+        for (std::uint32_t index = 0; index < n; ++index) {
+            told += 3 * kP;
+            moved += resync.observe(3, told, kP, kP, told, 3);
+        }
+        require(moved == 1 && resync.offset[2] == 4,
+            "told with: a 3 frame told with 3 and shown a period late moves 3 to 4 (moved " +
+                std::to_string(moved) + ", offset " + std::to_string(resync.offset[2]) + ")");
+    }
+    {
+        // At back-off level 2 (hold 120 s), a shift against the last move that
+        // every judged frame since agrees on moves within ~30 s; one whose
+        // frames disagree now and then is held the whole 120 s.
+        const auto shift_delay = [&](bool unanimous_shift) {
+            CadenceTimeResync resync{};
+            Nanoseconds told = kStart;
+            std::int64_t moved = 0;
+            // A real move (+2) starts the hold.
+            for (std::uint32_t index = 0; index < n; ++index) {
+                told += 3 * kP;
+                moved += resync.observe(3, told, 2 * kP, kP, told, resync.periods_for(3));
+            }
+            require(moved == 2 && resync.last_move_sign[2] == 1, "unanimous: the first move");
+            const Nanoseconds hold_start = resync.hold_from[2];
+            resync.backoff[2] = 2;
+            resync.backoff_at[2] = hold_start;
+            require(resync.reverse_hold(2, hold_start) == 120 * kSecond, "unanimous: back-off 2 holds 120 s");
+            // Then every frame a period early (every 15th two, if not unanimous).
+            std::uint32_t count = 0;
+            while (told < hold_start + 200 * kSecond) {
+                told += 3 * kP;
+                ++count;
+                const std::int64_t off = !unanimous_shift && count % 15 == 0 ? -2 : -1;
+                if (resync.observe(3, told, off * kP, kP, told, resync.periods_for(3)) != 0) {
+                    return told - hold_start;
+                }
+            }
+            return Nanoseconds{-1};
+        };
+        const Nanoseconds unanimous = shift_delay(true);
+        const Nanoseconds mixed = shift_delay(false);
+        std::cout << "cadence resync (0063): at back-off 2 a unanimous shift moved after "
+                  << unanimous / kMillisecond << " ms, a mixed one after " << mixed / kMillisecond << " ms\n";
+        require(unanimous > 0 && unanimous <= CadenceTimeResync::kUnanimousHold + kSecond &&
+                    unanimous >= CadenceTimeResync::kUnanimousHold,
+            "unanimous: a unanimous shift at back-off 2 is held 30 s, not 120 s");
+        require(mixed >= 120 * kSecond && mixed <= 121 * kSecond,
+            "unanimous: a shift whose frames disagree keeps the 120 s hold");
+    }
+    {
+        // adaptive_switch result=14's c: the move count saturates (it wrapped).
+        const std::uint64_t c = xrfg::latency::resync_record_c(-2, 70000, 300, 300);
+        require((c & 0xFFFFFFFFULL) == 0xFFFFFFFEULL && ((c >> 32) & 0xFFFFULL) == 0xFFFFULL &&
+                    ((c >> 48) & 0xFFULL) == 0xFFULL && (c >> 56) == 0xFFULL,
+            "result=14: fields saturate");
+        require(((xrfg::latency::resync_record_c(3, 65536, 1, 2) >> 32) & 0xFFFFULL) == 0xFFFFULL &&
+                    ((xrfg::latency::resync_record_c(3, 65535, 1, 2) >> 32) & 0xFFFFULL) == 0xFFFFULL &&
+                    ((xrfg::latency::resync_record_c(3, 7, 1, 2) >> 32) & 0xFFFFULL) == 7ULL,
+            "result=14: 65,536 moves read 65,535, not 0");
+        require(xrfg::latency::resync_record_signed(-1) == 0xFFFFFFFFULL, "result=14: signed field");
+    }
+    {
+        // The display period: 90 Hz to 72 Hz mid-session is taken after 90
+        // waits (with the scanout agreeing, or none measured), the throttle's
+        // multiples never, a scanout that disagrees never.
+        constexpr Nanoseconds k90 = 11'111'111;
+        constexpr Nanoseconds k72 = 13'888'889;
+        for (const bool measured : {true, false}) {
+            xrfg::latency::DisplayPeriodRise rise{};
+            std::uint32_t adopted_at = 0;
+            Nanoseconds adopted{};
+            for (std::uint32_t wait = 1; wait <= 200 && adopted_at == 0; ++wait) {
+                const Nanoseconds jitter = (wait % 3) * 1000;
+                if (const auto taken = rise.observe(k90, k72 + jitter,
+                        measured ? std::optional<Nanoseconds>(k72) : std::nullopt)) {
+                    adopted_at = wait;
+                    adopted = *taken;
+                }
+            }
+            require(adopted_at == xrfg::latency::DisplayPeriodRise::kWaits &&
+                        adopted >= k72 && adopted <= k72 + 2000,
+                "display period: 90 -> 72 Hz taken after 90 waits (at " + std::to_string(adopted_at) + ")");
+            // The layer's glue on adoption: told time and resync start over.
+            CadenceTimeResync resync{};
+            resync.offset[1] = 4;
+            resync.learnt[1] = true;
+            resync.reset();
+            require(!resync.learnt[1] && resync.offset[1] == 0, "display period: the resync starts over");
+        }
+        xrfg::latency::DisplayPeriodRise throttled{};
+        bool taken = false;
+        const std::array<Nanoseconds, 3> multiples{5 * k90, 2 * k90, 3 * k90};
+        for (std::uint32_t wait = 0; wait < 1000; ++wait) {
+            taken = taken || throttled.observe(k90, multiples[wait % 3], std::nullopt).has_value();
+        }
+        require(!taken, "display period: SteamVR's jumping multiples are never taken");
+        xrfg::latency::DisplayPeriodRise disagreeing{};
+        for (std::uint32_t wait = 0; wait < 1000; ++wait) {
+            taken = taken || disagreeing.observe(k90, k72, k90).has_value();
+        }
+        require(!taken, "display period: a scanout still at 90 Hz keeps it");
+        xrfg::latency::DisplayPeriodRise broken{};
+        for (std::uint32_t wait = 0; wait < 1000; ++wait) {
+            // A normal report every 89 waits starts the run again.
+            taken = taken || broken.observe(k90, wait % 89 == 88 ? k90 : k72, std::nullopt).has_value();
+        }
+        require(!taken, "display period: a run broken before 90 waits is not taken");
+    }
+    {
+        // 0050's epoch: a capture whose wait for the re-presented slot ran
+        // out does not capture (nor take a number); the next frame tries the
+        // same number again.
+        using xrfg::latency::capture_epoch_step;
+        using xrfg::latency::capture_slot_reused;
+        const std::uint64_t in_flight = 5;
+        const std::uint64_t epoch = 6;
+        require(capture_slot_reused(in_flight, epoch + 1, 2), "epoch: the next capture would take the slot");
+        const auto ran_out = capture_epoch_step(epoch, true);
+        require(!ran_out.capture && ran_out.epoch == epoch, "epoch: ran out, no capture, no number taken");
+        const auto clear = capture_epoch_step(epoch, false);
+        require(clear.capture && clear.epoch == epoch + 1, "epoch: the slot went out, the capture goes ahead");
+    }
+}
