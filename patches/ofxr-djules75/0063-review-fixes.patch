+// DCS Control (0063): the display period the presenter paces on is the
+// smallest the runtime reports (a slow frame makes SteamVR report multiples),
+// which a drop of the headset's refresh rate mid-session (90 to 72 Hz) never
+// replaced: adaptive cadence's told times, 1X deadline, lost-slot counts and
+// resync then ran on the old period. This takes a longer one once it has
+// been reported for kWaits presenter waits in a row, each more than 5% above
+// the period in force and within 5% of the run's own (the throttle's
+// multiples jump about, a new refresh rate holds), and the headset's own
+// scanout measurement, where there is one, agrees. observe returns the period
+// to adopt (the smallest of the run), else nothing.
+struct DisplayPeriodRise {
+    static constexpr std::uint32_t kWaits = 90;
+    Nanoseconds candidate{};
+    std::uint32_t waits{};
+
+    [[nodiscard]] static constexpr bool above(Nanoseconds value, Nanoseconds base) noexcept {
+        return value * 100 > base * 105;
+    }
+    std::optional<Nanoseconds> observe(
+        Nanoseconds current,
+        Nanoseconds reported,
+        std::optional<Nanoseconds> scanout) noexcept {
+        if (current <= 0 || reported <= 0 || !above(reported, current) ||
+            (scanout && !above(*scanout, current))) {
+            waits = 0;
+            return std::nullopt;
+        }
+        const Nanoseconds seen = scanout && *scanout < reported ? *scanout : reported;
+        if (waits == 0 || above(seen, candidate) || above(candidate, seen)) {
+            candidate = seen;
+            waits = 1;
+        } else {
+            candidate = seen < candidate ? seen : candidate;
+            ++waits;
+        }
+        if (waits < kWaits) {
+            return std::nullopt;
+        }
+        waits = 0;
+        return candidate;
+    }
 };
 
