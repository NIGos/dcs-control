+[[nodiscard]] inline std::uint64_t resync_record_c(
+    std::int64_t offset,
+    std::uint32_t moves,
+    std::uint32_t backoff,
+    std::uint32_t held) noexcept {
+    return resync_record_signed(offset) |
+        (static_cast<std::uint64_t>(std::min<std::uint32_t>(moves, 0xFFFFU)) << 32) |
+        (static_cast<std::uint64_t>(std::min<std::uint32_t>(backoff, 0xFFU)) << 48) |
