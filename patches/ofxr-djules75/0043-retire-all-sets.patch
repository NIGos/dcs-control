+// DCS Control (0043): the cockpit mask consumer's retired sets (mask, depth,
+// motion) whose copies completed, dropped on every xrEndFrame once a consumer
+// exists, frame generation on or off (acquire_cockpit_mask runs only while
+// it is on). A fence read: never waits.
+void drop_idle_cockpit_mask(SessionState& session) noexcept {
+    std::shared_ptr<xrfg::CockpitMaskConsumer> consumer;
+    try {
+        std::scoped_lock lock(session.cockpit_mask_mutex);
+        consumer = session.cockpit_mask;
+    } catch (...) {
+        return;
+    }
+    if (consumer) {
+        consumer->drop_idle();
+    }
+}
