+// DCS Control (0043): a mask header no longer usable retires the depth and
+// motion sets with the mask's (not kept until the next pairing, none while
+// the export is off), each kept while a copy may still read it, and dropped
+// once the copies complete even without another acquire (drop_idle, called
+// on every xrEndFrame, generation on or off).
+void test_unusable_header_retires_all_sets(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"retireall");
+    FakeProducer producer(gpu, suffix);
+    FakeDepthProducer depth(gpu, suffix, producer);
+    FakeMotionProducer motion(gpu, suffix, producer);
+    auto options = test_options(suffix);
+    options.cockpit_depth = true;
+    options.dcs_motion = true;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    std::uint64_t seq = producer.commit(9000, 255);
+    depth.commit(producer);
+    motion.commit(producer, 8990);
+    auto frame = consumer.acquire(9000);
+    require(frame != nullptr && frame->depth && frame->motion, "retire all: mask, depth and motion paired");
+    require(consumer.stats().sets_opened == 3 && consumer.stats().sets_retired == 0,
+        "retire all: three sets opened");
+    // The copy waits for the producer's fence: still outstanding.
+    Sleep(50);
+    require(frame->ready_fence->GetCompletedValue() < frame->ready_value, "retire all: the copy is outstanding");
+
+    // The export goes off: the header inactive.
+    producer.header_.flags &= ~cm::header_flags::active;
+    producer.publish();
+    require(consumer.acquire(9100) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::header_unusable,
+        "retire all: an inactive header");
+    xrfg::CockpitMaskConsumerStats stats = consumer.stats();
+    require(stats.sets_opened == 0 && stats.sets_retired == 3,
+        "retire all: the depth and motion sets retired with the mask's (opened " +
+            std::to_string(stats.sets_opened) + ", retired " + std::to_string(stats.sets_retired) + ")");
+    // Idle (no acquire): kept while the copy may still read them.
+    consumer.drop_idle();
+    require(consumer.stats().sets_retired == 3 && consumer.stats().sets_dropped == 0,
+        "retire all: nothing dropped while the copy is outstanding");
+
+    producer.signal(seq);
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    frame.reset();
+    // done_fence follows the copy fence on the copy queue: dropped by
+    // drop_idle alone once it lands.
+    const ULONGLONG deadline = GetTickCount64() + 10000;
+    while (true) {
+        consumer.drop_idle();
+        stats = consumer.stats();
+        if (stats.sets_retired == 0 || GetTickCount64() > deadline) {
+            break;
+        }
+        Sleep(5);
+    }
+    require(stats.sets_retired == 0 && stats.sets_dropped == 3,
+        "retire all: the three sets dropped once their copies completed, without an acquire (dropped " +
+            std::to_string(stats.sets_dropped) + ")");
+
+    // Active again: all three opened afresh, and paired.
+    producer.header_.flags |= cm::header_flags::active;
+    seq = producer.commit(9200, 255);
+    depth.commit(producer);
+    motion.commit(producer, 9100);
+    auto again = consumer.acquire(9200);
+    require(again != nullptr && again->depth && again->motion && consumer.stats().sets_opened == 3,
+        "retire all: paired again once active");
+    stats = consumer.stats();
+    require(stats.generations_opened == 2 && stats.depth_generations_opened == 2 &&
+            stats.motion_generations_opened == 2,
+        "retire all: each set opened again");
+    producer.signal(seq);
+    gpu.wait(again->ready_fence.Get(), again->ready_value);
+    std::cout << "cockpit mask: an unusable header retires the mask, depth and motion sets, dropped once copied\n";
+}
+
