+// Whether `input`'s pixel lies in a still tile; then its composition: the
+// two frames at the pixel, or the current frame alone where
+// synthesize_midpoint has no previous sample there (the same tests, in the
+// same order).
+bool still_tile_pixel(FullscreenVertex input, out float4 previous_color, out float4 current_color,
+    out bool blend) {
+    previous_color = float4(0.0, 0.0, 0.0, 1.0);
+    current_color = float4(0.0, 0.0, 0.0, 1.0);
+    blend = false;
+    uint2 integer_pixel = uint2(input.position.xy);
+    bool still = StillTiles.Load(int4(integer_pixel / kStillTileSize, ViewIndex, 0)) != 0u;
+    [branch] if (still) {
+        bool in_bounds = integer_pixel.x < Width && integer_pixel.y < Height && Slice < ArraySize;
+        if (in_bounds) {
+            float2 pixel = float2(integer_pixel);
+            CameraSample current = sample_current_target(pixel, Slice, ViewIndex);
+            CameraSample previous = sample_previous_target(pixel, Slice, ViewIndex);
+            current_color = current.color;
+            previous_color = previous.color;
+            blend = previous.valid >= 0.5 && current.valid >= 0.5;
+        }
+    }
+    return still;
+}
