+std::vector<StereoPattern> synthesize_fast_composition_pair(D3D12WarpFixture& fixture,
+    const StereoPattern& a, const StereoPattern& b, UINT width, UINT height,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options,
+    const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>& cockpit_mask, bool triple,
