+// DCS Control (0033): [ofxr] fast_composition=1, still tiles. Compiled in
+// only for the shaders built with XRFG_FAST_COMPOSITION=1: the NVIDIA
+// compositions D3D12FrameSynthesizer makes only with that key (without it the
+// compositions are these shaders exactly as before 0033), and the pass that
+// classifies their tiles.
+//
+// A tile is still when synthesize_midpoint on the NVIDIA path
+// (pose-compensated flow) comes, at every pixel of it, to
+// saturate(lerp(previous at the pixel, current at the pixel, t)) - or to the
+// current frame alone where the previous frame's coverage or the current
+// rectangle ends, as at any pixel - whatever else it computes:
+//  - every flow cell any pixel of the tile interpolates (flow_for_pixel_spread:
+//    the same cells, bounds and clamps) is exactly zero, so every endpoint is
+//    the pixel itself, the flow midpoint and the stable midpoint are one
+//    value, and the confidence, cost, cycle, endpoint and stationary checks
+//    that weigh one against the other cannot change it; the moving-edge step
+//    needs a vector to move;
+//  - with the occlusion choice (levels 2 and 3) the cells it probes, up to
+//    five cells away, are zero too, so it finds no second motion (its edge
+//    weight is 0) and leaves the pixel as composed;
+//  - no pixel of it is within the cockpit mask's reach (below 0.25: none of
+//    the cockpit rules run);
+//  - or the pair repeats a capture, whose flow is zero and where none of
+//    those rules runs.
+// The tiles' flags, one byte per tile of kStillTileSize pixels (in the
+// image's own pixels, from 0), slice ViewIndex; the composition reads them at
+// t6, which the NVIDIA compositions do not otherwise read (the game-motion
+// composition's vectors). How many tiles of each view are still decides
+// which composition draws it (DecideStillTilesCS): where too few are, the
+// one without this path, so a view in motion costs only the classification.
+#ifndef XRFG_FAST_COMPOSITION
+#define XRFG_FAST_COMPOSITION 0
+#endif
+#if XRFG_FAST_COMPOSITION
+static const uint kStillTileSize = 16u;
+Texture2DArray<uint> StillTiles : register(t6);
+#ifndef XRFG_STILL_TILE_CLASSIFY
+#define XRFG_STILL_TILE_CLASSIFY 0
+#endif
+#if XRFG_STILL_TILE_CLASSIFY
+// The classification's own (compiled with XRFG_STILL_TILE_CLASSIFY=1).
+RWTexture2DArray<uint> StillTilesOut : register(u0);
+// Per view, from byte 0, the still tiles counted so far (a uint each); from
+// byte 64 the predicates the composition's draws are predicated on (a
+// uint64 each): 1 draw the still-tile composition, 0 the one without.
+RWByteAddressBuffer StillCounts : register(u1);
+static const uint kStillPredicateOffset = 64u;
+groupshared uint g_still_tiles;
+
+// The flow cell flow_for_pixel_spread starts its 2x2 interpolation from at
+// `pixel` (its top-left cell; the other is one further, within the bounds).
+int2 still_flow_cell(float2 pixel, FlowGridBounds bounds) {
+    float2 scaled = flow_input_coordinate(pixel);
+    float2 packed_coordinate = float2(scaled.x, scaled.y + float(Slice * PackedEyeStride));
+    float2 flow_coordinate = (packed_coordinate + 0.5) / float(FlowBlockSize) - 0.5;
+    float2 bounded = clamp(flow_coordinate, float2(bounds.minimum), float2(bounds.maximum));
+    return int2(floor(bounded));
+}
+
+// One thread per tile of the view's image (Width x Height), for view
+// ViewIndex: 1 still, 0 not; and the view's count of still tiles.
+[numthreads(8, 8, 1)]
+void ClassifyStillTilesCS(uint3 thread_id : SV_DispatchThreadID, uint group_index : SV_GroupIndex) {
+    if (group_index == 0u) {
+        g_still_tiles = 0u;
+    }
+    GroupMemoryBarrierWithGroupSync();
+    uint2 tiles = (uint2(Width, Height) + kStillTileSize - 1u) / kStillTileSize;
+    bool inside = thread_id.x < tiles.x && thread_id.y < tiles.y;
+    uint2 first_pixel = thread_id.xy * kStillTileSize;
+    uint2 last_pixel = min(first_pixel + kStillTileSize - 1u, uint2(Width, Height) - 1u);
+    bool still = inside;
+    if (inside && repeated_capture_flag() == 0) {
+        // The mask texels cockpit_mask_at reads for these pixels.
+        if (cockpit_mask_bound()) {
+            float cell = float(4u << ((SynthesisFlags >> 6) & 3u));
+            float2 origin = PreviousMappings[ViewIndex].TargetRect.xy;
+            int2 first_texel = int2(floor((float2(first_pixel) - origin + 0.5) / cell));
+            int2 last_texel = int2(floor((float2(last_pixel) - origin + 0.5) / cell));
+            for (int y = first_texel.y; y <= last_texel.y && still; ++y) {
+                for (int x = first_texel.x; x <= last_texel.x; ++x) {
+                    if (CockpitMask.Load(int4(x, y, int(ViewIndex), 0)) >= 0.25) {
+                        still = false;
+                    }
+                }
+            }
+        }
+        // The flow cells: rounding is monotonic, so the first pixel's start
+        // cell and the last pixel's start cell plus one bound every pixel's.
+        FlowGridBounds bounds = flow_grid_bounds(PreviousMappings[ViewIndex].TargetRect, Slice);
+        int reach = moving_edge_flag() && occlusion_choice_flag() ? 6 : 0;
+        int2 first_cell = max(still_flow_cell(float2(first_pixel), bounds) - reach, bounds.minimum);
+        int2 last_cell = min(still_flow_cell(float2(last_pixel), bounds) + 1 + reach, bounds.maximum);
+        for (int y = first_cell.y; y <= last_cell.y && still; ++y) {
+            for (int x = first_cell.x; x <= last_cell.x; ++x) {
+                int2 flow = BackwardFlow.Load(int3(x, y, 0));
+                if ((flow.x | flow.y) != 0) {
+                    still = false;
+                }
+            }
+        }
+    }
+    if (inside) {
+        StillTilesOut[uint3(thread_id.xy, ViewIndex)] = still ? 1u : 0u;
+        if (still) {
+            InterlockedAdd(g_still_tiles, 1u);
+        }
+    }
+    GroupMemoryBarrierWithGroupSync();
+    if (group_index == 0u && g_still_tiles != 0u) {
+        StillCounts.InterlockedAdd(ViewIndex * 4u, g_still_tiles);
+    }
+}
+
+// After every view's classification: each view's predicate, 1 where at
+// least GameMotionPadding of its tiles (an eighth of them; one for a test) are
+// still, and its count back to 0 for the next pair.
+[numthreads(1, 1, 1)]
+void DecideStillTilesCS() {
+    uint threshold = max(GameMotionPadding, 1u);
+    [unroll] for (uint view = 0u; view < 2u; ++view) {
+        uint count = StillCounts.Load(view * 4u);
+        StillCounts.Store2(kStillPredicateOffset + view * 8u, uint2(count >= threshold ? 1u : 0u, 0u));
+        StillCounts.Store(view * 4u, 0u);
+    }
+}
+#endif
