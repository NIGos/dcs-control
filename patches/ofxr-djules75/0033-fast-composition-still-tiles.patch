+        }
+        std::cout << "fast composition scene=" << scene.name << ": " << combinations
+                  << " combinations, max difference " << worst_scene << ", " << differing_scene
+                  << " channels differ" << std::endl;
+        worst_overall = std::max(worst_overall, worst_scene);
+    }
+    SetEnvironmentVariableW(L"XRFG_TEST_STILL_TILES_ANY", nullptr);
+    // And as shipped (from an eighth of a view's tiles still), at the app's
+    // defaults: the still cockpit, and the rolling world (no view still
+    // enough: the composition without the path).
+    for (std::size_t index : {std::size_t{0}, std::size_t{2}, std::size_t{7}}) {
+        const FastCompositionScene& scene = scenes[index];
+        const auto mask = make_cockpit_mask_frame(fixture, width, height, scene.cockpit, kMaskDivisor, mask_views);
+        for (int masked = 0; masked < 2; ++masked) {
+            xrfg::D3D12NvidiaOpticalFlowOptions options;
+            options.occlusion_aware = 1;
+            options.cockpit_mask = true;
+            std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> frames{};
+            if (masked != 0) frames = {mask, mask};
+            const ReprojectionViews previous_views = make_reprojection_views(scene.previous_yaw);
+            const auto before = synthesize_fast_composition_pair(fixture, scene.previous, scene.current, width,
+                height, options, frames, false, previous_views);
+            options.fast_composition = true;
+            const auto after = synthesize_fast_composition_pair(fixture, scene.previous, scene.current, width,
+                height, options, frames, false, previous_views);
+            int worst = 0;
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                for (std::size_t i = 0; i < before[0][eye].size(); ++i) {
+                    worst = std::max(worst, std::abs(int(before[0][eye][i]) - int(after[0][eye][i])));
+                }
+                compared += before[0][eye].size();
+            }
+            require(worst <= 1, "fast composition (as shipped) differs by more than 1/255 on " + scene.name);
+            worst_overall = std::max(worst_overall, worst);
+        }
+    }
+    std::cout << "fast composition equivalence: " << compared << " channels compared, max difference "
+              << worst_overall << "/255" << std::endl;
+}
