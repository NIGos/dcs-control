+// XRFG_TEST_FAST_COMPOSITION_BENCH=1 on NVIDIA hardware: the composition's
+// GPU time per pair (the synthesis queue, the graphics engine) with [ofxr]
+// fast_composition off and on, driven alternately so both see the same
+// clocks, at the app's defaults (Medium, one-way, level 1, the cockpit mask
+// with `with_mask`). Scene 0: a still cockpit over a still world with one
+// object crossing (mostly no motion); scene 1: the world rolling behind still
+// bars (motion nearly everywhere); scenes 2 and 3: that with the lowest
+// quarter, or the lowest eighth and a half, of the world still. `triple`: 3X
+// in one pass.
+void bench_fast_composition(D3D12WarpFixture& fixture, UINT width, UINT height, int scene, bool with_mask,
+    bool triple = false) {
+    constexpr UINT kFrames = 3;
+    constexpr int kPairs = 240;
+    struct Pipeline {
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{};
+        std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+        std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+        std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+        std::vector<std::uint64_t> composition;
+        std::vector<std::uint64_t> total;
+    };
+    std::array<StereoPattern, kFrames> frames{};
+    std::vector<std::uint8_t> cockpit;
+    for (UINT frame = 0; frame < kFrames; ++frame) {
+        frames[frame] = scene == 0
+            ? fast_composition_cockpit(width, height, static_cast<int>(frame) * 20, frame == 0 ? &cockpit : nullptr)
+            : fast_composition_roll(width, height, 0.4 * frame, frame == 0 ? &cockpit : nullptr,
+                  scene == 2 ? height * 3U / 4U : scene == 3 ? height * 13U / 16U : 0xffffffffU);
+    }
+    std::array<Pipeline, 2> pipelines{};
+    for (UINT index = 0; index < pipelines.size(); ++index) {
+        Pipeline& pipeline = pipelines[index];
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            pipeline.sources[frame] = create_source_texture(fixture, width, height);
+            upload_pattern(fixture, pipeline.sources[frame].Get(), frames[frame]);
+        }
+        for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+        for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = pipeline.sources[i].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+        std::array<ID3D12Resource*, 2> synthetic_pointers{pipeline.synthetics[0].Get(), pipeline.synthetics[1].Get()};
+        pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "fast composition bench: history");
+        xrfg::D3D12NvidiaOpticalFlowOptions options{};
+        options.occlusion_aware = 1;
+        options.cockpit_mask = with_mask;
+        options.fast_composition = index == 1;
+        pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                    pipeline.history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "fast composition bench: synthesizer");
+    }
+    const ReprojectionViews views = make_reprojection_views();
+    std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> masks{};
+    if (with_mask) {
+        for (auto& mask : masks) mask = make_cockpit_mask_frame(fixture, width, height, cockpit, 8, views);
+    }
+    for (int frame = 0; frame <= kPairs; ++frame) {
+        const UINT slot = static_cast<UINT>(frame) % kFrames;
+        for (Pipeline& pipeline : pipelines) {
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require(operation_succeeded(pipeline.history->capture(slot, &capture)) &&
+                        operation_succeeded(pipeline.history->commit(capture)), "fast composition bench: capture");
+            if (with_mask) pipeline.synthesizer->set_cockpit_mask(masks[static_cast<std::size_t>(frame) % 2U]);
+            const HRESULT submitted = frame == 0
+                ? pipeline.synthesizer->submit_prime(capture, views, 0, &ticket)
+                : triple
+                ? pipeline.synthesizer->submit_pair(capture, views, views, 0, 1, &ticket, std::nullopt, {}, false,
+                      1.0F / 3.0F, xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                : pipeline.synthesizer->submit_pair(capture, views, views, 0,
+                      static_cast<std::uint32_t>(frame % 2), &ticket, std::nullopt, {}, false, 0.5F);
+            require(operation_succeeded(submitted), "fast composition bench: submission");
+            require_frame_start_gate(*pipeline.synthesizer, "fast composition bench: frame-start gate");
+            xrfg::D3D12NvidiaGpuTiming timing{};
+            while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                if (timing.previous_serial == 0) continue;
+                pipeline.composition.push_back(timing.composition_microseconds);
+                pipeline.total.push_back(timing.total_microseconds);
+            }
+        }
+    }
+    require(operation_succeeded(pipelines[0].synthesizer->wait_for_idle()) &&
+                operation_succeeded(pipelines[1].synthesizer->wait_for_idle()), "fast composition bench: idle");
+    const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+        if (values.empty()) return 0;
+        std::sort(values.begin(), values.end());
+        return values[values.size() / 2];
+    };
+    std::cout << "fast composition bench "
+              << (scene == 0 ? "still_cockpit" : scene == 1 ? "rolling_world"
+                  : scene == 2 ? "rolling_world_quarter_still" : "rolling_world_3/16_still")
+              << (with_mask ? " mask" : " no-mask") << (triple ? " 3X" : " 2X") << ' ' << width << "x" << height
+              << " x2 eyes: composition median off " << median(pipelines[0].composition) << " us, on "
+              << median(pipelines[1].composition) << " us (" << pipelines[1].composition.size()
+              << " pairs); whole pair median off " << median(pipelines[0].total) << " us, on "
+              << median(pipelines[1].total) << " us" << std::endl;
+}
+
+// DCS Control (0033): the GPU time of one full copy of a synthetic (both eyes,
+// RGBA8) on the graphics queue: what composing on an async compute queue
+// would add, since the runtime's sRGB swapchain images take no unordered
+// access and the composition would have to write an intermediate and copy it.
+// (At 2712 x 2678 both images fit in a large GPU's L2 cache here, which a
+// game's frame would not leave them.)
+void bench_synthetic_copy(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    // Textured content (an image the hardware cannot compress away).
+    auto source = create_source_texture(fixture, width, height);
+    upload_pattern(fixture, source.Get(), fast_composition_roll(width, height, 0.0, nullptr));
+    auto destination = create_source_texture(fixture, width, height);
+    D3D12_QUERY_HEAP_DESC heap_description{};
+    heap_description.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    heap_description.Count = 2;
+    ComPtr<ID3D12QueryHeap> heap;
+    require_hresult(fixture.device()->CreateQueryHeap(&heap_description, IID_PPV_ARGS(heap.GetAddressOf())),
+        "copy bench query heap");
+    auto readback = create_buffer(fixture, D3D12_HEAP_TYPE_READBACK, 16, D3D12_RESOURCE_STATE_COPY_DEST);
+    UINT64 frequency = 0;
+    require_hresult(fixture.queue()->GetTimestampFrequency(&frequency), "copy bench frequency");
+    std::vector<std::uint64_t> times;
+    for (int run = 0; run < 60; ++run) {
+        fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+            const std::array<D3D12_RESOURCE_BARRIER, 2> before{
+                transition_barrier(source.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    D3D12_RESOURCE_STATE_COPY_SOURCE),
+                transition_barrier(destination.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    D3D12_RESOURCE_STATE_COPY_DEST)};
+            const std::array<D3D12_RESOURCE_BARRIER, 2> after{
+                transition_barrier(source.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
+                    D3D12_RESOURCE_STATE_RENDER_TARGET),
+                transition_barrier(destination.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)};
+            list->ResourceBarrier(2, before.data());
+            list->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
+            list->CopyResource(destination.Get(), source.Get());
+            list->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 1);
+            list->ResourceBarrier(2, after.data());
+            list->ResolveQueryData(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0, 2, readback.Get(), 0);
+        });
+        std::uint64_t* mapped = nullptr;
+        require_hresult(readback->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "copy bench map");
+        times.push_back((mapped[1] - mapped[0]) * 1000000ULL / frequency);
+        readback->Unmap(0, nullptr);
+    }
+    std::sort(times.begin(), times.end());
+    std::cout << "synthetic copy bench " << width << "x" << height << " x2 eyes: median "
+              << times[times.size() / 2] << " us per synthetic" << std::endl;
+}
