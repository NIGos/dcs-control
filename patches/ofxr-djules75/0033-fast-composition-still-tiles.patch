+        D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::nvidia, options),
+        "fast composition initialize");
+    const auto views = make_reprojection_views();
+    xrfg::D3D12HistoryCaptureTicket ca{}, cb{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ca), "fast composition A");
+    require_hresult(history->commit(ca), "fast composition commit A");
+    synth.set_cockpit_mask(cockpit_mask[0]);
+    require_hresult(synth.submit_prime(ca, previous_views, 0, &output), "fast composition prime");
+    fixture.execute_and_wait([](ID3D12GraphicsCommandList*) {});
+    require_hresult(history->capture(1, &cb), "fast composition B");
+    require_hresult(history->commit(cb), "fast composition commit B");
