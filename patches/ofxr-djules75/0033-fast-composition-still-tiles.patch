+                const bool cockpit = y >= height * 2 / 3 || (x >= width / 4 && x < width / 4 + width / 40);
+                const int ox = static_cast<int>(x) - object_shift;
+                const bool object = !cockpit && ox >= static_cast<int>(width / 2) &&
+                    ox < static_cast<int>(width / 2 + width / 18) && y >= height / 5 && y < height / 5 + height / 26;
+                const auto texel = cockpit ? occlusion_texture(x, y, 1)
