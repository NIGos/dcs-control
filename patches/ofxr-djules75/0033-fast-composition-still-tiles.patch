+// A world turning `degrees` about the image's centre behind still bars (a
+// canopy bow and a sill), as bench_occlusion_composition's roll; from row
+// `still_from` down the world does not turn.
+StereoPattern fast_composition_roll(UINT width, UINT height, double degrees, std::vector<std::uint8_t>* bars,
+    UINT still_from = 0xffffffffU) {
+    StereoPattern image;
+    const double cx = width * 0.5, cy = height * 0.5;
+    const double angle = degrees * 3.14159265358979 / 180.0;
+    const double ca = std::cos(angle), sa = std::sin(angle);
+    if (bars != nullptr) bars->assign(static_cast<std::size_t>(width) * height, 0);
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        auto& bytes = image[eye];
+        bytes.resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const bool bar = (x >= width / 3 && x < width / 3 + 24) ||
+                    (y >= height * 3 / 4 && y < height * 3 / 4 + 20);
+                const double dx = x - cx, dy = y - cy;
+                const auto texel = bar ? occlusion_texture(x, y, 1)
+                    : y >= still_from ? occlusion_texture(x, y, 0)
+                                      : occlusion_texture(cx + ca * dx - sa * dy, cy + sa * dx + ca * dy, 0);
+                const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                bytes[i] = texel[0];
+                bytes[i + 1] = texel[1];
+                bytes[i + 2] = texel[2];
+                bytes[i + 3] = 255;
+                if (bars != nullptr && eye == 0) (*bars)[static_cast<std::size_t>(y) * width + x] = bar ? 1 : 0;
+            }
+        }
+    }
+    return image;
+}
