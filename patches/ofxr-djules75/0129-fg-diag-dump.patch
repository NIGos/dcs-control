     // DCS Control (0049): a pair's symbology fallback, counted where its
     // current frame's mask counts (cockpit_mask result=20).
     void count_hud_fallback(std::uint32_t reason, std::uint64_t views) noexcept {
diff --git a/src/d3d12/frame_synthesis.hlsl b/src/d3d12/frame_synthesis.hlsl
index ff877d6..85d4be4 100644
--- a/src/d3d12/frame_synthesis.hlsl
