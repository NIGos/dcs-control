+// DCS Control (0129, dev only): the frame-generation diagnosis dump. With
+// UseGameMotion bit 28 (set by the synthesizer only for a pair it dumps, and
+// only with the _extras twin bound: XRFG_FG_EXTRAS) every pixel of the dump
+// rectangle writes what dcs_motion_pixel decided into the u0 buffer (which is
+// then the synthesizer's diagnosis buffer, its first 128 bytes the counters):
+// at byte 128 the rectangle (x0, y0, width, height in target pixels), at 144
+// the magic 'FGDG' and the records' byte offset; one record of two words per
+// pixel and output, (output * height + y) * width + x:
+//   word 0: bits 0-3 the path (1 cockpit mask, 2 no usable MV (class or
+//           none), 3 the samples outside an image, 4 the gather's MV, 5 the
+//           scatter's MV; 0 not evaluated), 4-6 the gather's cell flags
+//           (1 MV, 2 one surface, 4 uniform field), 7 the mask band, 8-15 the
+//           gather's class byte, 16-23 the scatter candidate's class, 24 a
+//           scatter key, 25 the candidate consistent, 26 the candidate taken,
+//           27 dcs_motion_sky_occlusion forced the colour, 28 the
+//           still-content guard lowered the weight, 29 the strict check,
+//           30 the gather on the sky, 31 mask_here >= 0.75;
+//   word 1: unorm8 x4: the final weight, the colour check's weight (before
+//           the guard, the band and the sky rule), the disagreement (0-1),
+//           the mask value.
+// Without the bit (every pair the synthesizer does not dump, and every
+// composition built without the _extras twin) nothing here runs.
+#if XRFG_FG_EXTRAS
+static const uint kDcsMotionDiagBit = 1u << 28;
+void dcs_motion_diag_write(uint2 pixel, uint output, uint word0, float weight, float check_weight,
+    float disagreement, float mask) {
+    [branch] if ((UseGameMotion & kDcsMotionDiagBit) != 0u) {
+        uint4 rect = DcsMotionCounters.Load4(128);
+        uint4 info = DcsMotionCounters.Load4(144);
+        [branch] if (info.x == 0x47444746u && pixel.x >= rect.x && pixel.y >= rect.y &&
