+// DCS Control (0129, dev only): the frame-generation diagnosis dump. Off
+// unless the process has XRFG_DEV_FG_DIAG=1 and a folder (XRFG_DEV_FG_DIAG_DIR,
+// else the capture layer's RIGTAP_DIR): nothing below then runs, no resource
+// is made and no composition changes. With them, a trigger file
+// <folder>\fgdiag.txt (key=value lines, all optional: pairs=N the pairs each
+// synthesizer dumps, every=K one pair in K, delay_ms, seconds, tag,
+// window=l,r,u,d the tangents of the target view to dump, eye=0|1) starts a
+// session: it is renamed fgdiag.taken-<n>.txt, and from delay_ms on each
+// synthesizer with that eye dumps up to N of its pairs with DCS's MVs into
+// <folder>\fgdiag<n>_<tag>\: per pair s<owner>_p<k>.bin (the per-pixel
+// records of frame_synthesis.hlsl's dcs_motion_diag_write, then the resampled
+// grid's three slices and the scatter's two of that view, then the frame's MV
+// and class atlases as OFXR copied them; offsets and pitches in the .json)
+// and s<owner>_p<k>.json, plus s<owner>_pairs.csv (every pair the
+// synthesizer recorded in the session, with why it was not dumped).
+constexpr UINT kDcsMotionDiagBit = 1U << 28U;
+constexpr UINT64 kFgDiagHeaderOffset = 128;
+constexpr UINT64 kFgDiagRecordsOffset = 256;
+constexpr std::uint32_t kFgDiagMagic = 0x47444746U; // 'FGDG'
+constexpr UINT64 kFgDiagRecordBytes = 8;
+
+struct FgDiagSession {
+    std::uint32_t id{};
+    std::string tag;
+    std::int64_t start_qpc{};
+    std::int64_t end_qpc{};
+    std::uint32_t pairs{12};
+    std::uint32_t every{1};
+    std::array<float, 4> window{-100.0F, 100.0F, 100.0F, -100.0F};
+    std::uint32_t eye{};
+    std::filesystem::path directory;
+};
+
+class FgDiagTrigger {
+public:
+    static FgDiagTrigger& get() noexcept {
+        static FgDiagTrigger trigger;
+        return trigger;
+    }
+    [[nodiscard]] bool enabled() const noexcept { return enabled_; }
+    [[nodiscard]] std::int64_t frequency() const noexcept { return frequency_; }
+    [[nodiscard]] UINT64 record_bytes() const noexcept { return record_bytes_; }
+    [[nodiscard]] UINT ring() const noexcept { return ring_; }
+    [[nodiscard]] static std::int64_t now() noexcept {
+        LARGE_INTEGER value{};
+        QueryPerformanceCounter(&value);
+        return value.QuadPart;
+    }
+    // The current session (id 0: none yet), the trigger file polled at most
+    // every 50 ms (any thread).
+    [[nodiscard]] FgDiagSession current() noexcept {
+        std::scoped_lock lock(mutex_);
+        const std::int64_t at = now();
+        if (enabled_ && at - last_poll_ >= frequency_ / 20) {
+            last_poll_ = at;
+            try {
+                poll(at);
+            } catch (...) {
+            }
+        }
+        return session_;
+    }
+
+private:
+    FgDiagTrigger() noexcept {
+        LARGE_INTEGER frequency{};
+        QueryPerformanceFrequency(&frequency);
+        frequency_ = (std::max)(frequency.QuadPart, static_cast<LONGLONG>(1));
+        try {
+            const auto env = [](const wchar_t* name) {
+                std::wstring value(4096, L'\0');
+                const DWORD length = GetEnvironmentVariableW(name, value.data(), static_cast<DWORD>(value.size()));
+                value.resize(length < value.size() ? length : 0U);
+                return value;
+            };
+            std::wstring directory = env(L"XRFG_DEV_FG_DIAG_DIR");
+            if (directory.empty()) directory = env(L"RIGTAP_DIR");
+            enabled_ = env(L"XRFG_DEV_FG_DIAG") == L"1" && !directory.empty();
+            directory_ = directory;
+            const std::wstring megabytes = env(L"XRFG_DEV_FG_DIAG_MB");
+            const std::wstring ring = env(L"XRFG_DEV_FG_DIAG_RING");
+            if (!megabytes.empty()) record_bytes_ = std::clamp<UINT64>(_wtoi(megabytes.c_str()), 8, 512) << 20U;
+            if (!ring.empty()) ring_ = std::clamp<UINT>(static_cast<UINT>(_wtoi(ring.c_str())), 1U, 16U);
+        } catch (...) {
+            enabled_ = false;
+        }
+    }
+    void poll(std::int64_t at) {
+        const std::filesystem::path trigger = directory_ / L"fgdiag.txt";
+        const DWORD attributes = GetFileAttributesW(trigger.c_str());
+        if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0U) return;
+        std::string text;
+        if (FILE* file = _wfsopen(trigger.c_str(), L"rb", _SH_DENYNO)) {
+            char buffer[2048];
+            const std::size_t read = fread(buffer, 1, sizeof(buffer), file);
+            fclose(file);
+            text.assign(buffer, read);
+        } else {
+            return;
+        }
+        const std::uint32_t id = ++count_;
+        const std::filesystem::path taken = directory_ / (L"fgdiag.taken-" + std::to_wstring(id) + L".txt");
+        if (!MoveFileExW(trigger.c_str(), taken.c_str(), MOVEFILE_REPLACE_EXISTING)) DeleteFileW(trigger.c_str());
+        FgDiagSession session{};
+        session.id = id;
+        double delay_ms = 0.0;
+        double seconds = 4.0;
+        std::size_t begin = 0;
+        while (begin < text.size()) {
+            std::size_t end = text.find('\n', begin);
+            if (end == std::string::npos) end = text.size();
+            std::string line = text.substr(begin, end - begin);
+            begin = end + 1;
+            while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+            const std::size_t equals = line.find('=');
+            if (equals == std::string::npos) continue;
+            const std::string key = line.substr(0, equals);
+            const std::string value = line.substr(equals + 1);
+            if (key == "pairs") session.pairs = static_cast<std::uint32_t>(std::clamp(atoi(value.c_str()), 1, 400));
+            else if (key == "every") session.every = static_cast<std::uint32_t>(std::clamp(atoi(value.c_str()), 1, 100));
+            else if (key == "delay_ms") delay_ms = (std::max)(0.0, atof(value.c_str()));
+            else if (key == "seconds") seconds = std::clamp(atof(value.c_str()), 0.1, 60.0);
+            else if (key == "eye") session.eye = static_cast<std::uint32_t>(std::clamp(atoi(value.c_str()), 0, 1));
+            else if (key == "tag") {
+                for (const char c : value) {
+                    if (std::isalnum(static_cast<unsigned char>(c)) || c == '_' || c == '-') session.tag += c;
+                }
+            } else if (key == "window") {
+                float w[4]{};
+                if (sscanf_s(value.c_str(), "%f,%f,%f,%f", &w[0], &w[1], &w[2], &w[3]) == 4 && w[1] > w[0] && w[2] > w[3]) {
+                    session.window = {w[0], w[1], w[2], w[3]};
+                }
+            }
+        }
+        session.start_qpc = at + static_cast<std::int64_t>(delay_ms * 1.0e-3 * static_cast<double>(frequency_));
+        session.end_qpc = session.start_qpc + static_cast<std::int64_t>(seconds * static_cast<double>(frequency_));
+        std::wstring name = L"fgdiag" + std::to_wstring(id);
+        if (!session.tag.empty()) name += L"_" + std::wstring(session.tag.begin(), session.tag.end());
+        session.directory = directory_ / name;
+        std::error_code error;
+        std::filesystem::create_directories(session.directory, error);
+        session_ = session;
+    }
+    bool enabled_{};
+    std::filesystem::path directory_;
+    std::int64_t frequency_{1};
+    std::int64_t last_poll_{};
+    UINT64 record_bytes_{UINT64{96} << 20U};
+    UINT ring_{4};
+    std::uint32_t count_{};
+    FgDiagSession session_{};
+    std::mutex mutex_;
+};
+
