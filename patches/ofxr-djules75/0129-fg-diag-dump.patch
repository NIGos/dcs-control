+    std::string fg_diag_note;
+    std::thread fg_diag_thread;
+    std::mutex fg_diag_mutex;
+    std::condition_variable fg_diag_cv;
+    std::deque<FgDiagJob> fg_diag_jobs;
+    bool fg_diag_stop{};
+
+    [[nodiscard]] static UINT64 fg_diag_align(UINT64 value) noexcept {
+        return (value + D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT - 1U) &
+            ~static_cast<UINT64>(D3D12_TEXTURE_DATA_PLACEMENT_ALIGNMENT - 1U);
+    }
+    static bool fg_diag_write_file(const std::filesystem::path& path, const void* data, UINT64 size) noexcept {
+        HANDLE handle = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (handle == INVALID_HANDLE_VALUE) return false;
+        bool ok = true;
+        const auto* bytes = static_cast<const std::uint8_t*>(data);
+        while (ok && size > 0U) {
+            const DWORD chunk = static_cast<DWORD>((std::min)(size, UINT64{1} << 26U));
+            DWORD written = 0;
+            ok = WriteFile(handle, bytes, chunk, &written, nullptr) != FALSE && written == chunk;
+            bytes += chunk;
+            size -= chunk;
+        }
+        CloseHandle(handle);
+        return ok;
+    }
+    void fg_diag_queue(FgDiagJob job) noexcept {
+        try {
+            if (!fg_diag_thread.joinable()) {
+                fg_diag_thread = std::thread([this] {
+                    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL);
+                    for (;;) {
+                        FgDiagJob next;
+                        {
+                            std::unique_lock lock(fg_diag_mutex);
+                            fg_diag_cv.wait(lock, [this] { return fg_diag_stop || !fg_diag_jobs.empty(); });
+                            if (fg_diag_jobs.empty()) return;
+                            next = std::move(fg_diag_jobs.front());
+                            fg_diag_jobs.pop_front();
+                        }
+                        if (next.entry == UINT_MAX) {
+                            static_cast<void>(fg_diag_write_file(next.path, next.text.data(), next.text.size()));
+                            continue;
+                        }
+                        FgDiagEntry& entry = fg_diag_ring[next.entry];
+                        void* mapped = nullptr;
+                        const D3D12_RANGE read_range{0, static_cast<SIZE_T>(entry.used)};
+                        bool written = false;
+                        if (SUCCEEDED(entry.readback->Map(0, &read_range, &mapped)) && mapped != nullptr) {
+                            std::filesystem::path bin = entry.stem;
+                            bin += L".bin";
+                            written = fg_diag_write_file(bin, mapped, entry.used);
+                            const D3D12_RANGE no_write{0, 0};
+                            entry.readback->Unmap(0, &no_write);
+                        }
+                        std::filesystem::path json = entry.stem;
+                        json += L".json";
+                        std::string text = entry.json;
+                        text += written ? ",\"written\":true}\n" : ",\"written\":false}\n";
+                        static_cast<void>(fg_diag_write_file(json, text.data(), text.size()));
+                        entry.busy.store(false, std::memory_order_release);
+                    }
+                });
+            }
+            {
+                std::scoped_lock lock(fg_diag_mutex);
+                fg_diag_jobs.push_back(std::move(job));
+            }
+            fg_diag_cv.notify_one();
+        } catch (...) {
+            if (job.entry != UINT_MAX && fg_diag_ring) fg_diag_ring[job.entry].busy.store(false);
+        }
+    }
+    void fg_diag_stop_writer() noexcept {
+        if (!fg_diag_thread.joinable()) return;
+        {
+            std::scoped_lock lock(fg_diag_mutex);
+            fg_diag_stop = true;
+        }
+        fg_diag_cv.notify_all();
+        fg_diag_thread.join();
+    }
+    // The session's pair list, once it has ended (or another began).
+    void fg_diag_end_session() noexcept {
+        if (!fg_diag_session_open) return;
+        fg_diag_session_open = false;
+        try {
