+    // ---- DCS Control (0129, dev only): the frame-generation diagnosis dump
+    // (FgDiagTrigger). Nothing here runs or is made unless the trigger is
+    // enabled and a session is active for this synthesizer's eye.
+    struct FgDiagEntry {
+        ComPtr<ID3D12Resource> readback;
+        UINT64 size{};
+        UINT64 used{};
+        std::atomic<bool> busy{false};
+        std::filesystem::path stem;
+        std::string json;
+    };
+    struct FgDiagJob {
+        UINT entry{UINT_MAX};       // a ring entry to write, or
+        std::filesystem::path path; // a text file
+        std::string text;
+    };
+    std::unique_ptr<FgDiagEntry[]> fg_diag_ring;
+    UINT fg_diag_ring_count{};
+    ComPtr<ID3D12Resource> fg_diag_buffer;
+    UINT64 fg_diag_buffer_size{};
+    UINT64 fg_diag_entry_size{};
