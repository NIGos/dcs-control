+    std::uint32_t fg_diag_session{};
+    FgDiagSession fg_diag_current{};
+    bool fg_diag_in_window{};
+    bool fg_diag_session_open{};
+    std::uint32_t fg_diag_lines{};
+    std::uint32_t fg_diag_bound{};
+    std::uint32_t fg_diag_dumped{};
