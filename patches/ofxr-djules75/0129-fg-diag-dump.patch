+        fg_diag_note.clear();
+        fg_diag_bind_uav(slot, false);
+        FgDiagTrigger& trigger = FgDiagTrigger::get();
+        if (!trigger.enabled()) return;
+        const FgDiagSession session = trigger.current();
+        const std::int64_t now = FgDiagTrigger::now();
+        if (session.id != fg_diag_session) {
+            fg_diag_end_session();
+            fg_diag_session = session.id;
+            fg_diag_current = session;
+            fg_diag_lines = fg_diag_bound = fg_diag_dumped = 0;
+        }
+        fg_diag_in_window = session.id != 0 && now >= session.start_qpc && now <= session.end_qpc;
+        if (!fg_diag_in_window && now > session.end_qpc) fg_diag_end_session();
+        if (fg_diag_in_window) {
+            fg_diag_session_open = true;
+            start_extras_build_once(); // the _extras twins hold the records' code
+        }
+    }
+    // At every exit of record_dcs_motion within a session: the pair's line.
+    void fg_diag_line() noexcept {
+        if (!fg_diag_in_window) return;
+        try {
+            const D3D12CockpitMaskFrame* const current = pair_mask_current.get();
+            const D3D12CockpitMaskFrame* const previous = pair_mask_previous.get();
+            char line[512];
+            snprintf(line, sizeof(line), "%lld,%u,%u,%llu,%u,%lld,%llu,%lld,%llu,%d,%u,%.4f,%.4f,%d,%s\n",
+                static_cast<long long>(FgDiagTrigger::now()), hud_allocation_owner(), fg_diag_lines++,
+                static_cast<unsigned long long>(image_description.Width), image_description.Height,
+                static_cast<long long>(current ? current->display_time : 0),
+                static_cast<unsigned long long>(current ? current->mask_seq : 0),
+                static_cast<long long>(previous ? previous->display_time : 0),
+                static_cast<unsigned long long>(previous ? previous->mask_seq : 0), pair_motion_bound ? 1 : 0,
+                synthetic_output_count(), synthetic_output_fraction(0),
+                synthetic_output_count() > 1U ? synthetic_output_fraction(1) : 0.0F,
+                fg_diag_pair ? static_cast<int>(fg_diag_dumped) - 1 : -1,
+                fg_diag_note.empty() ? (fg_diag_pair ? "dumped" : "-") : fg_diag_note.c_str());
+            fg_diag_csv += line;
+        } catch (...) {
+        }
+    }
+    // The view blocks' u0 of `slot`: the diagnosis buffer or the counters.
+    void fg_diag_bind_uav(WorkSlot& slot, bool diag) noexcept {
+        if (slot.fg_diag_uav == diag || (diag && fg_diag_buffer == nullptr) || dcs_motion_counters == nullptr) return;
+        const D3D12_CPU_DESCRIPTOR_HANDLE start = slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        D3D12_UNORDERED_ACCESS_VIEW_DESC counters{};
+        counters.Format = DXGI_FORMAT_R32_TYPELESS;
+        counters.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+        counters.Buffer.NumElements = static_cast<UINT>((diag ? fg_diag_buffer_size : kDcsMotionCounterBytes) / 4U);
+        counters.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+        for (UINT block = 0; block < kMaxReprojectionViews; ++block) {
+            device->CreateUnorderedAccessView(diag ? fg_diag_buffer.Get() : dcs_motion_counters.Get(), nullptr,
+                &counters, offset_cpu_handle(start, block * kDescriptorBlockSize + kSrvDescriptorCount, descriptor_increment));
+        }
+        slot.fg_diag_uav = diag;
+    }
+    // The copy footprint of one subresource of `resource` at `offset`.
+    [[nodiscard]] UINT64 fg_diag_footprint(ID3D12Resource* resource, UINT subresource, UINT64 offset,
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT& footprint) const noexcept {
+        const D3D12_RESOURCE_DESC description = resource->GetDesc();
+        UINT rows = 0;
+        UINT64 row_bytes = 0;
+        UINT64 total = 0;
+        device->GetCopyableFootprints(&description, subresource, 1, offset, &footprint, &rows, &row_bytes, &total);
+        return total;
+    }
+    // What a dump of this pair needs besides its records.
+    [[nodiscard]] UINT64 fg_diag_extra_bytes(const D3D12CockpitMaskFrame& current) const noexcept {
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
+        UINT64 bytes = 0;
+        bytes += 3U * fg_diag_align(fg_diag_footprint(pair_motion_target, 0, 0, footprint));
+        bytes += 2U * fg_diag_align(fg_diag_footprint(pair_motion_scatter, 0, 0, footprint));
+        bytes += fg_diag_align(fg_diag_footprint(current.motion_texture.Get(), 0, 0, footprint));
+        if (current.motion_class && current.motion_class_texture != nullptr) {
+            bytes += fg_diag_align(fg_diag_footprint(current.motion_class_texture.Get(), 0, 0, footprint));
+        }
+        return bytes;
+    }
+    // After record_dcs_motion has filled `views` (pair_motion_target and
+    // pair_motion_scatter chosen): whether this pair is dumped, and if so its
+    // view's bit, the slot's u0 and the ring entry's description.
+    void fg_diag_prepare(WorkSlot& slot, const D3D12CockpitMaskFrame& current, const D3D12CockpitMaskFrame& previous,
+        const std::array<DcsMotionParameters, kMaxReprojectionViews>& views,
+        std::span<const D3D12ReprojectionView> target_views, UINT outputs) noexcept {
+        if (!fg_diag_in_window) return;
+        const FgDiagSession& session = fg_diag_current;
+        const std::uint32_t bound = fg_diag_bound++;
+        if (fg_diag_dumped >= session.pairs) { fg_diag_note = "pairs done"; return; }
+        if (bound % session.every != 0U) { fg_diag_note = "every"; return; }
+        UINT view = kMaxReprojectionViews;
+        for (UINT index = 0; index < static_cast<UINT>(target_views.size()) && index < kMaxReprojectionViews; ++index) {
+            if (pair_motion_bits[index] != 0U && cockpit_mask_eye(target_views[index], index) == session.eye) {
+                view = index;
+                break;
+            }
+        }
+        if (view >= kMaxReprojectionViews) { fg_diag_note = "eye not here"; return; }
+        const DcsMotionParameters& p = views[view];
+        const auto& tr = p.target_rect;
+        const auto& tt = p.target_tangents;
+        const auto& w = session.window;
+        if (!(tt[1] > tt[0]) || !(tt[2] > tt[3]) || tr[2] < 1.0F || tr[3] < 1.0F) { fg_diag_note = "no tangents"; return; }
+        const auto px = [&](float tangent) { return tr[0] + (tangent - tt[0]) / (tt[1] - tt[0]) * tr[2]; };
+        const auto py = [&](float tangent) { return tr[1] + (tt[2] - tangent) / (tt[2] - tt[3]) * tr[3]; };
+        const float x0 = std::clamp(px(w[0]), tr[0], tr[0] + tr[2]);
+        const float x1 = std::clamp(px(w[1]), tr[0], tr[0] + tr[2]);
+        const float y0 = std::clamp(py(w[2]), tr[1], tr[1] + tr[3]);
+        const float y1 = std::clamp(py(w[3]), tr[1], tr[1] + tr[3]);
+        UINT rx = static_cast<UINT>(std::floor(x0));
+        UINT ry = static_cast<UINT>(std::floor(y0));
+        UINT rw = static_cast<UINT>(std::ceil(x1)) > rx ? static_cast<UINT>(std::ceil(x1)) - rx : 0U;
+        UINT rh = static_cast<UINT>(std::ceil(y1)) > ry ? static_cast<UINT>(std::ceil(y1)) - ry : 0U;
+        if (rw == 0U || rh == 0U) { fg_diag_note = "window outside"; return; }
+        const UINT64 cap = FgDiagTrigger::get().record_bytes();
+        const UINT64 max_rows = cap / (static_cast<UINT64>(rw) * outputs * kFgDiagRecordBytes);
+        if (max_rows == 0U) { fg_diag_note = "window too wide"; return; }
+        if (rh > max_rows) {
+            ry += (rh - static_cast<UINT>(max_rows)) / 2U;
+            rh = static_cast<UINT>(max_rows);
+        }
+        const UINT64 records = static_cast<UINT64>(rw) * rh * outputs * kFgDiagRecordBytes;
+        const UINT64 need = fg_diag_align(records) + fg_diag_extra_bytes(current);
+        // The buffers, made once (the first pair of the first session here).
+        if (fg_diag_buffer == nullptr && !fg_diag_failed) {
+            fg_diag_failed = true;
+            const D3D12_HEAP_PROPERTIES heap = default_heap_properties(0);
+            D3D12_HEAP_PROPERTIES readback_heap = heap;
+            readback_heap.Type = D3D12_HEAP_TYPE_READBACK;
+            fg_diag_buffer_size = kFgDiagRecordsOffset + cap;
+            const D3D12_RESOURCE_DESC buffer =
+                buffer_description(fg_diag_buffer_size, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+            fg_diag_entry_size = fg_diag_align(cap) + fg_diag_extra_bytes(current) * 2U + (UINT64{8} << 20U);
+            const D3D12_RESOURCE_DESC entry = buffer_description(fg_diag_entry_size, D3D12_RESOURCE_FLAG_NONE);
+            try {
+                fg_diag_ring_count = FgDiagTrigger::get().ring();
+                fg_diag_ring = std::make_unique<FgDiagEntry[]>(fg_diag_ring_count);
+                bool made = SUCCEEDED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                    D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(fg_diag_buffer.GetAddressOf())));
+                for (UINT index = 0; made && index < fg_diag_ring_count; ++index) {
+                    made = SUCCEEDED(device->CreateCommittedResource(&readback_heap, D3D12_HEAP_FLAG_NONE, &entry,
+                        D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(fg_diag_ring[index].readback.GetAddressOf())));
+                    fg_diag_ring[index].size = fg_diag_entry_size;
+                }
+                fg_diag_failed = !made;
+            } catch (...) {
+            }
+            if (fg_diag_failed) {
+                fg_diag_buffer.Reset();
+                fg_diag_ring.reset();
+                fg_diag_ring_count = 0;
+            } else {
+                fg_diag_buffer->SetName(L"OFXR FG diagnosis buffer (dev)");
+            }
+        }
+        if (fg_diag_failed) { fg_diag_note = "buffers not made"; return; }
+        UINT entry = fg_diag_ring_count;
+        for (UINT index = 0; index < fg_diag_ring_count; ++index) {
+            if (!fg_diag_ring[index].busy.load(std::memory_order_acquire)) {
+                entry = index;
+                break;
+            }
+        }
+        if (entry >= fg_diag_ring_count) { fg_diag_note = "ring full"; return; }
+        if (need > fg_diag_ring[entry].size) { fg_diag_note = "entry too small"; return; }
+        try {
+            FgDiagEntry& e = fg_diag_ring[entry];
+            const std::uint32_t index = fg_diag_dumped;
+            e.stem = session.directory /
+                (L"s" + std::to_wstring(hud_allocation_owner()) + L"_p" + std::to_wstring(index));
+            char text[4096];
+            const auto f4 = [](const std::array<float, 4>& a) {
+                char b[160];
+                snprintf(b, sizeof(b), "[%.9g,%.9g,%.9g,%.9g]", a[0], a[1], a[2], a[3]);
+                return std::string(b);
+            };
+            snprintf(text, sizeof(text),
+                "{\"session\":%u,\"tag\":\"%s\",\"owner\":%u,\"pair\":%u,\"line\":%u,\"qpc\":%lld,\"qpcFreq\":%lld,"
+                "\"image\":[%llu,%u,%u],\"format\":%d,\"view\":%u,\"eye\":%u,\"slice\":%u,"
+                "\"current\":{\"displayTime\":%lld,\"maskSeq\":%llu},\"previous\":{\"displayTime\":%lld,\"maskSeq\":%llu},"
+                "\"outputs\":%u,\"fractions\":[%.6f,%.6f],\"rect\":[%u,%u,%u,%u],\"recordBytes\":%llu,"
+                "\"cell\":%u,\"grid\":[%u,%u],\"useGameMotion\":%u,\"qualityBits\":%u,\"motionFlags\":%u,"
+                "\"targetRect\":%s,\"targetTangents\":%s,\"targetToPrevious\":%s,\"sourceRect\":%s,\"sourceFov\":%s,"
+                "\"offset\":%s,\"focusRect\":%s,\"focusFov\":%s,\"focusOffset\":[%.9g,%.9g],\"focusFlags\":%u,"
+                "\"peripheryCell\":%u,\"maskBound\":%d,\"depthBound\":%d",
+                session.id, session.tag.c_str(), hud_allocation_owner(), index, fg_diag_lines,
+                static_cast<long long>(FgDiagTrigger::now()), static_cast<long long>(FgDiagTrigger::get().frequency()),
+                static_cast<unsigned long long>(image_description.Width), image_description.Height,
+                static_cast<UINT>(image_description.DepthOrArraySize), static_cast<int>(view_format), view,
+                session.eye, p.slice, static_cast<long long>(current.display_time),
+                static_cast<unsigned long long>(current.mask_seq), static_cast<long long>(previous.display_time),
+                static_cast<unsigned long long>(previous.mask_seq), outputs, p.fraction0, p.fraction1, rx, ry, rw, rh,
+                static_cast<unsigned long long>(records), p.cell, p.output_width, p.output_height,
+                pair_motion_bits[view] | kDcsMotionDiagBit, quality_bits(), p.flags, f4(p.target_rect).c_str(),
+                f4(p.target_tangents).c_str(), f4(p.target_to_previous).c_str(), f4(p.source_rect).c_str(),
+                f4(p.source_fov).c_str(), f4(p.offset).c_str(), f4(p.focus_rect).c_str(), f4(p.focus_fov).c_str(),
+                p.focus_offset[0], p.focus_offset[1], p.focus_flags, p.periphery_cell, pair_mask_bound ? 1 : 0,
+                pair_depth_bound ? 1 : 0);
+            e.json = text;
+            e.used = 0;
+            e.busy.store(true, std::memory_order_release);
+        } catch (...) {
+            fg_diag_note = "no memory";
+            return;
+        }
+        fg_diag_pair = true;
+        fg_diag_entry_index = entry;
+        fg_diag_view = view;
+        fg_diag_rect = {rx, ry, rw, rh};
+        fg_diag_outputs = outputs;
+        ++fg_diag_dumped;
+        pair_motion_bits[view] |= kDcsMotionDiagBit;
+        fg_diag_bind_uav(slot, true);
+    }
+    // After record_dcs_motion's last barrier (the counters in UAV): the
+    // counters copied into the diagnosis buffer, its header written.
+    void fg_diag_record_header(ID3D12GraphicsCommandList* list) noexcept {
+        if (!fg_diag_pair) return;
+        ComPtr<ID3D12GraphicsCommandList2> list2;
+        if (FAILED(list->QueryInterface(IID_PPV_ARGS(list2.GetAddressOf())))) {
+            // Never reached on Windows 10 1709 or later; the records stay
+            // unwritten (the magic is not there) and the dump says so.
+            fg_diag_note = "no WriteBufferImmediate";
+            return;
+        }
+        const std::array<D3D12_RESOURCE_BARRIER, 2> before{
+            transition_barrier(dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE),
+            transition_barrier(fg_diag_buffer.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST),
+        };
+        list->ResourceBarrier(static_cast<UINT>(before.size()), before.data());
+        list->CopyBufferRegion(fg_diag_buffer.Get(), 0, dcs_motion_counters.Get(), 0, kDcsMotionCounterBytes);
+        const std::array<UINT, 8> values{fg_diag_rect[0], fg_diag_rect[1], fg_diag_rect[2], fg_diag_rect[3],
+            kFgDiagMagic, static_cast<UINT>(kFgDiagRecordsOffset), fg_diag_outputs, 0U};
+        std::array<D3D12_WRITEBUFFERIMMEDIATE_PARAMETER, 8> parameters{};
+        const D3D12_GPU_VIRTUAL_ADDRESS base = fg_diag_buffer->GetGPUVirtualAddress() + kFgDiagHeaderOffset;
+        for (UINT index = 0; index < 8U; ++index) {
+            parameters[index].Dest = base + index * 4U;
+            parameters[index].Value = values[index];
+        }
+        list2->WriteBufferImmediate(static_cast<UINT>(parameters.size()), parameters.data(), nullptr);
+        const std::array<D3D12_RESOURCE_BARRIER, 2> after{
+            transition_barrier(dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
+            transition_barrier(fg_diag_buffer.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
+        };
+        list->ResourceBarrier(static_cast<UINT>(after.size()), after.data());
+    }
+    // In finish_dcs_motion, before its barriers (the diagnosis buffer and the
+    // counters in UAV, the resampled motion readable, the scatter a pixel
+    // shader resource): the counters back from the diagnosis buffer, and the
+    // records, grids and the frame's atlases into the ring entry.
+    void fg_diag_record_copies(ID3D12GraphicsCommandList* list, WorkSlot& slot) noexcept {
+        if (!fg_diag_pair) return;
+        fg_diag_pair = false;
+        FgDiagEntry& e = fg_diag_ring[fg_diag_entry_index];
+        const D3D12CockpitMaskFrame* const current = pair_mask_current.get();
+        const std::array<D3D12_RESOURCE_BARRIER, 4> before{
+            transition_barrier(fg_diag_buffer.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE),
+            transition_barrier(dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_DEST),
+            transition_barrier(pair_motion_target, kShaderReadState, D3D12_RESOURCE_STATE_COPY_SOURCE),
+            transition_barrier(pair_motion_scatter, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_SOURCE),
+        };
+        list->ResourceBarrier(static_cast<UINT>(before.size()), before.data());
+        list->CopyBufferRegion(dcs_motion_counters.Get(), 0, fg_diag_buffer.Get(), 0, kDcsMotionCounterBytes);
+        const UINT64 records = static_cast<UINT64>(fg_diag_rect[2]) * fg_diag_rect[3] * fg_diag_outputs * kFgDiagRecordBytes;
+        list->CopyBufferRegion(e.readback.Get(), 0, fg_diag_buffer.Get(), kFgDiagRecordsOffset, records);
+        std::string layout = ",\"twin\":";
+        layout += fg_diag_twin ? "true" : "false";
+        char b[320];
+        snprintf(b, sizeof(b), ",\"layout\":{\"records\":{\"offset\":0,\"bytes\":%llu}", static_cast<unsigned long long>(records));
+        layout += b;
+        UINT64 offset = fg_diag_align(records);
+        const auto copy = [&](const char* name, ID3D12Resource* resource, UINT subresource, bool more) {
+            D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{};
+            const UINT64 total = fg_diag_footprint(resource, subresource, offset, footprint);
+            D3D12_TEXTURE_COPY_LOCATION destination{};
+            destination.pResource = e.readback.Get();
+            destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+            destination.PlacedFootprint = footprint;
+            D3D12_TEXTURE_COPY_LOCATION source{};
+            source.pResource = resource;
+            source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            source.SubresourceIndex = subresource;
+            list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+            snprintf(b, sizeof(b), "%s{\"offset\":%llu,\"rowPitch\":%u,\"width\":%u,\"height\":%u,\"format\":%d,\"subresource\":%u}%s",
+                name, static_cast<unsigned long long>(footprint.Offset), footprint.Footprint.RowPitch,
+                footprint.Footprint.Width, footprint.Footprint.Height, static_cast<int>(footprint.Footprint.Format),
+                subresource, more ? "," : "");
+            layout += b;
+            offset = fg_diag_align(offset + total);
+        };
+        layout += ",\"grid\":[";
+        for (UINT k = 0; k < 3U; ++k) copy("", pair_motion_target, fg_diag_view * 3U + k, k < 2U);
+        layout += "],\"scatter\":[";
+        for (UINT k = 0; k < 2U; ++k) copy("", pair_motion_scatter, fg_diag_view * 2U + k, k < 1U);
+        layout += "]";
+        if (current != nullptr && current->motion_texture != nullptr) {
+            // The consumer's copies rest in COMMON: promoted to COPY_SOURCE
+            // by this read (a read state, as the resample's).
+            copy(",\"mv\":", current->motion_texture.Get(), 0, false);
+            if (current->motion_class && current->motion_class_texture != nullptr) {
+                copy(",\"class\":", current->motion_class_texture.Get(), 0, false);
+            }
+        }
+        layout += "}";
+        const std::array<D3D12_RESOURCE_BARRIER, 4> after{
+            transition_barrier(fg_diag_buffer.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON),
+            transition_barrier(dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_UNORDERED_ACCESS),
+            transition_barrier(pair_motion_target, D3D12_RESOURCE_STATE_COPY_SOURCE, kShaderReadState),
+            transition_barrier(pair_motion_scatter, D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE),
+        };
+        list->ResourceBarrier(static_cast<UINT>(after.size()), after.data());
+        try {
+            e.json += layout;
+        } catch (...) {
+        }
+        e.used = offset;
+        slot.fg_diag_entry = fg_diag_entry_index + 1U;
+    }
