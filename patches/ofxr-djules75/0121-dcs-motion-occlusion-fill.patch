new file mode 100644
--- /dev/null
+++ b/src/d3d12/dcs_motion_previous.hlsl
@@ -0,0 +1,50 @@
+// DCS Control (0121): [ofxr] dcs_motion_occlusion_fill's view of the PREVIOUS
+// real frame. Every DCS frame carries its class atlas beside its MVs; the
+// pair's previous frame's says what that frame showed where the composition
+// reads it. DcsMotionPreviousClassCS, after the resample (dcs_motion.hlsl),
+// one thread per cell of the current frame's own field (slice Slice * 3):
+// the cell's centre is taken to its direction, that into the previous
+// camera (TargetToPrevious, the rotation the composition maps the previous
+// frame with), to the previous frame's class rect by tangent (SourceRect /
+// SourceFov: the previous frame's rect), and the class found there, as a
+// depth rank, is kept in the cell's flags (w) above the resample's bits:
+// w += 8 * (rank + 1), rank 0 the sky, 1 another G-buffer surface, 2 a model,
+// 3 anything else; nothing where the cell has no MV (w stays 0) or the
+// direction is outside that rect (rank unknown: no bits). The composition
+// (frame_synthesis.hlsl, dcs_motion_occlusion_fill) reads it at the place a
+// vector takes a pixel to in the previous frame.
+//
+// Its own descriptor block (synthesizer: kDcsMotionFillBlock): t1 the previous
+// frame's class rect, u0 the resampled motion; the constants are
+// dcs_motion.hlsl's, in the 62 at b0 (Flags bit 0: the class rect is bound).
+
+#include "dcs_motion.hlsl"
+
+uint dcs_previous_rank(uint klass) {
+    uint composition = klass & 7u;
+    return (klass & 0x80u) != 0u ? 0u : (composition == 1u ? 2u : (composition <= 4u ? 1u : 3u));
+}
+
+[numthreads(8, 8, 1)]
+void DcsMotionPreviousClassCS(uint3 thread_id : SV_DispatchThreadID) {
+    if (thread_id.x >= OutputWidth || thread_id.y >= OutputHeight) {
+        return;
+    }
+    uint3 at = uint3(thread_id.xy, Slice * 3u);
+    float4 cell = MotionTarget[at];
+    uint flags = uint(cell.w + 0.5);
