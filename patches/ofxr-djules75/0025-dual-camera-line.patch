+std::string format_dual_camera_line(const DiagnosticInputs& in, DiagnosticColor& color) {
+    const auto& d = in.dual_camera;
+    if (!d.known || !(d.bits & kDualCameraConfigured)) return {};
+    color = DiagnosticColor::grey;
+    if (d.bits & kDualCameraPaused) {
+        const auto key = diagnostic_hotkey_label(in.dual_camera_hotkey);
+        return key.empty() ? std::string("Dual camera: paused") : "Dual camera: paused (" + key + ")";
+    }
+    if (d.bits & kDualCameraObserve) return "Dual camera: observing";
+    if (d.bits & kDualCameraWaiting) return "Dual camera: waiting for Depth boost";
+    if (!(d.bits & kDualCameraOn)) { color = DiagnosticColor::amber; return "Dual camera: not patching"; }
+    const auto scale = static_cast<unsigned>((d.bits >> 8) & 0xFFU);
+    const auto frames = static_cast<unsigned>((d.bits >> 16) & 0xFFFFU);
+    const auto hundredths = std::to_string(scale % 100U);
+    color = DiagnosticColor::green;
+    return "Dual camera: ON x" + std::to_string(scale / 100U) + "." + (hundredths.size() < 2 ? "0" : "") + hundredths +
+        ", " + std::to_string(frames) + " fps";
 }
 
