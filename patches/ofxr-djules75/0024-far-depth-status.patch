diff --git a/include/xrfg/diagnostic_overlay_model.hpp b/include/xrfg/diagnostic_overlay_model.hpp
--- a/include/xrfg/diagnostic_overlay_model.hpp
+++ b/include/xrfg/diagnostic_overlay_model.hpp
@@ -189,10 +189,15 @@
 // DCS Control (0023): the bundled Quad Views' DcsVr_QuadViewsDisparityStatus()
 // (Far depth): bit 0 on, bit 2 the engine's depth was valid this frame, bit 3
 // the last field is held (a frame without depth). known is false without it.
+// 0024: with DcsVr_QuadViewsDisparityStatus2 (extended): bit 4 switched off by
+// its key, bits 8-15 gain x100, bits 16-31 frames warped in the last second,
+// bits 32-39 HUD coverage % (255 unknown), bits 40-47 frames held.
 struct FarDepthStatus {
     bool known{};
     std::uint64_t bits{};
-};
+    bool extended{};
+};
+inline constexpr std::uint64_t kFarDepthKeyOff = 1ULL << 4;
 inline constexpr std::uint64_t kFarDepthOn = 1ULL << 0;
 inline constexpr std::uint64_t kFarDepthValid = 1ULL << 2;
 inline constexpr std::uint64_t kFarDepthHeld = 1ULL << 3;
@@ -221,6 +226,7 @@
     PupilIpd ipd;
     PeripheryStatus periphery;
     FarDepthStatus far_depth; // 0023
+    DiagnosticHotkey far_depth_hotkey; // 0024: DCSVR_FARDEPTH_HOTKEY
 };
 
 [[nodiscard]] std::string format_dlss_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
diff --git a/src/core/diagnostic_overlay_model.cpp b/src/core/diagnostic_overlay_model.cpp
--- a/src/core/diagnostic_overlay_model.cpp
+++ b/src/core/diagnostic_overlay_model.cpp
@@ -223,10 +223,29 @@
 
 std::string format_far_depth_line(const DiagnosticInputs& in, DiagnosticColor& color) {
     const auto& f = in.far_depth;
-    if (!f.known || !(f.bits & kFarDepthOn)) return {};
-    if (f.bits & (kFarDepthValid | kFarDepthHeld)) { color = DiagnosticColor::green; return "Far depth: ON"; }
-    color = DiagnosticColor::grey;
-    return "Far depth: waiting for engine";
+    if (!f.known) return {};
+    // 0024: switched off by its key, so the A/B shows which side is on screen.
+    if (f.extended && (f.bits & kFarDepthKeyOff)) {
+        color = DiagnosticColor::grey;
+        const auto key = diagnostic_hotkey_label(in.far_depth_hotkey);
+        return key.empty() ? std::string("Far depth: OFF") : "Far depth: OFF (" + key + ")";
+    }
+    if (!(f.bits & kFarDepthOn)) return {};
+    if (!(f.bits & (kFarDepthValid | kFarDepthHeld))) { color = DiagnosticColor::grey; return "Far depth: waiting for engine"; }
+    color = DiagnosticColor::green;
+    std::string text = "Far depth: ON";
+    if (!f.extended) return text;
+    const auto gain = static_cast<unsigned>((f.bits >> 8) & 0xFFU);
+    const auto warped = static_cast<unsigned>((f.bits >> 16) & 0xFFFFU);
+    const auto coverage = static_cast<unsigned>((f.bits >> 32) & 0xFFU);
+    if (gain < 100U) text += " " + std::to_string(gain) + "%";
+    text += ", " + std::to_string(warped) + " fps";
+    if (coverage != 255U) {
+        text += ", HUD " + std::to_string(coverage) + "%";
+        // More than 60% of the view taken as HUD means the coverage is wrong, not the HUD.
+        if (coverage > 60U) color = DiagnosticColor::amber;
+    }
+    return text;
 }
 
