diff --git a/src/layer/openxr_fps_overlay.cpp b/src/layer/openxr_fps_overlay.cpp
--- a/src/layer/openxr_fps_overlay.cpp
+++ b/src/layer/openxr_fps_overlay.cpp
@@ -139,6 +139,8 @@
     unsigned periphery_counter{0x100};
     // DCS Control (0023): Far depth's status, from the same Quad Views module.
     EngineStatusFn far_depth_status{};
+    bool far_depth_extended{};
+    DiagnosticHotkey far_depth_hotkey; // 0024
     HMODULE far_depth_module{};
     std::uint64_t next_far_depth_lookup_ms{};
     std::uint64_t periphery_moved_ms{};
@@ -429,11 +431,18 @@
             const auto tick = GetTickCount64();
             if (tick < next_far_depth_lookup_ms) return;
             next_far_depth_lookup_ms = tick + 2000;
+            // 0024: the extended status first; an older Quad Views has only the first one.
             far_depth_status = lookup_export<EngineStatusFn>(
+                L"XR_APILAYER_MBUCCHIA_quad_views_foveated.dll", "DcsVr_QuadViewsDisparityStatus2", far_depth_module);
+            far_depth_extended = far_depth_status != nullptr;
+            if (!far_depth_status) far_depth_status = lookup_export<EngineStatusFn>(
                 L"XR_APILAYER_MBUCCHIA_quad_views_foveated.dll", "DcsVr_QuadViewsDisparityStatus", far_depth_module);
             if (!far_depth_status) return;
         }
-        inputs.far_depth = {true, far_depth_status()};
+        inputs.far_depth_hotkey = far_depth_hotkey;
+        // The first export returns 32 bits; only the extended one fills the upper half.
+        const auto bits = far_depth_status();
+        inputs.far_depth = {true, far_depth_extended ? bits : (bits & 0xFFFFFFFFULL), far_depth_extended};
     }
 
     // DCS Control (0018): the bundled Quad Views' periphery stability pass.
@@ -575,6 +584,7 @@
     if (!parse_diagnostic_hotkey(environment("DCSVR_ENGINE_HOTKEY"), impl_->engine_hotkey)) impl_->engine_hotkey = {};
     if (!parse_diagnostic_hotkey(environment("DCSVR_PUPIL_HOTKEY"), impl_->pupil_hotkey)) impl_->pupil_hotkey = {};
     if (!parse_diagnostic_hotkey(environment("DCSVR_DEPTH_HOTKEY"), impl_->depth_hotkey)) impl_->depth_hotkey = {};
+    if (!parse_diagnostic_hotkey(environment("DCSVR_FARDEPTH_HOTKEY"), impl_->far_depth_hotkey)) impl_->far_depth_hotkey = {};
     impl_->toggle = DiagnosticToggle(environment("DCSVR_DIAG_OVERLAY") == "1");
 }
