index 0000000..83e009b
--- /dev/null
+++ b/tests/fg_lights.inc
@@ -0,0 +1,638 @@
+// DCS Control (0126): light_single_image ([ofxr] key, kFgQualityLightSingle)
+// against the pilot's night complaint (validation round 08): a distant aircraft
+// seen only as its lights (a spot of about 3 px, ~79 codes over a sky of 0-1)
+// came out of frame generation as two copies of the light 5-7 px apart in every
+// generated frame (ghostW 0.98: a full cross-fade), because a light drawn after
+// DCS's G-buffer has no MV of its own and the optical flow finds no match for a
+// few bright pixels on black. XRFG_TEST_FG_LIGHTS=1 (ctest
+// xrfg_d3d12_fg_lights, NVIDIA hardware, skipped without). Each case is a
+// scene of fg_engine_data.inc (MVs and classes from its opaque layers, the
+// cockpit mask) with lights added in linear light: moving lights (no MVs,
+// optionally with DCS's own fading trail of copies behind them), stars carried
+// by the sky and runway lights carried by the terrain (their layer's MVs), a
+// light crossing from the sky over a dark terrain edge, a sun glint by day, a
+// HUD over the night sky. Every case is composed with the key off and on, in
+// 2X (1/2), at 1/3 alone, in 3X (1/3 and 2/3 in one pass) and on an sRGB view.
+// Per moving light, against the true frame at the instant:
+//   error    |generated - truth| around the light's three places (A, B, the
+//            instant), over the light's own energy there: 0 exact, about 1
+//            for a cross-fade of copies apart
+//   present  the light's peak at its true place, over the truth's
+//   ghostW   fg_ghostfree.py's double-image index along the motion (0: the
+//            correct interpolation, 1: a plain cross-fade), from the exact
+//            light layers (the real-frame control here is the truth itself: 0)
+// Required: with the key the copies gone (<= a quarter of the key off's and
+// <= 0.12) and the light present (>= 0.7) on every moving case; every pixel
+// further than 16 px from a light's places byte for byte the key off's image;
+// the static cases (stars, runway, glint, HUD) byte for byte the key off's.
+// XRFG_TEST_FG_LIGHTS_DUMP=<folder>: the first eye of every frame as raw RGBA
+// with a json of the places, for fg_ghostfree.py's own measures.
+
+struct FlLight {
+    double x0, y0;                // screen px at s = 0
+    double dx, dy;                // px per pair (a real frame to the next)
+    double peak;                  // encoded code (0-255) of its peak over black
+    std::array<double, 3> colour; // relative, the largest 1
+    double sigma{0.75};           // px
+    int trail{};                  // DCS's fading copies behind it, one per earlier frame
+    double fade{0.7};             // each copy's intensity over the one before
+};
+
+// A light fixed in an opaque layer's texture (a star in the sky, a runway
+// light in the terrain): it moves with that layer, as its MVs say.
+struct FlSpot {
+    int shape;                    // the layer it is fixed in (kFeFull with class 0x80: the sky; kFeTerrain)
+    double u, v;                  // texture point
+    double peak;
+    std::array<double, 3> colour;
+    double sigma{0.6};
+};
+
+struct FlCase {
+    std::string name;
+    std::vector<FeLayer> layers;
+    std::vector<FlLight> lights;
+    std::vector<FlSpot> spots;
+};
+
+double fl_decode(double code) {
+    const double e = std::clamp(code / 255.0, 0.0, 1.0);
+    return e <= 0.04045 ? e / 12.92 : std::pow((e + 0.055) / 1.055, 2.4);
+}
+
+double fl_encode(double linear) {
+    const double l = std::clamp(linear, 0.0, 1.0);
+    return 255.0 * (l <= 0.0031308 ? l * 12.92 : 1.055 * std::pow(l, 1.0 / 2.4) - 0.055);
+}
+
+std::array<double, 2> fl_light_place(const FlLight& light, double s) {
+    return {light.x0 + light.dx * s, light.y0 + light.dy * s};
+}
+
+int fl_layer_of(const FlCase& scene, int shape) {
+    for (std::size_t index = 0; index < scene.layers.size(); ++index) {
+        const FeLayer& layer = scene.layers[index];
+        if (!layer.opaque) continue;
+        if (shape == kFeFull ? (layer.klass & 0x80U) != 0U : layer.shape == shape) return static_cast<int>(index);
+    }
+    return -1;
+}
+
+// The scene at instant s, lights added in linear light (`with_lights` false:
+// the background alone), the same image in both eyes.
+StereoPattern fl_frame(const FlCase& scene, UINT width, UINT height, double s, bool with_lights = true) {
+    FeFrame frame = fe_frame(scene.layers, width, height, s);
+    if (!with_lights) return frame.image;
+    const double w = width, h = height;
+    std::vector<double> linear(static_cast<std::size_t>(width) * height * 3U);
+    for (std::size_t i = 0; i < static_cast<std::size_t>(width) * height; ++i) {
+        for (int c = 0; c < 3; ++c) linear[i * 3 + c] = fl_decode(frame.image[0][i * kBytesPerPixel + c]);
+    }
+    const int cockpit = fl_layer_of(scene, kFeCockpit);
+    const auto add = [&](double x, double y, double amplitude, const std::array<double, 3>& colour, double sigma,
+                         int only_on) {
+        const int reach = static_cast<int>(std::ceil(4.0 * sigma)) + 1;
+        for (int py = static_cast<int>(y) - reach; py <= static_cast<int>(y) + reach; ++py) {
+            for (int px = static_cast<int>(x) - reach; px <= static_cast<int>(x) + reach; ++px) {
+                if (px < 0 || py < 0 || px >= int(width) || py >= int(height)) continue;
+                const int front = fe_opaque_at(scene.layers, px + 0.5, py + 0.5, s, w, h);
+                if (only_on >= 0 ? front != only_on : front == cockpit) continue;
+                const double dx = px + 0.5 - x, dy = py + 0.5 - y;
+                const double g = amplitude * std::exp(-(dx * dx + dy * dy) / (2.0 * sigma * sigma));
+                const std::size_t i = static_cast<std::size_t>(py) * width + px;
+                for (int c = 0; c < 3; ++c) linear[i * 3 + c] += g * colour[c];
+            }
+        }
+    };
+    for (const FlSpot& spot : scene.spots) {
+        const int index = fl_layer_of(scene, spot.shape);
+        if (index < 0) continue;
+        const auto at = fe_screen_point(scene.layers[static_cast<std::size_t>(index)], spot.u, spot.v, s, w, h);
+        add(at[0], at[1], fl_decode(spot.peak), spot.colour, spot.sigma, index);
+    }
+    for (const FlLight& light : scene.lights) {
+        double amplitude = fl_decode(light.peak);
+        for (int k = 0; k <= light.trail; ++k) {
+            const auto at = fl_light_place(light, s - k);
+            add(at[0], at[1], amplitude, light.colour, light.sigma, -1);
+            amplitude *= light.fade;
+        }
+    }
+    for (std::size_t i = 0; i < static_cast<std::size_t>(width) * height; ++i) {
+        for (int c = 0; c < 3; ++c) {
+            frame.image[0][i * kBytesPerPixel + c] = static_cast<std::uint8_t>(fl_encode(linear[i * 3 + c]) + 0.5);
+        }
+    }
+    frame.image[1] = frame.image[0];
+    return frame.image;
+}
+
+// A night scene: a near-black sky (codes 0-2), dark terrain below a sloped
+// horizon rolling 1.5 degrees a pair, the cockpit's strut and panel; `hud` a
+// still green HUD over it (no MVs).
+std::vector<FeLayer> fl_night_layers(bool hud, double sky = 0.012, double terrain = 0.06) {
+    const double pi = 3.14159265358979;
+    const double roll = 1.5 * pi / 180.0;
+    std::vector<FeLayer> layers;
+    if (hud) layers.push_back({0, 1.0, 0.0, 0.0, 0.0, kFeHud, 0, 1.0, false, {30.0, 200.0, 45.0}});
+    layers.push_back({2, 1.0, 0.0, 0.0, 0.0, kFeCockpit, 5, 1.0, true, {0.05, 0.05, 0.055}});
+    layers.push_back({0, 1.0, roll, 6.0, 9.0, kFeTerrain, 0, 1.0, true, {terrain, terrain, terrain}});
+    layers.push_back({3, 0.35, roll, 0.0, 0.0, kFeFull, 0x80, 1.0, true, {sky, sky, 1.2 * sky}});
+    return layers;
+}
+
+std::vector<FlCase> fl_cases(UINT width, UINT height) {
+    const double w = width, h = height;
+    std::vector<FlCase> cases;
+    // The pilot's case: a white light of 79 codes, 6 px a pair; a red one
+    // brighter and faster the other way.
+    const FlLight white{w * 0.55, h * 0.16, 6.0, 1.0, 79.0, {1.0, 1.0, 1.0}};
+    const FlLight red{w * 0.30, h * 0.22, -9.0, 2.0, 170.0, {1.0, 0.25, 0.2}, 0.9};
+    cases.push_back({"night lights", fl_night_layers(false), {white, red}, {}});
+    FlLight white_trail = white, red_trail = red;
+    white_trail.trail = red_trail.trail = 5;
+    cases.push_back({"night lights+trail", fl_night_layers(false), {white_trail, red_trail}, {}});
+    // Slow (2 px a pair: the copies overlap) and fast (30 px a pair).
+    cases.push_back({"night light slow+fast", fl_night_layers(false),
+        {FlLight{w * 0.62, h * 0.12, 2.0, 0.5, 120.0, {1.0, 1.0, 1.0}},
+            FlLight{w * 0.25, h * 0.10, 30.0, -3.0, 140.0, {0.3, 1.0, 0.3}}}, {}});
+    // Static stars over the sky (carried by its MVs) and a lit runway on the
+    // terrain (carried by its MVs): nothing to do, byte for byte.
+    std::vector<FlSpot> stars;
+    for (int i = 0; i < 40; ++i) {
+        stars.push_back({kFeFull, w * (0.15 + 0.7 * std::fmod(i * 0.618034, 1.0)),
+            h * (0.04 + 0.28 * std::fmod(i * 0.414214, 1.0)), 40.0 + 6.0 * (i % 12), {1.0, 1.0, 1.0}});
+    }
+    cases.push_back({"night stars", fl_night_layers(false), {}, stars});
+    std::vector<FlSpot> runway;
+    for (int i = 0; i < 24; ++i) {
+        runway.push_back({kFeTerrain, w * 0.42 + i * 9.0, h * 0.68 + i * 1.5, 150.0, {1.0, 0.85, 0.6}});
+        runway.push_back({kFeTerrain, w * 0.42 + i * 9.0, h * 0.72 + i * 1.5, 150.0, {1.0, 0.85, 0.6}});
+    }
+    cases.push_back({"night runway", fl_night_layers(false), {}, runway});
+    // Stars and a runway with a moving light among them.
+    {
+        FlCase mixed{"night stars+runway+light", fl_night_layers(false), {white, red}, stars};
+        mixed.spots.insert(mixed.spots.end(), runway.begin(), runway.end());
+        cases.push_back(mixed);
+    }
+    // A light crossing from the sky over the dark terrain's edge (the horizon
+    // at x: h * 0.45 + 0.08 * (x - w / 2), before the roll).
+    cases.push_back({"night light over terrain edge", fl_night_layers(false),
+        {FlLight{w * 0.70, h * 0.45 + 0.08 * (w * 0.20) - 4.0, -1.0, 7.0, 110.0, {1.0, 0.95, 0.85}}}, {}});
+    // The HUD over the night sky, still; a light passing beside its box.
+    cases.push_back({"night HUD", fl_night_layers(true), {}, {}});
+    cases.push_back({"night HUD+light", fl_night_layers(true),
+        {FlLight{w * 0.36, h * 0.27, 6.0, 1.0, 100.0, {1.0, 1.0, 1.0}}}, {}});
+    // By day: the sun's glint, a bright spot moving over the bright sky, and a
+    // small hard one: never touched.
+    cases.push_back({"day glint", fe_flight_case("day", 1.0, false).layers,
+        {FlLight{w * 0.70, h * 0.15, 5.0, 1.0, 255.0, {1.0, 1.0, 0.95}, 4.0},
+            FlLight{w * 0.40, h * 0.12, 6.0, 0.0, 255.0, {1.0, 1.0, 1.0}, 0.8}}, {}});
+    return cases;
+}
+
+struct FlVariant {
+    std::string name;
+    std::vector<double> instants;  // one: a pair with one synthetic; two: 3X in one pass
+    DXGI_FORMAT view{kFormat};
+};
+
+// The pair (a, b) composed at the variant's instants, with the key or without.
+std::vector<StereoPattern> fl_synthesize(D3D12WarpFixture& fixture, const StereoPattern& a, const StereoPattern& b,
+    UINT width, UINT height, const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>& masks,
+    const FlVariant& variant, bool light, std::uint64_t* light_draws = nullptr) {
+    const ReprojectionViews views = make_reprojection_views();
+    const DXGI_FORMAT saved_texture_format = g_test_texture_format;
+    g_test_texture_format = variant.view == kFormat ? kFormat : DXGI_FORMAT_R8G8B8A8_TYPELESS;
+    std::array<ComPtr<ID3D12Resource>, 2> sources{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    std::array<ComPtr<ID3D12Resource>, 2> currents{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    g_test_texture_format = saved_texture_format;
+    const bool triple = variant.instants.size() == 2U;
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 2> current_out{currents[0].Get(), currents[1].Get()};
+    std::array<ID3D12Resource*, 2> synthetic_out{synthetics[0].Get(), synthetics[1].Get()};
+    upload_pattern(fixture, sources[0].Get(), a);
+    upload_pattern(fixture, sources[1].Get(), b);
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(fixture.device(), fixture.queue(), input, D3D12_RESOURCE_STATE_RENDER_TARGET),
+        "fg lights history");
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.occlusion_aware = 1; // the app's default for Medium
+    options.cockpit_mask = true;
+    options.dcs_motion = true;
+    options.fg_quality = light ? xrfg::kFgQualityLightSingle : 0U;
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(fixture.device(), fixture.queue(), history,
+                        std::span<ID3D12Resource* const>(current_out.data(), current_out.size()),
+                        std::span<ID3D12Resource* const>(synthetic_out.data(), triple ? 2U : 1U), variant.view,
+                        D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::nvidia, options),
+        "fg lights initialize");
+    xrfg::D3D12HistoryCaptureTicket ca{}, cb{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ca), "fg lights A");
+    require_hresult(history->commit(ca), "fg lights commit A");
+    synth.set_cockpit_mask(masks[0]);
+    require_hresult(synth.submit_prime(ca, views, 0, &output), "fg lights prime");
+    fixture.execute_and_wait([](ID3D12GraphicsCommandList*) {});
+    require_hresult(history->capture(1, &cb), "fg lights B");
+    require_hresult(history->commit(cb), "fg lights commit B");
+    synth.set_cockpit_mask(masks[1]);
+    const HRESULT submitted = triple
+        ? synth.submit_pair(cb, views, views, 0, 0, &output, std::nullopt, {}, false,
+              static_cast<float>(variant.instants[0]), xrfg::D3D12ExtraSynthetic{1, static_cast<float>(variant.instants[1])})
+        : synth.submit_pair(cb, views, views, 0, 0, &output, std::nullopt, {}, false,
+              static_cast<float>(variant.instants[0]));
+    require_hresult(submitted, "fg lights pair");
+    std::vector<StereoPattern> images;
+    for (std::size_t index = 0; index < variant.instants.size(); ++index) {
+        images.push_back(readback_pattern(fixture, synthetics[index].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    require_hresult(synth.wait_for_idle(), "fg lights drain");
+    if (light_draws != nullptr) *light_draws = synth.fg_settings().light_draws;
+    // XRFG_TEST_FG_LIGHTS_LIST=1: the list the pair left, view 0.
+    if (light && GetEnvironmentVariableA("XRFG_TEST_FG_LIGHTS_LIST", nullptr, 0) != 0) {
+        const auto words = synth.light_list_for_tests();
+        if (!words.empty()) {
+            const std::uint32_t count = std::min<std::uint32_t>(words[0], 64U);
+            std::cout << "  list (" << variant.name << "): " << words[0] << " entries";
+            for (std::uint32_t i = 0; i < count; ++i) {
+                const std::uint32_t* r = &words[4U + i * 4U];
+                char text[160]{};
+                std::snprintf(text, sizeof(text), " | #%u %s (%.2f,%.2f) r%u peak %.0f best %d first %u", i,
+                    (r[1] & 0x80000000U) != 0U ? "B" : "A", (r[0] & 0xffffU) / 8.0, (r[0] >> 16) / 8.0, (r[1] >> 24) & 3U,
+                    r[3] / 65535.0 * 255.0, (r[2] & 0xffffU) == 0xffffU ? -1 : int(r[2] & 0xffffU), r[2] >> 16);
+                std::cout << text;
+            }
+            std::cout << std::endl;
+        }
+    }
+    fixture.require_no_debug_errors();
+    return images;
+}
+
+double fl_luma(const StereoPattern& image, UINT width, UINT x, UINT y) {
+    const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+    return 0.2126 * image[0][i] + 0.7152 * image[0][i + 1] + 0.0722 * image[0][i + 2];
+}
+
+struct FlMeasure {
+    double copies{};
+    double present{};
+    double ghost_w{};
+    double lead{}; // light ahead of its true place (the leading copy of a cross-fade), over its own energy
+};
+
+// One moving light's measures in a synthetic at instant t (see the top).
+FlMeasure fl_measure(const FlCase& scene, std::size_t which, const StereoPattern& generated, double t, UINT width,
+    UINT height) {
+    const FlLight& light = scene.lights[which];
+    FlCase alone{scene.name, scene.layers, {light}, {}};
+    alone.lights[0].trail = 0;
+    // The light's own layer (the truth less the background, encoded codes
+    // as the images hold them), at A, B and the instant.
+    const StereoPattern background = fl_frame(scene, width, height, t, false);
+    const StereoPattern truth = fl_frame(scene, width, height, t);
+    const StereoPattern only_t = fl_frame(alone, width, height, t);
+    const StereoPattern only_a = fl_frame(alone, width, height, 0.0);
+    const StereoPattern only_b = fl_frame(alone, width, height, 1.0);
+    const StereoPattern bg_a = fl_frame(alone, width, height, 0.0, false);
+    const StereoPattern bg_b = fl_frame(alone, width, height, 1.0, false);
+    const auto pa = fl_light_place(light, 0.0), pb = fl_light_place(light, 1.0), pt = fl_light_place(light, t);
+    const double radius = std::max(4.0, 3.0 * light.sigma + 1.5);
+    const auto close_to = [&](const std::array<double, 2>& p, double x, double y) {
+        return std::hypot(x + 0.5 - p[0], y + 0.5 - p[1]) <= radius;
+    };
+    FlMeasure m;
+    double lead_energy = 0.0;
+    double copy_energy = 0.0, own = 0.0, peak_truth = 0.0, peak_generated = 0.0, num = 0.0, den = 0.0;
+    const int x0 = int(std::min({pa[0], pb[0], pt[0]}) - radius - 2), x1 = int(std::max({pa[0], pb[0], pt[0]}) + radius + 2);
+    const int y0 = int(std::min({pa[1], pb[1], pt[1]}) - radius - 2), y1 = int(std::max({pa[1], pb[1], pt[1]}) + radius + 2);
+    for (int y = std::max(y0, 0); y <= std::min(y1, int(height) - 1); ++y) {
+        for (int x = std::max(x0, 0); x <= std::min(x1, int(width) - 1); ++x) {
+            const double bg = fl_luma(background, width, x, y);
+            const double g = fl_luma(generated, width, x, y) - bg;
+            const double ref = fl_luma(only_t, width, x, y) - bg;
+            const double tr = fl_luma(truth, width, x, y) - bg;
+            if (close_to(pt, x, y)) {
+                peak_truth = std::max(peak_truth, tr);
+                peak_generated = std::max(peak_generated, g);
+            }
+            if (close_to(pt, x, y) || close_to(pa, x, y) || close_to(pb, x, y)) {
+                own += std::max(tr, 0.0);
+                copy_energy += std::abs(g - tr);
+            }
+            {
+                const double mx = light.dx, my = light.dy, len = std::max(std::hypot(mx, my), 1.0e-6);
+                const double ahead = ((x + 0.5 - pt[0]) * mx + (y + 0.5 - pt[1]) * my) / len;
+                const double across = std::abs((x + 0.5 - pt[0]) * my - (y + 0.5 - pt[1]) * mx) / len;
+                if (ahead > radius - 1.0 && across <= radius) lead_energy += std::max(g - std::max(tr, 0.0), 0.0);
+            }
+            // ghostW: EG - ref against the cross-fade's regressor (cA + cB).
+            const double oa = fl_luma(only_a, width, x, y) - fl_luma(bg_a, width, x, y);
+            const double ob = fl_luma(only_b, width, x, y) - fl_luma(bg_b, width, x, y);
+            const double c = (1.0 - t) * (oa - ref) + t * (ob - ref);
+            num += (g - ref) * c;
+            den += c * c;
+        }
+    }
+    m.copies = own > 0.0 ? copy_energy / own : 0.0;
+    m.present = peak_truth > 0.0 ? peak_generated / peak_truth : 0.0;
+    m.ghost_w = den > 1.0e-9 ? num / den : 0.0;
+    m.lead = own > 0.0 ? lead_energy / own : 0.0;
+    return m;
+}
+
+// Whether pixel (x, y) is within `reach` px of any light's place at A, B or the
+// instant (and its trail's copies).
+bool fl_near_light(const FlCase& scene, double x, double y, double reach) {
+    for (const FlLight& light : scene.lights) {
+        for (int k = 0; k <= light.trail + 1; ++k) {
+            for (double s : {0.0, 1.0}) {
+                const auto a = fl_light_place(light, s - k);
+                const auto b = fl_light_place(light, s - k + 1.0);
+                // The segment between two consecutive places.
+                const double vx = b[0] - a[0], vy = b[1] - a[1];
+                const double len2 = vx * vx + vy * vy;
+                double u = len2 > 0.0 ? ((x - a[0]) * vx + (y - a[1]) * vy) / len2 : 0.0;
+                u = std::clamp(u, 0.0, 1.0);
+                if (std::hypot(x - a[0] - u * vx, y - a[1] - u * vy) <= reach) return true;
+            }
+        }
+    }
+    return false;
+}
+
+void fl_dump(const char* folder, const std::string& name, const StereoPattern& image, UINT width, UINT height) {
+    std::string file = std::string(folder) + "\\" + name + ".rgba";
+    for (char& c : file) if (c == ' ' || c == '+' || c == '/') c = '_';
+    std::ofstream out(file, std::ios::binary);
+    out.write(reinterpret_cast<const char*>(image[0].data()), static_cast<std::streamsize>(width) * height * kBytesPerPixel);
+}
+
+void run_fg_lights_fixtures() {
+    D3D12WarpFixture fixture(true);
+    constexpr UINT width = 640, height = 480;
+    const ReprojectionViews views = make_reprojection_views();
+    char dump_folder[512]{};
+    const bool dump = GetEnvironmentVariableA("XRFG_TEST_FG_LIGHTS_DUMP", dump_folder, sizeof(dump_folder)) != 0;
+    std::ofstream places;
+    if (dump) {
+        places.open(std::string(dump_folder) + "\\places.json");
+        places << "{\"width\": " << width << ", \"height\": " << height << ", \"runs\": [\n";
+    }
+    bool first_place = true;
+    const std::vector<FlVariant> variants{{"2X", {0.5}}, {"t1/3", {1.0 / 3.0}},
+        {"3X", {1.0 / 3.0, 2.0 / 3.0}}, {"2X srgb", {0.5}, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB}};
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    std::vector<std::string> failures; // every case runs; the first failure fails the test at the end
+    const auto check = [&](bool ok, const std::string& what) {
+        if (!ok) failures.push_back(what);
+    };
+    for (const FlCase& scene : fl_cases(width, height)) {
+        const StereoPattern a = fl_frame(scene, width, height, 0.0);
+        const StereoPattern b = fl_frame(scene, width, height, 1.0);
+        // Both frames' MVs and classes from the opaque layers (lights have none).
+        const auto previous = fe_mask_frame(fixture, scene.layers, width, height, 10, 10, views, 1000, 500, true,
+            counters, 0.0, -1.0);
+        const auto current = fe_mask_frame(fixture, scene.layers, width, height, 10, 10, views, 2000, 1000, true,
+            counters, 1.0, 0.0);
+        if (dump) {
+            fl_dump(dump_folder, scene.name + " A", a, width, height);
+            fl_dump(dump_folder, scene.name + " B", b, width, height);
+        }
+        double worst_off = 0.0; // the most doubled light without the key, 2X
+        for (const FlVariant& variant : variants) {
+            const auto off = fl_synthesize(fixture, a, b, width, height, {previous, current}, variant, false);
+            std::uint64_t draws = 0;
+            const auto on = fl_synthesize(fixture, a, b, width, height, {previous, current}, variant, true, &draws);
+            for (std::size_t index = 0; index < variant.instants.size(); ++index) {
+                const double t = variant.instants[index];
+                const std::string label = "fg lights " + scene.name + " " + variant.name +
+                    (variant.instants.size() > 1U ? (index == 0U ? " (1/3)" : " (2/3)") : "");
+                std::size_t changed = 0, changed_far = 0;
+                for (UINT y = 0; y < height; ++y) {
+                    for (UINT x = 0; x < width; ++x) {
+                        const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                        bool same = true;
+                        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                            for (int c = 0; c < 4; ++c) same = same && on[index][eye][i + c] == off[index][eye][i + c];
+                        }
+                        if (same) continue;
+                        ++changed;
+                        if (!fl_near_light(scene, x + 0.5, y + 0.5, 16.0)) ++changed_far;
+                    }
+                }
+                const StereoPattern truth = fl_frame(scene, width, height, t);
+                const auto all = [](UINT, UINT, UINT) { return true; };
+                const DepthTestError error_off = depth_test_error(off[index], truth, width, height, all);
+                const DepthTestError error_on = depth_test_error(on[index], truth, width, height, all);
+                std::cout << label << ": " << changed << " px changed (" << changed_far << " far from a light), "
+                          << draws << " light draws, all mae " << error_off.mae << " -> " << error_on.mae;
+                for (std::size_t which = 0; which < scene.lights.size(); ++which) {
+                    const FlMeasure m_off = fl_measure(scene, which, off[index], t, width, height);
+                    const FlMeasure m_on = fl_measure(scene, which, on[index], t, width, height);
+                    const FlMeasure m_truth = fl_measure(scene, which, truth, t, width, height);
+                    char text[256]{};
+                    std::snprintf(text, sizeof(text),
+                        " | light %zu error %.2f -> %.2f present %.2f -> %.2f ghostW %.2f -> %.2f (truth %.2f) lead %.2f -> %.2f",
+                        which, m_off.copies, m_on.copies, m_off.present, m_on.present, m_off.ghost_w, m_on.ghost_w,
+                        m_truth.ghost_w, m_off.lead, m_on.lead);
+                    std::cout << text;
+                    // The day glint is never a light here (bright surroundings):
+                    // it stays as the key off leaves it (checked below).
+                    if (scene.name.rfind("day", 0) == 0) continue;
+                    // With DCS's trail every real frame holds copies behind the
+                    // light (at the other frame's places: ghostW and the error
+                    // see them too); there the leading copy is what must go.
+                    const FlLight& light = scene.lights[which];
+                    if (variant.view == kFormat && variant.instants.size() == 1U && t == 0.5) {
+                        worst_off = std::max(worst_off, m_off.ghost_w);
+                    }
+                    if (light.trail == 0) {
+                        // Copies at least 4 px apart and clearly doubled without
+                        // the key: nearly gone; closer (they overlap, a slow
+                        // light) or a light the flow half followed: not worse.
+                        if (std::hypot(light.dx, light.dy) >= 4.0 && m_off.ghost_w >= 0.3) {
+                            check(m_on.ghost_w <= std::min(0.2, 0.5 * m_off.ghost_w), label + ": the light is still doubled");
+                        } else {
+                            check(m_on.ghost_w <= std::max(m_off.ghost_w, 0.15), label + ": the light is more doubled");
+                        }
+                        check(m_on.copies <= m_off.copies + 0.02, label + ": the light's error grew");
+                    }
+                    // Ahead of the light: the leading copy gone (half at most),
+                    // or, where there was little to begin with (the
+                    // composition's own edge error at a horizon), no more than
+                    // 0.08 more (the 2/3 instant there: 0.14 -> 0.20).
+                    check(m_on.lead <= std::max(0.1, 0.5 * m_off.lead) || m_on.lead <= m_off.lead + 0.08,
+                        label + ": a copy ahead of the light remains");
+                    check(m_on.present >= 0.7, label + ": the light is not where it is at the instant");
+                }
+                std::cout << std::endl;
+                check(changed_far == 0, label + ": pixels away from every light changed");
+                if (scene.lights.empty() || scene.name.rfind("day", 0) == 0) {
+                    check(changed == 0, label + ": a scene without a moving light changed");
+                }
+                if (dump) {
+                    const std::string stem = scene.name + " " + variant.name + " " + std::to_string(index);
+                    fl_dump(dump_folder, stem + " off", off[index], width, height);
+                    fl_dump(dump_folder, stem + " on", on[index], width, height);
+                    fl_dump(dump_folder, stem + " truth", truth, width, height);
+                    fl_dump(dump_folder, stem + " bg", fl_frame(scene, width, height, t, false), width, height);
+                    places << (first_place ? "" : ",\n") << "{\"case\": \"" << scene.name << "\", \"variant\": \""
+                           << variant.name << "\", \"index\": " << index << ", \"t\": " << t << ", \"lights\": [";
+                    first_place = false;
+                    for (std::size_t which = 0; which < scene.lights.size(); ++which) {
+                        const FlLight& l = scene.lights[which];
+                        places << (which ? ", " : "") << "{\"x0\": " << l.x0 << ", \"y0\": " << l.y0 << ", \"dx\": " << l.dx
+                               << ", \"dy\": " << l.dy << ", \"sigma\": " << l.sigma << ", \"trail\": " << l.trail << "}";
+                    }
+                    places << "]}";
+                }
+            }
+        }
+        // The fixture shows the pilot's double light without the key (2X):
+        // at least one light per night case a cross-fade more than half.
+        if (!scene.lights.empty() && scene.name.rfind("night", 0) == 0) {
+            check(worst_off >= 0.5, "fg lights " + scene.name + ": no light doubled without the key (the fixture)");
+        }
+    }
+    if (dump) places << "\n]}\n";
+    for (const std::string& failure : failures) std::cout << "FAILED " << failure << std::endl;
+    require(failures.empty(), failures.empty() ? std::string() : failures.front());
+    fixture.require_no_debug_errors();
+}
+
+// DCS Control (0126): light_single_image's GPU cost at a headset's eye image
+// (XRFG_TEST_FG_LIGHTS_BENCH, label bench). Two synthesizers on the same night
+// frames (two moving lights, stars, a runway), interleaved pair by pair: the
+// key off and on, in 2X and in 3X. The composition's time includes the
+// resample, the scatter and the light passes, as the layer logs it.
+void bench_fg_lights(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    constexpr UINT kFrames = 4;
+    constexpr int kPairs = 240;
+    std::vector<FlCase> cases = fl_cases(width, height);
+    FlCase scene = cases[5]; // stars, a runway and two moving lights
+    const double factor = double(width) / 640.0;
+    for (FeLayer& layer : scene.layers) {
+        layer.dx *= factor;
+        layer.dy *= factor;
+    }
+    for (FlLight& light : scene.lights) {
+        light.dx *= factor;
+        light.dy *= factor;
+    }
+    const UINT divisor = 9;
+    const ReprojectionViews views = make_reprojection_views();
+    const StereoPattern a = fl_frame(scene, width, height, 0.0);
+    const StereoPattern b = fl_frame(scene, width, height, 1.0);
+    for (const bool triple : {false, true}) {
+        struct Pipeline {
+            std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+            std::array<ComPtr<ID3D12Resource>, 2> currents{};
+            std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+            std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+            std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+            std::vector<std::uint64_t> composition;
+            std::vector<std::uint64_t> total;
+        };
+        auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+        std::array<Pipeline, 2> pipelines{};
+        for (UINT index = 0; index < pipelines.size(); ++index) {
+            Pipeline& pipeline = pipelines[index];
+            for (UINT frame = 0; frame < kFrames; ++frame) {
+                pipeline.sources[frame] = create_source_texture(fixture, width, height);
+                upload_pattern(fixture, pipeline.sources[frame].Get(), frame % 2U == 0U ? a : b);
+            }
+            for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+            for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+            std::array<ID3D12Resource*, kFrames> source_pointers{};
+            for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = pipeline.sources[i].Get();
+            std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+            std::array<ID3D12Resource*, 2> synthetic_pointers{pipeline.synthetics[0].Get(), pipeline.synthetics[1].Get()};
+            pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+            require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                        std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                        D3D12_RESOURCE_STATE_RENDER_TARGET)), "fg lights bench: history");
+            xrfg::D3D12NvidiaOpticalFlowOptions options{};
+            options.occlusion_aware = 1;
+            options.cockpit_mask = true;
+            options.dcs_motion = true;
+            options.fg_quality = index == 1 ? xrfg::kFgQualityLightSingle : 0U;
+            pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+            require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                        pipeline.history,
+                        std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                        std::span<ID3D12Resource* const>(synthetic_pointers.data(), triple ? 2U : 1U),
+                        kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                        xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "fg lights bench: synthesizer");
+        }
+        const auto with_b =
+            fe_mask_frame(fixture, scene.layers, width, height, divisor, divisor, views, 0, 0, true, counters);
+        const auto with_a =
+            fe_mask_frame(fixture, scene.layers, width, height, divisor, divisor, views, 0, 0, true, counters, 0.0, 1.0);
+        for (int frame = 0; frame <= kPairs; ++frame) {
+            const UINT slot = static_cast<UINT>(frame) % kFrames;
+            for (Pipeline& pipeline : pipelines) {
+                xrfg::D3D12HistoryCaptureTicket capture{};
+                xrfg::D3D12FrameSynthesisTicket ticket{};
+                require(operation_succeeded(pipeline.history->capture(slot, &capture)) &&
+                            operation_succeeded(pipeline.history->commit(capture)), "fg lights bench: capture");
+                const auto& source = slot % 2U == 0U ? with_a : with_b;
+                auto mask = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+                mask->texture = source->texture;
+                mask->ready_fence = source->ready_fence;
+                mask->ready_value = source->ready_value;
+                mask->views = source->views;
+                mask->motion_texture = source->motion_texture;
+                mask->motion_class_texture = source->motion_class_texture;
+                mask->motion = frame > 0;
+                mask->motion_class = true;
+                mask->motion_views = source->motion_views;
+                mask->motion_slot_flags = source->motion_slot_flags;
+                mask->counters = counters;
+                mask->display_time = 1000 + frame;
+                mask->motion_previous_display_time = 999 + frame;
+                pipeline.synthesizer->set_cockpit_mask(mask);
+                const HRESULT submitted = frame == 0
+                    ? pipeline.synthesizer->submit_prime(capture, views, 0, &ticket)
+                    : triple
+                    ? pipeline.synthesizer->submit_pair(capture, views, views, 0, 1, &ticket, std::nullopt, {}, false,
+                          1.0F / 3.0F, xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                    : pipeline.synthesizer->submit_pair(capture, views, views, 0,
+                          static_cast<std::uint32_t>(frame % 2), &ticket, std::nullopt, {}, false, 0.5F);
+                require(operation_succeeded(submitted), "fg lights bench: submission");
+                require_frame_start_gate(*pipeline.synthesizer, "fg lights bench: frame-start gate");
+                xrfg::D3D12NvidiaGpuTiming timing{};
+                while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                    if (timing.previous_serial == 0) continue;
+                    pipeline.composition.push_back(timing.composition_microseconds);
+                    pipeline.total.push_back(timing.total_microseconds);
+                }
+            }
+        }
+        require(operation_succeeded(pipelines[0].synthesizer->wait_for_idle()) &&
+                    operation_succeeded(pipelines[1].synthesizer->wait_for_idle()), "fg lights bench: idle");
+        const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+            if (values.empty()) return 0;
+            std::sort(values.begin(), values.end());
+            return values[values.size() / 2];
+        };
+        const auto p90 = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+            if (values.empty()) return 0;
+            std::sort(values.begin(), values.end());
+            return values[values.size() * 9 / 10];
+        };
+        std::cout << "fg lights bench " << width << "x" << height << " x2 " << (triple ? "3X" : "2X")
+                  << ": composition median " << median(pipelines[0].composition) << " us key off, "
+                  << median(pipelines[1].composition) << " us on (p90 " << p90(pipelines[0].composition) << " / "
+                  << p90(pipelines[1].composition) << "); whole pair median " << median(pipelines[0].total) << " / "
+                  << median(pipelines[1].total) << " us (" << pipelines[0].composition.size() << "/"
+                  << pipelines[1].composition.size() << " pairs timed; light draws "
+                  << pipelines[1].synthesizer->fg_settings().light_draws << ")" << std::endl;
+    }
+}
