+void run_fg_lights_fixtures() {
+    D3D12WarpFixture fixture(true);
+    constexpr UINT width = 640, height = 480;
+    const ReprojectionViews views = make_reprojection_views();
+    char dump_folder[512]{};
+    const bool dump = GetEnvironmentVariableA("XRFG_TEST_FG_LIGHTS_DUMP", dump_folder, sizeof(dump_folder)) != 0;
+    std::ofstream places;
+    if (dump) {
+        places.open(std::string(dump_folder) + "\\places.json");
+        places << "{\"width\": " << width << ", \"height\": " << height << ", \"runs\": [\n";
+    }
+    bool first_place = true;
+    const std::vector<FlVariant> variants{{"2X", {0.5}}, {"t1/3", {1.0 / 3.0}},
+        {"3X", {1.0 / 3.0, 2.0 / 3.0}}, {"2X srgb", {0.5}, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB}};
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    std::vector<std::string> failures; // every case runs; the first failure fails the test at the end
+    const auto check = [&](bool ok, const std::string& what) {
+        if (!ok) failures.push_back(what);
+    };
+    for (const FlCase& scene : fl_cases(width, height)) {
+        const StereoPattern a = fl_frame(scene, width, height, 0.0);
+        const StereoPattern b = fl_frame(scene, width, height, 1.0);
+        // Both frames' MVs and classes from the opaque layers (lights have none).
+        const auto previous = fe_mask_frame(fixture, scene.layers, width, height, 10, 10, views, 1000, 500, true,
+            counters, 0.0, -1.0);
+        const auto current = fe_mask_frame(fixture, scene.layers, width, height, 10, 10, views, 2000, 1000, true,
+            counters, 1.0, 0.0);
+        if (dump) {
+            fl_dump(dump_folder, scene.name + " A", a, width, height);
+            fl_dump(dump_folder, scene.name + " B", b, width, height);
+        }
+        double worst_off = 0.0; // the most doubled light without the key, 2X
+        for (const FlVariant& variant : variants) {
+            const auto off = fl_synthesize(fixture, a, b, width, height, {previous, current}, variant, false);
+            std::uint64_t draws = 0;
+            const auto on = fl_synthesize(fixture, a, b, width, height, {previous, current}, variant, true, &draws);
+            for (std::size_t index = 0; index < variant.instants.size(); ++index) {
+                const double t = variant.instants[index];
+                const std::string label = "fg lights " + scene.name + " " + variant.name +
+                    (variant.instants.size() > 1U ? (index == 0U ? " (1/3)" : " (2/3)") : "");
+                std::size_t changed = 0, changed_far = 0;
+                for (UINT y = 0; y < height; ++y) {
+                    for (UINT x = 0; x < width; ++x) {
+                        const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                        bool same = true;
+                        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                            for (int c = 0; c < 4; ++c) same = same && on[index][eye][i + c] == off[index][eye][i + c];
+                        }
+                        if (same) continue;
+                        ++changed;
+                        if (!fl_near_light(scene, x + 0.5, y + 0.5, 16.0)) ++changed_far;
+                    }
+                }
+                const StereoPattern truth = fl_frame(scene, width, height, t);
+                const auto all = [](UINT, UINT, UINT) { return true; };
+                const DepthTestError error_off = depth_test_error(off[index], truth, width, height, all);
+                const DepthTestError error_on = depth_test_error(on[index], truth, width, height, all);
+                std::cout << label << ": " << changed << " px changed (" << changed_far << " far from a light), "
+                          << draws << " light draws, all mae " << error_off.mae << " -> " << error_on.mae;
+                for (std::size_t which = 0; which < scene.lights.size(); ++which) {
+                    const FlMeasure m_off = fl_measure(scene, which, off[index], t, width, height);
+                    const FlMeasure m_on = fl_measure(scene, which, on[index], t, width, height);
+                    const FlMeasure m_truth = fl_measure(scene, which, truth, t, width, height);
+                    char text[256]{};
+                    std::snprintf(text, sizeof(text),
+                        " | light %zu error %.2f -> %.2f present %.2f -> %.2f ghostW %.2f -> %.2f (truth %.2f) lead %.2f -> %.2f",
+                        which, m_off.copies, m_on.copies, m_off.present, m_on.present, m_off.ghost_w, m_on.ghost_w,
+                        m_truth.ghost_w, m_off.lead, m_on.lead);
+                    std::cout << text;
+                    // The day glint is never a light here (bright surroundings):
+                    // it stays as the key off leaves it (checked below).
+                    if (scene.name.rfind("day", 0) == 0) continue;
+                    // With DCS's trail every real frame holds copies behind the
+                    // light (at the other frame's places: ghostW and the error
+                    // see them too); there the leading copy is what must go.
+                    const FlLight& light = scene.lights[which];
+                    if (variant.view == kFormat && variant.instants.size() == 1U && t == 0.5) {
+                        worst_off = std::max(worst_off, m_off.ghost_w);
+                    }
+                    if (light.trail == 0) {
+                        // Copies at least 4 px apart and clearly doubled without
+                        // the key: nearly gone; closer (they overlap, a slow
+                        // light) or a light the flow half followed: not worse.
+                        if (std::hypot(light.dx, light.dy) >= 4.0 && m_off.ghost_w >= 0.3) {
+                            check(m_on.ghost_w <= std::min(0.2, 0.5 * m_off.ghost_w), label + ": the light is still doubled");
+                        } else {
+                            check(m_on.ghost_w <= std::max(m_off.ghost_w, 0.15), label + ": the light is more doubled");
+                        }
+                        check(m_on.copies <= m_off.copies + 0.02, label + ": the light's error grew");
+                    }
+                    // Ahead of the light: the leading copy gone (half at most),
+                    // or, where there was little to begin with (the
+                    // composition's own edge error at a horizon), no more than
+                    // 0.08 more (the 2/3 instant there: 0.14 -> 0.20).
+                    check(m_on.lead <= std::max(0.1, 0.5 * m_off.lead) || m_on.lead <= m_off.lead + 0.08,
+                        label + ": a copy ahead of the light remains");
+                    check(m_on.present >= 0.7, label + ": the light is not where it is at the instant");
+                }
+                std::cout << std::endl;
+                check(changed_far == 0, label + ": pixels away from every light changed");
+                if (scene.lights.empty() || scene.name.rfind("day", 0) == 0) {
+                    check(changed == 0, label + ": a scene without a moving light changed");
+                }
+                if (dump) {
+                    const std::string stem = scene.name + " " + variant.name + " " + std::to_string(index);
+                    fl_dump(dump_folder, stem + " off", off[index], width, height);
+                    fl_dump(dump_folder, stem + " on", on[index], width, height);
+                    fl_dump(dump_folder, stem + " truth", truth, width, height);
+                    fl_dump(dump_folder, stem + " bg", fl_frame(scene, width, height, t, false), width, height);
+                    places << (first_place ? "" : ",\n") << "{\"case\": \"" << scene.name << "\", \"variant\": \""
+                           << variant.name << "\", \"index\": " << index << ", \"t\": " << t << ", \"lights\": [";
+                    first_place = false;
+                    for (std::size_t which = 0; which < scene.lights.size(); ++which) {
+                        const FlLight& l = scene.lights[which];
+                        places << (which ? ", " : "") << "{\"x0\": " << l.x0 << ", \"y0\": " << l.y0 << ", \"dx\": " << l.dx
+                               << ", \"dy\": " << l.dy << ", \"sigma\": " << l.sigma << ", \"trail\": " << l.trail << "}";
+                    }
+                    places << "]}";
+                }
+            }
+        }
+        // The fixture shows the pilot's double light without the key (2X):
+        // at least one light per night case a cross-fade more than half.
+        if (!scene.lights.empty() && scene.name.rfind("night", 0) == 0) {
+            check(worst_off >= 0.5, "fg lights " + scene.name + ": no light doubled without the key (the fixture)");
+        }
+    }
+    if (dump) places << "\n]}\n";
+    for (const std::string& failure : failures) std::cout << "FAILED " << failure << std::endl;
+    require(failures.empty(), failures.empty() ? std::string() : failures.front());
+    fixture.require_no_debug_errors();
+}
+
+// DCS Control (0126): light_single_image's GPU cost at a headset's eye image
+// (XRFG_TEST_FG_LIGHTS_BENCH, label bench). Two synthesizers on the same night
+// frames (two moving lights, stars, a runway), interleaved pair by pair: the
+// key off and on, in 2X and in 3X. The composition's time includes the
+// resample, the scatter and the light passes, as the layer logs it.
+void bench_fg_lights(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    constexpr UINT kFrames = 4;
+    constexpr int kPairs = 240;
+    std::vector<FlCase> cases = fl_cases(width, height);
+    FlCase scene = cases[5]; // stars, a runway and two moving lights
+    const double factor = double(width) / 640.0;
+    for (FeLayer& layer : scene.layers) {
+        layer.dx *= factor;
+        layer.dy *= factor;
+    }
+    for (FlLight& light : scene.lights) {
+        light.dx *= factor;
+        light.dy *= factor;
+    }
+    const UINT divisor = 9;
+    const ReprojectionViews views = make_reprojection_views();
+    const StereoPattern a = fl_frame(scene, width, height, 0.0);
+    const StereoPattern b = fl_frame(scene, width, height, 1.0);
+    for (const bool triple : {false, true}) {
+        struct Pipeline {
+            std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+            std::array<ComPtr<ID3D12Resource>, 2> currents{};
+            std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+            std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+            std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+            std::vector<std::uint64_t> composition;
+            std::vector<std::uint64_t> total;
+        };
+        auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+        std::array<Pipeline, 2> pipelines{};
+        for (UINT index = 0; index < pipelines.size(); ++index) {
+            Pipeline& pipeline = pipelines[index];
+            for (UINT frame = 0; frame < kFrames; ++frame) {
+                pipeline.sources[frame] = create_source_texture(fixture, width, height);
+                upload_pattern(fixture, pipeline.sources[frame].Get(), frame % 2U == 0U ? a : b);
+            }
+            for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+            for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+            std::array<ID3D12Resource*, kFrames> source_pointers{};
+            for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = pipeline.sources[i].Get();
+            std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+            std::array<ID3D12Resource*, 2> synthetic_pointers{pipeline.synthetics[0].Get(), pipeline.synthetics[1].Get()};
+            pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+            require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                        std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                        D3D12_RESOURCE_STATE_RENDER_TARGET)), "fg lights bench: history");
+            xrfg::D3D12NvidiaOpticalFlowOptions options{};
+            options.occlusion_aware = 1;
+            options.cockpit_mask = true;
+            options.dcs_motion = true;
+            options.fg_quality = index == 1 ? xrfg::kFgQualityLightSingle : 0U;
+            pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+            require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                        pipeline.history,
+                        std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                        std::span<ID3D12Resource* const>(synthetic_pointers.data(), triple ? 2U : 1U),
+                        kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                        xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "fg lights bench: synthesizer");
+        }
+        const auto with_b =
+            fe_mask_frame(fixture, scene.layers, width, height, divisor, divisor, views, 0, 0, true, counters);
+        const auto with_a =
+            fe_mask_frame(fixture, scene.layers, width, height, divisor, divisor, views, 0, 0, true, counters, 0.0, 1.0);
+        for (int frame = 0; frame <= kPairs; ++frame) {
+            const UINT slot = static_cast<UINT>(frame) % kFrames;
+            for (Pipeline& pipeline : pipelines) {
+                xrfg::D3D12HistoryCaptureTicket capture{};
+                xrfg::D3D12FrameSynthesisTicket ticket{};
+                require(operation_succeeded(pipeline.history->capture(slot, &capture)) &&
+                            operation_succeeded(pipeline.history->commit(capture)), "fg lights bench: capture");
+                const auto& source = slot % 2U == 0U ? with_a : with_b;
+                auto mask = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+                mask->texture = source->texture;
+                mask->ready_fence = source->ready_fence;
+                mask->ready_value = source->ready_value;
+                mask->views = source->views;
+                mask->motion_texture = source->motion_texture;
+                mask->motion_class_texture = source->motion_class_texture;
+                mask->motion = frame > 0;
+                mask->motion_class = true;
+                mask->motion_views = source->motion_views;
+                mask->motion_slot_flags = source->motion_slot_flags;
+                mask->counters = counters;
+                mask->display_time = 1000 + frame;
+                mask->motion_previous_display_time = 999 + frame;
+                pipeline.synthesizer->set_cockpit_mask(mask);
+                const HRESULT submitted = frame == 0
+                    ? pipeline.synthesizer->submit_prime(capture, views, 0, &ticket)
+                    : triple
+                    ? pipeline.synthesizer->submit_pair(capture, views, views, 0, 1, &ticket, std::nullopt, {}, false,
+                          1.0F / 3.0F, xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                    : pipeline.synthesizer->submit_pair(capture, views, views, 0,
+                          static_cast<std::uint32_t>(frame % 2), &ticket, std::nullopt, {}, false, 0.5F);
+                require(operation_succeeded(submitted), "fg lights bench: submission");
+                require_frame_start_gate(*pipeline.synthesizer, "fg lights bench: frame-start gate");
+                xrfg::D3D12NvidiaGpuTiming timing{};
+                while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                    if (timing.previous_serial == 0) continue;
+                    pipeline.composition.push_back(timing.composition_microseconds);
+                    pipeline.total.push_back(timing.total_microseconds);
+                }
+            }
+        }
+        require(operation_succeeded(pipelines[0].synthesizer->wait_for_idle()) &&
+                    operation_succeeded(pipelines[1].synthesizer->wait_for_idle()), "fg lights bench: idle");
+        const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+            if (values.empty()) return 0;
+            std::sort(values.begin(), values.end());
+            return values[values.size() / 2];
+        };
+        const auto p90 = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+            if (values.empty()) return 0;
+            std::sort(values.begin(), values.end());
+            return values[values.size() * 9 / 10];
+        };
+        std::cout << "fg lights bench " << width << "x" << height << " x2 " << (triple ? "3X" : "2X")
+                  << ": composition median " << median(pipelines[0].composition) << " us key off, "
+                  << median(pipelines[1].composition) << " us on (p90 " << p90(pipelines[0].composition) << " / "
+                  << p90(pipelines[1].composition) << "); whole pair median " << median(pipelines[0].total) << " / "
+                  << median(pipelines[1].total) << " us (" << pipelines[0].composition.size() << "/"
+                  << pipelines[1].composition.size() << " pairs timed; light draws "
+                  << pipelines[1].synthesizer->fg_settings().light_draws << ")" << std::endl;
+    }
+}
diff --git a/tests/fg_scene.inc b/tests/fg_scene.inc
new file mode 100644
index 0000000..9a78046
--- /dev/null
+++ b/tests/fg_scene.inc
@@ -0,0 +1,321 @@
+// DCS Control (0126): the synthetic flight scene light_single_image's fixtures
+// (fg_lights.inc) are drawn in. Every scene is drawn exactly at the previous
+// capture (s = 0), the current one (s = 1) and in between (the truth), from
+// rigid layers (front first), with what DCS's G-buffer holds of it: the opaque
+// layers' motion vectors at the render resolution (`divisor` output pixels a
+// texel; 10 is the periphery's MVs where the composed image shows the focus
+// view), their class (stencil composition, bit 7 the sky) and the cockpit mask
+// at the same resolution. Transparent layers (smoke, particles, the HUD) have
+// none. (Taken from the 0.7.1 development series' engine-data fixtures, which
+// were removed with its occlusion fill.)
+
+struct FeLayer {
+    int texture;       // occlusion_texture's layer
+    double scale;      // texture coordinates per pixel
+    double roll;       // radians at s = 1, about the image centre
+    double dx, dy;     // pixels at s = 1
+    int shape;         // fe_cover
+    std::uint8_t klass;
+    double alpha;      // 1 opaque; below, transparent
+    bool opaque;       // in the G-buffer (MVs, class)
+    std::array<double, 3> tint;
+};
+
+// Region ids of FeFrame::front's layers are their indices; these name the shapes.
+enum FeShape : int {
+    kFeFull = 0, kFeWires = 1, kFeModelLow = 2, kFeModelHigh = 3, kFeSmoke = 4, kFeTerrain = 5,
+    kFeCockpit = 6, kFeHud = 7, kFeParticles = 8,
+};
+
+double fe_cover(int shape, double u, double v, double w, double h) {
+    switch (shape) {
+    case kFeWires: {
+        const double line1 = h * 0.40 + 0.06 * (u - w * 0.5);
+        const double line2 = h * 0.58 - 0.04 * (u - w * 0.5);
+        return std::abs(v - line1) < 0.9 || std::abs(v - line2) < 0.7 ? 1.0 : 0.0;
+    }
+    case kFeModelLow: { // an aircraft over the terrain: fuselage and wings
+        const double cx = w * 0.36, cy = h * 0.70;
+        const bool body = std::abs(v - cy) < 9.0 && std::abs(u - cx) < 52.0;
+        const bool wing = std::abs(u - cx + 6.0) < 12.0 + 0.0 * v && std::abs(v - cy) < 40.0;
+        const bool tail = std::abs(u - cx + 46.0) < 6.0 && std::abs(v - cy) < 18.0;
+        return body || wing || tail ? 1.0 : 0.0;
+    }
+    case kFeModelHigh: { // another one in the sky
+        const double cx = w * 0.62, cy = h * 0.22;
+        const bool body = std::abs(v - cy) < 7.0 && std::abs(u - cx) < 40.0;
+        const bool wing = std::abs(u - cx + 4.0) < 9.0 && std::abs(v - cy) < 30.0;
+        return body || wing ? 1.0 : 0.0;
+    }
+    case kFeSmoke: {
+        const double r = std::hypot(u - w * 0.58, v - h * 0.55) / 70.0;
+        return r < 1.0 ? (1.0 - r * r) : 0.0;
+    }
+    case kFeTerrain: // terrain below a sloped horizon
+        return v > h * 0.45 + 0.08 * (u - w * 0.5) ? 1.0 : 0.0;
+    case kFeCockpit: { // a canopy strut and the panel's top edge
+        const bool strut = u > w * 0.12 - 0.25 * (v - h * 0.5) && u < w * 0.12 - 0.25 * (v - h * 0.5) + 14.0;
+        const bool panel = v > h * 0.86 + 0.02 * (u - w * 0.5);
+        return strut || panel ? 1.0 : 0.0;
+    }
+    case kFeHud: {
+        const bool box = u >= w * 0.40 && u < w * 0.60 && v >= h * 0.30 && v < h * 0.46 &&
+            (u < w * 0.40 + 2.0 || u >= w * 0.60 - 2.0 || v < h * 0.30 + 2.0 || v >= h * 0.46 - 2.0);
+        const bool cross = (std::abs(u - w * 0.5) < 1.0 && std::abs(v - h * 0.38) < 14.0) ||
+            (std::abs(v - h * 0.38) < 1.0 && std::abs(u - w * 0.5) < 14.0);
+        return box || cross ? 1.0 : 0.0;
+    }
+    case kFeParticles: { // a cluster of 3 px sparks
+        for (int i = 0; i < 36; ++i) {
+            const double px = w * 0.72 + 70.0 * std::sin(i * 2.399), py = h * 0.66 + 45.0 * std::cos(i * 1.711);
+            if (std::abs(u - px) < 1.5 && std::abs(v - py) < 1.5) return 1.0;
+        }
+        return 0.0;
+    }
+    default:
+        return 1.0;
+    }
+}
+
+std::array<double, 2> fe_texture_point(const FeLayer& layer, double x, double y, double s, double w, double h) {
+    const double a = -layer.roll * s;
+    const double px = x - w * 0.5 - layer.dx * s;
+    const double py = y - h * 0.5 - layer.dy * s;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5, std::sin(a) * px + std::cos(a) * py + h * 0.5};
+}
+
+std::array<double, 2> fe_screen_point(const FeLayer& layer, double u, double v, double s, double w, double h) {
+    const double a = layer.roll * s;
+    const double px = u - w * 0.5, py = v - h * 0.5;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5 + layer.dx * s,
+        std::sin(a) * px + std::cos(a) * py + h * 0.5 + layer.dy * s};
+}
+
+// A layer's colour at texture point (u, v).
+std::array<double, 3> fe_colour(const FeLayer& layer, double u, double v) {
+    if (layer.shape == kFeHud || layer.shape == kFeParticles) return layer.tint;
+    const auto texel = occlusion_texture(u * layer.scale, v * layer.scale, layer.texture);
+    return {texel[0] * layer.tint[0], texel[1] * layer.tint[1], texel[2] * layer.tint[2]};
+}
+
+// Cameras. The scene's layers live in the reference
+// camera's image (the current frame's, identity orientation); a frame drawn by
+// a camera turned by `orientation` (its pose) sees, at its pixel, what the
+// reference image holds at the same direction. Per eye, by its field of view.
+struct FeCamera {
+    const ReprojectionViews* views{};    // the fields of view (the same in every camera)
+    xrfg::Quaternion orientation{0.0F, 0.0F, 0.0F, 1.0F};
+    [[nodiscard]] bool turned() const noexcept {
+        return views != nullptr && std::abs(orientation.w) < 0.9999999F;
+    }
+};
+
+std::array<double, 4> fe_tangents(const ReprojectionViews& views, UINT eye) {
+    const auto& fov = views[eye].fov;
+    return {std::tan(fov.angle_left), std::tan(fov.angle_right), std::tan(fov.angle_up), std::tan(fov.angle_down)};
+}
+
+// A pixel of camera `camera` (eye `eye`) to the reference image's pixel, or
+// the other way (`inverse`); false behind the camera.
+bool fe_map_pixel(const FeCamera& camera, UINT eye, double x, double y, double w, double h, bool inverse,
+    double& out_x, double& out_y) {
+    if (!camera.turned()) {
+        out_x = x;
+        out_y = y;
+        return true;
+    }
+    const auto t = fe_tangents(*camera.views, eye);
+    const double tx = t[0] + x / w * (t[1] - t[0]), ty = t[2] - y / h * (t[2] - t[3]);
+    xrfg::Quaternion q = camera.orientation;
+    if (inverse) {
+        q = {-q.x, -q.y, -q.z, q.w};
+    }
+    const xrfg::Vec3 d = depth_test_rotate(q, {static_cast<float>(tx), static_cast<float>(ty), -1.0F});
+    if (!(d.z < -1.0e-6F)) return false;
+    const double rx = d.x / -d.z, ry = d.y / -d.z;
+    out_x = (rx - t[0]) / (t[1] - t[0]) * w;
+    out_y = (t[2] - ry) / (t[2] - t[3]) * h;
+    return true;
+}
+
+struct FeFrame {
+    StereoPattern image;
+    std::vector<std::int8_t> front; // the front layer's index (a transparent one where it covers > 0.3)
+};
+
+// The colour and front layer at reference-image point (cx, cy), instant s.
+std::array<double, 3> fe_shade(const std::vector<FeLayer>& layers, double cx, double cy, double s, double w, double h,
+    std::int8_t& front_out) {
+    std::array<double, 3> colour{0.0, 0.0, 0.0};
+    std::size_t base = layers.size();
+    for (std::size_t index = 0; index < layers.size(); ++index) {
+        const FeLayer& layer = layers[index];
+        if (!layer.opaque) continue;
+        const auto uv = fe_texture_point(layer, cx, cy, s, w, h);
+        if (fe_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) {
+            colour = fe_colour(layer, uv[0], uv[1]);
+            base = index;
+            break;
+        }
+    }
+    std::int8_t front = static_cast<std::int8_t>(base);
+    for (std::size_t index = base; index-- > 0;) {
+        const FeLayer& layer = layers[index];
+        if (layer.opaque) continue;
+        const auto uv = fe_texture_point(layer, cx, cy, s, w, h);
+        const double cover = fe_cover(layer.shape, uv[0], uv[1], w, h) * layer.alpha;
+        if (cover > 0.0) {
+            const auto overlay = fe_colour(layer, uv[0], uv[1]);
+            for (int c = 0; c < 3; ++c) colour[c] += (overlay[c] - colour[c]) * cover;
+            if (cover > 0.3) front = static_cast<std::int8_t>(index);
+        }
+    }
+    front_out = front;
+    return colour;
+}
+
+// The image at instant s seen by `camera` (the reference camera by default).
+FeFrame fe_frame(const std::vector<FeLayer>& layers, UINT width, UINT height, double s, const FeCamera& camera = {}) {
+    FeFrame frame;
+    frame.front.assign(static_cast<std::size_t>(width) * height, -1);
+    const double w = width, h = height;
+    const UINT eyes = camera.turned() ? kEyeCount : 1U;
+    for (UINT eye = 0; eye < eyes; ++eye) {
+        std::vector<std::uint8_t> bytes(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                double cx = x + 0.5, cy = y + 0.5;
+                std::int8_t front = -1;
+                std::array<double, 3> colour{0.0, 0.0, 0.0};
+                if (fe_map_pixel(camera, eye, x + 0.5, y + 0.5, w, h, false, cx, cy)) {
+                    colour = fe_shade(layers, cx, cy, s, w, h, front);
+                }
+                if (eye == 0) frame.front[static_cast<std::size_t>(y) * width + x] = front;
+                const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                for (int c = 0; c < 3; ++c) bytes[i + c] = static_cast<std::uint8_t>(std::clamp(colour[c], 0.0, 255.0) + 0.5);
+                bytes[i + 3] = 255;
+            }
+        }
+        frame.image[eye] = bytes;
+    }
+    if (eyes == 1U) frame.image[1] = frame.image[0];
+    return frame;
+}
+
+// The front opaque layer at reference point (x, y), instant s (-1 none).
+int fe_opaque_at(const std::vector<FeLayer>& layers, double x, double y, double s, double w, double h) {
+    for (std::size_t index = 0; index < layers.size(); ++index) {
+        const FeLayer& layer = layers[index];
+        if (!layer.opaque) continue;
+        const auto uv = fe_texture_point(layer, x, y, s, w, h);
+        if (fe_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) return static_cast<int>(index);
+    }
+    return -1;
+}
+
+// A frame's mask frame as the consumer hands it on: the cockpit mask and,
+// `with_motion`, the MVs and classes at the render resolution (`divisor`),
+// pointing at `previous_display_time`; the frame is the scene at s = `from`
+// seen by `camera`, the frame its MVs point at the scene at `to` seen by
+// `to_camera` (DCS's MVs carry the head's turn: the content's place in that
+// frame's own image less its place in this one).
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> fe_mask_frame(D3D12WarpFixture& fixture, const std::vector<FeLayer>& layers,
+    UINT width, UINT height, UINT divisor, UINT mask_divisor, const ReprojectionViews& views, std::int64_t display_time,
+    std::int64_t previous_display_time, bool with_motion, const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters,
+    double from = 1.0, double to = 0.0, const FeCamera& camera = {}, const FeCamera& to_camera = {}) {
+    const double w = width, h = height;
+    std::vector<std::uint8_t> cockpit(static_cast<std::size_t>(width) * height, 0);
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            double rx = 0.0, ry = 0.0;
+            if (!fe_map_pixel(camera, 0, x + 0.5, y + 0.5, w, h, false, rx, ry)) continue;
+            const int index = fe_opaque_at(layers, rx, ry, from, w, h);
+            cockpit[static_cast<std::size_t>(y) * width + x] =
+                index >= 0 && (layers[static_cast<std::size_t>(index)].klass & 7U) == 5U ? 1 : 0;
+        }
+    }
+    auto frame = make_cockpit_mask_frame(fixture, width, height, cockpit, mask_divisor, views);
+    frame->display_time = display_time;
+    frame->counters = counters;
+    if (!with_motion) return frame;
+    const UINT d = divisor;
+    const UINT rw = (width + d - 1U) / d, rh = (height + d - 1U) / d;
+    std::vector<std::uint8_t> motion(static_cast<std::size_t>(rw) * kEyeCount * rh * 4U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(rw) * kEyeCount * rh, 0);
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (UINT j = 0; j < rh; ++j) {
+            for (UINT i = 0; i < rw; ++i) {
+                const double x = (i + 0.5) * d, y = (j + 0.5) * d;
+                float mx = 0.0F, my = 0.0F;
+                std::uint8_t klass = 7;
+                double rx = 0.0, ry = 0.0;
+                if (fe_map_pixel(camera, eye, x, y, w, h, false, rx, ry)) {
+                    const int index = fe_opaque_at(layers, rx, ry, from, w, h);
+                    if (index >= 0) {
+                        const FeLayer& layer = layers[static_cast<std::size_t>(index)];
+                        const auto uv = fe_texture_point(layer, rx, ry, from, w, h);
+                        const auto then = fe_screen_point(layer, uv[0], uv[1], to, w, h);
+                        double px = then[0], py = then[1];
+                        if (fe_map_pixel(to_camera, eye, then[0], then[1], w, h, true, px, py)) {
+                            mx = static_cast<float>((px - x) / d);
+                            my = static_cast<float>((py - y) / d);
+                        }
+                        klass = layer.klass;
+                    }
+                }
+                const std::size_t texel = static_cast<std::size_t>(j) * rw * kEyeCount + eye * rw + i;
+                const std::uint16_t hx = dcs_motion_half(mx), hy = dcs_motion_half(my);
+                std::memcpy(&motion[texel * 4U], &hx, 2);
+                std::memcpy(&motion[texel * 4U + 2U], &hy, 2);
+                classes[texel] = klass;
+            }
+        }
+    }
+    frame->motion_texture = upload_depth_test_texture(fixture, rw * kEyeCount, rh, DXGI_FORMAT_R16G16_FLOAT, 4, motion);
+    frame->motion_class_texture = upload_depth_test_texture(fixture, rw * kEyeCount, rh, DXGI_FORMAT_R8_UINT, 1, classes);
+    frame->motion = true;
+    frame->motion_class = true;
+    frame->motion_previous_display_time = previous_display_time;
+    frame->motion_slot_flags = 0x80U | 0x40U | 0x3U;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        auto& view = frame->motion_views[eye];
+        view.valid = true;
+        view.x = eye * rw;
+        view.y = 0;
+        view.width = rw;
+        view.height = rh;
+        // The rect's edges: the last texel may reach past the image.
+        view.fov_tan = {left, left + (right - left) * float(rw * d) / float(width), up,
+            up - (up - down) * float(rh * d) / float(height)};
+    }
+    return frame;
+}
+struct FeCase {
+    const char* name;
+    std::vector<FeLayer> layers;
+};
+
+// The flight scene, day (`dark` 1) or night (0.22): sky, terrain, wires, two
+// aircraft, the cockpit's strut and panel, with or without the effects (HUD,
+// smoke, particles). The world rolls 1.5 degrees a pair and slides.
+FeCase fe_flight_case(const char* name, double dark, bool effects) {
+    const double pi = 3.14159265358979;
+    const double roll = 1.5 * pi / 180.0;
+    const std::array<double, 3> grey{dark, dark, dark};
+    FeCase scene{name, {}};
+    if (effects) {
+        scene.layers.push_back({0, 1.0, 0.0, 0.0, 0.0, kFeHud, 0, 1.0, false, {40.0, 255.0, 60.0}});
+        scene.layers.push_back({0, 1.0, 0.0, 34.0, -22.0, kFeParticles, 0, 1.0, false, {255.0, 220.0, 150.0}});
