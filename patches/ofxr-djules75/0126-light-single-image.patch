+            } else {
+                float distance_px = length(there - at);
+                float ratio = max(float(other.w & 0xffffu), 1.0) / peak;
+                float3 difference = abs(light_chroma(other) - chroma);
+                float hue = difference.r + difference.g + difference.b;
+                [branch] if (distance_px <= kLightReach && ratio >= 0.5 && ratio <= 2.0 && hue <= 0.3) {
+                    // Strictly lower: of repeated entries the first is taken.
+                    float cost = distance_px / kLightReach + 2.0 * abs(log2(ratio)) + hue;
+                    best = cost < best_cost ? j : best;
+                    best_cost = min(cost, best_cost);
+                }
+            }
+        }
+        DcsMotionCounters.Store(base + 16u + instance * 16u + 8u, best | ((first | carried) << 16));
+        // No candidate in the list: the other frame's own brightest pixel
+        // within 3 px of where the MVs put this spot, when it holds the light (at least 60 % of the peak),
+        // to a quarter pixel (3x3 centroid above half its value).
+        [branch] if (best == kLightNone && carried == 0u && first == instance) {
+            float found = -1.0;
+            float2 found_at = at;
+            [loop] for (int dy = -3; dy <= 3; ++dy) {
+                [loop] for (int dx = -3; dx <= 3; ++dx) {
+                    float2 probe = floor(carried_to + 0.5) + float2(dx, dy);
+                    float v = light_luma_at(!mine, probe);
+                    found_at = v > found ? probe : found_at;
+                    found = max(found, v);
+                }
+            }
+            [branch] if (found >= 0.6 * (peak / 65535.0) && found * 0.6 <= peak / 65535.0) {
+                float2 offset_sum = float2(0.0, 0.0);
+                float mass = found * 0.5;
+                [unroll] for (int cy = -1; cy <= 1; ++cy) {
+                    [unroll] for (int cx = -1; cx <= 1; ++cx) {
+                        float w = max(light_luma_at(!mine, found_at + float2(cx, cy)) - found * 0.5, 0.0);
+                        offset_sum += w * float2(cx, cy);
+                        mass += w;
+                    }
+                }
+                float2 there = found_at + clamp(offset_sum / max(mass, 1.0e-5), -0.5, 0.5);
+                int2 code = clamp(int2(round((there - at) * 4.0)), -127, 127) + 128;
+                DcsMotionCounters.Store(base + 16u + instance * 16u + 12u,
+                    (me.w & 0xffffu) | (uint(code.x) << 16) | (uint(code.y) << 24));
+            }
+        }
+    }
+    return output;
+}
+
+FullscreenVertex LightRegionVS(uint vertex_id : SV_VertexID, uint instance : SV_InstanceID) {
+    FullscreenVertex output;
+    output.position = float4(2.0, 2.0, 0.0, 1.0);
+    uint base = light_view_base();
+    uint count = light_count(base);
+    [branch] if (instance < count) {
+        uint4 me = light_record(base, instance);
+        uint partner = light_partner(base, instance, me);
+        bool current = light_from_current(me);
+        // One quad per light: none for a repeated entry, nor for a current
+        // spot drawn with its previous partner.
+        float2 image_there;
+        bool image = partner == kLightNone && light_image_partner(me, image_there);
+        [branch] if ((me.z >> 16) == instance && !(current && partner != kLightNone)) {
+            float t = synthesis_fraction();
+            uint slice = ViewIndex * 3u + 1u + dcs_motion_output();
+            float2 at = light_place(me);
+            float2 motion = dcs_motion_field(at, slice).xy;
+            // Where the composition put this frame's copy.
+            float2 copy = current ? at + (1.0 - t) * motion : at - t * motion;
+            float2 low = min(at, copy);
+            float2 high = max(at, copy);
+            float pad = light_radius(me) + 4.0;
+            [branch] if (partner != kLightNone) {
+                uint4 other = light_record(base, partner);
+                float2 there = light_place(other);
+                float2 there_copy = there + (1.0 - t) * dcs_motion_field(there, slice).xy;
+                low = min(low, min(there, there_copy));
+                high = max(high, max(there, there_copy));
+                pad = max(pad, light_radius(other) + 4.0);
+            } else if (image) {
+                float2 image_copy = current ? image_there - t * motion : image_there + (1.0 - t) * motion;
+                low = min(low, min(image_there, image_copy));
+                high = max(high, max(image_there, image_copy));
+            }
+            float4 rect = PreviousMappings[ViewIndex].TargetRect;
+            low = clamp(low - pad, rect.xy, rect.xy + rect.zw);
+            high = clamp(high + pad + 1.0, rect.xy, rect.xy + rect.zw);
+            static const float2 corners[6] = {
+                float2(0.0, 0.0), float2(1.0, 0.0), float2(0.0, 1.0),
+                float2(1.0, 0.0), float2(1.0, 1.0), float2(0.0, 1.0)};
+            float2 corner = lerp(low, high, corners[min(vertex_id, 5u)]);
+            float2 uv = (corner - rect.xy) / max(rect.zw, float2(1.0, 1.0));
+            output.position = float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
+        }
+    }
+    return output;
+}
+
+float4 LightCompositePS(FullscreenVertex input) : SV_Target {
+    float2 pixel = floor(input.position.xy);
+    [branch] if (cockpit_mask_bound() && cockpit_masked(pixel)) {
+        discard; // the cockpit keeps its own composition
+    }
+    float t = synthesis_fraction();
+    float4 here = dcs_motion_field(pixel, ViewIndex * 3u + 1u + dcs_motion_output());
+    float2 motion = (uint(here.w) & 1u) != 0u && dot(here.xy, here.xy) > kDcsMotionSnap * kDcsMotionSnap
+        ? here.xy : float2(0.0, 0.0);
+    float2 at_previous = pixel + t * motion;
+    float2 at_current = pixel - (1.0 - t) * motion;
+    CameraSample previous = sample_previous_target(at_previous, Slice, ViewIndex);
+    CameraSample current = sample_current_target(at_current, Slice, ViewIndex);
+    [branch] if (previous.valid < 0.5 || current.valid < 0.5) {
+        discard;
+    }
+    uint base = light_view_base();
+    uint count = light_count(base);
+    // Both frames' copies out: a sample on a listed spot of its frame is the
+    // other frame's sample there (the darker of the two where both are).
+    float on_previous = 0.0;
+    float on_current = 0.0;
+    [loop] for (uint i = 0u; i < count; ++i) {
+        uint4 record = light_record(base, i);
+        [branch] if ((record.z >> 16) == i) {
+            bool from_current = light_from_current(record);
+            float w = light_weight(length((from_current ? at_current : at_previous) - light_place(record)),
+                light_radius(record));
+            on_previous = from_current ? on_previous : max(on_previous, w);
+            on_current = from_current ? max(on_current, w) : on_current;
+            float2 there;
+            [branch] if ((record.z & 0xffffu) == kLightNone && light_image_partner(record, there)) {
+                float v = light_weight(length((from_current ? at_previous : at_current) - there), light_radius(record));
+                on_previous = from_current ? max(on_previous, v) : on_previous;
+                on_current = from_current ? on_current : max(on_current, v);
+            }
+        }
+    }
+    float4 darker = min(previous.color, current.color);
+    float4 a = lerp(previous.color, on_current > 0.5 ? darker : current.color, on_previous);
+    float4 b = lerp(current.color, on_previous > 0.5 ? darker : previous.color, on_current);
+    float4 background = lerp(a, b, t);
+    float4 color = background;
+    bool changed = on_previous > 0.0 || on_current > 0.0;
+    // Each light once: a matched pair where it is at this instant; a spot
+    // alone only from the nearer frame, where that frame's copy is.
+    [loop] for (uint k = 0u; k < count; ++k) {
+        uint4 record = light_record(base, k);
+        [branch] if ((record.z >> 16) == k) {
+            bool from_current = light_from_current(record);
+            uint partner = light_partner(base, k, record);
+            float2 previous_place, current_place;
+            float radius;
+            float2 image_there;
+            bool alone = partner == kLightNone && !light_image_partner(record, image_there);
+            [branch] if (light_pair(base, k, record, previous_place, current_place, radius)) {
+                float2 d = current_place - previous_place;
+                float2 place = previous_place + t * d;
+                // Along its path between the two spots (and the pixels' own
+                // motion further) the composition may have left a copy where
+                // the flow half followed the light: the band is composed here
+                // too, the background along the MVs.
+                float2 along = pixel - previous_place;
+                float u = saturate(dot(along, d) / max(dot(d, d), 1.0e-4));
+                // Not at a surface's edge (the field's cell holds one
+                // surface): there the MVs' background is the cell's, coarser
+                // than the composition's.
+                changed = changed || ((uint(here.w) & 2u) != 0u && length(along - u * d) <= radius + 2.0 + length(motion));
+                float w = light_weight(length(pixel - place), radius);
+                [branch] if (w > 0.0) {
+                    float4 la = sample_previous_target(pixel - t * d, Slice, ViewIndex).color;
+                    float4 lb = sample_current_target(pixel + (1.0 - t) * d, Slice, ViewIndex).color;
+                    // Where the two frames' samples agree it is the light
+                    // itself (cross-faded); where they do not, what was
+                    // around it in one frame (the terrain below it, say):
+                    // the darker then, so nothing but the light is moved.
+                    float agree = 1.0 - smoothstep(0.15, 0.4, quality_relative_error(la, lb));
+                    float3 light = lerp(min(la.rgb, lb.rgb), lerp(la.rgb, lb.rgb, t), agree);
+                    color.rgb = max(color.rgb, lerp(background.rgb, light, w));
+                    changed = true;
+                }
+            } else if (alone && (from_current ? t >= 0.5 : t < 0.5)) {
+                float w = light_weight(length((from_current ? at_current : at_previous) - light_place(record)),
+                    light_radius(record));
+                [branch] if (w > 0.0) {
+                    color.rgb = max(color.rgb,
+                        lerp(background.rgb, (from_current ? current.color : previous.color).rgb, w));
+                    changed = true;
+                }
+            }
+        }
+    }
+    [branch] if (!changed) {
+        discard;
+    }
+    return foveated_alpha(input.position.xy, saturate(color));
+}
+#endif
