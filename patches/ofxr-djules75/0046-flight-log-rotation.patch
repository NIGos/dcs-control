+    // DCS Control (0046): the full log becomes <name>.prev<ext>, replacing an
+    // older one, and logging goes on in a new file under the log's own name,
+    // so a wrap keeps one whole earlier segment instead of losing it. The
+    // open file is renamed in place: create_log_file shares it for delete,
+    // which is what lets MoveFileExW move it while this handle stays open.
+    // False, with nothing changed, when the rename cannot be done (an older
+    // .prev held open by a reader without delete sharing) or the new file
+    // cannot be made; the caller then cuts the file back as before 0046.
+    // Exclusive lock held, so no write is in flight on the old handle.
+    [[nodiscard]] bool rotate() noexcept {
+        try {
+            if (path.empty()) {
+                return false;
+            }
+            std::filesystem::path previous = path;
+            previous.replace_filename(
+                path.stem().native() + L".prev" + path.extension().native());
+            if (!MoveFileExW(path.c_str(), previous.c_str(), MOVEFILE_REPLACE_EXISTING)) {
+                return false;
+            }
+            // The same flags as create_log_file (FILE_FLAG_OVERLAPPED matters
+            // for the positioned writes, see there).
+            HANDLE fresh = CreateFileW(
+                path.c_str(),
+                GENERIC_WRITE,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                nullptr,
+                CREATE_ALWAYS,
+                FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OVERLAPPED,
+                nullptr);
+            if (fresh == INVALID_HANDLE_VALUE) {
+                const DWORD error = GetLastError();
+                // Back under its own name, so the fallback cuts the live
+                // log rather than leaving it named .prev. Should that fail
+                // too, the old handle still writes, into the .prev name.
+                static_cast<void>(MoveFileExW(previous.c_str(), path.c_str(), 0));
+                SetLastError(error);
+                return false;
+            }
+            CloseHandle(file);
+            file = fresh;
+            return true;
+        } catch (...) {
+            return false;
+        }
+    }
