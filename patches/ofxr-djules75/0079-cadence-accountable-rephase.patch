+        const auto without = run_rephase_model(false, 2, kOffsetThree, 30 * kMillisecond, true);
+        std::cout << "rephase model, cadence 2, an application too slow for it, the key on:"
+                  << describe(with) << '\n';
+        require(with.rephases >= 2 && with.rephases <= 4,
+            "rephase model: tried a few times, backing off" + describe(with));
+        require(with.frames >= without.frames,
+            "rephase model: and no frame is lost to it" + describe(with));
+    }
