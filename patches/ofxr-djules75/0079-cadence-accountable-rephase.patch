+// DCS Control (0079), GitHub #23: adaptive cadence at the shallow depth, off
+// SteamVR (`[ofxr] cadence_accountable`, on unless set to 0). Three parts:
+// CadenceConfig::three_accountable above, and the two below.
+//
+// Whether a frame's first synthetic handed over `wait_to_submit` after its
+// slot's wait is a missed slot for adaptive cadence. With `deadline` (the
+// key on, a frame of cadence 2 or 3): only from cadence_one_deadline on,
+// half a period, as 0059 has it for 1X and for the same reason - the
+// runtime shows a hand-over 2-5.6 ms after the wait in its slot. The same
+// reporter at a fixed 2X in the good phase: 11% of first synthetics past
+// the 2 ms line (p99 4.8 ms), two or more of them in 33 seconds of 36 - the
+// rule that sends 2 to 3 - and two past half a period in none. Without
+// `deadline`, the 2 ms line as before.
+[[nodiscard]] constexpr bool cadence_leader_missed(
+    Nanoseconds wait_to_submit,
+    Nanoseconds period,
+    bool deadline) noexcept {
+    if (!deadline || period <= 0) {
+        return submission_late(wait_to_submit);
+    }
+    return submission_late(wait_to_submit) &&
+        wait_to_submit >= cadence_one_deadline(period);
+}
+
+// The once-per-frame hold releases the application when the presenter has
+// run the frame's cadence in frames since the last release, and which slot
+// that count started from is whatever it was left at: by the start, by a
+// slot with nothing fresh in it, by a visit to 1X. Counted from the slot of
+// the frame's last-but-one submission the application's next frame is
+// queued before its first synthetic is due, whatever the release offset;
+// counted from the slot of its real frame, it arrives the release offset
+// and its own time later, which past a period is after the first
+// synthetic's slot has opened - the presenter waits there with nothing
+// queued and hands every first synthetic over late - and nothing moves the
+// count back: the release offset is steered modulo one period, and a
+// change of cadence keeps the count where it is (measured: 98-99% of first
+// synthetics late at 3, and every one of the 6-9 frames of each return to
+// 2).
+//
+// So when kStreak first synthetics in a row were handed over late, one
+// hold waits for one presenter frame less than the frame's cadence (and
+// counts the next from where it then is): the release is a slot earlier
+// from then on and the frame is queued ahead of its first synthetic's
+// slot, at 2 and at 3, and through a change between them. The frame lands
+// in the slots it would have; what is paid is the period of queue every
+// on-time session has. The release is then a period further from where
+// its frame lands, so the caller counts the told time's estimate from a
+// period later from then on (an application that waits a frame ahead had
+// the estimate two periods from the told time already, and a third
+// restarted it: told times repeated, 42 frames shown off their time in
+// the call chain's cadence scenario at the shallow depth). Where the hold
+// was not waiting anyway (an application too slow for its cadence is late
+// as well) it changes nothing, so it is not used again for
+// kFirstInterval, and for twice the wait before each time it is needed
+// again within twice that wait.
+struct ReleaseRephase {
+    static constexpr std::uint32_t kStreak = 8;
+    static constexpr Nanoseconds kFirstInterval = 5 * kSecond;
+    static constexpr Nanoseconds kMaxInterval = 80 * kSecond;
+
+    Nanoseconds interval{kFirstInterval};
+    Nanoseconds last{-1};
+    std::uint32_t uses{};
+
+    // Whether the hold entered at `now` waits one presenter frame less,
+    // `streak` first synthetics in a row having been handed over late.
+    [[nodiscard]] constexpr bool due(
+        std::uint32_t streak, Nanoseconds now) const noexcept {
+        return streak >= kStreak && (last < 0 || now - last >= interval);
+    }
+    // That hold released the application.
+    constexpr void used(Nanoseconds now) noexcept {
+        if (last >= 0 && now - last < 2 * interval) {
+            interval = interval * 2 > kMaxInterval ? kMaxInterval : interval * 2;
+        } else {
+            interval = kFirstInterval;
+        }
+        last = now;
+        ++uses;
+    }
+};
+
 } // namespace xrfg::latency
