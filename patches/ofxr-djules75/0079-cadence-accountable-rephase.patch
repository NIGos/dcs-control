+            std::cout << "accountable, light, a missed slot every frame, on" << name << ":"
+                      << describe_accountable(r) << '\n';
+            require(r.final_level == 2 && r.miss_hold,
+                "accountable: back at 2 with the hold" + name + describe_accountable(r));
+            require(r.no_gain == 1,
+                "accountable: one no-gain return" + name + describe_accountable(r));
