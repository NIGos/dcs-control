+void cadence_accountable_tests() {
+    const auto light = [](std::uint64_t, Nanoseconds) { return kAccountLight; };
+    const auto between = [](std::uint64_t, Nanoseconds) { return kAccountBetween; };
+    const auto heavy = [](std::uint64_t, Nanoseconds) { return kAccountHeavy; };
+    const auto none = [](std::uint32_t, std::uint64_t, Nanoseconds) { return 0U; };
+    const auto every = [](std::uint32_t, std::uint64_t, Nanoseconds) { return 1U; };
+    const auto at_two = [](std::uint32_t level, std::uint64_t, Nanoseconds) {
+        return level == 2 ? 1U : 0U;
+    };
