+void release_rephase_tests() {
+    // The rule: eight late in a row, then not again for 5 s, and for twice
+    // the wait each time it is needed again within twice that wait.
+    {
+        ReleaseRephase rephase;
+        require(!rephase.due(0, 0) && !rephase.due(7, 0) && rephase.due(8, 0),
+            "rephase: due on eight late first synthetics in a row");
+        rephase.used(1 * kSecond);
+        require(rephase.interval == ReleaseRephase::kFirstInterval &&
+                !rephase.due(100, 5 * kSecond) && rephase.due(8, 6 * kSecond) &&
+                !rephase.due(7, 60 * kSecond),
+            "rephase: not again within the first interval");
+        rephase.used(6 * kSecond);
+        require(rephase.interval == 10 * kSecond && !rephase.due(8, 15 * kSecond) &&
+                rephase.due(8, 16 * kSecond),
+            "rephase: needed again at once, the wait doubles");
+        Nanoseconds at = 6 * kSecond;
+        for (int index = 0; index < 6; ++index) {
+            at += rephase.interval;
+            rephase.used(at);
+        }
+        require(rephase.interval == ReleaseRephase::kMaxInterval,
+            "rephase: the wait stops at its ceiling");
+        rephase.used(at + 200 * kSecond);
+        require(rephase.interval == ReleaseRephase::kFirstInterval && rephase.uses == 9,
+            "rephase: after a long quiet stretch the first interval again");
+    }
+    const auto describe = [](const RephaseModelResult& r) {
+        return " (frames " + std::to_string(r.frames) + ", re-phased " +
+            std::to_string(r.rephases) + ", late first synthetics: first second " +
+            std::to_string(r.late_first) + " of " + std::to_string(r.leaders_first) +
+            ", last five " + std::to_string(r.late_last) + " of " +
+            std::to_string(r.leaders_last) + ", after the switch " +
+            std::to_string(r.late_after) + " of " + std::to_string(r.leaders_after) + ")";
+    };
+    // The reporter's 3 (GitHub #23): a release offset of 8.8 ms and 5.9 ms
+    // from the release to the application's xrEndFrame, the count on the
+    // real frame's slot: every first synthetic 3.6 ms late, for good - and
+    // every one of the frames of 2 after a change of cadence as well.
+    constexpr Nanoseconds kOffsetThree = 8'800'000;
+    constexpr Nanoseconds kWorkThree = 5'900'000;
+    {
+        const auto r = run_rephase_model(false, 3, kOffsetThree, kWorkThree, true,
+            10 * kSecond, 2);
+        std::cout << "rephase model, cadence 3 then 2, the count a slot off, the key off:"
+                  << describe(r) << '\n';
+        require(r.rephases == 0 && r.leaders_last > 200 && r.late_last == r.leaders_last,
+            "rephase model: without it every first synthetic stays late" + describe(r));
+        require(r.leaders_after > 300 && r.late_after == r.leaders_after,
+            "rephase model: and at 2 after the change as well" + describe(r));
+    }
+    // With it: one hold a presenter frame short within the first second,
+    // then on time at 3, and at 2 from the first frame after the change.
+    {
+        const auto r = run_rephase_model(true, 3, kOffsetThree, kWorkThree, true,
+            10 * kSecond, 2);
+        std::cout << "rephase model, cadence 3 then 2, the count a slot off, the key on:"
+                  << describe(r) << '\n';
+        require(r.rephases == 1,
+            "rephase model: one re-phase" + describe(r));
+        require(r.late_first >= 8 && r.late_first <= 10,
+            "rephase model: after eight late first synthetics" + describe(r));
+        require(r.leaders_last > 200 && r.late_last == 0,
+            "rephase model: then on time" + describe(r));
+        require(r.leaders_after > 300 && r.late_after == 0,
+            "rephase model: and at 2 from the first frame after the change" + describe(r));
+    }
+    // Our own flights after a visit to 1X at 2: offset 10.9 ms and 7 ms of
+    // the application, every first synthetic 6.8 ms late; with the
+    // re-phase, on time within a few frames.
+    {
+        const auto without = run_rephase_model(false, 2, 10'900'000, 7 * kMillisecond, true);
+        const auto with = run_rephase_model(true, 2, 10'900'000, 7 * kMillisecond, true);
+        std::cout << "rephase model, cadence 2, the count a slot off, the key off:"
+                  << describe(without) << '\n';
+        std::cout << "rephase model, cadence 2, the count a slot off, the key on:"
+                  << describe(with) << '\n';
+        require(without.late_last == without.leaders_last && without.leaders_last > 200,
+            "rephase model: 2 stays late without it" + describe(without));
+        require(with.rephases == 1 && with.late_last == 0 && with.leaders_last > 200 &&
+                with.late_first <= 12,
+            "rephase model: 2 is on time with it" + describe(with));
+        require(with.frames == without.frames || with.frames == without.frames + 1,
+            "rephase model: the frame rate is the cadence's either way" + describe(with));
+    }
+    // A session whose count is where it should be: never used, and nothing
+    // differs from the key off.
+    for (const std::uint32_t cadence : {2U, 3U}) {
+        const auto with = run_rephase_model(true, cadence, kOffsetThree, kWorkThree, false);
+        const auto without = run_rephase_model(false, cadence, kOffsetThree, kWorkThree, false);
+        require(with.rephases == 0 && with.late_first == 0 && with.late_last == 0 &&
+                with.frames == without.frames && with.leaders_last == without.leaders_last,
+            "rephase model: a healthy session is left alone" + describe(with));
+    }
+    // An application too slow for its cadence (30 ms of its own at 2) is
