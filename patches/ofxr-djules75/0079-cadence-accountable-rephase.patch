+// ---------------------------------------------------------------------------
+// DCS Control (0079): adaptive cadence answering for its missed slots
+// (GitHub #23): CadenceConfig::three_accountable, cadence_leader_missed and
+// ReleaseRephase.
+
+constexpr Nanoseconds kAccountLight = 12 * kMillisecond;   // 54% of two periods
+constexpr Nanoseconds kAccountBetween = 20 * kMillisecond; // over 85%, under 95%
+constexpr Nanoseconds kAccountHeavy = 25 * kMillisecond;   // over 95% of 22.2 ms
+
+struct AccountableRun {
+    std::uint32_t final_level{};
+    std::uint32_t changes{};
+    // The second half of the run: frames, those of cadence 3, changes.
+    std::uint32_t frames_last{};
+    std::uint32_t three_last{};
+    std::uint32_t changes_last{};
+    std::uint32_t no_gain{};
+    std::uint32_t lifted{};
+    std::uint32_t max_run_required{};
+    bool miss_hold{};
+    // Each decision: the level, the run a return needs, the event.
+    std::vector<std::uint32_t> trace;
+};
+
+// CadenceSim over `duration` with the application's work (CPU and GPU the
+// same, too much for 1X) from `work(index, since the start)` and the slots
+// each frame missed from `missed(level, index, since the start)`.
+template <typename Work, typename Missed>
+AccountableRun run_accountable(
+    CadenceConfig config, Nanoseconds duration, Work work, Missed missed) {
+    CadenceSim sim(config);
+    AccountableRun run{};
+    const Nanoseconds end = sim.now + duration;
+    const Nanoseconds half = sim.now + duration / 2;
+    std::uint64_t index = 0;
+    while (sim.now < end) {
+        const std::uint32_t level = sim.controller.level();
+        // When this frame ends (CadenceSim::frame advances by the same).
+        const Nanoseconds at = sim.now + kPeriod * level;
+        const std::uint32_t count = missed(level, index, at - sim.started);
+        if (count != 0) {
+            sim.controller.add_late(at, count);
+        }
+        const Nanoseconds cost = work(index, at - sim.started);
+        const CadenceStep step = sim.frame(cost, cost);
+        run.max_run_required = std::max(run.max_run_required, step.run_required);
+        run.no_gain += step.event == CadenceEvent::three_left_no_gain ? 1U : 0U;
+        run.lifted += step.event == CadenceEvent::miss_hold_lifted ? 1U : 0U;
+        if (sim.now > half) {
+            ++run.frames_last;
+            run.three_last += step.level == 3 ? 1U : 0U;
+            run.changes_last += step.level != step.previous ? 1U : 0U;
+        }
+        run.trace.push_back(step.level * 100'000U + step.run_required * 10U +
+            static_cast<std::uint32_t>(step.event));
+        ++index;
+    }
+    run.final_level = sim.controller.level();
+    run.changes = sim.changes;
+    run.miss_hold = sim.controller.miss_hold();
+    return run;
+}
+
+std::string describe_accountable(const AccountableRun& run) {
+    return " (level " + std::to_string(run.final_level) + ", changes " +
+        std::to_string(run.changes) + ", in the second half " +
+        std::to_string(run.changes_last) + ", frames of 3 there " +
+        std::to_string(run.three_last) + " of " + std::to_string(run.frames_last) +
+        ", no-gain returns " + std::to_string(run.no_gain) + ", holds lifted " +
+        std::to_string(run.lifted) + ", longest run required " +
+        std::to_string(run.max_run_required) + ", hold " +
+        std::to_string(run.miss_hold ? 1 : 0) + ")";
+}
