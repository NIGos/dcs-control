+    for (const CadencePreference preference :
+         {CadencePreference::steady, CadencePreference::balanced, CadencePreference::rate}) {
+        const CadenceConfig off = cadence_config_for(preference);
+        CadenceConfig on = off;
+        on.three_accountable = true;
