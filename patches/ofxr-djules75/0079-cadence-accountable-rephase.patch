+
+// The once-per-frame hold and the presenter, in 50 us steps, with nothing of
+// the layer but ReleaseRephase and submission_late: the presenter takes one
+// submission per display period, counts a frame at each slot's wait and,
+// with nothing queued, waits in the slot for the next submission; the
+// application queues a frame's submissions (its first synthetic first, its
+// real frame last), is held until the presenter has counted the frame's
+// cadence since the last release, sleeps `offset` and works `work`.
+// `late_start`: the count starts on the slot of the real frame (what a slot
+// with nothing fresh in it or a visit to 1X leave behind); otherwise on the
+// slot before it.
+struct RephaseModelResult {
+    int frames{};
+    int rephases{};
+    // First synthetics handed over, and those late: the first second, the
+    // last five, and the frames of the cadence switched to.
+    int leaders_first{};
+    int late_first{};
+    int leaders_last{};
+    int late_last{};
+    int leaders_after{};
+    int late_after{};
+};
+
+RephaseModelResult run_rephase_model(
+    bool enabled,
+    std::uint32_t cadence,
+    Nanoseconds offset,
+    Nanoseconds work,
+    bool late_start,
+    Nanoseconds switch_at = 0,
+    std::uint32_t switch_cadence = 0) {
+    constexpr Nanoseconds kTick = 50'000;
+    constexpr Nanoseconds kTotal = 20 * kSecond;
+    struct Item {
+        bool leader{};
+        std::uint32_t cadence{};
+    };
+    RephaseModelResult result{};
+    std::deque<Item> queue;
+    std::uint64_t serial = late_start ? 0U : 1U;
+    std::uint64_t served = 0;
+    // The presenter: its next slot's wait returns at `slot_at`; `slot_open`
+    // is the wait of a slot still without its submission (-1: none open).
+    Nanoseconds slot_at = kPeriod;
+    Nanoseconds slot_open = -1;
+    // The application: 0 working until `app_at`, 1 held, 2 sleeping the
+    // release offset until `app_at`.
+    int app = 0;
+    Nanoseconds app_at = kMillisecond;
+    std::uint32_t frame_cadence = cadence;
+    std::uint64_t hold_frames = 0;
+    std::uint64_t shift = 0;
+    std::uint32_t streak = 0;
+    ReleaseRephase rephase;
+    for (Nanoseconds now = 0; now < kTotal; now += kTick) {
+        if (slot_open < 0 && now >= slot_at) {
+            ++serial;
+            slot_open = slot_at;
+        }
+        if (slot_open >= 0 && !queue.empty()) {
+            const Item item = queue.front();
+            queue.pop_front();
+            if (item.leader) {
+                const bool late = submission_late(now - slot_open);
+                streak = late ? streak + 1 : 0;
+                if (now < kSecond) {
+                    ++result.leaders_first;
+                    result.late_first += late ? 1 : 0;
+                }
+                if (now >= kTotal - 5 * kSecond) {
+                    ++result.leaders_last;
+                    result.late_last += late ? 1 : 0;
+                }
+                if (switch_at > 0 && item.cadence == switch_cadence) {
+                    ++result.leaders_after;
+                    result.late_after += late ? 1 : 0;
+                }
+            }
+            // The runtime's next wait returns at the next slot.
+            slot_at = (now / kPeriod + 1) * kPeriod;
+            slot_open = -1;
+        }
+        if (app == 0 && now >= app_at) {
+            queue.push_back(Item{true, frame_cadence});
+            for (std::uint32_t rest = 1; rest < frame_cadence; ++rest) {
+                queue.push_back(Item{false, frame_cadence});
+            }
+            hold_frames = frame_cadence;
+            shift = 0;
+            if (enabled && rephase.due(streak, now)) {
+                shift = 1;
+                rephase.used(now);
+                streak = 0;
+                ++result.rephases;
+            }
+            app = 1;
+            ++result.frames;
+        }
+        if (app == 1 && serial + shift >= served + hold_frames) {
+            // Not credited with the shift: the next hold is the frame's own
+            // count again.
+            served = serial;
+            app = 2;
+            app_at = now + offset;
+        }
+        if (app == 2 && now >= app_at) {
+            app = 0;
+            app_at = now + work;
+            frame_cadence = switch_at > 0 && now >= switch_at ? switch_cadence : cadence;
+        }
+    }
+    return result;
+}
