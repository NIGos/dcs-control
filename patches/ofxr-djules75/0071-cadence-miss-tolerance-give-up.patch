 }
@@ -1612,6 +1644,12 @@ public:
 
     [[nodiscard]] std::uint32_t level() const noexcept { return level_; }
     [[nodiscard]] Nanoseconds backoff() const noexcept { return backoff_; }
+    // DCS Control (0071): 1X failed one_max_failed times in a row and is
+    // not tried again until the scene changes.
+    [[nodiscard]] bool one_given_up() const noexcept {
+        return config_.one_max_failed != 0 &&
+            failed_in_row_ >= config_.one_max_failed;
+    }
     [[nodiscard]] Nanoseconds one_allowed_at() const noexcept {
         return one_allowed_at_;
     }
@@ -1656,6 +1694,8 @@ private:
     Nanoseconds one_entered_at_{-1};
     Nanoseconds one_allowed_at_{};
     Nanoseconds backoff_{};
+    // DCS Control (0071): attempts at 1X failed in a row (one_max_failed).
+    std::uint32_t failed_in_row_{};
     bool three_allowed_{true}; // DCS Control (0034)
 };
 
diff --git a/src/core/latency_control.cpp b/src/core/latency_control.cpp
--- a/src/core/latency_control.cpp
+++ b/src/core/latency_control.cpp
@@ -1009,6 +1009,7 @@ void CadenceController::start(Nanoseconds now) noexcept {
     // Nothing into or out of 1X yet: the spacing does not apply.
     one_allowed_at_ = now;
     backoff_ = 0;
+    failed_in_row_ = 0; // DCS Control (0071)
 }
 
 void CadenceController::add_frame(
@@ -1034,7 +1035,10 @@ void CadenceController::add_late(Nanoseconds at, std::uint32_t count) noexcept {
     if (late_count_ != 0) {
         const Nanoseconds episode =
             late_at_[(late_next_ + kLateEvents - 1) % kLateEvents];
-        if (at >= episode && at - episode < config_.late_episode_gap) {
+        // DCS Control (0071): 1X's own gap (CadencePreference).
+        const Nanoseconds gap = level_ == 1 ? config_.one_late_episode_gap
+                                            : config_.late_episode_gap;
+        if (at >= episode && at - episode < gap) {
             return;
         }
     }
@@ -1100,10 +1104,17 @@ void CadenceController::leave_one(
         backoff_ = backoff_ <= 0
             ? config_.one_backoff_first
             : std::min(backoff_ * 2, config_.one_backoff_max);
+        ++failed_in_row_; // DCS Control (0071)
     } else if (held >= config_.one_reset_after) {
         backoff_ = 0;
+        failed_in_row_ = 0;
     }
     one_allowed_at_ = now + std::max(config_.one_spacing, failed ? backoff_ : 0);
+    // DCS Control (0071): failed too often in a row: not again in this scene
+    // (scene_changed and start allow it again).
+    if (one_given_up()) {
+        one_allowed_at_ = now + 86'400 * kSecond;
+    }
     // Slots missed at 1X say nothing about 2: they would send it on to 3.
     late_count_ = 0;
     late_next_ = 0;
@@ -1138,6 +1149,7 @@ CadenceStep CadenceController::decide(Nanoseconds now, Nanoseconds period) noexc
             now);
         if (now - one_entered_at_ >= config_.one_reset_after) {
             backoff_ = 0;
+            failed_in_row_ = 0; // DCS Control (0071)
         }
         if (now >= one_entered_at_ + config_.one_grace) {
             // DCS Control (0070): the slower miss rule, and the p90 only
@@ -1244,6 +1256,12 @@ CadenceStep CadenceController::scene_changed(Nanoseconds now) noexcept {
     if (level_ == 1) {
         leave_one(now, CadenceEvent::one_left_scene, step);
     }
+    // DCS Control (0071): a new scene may hold 1X where the last did not:
+    // it is tried again (after the spacing, and what is left of the backoff).
+    if (one_given_up()) {
+        one_allowed_at_ = now + std::max(config_.one_spacing, backoff_);
+    }
+    failed_in_row_ = 0;
     level_ = 2;
     level_since_ = now;
     run_three_ = 0;
diff --git a/tests/latency_control_tests.cpp b/tests/latency_control_tests.cpp
