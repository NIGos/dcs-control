-                while (sim->now < at) {
-                    sim->frame(10'800'000, 9'500'000, 0);
-                }
-                sim->controller.add_late(sim->now, 1);
-                sim->frame(10'800'000, 9'500'000, 0);
+            const Nanoseconds entered = enter(*sim);
+            for (int hiccup = 0; hiccup < 2; ++hiccup) {
+                miss_at(*sim, entered + (5 + 5 * hiccup) * kSecond);
+                miss_at(*sim, entered + (5 + 5 * hiccup) * kSecond + 180 * kMillisecond);
+            }
+            run_to(*sim, entered + 14 * kSecond);
+            require(sim->controller.level() == 1 && sim->events.size() == 1,
+                "balanced and rate: a hiccup of two misses 180 ms apart stays");
+        }
+        {
+            CadenceSim steady;
+            const Nanoseconds entered = enter_one(steady);
+            while (steady.now < entered + 5 * kSecond) {
