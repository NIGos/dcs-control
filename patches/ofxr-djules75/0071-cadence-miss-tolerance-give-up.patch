+            }
+            steady.controller.add_late(steady.now, 1);
+            steady.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+            steady.controller.add_late(steady.now + 180 * kMillisecond, 1);
+            for (int index = 0; index < 60; ++index) {
