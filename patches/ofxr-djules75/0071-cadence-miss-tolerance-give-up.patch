+        config.one_exit_episodes = 3;        // 0071
+        config.one_exit_sparse_episodes = 5; // 0071: was 3
+        config.one_late_episode_gap = 250 * kMillisecond;
+        config.one_max_failed = 3;
     } else if (preference == CadencePreference::rate) {
         config.one_enter_fraction = 1.25;
         config.one_exit_slow = false;
+        config.one_exit_episodes = 3;         // 0071
+        config.one_exit_sparse_episodes = 10; // 0071
+        config.one_late_episode_gap = 250 * kMillisecond;
+        config.one_max_failed = 6;
     }
