+// DCS Control (0045): a scene change's reset of the presenter's state, which
+// needs the presenter's content lock, kept across the application's
+// xrEndFrame calls until that lock is had. 0042 kept the whole gap instead:
+// while a presenter wedged in the runtime's xrEndFrame held the lock (the
+// stall latch tripped), every frame started the adaptive controllers over
+// again, logged a cadence step, and waited for the lock 250 ms. Now the
+// controllers start over once per gap (begin, at the gap's first attempt,
+// on that attempt's samples), and only the locked part is retried: waited
+// for, bounded, at a gap's first attempt while generation runs, and only
+// tried at once (zero_wait) on a retry or while the latch has tripped. A
+// newer gap replaces a pending one.
+struct SceneReset {
+    bool pending{};
+    bool retrying{};
+    Nanoseconds gap{-1};
+
+    void begin(Nanoseconds new_gap) noexcept {
+        pending = true;
+        retrying = false;
+        gap = new_gap;
+    }
+    [[nodiscard]] bool zero_wait(bool stalled) const noexcept {
+        return retrying || stalled;
+    }
+    // The lock was not had: kept for the next frame.
+    void missed() noexcept {
+        retrying = pending;
+    }
+    void done() noexcept {
+        pending = false;
+        retrying = false;
+        gap = -1;
+    }
+};
