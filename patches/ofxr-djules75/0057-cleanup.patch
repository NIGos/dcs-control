-// DCS Control (0039): QPC ticks to nanoseconds as std::chrono::steady_clock
-// does on Windows (whole seconds and the remainder apart: no overflow for any
-// uptime). 0 for a value or frequency that is not positive.
-[[nodiscard]] inline std::int64_t qpc_to_nanoseconds(std::int64_t qpc, std::int64_t frequency) noexcept {
-    if (qpc <= 0 || frequency <= 0) {
-        return 0;
-    }
-    constexpr std::int64_t kNanosecondsPerSecond = 1'000'000'000;
-    const std::int64_t whole = qpc / frequency;
-    const std::int64_t part = qpc % frequency;
-    return whole * kNanosecondsPerSecond + part * kNanosecondsPerSecond / frequency;
-}
