-// DCS Control (0033): the GPU time of one full copy of a synthetic (both eyes,
-// RGBA8) on the graphics queue: what composing on an async compute queue
-// would add, since the runtime's sRGB swapchain images take no unordered
-// access and the composition would have to write an intermediate and copy it.
-// (At 2712 x 2678 both images fit in a large GPU's L2 cache here, which a
-// game's frame would not leave them.)
-void bench_synthetic_copy(D3D12WarpFixture& fixture, UINT width, UINT height) {
-    // Textured content (an image the hardware cannot compress away).
-    auto source = create_source_texture(fixture, width, height);
-    upload_pattern(fixture, source.Get(), fast_composition_roll(width, height, 0.0, nullptr));
-    auto destination = create_source_texture(fixture, width, height);
-    D3D12_QUERY_HEAP_DESC heap_description{};
-    heap_description.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
-    heap_description.Count = 2;
-    ComPtr<ID3D12QueryHeap> heap;
-    require_hresult(fixture.device()->CreateQueryHeap(&heap_description, IID_PPV_ARGS(heap.GetAddressOf())),
-        "copy bench query heap");
-    auto readback = create_buffer(fixture, D3D12_HEAP_TYPE_READBACK, 16, D3D12_RESOURCE_STATE_COPY_DEST);
-    UINT64 frequency = 0;
-    require_hresult(fixture.queue()->GetTimestampFrequency(&frequency), "copy bench frequency");
-    std::vector<std::uint64_t> times;
-    for (int run = 0; run < 60; ++run) {
-        fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
-            const std::array<D3D12_RESOURCE_BARRIER, 2> before{
-                transition_barrier(source.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET,
-                    D3D12_RESOURCE_STATE_COPY_SOURCE),
-                transition_barrier(destination.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET,
-                    D3D12_RESOURCE_STATE_COPY_DEST)};
-            const std::array<D3D12_RESOURCE_BARRIER, 2> after{
-                transition_barrier(source.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE,
-                    D3D12_RESOURCE_STATE_RENDER_TARGET),
-                transition_barrier(destination.Get(), D3D12_RESOURCE_STATE_COPY_DEST,
-                    D3D12_RESOURCE_STATE_RENDER_TARGET)};
-            list->ResourceBarrier(2, before.data());
-            list->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
-            list->CopyResource(destination.Get(), source.Get());
-            list->EndQuery(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 1);
-            list->ResourceBarrier(2, after.data());
-            list->ResolveQueryData(heap.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0, 2, readback.Get(), 0);
-        });
-        std::uint64_t* mapped = nullptr;
-        require_hresult(readback->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "copy bench map");
-        times.push_back((mapped[1] - mapped[0]) * 1000000ULL / frequency);
-        readback->Unmap(0, nullptr);
-    }
-    std::sort(times.begin(), times.end());
-    std::cout << "synthetic copy bench " << width << "x" << height << " x2 eyes: median "
-              << times[times.size() / 2] << " us per synthetic" << std::endl;
-}
