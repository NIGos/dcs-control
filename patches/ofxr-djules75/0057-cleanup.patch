-namespace content_time {
-
-// Clocks with different epochs, as the layer's are (XrTime, steady clock).
-constexpr Nanoseconds kDisplayEpoch = 7'000 * kSecond;
-constexpr Nanoseconds kContentEpoch = 50 * kSecond;
-
-Nanoseconds periods(double value) {
-    return static_cast<Nanoseconds>(std::llround(value * static_cast<double>(kPeriod)));
-}
-
-// The layer's answer without 0037 for a told interval (display periods).
-float display_fraction(double told, std::uint32_t frames, std::uint32_t index) {
-    const double before = static_cast<double>(frames - 1 - index);
-    if (told <= static_cast<double>(frames - 1) || told > 2.0 * frames) {
-        return static_cast<float>(index + 1) / static_cast<float>(frames);
-    }
-    return static_cast<float>(1.0 - before / told);
-}
-
-struct Placement {
-    float fraction{};
-    float fallback{};
-    bool content{};              // content_time_fraction answered
-    double line_error{};         // shown content less the constant-latency line, periods
-    double display_line_error{}; // the same for the display fraction
-};
-
-// Runs real frames (told display and content start, in periods) through the
-// tracker and places each pair's synthetic `index` of `frames`. The line is
-// the true latency, `latency` periods.
-std::vector<Placement> run(
-    const std::vector<double>& told,
-    const std::vector<double>& content,
-    double latency,
-    std::uint32_t frames = 2,
-    std::uint32_t index = 0) {
-    ContentLatencyTracker tracker;
-    std::vector<Placement> out;
-    for (std::size_t i = 0; i < told.size(); ++i) {
-        const Nanoseconds display = kDisplayEpoch + periods(told[i]);
-        const Nanoseconds start = kContentEpoch + periods(content[i]);
-        tracker.observe(display, start);
-        if (i == 0) {
-            continue;
-        }
-        Placement placement;
-        placement.fallback = display_fraction(told[i] - told[i - 1], frames, index);
-        const auto value = content_time_fraction(
-            kDisplayEpoch + periods(told[i - 1]),
-            kContentEpoch + periods(content[i - 1]),
-            display,
-            start,
-            tracker.latency(),
-            kPeriod,
-            frames,
-            index,
-            placement.fallback);
-        placement.content = value.has_value();
-        placement.fraction = value ? *value : placement.fallback;
-        const double slot = told[i] - static_cast<double>(frames - 1 - index);
-        const double line = slot - latency;
-        const double interval = content[i] - content[i - 1];
-        placement.line_error = content[i - 1] + placement.fraction * interval - line;
-        placement.display_line_error =
-            content[i - 1] + placement.fallback * interval - line;
-        out.push_back(placement);
-    }
-    return out;
-}
-
-double worst(const std::vector<Placement>& placements, std::size_t from, bool display) {
-    double result = 0.0;
-    for (std::size_t i = from; i < placements.size(); ++i) {
-        const double error = display ? placements[i].display_line_error
-                                     : placements[i].line_error;
-        result = std::max(result, std::abs(error));
-    }
-    return result;
-}
