+            cockpit_mask_target.Get(), D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE,
+            D3D12_RESOURCE_STATE_COMMON);
+        list->ResourceBarrier(1, &barrier);
+    }
