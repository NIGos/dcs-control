diff --git a/include/xrfg/cockpit_mask.hpp b/include/xrfg/cockpit_mask.hpp
new file mode 100644
--- /dev/null
+++ b/include/xrfg/cockpit_mask.hpp
@@ -0,0 +1,171 @@
+#pragma once
+
+// DCS Control (0031): the cockpit mask, read from DCS Control's engine module
+// (contract: xrfg/dcsvr_cockpit_mask.h, R65 v1) and handed to the synthesis.
+//
+// Where DCS drew cockpit geometry in each eye of a real frame, as a small R8
+// mask on DCS's GPU, paired with the frame by XrFrameEndInfo::displayTime. The
+// synthesis composes the pixels it covers from the camera mapping alone (the
+// cockpit moves with the head, which the rotation pre-warp already follows)
+// and keeps the flow from carrying samples across its edge
+// (frame_synthesis.hlsl, D3D12FrameSynthesizer::set_cockpit_mask).
+//
+// Anything missing, stale or failed is "no mask for this frame": the
+// composition as before. Nothing here waits on the CPU for the GPU.
+
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace xrfg {
+
+// One eye's mask inside a D3D12CockpitMaskFrame's texture.
+struct D3D12CockpitMaskView {
+    bool valid{};
+    // The rectangle in the texture, in texels.
+    std::uint32_t x{};
+    std::uint32_t y{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    // Tangents of the rectangle's outer edges: left, right, up, down (x
+    // right, y up), as dcsvr_cockpit_mask::MaskView::fovTan.
+    std::array<float, 4> fov_tan{};
+};
+
+// One real frame's cockpit mask on the synthesis device: an R8_UNORM texture
+// (non-zero: cockpit) that rests in COMMON, complete once ready_fence reaches
+// ready_value. Shared between the consumer, which reuses it only when nobody
+// else holds it and every read noted on it has completed, and the
+// synthesizers that read it (the frame's own pair, and the next pair as its
+// previous frame).
+class D3D12CockpitMaskFrame final {
+public:
+    Microsoft::WRL::ComPtr<ID3D12Resource> texture;
+    Microsoft::WRL::ComPtr<ID3D12Fence> ready_fence;
+    std::uint64_t ready_value{};
+    // Index 0 the left eye, 1 the right (the projection layer's views).
+    std::array<D3D12CockpitMaskView, 2> views{};
+    std::int64_t display_time{};
+    std::uint64_t mask_seq{};
+
+    // A submission that reads the texture completes at `value` of `fence`.
+    void note_reader(ID3D12Fence* fence, std::uint64_t value) noexcept;
+    // Every noted read has completed (or none was noted).
+    [[nodiscard]] bool readers_complete() noexcept;
+    void clear_readers() noexcept;
+
+private:
+    std::mutex mutex_;
+    std::vector<std::pair<Microsoft::WRL::ComPtr<ID3D12Fence>, std::uint64_t>> readers_;
+};
+
+// Why the last acquire returned what it did. Values are logged.
+enum class CockpitMaskLookup : std::uint32_t {
+    none = 0,
+    paired = 1,           // a mask for the frame
+    no_block = 2,         // the shared block does not exist (export off, or not DCS)
+    retry_wait = 3,       // the block was missing; the next look is due later
+    header_busy = 4,      // the writer held the seqlock through every attempt
+    header_unusable = 5,  // inactive, other version, other process, no fence
+    adapter_mismatch = 6, // DCS renders on another adapter
+    stale = 7,            // the heartbeat is older than 500 ms
+    open_failed = 8,      // a shared handle did not open on this device
+    generation_changed = 9, // the textures changed while they were opened
+    no_slot = 10,         // no slot committed for this displayTime
+    no_view = 11,         // neither eye's view is valid in that slot
+    ring_busy = 12,       // every private copy is still in use
+    copy_failed = 13,     // recording or queueing the copy failed
+    stalled = 14,         // a copy never completed: off for the session
+    disabled = 15,        // not initialized
+};
+
+// Whether a mask is coming, as the flight log reports changes of it.
+enum class CockpitMaskPresence : std::uint32_t {
+    absent = 0,   // no block
+    inactive = 1, // a block, but not usable (inactive, stale, other adapter)
+    unpaired = 2, // usable, but frames find no slot of their own
+    active = 3,   // frames get their masks
+};
+
+struct CockpitMaskConsumerStats {
+    std::uint64_t lookups{};
+    std::uint64_t paired{};
+    std::uint64_t no_slot{};
+    std::uint64_t stale{};
+    std::uint64_t other_misses{};
+    std::uint64_t generations_opened{};
+    std::uint64_t releases_signalled{};
+    std::uint64_t heartbeats_stored{};
+    std::uint64_t heartbeats_stopped{};
+    CockpitMaskLookup last{CockpitMaskLookup::none};
+    CockpitMaskPresence presence{CockpitMaskPresence::absent};
+    std::uint32_t generation{};
+};
+
+struct CockpitMaskConsumerOptions {
+    // Appended to the block name; by default the environment variable
+    // DCSVR_PERCEPTION_SHM_SUFFIX, as the producer does.
+    bool suffix_from_environment{true};
+    std::wstring suffix;
+    // How often to look for a missing block.
+    std::uint32_t retry_milliseconds{1000};
+    // The heartbeat's allowed age.
+    double heartbeat_milliseconds{500.0};
+    // Signal the producer's release fence (when it offers one) after each
+    // copy, so it never overwrites a slot being copied.
+    bool use_release_fence{true};
+    // A copy outstanding this long: the copy queue is taken as stuck, its
+    // dependants are released and masks are off for the session.
+    std::uint32_t stall_milliseconds{1000};
+    // Minimum interval between two presence-change log lines.
+    std::uint32_t log_interval_milliseconds{1000};
+    // Private copies kept.
+    std::uint32_t ring_size{6};
+    // The reader heartbeat's store interval (the producer idles after 2 s
+    // without one).
+    std::uint32_t heartbeat_store_milliseconds{250};
+};
+
+class CockpitMaskConsumer final {
+public:
+    // result, a, b, c of a flight-log record (BridgeFlightOperation::cockpit_mask).
+    using Logger = std::function<void(std::int64_t, std::uint64_t, std::uint64_t, std::uint64_t)>;
+
+    CockpitMaskConsumer() noexcept;
+    ~CockpitMaskConsumer();
+    CockpitMaskConsumer(const CockpitMaskConsumer&) = delete;
+    CockpitMaskConsumer& operator=(const CockpitMaskConsumer&) = delete;
+
+    // The device the copies are made on and read from (the synthesis device).
+    [[nodiscard]] HRESULT initialize(
+        ID3D12Device* device,
+        Logger logger = {},
+        CockpitMaskConsumerOptions options = CockpitMaskConsumerOptions{}) noexcept;
+
+    // The mask of the frame the application submits with `display_time`,
+    // copied out of the producer's slot on a queue of its own (after a GPU
+    // wait for the producer's fence), or null: no mask for this frame. The
+    // same frame is returned again for the same display time (one frame, more
+    // than one swapchain). Never blocks on the GPU. Called only while frame
+    // generation runs: it also keeps the reader heartbeat fresh (the producer
+    // works only while it is), and stops it when the copies stall.
+    [[nodiscard]] std::shared_ptr<D3D12CockpitMaskFrame> acquire(
+        std::int64_t display_time) noexcept;
+
+    [[nodiscard]] CockpitMaskConsumerStats stats() const noexcept;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace xrfg
