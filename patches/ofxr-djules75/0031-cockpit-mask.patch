diff --git a/src/d3d12/cockpit_mask.hlsl b/src/d3d12/cockpit_mask.hlsl
new file mode 100644
--- /dev/null
+++ b/src/d3d12/cockpit_mask.hlsl
@@ -0,0 +1,120 @@
+// DCS Control (0031): the cockpit mask, resampled into the synthetic's own
+// view (D3D12FrameSynthesizer, before the composition of a pair).
+//
+// Input: the two real frames' masks (xrfg::D3D12CockpitMaskFrame, R8, one
+// rectangle per eye whose edges are the tangents fovTan of DCS's projection;
+// non-zero = cockpit). Output: one texel per Cell x Cell pixels of the target
+// view's rectangle: 1 where either frame's mask covers that direction (the
+// union) within one mask texel each way; 0.5 where the current frame's mask
+// is within three mask texels (the band where the composition checks the
+// flow against the mask); 0 elsewhere, where the composition does nothing
+// more than read this texel. The current frame is the target camera itself;
+// the previous frame is reached through the rotation the composition uses for
+// it (target to source).
+//
+// Cost: the max over a 2 x 2 block is one bilinear sample at the corner the
+// four texels share (each weighs 1/4, so it is non-zero exactly when one of
+// them is): 4 samples cover the 3 x 3 block around a texel, 16 the 7 x 7.
+//
+// Same root signature as frame_synthesis.hlsl: t0/t1 and u0 of the slot's
+// cockpit-mask descriptor block, and these constants in the 62 at b0.
+
+SamplerState LinearClamp : register(s0);
+Texture2D<float> PreviousMask : register(t0);
+Texture2D<float> CurrentMask : register(t1);
+RWTexture2DArray<float> TargetMask : register(u0);
+
+cbuffer CockpitMaskParameters : register(b0) {
+    uint OutputWidth;
+    uint OutputHeight;
+    uint Cell;
+    uint Reserved;
+    uint Slice;
+    // Bit 0: the previous frame's mask is bound; bit 1: the current one's.
+    uint Flags;
+    uint Padding0;
+    uint Padding1;
+    float4 TargetRect;
+    // left, right, up, down tangents of the target view.
+    float4 TargetTangents;
+    float4 TargetToPrevious;
+    // x, y, w, h of each frame's rectangle for this eye, and its fovTan.
+    float4 CurrentRect;
+    float4 CurrentFov;
+    float4 PreviousRect;
+    float4 PreviousFov;
+};
+
+float3 rotate_by_quaternion(float4 quaternion, float3 input_vector) {
+    return input_vector + 2.0 * cross(
+        quaternion.xyz,
+        cross(quaternion.xyz, input_vector) + quaternion.w * input_vector);
+}
+
+// dcsvr_cockpit_mask::tan_to_texel's texel for `tangent`, and from it the
+// mask within one texel (x) and within three (y), the 2 x 2 blocks read at
+// their shared corners (clamped into the rect, so the other view's rect next
+// to it in the atlas is never read). Near only for `near`.
+float2 mask_around(Texture2D<float> mask, float4 rect, float4 fov, float2 tangent, bool near) {
+    float left = fov.x, right = fov.y, up = fov.z, down = fov.w;
+    float2 result = float2(0.0, 0.0);
+    bool usable = right > left && up > down && rect.z >= 2.0 && rect.w >= 2.0;
+    float2 fraction = usable
+        ? float2((tangent.x - left) / (right - left), (up - tangent.y) / (up - down))
+        : float2(-1.0, -1.0);
+    float2 texel = floor(fraction * rect.zw);
+    // Outside the rect by more than the band: nothing.
+    if (usable && all(texel >= -3.0) && all(texel < rect.zw + 3.0)) {
+        float width, height;
+        mask.GetDimensions(width, height);
+        float2 inverse_size = 1.0 / float2(width, height);
+        float2 low = rect.xy + 1.0, high = rect.xy + rect.zw - 1.0;
+        // Corner edges, relative to the texel's own left/top edge.
+        static const float inner[2] = {0.0, 1.0};
+        static const float outer[4] = {-2.0, 0.0, 1.0, 3.0};
+        [unroll] for (uint j = 0; j < 2; ++j) {
+            [unroll] for (uint i = 0; i < 2; ++i) {
+                float2 corner = clamp(rect.xy + texel + float2(inner[i], inner[j]), low, high);
+                result.x = max(result.x, mask.SampleLevel(LinearClamp, corner * inverse_size, 0.0));
+            }
+        }
+        result.y = result.x;
+        [branch] if (near && result.x <= 0.0) {
+            [unroll] for (uint y = 0; y < 4; ++y) {
+                [unroll] for (uint x = 0; x < 4; ++x) {
+                    if ((x == 1 || x == 2) && (y == 1 || y == 2)) {
+                        continue;
+                    }
+                    float2 corner = clamp(rect.xy + texel + float2(outer[x], outer[y]), low, high);
+                    result.y = max(result.y, mask.SampleLevel(LinearClamp, corner * inverse_size, 0.0));
+                }
+            }
+        }
+    }
+    return result;
+}
+
+[numthreads(8, 8, 1)]
+void CockpitMaskResampleCS(uint3 thread_id : SV_DispatchThreadID) {
+    if (thread_id.x >= OutputWidth || thread_id.y >= OutputHeight) {
+        return;
+    }
+    // The centre of the cell, in the target's pixel coordinates (a pixel's
+    // own coordinate is its centre, as in frame_synthesis.hlsl).
+    float2 pixel = TargetRect.xy + (float2(thread_id.xy) + 0.5) * float(Cell) - 0.5;
+    float2 uv = (pixel - TargetRect.xy + 0.5) / max(TargetRect.zw, float2(1.0, 1.0));
+    float2 tangent = float2(
+        lerp(TargetTangents.x, TargetTangents.y, uv.x),
+        lerp(TargetTangents.z, TargetTangents.w, uv.y));
+    float2 value = float2(0.0, 0.0);
+    if ((Flags & 2u) != 0u) {
+        value = mask_around(CurrentMask, CurrentRect, CurrentFov, tangent, true);
+    }
+    if ((Flags & 1u) != 0u && value.x <= 0.0) {
+        float3 ray = rotate_by_quaternion(TargetToPrevious, float3(tangent, -1.0));
+        if (ray.z < -1.0e-5) {
+            value.x = mask_around(PreviousMask, PreviousRect, PreviousFov, ray.xy / -ray.z, false).x;
+        }
+    }
+    TargetMask[uint3(thread_id.xy, Slice)] = value.x > 0.0 ? 1.0 : (value.y > 0.0 ? 0.5 : 0.0);
+}
