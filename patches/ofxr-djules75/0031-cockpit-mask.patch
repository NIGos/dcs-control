+// DCS Control (0031): the cockpit mask (D3D12FrameSynthesizer::set_cockpit_mask).
+// Bit 4: bound for this pair. Bit 5 ([ofxr] nvidia_occlusion_aware=3): the
+// occlusion choice only where it is bound and leaves the pixel to the world.
+// Bits 6-7: its cell, 4 << n pixels.
+// Compiled in only for the compositions built with XRFG_COCKPIT_MASK=1, which
+// D3D12FrameSynthesizer uses for a pair that binds a mask: the others are the
+// compositions as before (the code below folds away).
+#ifndef XRFG_COCKPIT_MASK
+#define XRFG_COCKPIT_MASK 0
+#endif
+bool cockpit_mask_bound() {
+    return XRFG_COCKPIT_MASK != 0 && (SynthesisFlags & 16u) != 0u;
+}
+
+bool occlusion_choice_outside_mask_only() {
+    return (SynthesisFlags & 32u) != 0u;
+}
+
+// The mask at target pixel `pixel` of this view (cockpit_mask.hlsl): 1 the
+// cockpit, 0.5 within three mask texels of it, 0 elsewhere (outside the
+// view's rectangle as well: a load out of range reads 0).
+float cockpit_mask_at(float2 pixel) {
+    float cell = float(4u << ((SynthesisFlags >> 6) & 3u));
+    float2 relative = pixel - PreviousMappings[ViewIndex].TargetRect.xy + 0.5;
+    int2 texel = int2(floor(relative / cell));
+    return CockpitMask.Load(int4(texel, int(ViewIndex), 0));
+}
+
+bool cockpit_masked(float2 pixel) {
+    return cockpit_mask_at(pixel) >= 0.75;
+}
+
+// Where the flow at a world pixel cannot be trusted next to the cockpit (the
+// engine matched a block that holds both, or the vector's ends land in the
+// mask), a vector of the world nearby: from cells two and four away in eight
+// directions, one measured in the world whose own ends both stay in the
+// world, the best matched. False when there is none.
