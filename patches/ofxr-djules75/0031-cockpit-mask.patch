+// DCS Control (0031): the cockpit mask of the frame the application submits
+// with `display_time` (its XrFrameEndInfo::displayTime), or null: the export
+// is off, nothing pairs, or the consumer could not be made. Never blocks.
+[[nodiscard]] std::shared_ptr<xrfg::D3D12CockpitMaskFrame> acquire_cockpit_mask(
+    SessionState& session, XrTime display_time) noexcept {
+    if (!session.cockpit_mask_enabled || display_time <= 0) {
+        return nullptr;
+    }
+    std::shared_ptr<xrfg::CockpitMaskConsumer> consumer;
+    try {
+        std::scoped_lock lock(session.cockpit_mask_mutex);
+        if (!session.cockpit_mask && !session.cockpit_mask_tried && session.d3d12_device) {
+            session.cockpit_mask_tried = true;
+            auto created = std::make_shared<xrfg::CockpitMaskConsumer>();
+            const HRESULT result = created->initialize(
+                session.d3d12_device.Get(),
+                [](std::int64_t code, std::uint64_t a, std::uint64_t b, std::uint64_t c) {
+                    xrfg::bridge_flight_logger().event(
+                        xrfg::BridgeFlightOperation::cockpit_mask, code, a, b, c);
+                });
+            if (SUCCEEDED(result)) {
+                session.cockpit_mask = std::move(created);
+            } else {
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::cockpit_mask, 6,
+                    static_cast<std::uint32_t>(result), 0, 0);
+            }
+        }
+        consumer = session.cockpit_mask;
+    } catch (...) {
+        return nullptr;
+    }
+    return consumer ? consumer->acquire(static_cast<std::int64_t>(display_time)) : nullptr;
+}
