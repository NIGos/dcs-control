+    // DCS Control (0031): after the composition: the target-view mask back
+    // to COMMON, where the next pair's resample takes it from.
+    void finish_cockpit_mask(ID3D12GraphicsCommandList* list) noexcept {
+        if (!pair_mask_bound) {
