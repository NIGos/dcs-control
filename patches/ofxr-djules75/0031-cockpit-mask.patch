+// DCS Control (0031): the cockpit mask consumer (xrfg::CockpitMaskConsumer)
+// against a fake producer that makes the block, the slot atlases and the
+// fences as DCS Control's engine module does (NT handles of this process; a
+// D3D12 device stands in for DCS's D3D11 one, on the same WARP adapter as the
+// consumer): pairing by displayTime, the GPU wait for the producer's fence,
+// the release fence, staleness, generation and adapter changes, the copy
+// stall, and the reader heartbeat (stored while consuming, stopped on a stall
+// and at the end).
+
+#include "xrfg/cockpit_mask.hpp"
+#include "xrfg/dcsvr_cockpit_mask.h"
+#include "xrfg/implicit_layer.hpp"
+
+#include <windows.h>
