+
+namespace {
+
+using Microsoft::WRL::ComPtr;
+namespace cm = dcsvr_cockpit_mask;
+
+void require(bool condition, const std::string& message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+void require_hresult(HRESULT result, const std::string& operation) {
+    if (FAILED(result)) {
+        throw std::runtime_error(operation + " failed: 0x" + std::to_string(static_cast<unsigned long>(result)));
+    }
+}
+
+std::int64_t qpc_now() {
+    LARGE_INTEGER value{};
+    QueryPerformanceCounter(&value);
+    return value.QuadPart;
+}
+
+std::int64_t qpc_frequency() {
+    LARGE_INTEGER value{};
+    QueryPerformanceFrequency(&value);
+    return value.QuadPart;
+}
+
+constexpr UINT kAtlasWidth = 48;
+constexpr UINT kAtlasHeight = 20;
+constexpr UINT kViewWidth = 24;
+
+class Gpu final {
+public:
+    Gpu() {
+        ComPtr<IDXGIFactory4> factory;
+        require_hresult(CreateDXGIFactory2(0, IID_PPV_ARGS(factory.GetAddressOf())), "CreateDXGIFactory2");
+        ComPtr<IDXGIAdapter> adapter;
+        require_hresult(factory->EnumWarpAdapter(IID_PPV_ARGS(adapter.GetAddressOf())), "EnumWarpAdapter");
+        require_hresult(D3D12CreateDevice(adapter.Get(), D3D_FEATURE_LEVEL_11_0,
+                            IID_PPV_ARGS(device.GetAddressOf())),
+            "D3D12CreateDevice(WARP)");
+        D3D12_COMMAND_QUEUE_DESC description{};
+        description.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+        require_hresult(device->CreateCommandQueue(&description, IID_PPV_ARGS(queue.GetAddressOf())),
+            "CreateCommandQueue");
+        require_hresult(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(fence.GetAddressOf())),
+            "CreateFence");
+        event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        require(event != nullptr, "CreateEventW");
+    }
+    ~Gpu() {
+        if (event != nullptr) {
+            CloseHandle(event);
+        }
+    }
+    Gpu(const Gpu&) = delete;
+    Gpu& operator=(const Gpu&) = delete;
+
+    void wait(ID3D12Fence* which, std::uint64_t value, DWORD milliseconds = 10000) {
+        if (which->GetCompletedValue() >= value) {
+            return;
+        }
+        require_hresult(which->SetEventOnCompletion(value, event), "SetEventOnCompletion");
+        require(WaitForSingleObject(event, milliseconds) == WAIT_OBJECT_0, "a fence wait timed out");
+    }
+
+    // Uploads `bytes` (kAtlasWidth x kAtlasHeight) into an R8 texture in COMMON,
+    // or reads one back.
+    void upload(ID3D12Resource* texture, const std::vector<std::uint8_t>& bytes) {
+        transfer(texture, const_cast<std::vector<std::uint8_t>*>(&bytes), true);
+    }
+    std::vector<std::uint8_t> readback(ID3D12Resource* texture) {
+        std::vector<std::uint8_t> bytes(static_cast<std::size_t>(kAtlasWidth) * kAtlasHeight);
+        transfer(texture, &bytes, false);
+        return bytes;
+    }
+
+    ComPtr<ID3D12Device> device;
+    ComPtr<ID3D12CommandQueue> queue;
+    ComPtr<ID3D12Fence> fence;
+    std::uint64_t fence_value{};
+    HANDLE event{};
+
+private:
+    void transfer(ID3D12Resource* texture, std::vector<std::uint8_t>* bytes, bool to_texture) {
+        const D3D12_RESOURCE_DESC description = texture->GetDesc();
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout{};
+        UINT rows = 0;
+        UINT64 row_size = 0, total = 0;
+        device->GetCopyableFootprints(&description, 0, 1, 0, &layout, &rows, &row_size, &total);
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = to_texture ? D3D12_HEAP_TYPE_UPLOAD : D3D12_HEAP_TYPE_READBACK;
+        D3D12_RESOURCE_DESC buffer{};
+        buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        buffer.Width = total;
+        buffer.Height = 1;
+        buffer.DepthOrArraySize = 1;
+        buffer.MipLevels = 1;
+        buffer.SampleDesc.Count = 1;
+        buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ComPtr<ID3D12Resource> staging;
+        require_hresult(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                            to_texture ? D3D12_RESOURCE_STATE_GENERIC_READ : D3D12_RESOURCE_STATE_COPY_DEST,
+                            nullptr, IID_PPV_ARGS(staging.GetAddressOf())),
+            "staging buffer");
+        if (to_texture) {
+            std::uint8_t* mapped = nullptr;
+            require_hresult(staging->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "Map(upload)");
+            for (UINT y = 0; y < rows; ++y) {
+                std::memcpy(mapped + layout.Offset + static_cast<std::size_t>(y) * layout.Footprint.RowPitch,
+                    bytes->data() + static_cast<std::size_t>(y) * kAtlasWidth, kAtlasWidth);
+            }
+            staging->Unmap(0, nullptr);
+        }
+        ComPtr<ID3D12CommandAllocator> allocator;
+        ComPtr<ID3D12GraphicsCommandList> list;
+        require_hresult(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                            IID_PPV_ARGS(allocator.GetAddressOf())),
+            "CreateCommandAllocator");
+        require_hresult(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(),
+                            nullptr, IID_PPV_ARGS(list.GetAddressOf())),
+            "CreateCommandList");
+        D3D12_TEXTURE_COPY_LOCATION image{};
+        image.pResource = texture;
+        image.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION linear{};
+        linear.pResource = staging.Get();
+        linear.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        linear.PlacedFootprint = layout;
+        // COMMON is promoted to the copy state and decays back after the list.
+        if (to_texture) {
+            list->CopyTextureRegion(&image, 0, 0, 0, &linear, nullptr);
+        } else {
+            list->CopyTextureRegion(&linear, 0, 0, 0, &image, nullptr);
+        }
+        require_hresult(list->Close(), "Close");
+        ID3D12CommandList* lists[] = {list.Get()};
+        queue->ExecuteCommandLists(1, lists);
+        require_hresult(queue->Signal(fence.Get(), ++fence_value), "Signal");
+        wait(fence.Get(), fence_value);
+        if (!to_texture) {
+            std::uint8_t* mapped = nullptr;
+            require_hresult(staging->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "Map(readback)");
+            for (UINT y = 0; y < rows; ++y) {
+                std::memcpy(bytes->data() + static_cast<std::size_t>(y) * kAtlasWidth,
+                    mapped + layout.Offset + static_cast<std::size_t>(y) * layout.Footprint.RowPitch, kAtlasWidth);
+            }
+            staging->Unmap(0, nullptr);
+        }
+    }
+};
+
+// What DCS Control's engine module shares, made the same way (NT handles of
+// this process), on the test's device.
+class FakeProducer final {
+public:
+    FakeProducer(Gpu& gpu, const std::wstring& suffix) : gpu_(gpu) {
+        const std::wstring name = std::wstring(cm::block_name) + suffix;
+        mapping_ = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 4096, name.c_str());
+        require(mapping_ != nullptr, "producer: CreateFileMappingW");
+        block_ = static_cast<cm::Header*>(MapViewOfFile(mapping_, FILE_MAP_ALL_ACCESS, 0, 0, 4096));
+        require(block_ != nullptr, "producer: MapViewOfFile");
+        make_resources();
+    }
+    ~FakeProducer() {
+        close_handles();
+        for (HANDLE handle : retired_) {
+            CloseHandle(handle);
+        }
+        if (block_ != nullptr) {
+            UnmapViewOfFile(block_);
+        }
+        if (mapping_ != nullptr) {
+            CloseHandle(mapping_);
+        }
+    }
+    FakeProducer(const FakeProducer&) = delete;
+    FakeProducer& operator=(const FakeProducer&) = delete;
+
+    // New textures and fences: a new generation (the old handles stay open,
+    // as the engine keeps them for 2 s).
+    void make_resources() {
+        close_handles(true);
+        D3D12_HEAP_PROPERTIES heap{};
+        heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+        D3D12_RESOURCE_DESC description{};
+        description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        description.Width = kAtlasWidth;
+        description.Height = kAtlasHeight;
+        description.DepthOrArraySize = 1;
+        description.MipLevels = 1;
+        description.Format = DXGI_FORMAT_R8_UNORM;
+        description.SampleDesc.Count = 1;
+        for (int index = 0; index < cm::slot_count; ++index) {
+            textures_[index].Reset();
+            require_hresult(gpu_.device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_SHARED, &description,
+                                D3D12_RESOURCE_STATE_COMMON, nullptr,
+                                IID_PPV_ARGS(textures_[index].GetAddressOf())),
+                "producer: slot texture");
+            require_hresult(gpu_.device->CreateSharedHandle(textures_[index].Get(), nullptr, GENERIC_ALL,
+                                nullptr, &texture_handles_[index]),
+                "producer: texture handle");
+        }
+        fence_.Reset();
+        release_fence_.Reset();
+        require_hresult(gpu_.device->CreateFence(0, D3D12_FENCE_FLAG_SHARED, IID_PPV_ARGS(fence_.GetAddressOf())),
+            "producer: fence");
+        require_hresult(gpu_.device->CreateSharedHandle(fence_.Get(), nullptr, GENERIC_ALL, nullptr, &fence_handle_),
+            "producer: fence handle");
+        require_hresult(gpu_.device->CreateFence(
+                            0, D3D12_FENCE_FLAG_SHARED, IID_PPV_ARGS(release_fence_.GetAddressOf())),
+            "producer: release fence");
+        require_hresult(gpu_.device->CreateSharedHandle(
+                            release_fence_.Get(), nullptr, GENERIC_ALL, nullptr, &release_fence_handle_),
+            "producer: release fence handle");
+        ++generation_;
+        header_ = {};
+        header_.magic = cm::block_magic;
+        header_.version = cm::block_version;
+        header_.structSize = sizeof(cm::Header);
+        header_.flags = cm::header_flags::active | cm::header_flags::fence | cm::header_flags::release_fence |
+            cm::header_flags::reader_heartbeat;
+        header_.generation = generation_;
+        header_.slotCount = cm::slot_count;
+        header_.format = cm::format_r8_unorm;
+        header_.atlasW = kAtlasWidth;
+        header_.atlasH = kAtlasHeight;
+        header_.ownerPid = GetCurrentProcessId();
+        const LUID luid = gpu_.device->GetAdapterLuid();
+        header_.adapterLuid = static_cast<std::uint64_t>(luid.LowPart) |
+            (static_cast<std::uint64_t>(static_cast<std::uint32_t>(luid.HighPart)) << 32U);
+        for (int index = 0; index < cm::slot_count; ++index) {
+            header_.textureHandle[index] = reinterpret_cast<std::uintptr_t>(texture_handles_[index]);
+        }
+        header_.fenceHandle = reinterpret_cast<std::uintptr_t>(fence_handle_);
+        header_.releaseFenceHandle = reinterpret_cast<std::uintptr_t>(release_fence_handle_);
+        header_.qpcFrequency = qpc_frequency();
+        publish();
+    }
+
+    // Draws the frame with `display_time` into the next slot (both eyes'
+    // rects; `fill` marks the texels) and commits it; the fence is
+    // signalled only by signal().
+    std::uint64_t commit(std::int64_t display_time, std::uint8_t fill, std::uint32_t view_mask = 3U) {
+        const int slot = next_slot_;
+        next_slot_ = (next_slot_ + 1) % cm::slot_count;
+        last_pattern_.assign(static_cast<std::size_t>(kAtlasWidth) * kAtlasHeight, 0);
+        for (UINT y = 0; y < kAtlasHeight; ++y) {
+            for (UINT x = 0; x < kAtlasWidth; ++x) {
+                // A diagonal band per eye: something to compare.
+                if (((x % kViewWidth) + y) % 7U < 3U) {
+                    last_pattern_[static_cast<std::size_t>(y) * kAtlasWidth + x] = fill;
+                }
+            }
+        }
+        gpu_.upload(textures_[slot].Get(), last_pattern_);
+        cm::MaskSlot& record = header_.slot[slot];
+        record = {};
+        record.maskSeq = ++mask_seq_;
+        record.engineFrame = mask_seq_;
+        record.displayTime = display_time;
+        record.qpcCommit = qpc_now();
+        record.flags = cm::slot_flags::valid | cm::slot_flags::display_time;
+        record.viewMask = view_mask;
+        for (int view = 0; view < 2; ++view) {
+            cm::MaskView& entry = record.view[view];
+            entry.flags = (view_mask & (1U << view)) != 0 ? cm::view_flags::valid | cm::view_flags::stencil : 0U;
+            entry.x = static_cast<std::uint32_t>(view) * kViewWidth;
+            entry.y = 0;
+            entry.w = kViewWidth;
+            entry.h = kAtlasHeight;
+            entry.srcW = kViewWidth * 2;
+            entry.srcH = kAtlasHeight * 2;
+            entry.divisor = 2;
+            entry.fovTan[0] = -1.0F;
+            entry.fovTan[1] = 1.0F;
+            entry.fovTan[2] = 0.8F;
+            entry.fovTan[3] = -0.8F;
+        }
+        header_.newestMaskSeq = mask_seq_;
+        header_.newestSlot = static_cast<std::uint32_t>(slot);
+        publish();
+        return mask_seq_;
+    }
+
+    void signal(std::uint64_t value) {
+        require_hresult(fence_->Signal(value), "producer: Signal");
+    }
+
+    void publish(std::int64_t heartbeat_age_ms = 0) {
+        header_.heartbeatQpc = qpc_now() - heartbeat_age_ms * header_.qpcFrequency / 1000;
+        cm::seqlock_write(block_, header_);
+    }
+
+    std::uint64_t reader_heartbeat() const {
+        return cm::reader_heartbeat_of(block_).load(std::memory_order_acquire);
+    }
+    void clear_reader_heartbeat() {
+        cm::reader_heartbeat_of(block_).store(0, std::memory_order_release);
+    }
+
+    cm::Header header_{};
+    std::vector<std::uint8_t> last_pattern_;
+    ComPtr<ID3D12Fence> release_fence_;
+
+private:
+    void close_handles(bool keep = false) {
+        for (HANDLE& handle : texture_handles_) {
+            if (handle != nullptr) {
+                keep ? retired_.push_back(handle) : static_cast<void>(CloseHandle(handle));
+                handle = nullptr;
+            }
+        }
+        for (HANDLE* handle : {&fence_handle_, &release_fence_handle_}) {
+            if (*handle != nullptr) {
+                keep ? retired_.push_back(*handle) : static_cast<void>(CloseHandle(*handle));
+                *handle = nullptr;
+            }
+        }
+    }
+
+    Gpu& gpu_;
+    HANDLE mapping_{};
+    cm::Header* block_{};
+    std::array<ComPtr<ID3D12Resource>, cm::slot_count> textures_{};
+    std::array<HANDLE, cm::slot_count> texture_handles_{};
+    ComPtr<ID3D12Fence> fence_;
+    HANDLE fence_handle_{};
+    HANDLE release_fence_handle_{};
+    std::vector<HANDLE> retired_;
+    std::uint32_t generation_{1000};
+    std::uint64_t mask_seq_{};
+    int next_slot_{};
+};
+
+std::wstring test_suffix(const wchar_t* name) {
+    return std::wstring(L"_xrfg_test_") + name + L"_" + std::to_wstring(GetCurrentProcessId());
+}
+
+xrfg::CockpitMaskConsumerOptions test_options(const std::wstring& suffix) {
+    xrfg::CockpitMaskConsumerOptions options;
+    options.suffix_from_environment = false;
+    options.suffix = suffix;
+    options.retry_milliseconds = 0;
+    options.heartbeat_store_milliseconds = 0;
+    return options;
+}
+
+void test_missing_block_retries_once_a_second(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"retry");
+    auto options = test_options(suffix);
+    options.retry_milliseconds = 1000;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    require(consumer.acquire(100) == nullptr, "retry: no block, no mask");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::no_block, "retry: the first look finds no block");
+    FakeProducer producer(gpu, suffix);
+    producer.commit(200, 255);
+    producer.signal(1);
+    require(consumer.acquire(200) == nullptr, "retry: not looked for again at once");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::retry_wait, "retry: the next look is due later");
+    Sleep(1100);
+    producer.publish(); // the engine writes the header every frame
+    require(consumer.acquire(200) != nullptr, "retry: found a second later, and paired");
+    std::cout << "cockpit mask: a missing block is looked for once a second\n";
+}
+
+void test_pairing_gpu_wait_release_and_heartbeat(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"pair");
+    FakeProducer producer(gpu, suffix);
+    std::vector<std::int64_t> logged;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(),
+                        [&logged](std::int64_t code, std::uint64_t, std::uint64_t, std::uint64_t) {
+                            logged.push_back(code);
+                        },
+                        test_options(suffix)),
+        "consumer initialize");
+
+    require(producer.reader_heartbeat() == 0, "heartbeat: none before the reader looks");
+    const std::uint64_t seq = producer.commit(1000, 255);
+    const std::int64_t before = qpc_now();
+    auto frame = consumer.acquire(1000);
+    require(frame != nullptr, "pairing: the frame's own slot gives a mask");
+    const std::uint64_t heartbeat = producer.reader_heartbeat();
+    require(heartbeat >= static_cast<std::uint64_t>(before) && heartbeat <= static_cast<std::uint64_t>(qpc_now()),
+        "heartbeat: stored (QPC) while consuming");
+    require(frame->display_time == 1000 && frame->mask_seq == seq, "pairing: the frame's display time and maskSeq");
+    require(frame->views[0].valid && frame->views[1].valid && frame->views[1].x == kViewWidth &&
+            frame->views[0].width == kViewWidth && frame->views[0].fov_tan[2] == 0.8F,
+        "pairing: both eyes' rects and tangents");
+    // The copy waits for the producer's fence on the GPU, not here.
+    Sleep(100);
+    require(frame->ready_fence->GetCompletedValue() < frame->ready_value,
+        "pairing: the copy waits on the GPU for the producer's fence");
+    require(consumer.acquire(1000) == frame, "pairing: the same frame again for the same display time");
+    producer.signal(seq);
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    require(gpu.readback(frame->texture.Get()) == producer.last_pattern_, "pairing: the copy holds the slot");
+    gpu.wait(producer.release_fence_.Get(), seq);
+    require(producer.release_fence_->GetCompletedValue() == seq, "release fence: signalled with the slot's maskSeq");
+
+    require(consumer.acquire(999) == nullptr, "pairing: another frame's display time gets no mask");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::no_slot, "pairing: no slot for it");
+    require(consumer.acquire(0) == nullptr, "pairing: display time 0 never pairs");
+
+    // A slot whose eyes are not valid.
+    producer.commit(1100, 255, 0U);
+    producer.signal(seq + 1);
+    require(consumer.acquire(1100) == nullptr, "views: no valid view, no mask");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::no_view, "views: reported");
+
+    // Stale: the producer's heartbeat older than 500 ms.
+    const std::uint64_t stale_seq = producer.commit(1200, 255);
+    producer.signal(stale_seq);
+    producer.publish(800);
+    require(consumer.acquire(1200) == nullptr, "stale: no mask");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::stale, "stale: reported");
+    // The reader heartbeat is stored whatever the header says: an idle
+    // producer starts again only after it sees one.
+    producer.clear_reader_heartbeat();
+    producer.header_.flags = 0;
+    producer.publish();
+    require(consumer.acquire(1201) == nullptr, "inactive: no mask");
+    require(consumer.stats().last == xrfg::CockpitMaskLookup::header_unusable, "inactive: reported");
+    require(producer.reader_heartbeat() != 0, "heartbeat: stored while the export is inactive");
+    producer.header_.flags =
+        cm::header_flags::active | cm::header_flags::fence | cm::header_flags::release_fence;
+
+    // Another adapter.
+    const std::uint64_t luid = producer.header_.adapterLuid;
+    producer.header_.adapterLuid = luid + 1;
+    producer.publish();
+    require(consumer.acquire(1200) == nullptr &&
+            consumer.stats().last == xrfg::CockpitMaskLookup::adapter_mismatch,
+        "adapter: another adapter's export is not used");
+    producer.header_.adapterLuid = luid;
+    producer.publish();
+    require(consumer.acquire(1200) != nullptr, "stale: fresh again, the frame pairs");
+
+    // A new generation: new textures and fences, opened again.
+    const auto opened = consumer.stats().generations_opened;
+    producer.make_resources();
+    const std::uint64_t new_seq = producer.commit(1300, 128);
+    auto renewed = consumer.acquire(1300);
+    require(renewed != nullptr && consumer.stats().generations_opened == opened + 1,
+        "generation: a new generation is opened and pairs");
+    producer.signal(new_seq);
+    gpu.wait(renewed->ready_fence.Get(), renewed->ready_value);
+    require(gpu.readback(renewed->texture.Get()) == producer.last_pattern_,
+        "generation: the copy holds the new generation's slot");
+
+    // The ring: frames still held by a synthesizer are never written over.
+    std::vector<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>> held;
+    held.push_back(std::move(renewed));
+    for (std::int64_t time = 1400; time < 1400 + 12; ++time) {
+        const std::uint64_t ring_seq = producer.commit(time, 255);
+        producer.signal(ring_seq);
+        auto next = consumer.acquire(time);
+        if (next == nullptr) {
+            require(consumer.stats().last == xrfg::CockpitMaskLookup::ring_busy, "ring: busy when all are held");
+            break;
+        }
+        for (const auto& other : held) {
+            require(other->texture != next->texture, "ring: a held copy is not reused");
+        }
+        held.push_back(std::move(next));
+    }
+    require(held.size() <= 6, "ring: at most ring_size copies");
+    held.clear();
+    require(std::find(logged.begin(), logged.end(), 2) != logged.end(), "log: the generations opened (result=2)");
+    require(std::find(logged.begin(), logged.end(), 1) != logged.end(), "log: the presence changes (result=1)");
+    std::cout << "cockpit mask: pairing, GPU wait, release fence, staleness, generation, adapter, ring\n";
+}
+
+void test_stall_stops_the_heartbeat(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"stall");
+    FakeProducer producer(gpu, suffix);
+    auto options = test_options(suffix);
+    options.stall_milliseconds = 150;
+    std::uint64_t never_signalled = 0;
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+        never_signalled = producer.commit(2000, 255);
+        auto frame = consumer.acquire(2000);
+        require(frame != nullptr && producer.reader_heartbeat() != 0, "stall: paired, heartbeat stored");
+        Sleep(250);
+        producer.clear_reader_heartbeat();
+        producer.commit(2001, 255);
+        require(consumer.acquire(2001) == nullptr &&
+                consumer.stats().last == xrfg::CockpitMaskLookup::stalled,
+            "stall: a copy that never completes turns the masks off");
+        // Whatever waited on the copy is released.
+        require(frame->ready_fence->GetCompletedValue() >= frame->ready_value,
+            "stall: the copy's dependants are released");
+        require(consumer.acquire(2002) == nullptr && producer.reader_heartbeat() == 0,
+            "stall: the heartbeat is no longer stored");
+        require(consumer.stats().heartbeats_stopped == 1, "stall: the heartbeat stopped once");
+    }
+    // The producer's late signal lets the copy queue finish.
+    producer.signal(never_signalled + 10);
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, test_options(suffix)), "consumer initialize");
+        const std::uint64_t seq = producer.commit(3000, 255);
+        producer.signal(seq);
+        require(consumer.acquire(3000) != nullptr && producer.reader_heartbeat() != 0,
+            "end: heartbeat stored while consuming");
+    }
+    require(producer.reader_heartbeat() == 0, "end: the heartbeat is cleared when the consumer goes");
+    std::cout << "cockpit mask: a stalled copy turns masks and the heartbeat off; the end clears it\n";
+}
+
+void test_heartbeat_is_throttled(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"throttle");
+    FakeProducer producer(gpu, suffix);
+    auto options = test_options(suffix);
+    options.heartbeat_store_milliseconds = 250;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    for (std::int64_t time = 4000; time < 4010; ++time) {
+        const std::uint64_t seq = producer.commit(time, 255);
+        producer.signal(seq);
+        require(consumer.acquire(time) != nullptr, "throttle: paired");
+    }
+    require(consumer.stats().heartbeats_stored == 1, "throttle: one store per interval");
+    Sleep(300);
+    const std::uint64_t seq = producer.commit(4100, 255);
+    producer.signal(seq);
+    require(consumer.acquire(4100) != nullptr && consumer.stats().heartbeats_stored == 2,
+        "throttle: stored again after the interval");
+    std::cout << "cockpit mask: the heartbeat is stored at most every 250 ms\n";
+}
+
+// `[ofxr] cockpit_mask`: 1 on, missing or anything else off; and
+// `nvidia_occlusion_aware` takes 3.
+void test_ini() {
+    const auto directory = std::filesystem::temp_directory_path() /
+        (L"ofxr-cockpit-mask-" + std::to_wstring(GetCurrentProcessId()));
+    std::filesystem::create_directories(directory);
+    const auto write = [&](const char* text) {
+        std::ofstream(directory / L"ofxr_bridge.ini", std::ios::trunc) << text;
+    };
+    write("[ofxr]\nbackend=nvidia\n");
+    const bool missing = xrfg::implicit_layer::read_cockpit_mask(directory);
+    write("[ofxr]\ncockpit_mask=1\nnvidia_occlusion_aware=3\n");
+    const bool on = xrfg::implicit_layer::read_cockpit_mask(directory);
+    const auto level = xrfg::implicit_layer::read_nvidia_occlusion_aware(directory);
+    write("[ofxr]\ncockpit_mask=0\nnvidia_occlusion_aware=4\n");
+    const bool off = xrfg::implicit_layer::read_cockpit_mask(directory);
+    const auto out_of_range = xrfg::implicit_layer::read_nvidia_occlusion_aware(directory);
+    std::error_code ignored;
+    std::filesystem::remove_all(directory, ignored);
+    require(!missing && on && !off && !xrfg::implicit_layer::read_cockpit_mask({}),
+        "ini: cockpit_mask is 1 on, off otherwise");
+    require(level == 3 && out_of_range == 0, "ini: nvidia_occlusion_aware takes 3");
+    std::cout << "cockpit mask: [ofxr] cockpit_mask and nvidia_occlusion_aware=3 read\n";
+}
+
+}  // namespace
+
+int main() {
+    try {
+        test_ini();
+        Gpu gpu;
+        test_missing_block_retries_once_a_second(gpu);
+        test_pairing_gpu_wait_release_and_heartbeat(gpu);
+        test_heartbeat_is_throttled(gpu);
+        test_stall_stops_the_heartbeat(gpu);
+        std::cout << "cockpit mask consumer tests passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "cockpit mask consumer test failed: " << error.what() << '\n';
+        return 1;
+    }
+}
