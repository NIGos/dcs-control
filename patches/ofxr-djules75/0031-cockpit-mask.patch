+            slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        for (UINT block = 0; block < kMaxReprojectionViews; ++block) {
+            device->CreateShaderResourceView(
+                bound ? cockpit_mask_target.Get() : cockpit_mask_zero.Get(),
+                &view,
+                offset_cpu_handle(
+                    start,
+                    block * kDescriptorBlockSize + kCockpitMaskSrvDescriptor,
+                    descriptor_increment));
+        }
+    }
+
+    // DCS Control (0031): the resample's block: the two frames' masks (t0
+    // previous, t1 current), the target-view mask (u0), typed nulls besides.
+    void write_cockpit_mask_block(
+        WorkSlot& slot, ID3D12Resource* previous_mask, ID3D12Resource* current_mask) noexcept {
+        const D3D12_CPU_DESCRIPTOR_HANDLE start =
+            slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        const UINT base = kCockpitMaskBlock * kDescriptorBlockSize;
+        D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+        view.Format = DXGI_FORMAT_R8_UNORM;
+        view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        view.Texture2D.MipLevels = 1;
+        for (UINT index = 0; index < kSrvDescriptorCount; ++index) {
+            ID3D12Resource* resource = index == 0 ? previous_mask
+                : index == 1                     ? current_mask
+                                                 : nullptr;
+            device->CreateShaderResourceView(
+                resource, &view, offset_cpu_handle(start, base + index, descriptor_increment));
+        }
+        D3D12_UNORDERED_ACCESS_VIEW_DESC target{};
+        target.Format = DXGI_FORMAT_R8_UNORM;
+        target.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+        target.Texture2DArray.ArraySize = kMaxReprojectionViews;
+        device->CreateUnorderedAccessView(
+            cockpit_mask_target.Get(), nullptr, &target,
+            offset_cpu_handle(start, base + kSrvDescriptorCount, descriptor_increment));
+        D3D12_UNORDERED_ACCESS_VIEW_DESC null_target{};
+        null_target.Format = DXGI_FORMAT_R8_UNORM;
+        null_target.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        for (UINT index = 1; index < kUavDescriptorCount; ++index) {
+            device->CreateUnorderedAccessView(
+                nullptr, nullptr, &null_target,
+                offset_cpu_handle(start, base + kSrvDescriptorCount + index, descriptor_increment));
+        }
+    }
+
+    // The eye of a frame's mask a view uses: its mask_view, or for a direct
+    // caller (no mask_view) the view's own index.
+    [[nodiscard]] static UINT cockpit_mask_eye(
+        const D3D12ReprojectionView& view, UINT view_index) noexcept {
+        return view.mask_view < 2U ? view.mask_view : (view_index < 2U ? view_index : 2U);
+    }
+
+    // DCS Control (0031): records the resample of pair_mask_current (and
+    // pair_mask_previous where it has the eye) into the target-view mask, on
+    // `list` before the composition, and binds it (t10). Returns the
+    // composition's flag bits, 0 where nothing was bound.
+    [[nodiscard]] UINT record_cockpit_mask(
+        ID3D12GraphicsCommandList* list,
+        WorkSlot& slot,
+        const RollingSource& previous_source,
+        std::span<const D3D12ReprojectionView> target_views) noexcept {
+        pair_mask_bound = false;
+        pair_mask_previous_bound = false;
+        D3D12CockpitMaskFrame* const current = pair_mask_current.get();
+        D3D12CockpitMaskFrame* const previous_frame = pair_mask_previous.get();
+        // DCS Control (0031): only where the masked composition exists
+        // ([ofxr] cockpit_mask made it).
+        ID3D12PipelineState* const plain = backend == D3D12OpticalFlowBackend::nvidia
+            ? (nvidia_options.bidirectional ? nvidia_bidirectional_graphics_pipeline.Get()
+                                            : nvidia_graphics_pipeline.Get())
+            : graphics_pipeline.Get();
+        if (current == nullptr || current->texture == nullptr || current->ready_fence == nullptr ||
+            cockpit_mask_target == nullptr || cockpit_mask_pipeline == nullptr ||
+            masked_pipeline(plain) == nullptr) {
+            write_cockpit_mask_view(slot, false);
+            return 0;
+        }
+        std::array<CockpitMaskParameters, kMaxReprojectionViews> views{};
+        bool any = false;
+        bool previous_used = false;
+        const UINT width = static_cast<UINT>(image_description.Width);
+        for (UINT index = 0; index < static_cast<UINT>(target_views.size()); ++index) {
+            CockpitMaskParameters& parameters = views[index];
+            const CameraMapping mapping = make_camera_mapping(
+                previous_source.views[index], target_views[index], width, image_description.Height);
+            parameters.cell = cockpit_mask_cell;
+            parameters.slice = index;
+            parameters.target_rect = mapping.target_rect;
+            parameters.target_tangents = mapping.target_tangents;
+            parameters.target_to_previous = mapping.target_to_source_rotation;
+            parameters.output_width =
+                (static_cast<UINT>(mapping.target_rect[2]) + cockpit_mask_cell - 1U) / cockpit_mask_cell;
+            parameters.output_height =
+                (static_cast<UINT>(mapping.target_rect[3]) + cockpit_mask_cell - 1U) / cockpit_mask_cell;
+            const UINT current_eye = cockpit_mask_eye(target_views[index], index);
+            if (current_eye < 2U && current->views[current_eye].valid) {
+                const D3D12CockpitMaskView& view = current->views[current_eye];
+                parameters.flags |= 2U;
+                parameters.current_rect = {float(view.x), float(view.y), float(view.width), float(view.height)};
+                parameters.current_fov = view.fov_tan;
+            }
+            const UINT previous_eye = cockpit_mask_eye(previous_source.views[index], index);
+            // Only with the current frame's own: a frame without its mask is
+            // not given another frame's.
+            if ((parameters.flags & 2U) != 0U && previous_frame != nullptr && previous_frame != current &&
+                previous_frame->texture != nullptr && previous_frame->ready_fence != nullptr &&
+                previous_eye < 2U && previous_frame->views[previous_eye].valid) {
+                const D3D12CockpitMaskView& view = previous_frame->views[previous_eye];
+                parameters.flags |= 1U;
+                parameters.previous_rect = {float(view.x), float(view.y), float(view.width), float(view.height)};
+                parameters.previous_fov = view.fov_tan;
+                previous_used = true;
+            }
+            any = any || parameters.flags != 0U;
+        }
+        if (!any) {
+            write_cockpit_mask_view(slot, false);
+            return 0;
+        }
+        ID3D12Resource* const current_texture = current->texture.Get();
+        ID3D12Resource* const previous_texture =
+            previous_used ? previous_frame->texture.Get() : current_texture;
+        write_cockpit_mask_block(slot, previous_texture, current_texture);
+        write_cockpit_mask_view(slot, true);
+
+        std::array<D3D12_RESOURCE_BARRIER, 3> before{};
+        UINT before_count = 0;
+        before[before_count++] = transition_barrier(
+            cockpit_mask_target.Get(), D3D12_RESOURCE_STATE_COMMON,
+            D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        before[before_count++] = transition_barrier(
+            current_texture, D3D12_RESOURCE_STATE_COMMON,
+            D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        if (previous_texture != current_texture) {
+            before[before_count++] = transition_barrier(
+                previous_texture, D3D12_RESOURCE_STATE_COMMON,
+                D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        }
+        list->ResourceBarrier(before_count, before.data());
+        ID3D12DescriptorHeap* heaps[] = {slot.descriptor_heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetComputeRootSignature(root_signature.Get());
+        list->SetPipelineState(cockpit_mask_pipeline.Get());
+        const D3D12_GPU_DESCRIPTOR_HANDLE block = offset_gpu_handle(
+            slot.descriptor_heap->GetGPUDescriptorHandleForHeapStart(),
+            kCockpitMaskBlock * kDescriptorBlockSize,
+            descriptor_increment);
+        list->SetComputeRootDescriptorTable(0, block);
+        list->SetComputeRootDescriptorTable(
+            1, offset_gpu_handle(block, kSrvDescriptorCount, descriptor_increment));
+        for (UINT index = 0; index < static_cast<UINT>(target_views.size()); ++index) {
+            const CockpitMaskParameters& parameters = views[index];
+            if (parameters.output_width == 0 || parameters.output_height == 0) {
+                continue;
+            }
+            // A view without a mask of its own is written all 0, so nothing
+            // left over from an earlier pair stays in its slice.
+            list->SetComputeRoot32BitConstants(
+                2, static_cast<UINT>(sizeof(CockpitMaskParameters) / sizeof(UINT)), &parameters, 0);
+            list->Dispatch(
+                (parameters.output_width + 7U) / 8U, (parameters.output_height + 7U) / 8U, 1);
+        }
+        std::array<D3D12_RESOURCE_BARRIER, 3> after{};
+        UINT after_count = 0;
+        after[after_count++] = transition_barrier(
+            cockpit_mask_target.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS,
+            D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        after[after_count++] = transition_barrier(
+            current_texture, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+            D3D12_RESOURCE_STATE_COMMON);
+        if (previous_texture != current_texture) {
+            after[after_count++] = transition_barrier(
+                previous_texture, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE,
+                D3D12_RESOURCE_STATE_COMMON);
+        }
+        list->ResourceBarrier(after_count, after.data());
+        pair_mask_bound = true;
+        pair_mask_previous_bound = previous_used;
+        return kSynthesisCockpitMaskFlag |
+            (cockpit_mask_cell_code << kSynthesisCockpitMaskCellShift);
+    }
