diff --git a/src/d3d12/cockpit_mask.cpp b/src/d3d12/cockpit_mask.cpp
new file mode 100644
--- /dev/null
+++ b/src/d3d12/cockpit_mask.cpp
@@ -0,0 +1,757 @@
+// DCS Control (0031): the cockpit mask consumer (see xrfg/cockpit_mask.hpp).
+//
+// The producer (DCS Control's engine module, R65 v1) writes a 1024-byte block
+// under a seqlock and three R8 atlases with a timeline fence, all NT handles
+// of this process. Each frame's mask is copied out of its slot at once, on a
+// copy queue of our own that waits on the producer's fence on the GPU, into a
+// private texture the synthesis then reads at its own pace: the producer's
+// slot is free again as soon as the copy has run (and the release fence, when
+// the producer offers one, tells it exactly when).
+
+#include "xrfg/cockpit_mask.hpp"
+#include "xrfg/dcsvr_cockpit_mask.h"
+
+#include <windows.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <limits>
+#include <optional>
+
+namespace xrfg {
+
+using Microsoft::WRL::ComPtr;
+namespace cm = dcsvr_cockpit_mask;
+
+void D3D12CockpitMaskFrame::note_reader(ID3D12Fence* fence, std::uint64_t value) noexcept {
+    if (fence == nullptr || value == 0) {
+        return;
+    }
+    try {
+        std::scoped_lock lock(mutex_);
+        for (auto& reader : readers_) {
+            if (reader.first.Get() == fence) {
+                reader.second = std::max(reader.second, value);
+                return;
+            }
+        }
+        readers_.emplace_back(fence, value);
+    } catch (...) {
+    }
+}
+
+bool D3D12CockpitMaskFrame::readers_complete() noexcept {
+    try {
+        std::scoped_lock lock(mutex_);
+        readers_.erase(
+            std::remove_if(readers_.begin(), readers_.end(),
+                [](const auto& reader) {
+                    // A removed device reports UINT64_MAX: nothing runs there.
+                    return reader.first->GetCompletedValue() >= reader.second;
+                }),
+            readers_.end());
+        return readers_.empty();
+    } catch (...) {
+        return false;
+    }
+}
+
+void D3D12CockpitMaskFrame::clear_readers() noexcept {
+    try {
+        std::scoped_lock lock(mutex_);
+        readers_.clear();
+    } catch (...) {
+    }
+}
+
+namespace {
+
+[[nodiscard]] std::int64_t qpc_now() noexcept {
+    LARGE_INTEGER counter{};
+    QueryPerformanceCounter(&counter);
+    return counter.QuadPart;
+}
+
+constexpr std::uint64_t kStatsLogMilliseconds = 10000;
+
+// The reader heartbeat (R67): "masks wanted", the header's reader_heartbeat().
+void store_reader_heartbeat(void* block, std::int64_t qpc) noexcept {
+    cm::reader_heartbeat(static_cast<cm::Header*>(block), qpc);
+}
+
+}  // namespace
+
+struct CockpitMaskConsumer::Impl {
+    struct Opened {
+        std::uint32_t generation{};
+        std::array<ComPtr<ID3D12Resource>, cm::slot_count> textures{};
+        ComPtr<ID3D12Fence> fence;
+        ComPtr<ID3D12Fence> release_fence;
+        std::uint32_t atlas_width{};
+        std::uint32_t atlas_height{};
+        // The last copy that read these textures.
+        std::uint64_t last_use_copy_value{};
+    };
+
+    struct RingEntry {
+        std::shared_ptr<D3D12CockpitMaskFrame> frame;
+        ComPtr<ID3D12CommandAllocator> allocator;
+        ComPtr<ID3D12GraphicsCommandList> list;
+        std::uint64_t copy_value{};
+        std::uint32_t width{};
+        std::uint32_t height{};
+    };
+
+    ComPtr<ID3D12Device> device;
+    ComPtr<ID3D12CommandQueue> queue;
+    ComPtr<ID3D12Fence> copy_fence;
+    // Signalled by the copy queue alone, after copy_fence: what has really
+    // run there (a stall signals copy_fence from the CPU to release the
+    // synthesis, never this one).
+    ComPtr<ID3D12Fence> done_fence;
+    HANDLE fence_event{};
+    std::uint64_t next_copy_value{1};
+    std::uint64_t last_copy_value{};
+    std::int64_t last_copy_qpc{};
+    std::int64_t qpc_frequency{1};
+    std::uint64_t adapter_luid{};
+    DWORD process_id{};
+    Logger logger;
+    CockpitMaskConsumerOptions options;
+    std::wstring name;
+
+    HANDLE mapping{};
+    const cm::Header* block{};
+    // The same view, when it could be mapped writable: the reader heartbeat.
+    void* writable_block{};
+    std::int64_t last_heartbeat_qpc{};
+    std::uint64_t next_open_ms{};
+
+    std::optional<Opened> opened;
+    std::vector<Opened> retired;
+    std::uint32_t open_failure_logged_generation{};
+    std::vector<RingEntry> ring;
+    std::uint32_t next_ring{};
+    std::shared_ptr<D3D12CockpitMaskFrame> last_frame;
+    std::int64_t last_display_time{};
+    std::uint64_t last_release_value{};
+    bool stalled{};
+
+    CockpitMaskConsumerStats stats{};
+    // Logging: presence from what the last second saw.
+    std::uint64_t last_paired_ms{};
+    std::uint64_t last_usable_ms{};
+    std::uint64_t last_block_ms{};
+    CockpitMaskPresence logged_presence{CockpitMaskPresence::absent};
+    std::uint64_t last_presence_log_ms{};
+    std::uint64_t last_stats_log_ms{};
+    CockpitMaskConsumerStats stats_at_log{};
+    mutable std::mutex mutex;
+
+    ~Impl() {
+        stop_heartbeat();
+        if (block != nullptr) {
+            UnmapViewOfFile(block);
+        }
+        if (mapping != nullptr) {
+            CloseHandle(mapping);
+        }
+        if (fence_event != nullptr) {
+            CloseHandle(fence_event);
+        }
+    }
+
+    void log(std::int64_t result, std::uint64_t a, std::uint64_t b, std::uint64_t c) noexcept {
+        if (!logger) {
+            return;
+        }
+        try {
+            logger(result, a, b, c);
+        } catch (...) {
+        }
+    }
+
+    [[nodiscard]] std::uint64_t completed_copies() const noexcept {
+        return done_fence ? done_fence->GetCompletedValue() : 0;
+    }
+
+    // Waits up to `milliseconds` for every copy to complete.
+    [[nodiscard]] bool drain(DWORD milliseconds) noexcept {
+        if (!done_fence || last_copy_value == 0 || completed_copies() >= last_copy_value) {
+            return true;
+        }
+        if (fence_event == nullptr ||
+            FAILED(done_fence->SetEventOnCompletion(last_copy_value, fence_event))) {
+            return false;
+        }
+        return WaitForSingleObject(fence_event, milliseconds) == WAIT_OBJECT_0;
+    }
+
+    // "No masks wanted": the producer idles at once instead of after 2 s.
+    void stop_heartbeat() noexcept {
+        if (writable_block != nullptr && last_heartbeat_qpc != 0) {
+            store_reader_heartbeat(writable_block, 0);
+            ++stats.heartbeats_stopped;
+        }
+        last_heartbeat_qpc = 0;
+    }
+
+    // "Masks wanted", whatever the header says (the producer starts only
+    // after it sees one), at most every kHeartbeatMilliseconds: called only
+    // while frame generation consumes masks (acquire), so it stops with it.
+    void heartbeat(std::int64_t now) noexcept {
+        if (writable_block == nullptr) {
+            return;
+        }
+        const std::int64_t interval =
+            qpc_frequency * static_cast<std::int64_t>(options.heartbeat_store_milliseconds) / 1000;
+        if (last_heartbeat_qpc != 0 && now - last_heartbeat_qpc < interval) {
+            return;
+        }
+        store_reader_heartbeat(writable_block, now);
+        last_heartbeat_qpc = now;
+        ++stats.heartbeats_stored;
+    }
+
+    void close_block() noexcept {
+        writable_block = nullptr;
+        last_heartbeat_qpc = 0;
+        if (block != nullptr) {
+            UnmapViewOfFile(block);
+            block = nullptr;
+        }
+        if (mapping != nullptr) {
+            CloseHandle(mapping);
+            mapping = nullptr;
+        }
+    }
+
+    void retire_opened() noexcept {
+        if (!opened) {
+            return;
+        }
+        try {
+            retired.push_back(std::move(*opened));
+        } catch (...) {
+            // Nowhere to keep them: wait for the copies that read them.
+            static_cast<void>(drain(1000));
+        }
+        opened.reset();
+        last_release_value = 0;
+    }
+
+    void drop_retired() noexcept {
+        const std::uint64_t completed = completed_copies();
+        retired.erase(
+            std::remove_if(retired.begin(), retired.end(),
+                [completed](const Opened& old) { return old.last_use_copy_value <= completed; }),
+            retired.end());
+    }
+
+    // The copy queue never finished a copy (the producer's fence not
+    // signalled, a hang): release whatever waits on our fence and stop.
+    [[nodiscard]] bool check_stall(std::int64_t now) noexcept {
+        if (stalled) {
+            return true;
+        }
+        const std::uint64_t completed = completed_copies();
+        if (completed == std::numeric_limits<std::uint64_t>::max()) {
+            stalled = true;
+            log(5, last_copy_value, completed, 0);
+            return true;
+        }
+        if (last_copy_value == 0 || completed >= last_copy_value) {
+            return false;
+        }
+        const double waited_ms =
+            double(now - last_copy_qpc) * 1000.0 / double(std::max<std::int64_t>(qpc_frequency, 1));
+        if (waited_ms < double(options.stall_milliseconds)) {
+            return false;
+        }
+        static_cast<void>(copy_fence->Signal(last_copy_value));
+        stalled = true;
+        log(5, last_copy_value, completed, static_cast<std::uint64_t>(waited_ms));
+        return true;
+    }
+
+    // The block, looked for at most once a retry interval while missing.
+    [[nodiscard]] CockpitMaskLookup open_block(std::uint64_t now_ms) noexcept {
+        if (block != nullptr) {
+            return CockpitMaskLookup::paired;
+        }
+        if (next_open_ms != 0 && now_ms < next_open_ms) {
+            return CockpitMaskLookup::retry_wait;
+        }
+        next_open_ms = now_ms + options.retry_milliseconds;
+        // Writable for the reader heartbeat alone; read-only if refused (no
+        // heartbeat: a producer that waits for one then stays idle).
+        bool writable = true;
+        mapping = OpenFileMappingW(FILE_MAP_READ | FILE_MAP_WRITE, FALSE, name.c_str());
+        if (mapping == nullptr) {
+            writable = false;
+            mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, name.c_str());
+        }
+        if (mapping == nullptr) {
+            return CockpitMaskLookup::no_block;
+        }
+        void* view = MapViewOfFile(
+            mapping, writable ? FILE_MAP_READ | FILE_MAP_WRITE : FILE_MAP_READ, 0, 0, sizeof(cm::Header));
+        if (view == nullptr) {
+            CloseHandle(mapping);
+            mapping = nullptr;
+            return CockpitMaskLookup::no_block;
+        }
+        block = static_cast<const cm::Header*>(view);
+        writable_block = writable ? view : nullptr;
+        last_heartbeat_qpc = 0;
+        return CockpitMaskLookup::paired;
+    }
+
+    [[nodiscard]] CockpitMaskLookup open_handles(const cm::Header& header) noexcept {
+        Opened next{};
+        next.generation = header.generation;
+        next.atlas_width = header.atlasW;
+        next.atlas_height = header.atlasH;
+        const auto failed = [&](HRESULT result, std::uint64_t which) {
+            if (open_failure_logged_generation != header.generation) {
+                open_failure_logged_generation = header.generation;
+                log(4, static_cast<std::uint32_t>(result), which, header.generation);
+            }
+            return CockpitMaskLookup::open_failed;
+        };
+        for (int index = 0; index < cm::slot_count; ++index) {
+            const HRESULT result = device->OpenSharedHandle(
+                reinterpret_cast<HANDLE>(static_cast<std::uintptr_t>(header.textureHandle[index])),
+                IID_PPV_ARGS(next.textures[index].GetAddressOf()));
+            if (FAILED(result)) {
+                return failed(result, static_cast<std::uint64_t>(index));
+            }
+            const D3D12_RESOURCE_DESC description = next.textures[index]->GetDesc();
+            if (description.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+                (description.Format != DXGI_FORMAT_R8_UNORM &&
+                    description.Format != DXGI_FORMAT_R8_TYPELESS) ||
+                description.Width < header.atlasW || description.Height < header.atlasH ||
+                description.SampleDesc.Count != 1) {
+                return failed(E_INVALIDARG, static_cast<std::uint64_t>(index));
+            }
+        }
+        HRESULT result = device->OpenSharedHandle(
+            reinterpret_cast<HANDLE>(static_cast<std::uintptr_t>(header.fenceHandle)),
+            IID_PPV_ARGS(next.fence.GetAddressOf()));
+        if (FAILED(result)) {
+            return failed(result, 3);
+        }
+        if (options.use_release_fence && (header.flags & cm::header_flags::release_fence) != 0 &&
+            header.releaseFenceHandle != 0) {
+            // Optional: without it the copy at once is the protection.
+            if (FAILED(device->OpenSharedHandle(
+                    reinterpret_cast<HANDLE>(
+                        static_cast<std::uintptr_t>(header.releaseFenceHandle)),
+                    IID_PPV_ARGS(next.release_fence.GetAddressOf())))) {
+                next.release_fence.Reset();
+            }
+        }
+        // The handles stay open for 2 s after a generation change, so they
+        // were valid when opened only if the generation still holds now.
+        cm::Header again{};
+        if (!cm::seqlock_read(block, again) || again.generation != header.generation) {
+            return CockpitMaskLookup::generation_changed;
+        }
+        retire_opened();
+        opened = std::move(next);
+        ++stats.generations_opened;
+        log(2, header.generation,
+            static_cast<std::uint64_t>(header.atlasW) |
+                (static_cast<std::uint64_t>(header.atlasH) << 32U),
+            static_cast<std::uint64_t>(header.flags) |
+                (opened->release_fence ? 0x100U : 0U));
+        return CockpitMaskLookup::paired;
+    }
+
+    // Our producer-facing promise: every slot up to `value` may be written.
+    void signal_release(std::uint64_t value) noexcept {
+        if (!opened || !opened->release_fence || value <= last_release_value) {
+            return;
+        }
+        if (SUCCEEDED(queue->Signal(opened->release_fence.Get(), value))) {
+            last_release_value = value;
+            ++stats.releases_signalled;
+        }
+    }
+
+    [[nodiscard]] RingEntry* free_entry(std::uint32_t width, std::uint32_t height) noexcept {
+        const std::uint64_t completed = completed_copies();
+        const std::size_t count = ring.size();
+        for (std::size_t step = 0; step < count; ++step) {
+            RingEntry& entry = ring[(next_ring + step) % count];
+            if (entry.frame && entry.frame.use_count() > 1) {
+                continue;
+            }
+            if (entry.copy_value > completed) {
+                continue;
+            }
+            if (entry.frame && !entry.frame->readers_complete()) {
+                continue;
+            }
+            if (!entry.frame || entry.width != width || entry.height != height) {
+                if (!create_entry(entry, width, height)) {
+                    return nullptr;
+                }
+            }
+            next_ring = static_cast<std::uint32_t>((next_ring + step + 1) % count);
+            return &entry;
+        }
+        return nullptr;
+    }
+
+    [[nodiscard]] bool create_entry(RingEntry& entry, std::uint32_t width, std::uint32_t height) noexcept {
+        try {
+            auto frame = std::make_shared<D3D12CockpitMaskFrame>();
+            D3D12_HEAP_PROPERTIES heap{};
+            heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+            D3D12_RESOURCE_DESC description{};
+            description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+            description.Width = width;
+            description.Height = height;
+            description.DepthOrArraySize = 1;
+            description.MipLevels = 1;
+            description.Format = DXGI_FORMAT_R8_UNORM;
+            description.SampleDesc.Count = 1;
+            description.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+            if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &description,
+                    D3D12_RESOURCE_STATE_COMMON, nullptr,
+                    IID_PPV_ARGS(frame->texture.GetAddressOf())))) {
+                return false;
+            }
+            frame->texture->SetName(L"OFXR Cockpit Mask Copy");
+            if (!entry.allocator) {
+                if (FAILED(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_COPY,
+                        IID_PPV_ARGS(entry.allocator.GetAddressOf()))) ||
+                    FAILED(device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_COPY,
+                        entry.allocator.Get(), nullptr, IID_PPV_ARGS(entry.list.GetAddressOf()))) ||
+                    FAILED(entry.list->Close())) {
+                    entry.allocator.Reset();
+                    entry.list.Reset();
+                    return false;
+                }
+            }
+            frame->ready_fence = copy_fence;
+            entry.frame = std::move(frame);
+            entry.width = width;
+            entry.height = height;
+            return true;
+        } catch (...) {
+            return false;
+        }
+    }
+
+    [[nodiscard]] CockpitMaskLookup lookup(
+        std::int64_t display_time, std::shared_ptr<D3D12CockpitMaskFrame>* output) noexcept {
+        if (!device) {
+            return CockpitMaskLookup::disabled;
+        }
+        const std::int64_t now = qpc_now();
+        const std::uint64_t now_ms = GetTickCount64();
+        if (check_stall(now)) {
+            stop_heartbeat();
+            return CockpitMaskLookup::stalled;
+        }
+        // One frame, several swapchains: the same mask again.
+        if (last_frame && display_time != 0 && display_time == last_display_time) {
+            *output = last_frame;
+            return CockpitMaskLookup::paired;
+        }
+        last_frame.reset();
+        drop_retired();
+        if (const CockpitMaskLookup state = open_block(now_ms);
+            state != CockpitMaskLookup::paired) {
+            return state;
+        }
+        heartbeat(now);
+        last_block_ms = now_ms;
+        cm::Header header{};
+        if (!cm::seqlock_read(block, header)) {
+            return CockpitMaskLookup::header_busy;
+        }
+        if (!cm::header_usable(header, process_id) ||
+            (header.flags & cm::header_flags::fence) == 0 || header.fenceHandle == 0) {
+            retire_opened();
+            return CockpitMaskLookup::header_unusable;
+        }
+        if (header.adapterLuid != adapter_luid) {
+            retire_opened();
+            return CockpitMaskLookup::adapter_mismatch;
+        }
+        if (!cm::heartbeat_fresh(header, now, options.heartbeat_milliseconds)) {
+            return CockpitMaskLookup::stale;
+        }
+        last_usable_ms = now_ms;
+        stats.generation = header.generation;
+        if (!opened || opened->generation != header.generation) {
+            const CockpitMaskLookup opened_result = open_handles(header);
+            if (opened_result != CockpitMaskLookup::paired) {
+                return opened_result;
+            }
+        }
+        const int slot = cm::find_slot(header, display_time);
+        if (slot < 0) {
+            signal_release(header.newestMaskSeq);
+            return CockpitMaskLookup::no_slot;
+        }
+        const cm::MaskSlot& source = header.slot[slot];
+        std::array<D3D12CockpitMaskView, 2> views{};
+        UINT left = std::numeric_limits<UINT>::max(), top = std::numeric_limits<UINT>::max();
+        UINT right = 0, bottom = 0;
+        for (int eye = 0; eye < 2; ++eye) {
+            if (!cm::view_usable(header, slot, eye)) {
+                continue;
+            }
+            const cm::MaskView& view = source.view[eye];
+            if (!(view.fovTan[1] > view.fovTan[0]) || !(view.fovTan[2] > view.fovTan[3]) ||
+                view.x + view.w > opened->atlas_width || view.y + view.h > opened->atlas_height) {
+                continue;
+            }
+            views[eye].valid = true;
+            views[eye].x = view.x;
+            views[eye].y = view.y;
+            views[eye].width = view.w;
+            views[eye].height = view.h;
+            views[eye].fov_tan = {view.fovTan[0], view.fovTan[1], view.fovTan[2], view.fovTan[3]};
+            left = std::min(left, view.x);
+            top = std::min(top, view.y);
+            right = std::max(right, view.x + view.w);
+            bottom = std::max(bottom, view.y + view.h);
+        }
+        if (!views[0].valid && !views[1].valid) {
+            signal_release(header.newestMaskSeq);
+            return CockpitMaskLookup::no_view;
+        }
+        RingEntry* entry = free_entry(opened->atlas_width, opened->atlas_height);
+        if (entry == nullptr) {
+            signal_release(header.newestMaskSeq);
+            return CockpitMaskLookup::ring_busy;
+        }
+        if (FAILED(entry->allocator->Reset()) ||
+            FAILED(entry->list->Reset(entry->allocator.Get(), nullptr))) {
+            return CockpitMaskLookup::copy_failed;
+        }
+        D3D12_TEXTURE_COPY_LOCATION destination{};
+        destination.pResource = entry->frame->texture.Get();
+        destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        destination.SubresourceIndex = 0;
+        D3D12_TEXTURE_COPY_LOCATION origin{};
+        origin.pResource = opened->textures[static_cast<std::size_t>(slot)].Get();
+        origin.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        origin.SubresourceIndex = 0;
+        const D3D12_BOX box{left, top, 0, right, bottom, 1};
+        entry->list->CopyTextureRegion(&destination, left, top, 0, &origin, &box);
+        if (FAILED(entry->list->Close())) {
+            return CockpitMaskLookup::copy_failed;
+        }
+        // The producer signals maskSeq once the slot's writes are queued; the
+        // copy waits for it on the GPU, never here.
+        if (FAILED(queue->Wait(opened->fence.Get(), source.maskSeq))) {
+            return CockpitMaskLookup::copy_failed;
+        }
+        ID3D12CommandList* lists[] = {entry->list.Get()};
+        queue->ExecuteCommandLists(1, lists);
+        const std::uint64_t copy_value = next_copy_value;
+        if (FAILED(queue->Signal(copy_fence.Get(), copy_value)) ||
+            FAILED(queue->Signal(done_fence.Get(), copy_value))) {
+            stalled = true;
+            return CockpitMaskLookup::copy_failed;
+        }
+        ++next_copy_value;
+        // After the copy on the same queue: the slot is ours no longer.
+        signal_release(source.maskSeq);
+        entry->copy_value = copy_value;
+        last_copy_value = copy_value;
+        last_copy_qpc = now;
+        opened->last_use_copy_value = copy_value;
+
+        D3D12CockpitMaskFrame& frame = *entry->frame;
+        frame.clear_readers();
+        frame.ready_fence = copy_fence;
+        frame.ready_value = copy_value;
+        frame.views = views;
+        frame.display_time = display_time;
+        frame.mask_seq = source.maskSeq;
+        last_frame = entry->frame;
+        last_display_time = display_time;
+        last_paired_ms = now_ms;
+        *output = entry->frame;
+        return CockpitMaskLookup::paired;
+    }
+
+    void account(CockpitMaskLookup result) noexcept {
+        stats.last = result;
+        switch (result) {
+        case CockpitMaskLookup::paired:
+            ++stats.paired;
+            break;
+        case CockpitMaskLookup::no_slot:
+            ++stats.no_slot;
+            break;
+        case CockpitMaskLookup::stale:
+            ++stats.stale;
+            break;
+        default:
+            ++stats.other_misses;
+            break;
+        }
+        const std::uint64_t now_ms = GetTickCount64();
+        const auto recent = [now_ms](std::uint64_t at) { return at != 0 && now_ms - at <= 1000U; };
+        stats.presence = recent(last_paired_ms) ? CockpitMaskPresence::active
+            : recent(last_usable_ms)            ? CockpitMaskPresence::unpaired
+            : recent(last_block_ms)             ? CockpitMaskPresence::inactive
+                                                : CockpitMaskPresence::absent;
+        if (stalled) {
+            stats.presence = CockpitMaskPresence::inactive;
+        }
+        // result=1: a change of presence, at most once a log interval.
+        if (stats.presence != logged_presence &&
+            (last_presence_log_ms == 0 ||
+                now_ms - last_presence_log_ms >= options.log_interval_milliseconds)) {
+            logged_presence = stats.presence;
+            last_presence_log_ms = now_ms;
+            log(1, static_cast<std::uint64_t>(stats.presence), static_cast<std::uint64_t>(result),
+                stats.generation);
+        }
+        // result=3: what the last ten seconds saw, while a block exists.
+        if (last_stats_log_ms == 0) {
+            last_stats_log_ms = now_ms;
+            stats_at_log = stats;
+        } else if (now_ms - last_stats_log_ms >= kStatsLogMilliseconds) {
+            const auto saturate16 = [](std::uint64_t value) {
+                return std::min<std::uint64_t>(value, 0xffffU);
+            };
+            if (stats.presence != CockpitMaskPresence::absent ||
+                stats_at_log.presence != CockpitMaskPresence::absent) {
+                log(3, stats.paired - stats_at_log.paired, stats.lookups - stats_at_log.lookups,
+                    saturate16(stats.no_slot - stats_at_log.no_slot) |
+                        (saturate16(stats.stale - stats_at_log.stale) << 16U) |
+                        (saturate16(stats.other_misses - stats_at_log.other_misses) << 32U) |
+                        (static_cast<std::uint64_t>(result) << 48U));
+            }
+            last_stats_log_ms = now_ms;
+            stats_at_log = stats;
+        }
+    }
+};
+
+CockpitMaskConsumer::CockpitMaskConsumer() noexcept = default;
+
+CockpitMaskConsumer::~CockpitMaskConsumer() {
+    if (impl_ == nullptr) {
+        return;
+    }
+    try {
+        std::scoped_lock lock(impl_->mutex);
+        impl_->last_frame.reset();
+        // The copies read the producer's textures and write ours: keep them
+        // alive until the queue is done, and leak them if it never is (a
+        // stalled queue: not waited for at all).
+        if (!impl_->drain(impl_->stalled ? 0U : 1000U)) {
+            impl_->stop_heartbeat();
+            static_cast<void>(impl_.release());
+            return;
+        }
+    } catch (...) {
+    }
+}
+
+HRESULT CockpitMaskConsumer::initialize(
+    ID3D12Device* device, Logger logger, CockpitMaskConsumerOptions options) noexcept {
+    if (device == nullptr) {
+        return E_INVALIDARG;
+    }
+    if (impl_ != nullptr) {
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    try {
+        auto impl = std::make_unique<Impl>();
+        impl->device = device;
+        impl->logger = std::move(logger);
+        impl->options = std::move(options);
+        impl->options.ring_size = std::clamp<std::uint32_t>(impl->options.ring_size, 3U, 16U);
+        impl->name = cm::block_name;
+        if (impl->options.suffix_from_environment) {
+            std::array<wchar_t, 128> suffix{};
+            const DWORD length = GetEnvironmentVariableW(
+                L"DCSVR_PERCEPTION_SHM_SUFFIX", suffix.data(), static_cast<DWORD>(suffix.size()));
+            if (length > 0 && length < suffix.size()) {
+                impl->name.append(suffix.data(), length);
+            }
+        } else {
+            impl->name += impl->options.suffix;
+        }
+        D3D12_COMMAND_QUEUE_DESC queue_description{};
+        queue_description.Type = D3D12_COMMAND_LIST_TYPE_COPY;
+        HRESULT result = device->CreateCommandQueue(
+            &queue_description, IID_PPV_ARGS(impl->queue.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->queue->SetName(L"OFXR Cockpit Mask Copy");
+        result = device->CreateFence(
+            0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(impl->copy_fence.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        result = device->CreateFence(
+            0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(impl->done_fence.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->fence_event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (impl->fence_event == nullptr) {
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        const LUID luid = device->GetAdapterLuid();
+        impl->adapter_luid = static_cast<std::uint64_t>(luid.LowPart) |
+            (static_cast<std::uint64_t>(static_cast<std::uint32_t>(luid.HighPart)) << 32U);
+        impl->process_id = GetCurrentProcessId();
+        LARGE_INTEGER frequency{};
+        QueryPerformanceFrequency(&frequency);
+        impl->qpc_frequency = std::max<std::int64_t>(frequency.QuadPart, 1);
+        impl->ring.resize(impl->options.ring_size);
+        impl_ = std::move(impl);
+        return S_OK;
+    } catch (...) {
+        return E_OUTOFMEMORY;
+    }
+}
+
+std::shared_ptr<D3D12CockpitMaskFrame> CockpitMaskConsumer::acquire(
+    std::int64_t display_time) noexcept {
+    if (impl_ == nullptr) {
+        return nullptr;
+    }
+    try {
+        std::scoped_lock lock(impl_->mutex);
+        ++impl_->stats.lookups;
+        std::shared_ptr<D3D12CockpitMaskFrame> frame;
+        const CockpitMaskLookup result = impl_->lookup(display_time, &frame);
+        impl_->account(result);
+        return result == CockpitMaskLookup::paired ? frame : nullptr;
+    } catch (...) {
+        return nullptr;
+    }
+}
+
+CockpitMaskConsumerStats CockpitMaskConsumer::stats() const noexcept {
+    if (impl_ == nullptr) {
+        CockpitMaskConsumerStats none{};
+        none.last = CockpitMaskLookup::disabled;
+        return none;
+    }
+    try {
+        std::scoped_lock lock(impl_->mutex);
+        return impl_->stats;
+    } catch (...) {
+        return {};
+    }
+}
