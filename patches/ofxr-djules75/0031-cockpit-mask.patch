+// DCS Control (0031): a cockpit mask as DCS Control's engine module shares it
+// (xrfg::D3D12CockpitMaskFrame, R65 v1): `cockpit` (one byte per pixel, the
+// same for both eyes) max-filtered into blocks of `divisor` x `divisor`
+// pixels, one rect per eye side by side in an R8 atlas, each rect's edges the
+// tangents of `views`' fields of view (extended where the last block reaches
+// past the image), complete at once (its fence already signalled).
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> make_cockpit_mask_frame(D3D12WarpFixture& fixture,
+    UINT width, UINT height, const std::vector<std::uint8_t>& cockpit, UINT divisor,
+    const ReprojectionViews& views) {
+    const UINT mask_width = (width + divisor - 1U) / divisor;
+    const UINT mask_height = (height + divisor - 1U) / divisor;
+    const UINT atlas_width = mask_width * kEyeCount;
+    std::vector<std::uint8_t> atlas(static_cast<std::size_t>(atlas_width) * mask_height, 0);
+    for (UINT y = 0; y < height; ++y) {
