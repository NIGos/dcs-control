+    // DCS Control (0018): the eye distance rendered now, in tenths of a mm.
+    const auto rendered = static_cast<unsigned>((in.ipd.bits >> 16) & 0xFFFFU);
+    if (in.ipd.known && rendered > 0U) {
+        const auto tenths = (rendered + 5U) / 10U;
