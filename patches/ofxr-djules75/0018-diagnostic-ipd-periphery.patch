+// DCS Control (0018): the same layer's PupilShift_Ipd() export. Bits 0-15 the
+// base eye distance in 0.01 mm (the profile's Ipd= or the runtime's), bits
+// 16-31 the eye distance rendered now (the base times Depth boost's scale),
+// bits 32-47 the larger pupil offset in 0.01 mm, bit 48 the base is the
+// runtime's, bit 49 the profile's. 0 until known; known is false without it.
+struct PupilIpd {
+    bool known{};
+    std::uint64_t bits{};
+};
+// DCS Control (0018): the bundled Quad Views' DcsVr_QuadViewsPeripheryStatus()
+// export. Bit 0 the periphery stability pass is on, bit 1 the last frame was
+// filtered, bits 8-15 the strength x100, bits 16-31 frames filtered in the
+// last second, bits 32-47 resets in the last second. known is false when the
+// bundled Quad Views (or its export) is not loaded.
+struct PeripheryStatus {
+    bool known{};
+    std::uint64_t bits{};
+};
+inline constexpr std::uint64_t kPeripheryOn = 1ULL << 0;
 
