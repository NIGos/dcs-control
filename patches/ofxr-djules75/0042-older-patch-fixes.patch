+// DCS Control (0042): a copy into the runtime's image that fails after its
+// hand-over is kept for the next catch-up (or frame_ended), not dropped.
+void test_failed_copy_retried(const Devices& devices) {
+    UnsubmittedFixture fixture;
+    if (!create_unsubmitted_fixture(devices, &fixture, "retry: bridge initialised")) {
+        return;
+    }
+    xrfg::D3D11BridgeSwapchain& bridge = fixture.bridge;
+    const auto paint = [&](std::uint32_t index, std::uint8_t red) {
+        std::vector<std::uint8_t> pixels(8 * 8 * 4, 0);
+        for (std::size_t offset = 0; offset < pixels.size(); offset += 4) {
+            pixels[offset] = red;
+            pixels[offset + 3] = 255;
+        }
+        expect(SUCCEEDED(bridge.before_write(index)), "retry: before_write");
+        devices.context->UpdateSubresource(
+            bridge.d3d11_images()[index], 0, nullptr, pixels.data(), 8 * 4, 0);
+    };
+    // A copying release whose copy fails: kept, and the catch-up copies it.
+    paint(1, 61);
+    bridge.test_fail_next_copies(1);
+    expect(FAILED(bridge.release(1)), "retry: the release reports the failed copy");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "retry: idle");
+    expect(runtime_red(devices, fixture.runtime[1].Get()) != 61, "retry: nothing copied yet");
+    // The catch-up fails too: still kept.
+    bridge.test_fail_next_copies(1);
+    expect(FAILED(bridge.catch_up()), "retry: a failed catch-up reports it");
+    expect(bridge.catch_up() == S_FALSE, "retry: the failed copy is retried");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "retry: idle after the retry");
+    expect(runtime_red(devices, fixture.runtime[1].Get()) == 61, "retry: the retry holds the release");
+    expect(bridge.catch_up() == S_OK, "retry: caught up once");
+    // The unsubmitted skip's catch-up (frame_ended) failing: kept as well.
+    std::uint32_t index = 0;
+    std::uint8_t red = 0;
+    HRESULT released = E_FAIL;
+    for (std::uint32_t step = 0;
+         step < xrfg::D3D11BridgeSwapchain::kUnsubmittedFramesBeforeSkip + 2; ++step) {
+        index = step % 3;
+        red = static_cast<std::uint8_t>(120 + step);
+        expect(render_and_release(devices, bridge, index, red, &released), "retry: unsubmitted release");
+        expect(SUCCEEDED(bridge.frame_ended(false)), "retry: unsubmitted frame_ended");
+    }
+    expect(!bridge.copies_on_release() && released == S_FALSE, "retry: skipping");
+    bridge.test_fail_next_copies(1);
+    expect(FAILED(bridge.frame_ended(true)), "retry: the skip's catch-up fails");
+    expect(bridge.catch_up() == S_FALSE, "retry: the skip's image is retried");
+    expect(SUCCEEDED(bridge.wait_for_idle()), "retry: idle after the skip's retry");
+    expect(runtime_red(devices, fixture.runtime[index].Get()) == red,
+        "retry: the retry holds the skip's last release");
+}
