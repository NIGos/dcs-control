+
+// DCS Control (0017): Depth boost, "Depth boost: ..." alone or "Depth ..."
+// after the pupil shift.
+std::string depth_part(const DiagnosticInputs& in, DiagnosticColor& color, bool alone) {
+    const auto bits = in.pupil.bits;
+    const std::string name = alone ? "Depth boost: " : "Depth ";
+    if (!(bits & kDepthOn)) {
+        color = DiagnosticColor::grey;
+        const auto key = alone ? diagnostic_hotkey_label(in.depth_hotkey) : std::string();
+        return name + (key.empty() ? std::string("OFF") : "OFF (" + key + ")");
+    }
+    if (bits & kDepthConstant) { color = DiagnosticColor::amber; return name + (alone ? "no depth (shared gaze)" : "no depth"); }
+    if (!(bits & kDepthSource)) { color = DiagnosticColor::grey; return name + "waiting"; }
+    const auto percent = static_cast<unsigned>((bits >> 16) & 0xFFU);
+    const auto fixation = static_cast<unsigned>((bits >> 24) & 3U);
+    const auto hundredths = std::to_string(percent % 100);
+    color = DiagnosticColor::green;
+    return name + "x" + std::to_string(1U + percent / 100) + "." + (hundredths.size() < 2 ? "0" : "") + hundredths +
+        (fixation == 2U ? " far" : fixation == 1U ? " cockpit" : "");
+}
+}
+
+std::string format_pupil_line(const DiagnosticInputs& in, DiagnosticColor& color) {
+    const auto& p = in.pupil;
+    if (!p.known) return {};
+    const bool depth = (p.bits & kDepthEnabled) != 0;
+    if (!(p.bits & kPupilRunning)) {
+        color = DiagnosticColor::grey;
+        return depth && (p.bits & kPupilDisabled) ? "Depth boost: starting" : "Pupil shift: starting";
+    }
+    if (p.bits & kPupilDisabled) {
+        if (!depth) return {};
+        return depth_part(in, color, true);
+    }
+    auto text = pupil_part(in, color);
+    if (!depth) return text;
+    DiagnosticColor depth_color{};
+    text += "; " + depth_part(in, depth_color, false);
+    // The line takes the more urgent colour of its two parts.
+    if (color == DiagnosticColor::amber || depth_color == DiagnosticColor::amber) color = DiagnosticColor::amber;
+    else if (color == DiagnosticColor::green || depth_color == DiagnosticColor::green) color = DiagnosticColor::green;
+    return text;
 }
 
