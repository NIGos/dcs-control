+// DCS Control (0070): the pass-through preference (issue #17).
+void cadence_preference_tests() {
+    using xrfg::latency::cadence_config_for;
+    using xrfg::latency::cadence_preference_from;
+    using xrfg::latency::CadencePreference;
+    require(cadence_preference_from(0) == CadencePreference::steady &&
+            cadence_preference_from(1) == CadencePreference::balanced &&
+            cadence_preference_from(2) == CadencePreference::rate &&
+            cadence_preference_from(3) == CadencePreference::steady,
+        "preference: 0, 1, 2; steady otherwise");
+    {
+        const CadenceConfig steady = cadence_config_for(CadencePreference::steady);
+        const CadenceConfig base{};
+        require(steady.one_enter_fraction == base.one_enter_fraction &&
+                steady.one_exit_fraction == base.one_exit_fraction &&
+                steady.one_exit_slow && steady.one_exit_sparse_episodes == 0,
+            "steady is 0032's rule");
+    }
+    // Issue #17's cockpit view as 2 measures it: CPU 10.5 ms, GPU 12.2 ms of
+    // which 1.2 are synthesis - 11 ms at 1X, 99% of the period.
+    constexpr Nanoseconds kHoldCpu = 10'500'000;
+    constexpr Nanoseconds kHoldGpu = 12'200'000;
+    constexpr Nanoseconds kHoldSynthesis = 1'200'000;
+    // 13.5 ms at 1X, 1.215 periods: only the rate preference tries it.
+    constexpr Nanoseconds kEdgeGpu = 14'700'000;
+    // 14.5 ms at 1X, 1.3 periods: nobody does.
+    constexpr Nanoseconds kFarGpu = 15'700'000;
+    {
+        CadenceSim steady(cadence_config_for(CadencePreference::steady));
+        CadenceSim balanced(cadence_config_for(CadencePreference::balanced));
+        CadenceSim rate(cadence_config_for(CadencePreference::rate));
+        for (int index = 0; index < 600; ++index) {
+            steady.frame(kHoldCpu, kHoldGpu, kHoldSynthesis);
+        }
+        require(steady.events.empty() && steady.controller.level() == 2,
+            "steady: 99% of the period never enters 1X");
+        const Nanoseconds entered = balanced.until(
+            CadenceEvent::one_entered, 1000, kHoldCpu, kHoldGpu, kHoldSynthesis);
+        require(entered >= balanced.started + 5 * kSecond &&
+                entered <= balanced.started + 5 * kSecond + 500 * kMillisecond,
+            "balanced: 99% of the period enters after the five seconds");
+        require(rate.until(CadenceEvent::one_entered, 1000, kHoldCpu, kHoldGpu,
+                    kHoldSynthesis) >= 0,
+            "rate: enters too");
+        // At 1X the work is the period less a short wait, 97% of it: kept
+        // (steady would leave over 95%), ten seconds of it.
+        for (int index = 0; index < 900; ++index) {
+            balanced.frame(10'800'000, 9'500'000, 0);
+            rate.frame(10'800'000, 9'500'000, 0);
+        }
+        require(balanced.controller.level() == 1 && balanced.events.size() == 1 &&
+                rate.controller.level() == 1 && rate.events.size() == 1,
+            "balanced and rate: 1X is not left on the p90");
+    }
+    {
+        CadenceSim balanced(cadence_config_for(CadencePreference::balanced));
+        CadenceSim rate(cadence_config_for(CadencePreference::rate));
+        CadenceSim far(cadence_config_for(CadencePreference::rate));
+        for (int index = 0; index < 600; ++index) {
+            balanced.frame(kHoldCpu, kEdgeGpu, kHoldSynthesis);
+            far.frame(kHoldCpu, kFarGpu, kHoldSynthesis);
+        }
+        require(balanced.events.empty(), "balanced: 1.2 periods is out of reach");
+        require(far.events.empty() && far.controller.level() == 2,
+            "rate: 1.3 periods is out of reach");
+        require(rate.until(CadenceEvent::one_entered, 1000, kHoldCpu, kEdgeGpu,
+                    kHoldSynthesis) >= 0,
+            "rate: 1.2 periods is tried");
+    }
+    {
+        // Sparse misses at 1X - one every three seconds, never two within a
+        // second: balanced leaves at the third within ten seconds (a failed
+        // attempt: the backoff), rate stays.
+        CadenceSim balanced(cadence_config_for(CadencePreference::balanced));
+        CadenceSim rate(cadence_config_for(CadencePreference::rate));
+        for (CadenceSim* sim : {&balanced, &rate}) {
+            const Nanoseconds entered = sim->until(
+                CadenceEvent::one_entered, 1000, kHoldCpu, kHoldGpu, kHoldSynthesis);
+            require(entered >= 0, "sparse: entered");
+            for (int miss = 0; miss < 3; ++miss) {
+                const Nanoseconds at = entered + (2 + 3 * miss) * kSecond;
+                while (sim->now < at) {
+                    sim->frame(10'800'000, 9'500'000, 0);
+                }
+                sim->controller.add_late(sim->now, 1);
+                sim->frame(10'800'000, 9'500'000, 0);
+            }
+        }
+        require(balanced.controller.level() == 2 &&
+                balanced.events.back().event == CadenceEvent::one_left_late &&
+                balanced.controller.backoff() == 30 * kSecond,
+            "balanced: three episodes in ten seconds leave, and back off");
+        require(rate.controller.level() == 1 && rate.events.size() == 1,
+            "rate: sparse misses stay");
+        // Two episodes within a second leave under rate as well.
+        rate.controller.add_late(rate.now, 1);
+        rate.frame(10'800'000, 9'500'000, 0);
+        rate.controller.add_late(rate.now + 300 * kMillisecond, 1);
+        for (int index = 0; index < 60; ++index) {
+            rate.frame(10'800'000, 9'500'000, 0);
+        }
+        require(rate.controller.level() == 2 &&
+                rate.events.back().event == CadenceEvent::one_left_late,
+            "rate: two episodes in a second leave");
+        // Back at 2, as heavy as before: not tried again inside the backoff.
+        const Nanoseconds left = rate.events.back().one_allowed_at;
+        const Nanoseconds again = rate.until(
+            CadenceEvent::one_entered, 4000, kHoldCpu, kHoldGpu, kHoldSynthesis);
+        require(again >= left, "rate: the next attempt waits for the backoff");
+    }
+}
