 };
 
+// DCS Control (0070): how readily adaptive cadence passes frames through
+// (`[ofxr] cadence_preference`, 0 steady, 1 balanced, 2 rate; steady where
+// the key is absent or anything else).
+//
+// Issue #17, measured on DCS (Pimax, 90 Hz): a cockpit view that holds 90 with
+// the layer off (11.1 ms frames, GPU 8.6 ms, render thread 10.2 ms) reads
+// 10.2-11.6 ms of GPU at 1X while it runs at 2 - the busy time per frame at
+// half the rate is a fifth to a quarter more than the frame costs at the full
+// rate - so one_enter_fraction 0.80 (8.9 ms) was never met and 1X never
+// entered. The estimate cannot say whether 1X holds there; 1X itself can.
+// So the other two preferences enter 1X on a wider estimate - a trial, with
+// everything 0032 has for one (the grace, the failed attempt's backoff from
+// 30 s doubling to 240 s, the spacing) - and keep it by what 1X shows: slots
+// missed, not the p90 against the period (at the full rate the work is the
+// interval less the wait, within a few percent of the period whenever the
+// application just holds it).
+//
+//   steady    0032 as it was: enter at 0.80 of the period, leave over 0.95
+//             or on 2 missed-slot episodes within a second.
+//   balanced  enter at 1.10 (the estimate's excess over a real 0.9 or so);
+//             leave on 2 episodes within a second or 3 within 10 s.
+//   rate      enter at 1.25 (what may hold at all); leave on 2 episodes
+//             within a second only.
+enum class CadencePreference : std::uint32_t { steady = 0, balanced = 1, rate = 2 };
+
+[[nodiscard]] constexpr CadencePreference cadence_preference_from(
+    std::uint32_t value) noexcept {
+    return value == 1 ? CadencePreference::balanced
+        : value == 2 ? CadencePreference::rate
+        : CadencePreference::steady;
+}
+
+[[nodiscard]] constexpr CadenceConfig cadence_config_for(
+    CadencePreference preference) noexcept {
+    CadenceConfig config{};
+    if (preference == CadencePreference::balanced) {
+        config.one_enter_fraction = 1.10;
+        config.one_exit_slow = false;
+        config.one_exit_sparse_episodes = 3;
+    } else if (preference == CadencePreference::rate) {
+        config.one_enter_fraction = 1.25;
+        config.one_exit_slow = false;
+    }
+    return config;
+}
