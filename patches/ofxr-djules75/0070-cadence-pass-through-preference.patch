+// DCS Control (0070): 0 unless set to 1 or 2.
+std::uint32_t read_cadence_preference(
+    const std::filesystem::path& module_directory) noexcept {
+    try {
+        if (module_directory.empty()) {
+            return 0;
+        }
+        const auto ini_path = module_directory / L"ofxr_bridge.ini";
+        const UINT value = GetPrivateProfileIntW(
+            L"ofxr", L"cadence_preference", 0, ini_path.c_str());
+        return value <= 2U ? value : 0U;
+    } catch (...) {
+        return 0;
+    }
+}
