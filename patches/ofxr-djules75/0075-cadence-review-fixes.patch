+    //    frame's interval less its holds and reads the same at either rate -
+    //    so 1.10 or 1.25 of the period there only lets in attempts that
+    //    cannot hold.
+    //  - one_give_up_clean: given up (one_max_failed), 1X is tried once more
+    //    when 2 has passed the entry test this long without a missed slot,
+    //    or for one_enter_hold with CPU and GPU at 0032's own 0.80 (the work
+    //    dropped); 0: only a scene change lifts it. A mission restarted
+    //    without the one-second gap a scene change needs no longer leaves
+    //    1X off for the session. That attempt failing gives up again.
+    Nanoseconds up_late_gate_clean{5 * kSecond};
+    double one_enter_cpu_fraction{0.0};
+    Nanoseconds one_give_up_clean{0};
 };
 
