+    std::cout << "; mean of pairs 2+: " << off / pairs << " / " << on / pairs << "; flow median "
+              << median(pipelines[0].flow) << " / " << median(pipelines[1].flow) << " us" << std::endl;
+    fixture.require_no_debug_errors();
+}
