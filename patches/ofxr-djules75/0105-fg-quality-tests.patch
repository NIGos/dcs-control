+// first pair has no hint to take), and the optical flow's GPU time per pair.
+// XRFG_TEST_TEMPORAL_HINTS=1, NVIDIA hardware; prints, requires only that the
+// hints never make a pair much worse.
+void run_temporal_hints_sequence(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    constexpr UINT kFrames = 9;
+    DcsMotionScene scene;
+    scene.layers = {
+        {1, 1.0, 0.0, 34.0, 6.0, 2, 1, 1.0, true, {0.9, 0.85, 0.8}},
+        {0, 1.0, 0.0, 20.0, -3.0, 0, 0, 1.0, true, {1.0, 1.0, 1.0}},
+    };
+    std::vector<DcsMotionFrame> frames, truths;
+    for (UINT k = 0; k < kFrames; ++k) frames.push_back(dcs_motion_frame(scene, width, height, double(k)));
+    for (UINT k = 0; k + 1 < kFrames; ++k) truths.push_back(dcs_motion_frame(scene, width, height, k + 0.5));
+    const ReprojectionViews views = make_reprojection_views();
+    struct Pipeline {
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{};
+        std::array<ComPtr<ID3D12Resource>, 1> synthetics{};
+        std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+        std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+        std::vector<double> mae;
+        std::vector<std::uint64_t> flow;
+    };
+    std::array<Pipeline, 2> pipelines{};
+    for (UINT index = 0; index < pipelines.size(); ++index) {
+        Pipeline& pipeline = pipelines[index];
+        for (UINT k = 0; k < kFrames; ++k) {
+            pipeline.sources[k] = create_source_texture(fixture, width, height);
+            upload_pattern(fixture, pipeline.sources[k].Get(), frames[k].image);
+        }
+        for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+        for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT k = 0; k < kFrames; ++k) source_pointers[k] = pipeline.sources[k].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+        std::array<ID3D12Resource*, 1> synthetic_pointers{pipeline.synthetics[0].Get()};
+        pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "temporal hints: history");
+        xrfg::D3D12NvidiaOpticalFlowOptions options{};
+        options.occlusion_aware = 1U;
+        options.fg_quality = index == 1 ? xrfg::kFgQualityTemporalHints : 0U;
+        pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                    pipeline.history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "temporal hints: synthesizer");
+    }
+    for (UINT k = 0; k < kFrames; ++k) {
+        for (Pipeline& pipeline : pipelines) {
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require(operation_succeeded(pipeline.history->capture(k, &capture)) &&
+                        operation_succeeded(pipeline.history->commit(capture)), "temporal hints: capture");
+            const HRESULT submitted = k == 0
+                ? pipeline.synthesizer->submit_prime(capture, views, 0, &ticket)
+                : pipeline.synthesizer->submit_pair(capture, views, views, 0, k % 2U, &ticket);
+            require(operation_succeeded(submitted), "temporal hints: submission " + std::to_string(k) + " hr " +
+                std::to_string(static_cast<unsigned long>(submitted)));
+            require_frame_start_gate(*pipeline.synthesizer, "temporal hints: frame-start gate");
+            if (k == 0) {
+                continue;
+            }
+            const StereoPattern image =
+                readback_pattern(fixture, pipeline.synthetics[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+            pipeline.mae.push_back(depth_test_error(image, truths[k - 1].image, width, height,
+                [](UINT, UINT, UINT) { return true; }).mae);
+            xrfg::D3D12NvidiaGpuTiming timing{};
+            while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                if (timing.previous_serial != 0) pipeline.flow.push_back(timing.eye0_microseconds + timing.eye1_microseconds);
+            }
+        }
+    }
+    double off = 0.0, on = 0.0;
+    std::cout << "temporal hints " << width << "x" << height << ", mae per pair (off / on):";
+    for (std::size_t i = 0; i < pipelines[0].mae.size(); ++i) {
+        std::cout << ' ' << pipelines[0].mae[i] << '/' << pipelines[1].mae[i];
+        if (i > 0) { off += pipelines[0].mae[i]; on += pipelines[1].mae[i]; }
+        require(pipelines[1].mae[i] <= pipelines[0].mae[i] * 1.5 + 0.5, "temporal hints: a pair much worse with the hints");
+    }
+    const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+        if (values.empty()) return 0;
+        std::sort(values.begin(), values.end());
+        return values[values.size() / 2];
