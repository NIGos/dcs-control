+// DCS Control (0059): see CadenceTimeResync.
+std::int64_t CadenceTimeResync::observe(
+    std::uint32_t frames,
+    Nanoseconds told,
+    Nanoseconds residual,
+    Nanoseconds period,
+    Nanoseconds last_told) noexcept {
+    if (frames == 0 || period <= 0 || told <= settle_until) {
+        return 0;
+    }
+    const std::size_t level = level_index(frames);
+    const std::int64_t periods = residual_periods(residual, period);
+    if (periods == 0) {
+        streak = 0;
+        return 0;
+    }
+    if (streak != 0 && candidate == periods && candidate_level == level) {
+        ++streak;
+    } else {
+        candidate = periods;
+        candidate_level = level;
+        streak = 1;
+    }
+    if (streak < kConfirm) {
+        return 0;
+    }
+    // Shown later than told: told later from here (and the reverse). The
+    // level's own part moves; its whole offset stays within kMaxPeriods.
+    const std::int64_t whole = periods_for(frames);
+    const std::int64_t moved = std::clamp<std::int64_t>(
+        whole + periods, -kMaxPeriods, kMaxPeriods) - whole;
+    offset[level] += moved;
+    if (moved != 0) {
+        ++moves;
+    }
+    settle(last_told);
+    return moved;
+}
