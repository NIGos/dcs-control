+// and prime apart, against a 2X frame's capture and pair; both eyes in one
+// image.
+void bench_warm_one(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    constexpr UINT kFrames = 3;
+    constexpr int kTimed = 200;
+    std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+    std::array<ComPtr<ID3D12Resource>, 2> currents{};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
