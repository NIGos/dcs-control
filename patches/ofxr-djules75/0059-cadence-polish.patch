+# DCS Control (0059): runs one of the call chain's adaptive cadence scenarios
+# under `[ofxr] pipelined_deep_hold` (CADENCE_INI beside the layer DLL; MODE
+# dcs-cadence-exit, dcs-cadence-jitter or dcs-cadence-stall) and checks its
+# flight log. The call chain checks what was shown and when.
+#   exit    1X entered and left on missed slots (result=9), the slots its held
+#           primes left re-presented at their deadline (407).
+#   jitter  no slot missed at 1X (adaptive_throughput result=6's bits 48-63)
+#           from its entry until the first record after it is left, and not
+#           left on missed slots: every hand-over there came 1.5-3 ms after its
+#           slot's wait, which the 2 ms line before 0059 counted missed.
+#   stall   the held prime's slots re-presented at their deadline (407), and
+#           the held submission timed (slow_step result=7).
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN CADENCE_INI WORK_DIR MODE)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${CADENCE_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(cadence_ini_name "${CADENCE_INI}" NAME)
+file(RENAME "${WORK_DIR}/${cadence_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        "${MODE}"
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+message(STATUS "${call_chain_output}")
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${MODE}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+set(expected "op=adaptive_switch result=8 dur_us=0 a=2 b=1 c=")
+if(MODE STREQUAL "dcs-cadence-exit")
+    list(APPEND expected
+        "op=adaptive_switch result=9 dur_us=0 a=1 b=2 c="
+        "op=presenter_transition result=407 ")
+elseif(MODE STREQUAL "dcs-cadence-stall")
+    list(APPEND expected
+        "op=presenter_transition result=407 "
+        "op=slow_step result=7 ")
+endif()
+foreach(item IN LISTS expected)
+    string(FIND "${contents}" "${item}" found)
+    if(found EQUAL -1)
+        message(FATAL_ERROR "The flight log is missing: ${item}")
+    endif()
+endforeach()
+
+if(MODE STREQUAL "dcs-cadence-jitter")
+    file(STRINGS "${flight_log}" records
+        REGEX "op=adaptive_switch result=(8|9|10) |op=adaptive_throughput result=6 ")
+    set(in_one FALSE)
+    set(left FALSE)
+    set(judged 0)
+    set(missed 0)
+    foreach(record IN LISTS records)
+        if(record MATCHES "op=adaptive_switch result=8 ")
+            set(in_one TRUE)
+        elseif(in_one AND record MATCHES "op=adaptive_switch result=9 ")
+            message(FATAL_ERROR "1X was left on missed slots: ${record}")
+        elseif(in_one AND record MATCHES "op=adaptive_switch result=10 ")
+            set(left TRUE)
+        elseif(in_one AND record MATCHES "op=adaptive_throughput result=6 .* c=([0-9]+)$")
+            math(EXPR record_missed "${CMAKE_MATCH_1} >> 48")
+            math(EXPR missed "${missed} + ${record_missed}")
+            math(EXPR judged "${judged} + 1")
+            if(left)
+                break()
+            endif()
+        endif()
+    endforeach()
+    if(judged EQUAL 0 OR NOT missed EQUAL 0)
+        message(FATAL_ERROR
+            "Slots missed at 1X: ${missed} over ${judged} records (expected none)")
+    endif()
+    message(STATUS "1X: no slot missed over ${judged} records")
+endif()
