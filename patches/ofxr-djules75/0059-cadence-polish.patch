+// DCS Control (0059): a real frame's residual - the display time of the slot
+// it was shown in less the display time it was told - in whole display
+// periods, signed: 0 under kResidualThreshold of a period either way, past it
+// the nearest whole period with an exact half rounded down (1.5 periods is 1).
+// 0048's frame_slot record rounded half up from zero, so a residual of exactly
+// half a period - 5.6 ms at 90 Hz: a frame shown in the slot it was rendered
+// for, the presenter's grid half a period off its told time - read as one
+// period late. A non-positive period is 0.
+inline constexpr Nanoseconds kResidualThresholdQuarters = 3; // 0.75 period
+[[nodiscard]] constexpr std::int64_t residual_periods(
+    Nanoseconds residual, Nanoseconds period) noexcept {
+    if (period <= 0) {
+        return 0;
+    }
+    const Nanoseconds size = residual < 0 ? -residual : residual;
+    if (size * 4 < period * kResidualThresholdQuarters) {
+        return 0;
+    }
+    const std::int64_t periods = (size * 2 + period - 1) / (period * 2);
+    return residual < 0 ? -periods : periods;
+}
+
+// DCS Control (0059): how long after its slot's xrWaitFrame returned a frame
+// at adaptive cadence's 1X may still be handed over, as a fraction of the
+// period: half. R110 (DCS, Pimax 90 Hz): hand-overs 2-5.6 ms after the wait
+// were shown in their slot (residual 0.1 ms), one 6.1 ms after it was not.
+// Before it, a pipelined presenter waited for the frame without a bound, and
+// its 2 ms late-submission line counted every one of those shown frames as a
+// missed slot. Past it, under `[ofxr] pipelined_deep_hold`, the slot
+// re-presents the last real frame (presenter_transition 407) and the frame
+// takes the next one, with the period ahead of it.
+[[nodiscard]] constexpr Nanoseconds cadence_one_deadline(Nanoseconds period) noexcept {
+    return period > 0 ? period / 2 : 0;
+}
+
+// DCS Control (0059): adaptive cadence's told time, resynchronised on where
+// its real frames are shown. The told time follows the frames' own cadences
+// and the slots the presenter lost (cadence_told_time), and the display time
+// correction on top of it learns where real frames land - in two windows of
+// thirty real frames that agree, and keyed by the pipeline's shape, which
+// adaptive cadence does not change between 1X and 2. 1X's real frames land
+// sooner (no synthetic held in front of them), so every stretch at 1X was
+// first shown 2-3 periods before its told time (R110: 17 s at -22 ms), until
+// the correction learned it, and then every exit to 2 was shown 2 periods
+// late (late=2) until it learned 2 again: 43-44 late frames per exit.
+//
+// This keeps an offset in whole periods added to the told time: offset[1] for
+// every level (what 2 and 3 - one queue shape, mixed frame by frame - are
+// told), and offset[0] on top of it for 1X frames alone. A run of kConfirm
+// real frames of one level shown the same whole number of periods off
+// (residual_periods), all told after the last move, moves that level's own
+// part by it. A frame told at or before settle_until is not judged: it was
+// told before an offset moved or before the presenter lost or gained a slot,
+// and lands off by that as designed. 1X's part is kept while 2 is in force,
+// so 1X comes back where it was shown last time, and the common part moves
+// both, so a 1X never visited starts where 2 is. Under presenter_mutex.
+struct CadenceTimeResync {
+    static constexpr std::uint32_t kConfirm = 3;
+    static constexpr std::int64_t kMaxPeriods = 8;
+    std::array<std::int64_t, 2> offset{};
+    std::int64_t candidate{};
+    std::size_t candidate_level{};
+    std::uint32_t streak{};
+    Nanoseconds settle_until{};
+    std::uint32_t moves{};
+
+    [[nodiscard]] static constexpr std::size_t level_index(
+        std::uint32_t frames) noexcept {
+        return frames <= 1 ? 0U : 1U;
+    }
+    // The whole offset a frame of cadence `frames` is told, in periods.
+    [[nodiscard]] std::int64_t periods_for(std::uint32_t frames) const noexcept {
+        return offset[1] + (level_index(frames) == 0 ? offset[0] : 0);
+    }
+    [[nodiscard]] Nanoseconds offset_for(
+        std::uint32_t frames, Nanoseconds period) const noexcept {
+        return periods_for(frames) * period;
+    }
+    void reset() noexcept { *this = CadenceTimeResync{}; }
+    // Frames told up to `last_told` are not judged.
+    void settle(Nanoseconds last_told) noexcept {
+        settle_until = last_told > settle_until ? last_told : settle_until;
+        streak = 0;
+    }
+    // A real frame of cadence `frames`, told `told`, shown `residual` after
+    // it; `last_told` the latest display time told so far. Returns the
+    // periods its level's offset moved (0: none).
+    std::int64_t observe(
+        std::uint32_t frames,
+        Nanoseconds told,
+        Nanoseconds residual,
+        Nanoseconds period,
+        Nanoseconds last_told) noexcept;
+};
+
 // DCS Control (0050): what the 2X deeper pipeline's hold re-presents for the
 // slot it holds a synthetic back from. A presenter outside the pipelined mode
 // keeps the frame it submitted last (`last_frame`); a pipelined one (DCS:
