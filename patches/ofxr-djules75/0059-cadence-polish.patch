+// DCS Control (0059): a residual in whole periods, rounded half down from
+// 0.75 of a period (the frame_slot record's periods late, and the resync's
+// unit).
+void residual_period_tests() {
+    constexpr Nanoseconds kP = 11'111'111;
+    require(residual_periods(0, kP) == 0, "residual: on time");
+    require(residual_periods(kP / 2, kP) == 0,
+        "residual: exactly half a period (5.6 ms at 90 Hz) is not late");
+    require(residual_periods(-(kP / 2), kP) == 0, "residual: half a period early is 0");
+    require(residual_periods(kP * 3 / 4 - 1, kP) == 0, "residual: just under 0.75 is 0");
+    require(residual_periods(kP * 3 / 4 + 1, kP) == 1, "residual: 0.75 is one period");
+    require(residual_periods(kP, kP) == 1 && residual_periods(-kP, kP) == -1,
+        "residual: one period either way");
+    require(residual_periods(kP * 3 / 2, kP) == 1, "residual: 1.5 rounds down");
+    require(residual_periods(kP * 3 / 2 + 2, kP) == 2, "residual: past 1.5 is two");
+    require(residual_periods(22'207'000, kP) == 2, "residual: R110's late=2 frames");
+    require(residual_periods(-22'221'000, kP) == -2, "residual: R110's early 1X frames");
+    require(residual_periods(kP, 0) == 0, "residual: no period");
+    require(cadence_one_deadline(kP) == kP / 2 && cadence_one_deadline(0) == 0,
+        "1X deadline: half a period");
+}
+
+// DCS Control (0059): adaptive cadence's told time resynchronised per level.
+void cadence_resync_tests() {
+    constexpr Nanoseconds kP = 10'000'000;
+    {
+        CadenceTimeResync resync{};
+        Nanoseconds told = 1'000'000'000;
+        // Two frames off by two periods: not yet.
+        require(resync.observe(2, told += kP, 2 * kP, kP, told + 3 * kP) == 0 &&
+                    resync.observe(2, told += kP, 2 * kP + 300'000, kP, told + 3 * kP) == 0,
+            "resync: two frames do not move it");
+        // The third does; 1X follows the common part.
+        const Nanoseconds last_told = told + 3 * kP;
+        require(resync.observe(2, told += kP, 2 * kP - 200'000, kP, last_told) == 2,
+            "resync: three frames two periods late move it two later");
+        require(resync.periods_for(2) == 2 && resync.periods_for(3) == 2 &&
+                    resync.periods_for(1) == 2 && resync.moves == 1,
+            "resync: the common part moves every level");
+        // Frames told before the move are not judged.
+        for (int index = 0; index < 5; ++index) {
+            require(resync.observe(2, last_told - index, 2 * kP, kP, last_told + kP) == 0,
+                "resync: frames told before the move are settled");
+        }
+        require(resync.streak == 0, "resync: settled frames start no run");
+        // A frame on time breaks a run.
+        told = last_told;
+        require(resync.observe(1, told += kP, -kP, kP, told) == 0 &&
+                    resync.observe(1, told += kP, -kP, kP, told) == 0 &&
+                    resync.observe(1, told += kP, 0, kP, told) == 0 &&
+                    resync.observe(1, told += kP, -kP, kP, told) == 0 &&
+                    resync.observe(1, told += kP, -kP, kP, told) == 0,
+            "resync: a frame on time breaks the run");
+        require(resync.observe(1, told += kP, -kP, kP, told) == -1,
+            "resync: 1X one period early moves its own part");
+        require(resync.periods_for(1) == 1 && resync.periods_for(2) == 2 &&
+                    resync.offset[0] == -1,
+            "resync: 1X's part leaves 2's alone");
+        // Levels do not mix in one run.
+        require(resync.observe(1, told += kP, kP, kP, told) == 0 &&
+                    resync.observe(2, told += kP, kP, kP, told) == 0 &&
+                    resync.observe(1, told += kP, kP, kP, told) == 0 &&
+                    resync.streak == 1,
+            "resync: a run is one level's");
+        // A lost slot settles what was told so far.
+        resync.settle(told);
+        require(resync.observe(2, told, kP, kP, told) == 0 && resync.streak == 0,
+            "resync: settle");
+        // Outside adaptive cadence (frames 0) nothing.
+        require(resync.observe(0, told + kP, 5 * kP, kP, told + kP) == 0,
+            "resync: no cadence");
+    }
+    {
+        // Bounded either way.
+        CadenceTimeResync resync{};
+        Nanoseconds told = 1'000'000'000;
+        for (int run = 0; run < 3; ++run) {
+            for (int index = 0; index < 3; ++index) {
+                static_cast<void>(resync.observe(2, told += kP, 5 * kP, kP, told));
+            }
+            told += 10 * kP;
+        }
+        require(resync.periods_for(2) == CadenceTimeResync::kMaxPeriods,
+            "resync: bounded at kMaxPeriods");
+        resync.reset();
+        require(resync.periods_for(1) == 0 && resync.moves == 0, "resync: reset");
+    }
+    {
+        // R110's shape: 1X's frames land two periods sooner than 2's. Told
+        // with the resync's offset, shown at the level's own shape; each
+        // frame observed two frames after it was told (frames in flight).
+        // Before 0059 every entry was shown 2 periods early until the
+        // correction learned 1X, and every exit 2 periods late (43-44
+        // frames) until it learned 2 again.
+        CadenceTimeResync resync{};
+        struct Told { std::uint32_t frames; Nanoseconds told; std::int64_t periods; };
+        std::vector<Told> in_flight;
+        Nanoseconds told = 1'000'000'000;
+        const auto shape = [](std::uint32_t frames) -> std::int64_t {
+            return frames == 1 ? -2 : 0;
+        };
+        const auto run = [&](std::uint32_t frames, int count) {
+            int off = 0;
+            for (int index = 0; index < count; ++index) {
+                told += frames * kP;
+                in_flight.push_back({frames, told, resync.periods_for(frames)});
+                if (in_flight.size() > 2) {
+                    const Told shown = in_flight.front();
+                    in_flight.erase(in_flight.begin());
+                    // Jitter of a quarter period either way.
+                    const Nanoseconds jitter = (index % 3 - 1) * kP / 4;
+                    const Nanoseconds residual =
+                        (shape(shown.frames) - shown.periods) * kP + jitter;
+                    off += residual_periods(residual, kP) != 0 ? 1 : 0;
+                    static_cast<void>(resync.observe(
+                        shown.frames, shown.told, residual, kP, told));
+                }
+            }
+            return off;
+        };
+        require(run(2, 300) == 0, "resync shape: 2 on time from the start");
+        const int first_entry = run(1, 300);
+        require(first_entry > 0 && first_entry <= 6,
+            "resync shape: the first 1X is resynchronised within a few frames (" +
+                std::to_string(first_entry) + ")");
+        require(run(2, 300) == 0, "resync shape: the exit is on time");
+        require(run(1, 300) == 0, "resync shape: the next 1X comes back where it was");
+        require(run(2, 300) == 0 && resync.moves == 1,
+            "resync shape: one move in all (" + std::to_string(resync.moves) + ")");
+    }
+}
