+        sources[frame] = create_source_texture(fixture, width, height);
+        StereoPattern image;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            image[eye].resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+            for (std::size_t index = 0; index < image[eye].size(); ++index) {
+                // A texture that moves a little every frame.
+                image[eye][index] = static_cast<std::uint8_t>(
+                    (index / kBytesPerPixel + frame * 9U + eye * 31U) * 2654435761U >> 24);
+            }
+        }
+        upload_pattern(fixture, sources[frame].Get(), image);
+    }
