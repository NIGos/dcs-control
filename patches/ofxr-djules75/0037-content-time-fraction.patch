+        feed_o(17.0 + 12.0, 14.0);
+        require(outliers.count() == 3 && outliers.latency() &&
+                    *outliers.latency() == kDisplayEpoch - kContentEpoch + periods(15),
+            "three in a row are the new latency");
+    }
