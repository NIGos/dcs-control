+        require(!place(d0, c0, d0 + periods(2), 0, latency), "no current start");
+        require(!place(0, c0, d0 + periods(2), c0 + periods(2), latency), "no previous display");
+        require(!place(d0, c0, d0 + periods(2), c0 + periods(2), std::nullopt), "no latency");
+        require(!place(d0, c0, d0, c0 + periods(2), latency), "no told interval");
+        require(!place(d0, c0 + periods(2), d0 + periods(2), c0, latency), "starts out of order");
+        require(!place(d0, c0, d0 + periods(2), c0 + periods(0.4), latency), "starts too close");
+        require(!place(d0, c0, d0 + periods(2), c0 + periods(6.5), latency), "starts too far apart");
