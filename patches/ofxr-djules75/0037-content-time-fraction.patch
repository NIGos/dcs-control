 }
 
 // ---------------------------------------------------------------------------
+// DCS Control (0037): synthetics placed in content time.
+
+namespace content_time {
+
+// Clocks with different epochs, as the layer's are (XrTime, steady clock).
+constexpr Nanoseconds kDisplayEpoch = 7'000 * kSecond;
+constexpr Nanoseconds kContentEpoch = 50 * kSecond;
+
+Nanoseconds periods(double value) {
+    return static_cast<Nanoseconds>(std::llround(value * static_cast<double>(kPeriod)));
+}
+
+// The layer's answer without 0037 for a told interval (display periods).
+float display_fraction(double told, std::uint32_t frames, std::uint32_t index) {
+    const double before = static_cast<double>(frames - 1 - index);
+    if (told <= static_cast<double>(frames - 1) || told > 2.0 * frames) {
+        return static_cast<float>(index + 1) / static_cast<float>(frames);
+    }
+    return static_cast<float>(1.0 - before / told);
+}
+
+struct Placement {
+    float fraction{};
+    float fallback{};
+    bool content{};              // content_time_fraction answered
+    double line_error{};         // shown content less the constant-latency line, periods
+    double display_line_error{}; // the same for the display fraction
+};
+
+// Runs real frames (told display and content start, in periods) through the
+// tracker and places each pair's synthetic `index` of `frames`. The line is
+// the true latency, `latency` periods.
+std::vector<Placement> run(
+    const std::vector<double>& told,
+    const std::vector<double>& content,
+    double latency,
+    std::uint32_t frames = 2,
+    std::uint32_t index = 0) {
+    ContentLatencyTracker tracker;
+    std::vector<Placement> out;
+    for (std::size_t i = 0; i < told.size(); ++i) {
+        const Nanoseconds display = kDisplayEpoch + periods(told[i]);
+        const Nanoseconds start = kContentEpoch + periods(content[i]);
+        tracker.observe(display, start);
+        if (i == 0) {
+            continue;
+        }
+        Placement placement;
+        placement.fallback = display_fraction(told[i] - told[i - 1], frames, index);
+        const auto value = content_time_fraction(
+            kDisplayEpoch + periods(told[i - 1]),
+            kContentEpoch + periods(content[i - 1]),
+            display,
+            start,
+            tracker.latency(),
+            kPeriod,
+            frames,
+            index,
+            placement.fallback);
+        placement.content = value.has_value();
+        placement.fraction = value ? *value : placement.fallback;
+        const double slot = told[i] - static_cast<double>(frames - 1 - index);
+        const double line = slot - latency;
+        const double interval = content[i] - content[i - 1];
+        placement.line_error = content[i - 1] + placement.fraction * interval - line;
+        placement.display_line_error =
+            content[i - 1] + placement.fallback * interval - line;
+        out.push_back(placement);
+    }
+    return out;
+}
+
+double worst(const std::vector<Placement>& placements, std::size_t from, bool display) {
+    double result = 0.0;
+    for (std::size_t i = from; i < placements.size(); ++i) {
+        const double error = display ? placements[i].display_line_error
+                                     : placements[i].line_error;
+        result = std::max(result, std::abs(error));
+    }
+    return result;
+}
+
+} // namespace content_time
+
+void content_time_tests() {
+    using namespace content_time;
+    const auto near = [](float value, double expected) {
+        return value > expected - 0.002 && value < expected + 0.002;
+    };
+    // A steady application: told and started two periods apart (2X), three
+    // (3X), at a constant latency: the fixed k / frames.
+    {
+        std::vector<double> told;
+        std::vector<double> content;
+        for (int i = 0; i < 12; ++i) {
+            told.push_back(2.0 * i + 3.0);
+            content.push_back(2.0 * i);
+        }
+        const auto placements = run(told, content, 3.0);
+        for (std::size_t i = kContentLatencyMinimum - 1; i < placements.size(); ++i) {
+            require(placements[i].content && near(placements[i].fraction, 0.5),
+                "steady 2X: one half");
+        }
+        for (double& value : told) {
+            value *= 1.5;
+        }
+        for (double& value : content) {
+            value *= 1.5;
+        }
+        for (std::uint32_t index = 0; index < 2; ++index) {
+            const auto triple = run(told, content, 4.5, 3, index);
+            for (std::size_t i = kContentLatencyMinimum - 1; i < triple.size(); ++i) {
+                require(triple[i].content &&
+                        near(triple[i].fraction, (index + 1) / 3.0),
+                    "steady 3X: thirds");
+            }
+        }
+    }
+    // Irregular display steps, steady content: an application at 2.25
+    // periods a frame in 2X (40 fps at 90 Hz) starts every 2.25 periods and
+    // is told the scanout after, 2 or 3 periods on. Told less started is
+    // 3.75, 3.5, 3.25 and 3 periods in turn: the line is their median,
+    // 3.375. The display fraction (1/2 or 2/3, with the told step) puts the
+    // world up to a quarter period off it; the content one keeps every
+    // synthetic on it.
+    {
+        std::vector<double> told;
+        std::vector<double> content;
+        for (int i = 0; i < 26; ++i) {
+            content.push_back(2.25 * i);
+            told.push_back(std::ceil(2.25 * i) + 3.0);
+        }
+        const auto placements = run(told, content, 3.375);
+        std::size_t answered = 0;
+        for (std::size_t i = kContentLatencyWindow; i < placements.size(); ++i) {
+            const Placement& placement = placements[i];
+            require(placement.content, "irregular display: answered");
+            ++answered;
+            require(placement.fraction >= placement.fallback - 0.25F - 1e-6F &&
+                    placement.fraction <= placement.fallback + 0.25F + 1e-6F,
+                "irregular display: within the band");
+            require(std::abs(placement.line_error) < 0.01,
+                "irregular display: on the line: " +
+                    std::to_string(placement.line_error));
+        }
+        require(answered >= 10, "irregular display: frames answered");
+        require(worst(placements, kContentLatencyWindow, true) > 0.2,
+            "irregular display: the display fraction is off the line");
+    }
+    // Steady display, irregular content: told two periods apart, started with
+    // up to 0.4 periods of jitter either way. The display fraction stays at
+    // 1/2 and carries every start's jitter onto the screen; the content one
+    // stays near the line, and a frame that starts late after one on time
+    // (more content between the two) has its synthetic nearer the previous
+    // frame, one that starts early nearer the current.
+    {
+        const std::vector<double> jitter{0.0, 0.3, -0.2, 0.4, -0.4, 0.1, 0.0, -0.3,
+            0.2, 0.35, -0.1, 0.0, 0.4, -0.25, 0.15, 0.0, -0.35, 0.25, 0.0, 0.3};
+        std::vector<double> told;
+        std::vector<double> content;
+        for (std::size_t i = 0; i < jitter.size(); ++i) {
+            told.push_back(2.0 * static_cast<double>(i) + 3.0);
+            content.push_back(2.0 * static_cast<double>(i) + jitter[i]);
+        }
