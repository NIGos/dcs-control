 // ---------------------------------------------------------------------------
+// DCS Control (0037): where a synthetic belongs, in the application's content
+// time (`[ofxr] content_time_fraction=1`).
+//
+// DCS's world advances with the wall clock between its frame starts, while
+// the display times it is told advance in whole periods. A synthetic shown at
+// slot s should show the world as it was at s less the pipeline's latency -
+// the same latency the real frames around it are shown with. Each real frame
+// has a latency of its own, told display time less content time (its frame
+// start): ContentLatencyTracker keeps the median of the last few, so one
+// frame's jitter or one quantized display step does not move it, and a lasting
+// change (a lost slot carried into the told times, a change of cadence) does
+// after half the window. Then
+//
+//     target = display(B) - (frames - 1 - index) * period - latency
+//     t      = (target - content(A)) / (content(B) - content(A))
+//
+// With a steady application this is the fixed k / frames. When the told
+// interval is a whole period longer or shorter than the content one, the
+// display time's fraction (1 - period / told interval) is off by up to a
+// third; this one follows the content. When the content interval jitters,
+// the synthetic stays on the constant-latency line instead of following
+// either neighbour.
+//
+// Nothing (the caller keeps its own answer) when a time is missing, out of
+// order or implausible, or the tracker has too few frames. The answer is held
+// within half a synthetic's spacing (0.5 / frames) of the caller's own, so an
+// error in the inputs can move a synthetic but never past its neighbour.
+inline constexpr std::size_t kContentLatencyWindow = 8;
+inline constexpr std::size_t kContentLatencyMinimum = 3;
+// A frame's latency this far from the window's is an outlier.
+inline constexpr Nanoseconds kContentLatencyJump = 100 * kMillisecond;
+// A gap this long between two real frames (a pause, a load) starts over.
+inline constexpr Nanoseconds kContentLatencyGap = 250 * kMillisecond;
+
+class ContentLatencyTracker {
+public:
+    // One real frame: the display time it was told and when it started (its
+    // content time), each in nanoseconds on a clock of its own. A frame that is
+    // missing either, goes back in time or follows a gap starts the window
+    // over.
+    void observe(Nanoseconds display, Nanoseconds content) noexcept {
+        if (display <= 0 || content <= 0) {
+            reset();
+            return;
+        }
+        if (last_display_ != 0 &&
+            (display <= last_display_ || content <= last_content_ ||
+             display - last_display_ > kContentLatencyGap ||
+             content - last_content_ > kContentLatencyGap)) {
+            reset();
+        }
+        last_display_ = display;
+        last_content_ = content;
+        // The two clocks may count from different epochs (the runtime's
+        // XrTime, the layer's steady clock), so a latency is judged against
+        // the window's, not on its own: one far from it is left out, and
+        // kContentLatencyMinimum of them in a row are the window from then
+        // on.
+        const Nanoseconds latency = display - content;
+        if (const auto current = this->latency()) {
+            const Nanoseconds off = latency > *current ? latency - *current
+                                                       : *current - latency;
+            if (off > kContentLatencyJump) {
+                pending_[outliers_++] = latency;
+                if (outliers_ < kContentLatencyMinimum) {
+                    return;
+                }
+                const auto pending = pending_;
+                const Nanoseconds keep_display = last_display_;
+                const Nanoseconds keep_content = last_content_;
+                reset();
+                last_display_ = keep_display;
+                last_content_ = keep_content;
+                for (const Nanoseconds value : pending) {
+                    record(value);
+                }
+                return;
+            }
+        }
+        outliers_ = 0;
+        record(latency);
+    }
+
+    void reset() noexcept {
+        count_ = 0;
+        next_ = 0;
+        outliers_ = 0;
+        last_display_ = 0;
+        last_content_ = 0;
+    }
+
+    // The median latency of the window (the mean of the middle two for an
+    // even count); nothing below kContentLatencyMinimum frames.
+    [[nodiscard]] std::optional<Nanoseconds> latency() const noexcept {
+        if (count_ < kContentLatencyMinimum) {
+            return std::nullopt;
+        }
+        std::array<Nanoseconds, kContentLatencyWindow> sorted{};
+        for (std::size_t i = 0; i < count_; ++i) {
+            sorted[i] = latencies_[i];
+        }
+        // Insertion sort: eight values, no allocation, noexcept.
+        for (std::size_t i = 1; i < count_; ++i) {
+            const Nanoseconds value = sorted[i];
+            std::size_t j = i;
+            while (j > 0 && sorted[j - 1] > value) {
+                sorted[j] = sorted[j - 1];
+                --j;
+            }
+            sorted[j] = value;
+        }
+        const std::size_t middle = count_ / 2;
+        return count_ % 2 != 0
+            ? sorted[middle]
+            : sorted[middle - 1] + (sorted[middle] - sorted[middle - 1]) / 2;
+    }
+
+    [[nodiscard]] std::size_t count() const noexcept { return count_; }
+
+private:
+    void record(Nanoseconds latency) noexcept {
+        latencies_[next_] = latency;
+        next_ = (next_ + 1) % latencies_.size();
+        count_ = count_ < latencies_.size() ? count_ + 1 : count_;
+    }
+
+    std::array<Nanoseconds, kContentLatencyWindow> latencies_{};
+    std::array<Nanoseconds, kContentLatencyMinimum> pending_{};
+    std::size_t count_{};
+    std::size_t next_{};
+    std::size_t outliers_{};
+    Nanoseconds last_display_{};
+    Nanoseconds last_content_{};
+};
+
+// `fallback` is the caller's own answer for this synthetic (the fixed k /
+// frames, or DCS Control 0029's), which bounds this one.
+[[nodiscard]] inline std::optional<float> content_time_fraction(
+    Nanoseconds previous_display,
+    Nanoseconds previous_content,
+    Nanoseconds current_display,
+    Nanoseconds current_content,
+    std::optional<Nanoseconds> latency,
+    Nanoseconds period,
+    std::uint32_t frames,
+    std::uint32_t index,
+    float fallback) noexcept {
+    if (period <= 0 || frames < 2 || index + 1 >= frames || !latency ||
+        previous_display <= 0 || previous_content <= 0 ||
+        current_display <= previous_display ||
+        current_content <= previous_content ||
+        !(fallback >= 0.0F && fallback <= 1.0F)) {
+        return std::nullopt;
+    }
+    const Nanoseconds interval = current_content - previous_content;
+    // Shorter than half a period, or longer than three times the cadence:
+    // not two consecutive frames of a running application.
+    if (interval < period / 2 ||
+        interval > period * static_cast<Nanoseconds>(frames) * 3) {
+        return std::nullopt;
+    }
+    const Nanoseconds before =
+        period * static_cast<Nanoseconds>(frames - 1 - index);
+    const Nanoseconds target = current_display - before - *latency;
+    double fraction = static_cast<double>(target - previous_content) /
+        static_cast<double>(interval);
+    const double band = 0.5 / static_cast<double>(frames);
+    const double low = std::max(0.0, static_cast<double>(fallback) - band);
+    const double high = std::min(1.0, static_cast<double>(fallback) + band);
+    fraction = fraction < low ? low : (fraction > high ? high : fraction);
+    return static_cast<float>(fraction);
+}
