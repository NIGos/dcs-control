+// DCS Control (0036): DCS's own motion vectors (R70 Stage 2; dcs_motion.hlsl
+// resamples the current frame's into this view). Compiled in only for the
+// compositions built with XRFG_DCS_MOTION=1 (always with the mask), which
+// D3D12FrameSynthesizer uses for a pair whose current frame carries proven
+// MVs pointing at its previous capture: every other pair runs the
+// compositions without, byte for byte as before 0036.
+//  - t11 the resampled motion: per cell xy the residual motion (the previous
+//    frame's position less the cell's, target pixels, after the rotation the
+//    composition maps the previous frame with: the vector the NVIDIA flow
+//    would give, the head rotation counted once), z the class byte, w flags
+//    (1 an MV, 2 one surface: interpolate, 4 a uniform field); slice
+//    ViewIndex * 3 the current frame's own, + 1 + output the field at that
+//    output's instant, already at its fixed point (dcs_motion.hlsl).
+//  - t12 the scatter (slice ViewIndex * 2 + output): what reaches each cell
+//    at the output's instant from an edge cell (a key: priority, cell index).
+//  - u0 the counters: per bucket of 8 bytes the pixels composed along an MV
+//    and those that fell back to the flow, one pixel in 256.
+//  - UseGameMotion (read by the game-motion composition alone otherwise):
+//    bit 0 bound for this view, bit 1 the sky's MVs used (else its flow),
+//    bit 2 a test's MVs without any check, bit 3 count this output, bits 4-5
+//    the cell (4 << n pixels), bit 8 the output (two passes).
+// A pixel (not the cockpit's: the mask and depth compose those) takes one of
+// two candidates: the MV at its fixed point (the current frame's pixel whose
+// content is here at the instant; solved per cell by the resample), or the
+// scatter's (an edge cell's content arriving here, where it is its own fixed
+// point): the latter where it is a model over anything else, or a surface
+// over the sky. Its two frames' samples must agree (a stricter test on water,
+// foliage and grass, whose look changes without their geometry moving), and a
+// pixel the MV field moves uniformly whose two frames agree at the very pixel
+// while the MV's samples do not is content the G-buffer does not hold (a HUD,
+// a label over the world): the flow there. Where the check fails, the flow
+// composition as before; in between, the two blended.
+#ifndef XRFG_DCS_MOTION
+#define XRFG_DCS_MOTION 0
+#endif
+#if XRFG_DCS_MOTION
+Texture2DArray<float4> DcsMotion : register(t11);
+Texture2DArray<uint> DcsMotionScatter : register(t12);
+RWByteAddressBuffer DcsMotionCounters : register(u0);
+static const uint kDcsMotionScatterIndexBits = 22u;
+
+bool dcs_motion_bound() {
+    return (UseGameMotion & 1u) != 0u;
+}
+
+float dcs_motion_cell() {
+    return float(4u << ((UseGameMotion >> 4) & 3u));
+}
+
+uint dcs_motion_output() {
+    return (UseGameMotion >> 8) & 1u;
+}
+
+bool dcs_motion_counting() {
+    return (UseGameMotion & 8u) != 0u;
+}
+
+// The class's use: 0 none (flow), 1 normal, 2 strict (water, foliage, grass).
+uint dcs_motion_class_use(uint klass) {
+    uint composition = klass & 7u;
+    uint use = composition == 0u || composition == 1u ? 1u : (composition <= 4u ? 2u : 0u);
+    return (klass & 0x80u) != 0u ? ((UseGameMotion & 2u) != 0u ? 1u : 0u) : use;
+}
+
+// The resampled motion of slice `slice` at target pixel `pixel`:
+// interpolated where its cell is one surface, the cell's own at an edge; w
+// the flags as integers (0: none).
+float4 dcs_motion_field(float2 pixel, uint slice) {
+    float2 position = (pixel - PreviousMappings[ViewIndex].TargetRect.xy + 0.5) / dcs_motion_cell();
+    float4 value = DcsMotion.Load(int4(int2(floor(position)), int(slice), 0));
+    float width, height, slices;
+    DcsMotion.GetDimensions(width, height, slices);
+    float2 interpolated = DcsMotion.SampleLevel(
+        LinearClamp, float3(position / float2(width, height), float(slice)), 0.0).xy;
+    uint flags = uint(value.w + 0.5);
+    value.xy = (flags & 2u) != 0u ? interpolated : value.xy;
+    value.w = float(flags);
+    return value;
+}
+
+// Whether the MVs see motion at `pixel` (the still-tile path stays off
+// there): a vector over the composition's snap (1/64 px), or anything the
+// scatter brings. Elsewhere the MV composition is the two frames at the very
+// pixel, the still tiles' own value: the same image either way.
+static const float kDcsMotionSnap = 1.0 / 64.0;
+bool dcs_motion_moving(float2 pixel) {
+    float4 here = dcs_motion_field(pixel, ViewIndex * 3u);
+    int2 cell = int2(floor((pixel - PreviousMappings[ViewIndex].TargetRect.xy + 0.5) / dcs_motion_cell()));
+    uint keys = DcsMotionScatter.Load(int4(cell, int(ViewIndex * 2u), 0)) |
+        DcsMotionScatter.Load(int4(cell, int(ViewIndex * 2u + 1u), 0));
+    return keys != 0u || (here.w > 0.5 && dot(here.xy, here.xy) > kDcsMotionSnap * kDcsMotionSnap);
+}
+
+// The MVs' composition of the pixel at `position` at this instant (`color`) and how
+// far it holds: 1 it alone, 0 the flow's as before, between the two blended.
+float dcs_motion_pixel(float2 position, uint output, bool count, out float4 color) {
+    color = float4(0.0, 0.0, 0.0, 1.0);
+    float weight = 0.0;
+    uint2 integer_pixel = uint2(position);
+    [branch] if (dcs_motion_bound() && cockpit_mask_bound() && repeated_capture_flag() == 0 &&
+        integer_pixel.x < Width && integer_pixel.y < Height && Slice < ArraySize) {
+        float2 pixel = float2(integer_pixel);
+        float t = synthesis_fraction();
+        bool eligible = false;
+        [branch] if (cockpit_mask_at(pixel) < 0.75) {
+            // The gather: the MV at its fixed point for this instant.
+            float4 here = dcs_motion_field(pixel, ViewIndex * 3u + 1u + output);
+            uint here_class = uint(here.z + 0.5);
+            uint here_flags = uint(here.w);
+            uint use = (here_flags & 1u) != 0u ? dcs_motion_class_use(here_class) : 0u;
+            // Below the snap, none (exactly the two frames at the pixel).
+            float2 motion = dot(here.xy, here.xy) > kDcsMotionSnap * kDcsMotionSnap ? here.xy : float2(0.0, 0.0);
+            bool same_field = (here_flags & 4u) != 0u;
+            // The scatter: an edge cell's content arriving here.
+            float2 rect_cells = ceil(PreviousMappings[ViewIndex].TargetRect.zw / dcs_motion_cell());
+            int2 cell = int2(floor((pixel - PreviousMappings[ViewIndex].TargetRect.xy + 0.5) / dcs_motion_cell()));
+            uint key = DcsMotionScatter.Load(int4(cell, int(ViewIndex * 2u + output), 0));
+            [branch] if (key != 0u) {
+                uint index = key & ((1u << kDcsMotionScatterIndexBits) - 1u);
+                uint priority = key >> kDcsMotionScatterIndexBits;
+                uint grid_width = max(uint(rect_cells.x), 1u);
+                float4 source = DcsMotion.Load(
+                    int4(int(index % grid_width), int(index / grid_width), int(ViewIndex * 3u), 0));
+                uint source_class = uint(source.z + 0.5);
+                // Its own fixed point here: the content at the current pixel
+                // it comes from moves with it.
+                float4 check = dcs_motion_field(pixel - (1.0 - t) * source.xy, ViewIndex * 3u);
+                bool consistent = source.w > 0.5 && check.w > 0.5 && uint(check.z + 0.5) == source_class &&
+                    length(check.xy - source.xy) < 1.0 && length(source.xy - motion) >= 1.0;
+                // In front of the gather's: a model over anything else, a
+                // surface over the sky or over nothing usable.
+                uint gather_priority = use == 0u || (here_class & 0x80u) != 0u ? 0u
+                    : ((here_class & 7u) == 1u ? 2u : 1u);
+                [branch] if (consistent && priority > gather_priority) {
+                    motion = source.xy;
+                    use = dcs_motion_class_use(source_class);
+                    same_field = false;
+                }
+            }
+            [branch] if (use != 0u) {
+                CameraSample previous = sample_previous_target(pixel + t * motion, Slice, ViewIndex);
+                CameraSample current = sample_current_target(pixel - (1.0 - t) * motion, Slice, ViewIndex);
+                [branch] if (previous.valid >= 0.5 && current.valid >= 0.5) {
+                    eligible = true;
+                    color = saturate(lerp(previous.color, current.color, t));
+                    if ((UseGameMotion & 4u) != 0u) {
+                        weight = 1.0;
+                    } else {
+                        bool strict = use == 2u;
+                        float disagreement = rgb_error(previous.color, current.color);
+                        weight = 1.0 - smoothstep(strict ? 6.0 / 255.0 : 16.0 / 255.0,
+                                           strict ? 20.0 / 255.0 : 48.0 / 255.0, disagreement);
+                        // Content the MVs do not hold over a uniformly moving
+                        // surface: the two frames agree at the very pixel,
+                        // the MV's samples show something else.
+                        [branch] if (weight > 0.0 && same_field && dot(motion, motion) > 1.0) {
+                            CameraSample same_previous = sample_previous_target(pixel, Slice, ViewIndex);
+                            CameraSample same_current = sample_current_target(pixel, Slice, ViewIndex);
+                            if (same_previous.valid >= 0.5 && same_current.valid >= 0.5) {
+                                float still = 1.0 - smoothstep(4.0 / 255.0, 10.0 / 255.0,
+                                    rgb_error(same_previous.color, same_current.color));
+                                float differs = smoothstep(16.0 / 255.0, 40.0 / 255.0,
+                                    rgb_error(color, lerp(same_previous.color, same_current.color, t)));
+                                weight *= 1.0 - still * differs;
+                            }
+                        }
+                    }
+                }
+            }
+        }
