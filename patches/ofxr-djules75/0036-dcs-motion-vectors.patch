+        if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &description,
+                D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(dcs_motion_target.GetAddressOf()))) ||
+            FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &scatter,
+                D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(dcs_motion_scatter.GetAddressOf()))) ||
+            FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &counters,
+                D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(dcs_motion_counters.GetAddressOf()))) ||
+            FAILED(device->CreateCommittedResource(&readback_heap, D3D12_HEAP_FLAG_NONE, &readback,
