+            dcs_motion_target.Reset();
+            dcs_motion_scatter.Reset();
+            dcs_motion_counters.Reset();
+            dcs_motion_readback.Reset();
+            return S_OK;
+        }
+        dcs_motion_target->SetName(L"OFXR DCS Motion Target");
+        dcs_motion_scatter->SetName(L"OFXR DCS Motion Scatter");
+        dcs_motion_counters->SetName(L"OFXR DCS Motion Counters");
+        return S_OK;
+    }
+
+    // DCS Control (0036): t11, t12 and u0 of every view block, written once:
+    // the resampled motion, the scatter and the counters (null without
+    // them; only the MV compositions read them).
+    void write_dcs_motion_views(WorkSlot& slot) noexcept {
+        const bool made = dcs_motion_target != nullptr && dcs_motion_scatter != nullptr &&
+            dcs_motion_counters != nullptr;
+        const D3D12_CPU_DESCRIPTOR_HANDLE start = slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+        view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+        view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        view.Texture2DArray.MipLevels = 1;
+        for (UINT block = 0; block < kMaxReprojectionViews; ++block) {
+            const UINT base = block * kDescriptorBlockSize;
+            view.Format = kDcsMotionTargetFormat;
+            view.Texture2DArray.ArraySize = kMaxReprojectionViews * 3U;
+            device->CreateShaderResourceView(made ? dcs_motion_target.Get() : nullptr, &view,
+                offset_cpu_handle(start, base + kDcsMotionSrvDescriptor, descriptor_increment));
+            view.Format = kDcsMotionScatterFormat;
+            view.Texture2DArray.ArraySize = kMaxReprojectionViews * 2U;
+            device->CreateShaderResourceView(made ? dcs_motion_scatter.Get() : nullptr, &view,
+                offset_cpu_handle(start, base + kDcsMotionScatterSrvDescriptor, descriptor_increment));
+            if (made) {
+                D3D12_UNORDERED_ACCESS_VIEW_DESC counters{};
+                counters.Format = DXGI_FORMAT_R32_TYPELESS;
+                counters.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+                counters.Buffer.NumElements = kDcsMotionCounterBytes / 4U;
+                counters.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+                device->CreateUnorderedAccessView(dcs_motion_counters.Get(), nullptr, &counters,
+                    offset_cpu_handle(start, base + kSrvDescriptorCount, descriptor_increment));
+            }
+        }
+    }
+
+    // DCS Control (0036): records the resample and the scatter of the
+    // current frame's MVs into the target views, on `list` after the cockpit
+    // mask's resample, for a pair that bound a mask whose current frame
+    // carries MVs pointing at the previous capture (its display time), where
+    // the composition about to draw has its MV counterpart; sets
+    // pair_motion_bound and each view's UseGameMotion bits.
+    void record_dcs_motion(
+        ID3D12GraphicsCommandList* list,
+        WorkSlot& slot,
+        const RollingSource& previous_source,
+        std::span<const D3D12ReprojectionView> target_views) noexcept {
+        pair_motion_bound = false;
+        pair_motion_bits = {};
+        D3D12CockpitMaskFrame* const current = pair_mask_current.get();
+        D3D12CockpitMaskFrame* const previous_frame = pair_mask_previous.get();
+        ID3D12PipelineState* const plain = nvidia_options.bidirectional
+            ? nvidia_bidirectional_graphics_pipeline.Get()
+            : nvidia_graphics_pipeline.Get();
+        if (!dcs_motion_enabled() || !pair_mask_bound || current == nullptr || !current->motion ||
+            current->motion_texture == nullptr || dcs_motion_target == nullptr ||
+            dcs_motion_resample_pipeline == nullptr || dcs_motion_scatter_pipeline == nullptr ||
+            motion_pipeline(plain, pair_depth_bound) == nullptr) {
+            return;
+        }
+        // The MVs point at the frame DCS drew before this one: only a pair
+        // whose previous capture is that frame may use them.
+        if (previous_frame == nullptr || previous_frame == current ||
+            previous_frame->display_time != current->motion_previous_display_time) {
+            if (current->counters) {
+                current->counters->motion_previous_mismatch.fetch_add(1U, std::memory_order_relaxed);
+            }
+            return;
+        }
+        // Backing off (the MVs fell back too often lately): the flow alone.
+        if (dcs_motion_backoff_left != 0) {
+            --dcs_motion_backoff_left;
+            if (current->counters) {
+                current->counters->motion_backoff_pairs.fetch_add(1U, std::memory_order_relaxed);
+            }
+            return;
+        }
+        const UINT outputs = std::clamp(synthetic_output_count(), 1U, 2U);
+        std::array<DcsMotionParameters, kMaxReprojectionViews> views{};
+        bool any = false;
+        const UINT width = static_cast<UINT>(image_description.Width);
+        for (UINT index = 0; index < static_cast<UINT>(target_views.size()) && index < kMaxReprojectionViews;
+             ++index) {
+            const UINT eye = cockpit_mask_eye(target_views[index], index);
+            if (eye >= 2U || !current->motion_views[eye].valid) {
+                continue;
+            }
+            const D3D12DcsMotionView& motion = current->motion_views[eye];
+            const CameraMapping mapping = make_camera_mapping(
+                previous_source.views[index], target_views[index], width, image_description.Height);
+            DcsMotionParameters& parameters = views[index];
+            parameters.cell = dcs_motion_cell;
+            parameters.slice = index;
+            parameters.output_width =
+                (static_cast<UINT>(mapping.target_rect[2]) + dcs_motion_cell - 1U) / dcs_motion_cell;
+            parameters.output_height =
+                (static_cast<UINT>(mapping.target_rect[3]) + dcs_motion_cell - 1U) / dcs_motion_cell;
+            parameters.flags = (current->motion_class && current->motion_class_texture != nullptr ? 1U : 0U) |
+                (motion.no_stencil ? 2U : 0U);
+            parameters.outputs = outputs;
+            parameters.fraction0 = synthetic_output_fraction(0);
+            parameters.fraction1 = outputs > 1U ? synthetic_output_fraction(1) : parameters.fraction0;
+            parameters.target_rect = mapping.target_rect;
+            parameters.target_tangents = mapping.target_tangents;
+            parameters.target_to_previous = mapping.target_to_source_rotation;
+            parameters.source_rect = {float(motion.x), float(motion.y), float(motion.width), float(motion.height)};
+            parameters.source_fov = motion.fov_tan;
+            parameters.offset = {motion.offset_px[0], motion.offset_px[1], 0.0F, 0.0F};
+            if (parameters.output_width == 0 || parameters.output_height == 0) {
+                continue;
+            }
+            pair_motion_bits[index] = kDcsMotionBoundBit | dcs_motion_test_bits |
+                (dcs_motion_cell_code << kDcsMotionCellShift);
+            any = true;
+        }
+        if (!any) {
+            pair_motion_bits = {};
+            return;
+        }
+        ID3D12Resource* const source = current->motion_texture.Get();
+        ID3D12Resource* const classes = (views[0].flags & 1U) != 0U || (views[1].flags & 1U) != 0U
+            ? current->motion_class_texture.Get()
+            : nullptr;
+        // The block: t0 the MVs, t1 the classes, t2 the resampled motion;
+        // u0 the resampled motion, u1 the scatter; typed nulls besides.
+        const D3D12_CPU_DESCRIPTOR_HANDLE start = slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        const UINT base = kDcsMotionBlock * kDescriptorBlockSize;
+        for (UINT index = 0; index < kSrvDescriptorCount; ++index) {
+            D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+            view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+            view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+            view.Texture2D.MipLevels = 1;
+            view.Format = DXGI_FORMAT_R8_UNORM;
+            ID3D12Resource* resource = nullptr;
+            if (index == 0) {
+                resource = source;
+                view.Format = DXGI_FORMAT_R16G16_FLOAT;
+            } else if (index == 1) {
+                resource = classes;
+                view.Format = DXGI_FORMAT_R8_UINT;
+            } else if (index == 2) {
+                resource = dcs_motion_target.Get();
+                view.Format = kDcsMotionTargetFormat;
+                view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+                view.Texture2DArray.MipLevels = 1;
+                view.Texture2DArray.ArraySize = kMaxReprojectionViews * 3U;
+            }
+            device->CreateShaderResourceView(resource, &view, offset_cpu_handle(start, base + index, descriptor_increment));
+        }
+        D3D12_UNORDERED_ACCESS_VIEW_DESC target{};
+        target.Format = kDcsMotionTargetFormat;
+        target.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+        target.Texture2DArray.ArraySize = kMaxReprojectionViews * 3U;
+        device->CreateUnorderedAccessView(dcs_motion_target.Get(), nullptr, &target,
+            offset_cpu_handle(start, base + kSrvDescriptorCount, descriptor_increment));
+        target.Format = kDcsMotionScatterFormat;
+        target.Texture2DArray.ArraySize = kMaxReprojectionViews * 2U;
+        device->CreateUnorderedAccessView(dcs_motion_scatter.Get(), nullptr, &target,
+            offset_cpu_handle(start, base + kSrvDescriptorCount + 1U, descriptor_increment));
+        D3D12_UNORDERED_ACCESS_VIEW_DESC null_target{};
+        null_target.Format = DXGI_FORMAT_R8_UNORM;
+        null_target.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        device->CreateUnorderedAccessView(nullptr, nullptr, &null_target,
+            offset_cpu_handle(start, base + kSrvDescriptorCount + 2U, descriptor_increment));
+
+        std::array<D3D12_RESOURCE_BARRIER, 4> before{};
+        UINT before_count = 0;
+        before[before_count++] = transition_barrier(
+            source, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        if (classes != nullptr) {
+            before[before_count++] = transition_barrier(
+                classes, D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        }
+        before[before_count++] = transition_barrier(
+            dcs_motion_target.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        before[before_count++] = transition_barrier(
+            dcs_motion_scatter.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        list->ResourceBarrier(before_count, before.data());
+        ID3D12DescriptorHeap* heaps[] = {slot.descriptor_heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetComputeRootSignature(root_signature.Get());
+        const D3D12_GPU_DESCRIPTOR_HANDLE block = offset_gpu_handle(
+            slot.descriptor_heap->GetGPUDescriptorHandleForHeapStart(), base, descriptor_increment);
+        list->SetComputeRootDescriptorTable(0, block);
+        list->SetComputeRootDescriptorTable(1, offset_gpu_handle(block, kSrvDescriptorCount, descriptor_increment));
+        list->SetPipelineState(dcs_motion_resample_pipeline.Get());
+        for (UINT index = 0; index < kMaxReprojectionViews; ++index) {
+            if (pair_motion_bits[index] == 0U) {
+                continue;
+            }
+            list->SetComputeRoot32BitConstants(
+                2, static_cast<UINT>(sizeof(DcsMotionParameters) / sizeof(UINT)), &views[index], 0);
+            list->Dispatch((views[index].output_width + 7U) / 8U, (views[index].output_height + 7U) / 8U, 1);
+        }
+        // The resampled motion is read by the scatter, the scatter cleared.
+        const std::array<D3D12_RESOURCE_BARRIER, 2> resampled{
+            transition_barrier(dcs_motion_target.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, kShaderReadState),
+            uav_barrier(dcs_motion_scatter.Get()),
+        };
+        list->ResourceBarrier(static_cast<UINT>(resampled.size()), resampled.data());
+        list->SetPipelineState(dcs_motion_scatter_pipeline.Get());
+        for (UINT index = 0; index < kMaxReprojectionViews; ++index) {
+            if (pair_motion_bits[index] == 0U) {
+                continue;
+            }
+            list->SetComputeRoot32BitConstants(
+                2, static_cast<UINT>(sizeof(DcsMotionParameters) / sizeof(UINT)), &views[index], 0);
+            list->Dispatch((views[index].output_width + 7U) / 8U, (views[index].output_height + 7U) / 8U, 1);
+        }
+        std::array<D3D12_RESOURCE_BARRIER, 4> after{};
+        UINT after_count = 0;
+        after[after_count++] = transition_barrier(
+            source, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+        if (classes != nullptr) {
+            after[after_count++] = transition_barrier(
+                classes, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+        }
+        after[after_count++] = transition_barrier(
+            dcs_motion_scatter.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+        after[after_count++] = transition_barrier(
+            dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        list->ResourceBarrier(after_count, after.data());
+        pair_motion_bound = true;
+        if (current->counters) {
+            current->counters->motion_pairs.fetch_add(1U, std::memory_order_relaxed);
+        }
+        slot.motion_sink = current->counters;
+    }
+
+    // DCS Control (0036): after the composition: the MVs' targets back to
+    // COMMON, and the counters (cumulative) to this slot's readback region,
+    // read once the slot's work has completed.
+    void finish_dcs_motion(ID3D12GraphicsCommandList* list, WorkSlot& slot) noexcept {
+        if (!pair_motion_bound) {
+            return;
+        }
+        const std::array<D3D12_RESOURCE_BARRIER, 3> barriers{
+            transition_barrier(dcs_motion_target.Get(), kShaderReadState, D3D12_RESOURCE_STATE_COMMON),
+            transition_barrier(
+                dcs_motion_scatter.Get(), D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON),
+            transition_barrier(
+                dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COPY_SOURCE),
+        };
+        list->ResourceBarrier(static_cast<UINT>(barriers.size()), barriers.data());
+        const UINT slot_index = static_cast<UINT>(&slot - work_slots.data());
+        list->CopyBufferRegion(dcs_motion_readback.Get(), static_cast<UINT64>(slot_index) * kDcsMotionCounterBytes,
+            dcs_motion_counters.Get(), 0, kDcsMotionCounterBytes);
+        const D3D12_RESOURCE_BARRIER back = transition_barrier(
+            dcs_motion_counters.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_COMMON);
+        list->ResourceBarrier(1, &back);
+        slot.motion_order = dcs_motion_next_order++;
+        pair_motion_bound = false;
+    }
+
+    // DCS Control (0036): the MVs' counters of a slot whose work has
+    // completed, added (as pixels) to where its pair's mask counts, as the
+    // cockpit depth's.
+    void harvest_dcs_motion(WorkSlot& slot) noexcept {
+        if (slot.motion_order == 0 || dcs_motion_readback == nullptr ||
+            fence_status(fence.Get(), slot.fence_value) != S_OK) {
+            return;
+        }
+        const UINT slot_index = static_cast<UINT>(&slot - work_slots.data());
+        const SIZE_T begin = static_cast<SIZE_T>(slot_index) * kDcsMotionCounterBytes;
+        const D3D12_RANGE read_range{begin, begin + kDcsMotionCounterBytes};
+        void* mapped = nullptr;
+        if (SUCCEEDED(dcs_motion_readback->Map(0, &read_range, &mapped)) && mapped != nullptr) {
+            std::array<std::uint32_t, kDcsMotionCounterBuckets * 2U> words{};
+            std::memcpy(words.data(), static_cast<const std::byte*>(mapped) + begin, sizeof(words));
+            const D3D12_RANGE no_write{0, 0};
+            dcs_motion_readback->Unmap(0, &no_write);
