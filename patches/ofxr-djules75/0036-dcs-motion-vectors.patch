+                            dcs_motion_backoff_left = kDcsMotionBackoffPairs;
+                        }
+                        dcs_motion_window_pixels = 0;
+                        dcs_motion_window_fallbacks = 0;
+                        dcs_motion_window_pairs = 0;
+                    }
+                    if (slot.motion_sink) {
+                        slot.motion_sink->motion_pixels.fetch_add(
