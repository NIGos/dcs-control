+++ b/src/d3d12/dcs_motion.hlsl
@@ -0,0 +1,262 @@
+// DCS Control (0036): DCS's own motion vectors (R70 Stage 2, contract
+// xrfg/dcsvr_motion.h revision 2), resampled into the synthetic's own view
+// (D3D12FrameSynthesizer, before the composition of a pair whose current frame
+// carries them and points at the pair's previous capture).
+//
+// Input: the current frame's MV rect (R16G16_FLOAT, render texels of DCS's
+// view: +x right, +y down, B to A: the previous position is the current one
+// plus the MV, ownship and head motion included) and, where shared, its class
+// rect on the same grid (R8_UINT: bits 0-2 DCS's stencil composition, bit 7
+// no finite distance below 65504 m), the rect's edges the tangents of DCS's
+// jittered projection (SourceFov). A raw MV plus Offset is the true motion
+// (dcsvr_motion::true_motion: 0 for DCS's jitter-free MVs).
+//
+// DcsMotionResampleCS, one thread per Cell x Cell pixels of the target view
+// (the current frame's camera): the cell's centre is taken to its direction,
+// that to its texel of the MV rect by tangent (as the mask), the MV read
+// there, and the previous frame's position it gives (in the previous camera,
+// by the same tangents: the two frames' unjittered fields of view are the
+// same, and jittered tangents with a jitter-free MV leave the jitter out on
+// both sides) taken back into the target view through the rotation the
+// composition maps the previous frame with. That is the composition's own
+// residual motion: the previous frame's position in target pixels less the
+// cell's centre (what the NVIDIA flow measures after the pose pre-warp: the
+// head rotation counted once). Three slices per view (Slice * 3): the
+// current frame's own field (+0), and for each output's instant t (+1, +2)
+// the field solved to its fixed point c = p - (1 - t) * motion(c) here, once
+// per cell, so the composition reads its vector with no iteration (as 0035's
+// depth). Each: xy the residual, z the class byte, w flags: 1 an MV, 2 one
+// surface across the cell's neighbourhood (the composition may interpolate),
+// 4 the fixed point's vector is the cell's own within a pixel (the field
+// moves uniformly here). It also clears the cell in both outputs' slices of
+// the scatter target.
+//
+// DcsMotionScatterCS, after it: every edge cell of a surface (not sky) is
+// written at the place its content has at each output's instant into the
+// scatter target (InterlockedMax of a key: 2 for DCS's models, 1 for other
+// surfaces, above 22 bits of the cell's index), on the four cells there. The
+// composition reads it as a second candidate: what crosses a pixel at the
+// synthetic's instant though the MV at that very pixel belongs to what is
+// behind (a thin wire over the sky, an object's leading edge), which no
+// gather from the pixel can find.
+//
+// Its own descriptor block of the synthesizer's root signature: t0 the MV
+// rect, t1 the class rect, t2 the resampled motion (for the scatter), u0 the
+// resampled motion, u1 the scatter target; these constants in the 62 at b0.
+
+SamplerState LinearClamp : register(s0);
+Texture2D<float2> MotionSource : register(t0);
+Texture2D<uint> ClassSource : register(t1);
+Texture2DArray<float4> MotionResampled : register(t2);
+RWTexture2DArray<float4> MotionTarget : register(u0);
+RWTexture2DArray<uint> ScatterTarget : register(u1);
+
+cbuffer DcsMotionParameters : register(b0) {
+    uint OutputWidth;
+    uint OutputHeight;
+    uint Cell;
+    uint Slice;
+    // Bit 0: the class rect is bound; bit 1: its composition bits are unknown
+    // for this view (no stencil: taken as a surface).
+    uint Flags;
+    // How many outputs the pair composes (1 or 2), for the scatter.
+    uint Outputs;
+    float Fraction0;
+    float Fraction1;
+    float4 TargetRect;
+    // left, right, up, down tangents of the target view.
+    float4 TargetTangents;
+    float4 TargetToPrevious;
+    // x, y, w, h of the MV rect, and its fovTan.
+    float4 SourceRect;
+    float4 SourceFov;
+    // xy: what a raw MV takes to be the true motion (render pixels).
+    float4 Offset;
+};
+
+static const uint kScatterIndexBits = 22u;
+
+float3 rotate_by_quaternion(float4 quaternion, float3 input_vector) {
+    return input_vector + 2.0 * cross(
+        quaternion.xyz,
+        cross(quaternion.xyz, input_vector) + quaternion.w * input_vector);
+}
+
+int2 source_texel(int2 texel) {
+    return int2(SourceRect.xy) + clamp(texel, int2(0, 0), int2(SourceRect.zw) - 1);
+}
+
+float2 load_motion(int2 texel) {
+    return MotionSource.Load(int3(source_texel(texel), 0)) + Offset.xy;
+}
+
+uint load_class(int2 texel) {
+    uint value = (Flags & 1u) != 0u ? ClassSource.Load(int3(source_texel(texel), 0)) : 0u;
+    // Without a stencil plane bits 0-2 say nothing: a surface.
+    return (Flags & 2u) != 0u ? (value & 0x80u) : value;
+}
+
+bool finite2(float2 value) {
+    return all(abs(value) < 1.0e6);
+}
+
+// The MV rect's position (texels from its corner, centres at k + 0.5) of
+// target pixel `pixel`; false outside it.
+bool source_position(float2 pixel, out float2 position) {
+    float2 uv = (pixel - TargetRect.xy + 0.5) / max(TargetRect.zw, float2(1.0, 1.0));
+    float2 tangent = float2(
+        lerp(TargetTangents.x, TargetTangents.y, uv.x),
+        lerp(TargetTangents.z, TargetTangents.w, uv.y));
+    float left = SourceFov.x, right = SourceFov.y, up = SourceFov.z, down = SourceFov.w;
+    bool usable = right > left && up > down && SourceRect.z >= 2.0 && SourceRect.w >= 2.0;
+    position = usable
+        ? float2((tangent.x - left) / (right - left), (up - tangent.y) / (up - down)) * SourceRect.zw
+        : float2(-1.0, -1.0);
+    return usable && all(position >= 0.0) && all(position < SourceRect.zw);
+}
+
+// The residual motion in target pixels of target pixel `pixel`, whose MV at
+// rect position `position` is `motion` (true motion, render pixels); false
+// where the previous position is behind the target's front or absurd.
+bool target_residual(float2 pixel, float2 position, float2 motion, out float2 residual) {
+    residual = float2(0.0, 0.0);
+    float left = SourceFov.x, right = SourceFov.y, up = SourceFov.z, down = SourceFov.w;
+    float2 previous_position = position + motion;
+    float2 previous_tangent = float2(
+        left + previous_position.x / SourceRect.z * (right - left),
+        up - previous_position.y / SourceRect.w * (up - down));
+    float4 previous_to_target = float4(-TargetToPrevious.xyz, TargetToPrevious.w);
+    float3 ray = rotate_by_quaternion(previous_to_target, float3(previous_tangent, -1.0));
+    bool front = finite2(motion) && ray.z < -1.0e-5;
+    float2 span = float2(TargetTangents.y - TargetTangents.x, TargetTangents.w - TargetTangents.z);
+    float2 previous_pixel = TargetRect.xy +
+        (ray.xy / max(-ray.z, 1.0e-5) - TargetTangents.xz) / span * TargetRect.zw - 0.5;
+    residual = front ? previous_pixel - pixel : float2(0.0, 0.0);
+    return front && finite2(residual) && length(residual) <= 1024.0;
+}
+
+// The MV at rect position `position`: bilinear where the four texels around
+// it are one surface (one class, within half a texel), else the nearest's.
+float2 motion_around(float2 position, out uint klass) {
+    int2 nearest = int2(floor(position));
+    klass = load_class(nearest);
+    float2 at = position - 0.5;
+    int2 base = int2(floor(at));
+    float2 weight = at - float2(base);
+    float2 a = load_motion(base), b = load_motion(base + int2(1, 0));
+    float2 c = load_motion(base + int2(0, 1)), d = load_motion(base + int2(1, 1));
+    float2 low = min(min(a, b), min(c, d)), high = max(max(a, b), max(c, d));
+    bool one = load_class(base) == klass && load_class(base + int2(1, 0)) == klass &&
+        load_class(base + int2(0, 1)) == klass && load_class(base + int2(1, 1)) == klass &&
+        all(high - low <= 0.5);
+    return one ? lerp(lerp(a, b, weight.x), lerp(c, d, weight.x), weight.y) : load_motion(nearest);
+}
+
+[numthreads(8, 8, 1)]
+void DcsMotionResampleCS(uint3 thread_id : SV_DispatchThreadID) {
+    if (thread_id.x >= OutputWidth || thread_id.y >= OutputHeight) {
+        return;
+    }
+    float4 result = float4(0.0, 0.0, 0.0, 0.0);
+    float2 pixel = TargetRect.xy + (float2(thread_id.xy) + 0.5) * float(Cell) - 0.5;
+    float2 position;
+    uint klass = 0u;
+    bool interior = false;
+    if (source_position(pixel, position)) {
+        int2 nearest = int2(floor(position));
+        klass = load_class(nearest);
+        float2 motion = load_motion(nearest);
+        // One surface around: every texel a neighbouring cell's sample can
+        // reach (the cell's size in texels, at least one each way) of the
+        // same class and within half a texel of this motion, inside the
+        // rect, and the cell not on the grid's border.
+        float left = SourceFov.x, right = SourceFov.y, up = SourceFov.z, down = SourceFov.w;
+        float2 texels_per_pixel = SourceRect.zw /
+            max(abs(float2(right - left, up - down)), float2(1.0e-6, 1.0e-6)) *
+            abs(float2(TargetTangents.y - TargetTangents.x, TargetTangents.w - TargetTangents.z)) /
+            max(TargetRect.zw, float2(1.0, 1.0));
+        int reach = int(clamp(ceil(max(texels_per_pixel.x, texels_per_pixel.y) * float(Cell)), 1.0, 2.0));
+        interior = finite2(motion) && thread_id.x > 0u && thread_id.y > 0u &&
+            thread_id.x + 1u < OutputWidth && thread_id.y + 1u < OutputHeight &&
+            all(nearest - reach >= 0) && all(nearest + reach < int2(SourceRect.zw));
+        [loop] for (int y = -reach; y <= reach && interior; ++y) {
+            [loop] for (int x = -reach; x <= reach; ++x) {
+                int2 texel = nearest + int2(x, y);
+                float2 other = load_motion(texel);
+                if (load_class(texel) != klass || !finite2(other) || any(abs(other - motion) > 0.5)) {
+                    interior = false;
+                }
+            }
+        }
+        uint unused;
+        if (interior) {
+            motion = motion_around(position, unused);
+        }
+        float2 residual;
+        if (target_residual(pixel, position, motion, residual)) {
+            result = float4(residual, float(klass), interior ? 7.0 : 5.0);
+        }
+    }
+    MotionTarget[uint3(thread_id.xy, Slice * 3u)] = result;
+    // Each output's instant: the current pixel c whose content is at this
+    // cell's centre then, c = p - (1 - t) * motion(c), from the cell's own
+    // vector, in at most two steps, staying on its class.
+    [unroll] for (uint output = 0u; output < 2u; ++output) {
+        float4 solved = float4(0.0, 0.0, 0.0, 0.0);
+        float t = output == 0u ? Fraction0 : Fraction1;
+        [branch] if (result.w > 0.5) {
+            float2 motion = result.xy;
+            [unroll] for (uint step = 0u; step < 2u; ++step) {
+                float2 at = pixel - (1.0 - t) * motion;
+                float2 at_position;
+                uint at_class = 0u;
+                float2 residual = motion;
+                bool same = false;
+                if (source_position(at, at_position)) {
+                    float2 raw = motion_around(at_position, at_class);
+                    same = at_class == klass && target_residual(at, at_position, raw, residual);
+                }
+                float moved = same ? length(residual - motion) : 0.0;
+                motion = same ? residual : motion;
+                if (moved <= 0.25) {
+                    break;
+                }
+            }
+            bool uniform_field = length(motion - result.xy) < 1.0;
+            solved = float4(motion, result.z, 1.0 + (interior && uniform_field ? 2.0 : 0.0) +
+                (uniform_field ? 4.0 : 0.0));
+        }
+        MotionTarget[uint3(thread_id.xy, Slice * 3u + 1u + output)] = solved;
+        ScatterTarget[uint3(thread_id.xy, Slice * 2u + output)] = 0u;
+    }
+}
+
+[numthreads(8, 8, 1)]
+void DcsMotionScatterCS(uint3 thread_id : SV_DispatchThreadID) {
+    if (thread_id.x >= OutputWidth || thread_id.y >= OutputHeight) {
+        return;
+    }
+    float4 cell = MotionResampled.Load(int4(thread_id.xy, Slice * 3u, 0));
+    uint klass = uint(cell.z + 0.5);
+    uint flags = uint(cell.w + 0.5);
+    // Edge cells of a surface (an MV, not the sky, a G-buffer composition).
+    if ((flags & 3u) == 1u && (klass & 0x80u) == 0u && (klass & 7u) <= 4u) {
+        uint priority = (klass & 7u) == 1u ? 2u : 1u;
+        uint key = (priority << kScatterIndexBits) | (thread_id.y * OutputWidth + thread_id.x);
+        float2 pixel = TargetRect.xy + (float2(thread_id.xy) + 0.5) * float(Cell) - 0.5;
+        [unroll] for (uint output = 0u; output < 2u; ++output) {
+            if (output < Outputs) {
+                float t = output == 0u ? Fraction0 : Fraction1;
+                // The content of current pixel c is at c + (1 - t) * motion at t.
+                float2 at = (pixel + (1.0 - t) * cell.xy - TargetRect.xy + 0.5) / float(Cell) - 0.5;
+                int2 base = int2(floor(at));
+                [unroll] for (uint corner = 0u; corner < 4u; ++corner) {
+                    int2 target = base + int2(corner & 1u, corner >> 1);
+                    if (all(target >= 0) && target.x < int(OutputWidth) && target.y < int(OutputHeight)) {
+                        InterlockedMax(ScatterTarget[uint3(target, Slice * 2u + output)], key);
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/src/d3d12/frame_synthesis.hlsl b/src/d3d12/frame_synthesis.hlsl
