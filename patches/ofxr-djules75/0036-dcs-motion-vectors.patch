+            for (UINT bucket = 0; bucket < kDcsMotionCounterBuckets; ++bucket) {
+                values[0] += words[bucket * 2U];
+                values[1] += words[bucket * 2U + 1U];
+            }
+            if (slot.motion_order > dcs_motion_harvested_order) {
+                const std::uint32_t pixels = values[0] - dcs_motion_harvested[0];
+                const std::uint32_t fallbacks = values[1] - dcs_motion_harvested[1];
+                if (pixels < 0x80000000U && fallbacks < 0x80000000U) {
+                    dcs_motion_harvested = values;
+                    dcs_motion_harvested_order = slot.motion_order;
+                    dcs_motion_window_pixels += pixels;
+                    dcs_motion_window_fallbacks += fallbacks;
