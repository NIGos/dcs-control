+// DCS Control (0103): the composed size without a recommended view size. A
+// field of view that is not finite gives the periphery image's size, never a
+// NaN through std::clamp and std::lround (a 2^31 or 0 wide swapchain).
+bool composed_size_checks() {
+    const double nan = std::numeric_limits<double>::quiet_NaN();
