+// DCS Control (0103): one side of the composed image when the runtime gives no
+// recommended view size: the periphery's span (a difference of tangents) at the
+// focus layer's pixel density, times `scale`, never smaller than the periphery
+// image (nor 16), at most 8192. A span that is not finite (a field of view that
+// is not) counts as none: the periphery image's own size, never a NaN reaching
+// std::clamp and std::lround.
+[[nodiscard]] inline std::uint32_t foveated_composed_side(double periphery_span, double focus_span,
+    std::int32_t focus_pixels, std::int32_t periphery_pixels, double scale) noexcept {
+    const double low = static_cast<double>(std::clamp(periphery_pixels, 16, 8192));
+    double pixels = std::isfinite(periphery_span) && std::isfinite(focus_span) && focus_span > 1.0e-6
+        ? periphery_span / focus_span * focus_pixels * scale
+        : 0.0;
+    if (!std::isfinite(pixels)) pixels = 0.0;
+    return static_cast<std::uint32_t>(std::lround(std::clamp(pixels, low, 8192.0)));
+}
+
 } // namespace xrfg
