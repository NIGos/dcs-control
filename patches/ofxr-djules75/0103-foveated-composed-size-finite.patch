+             Case{3.2, 0.8, 1952, 1076, 0.5, 3904, "50 % scale"}, Case{3.2, 0.1, 1952, 1076, 1.0, 8192, "at most 8192"},
+             Case{0.4, 0.8, 1952, 1076, 1.0, 1076, "never below the periphery"}, Case{3.2, 0.0, 1952, 1076, 1.0, 1076, "no focus span"},
+             Case{nan, 0.8, 1952, 1076, 1.0, 1076, "periphery span NaN"}, Case{inf, 0.8, 1952, 1076, 1.0, 1076, "periphery span infinite"},
+             Case{3.2, nan, 1952, 1076, 1.0, 1076, "focus span NaN"}, Case{3.2, inf, 1952, 1076, 1.0, 1076, "focus span infinite"},
+             Case{-inf, 0.8, 1952, 1076, 1.0, 1076, "periphery span -infinite"}, Case{3.2, 0.8, 1952, 9000, 1.0, 8192, "periphery over 8192"},
+             Case{3.2, 0.8, 1952, 8, 0.001, 16, "at least 16"}}) {
