+// DCS Control (0044): the export off (header_flags::active clear) with the
+// generation the reader opened, in its process and on its adapter: the
+// producer keeps its textures, fences and NT handles while off and
+// republishes the same generation when on again, so the opened set is kept
+// (nothing paired or copied while off) and never imported again. Every
+// import of a shared NT handle (D3D11 or D3D12 reader, the same allocation or
+// a new one) adds its size to the process's "Dedicated Usage" for good, even
+// once released (xrfg_cockpit_mask_import_bench); the memory itself is freed.
+template <typename Header>
+[[nodiscard]] bool inactive_same_generation(const Header& header, std::uint32_t magic, std::uint32_t version,
+    std::uint32_t active, std::uint32_t generation, DWORD process_id, std::uint64_t adapter_luid) noexcept {
+    return header.magic == magic && header.version == version && (header.flags & active) == 0 &&
+        header.generation != 0 && header.generation == generation && header.ownerPid == process_id &&
+        header.adapterLuid == adapter_luid;
+}
+
 }  // namespace
 
