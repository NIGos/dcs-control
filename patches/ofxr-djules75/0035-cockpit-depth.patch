+            "depth: the cockpit camera is DCS's pose less the dual camera's shift");
+        require(left.jitter_known && left.jitter_px[0] == 0.25F && left.jitter_px[1] == -0.375F,
+            "depth: the jitter is carried");
+        // The cockpit camera's move from the left eye's camera to the right
+        // one's (tracking +0.06 x, +0.026 z), in the right camera's frame
+        // (turned 90 degrees about y: its +z is tracking +x, its +x tracking
+        // -z).
+        xrfg::Vec3 delta{};
+        require(xrfg::cockpit_camera_delta(frame->depth_views[0], frame->depth_views[1], delta) &&
+                std::abs(delta.x + 0.026F) < 1.0e-4F && std::abs(delta.z - 0.06F) < 1.0e-4F &&
+                std::abs(delta.y) < 1.0e-5F,
+            "depth: the camera move in the current camera's frame");
+        // One fence: the copy waits for the mask's seq, then holds both.
+        Sleep(50);
+        require(frame->ready_fence->GetCompletedValue() < frame->ready_value,
+            "depth: the copy waits for the shared fence");
+        producer.signal(seq);
+        gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+        require(gpu.readback(frame->depth_texture.Get(), 4) == depth.pattern_, "depth: the copy holds the slot");
+        require(gpu.readback(frame->texture.Get()) == producer.last_pattern_, "depth: the mask copy is unchanged");
+        gpu.wait(producer.release_fence_.Get(), seq);
+        frame.reset();
+
+        const auto expect_no_depth = [&](xrfg::CockpitDepthLookup reason, const char* what) {
+            require(consumer.stats().depth_last == reason, std::string("depth: ") + what + " is not reported");
+        };
+        // Another seq in the same slot: not this frame's depth.
+        seq = producer.commit(6100, 255);
+        depth.commit(producer);
+        depth.header_.slot[producer.header_.newestSlot].seq = seq + 7;
+        depth.publish();
+        auto unpaired = consumer.acquire(6100);
+        require(unpaired != nullptr && !unpaired->depth, "depth: another seq gives the mask alone");
+        expect_no_depth(xrfg::CockpitDepthLookup::unpaired, "a seq mismatch");
+        unpaired.reset(); // the ring holds six
+        producer.signal(seq);
+        // A late commit: no poses.
+        seq = producer.commit(6200, 255);
+        depth.commit(producer, cd::slot_flags::valid | cd::slot_flags::display_time | cd::slot_flags::late_commit);
+        auto late = consumer.acquire(6200);
+        require(late != nullptr && !late->depth, "depth: a late commit gives the mask alone");
+        expect_no_depth(xrfg::CockpitDepthLookup::late_commit, "a late commit");
+        late.reset(); // the ring holds six
+        producer.signal(seq);
+        // The mask slot without the depth bit.
+        seq = producer.commit(6300, 255);
+        depth.commit(producer);
+        producer.header_.slot[producer.header_.newestSlot].flags &= ~cm::slot_flags::depth;
+        producer.publish();
+        auto unflagged = consumer.acquire(6300);
+        require(unflagged != nullptr && !unflagged->depth, "depth: a mask slot without the depth bit");
+        expect_no_depth(xrfg::CockpitDepthLookup::unpaired, "a mask slot without the bit");
+        unflagged.reset(); // the ring holds six
+        producer.signal(seq);
+        // Another generation than the mask's.
+        seq = producer.commit(6400, 255);
+        depth.header_.generation += 1;
+        depth.commit(producer);
+        auto other_generation = consumer.acquire(6400);
+        require(other_generation != nullptr && !other_generation->depth, "depth: another generation");
+        expect_no_depth(xrfg::CockpitDepthLookup::generation_mismatch, "another generation");
+        depth.header_.generation -= 1;
+        other_generation.reset(); // the ring holds six
+        producer.signal(seq);
+        // Another fence than the mask's.
+        seq = producer.commit(6500, 255);
+        depth.header_.fenceHandle += 4;
+        depth.commit(producer);
+        auto other_fence = consumer.acquire(6500);
+        require(other_fence != nullptr && !other_fence->depth, "depth: another fence");
+        expect_no_depth(xrfg::CockpitDepthLookup::fence_mismatch, "another fence");
+        depth.header_.fenceHandle -= 4;
+        other_fence.reset(); // the ring holds six
+        producer.signal(seq);
+        // Idle (a heartbeat not fresh at the producer).
+        seq = producer.commit(6600, 255);
+        depth.header_.flags |= cd::header_flags::idle;
+        depth.commit(producer);
+        auto idle = consumer.acquire(6600);
+        require(idle != nullptr && !idle->depth, "depth: an idle producer");
+        expect_no_depth(xrfg::CockpitDepthLookup::idle, "an idle producer");
+        depth.header_.flags &= ~cd::header_flags::idle;
+        idle.reset(); // the ring holds six
+        producer.signal(seq);
+        // And paired again.
+        seq = producer.commit(6700, 255);
+        depth.commit(producer);
+        auto again = consumer.acquire(6700);
+        require(again != nullptr && again->depth, "depth: paired again");
+        producer.signal(seq);
+        gpu.wait(again->ready_fence.Get(), again->ready_value);
+        require(consumer.stats().depth_misses == 6 && consumer.stats().depth_generations_opened == 1,
+            "depth: the misses and the generation opened");
+        require(std::find(logged.begin(), logged.end(), 10) != logged.end(), "depth: the textures opened (result=10)");
+    }
+    require(producer.reader_heartbeat() == 0 && depth.reader_heartbeat() == 0,
+        "depth: both heartbeats are cleared when the consumer goes");
+
+    // [ofxr] cockpit_depth off: the depth block is not even opened.
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, test_options(suffix)), "consumer initialize");
+        const std::uint64_t seq = producer.commit(6800, 255);
+        depth.commit(producer);
+        auto frame = consumer.acquire(6800);
+        require(frame != nullptr && !frame->depth, "depth off: the mask alone");
+        require(consumer.stats().depth_last == xrfg::CockpitDepthLookup::off && depth.reader_heartbeat() == 0,
+            "depth off: no depth heartbeat");
+        producer.signal(seq);
+        gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    }
+    std::cout << "cockpit depth: pairing (slot, seq, generation, fence), late commits, idle, both heartbeats\n";
+}
