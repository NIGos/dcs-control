+// DCS Control (0035): the cockpit depth (R68 Stage 1, contract
+// xrfg/dcsvr_cockpit_depth.h). DCS Control's engine module writes, beside
+// each frame's cockpit mask and on the same grid, the cockpit's linear depth
+// (metres along the view axis; the nearest cockpit texel of each mask texel,
+// 0 where it has none) and the camera DCS drew that frame's cockpit from.
+// The cockpit is rigid and still in tracking space, so with the depth of both
+// real frames a cockpit pixel's position at any instant between them is a
+// closed-form function of the two cameras: the synthesis reprojects the
+// masked pixels in 6DoF (frame_synthesis.hlsl, XRFG_COCKPIT_DEPTH) instead of
+// 0034's same-pixel rule and parallax gate, which remain the fallback. One
+// eye's depth view of a frame: the cockpit camera's orientation and centre
+// (DCS's own submitted pose, its dual-camera shift taken off; tracking space
+// of the frame's XrSpace) and DLSS's jitter (render texels; for the record
+// only: the rect's tangents come from DCS's jittered projection, so the depth
+// texels are already where the jittered render put them).
+struct D3D12CockpitDepthView {
+    bool valid{};
+    Quaternion orientation{};
+    Vec3 cockpit_position{};
+    bool jitter_known{};
+    std::array<float, 2> jitter_px{};
 };
 
+namespace cockpit_mask_detail {
+[[nodiscard]] inline bool finite(const Vec3& v) noexcept {
+    return std::isfinite(v.x) && std::isfinite(v.y) && std::isfinite(v.z);
+}
+}  // namespace cockpit_mask_detail
+
+// DCS Control (0035): the cockpit camera's move from `previous` to `current`
+// (both frames' depth views of one eye), in the current camera's own frame
+// (OpenXR axes: x right, y up, z back), metres. The synthetic's target camera
+// at instant t has the current orientation and the centre
+// lerp(previous, current, t) (R68 answer 2), so a frame's camera sits
+// (1 - t) * delta (current) or -t * delta (previous) from it. False where
+// either view is unusable.
+[[nodiscard]] inline bool cockpit_camera_delta(const D3D12CockpitDepthView& previous,
+    const D3D12CockpitDepthView& current, Vec3& delta) noexcept {
+    delta = {};
+    if (!previous.valid || !current.valid || !cockpit_mask_detail::finite(previous.cockpit_position) ||
+        !cockpit_mask_detail::finite(current.cockpit_position)) {
+        return false;
+    }
+    const Quaternion& o = current.orientation;
+    const float length_squared = o.x * o.x + o.y * o.y + o.z * o.z + o.w * o.w;
+    if (!(length_squared > 1.0e-6F) || !std::isfinite(length_squared)) {
+        return false;
+    }
+    const Quaternion q = cockpit_mask_detail::unit(o);
+    const Quaternion inverse{-q.x, -q.y, -q.z, q.w};
+    const Vec3 moved{current.cockpit_position.x - previous.cockpit_position.x,
+        current.cockpit_position.y - previous.cockpit_position.y,
+        current.cockpit_position.z - previous.cockpit_position.z};
+    delta = cockpit_mask_detail::rotate(inverse, moved);
+    // More than a metre between two real frames is not a head.
+    return cockpit_mask_detail::finite(delta) &&
+        delta.x * delta.x + delta.y * delta.y + delta.z * delta.z < 1.0F;
+}
