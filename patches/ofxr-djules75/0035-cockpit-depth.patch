+        header_.flags = cd::header_flags::active | cd::header_flags::fence | cd::header_flags::reader_heartbeat |
+            cd::header_flags::shares_mask_fence;
+        header_.generation = mask.header_.generation;
+        header_.slotCount = cd::slot_count;
+        header_.format = cd::format_r16g16_float;
+        header_.atlasW = kAtlasWidth;
+        header_.atlasH = kAtlasHeight;
