+// DCS Control (0035): the cockpit depth on the composition. A scene drawn
+// exactly (ray traced, per eye, from each camera): a textured cockpit bar on
+// a plane 0.5 m ahead, a sill 0.7 m ahead, and a textured world 5 m away;
+// three cameras per eye: the previous capture's, the current one's and the
+// true middle frame's (the current orientation, the centre halfway: R68's
+// target camera). Masks and depth as DCS Control's engine module shares them
+// (the mask max-filtered, the depth the nearest cockpit depth per texel of
+// `divisor` x `divisor` pixels, R16G16_FLOAT), and per eye the camera.
+std::uint16_t depth_test_half(float value) {
+    if (!(value > 0.0F)) {
+        return 0;
+    }
+    std::uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const int exponent = static_cast<int>((bits >> 23) & 0xffU) - 127 + 15;
+    const std::uint32_t mantissa = bits & 0x7fffffU;
+    if (exponent >= 31) {
+        return 0x7bffU; // 65504, the contract's sky
+    }
+    if (exponent <= 0) {
+        return 0;
+    }
+    std::uint32_t half = (static_cast<std::uint32_t>(exponent) << 10) | (mantissa >> 13);
+    const std::uint32_t rest = mantissa & 0x1fffU;
+    if (rest > 0x1000U || (rest == 0x1000U && (half & 1U) != 0U)) {
+        ++half;
+    }
+    return static_cast<std::uint16_t>(half);
+}
+
+struct CockpitDepthScene {
+    StereoPattern image;
+    // Per eye and pixel: the cockpit's depth along the view axis (0: the
+    // world), and every pixel's depth.
+    std::array<std::vector<float>, kEyeCount> cockpit;
+    std::array<std::vector<float>, kEyeCount> depth;
+};
+
+xrfg::Vec3 depth_test_rotate(const xrfg::Quaternion& q, const xrfg::Vec3& v) {
+    const xrfg::Vec3 c1{q.y * v.z - q.z * v.y + q.w * v.x, q.z * v.x - q.x * v.z + q.w * v.y,
+        q.x * v.y - q.y * v.x + q.w * v.z};
+    return {v.x + 2.0F * (q.y * c1.z - q.z * c1.y), v.y + 2.0F * (q.z * c1.x - q.x * c1.z),
+        v.z + 2.0F * (q.x * c1.y - q.y * c1.x)};
+}
+
+// The bar spans x from bar_left to bar_right (metres).
+CockpitDepthScene cockpit_depth_scene(UINT width, UINT height, const ReprojectionViews& views,
+    float bar_left = -0.035F, float bar_right = 0.005F) {
+    CockpitDepthScene scene;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& view = views[eye];
+        const double left = std::tan(view.fov.angle_left), right = std::tan(view.fov.angle_right);
+        const double up = std::tan(view.fov.angle_up), down = std::tan(view.fov.angle_down);
+        auto& bytes = scene.image[eye];
+        bytes.resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        scene.cockpit[eye].assign(static_cast<std::size_t>(width) * height, 0.0F);
+        scene.depth[eye].assign(static_cast<std::size_t>(width) * height, 0.0F);
+        const xrfg::Vec3 c = view.pose.position;
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const double tx = left + (x + 0.5) / width * (right - left);
+                const double ty = up - (y + 0.5) / height * (up - down);
+                const xrfg::Vec3 d = depth_test_rotate(
+                    view.pose.orientation, {static_cast<float>(tx), static_cast<float>(ty), -1.0F});
+                // The plane z = -plane: its ray parameter is the depth along
+                // the view axis (d's component along the axis is 1).
+                const auto hit = [&](double plane, double& px, double& py) {
+                    const double s = (-plane - c.z) / d.z;
+                    px = c.x + s * d.x;
+                    py = c.y + s * d.y;
+                    return s;
+                };
+                double px = 0.0, py = 0.0;
+                std::array<std::uint8_t, 3> texel{};
+                double depth = hit(0.5, px, py);
+                bool cockpit = px >= bar_left && px < bar_right && py > -0.2 && py < 0.2;
+                if (cockpit) {
+                    texel = occlusion_texture(px * 2400.0, py * 2400.0, 1);
+                } else {
+                    depth = hit(0.7, px, py);
+                    cockpit = py >= -0.13 && py < -0.07;
+                    if (cockpit) {
+                        texel = occlusion_texture(px * 2400.0 + 500.0, py * 2400.0, 1);
+                    } else {
+                        depth = hit(5.0, px, py);
+                        texel = occlusion_texture(px * 240.0, py * 240.0, 0);
+                    }
+                }
+                const std::size_t at = static_cast<std::size_t>(y) * width + x;
+                scene.cockpit[eye][at] = cockpit ? static_cast<float>(depth) : 0.0F;
+                scene.depth[eye][at] = static_cast<float>(depth);
+                bytes[at * kBytesPerPixel] = texel[0];
+                bytes[at * kBytesPerPixel + 1] = texel[1];
+                bytes[at * kBytesPerPixel + 2] = texel[2];
+                bytes[at * kBytesPerPixel + 3] = 255;
+            }
+        }
+    }
+    return scene;
+}
+
+ComPtr<ID3D12Resource> upload_depth_test_texture(D3D12WarpFixture& fixture, UINT width, UINT height,
+    DXGI_FORMAT format, UINT texel_bytes, const std::vector<std::uint8_t>& bytes) {
+    ComPtr<ID3D12Resource> texture;
+    const D3D12_HEAP_PROPERTIES heap = heap_properties(D3D12_HEAP_TYPE_DEFAULT);
+    D3D12_RESOURCE_DESC description{};
+    description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    description.Width = width;
+    description.Height = height;
+    description.DepthOrArraySize = 1;
+    description.MipLevels = 1;
+    description.Format = format;
+    description.SampleDesc.Count = 1;
+    require_hresult(fixture.device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &description,
+                        D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(texture.GetAddressOf())),
+        "cockpit depth test texture");
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout{};
+    UINT rows = 0;
+    UINT64 row_size = 0, total = 0;
+    fixture.device()->GetCopyableFootprints(&description, 0, 1, 0, &layout, &rows, &row_size, &total);
+    ComPtr<ID3D12Resource> upload =
+        create_buffer(fixture, D3D12_HEAP_TYPE_UPLOAD, total, D3D12_RESOURCE_STATE_GENERIC_READ);
+    std::uint8_t* mapped = nullptr;
+    require_hresult(upload->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "cockpit depth test upload");
+    for (UINT y = 0; y < rows; ++y) {
+        std::memcpy(mapped + layout.Offset + static_cast<std::size_t>(y) * layout.Footprint.RowPitch,
+            bytes.data() + static_cast<std::size_t>(y) * width * texel_bytes, static_cast<std::size_t>(width) * texel_bytes);
+    }
+    upload->Unmap(0, nullptr);
+    fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+        D3D12_TEXTURE_COPY_LOCATION destination{};
+        destination.pResource = texture.Get();
+        destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION source{};
+        source.pResource = upload.Get();
+        source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        source.PlacedFootprint = layout;
+        list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+    });
+    return texture;
+}
+
+// The frame's mask (and, with `with_depth`, its depth and cameras) as the
+// consumer hands it on: both eyes side by side, complete at once.
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> make_cockpit_depth_frame(D3D12WarpFixture& fixture, UINT width,
+    UINT height, const CockpitDepthScene& scene, UINT divisor, const ReprojectionViews& views, bool with_depth,
+    const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters = {}) {
+    const UINT mask_width = (width + divisor - 1U) / divisor;
+    const UINT mask_height = (height + divisor - 1U) / divisor;
+    const UINT atlas_width = mask_width * kEyeCount;
+    std::vector<std::uint8_t> mask(static_cast<std::size_t>(atlas_width) * mask_height, 0);
+    std::vector<std::uint8_t> depth(static_cast<std::size_t>(atlas_width) * mask_height * 4U, 0);
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (UINT row = 0; row < mask_height; ++row) {
+            for (UINT column = 0; column < mask_width; ++column) {
+                float nearest = 0.0F, farthest = 0.0F;
+                for (UINT y = row * divisor; y < std::min(height, (row + 1U) * divisor); ++y) {
+                    for (UINT x = column * divisor; x < std::min(width, (column + 1U) * divisor); ++x) {
+                        const std::size_t at = static_cast<std::size_t>(y) * width + x;
+                        const float cockpit = scene.cockpit[eye][at];
+                        if (cockpit > 0.0F && (nearest == 0.0F || cockpit < nearest)) {
+                            nearest = cockpit;
+                        }
+                        farthest = std::max(farthest, scene.depth[eye][at]);
+                    }
+                }
+                const std::size_t texel = static_cast<std::size_t>(row) * atlas_width + eye * mask_width + column;
+                mask[texel] = nearest > 0.0F ? 255 : 0;
+                const std::uint16_t x = depth_test_half(nearest), y = depth_test_half(farthest);
+                std::memcpy(&depth[texel * 4U], &x, 2);
+                std::memcpy(&depth[texel * 4U + 2U], &y, 2);
+            }
+        }
+    }
+    auto frame = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+    frame->texture = upload_depth_test_texture(fixture, atlas_width, mask_height, DXGI_FORMAT_R8_UNORM, 1, mask);
+    require_hresult(fixture.device()->CreateFence(1, D3D12_FENCE_FLAG_NONE,
+                        IID_PPV_ARGS(frame->ready_fence.GetAddressOf())),
+        "cockpit depth test fence");
+    frame->ready_value = 1;
+    frame->counters = counters;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        auto& view = frame->views[eye];
+        view.valid = true;
+        view.x = eye * mask_width;
+        view.y = 0;
+        view.width = mask_width;
+        view.height = mask_height;
+        view.fov_tan = {left, left + (right - left) * float(mask_width * divisor) / float(width), up,
+            up - (up - down) * float(mask_height * divisor) / float(height)};
+    }
+    if (with_depth) {
+        frame->depth_texture =
+            upload_depth_test_texture(fixture, atlas_width, mask_height, DXGI_FORMAT_R16G16_FLOAT, 4, depth);
+        frame->depth = true;
+        frame->depth_space = 0x5ace;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            frame->depth_views[eye].valid = true;
+            frame->depth_views[eye].orientation = views[eye].pose.orientation;
+            frame->depth_views[eye].cockpit_position = views[eye].pose.position;
+        }
+    }
+    return frame;
+}
+
+// The cameras of one pair (previous, current, the true middle) for a head
+// that moved: both eyes 64 mm apart about a pivot `pivot_back` metres behind
+// them, turned by `yaw` radians (previous -yaw/2, current +yaw/2) and moved by
+// `lean` metres along x (previous -lean/2, current +lean/2); every view's
+// tangents +-tan_x x +-tan_y.
+std::array<ReprojectionViews, 3> cockpit_depth_cameras(
+    float yaw, float pivot_back, float lean, float tan_x = 0.3F, float tan_y = 0.225F) {
+    std::array<ReprojectionViews, 3> cameras{};
+    for (int which = 0; which < 3; ++which) {
+        ReprojectionViews views = make_reprojection_views();
+        const float side = which == 0 ? -0.5F : 0.5F;
+        const float angle = yaw * side;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            auto& view = views[eye];
+            view.fov.angle_left = std::atan(-tan_x);
+            view.fov.angle_right = std::atan(tan_x);
+            view.fov.angle_up = std::atan(tan_y);
+            view.fov.angle_down = std::atan(-tan_y);
+            view.pose.orientation = {0.0F, std::sin(angle * 0.5F), 0.0F, std::cos(angle * 0.5F)};
+            const xrfg::Vec3 arm = depth_test_rotate(
+                view.pose.orientation, {eye == 0 ? -0.032F : 0.032F, 0.0F, -pivot_back});
+            view.pose.position = {arm.x + lean * side, arm.y, arm.z + pivot_back};
+        }
+        cameras[static_cast<std::size_t>(which)] = views;
+    }
+    // The middle: the current orientation, the centre halfway.
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        auto& middle = cameras[2][eye];
+        middle.pose.orientation = cameras[1][eye].pose.orientation;
+        const xrfg::Vec3 a = cameras[0][eye].pose.position, b = cameras[1][eye].pose.position;
+        middle.pose.position = {(a.x + b.x) * 0.5F, (a.y + b.y) * 0.5F, (a.z + b.z) * 0.5F};
+    }
+    return cameras;
+}
+
+// The mean absolute error and the 99th percentile of the largest channel
+// error where `where` (per eye and pixel) holds, inside a 32 px margin.
+struct DepthTestError {
+    double mae{};
+    int p99{};
+    std::size_t pixels{};
+};
+
+DepthTestError depth_test_error(const StereoPattern& image, const StereoPattern& truth, UINT width, UINT height,
+    const std::function<bool(UINT, UINT, UINT)>& where) {
+    DepthTestError error;
+    std::vector<int> worst;
+    double total = 0.0;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        // The margin of the other tests: where the previous frame does not
+        // cover a pixel (a head turn) it is the current frame's, depth or not.
+        for (UINT y = 32; y + 32 < height; ++y) {
+            for (UINT x = 32; x + 32 < width; ++x) {
+                if (!where(eye, x, y)) continue;
+                const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                int largest = 0;
+                for (UINT c = 0; c < 3; ++c) {
+                    const int e = std::abs(int(image[eye][i + c]) - int(truth[eye][i + c]));
+                    total += e;
+                    largest = std::max(largest, e);
+                }
+                worst.push_back(largest);
+            }
+        }
+    }
+    error.pixels = worst.size();
+    if (!worst.empty()) {
+        error.mae = total / (3.0 * double(worst.size()));
+        std::sort(worst.begin(), worst.end());
+        error.p99 = worst[std::min(worst.size() - 1, worst.size() * 99 / 100)];
+    }
+    return error;
+}
+
+// DCS Control (0035): 0034's composition (the masks alone) against 0035's
+// (the masks with depth) for one head motion, against the true middle frame.
+// Without [ofxr] cockpit_depth, or with it but frames without depth, the
+// composition is byte for byte 0034's. With depth the cockpit's interior
+// (its pixels three mask texels from any edge in the middle frame) is the
+// true middle frame within the texture's own bilinear sampling, far closer
+// than 0034's; every cockpit pixel is no further than 0034's on average (its
+// edges are composed as 0034 does); the world is no worse; and the counters
+// saw one pair and its pixels.
+void test_cockpit_depth_motion(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const char* label, float yaw, float pivot_back, float lean) {
+    constexpr UINT width = 320, height = 240, divisor = 2;
+    const auto cameras = cockpit_depth_cameras(yaw, pivot_back, lean);
+    const CockpitDepthScene previous = cockpit_depth_scene(width, height, cameras[0]);
+    const CockpitDepthScene current = cockpit_depth_scene(width, height, cameras[1]);
+    const CockpitDepthScene middle = cockpit_depth_scene(width, height, cameras[2]);
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    const auto mask_previous = make_cockpit_depth_frame(fixture, width, height, previous, divisor, cameras[0], false);
+    const auto mask_current = make_cockpit_depth_frame(fixture, width, height, current, divisor, cameras[1], false);
+    const auto depth_previous =
+        make_cockpit_depth_frame(fixture, width, height, previous, divisor, cameras[0], true, counters);
+    const auto depth_current =
+        make_cockpit_depth_frame(fixture, width, height, current, divisor, cameras[1], true, counters);
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    const auto run = [&](const std::shared_ptr<xrfg::D3D12CockpitMaskFrame>& a,
+                         const std::shared_ptr<xrfg::D3D12CockpitMaskFrame>& b, bool depth_session) {
+        xrfg::D3D12NvidiaOpticalFlowOptions session = options;
+        session.cockpit_depth = depth_session;
+        return synthesize_nvidia_pair(fixture, previous.image, current.image, width, height, session, {a, b},
+            backend, true, &cameras[0], &cameras[1]);
+    };
+    const StereoPattern masked = run(mask_previous, mask_current, false);
+    require(run(depth_previous, depth_current, false) == masked,
+        "cockpit depth: depth is used although [ofxr] cockpit_depth is off");
+    require(run(mask_previous, mask_current, true) == masked,
+        "cockpit depth: frames without depth do not compose as 0034");
+    require(counters->depth_pairs.load() == 0, "cockpit depth: a pair counted without depth");
+    const StereoPattern with_depth = run(depth_previous, depth_current, true);
+    require(counters->depth_pairs.load() == 1 && counters->depth_pixels.load() > 0,
+        "cockpit depth: the pair and its pixels are not counted");
+    // The middle frame's cockpit, its interior, and the world.
+    const auto cockpit_at = [&](UINT eye, UINT x, UINT y) {
+        return middle.cockpit[eye][static_cast<std::size_t>(y) * width + x] > 0.0F;
+    };
+    const int reach = static_cast<int>(divisor) * 3;
+    const auto interior_at = [&](UINT eye, UINT x, UINT y) {
+        for (int dy = -reach; dy <= reach; ++dy) {
+            for (int dx = -reach; dx <= reach; ++dx) {
+                const int sx = std::clamp(int(x) + dx, 0, int(width) - 1);
+                const int sy = std::clamp(int(y) + dy, 0, int(height) - 1);
+                const float here = middle.cockpit[eye][static_cast<std::size_t>(y) * width + x];
+                const float there = middle.cockpit[eye][static_cast<std::size_t>(sy) * width + sx];
+                if (here <= 0.0F || there <= 0.0F || std::abs(there - here) > 0.05F) return false;
+            }
+        }
+        return true;
+    };
+    const auto world_at = [&](UINT eye, UINT x, UINT y) { return !cockpit_at(eye, x, y); };
+    const DepthTestError interior_masked = depth_test_error(masked, middle.image, width, height, interior_at);
+    const DepthTestError interior_depth = depth_test_error(with_depth, middle.image, width, height, interior_at);
+    const DepthTestError cockpit_masked = depth_test_error(masked, middle.image, width, height, cockpit_at);
+    const DepthTestError cockpit_depth = depth_test_error(with_depth, middle.image, width, height, cockpit_at);
+    const DepthTestError world_masked = depth_test_error(masked, middle.image, width, height, world_at);
+    const DepthTestError world_depth = depth_test_error(with_depth, middle.image, width, height, world_at);
+    std::cout << "cockpit depth (" << (backend == xrfg::D3D12OpticalFlowBackend::nvidia ? "NVIDIA" : "FidelityFX")
+              << ", " << label << "): cockpit interior mae " << interior_depth.mae << " p99 " << interior_depth.p99
+              << " (0034: mae " << interior_masked.mae << " p99 " << interior_masked.p99 << ", "
+              << interior_depth.pixels << " px); every cockpit pixel mae " << cockpit_depth.mae << " p99 "
+              << cockpit_depth.p99 << " (0034: mae " << cockpit_masked.mae << " p99 " << cockpit_masked.p99
+              << "); the world mae " << world_depth.mae << " (0034: " << world_masked.mae << "); counted "
+              << counters->depth_pixels.load() << " px with depth, " << counters->depth_fallback_pixels.load()
+              << " without" << std::endl;
+    require(interior_depth.pixels > 1000, "cockpit depth: the scene has no cockpit interior");
+    require(interior_depth.mae <= 1.5 && interior_depth.p99 <= 6,
+        "cockpit depth: the cockpit's interior is not the true middle frame");
+    // (Much closer with a flow that misses the cockpit's parallax; on the
+    // optical-flow engine 0034 can be close already for a head turn.)
+    require(interior_depth.mae <= interior_masked.mae + 0.01,
+        "cockpit depth: the cockpit's interior is further from the middle frame than 0034's");
+    require(cockpit_depth.mae <= cockpit_masked.mae, "cockpit depth: the cockpit is further from the middle frame");
+    require(world_depth.mae <= world_masked.mae * 1.02 + 0.01, "cockpit depth: the world is worse");
+}
+
+void test_cockpit_depth_composition(D3D12WarpFixture& fixture,
+    xrfg::D3D12OpticalFlowBackend backend = xrfg::D3D12OpticalFlowBackend::fidelity_fx) {
+    // R68's normal lean: 0.3 m/s, a pair in 2X at 90 Hz (22.2 ms): 6.7 mm.
+    test_cockpit_depth_motion(fixture, backend, "lean 0.3 m/s", 0.0F, 0.0F, 0.3F * 2.0F / 90.0F);
+    // A head turn at 100 deg/s about a neck 9 cm behind the eyes: 2.2 deg
+    // and, at the eyes, 3.5 mm a pair.
+    test_cockpit_depth_motion(fixture, backend, "yaw 100 deg/s, neck pivot",
+        100.0F * 3.14159265F / 180.0F * 2.0F / 90.0F, 0.09F, 0.0F);
+}
+
+// DCS Control (0035): the cockpit depth's GPU cost on hardware at a headset's
+// eye image (XRFG_TEST_COCKPIT_DEPTH_BENCH). Two synthesizers on the same
+// frames, interleaved pair by pair: the masks alone (0034) and the masks with
+// depth; a head leaning at 0.3 m/s (2X at 90 Hz), 46 px per degree at the
+// centre, a cockpit covering about half of each eye, mask and depth texels
+// of 18 px (the periphery's /2 at 5424 px). The composition's time includes
+// the resample (and the depth's), as the layer logs it.
+void bench_cockpit_depth_composition(D3D12WarpFixture& fixture, UINT width, UINT height) {
+    constexpr UINT kFrames = 3;
+    constexpr int kPairs = 240;
+    constexpr UINT kDivisor = 18;
+    const float tan_x = float(width) * 0.5F / 2636.0F;
+    const float tan_y = float(height) * 0.5F / 2636.0F;
+    const auto pair = cockpit_depth_cameras(0.0F, 0.0F, 0.3F * 2.0F / 90.0F, tan_x, tan_y);
+    // Frames A, B, A: every pair moves the head the same distance.
+    const std::array<const ReprojectionViews*, kFrames> cameras{&pair[0], &pair[1], &pair[0]};
+    std::array<CockpitDepthScene, kFrames> scenes{};
+    scenes[0] = cockpit_depth_scene(width, height, pair[0], -0.45F, 0.05F);
+    scenes[1] = cockpit_depth_scene(width, height, pair[1], -0.45F, 0.05F);
+    scenes[2] = scenes[0];
+    struct Pipeline {
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{};
+        std::array<ComPtr<ID3D12Resource>, 1> synthetics{};
+        std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+        std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+        std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, kFrames> masks{};
+        std::vector<std::uint64_t> composition;
+    };
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    std::array<Pipeline, 2> pipelines{};
+    for (UINT index = 0; index < pipelines.size(); ++index) {
+        Pipeline& pipeline = pipelines[index];
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            pipeline.sources[frame] = create_source_texture(fixture, width, height);
+            upload_pattern(fixture, pipeline.sources[frame].Get(), scenes[frame].image);
+            pipeline.masks[frame] = make_cockpit_depth_frame(
+                fixture, width, height, scenes[frame], kDivisor, *cameras[frame], index == 1, counters);
+        }
+        for (auto& c : pipeline.currents) c = create_source_texture(fixture, width, height);
+        for (auto& s : pipeline.synthetics) s = create_source_texture(fixture, width, height);
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = pipeline.sources[i].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+        std::array<ID3D12Resource*, 1> synthetic_pointers{pipeline.synthetics[0].Get()};
+        pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(pipeline.history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "depth bench: history");
+        xrfg::D3D12NvidiaOpticalFlowOptions options{};
+        options.cockpit_mask = true;
+        options.cockpit_depth = index == 1;
+        pipeline.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(pipeline.synthesizer->initialize(fixture.device(), fixture.queue(),
+                    pipeline.history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "depth bench: synthesizer");
+    }
+    for (int frame = 0; frame <= kPairs; ++frame) {
+        const UINT slot = static_cast<UINT>(frame) % kFrames;
+        for (UINT index = 0; index < pipelines.size(); ++index) {
+            Pipeline& pipeline = pipelines[index];
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require(operation_succeeded(pipeline.history->capture(slot, &capture)) &&
+                        operation_succeeded(pipeline.history->commit(capture)), "depth bench: capture");
+            pipeline.synthesizer->set_cockpit_mask(pipeline.masks[slot]);
+            const HRESULT submitted = frame == 0
+                ? pipeline.synthesizer->submit_prime(capture, *cameras[slot], 0, &ticket)
+                : pipeline.synthesizer->submit_pair(capture, *cameras[slot], *cameras[slot], 0,
+                      static_cast<std::uint32_t>(frame % 2), &ticket, std::nullopt, {}, false, 0.5F);
+            require(operation_succeeded(submitted), "depth bench: submission");
+            require_frame_start_gate(*pipeline.synthesizer, "depth bench: frame-start gate");
+            xrfg::D3D12NvidiaGpuTiming timing{};
+            while (pipeline.synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                if (timing.previous_serial == 0) continue;
+                pipeline.composition.push_back(timing.composition_microseconds);
+            }
+        }
+    }
+    require(operation_succeeded(pipelines[0].synthesizer->wait_for_idle()) &&
+                operation_succeeded(pipelines[1].synthesizer->wait_for_idle()), "depth bench: idle");
+    const auto median = [](std::vector<std::uint64_t> values) -> std::uint64_t {
+        if (values.empty()) return 0;
+        std::sort(values.begin(), values.end());
+        return values[values.size() / 2];
+    };
+    const std::uint64_t masked = median(pipelines[0].composition);
+    const std::uint64_t depth = median(pipelines[1].composition);
+    const double share = double(counters->depth_pixels.load()) /
+        double(std::max<std::uint64_t>(1, counters->depth_pairs.load())) / (2.0 * width * height);
+    std::cout << "cockpit depth bench " << width << "x" << height << " x2: composition median " << masked
+              << " us with the masks alone, " << depth << " us with depth (" << (std::int64_t(depth) - std::int64_t(masked))
+              << " us; " << pipelines[0].composition.size() << "/" << pipelines[1].composition.size()
+              << " pairs timed); depth pairs " << counters->depth_pairs.load() << ", " << int(share * 100.0 + 0.5)
+              << " % of the pixels masked with depth" << std::endl;
+}
