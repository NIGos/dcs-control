+// ---------------------------------------------------------------------------
+// DCS Control (0029): bounded waits on the presenter, failing open.
+
+// A fake runtime whose frame comes only after `stall` (or when released):
+// the presenter it would wake is stuck until then, and the application's
+// wait has to give up within its bound.
+struct StalledRuntime {
+    std::mutex mutex;
+    std::condition_variable condition;
+    bool frame_done{};
+    std::atomic<bool> release{false};
+    std::thread thread;
+    explicit StalledRuntime(std::chrono::milliseconds stall)
+        : thread([this, stall] {
+              const auto until = std::chrono::steady_clock::now() + stall;
+              while (!release.load() && std::chrono::steady_clock::now() < until) {
+                  std::this_thread::sleep_for(std::chrono::milliseconds(1));
+              }
+              {
+                  std::scoped_lock lock(mutex);
+                  frame_done = true;
+              }
+              condition.notify_all();
+          }) {}
+    StalledRuntime(const StalledRuntime&) = delete;
+    StalledRuntime& operator=(const StalledRuntime&) = delete;
+    ~StalledRuntime() {
+        release = true;
+        thread.join();
+    }
+};
+
+Nanoseconds steady_now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void generation_stall_tests() {
+    {
+        GenerationStall stall;
+        require(stall.wait_bound() == GenerationStall::kWaitBound, "500 ms while armed");
+        stall.rearm(10 * kSecond);
+        require(stall.timed_out(11 * kSecond) == StallVerdict::keep_waiting,
+            "within the quiet period after a re-arm: keep waiting");
+        require(!stall.stalled, "not tripped in the quiet");
+        require(stall.timed_out(12 * kSecond) == StallVerdict::tripped && stall.trips == 1,
+            "past the quiet: tripped, once");
+        require(stall.timed_out(13 * kSecond) == StallVerdict::stalled && stall.trips == 1,
+            "then failing open, not logged again");
+        require(stall.wait_bound() == GenerationStall::kStalledWaitBound,
+            "a shorter bound once stalled");
+        stall.rearm(20 * kSecond);
+        require(!stall.stalled && stall.wait_bound() == GenerationStall::kWaitBound, "re-armed");
+        require(stall.timed_out(21 * kSecond) == StallVerdict::keep_waiting, "a new quiet period");
+        require(stall.timed_out(23 * kSecond) == StallVerdict::tripped && stall.trips == 2,
+            "trips again");
+        require(GenerationStall::kQuiet == AdaptiveConfig{}.scene_settle,
+            "the quiet is the scene settle");
+    }
+    {
+        // Stalled for good: the wait gives up after its bound and trips once.
+        StalledRuntime runtime(std::chrono::seconds(30));
+        GenerationStall stall; // never re-armed: no quiet period
+        bool tripped = false;
+        const auto on_timeout = [&] {
+            const auto verdict = stall.timed_out(steady_now_ns());
+            tripped = tripped || verdict == StallVerdict::tripped;
+            return verdict == StallVerdict::keep_waiting;
+        };
+        const auto started = std::chrono::steady_clock::now();
+        std::unique_lock lock(runtime.mutex);
+        const bool done = wait_bounded(
+            runtime.condition, lock, [&] { return runtime.frame_done; },
+            [] { return 40 * kMillisecond; }, on_timeout);
+        const auto waited = std::chrono::steady_clock::now() - started;
+        require(!done && tripped && stall.stalled, "a stalled runtime trips the latch");
+        require(waited < std::chrono::seconds(2), "and the wait is bounded");
+        // Stalled again, already tripped: gives up again, silently.
+        tripped = false;
+        const bool again = wait_bounded(
+            runtime.condition, lock, [&] { return runtime.frame_done; },
+            [] { return 20 * kMillisecond; }, on_timeout);
+        require(!again && !tripped && stall.trips == 1,
+            "fails open again without a second trip");
+    }
+    {
+        // A stall shorter than the quiet period (a mission's first frames):
+        // the wait keeps waiting through it and nothing trips.
+        StalledRuntime runtime(std::chrono::milliseconds(150));
+        GenerationStall stall;
+        stall.rearm(steady_now_ns());
+        bool tripped = false;
+        std::unique_lock lock(runtime.mutex);
+        const bool done = wait_bounded(
+            runtime.condition, lock, [&] { return runtime.frame_done; },
+            [] { return 30 * kMillisecond; },
+            [&] {
+                const auto verdict = stall.timed_out(steady_now_ns());
+                tripped = tripped || verdict == StallVerdict::tripped;
+                return verdict == StallVerdict::keep_waiting;
+            });
+        require(done && !tripped && !stall.stalled, "the quiet period rides out a load");
+    }
+    {
+        // A healthy runtime: the predicate holds within the bound.
+        StalledRuntime runtime(std::chrono::milliseconds(5));
+        bool timed_out = false;
+        std::unique_lock lock(runtime.mutex);
+        const bool done = wait_bounded(
+            runtime.condition, lock, [&] { return runtime.frame_done; },
+            [] { return 2 * kSecond; },
+            [&] {
+                timed_out = true;
+                return false;
+            });
+        require(done && !timed_out, "a healthy wait never times out");
+    }
+}
