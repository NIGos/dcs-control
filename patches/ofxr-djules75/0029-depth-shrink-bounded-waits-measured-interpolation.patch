+                "the measured interval's position");
+        }
+    }
+    require(measured >= 5, "irregular intervals are measured: " + std::to_string(measured));
+    // Missing or implausible: nothing, and the caller keeps its own answer.
+    require(!measured_interpolation_fraction(0, at(4), kPeriod, 3, 0), "no previous release");
+    require(!measured_interpolation_fraction(at(4), at(4), kPeriod, 3, 0), "no interval");
