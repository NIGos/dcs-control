+// ---------------------------------------------------------------------------
+// DCS Control (0029): the application's waits for the presenter, bounded.
+//
+// The application's xrEndFrame waits on the presenter thread four ways: for
+// room in its queue (capacity), for it to drain (idle), for a submission to
+// reach the runtime, and for the once-per-pair hold. None had a bound: a
+// presenter stalled in a runtime call, or behind a fence that never
+// signalled, froze the game with it. Each wait now runs kWaitBound at a time.
+// The first time one runs out the latch trips (logged once by the caller),
+// and from then on generation fails open: the application's frames pass
+// through without synthesis, as with the tray's off switch, and a wait that
+// runs out again - kStalledWaitBound, shorter, so the game keeps a usable
+// rate while the presenter is gone - lets the application go on without
+// it. The latch is re-armed by a scene change, a new presenter or the
+// runtime focusing the session again, each of which opens a quiet period of
+// kQuiet (adaptive control's scene settle) in which a wait that runs out
+// keeps waiting instead: a mission's first frames, or a presenter's first,
+// may take that long.
+enum class StallVerdict : std::uint32_t {
+    keep_waiting = 0,
+    tripped = 1,  // the latch tripped now: the caller logs it, once
+    stalled = 2,  // tripped before: fail open again, silently
+};
+
+struct GenerationStall {
+    static constexpr Nanoseconds kWaitBound = 500 * kMillisecond;
+    static constexpr Nanoseconds kStalledWaitBound = 250 * kMillisecond;
+    static constexpr Nanoseconds kQuiet = 2 * kSecond;
+
+    bool stalled{};
+    std::uint32_t trips{};
+    Nanoseconds quiet_until{-1};
+
+    [[nodiscard]] Nanoseconds wait_bound() const noexcept {
+        return stalled ? kStalledWaitBound : kWaitBound;
+    }
+    // A bounded wait ran out at `now`.
+    [[nodiscard]] StallVerdict timed_out(Nanoseconds now) noexcept {
+        if (stalled) {
+            return StallVerdict::stalled;
+        }
+        if (now < quiet_until) {
+            return StallVerdict::keep_waiting;
+        }
+        stalled = true;
+        ++trips;
+        return StallVerdict::tripped;
+    }
+    void rearm(Nanoseconds now) noexcept {
+        stalled = false;
+        quiet_until = now + kQuiet;
+    }
+};
+
+// Waits on `condition` (held through `lock`) until `predicate` holds, at
+// most bound() at a time. When a bound runs out, on_timeout() says whether
+// to keep waiting. True when the predicate held, false when given up.
+template <typename Condition, typename Lock, typename Predicate,
+          typename Bound, typename OnTimeout>
+[[nodiscard]] bool wait_bounded(
+    Condition& condition,
+    Lock& lock,
+    Predicate predicate,
+    Bound bound,
+    OnTimeout on_timeout) {
+    for (;;) {
+        if (condition.wait_for(
+                lock, std::chrono::nanoseconds(bound()), predicate)) {
+            return true;
+        }
+        if (!on_timeout()) {
+            return predicate();
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// DCS Control (0029): where a synthetic belongs, from measured times.
+//
+// The layer places synthetic `index` (of frames - 1, counted from the first
+// shown; it goes out frames - 1 - index display periods before its real
+// frame) at 1 - (frames - 1 - index) * period / interval of the way from the
+// previous application frame to the current one. The interval it had was
+// the difference of the display times the application was told - virtual
+// times, whole periods apart, so the fraction was always a third, two thirds
+// or a half. After a late application frame the content of the two frames is
+// further apart than that: this takes the interval from when the application
+// was released for each of them (its frame starts there), measured.
+//
+// Only off the regular cadence: within kRegularBand of frames periods the
+// fixed answer stands (the measured one would only add the release's
+// jitter). Nothing when either release is missing, out of order, or the
+// interval implausible - no longer than the synthetics need, or more than
+// twice the cadence - and the caller keeps its own answer. Clamped to [0, 1].
+inline constexpr Nanoseconds kRegularBandDivisor = 4; // a quarter period
+
+[[nodiscard]] inline std::optional<float> measured_interpolation_fraction(
+    Nanoseconds previous_release,
+    Nanoseconds current_release,
+    Nanoseconds period,
+    std::uint32_t frames,
+    std::uint32_t index) noexcept {
+    if (period <= 0 || frames < 2 || index + 1 >= frames ||
+        previous_release <= 0 || current_release <= previous_release) {
+        return std::nullopt;
+    }
+    const Nanoseconds interval = current_release - previous_release;
+    const Nanoseconds cadence = period * static_cast<Nanoseconds>(frames);
+    if (interval <= period * static_cast<Nanoseconds>(frames - 1) ||
+        interval > cadence * 2) {
+        return std::nullopt;
+    }
+    const Nanoseconds off = interval > cadence ? interval - cadence
+                                               : cadence - interval;
+    if (off <= period / kRegularBandDivisor) {
+        return std::nullopt;
+    }
+    const Nanoseconds before =
+        period * static_cast<Nanoseconds>(frames - 1 - index);
+    const double fraction = 1.0 -
+        static_cast<double>(before) / static_cast<double>(interval);
+    return static_cast<float>(
+        fraction < 0.0 ? 0.0 : (fraction > 1.0 ? 1.0 : fraction));
+}
+
 } // namespace xrfg::latency
