+        feed.window(-kPeriod);
+        require(depth.slots == 2 && depth.dwell == 2 * TripleDepth::kDwellWindows,
+            "a grow right after a give-back doubles the dwell");
+        std::uint32_t windows = 0;
+        while (feed.given == 1 && windows < 200) {
