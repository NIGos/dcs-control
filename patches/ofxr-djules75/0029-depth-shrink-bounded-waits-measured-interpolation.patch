+        DepthFeed feed{depth};
+        feed.window(-kPeriod);
+        require(depth.slots == 2 && depth.dwell == TripleDepth::kDwellWindows, "base dwell");
+        for (std::uint32_t w = 0; w < TripleDepth::kDwellWindows; ++w) {
+            feed.window(8 * kMillisecond);
+        }
