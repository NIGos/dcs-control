+        }
+        require(depth.dwell_length == TripleDepth::kMaxDwellWindows, "up to the maximum");
+        for (std::uint32_t w = 0; w < TripleDepth::kFlapWindows; ++w) {
+            feed.window(8 * kMillisecond);
+        }
+        feed.window(-kPeriod);
+        require(depth.dwell == TripleDepth::kDwellWindows, "a calm stretch resets it");
