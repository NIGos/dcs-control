+void measured_interpolation_tests() {
+    const Nanoseconds start = 50 * kSecond;
+    const auto at = [&](double periods) {
+        return start + static_cast<Nanoseconds>(periods * static_cast<double>(kPeriod));
+    };
+    const auto near = [](std::optional<float> value, double expected) {
+        return value.has_value() && *value > expected - 0.002 && *value < expected + 0.002;
+    };
+    // The regular cadence, and jitter within a quarter period: the fixed
+    // answer stands.
+    require(!measured_interpolation_fraction(at(0), at(3), kPeriod, 3, 0), "3X on cadence");
+    require(!measured_interpolation_fraction(at(0), at(3.2), kPeriod, 3, 1), "3X jitter");
+    require(!measured_interpolation_fraction(at(0), at(1.8), kPeriod, 2, 0), "2X jitter");
+    // A late frame: four periods between releases in 3X. The first synthetic
+    // goes out two periods before its real frame: half way; the second three
+    // quarters.
+    require(near(measured_interpolation_fraction(at(0), at(4), kPeriod, 3, 0), 0.5),
+        "late: first at 1/2");
+    require(near(measured_interpolation_fraction(at(0), at(4), kPeriod, 3, 1), 0.75),
+        "late: second at 3/4");
+    // The frame after it, early: 2.5 periods.
+    require(near(measured_interpolation_fraction(at(4), at(6.5), kPeriod, 3, 0), 0.2),
+        "early: first at 0.2");
+    require(near(measured_interpolation_fraction(at(4), at(6.5), kPeriod, 3, 1), 0.6),
+        "early: second at 0.6");
+    // 2X, three periods: the synthetic one period before its frame.
+    require(near(measured_interpolation_fraction(at(0), at(3), kPeriod, 2, 0), 2.0 / 3.0),
+        "2X late");
+    // An irregular sequence: every answer within [0, 1], the first synthetic
+    // before the second, and each the measured formula's.
+    const std::vector<double> releases{0, 3, 4.6, 8.1, 11.0, 15.4, 17.9, 21.3, 25.0, 27.2};
+    std::size_t measured = 0;
+    for (std::size_t i = 1; i < releases.size(); ++i) {
+        const auto first = measured_interpolation_fraction(
+            at(releases[i - 1]), at(releases[i]), kPeriod, 3, 0);
+        const auto second = measured_interpolation_fraction(
+            at(releases[i - 1]), at(releases[i]), kPeriod, 3, 1);
+        require(first.has_value() == second.has_value(), "both or neither");
+        if (first) {
