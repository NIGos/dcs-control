+// ---------------------------------------------------------------------------
+// DCS Control (0029): the deeper pipeline gives slots back.
+
+// One window of first synthetics, each with `slack` (the one at `late_at`
+// a missed slot); a slot asked for is taken at once, a give-back applied
+// when `drop_safe`.
+struct DepthFeed {
+    TripleDepth& depth;
+    bool drop_safe{true};
+    std::uint32_t given{};
+    std::uint32_t taken{};
+
+    void window(Nanoseconds slack, std::uint32_t late_at = TripleDepth::kWindow) {
+        for (std::uint32_t i = 0; i < TripleDepth::kWindow; ++i) {
+            const Nanoseconds sample = i == late_at ? -kPeriod : slack;
+            depth.observe_leader(
+                triple_depth_leader_late(sample, kPeriod),
+                triple_depth_leader_spare(sample, kPeriod));
+            if (depth.pending && depth.take(true, true, true)) {
+                ++taken;
+            }
+            if (depth.shrink_pending && depth.give_back(drop_safe)) {
+                ++given;
+            }
+        }
+    }
+};
+
+void triple_depth_shrink_tests() {
+    {
+        require(triple_depth_leader_spare(kPeriod / 2 + 1, kPeriod), "past half a period: spare");
+        require(!triple_depth_leader_spare(kPeriod / 2, kPeriod), "half a period: not spare");
+        require(!triple_depth_leader_spare(2 * kMillisecond, kPeriod), "2 ms: not spare");
+        require(!triple_depth_leader_spare(-kPeriod, kPeriod), "late: not spare");
+        require(!triple_depth_leader_spare(kPeriod, kPeriod, true), "handed over late: not spare");
+        require(!triple_depth_leader_spare(kPeriod, 0), "no period: nothing judged");
+        require(TripleDepth::kBaseSlots == 1, "the arm's slot is the base");
+    }
+    {
+        // Grow from one slot to three on a heavy stretch, then the frames
+        // come back on time with room: nothing is given back within the dwell
+        // after the last grow, then one slot once it has passed with
+        // kShrinkWindows clean windows, the next after as many again, and
+        // never below the base.
+        TripleDepth depth;
+        depth.arm(true, 3);
+        require(depth.take(true, true, true) && depth.slots == 1, "the base slot");
+        DepthFeed feed{depth};
+        feed.window(-12 * kMillisecond);
+        feed.window(-12 * kMillisecond);
+        require(depth.slots == 3 && feed.taken == 2, "heavy: three slots");
+        require(depth.dwell == TripleDepth::kDwellWindows, "a grow starts the dwell");
+        const Nanoseconds roomy = 8 * kMillisecond; // more than half a period
+        for (std::uint32_t w = 1; w < TripleDepth::kDwellWindows; ++w) {
+            feed.window(roomy);
+            require(feed.given == 0 && !depth.shrink_pending,
+                "within the dwell nothing is given back (window " + std::to_string(w) + ")");
+        }
+        feed.window(roomy);
+        require(feed.given == 1 && depth.slots == 2 && depth.given_back == 1,
+            "past the dwell, after three clean windows: one slot back");
+        for (std::uint32_t w = 1; w < TripleDepth::kShrinkWindows; ++w) {
+            feed.window(roomy);
+        }
+        require(feed.given == 1 && depth.slots == 2, "not before kShrinkWindows more");
+        feed.window(roomy);
+        require(feed.given == 2 && depth.slots == 1, "then the next");
+        for (std::uint32_t w = 0; w < 20; ++w) {
+            feed.window(roomy);
+        }
+        require(feed.given == 2 && depth.slots == 1 && !depth.shrink_pending,
+            "never below the base slot");
+        require(depth.inserted == 3, "grows counted");
+    }
+    {
+        // Any late first synthetic in a window - or one without room -
+        // keeps every slot: one late every other window never gives back.
+        TripleDepth depth;
+        depth.arm(true, 3);
+        require(depth.take(true, true, true), "first slot");
+        DepthFeed feed{depth};
+        feed.window(-12 * kMillisecond);
+        feed.window(-12 * kMillisecond);
+        require(depth.slots == 3, "three slots");
+        for (std::uint32_t w = 0; w < 4 * TripleDepth::kDwellWindows; ++w) {
+            feed.window(8 * kMillisecond, w % 2 == 0 ? 7U : TripleDepth::kWindow);
+        }
+        require(feed.given == 0 && depth.slots == 3, "a late window resets the count");
+        for (std::uint32_t w = 0; w < 4 * TripleDepth::kDwellWindows; ++w) {
+            // On time but under half a period of room: a period less would
+            // make it late.
+            feed.window(3 * kMillisecond);
+        }
+        require(feed.given == 0 && depth.slots == 3, "no room: nothing given back");
+        // A give-back pending is not applied while the presenter cannot drop
+        // safely, and a late first synthetic cancels it.
+        feed.drop_safe = false;
+        for (std::uint32_t w = 0; w < TripleDepth::kShrinkWindows; ++w) {
+            feed.window(8 * kMillisecond);
+        }
+        require(depth.shrink_pending && depth.slots == 3, "pending until a safe slot");
+        require(!depth.give_back(false), "not dropped without a written pair");
+        depth.observe_leader(true, false);
+        require(!depth.shrink_pending, "a late first synthetic cancels it");
+        depth.arm(true, 3);
+        require(!depth.shrink_pending && depth.dwell == 0 && depth.slots == 0, "arm starts over");
+    }
