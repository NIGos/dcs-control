+// DCS Control (0060): the 2/3 cadence's resync confirms over ten frames and
+// holds a move against its last one (CadenceTimeResync::kReverseHold).
+void cadence_resync_hysteresis_tests() {
+    constexpr Nanoseconds kP = 11'111'111;
+    {
+        // R112's hunting: GPU bound at 2/3 (frames of 2 and 3 periods,
+        // mixed), bursts of 3-7 frames late by three periods or early by
+        // two, alternately, between 1-4 frames on time, a quarter period of
+        // jitter, each frame observed two frames after it was told. 0059 moved
+        // on any three in a row: 13 moves in 25 s, +3/-2 alternately. Then a
+        // real shift - every frame a period late - which is resynchronised.
+        CadenceTimeResync resync{};
+        struct Told { std::uint32_t frames; Nanoseconds told; std::int64_t periods; std::int64_t spike; };
+        std::vector<Told> in_flight;
+        std::uint32_t lcg = 0x5EED0060U;
+        const auto draw = [&](int low, int high) {
+            lcg = lcg * 1664525U + 1013904223U;
+            return low + static_cast<int>((lcg >> 8) % static_cast<std::uint32_t>(high - low + 1));
+        };
+        Nanoseconds told = 1'000'000'000;
+        std::vector<std::pair<Nanoseconds, std::int64_t>> moved_at;
+        int runs_of_three = 0;
+        int run_length = 0;
+        std::int64_t run_value = 0;
+        std::int64_t shift = 0;
+        const auto frame = [&](std::int64_t spike, int index) {
+            const std::uint32_t frames = index % 3 == 0 ? 3U : 2U;
+            told += frames * kP;
+            in_flight.push_back({frames, told, resync.periods_for(frames), spike});
+            if (in_flight.size() <= 2) {
+                return;
+            }
+            const Told shown = in_flight.front();
+            in_flight.erase(in_flight.begin());
+            const Nanoseconds jitter = (draw(0, 2) - 1) * kP / 4;
+            const Nanoseconds residual = (shift + shown.spike - shown.periods) * kP + jitter;
+            const std::int64_t off = residual_periods(residual, kP);
+            if (off != 0 && off == run_value) {
+                runs_of_three += ++run_length == 3 ? 1 : 0;
+            } else {
+                run_value = off;
+                run_length = off != 0 ? 1 : 0;
+            }
+            const std::int64_t moved = resync.observe(shown.frames, shown.told, residual, kP, told);
+            if (moved != 0) {
+                moved_at.emplace_back(shown.told, moved);
+            }
+        };
+        int index = 0;
+        bool late = true;
+        // About 25 s at 2/3 (90 Hz).
+        while (told < 1'000'000'000 + 25 * kSecond) {
+            const int burst = draw(3, 7);
+            for (int count = 0; count < burst; ++count) {
+                frame(late ? 3 : -2, index++);
+            }
+            late = !late;
+            const int calm = draw(1, 4);
+            for (int count = 0; count < calm; ++count) {
+                frame(0, index++);
+            }
+        }
+        require(runs_of_three >= 13,
+            "resync hunting: the input has runs 0059 moved on (" +
+                std::to_string(runs_of_three) + ")");
+        require(moved_at.empty() && resync.moves == 0,
+            "resync hunting: no move on bursts (" + std::to_string(resync.moves) + ")");
+        shift = 1;
+        for (int count = 0; count < 40; ++count) {
+            frame(0, index++);
+        }
+        require(moved_at.size() == 1 && moved_at[0].second == 1 && resync.moves == 1 &&
+                    resync.periods_for(2) == 1,
+            "resync hunting: a real shift moves it once (" +
+                std::to_string(resync.moves) + ")");
+        for (std::size_t at = 1; at < moved_at.size(); ++at) {
+            require(moved_at[at].second * moved_at[at - 1].second > 0 ||
+                        moved_at[at].first - moved_at[at - 1].first >=
+                            CadenceTimeResync::kReverseHold,
+                "resync hunting: no opposite move within the hold");
+        }
+    }
+    {
+        // The hold and its back-off, frame by frame (the clock is the told
+        // time). Each run: `count` 2-frames, `off` periods off, last_told the
+        // frame's own (so the next frame is judged).
+        CadenceTimeResync resync{};
+        Nanoseconds told = 1'000'000'000;
+        const auto feed = [&](std::uint32_t frames, std::uint32_t count, std::int64_t off) {
+            std::int64_t moved = 0;
+            for (std::uint32_t index = 0; index < count; ++index) {
+                told += frames * kP;
+                moved += resync.observe(frames, told, off * kP, kP, told);
+            }
+            return moved;
+        };
+        const std::uint32_t n = CadenceTimeResync::kConfirmCadence;
+        require(feed(2, n - 1, 2) == 0 && feed(2, 1, 2) == 2 && resync.backoff == 0,
+            "hysteresis: ten frames move the 2/3 cadence");
+        const Nanoseconds first_move = told;
+        // Same direction: no hold.
+        require(feed(3, n, 1) == 1 && resync.moves == 2, "hysteresis: the same way is not held");
+        // Against it within 2 s: held, however long it lasts.
+        require(feed(2, 3 * n, -2) == 0 && resync.held >= 3 && resync.periods_for(2) == 3,
+            "hysteresis: an opposite move within 2 s is held");
+        // 1X's part is not held, and confirms on three.
+        require(feed(1, 3, -1) == -1 && resync.offset[0] == -1,
+            "hysteresis: 1X moves on three frames, unheld");
+        // Past the hold: it moves, and the reversal raises the back-off.
+        told = std::max(told, first_move + CadenceTimeResync::kReverseHold);
+        // (the last move was the same-way one, a little after first_move)
+        told += 2 * kSecond;
+        require(feed(2, n, -2) == -2 && resync.backoff == 1 &&
+                    resync.reverse_hold(told) == 2 * CadenceTimeResync::kReverseHold,
+            "hysteresis: after the hold it moves, back-off 1 (4 s)");
+        const Nanoseconds second_move = told;
+        // Back again 3 s later: held (4 s now).
+        told += 3 * kSecond;
+        require(feed(2, n, 2) == 0, "hysteresis: the back-off lengthens the hold");
+        told = second_move + 4 * kSecond;
+        require(feed(2, n, 2) == 2 && resync.backoff == 2,
+            "hysteresis: past 4 s it moves, back-off 2 (8 s)");
+        // Capped at 16 s; one level off per minute without a reversal.
+        require(resync.reverse_hold(told) == 4 * CadenceTimeResync::kReverseHold,
+            "hysteresis: 8 s at level 2");
+        require(resync.backoff_level(told + 61 * kSecond) == 1 &&
+                    resync.backoff_level(told + 121 * kSecond) == 0 &&
+                    resync.reverse_hold(told + 121 * kSecond) == CadenceTimeResync::kReverseHold,
+            "hysteresis: the back-off decays a level a minute");
+        CadenceTimeResync capped{};
+        capped.backoff = 9;
+        capped.backoff_at = told;
+        require(capped.reverse_hold(told) == CadenceTimeResync::kMaxReverseHold,
+            "hysteresis: capped at 16 s");
+        resync.reset();
+        require(resync.backoff == 0 && resync.last_move_sign == 0 && resync.held == 0,
+            "hysteresis: reset");
+    }
+    {
+        // The 1X deadline's idle test.
+        constexpr Nanoseconds kPeriod = 11'111'111;
+        require(!cadence_application_idle(false, 0, 5 * kSecond, kPeriod),
+            "idle: no frame yet is not idle");
+        require(!cadence_application_idle(false, kSecond, kSecond + 2 * kPeriod, kPeriod),
+            "idle: two periods is not idle yet");
+        require(cadence_application_idle(false, kSecond, kSecond + 2 * kPeriod + 1, kPeriod),
+            "idle: past two periods");
+        require(!cadence_application_idle(true, kSecond, kSecond + 50 * kPeriod, kPeriod),
+            "idle: a frame held inside xrEndFrame is not idle");
+        require(!cadence_application_idle(false, kSecond, 2 * kSecond, 0), "idle: no period");
+    }
+}
+
