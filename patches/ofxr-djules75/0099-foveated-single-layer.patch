+
+// The D3D12 texture of `handle`'s image `index` (nullptr: none).
+[[nodiscard]] ID3D12Resource* d3d12_swapchain_image(
+    SessionState& session, XrSwapchain handle, std::uint32_t index) noexcept {
+    try {
+        const auto& dispatch = session.dispatch;
+        if (!dispatch || dispatch->enumerate_swapchain_images == nullptr || handle == XR_NULL_HANDLE) {
+            return nullptr;
+        }
+        std::uint32_t count = 0;
+        if (XR_FAILED(dispatch->enumerate_swapchain_images(handle, 0, &count, nullptr)) || index >= count) {
+            return nullptr;
+        }
+        std::vector<XrSwapchainImageD3D12KHR> images(count, {XR_TYPE_SWAPCHAIN_IMAGE_D3D12_KHR});
+        if (XR_FAILED(dispatch->enumerate_swapchain_images(handle, count, &count,
+                reinterpret_cast<XrSwapchainImageBaseHeader*>(images.data()))) ||
+            index >= count) {
+            return nullptr;
+        }
+        return images[index].texture;
+    } catch (...) {
+        return nullptr;
+    }
+}
+
+// The composed swapchain for `format` and `array_size` views, made on first
+// use (and again if the format or view count ever changes: the old one is
+// left to the session's end, a repeat may still name it).
+[[nodiscard]] bool ensure_composed_swapchain(
+    SessionState& session, std::int64_t format, std::uint32_t array_size,
+    std::uint32_t width, std::uint32_t height) noexcept {
+    try {
+        if (session.composed_swapchain != XR_NULL_HANDLE && session.composed_format == format &&
+            session.composed_array_size == array_size) {
+            return true;
+        }
+        const auto& dispatch = session.dispatch;
+        if (!dispatch || dispatch->create_swapchain == nullptr) {
+            return false;
+        }
+        XrSwapchainCreateInfo info{XR_TYPE_SWAPCHAIN_CREATE_INFO};
+        info.usageFlags = XR_SWAPCHAIN_USAGE_COLOR_ATTACHMENT_BIT | XR_SWAPCHAIN_USAGE_SAMPLED_BIT;
+        info.format = format;
+        info.sampleCount = 1;
+        info.width = width;
+        info.height = height;
+        info.faceCount = 1;
+        info.arraySize = array_size;
+        info.mipCount = 1;
+        XrSwapchain handle = XR_NULL_HANDLE;
+        const XrResult result = with_runtime_entry(&session, [&] {
+            return dispatch->create_swapchain(session.handle, &info, &handle);
+        });
+        if (XR_FAILED(result) || handle == XR_NULL_HANDLE) {
+            xrfg::bridge_flight_logger().event(xrfg::BridgeFlightOperation::foveated_mode, 5, 0,
+                static_cast<std::uint64_t>(static_cast<std::int64_t>(result)), 0);
+            return false;
+        }
+        std::uint32_t count = 0;
+        std::vector<XrSwapchainImageD3D12KHR> images;
+        if (XR_SUCCEEDED(dispatch->enumerate_swapchain_images(handle, 0, &count, nullptr)) && count != 0) {
+            images.assign(count, {XR_TYPE_SWAPCHAIN_IMAGE_D3D12_KHR});
+            if (XR_FAILED(dispatch->enumerate_swapchain_images(handle, count, &count,
+                    reinterpret_cast<XrSwapchainImageBaseHeader*>(images.data())))) {
+                images.clear();
+            }
+        }
+        if (images.empty() || std::any_of(images.begin(), images.end(),
+                                  [](const XrSwapchainImageD3D12KHR& image) { return image.texture == nullptr; })) {
+            static_cast<void>(dispatch->destroy_swapchain(handle));
+            xrfg::bridge_flight_logger().event(xrfg::BridgeFlightOperation::foveated_mode, 5, 0, 0, 1);
+            return false;
+        }
+        // An earlier one (another format) stays alive until the session ends.
+        if (session.composed_swapchain != XR_NULL_HANDLE) {
+            session.retired_composed_swapchains.push_back(session.composed_swapchain);
+        }
+        session.composed_swapchain = handle;
+        session.composed_images.clear();
+        for (const auto& image : images) {
+            session.composed_images.push_back(image.texture);
+        }
+        session.composed_width = width;
+        session.composed_height = height;
+        session.composed_array_size = array_size;
+        session.composed_format = format;
+        note_private_image(handle, 0, true); // the submission log's image table
+        xrfg::bridge_flight_logger().event(xrfg::BridgeFlightOperation::foveated_mode, 5,
+            static_cast<std::uint64_t>(format), (static_cast<std::uint64_t>(width) << 32) | height,
+            (static_cast<std::uint64_t>(array_size) << 32) | images.size());
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+// The composed image's size: the runtime's recommended view size (times
+// `foveated_single_layer_scale`); without one, the periphery's field of view
+// at the focus layer's pixel density, never smaller than the periphery image,
+// at most 8192 a side.
+[[nodiscard]] std::pair<std::uint32_t, std::uint32_t> composed_size(
+    const SessionState& session, const XrCompositionLayerProjectionView& periphery,
+    const XrCompositionLayerProjectionView& focus) noexcept {
+    const double scale = session.foveated_single_layer_scale / 100.0;
+    if (session.recommended_view_width != 0 && session.recommended_view_height != 0) {
+        return {std::max<std::uint32_t>(16U, static_cast<std::uint32_t>(std::lround(session.recommended_view_width * scale))),
+            std::max<std::uint32_t>(16U, static_cast<std::uint32_t>(std::lround(session.recommended_view_height * scale)))};
+    }
+    const auto span = [](float low, float high) { return std::tan(high) - std::tan(low); };
+    const double px = span(periphery.fov.angleLeft, periphery.fov.angleRight);
+    const double py = span(periphery.fov.angleDown, periphery.fov.angleUp);
+    const double fx = span(focus.fov.angleLeft, focus.fov.angleRight);
+    const double fy = span(focus.fov.angleDown, focus.fov.angleUp);
+    const auto side = [&](double periphery_span, double focus_span, std::int32_t focus_pixels, std::int32_t periphery_pixels) {
+        double pixels = focus_span > 1.0e-6 && std::isfinite(focus_span) ? periphery_span / focus_span * focus_pixels : 0.0;
+        pixels = std::clamp(pixels * scale, static_cast<double>(std::max(periphery_pixels, 16)), 8192.0);
+        return static_cast<std::uint32_t>(std::lround(pixels));
+    };
+    return {side(px, fx, focus.subImage.imageRect.extent.width, periphery.subImage.imageRect.extent.width),
+        side(py, fy, focus.subImage.imageRect.extent.height, periphery.subImage.imageRect.extent.height)};
+}
+
+[[nodiscard]] bool compose_foveated_single_layer(
+    SessionState& session,
+    GeneratedFrameEndInfo& frame,
+    const std::vector<PendingPrivateRelease>& releases) noexcept {
+    try {
+        if (!session.foveated_layers || frame.foveated_periphery_projection < 0 ||
+            frame.projections.size() != 2) {
+            return false;
+        }
+        if (!foveated_single_layer_enabled(session)) {
+            note_single_layer(session, 0, 0);
+            return false;
+        }
+        if (session.graphics_binding != SessionGraphicsBinding::d3d12 || !session.d3d12_device ||
+            runtime_queue(session) == nullptr) {
+            note_single_layer(session, 2, 1);
+            return false;
+        }
+        if (session.foveated_composer_failed) {
+            note_single_layer(session, 2, 3);
+            return false;
+        }
+        const std::size_t periphery_index = static_cast<std::size_t>(frame.foveated_periphery_projection);
+        if (periphery_index > 1) {
+            return false;
+        }
+        const std::size_t focus_index = 1 - periphery_index;
+        ProjectionLayerCopy& periphery = frame.projections[periphery_index];
+        const ProjectionLayerCopy& focus = frame.projections[focus_index];
+        const std::size_t view_count = periphery.views.size();
+        if (view_count == 0 || view_count > 2 || focus.views.size() != view_count) {
+            note_single_layer(session, 2, 4);
+            return false;
+        }
+        // Each view's image: the one the layer holds for this frame (left
+        // acquired for this hand-over).
+        const auto held = [&](XrSwapchain handle) -> const PendingPrivateRelease* {
+            for (const auto& pending : releases) {
+                if (pending.image != nullptr && pending.image->handle == handle &&
+                    pending.image->phase != PrivateOwnershipPhase::idle) {
+                    return &pending;
+                }
+            }
+            return nullptr;
+        };
+        std::array<xrfg::D3D12FoveatedComposeView, 2> views{};
+        std::int64_t format = 0;
+        const auto tangents = [](const XrFovf& fov) {
+            return std::array<float, 4>{std::tan(fov.angleLeft), std::tan(fov.angleRight), std::tan(fov.angleUp),
+                std::tan(fov.angleDown)};
+        };
+        const auto source = [&](const XrCompositionLayerProjectionView& view, xrfg::D3D12FoveatedComposeSource* out,
+                                std::int64_t* private_format) {
+            const PendingPrivateRelease* pending = held(view.subImage.swapchain);
+            if (pending == nullptr) {
+                return false;
+            }
+            out->resource = d3d12_swapchain_image(session, view.subImage.swapchain, pending->image->acquired_index);
+            if (out->resource == nullptr) {
+                return false;
+            }
+            if (private_format != nullptr && pending->generation) {
+                *private_format = pending->generation->private_info.format;
+            }
+            out->array_slice = view.subImage.imageArrayIndex;
+            out->x = view.subImage.imageRect.offset.x;
+            out->y = view.subImage.imageRect.offset.y;
+            out->width = static_cast<std::uint32_t>(std::max(view.subImage.imageRect.extent.width, 0));
+            out->height = static_cast<std::uint32_t>(std::max(view.subImage.imageRect.extent.height, 0));
+            out->tangents = tangents(view.fov);
+            out->orientation = {view.pose.orientation.x, view.pose.orientation.y, view.pose.orientation.z,
+                view.pose.orientation.w};
+            return out->width != 0 && out->height != 0;
+        };
+        const XrCompositionLayerFlags focus_flags = focus.layer.layerFlags;
+        const auto alpha = (focus_flags & XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT) == 0
+            ? xrfg::D3D12FoveatedFocusAlpha::opaque
+            : (focus_flags & XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT) != 0
+            ? xrfg::D3D12FoveatedFocusAlpha::unpremultiplied
+            : xrfg::D3D12FoveatedFocusAlpha::premultiplied;
+        for (std::size_t v = 0; v < view_count; ++v) {
+            if (!source(periphery.views[v], &views[v].periphery, &format) ||
+                !source(focus.views[v], &views[v].focus, nullptr)) {
+                note_single_layer(session, 2, 2,
+                    (static_cast<std::uint64_t>(releases.size()) << 32) | (session.binding_queue ? 1U : 0U));
+                return false;
+            }
+            views[v].alpha = alpha;
+            views[v].target_slice = static_cast<std::uint32_t>(v);
+        }
+        if (format == 0) {
+            note_single_layer(session, 2, 2);
+            return false;
+        }
+        if (!session.foveated_composer) {
+            auto composer = std::make_unique<xrfg::D3D12FoveatedComposer>();
+            if (FAILED(composer->initialize(session.d3d12_device.Get()))) {
+                session.foveated_composer_failed = true;
+                note_single_layer(session, 2, 3);
+                return false;
+            }
+            session.foveated_composer = std::move(composer);
+        }
+        const auto [width, height] = composed_size(session, periphery.views[0], focus.views[0]);
+        if (!ensure_composed_swapchain(session, format, static_cast<std::uint32_t>(view_count),
+                session.composed_swapchain != XR_NULL_HANDLE ? session.composed_width : width,
+                session.composed_swapchain != XR_NULL_HANDLE ? session.composed_height : height)) {
+            session.foveated_composer_failed = true;
+            note_single_layer(session, 2, 3);
+            return false;
+        }
+        const auto& dispatch = session.dispatch;
+        const XrSwapchain composed = session.composed_swapchain;
+        std::uint32_t index = 0;
+        XrSwapchainImageAcquireInfo acquire_info{XR_TYPE_SWAPCHAIN_IMAGE_ACQUIRE_INFO};
+        if (XR_FAILED(with_runtime_entry(&session, [&] {
+                return dispatch->acquire_swapchain_image(composed, &acquire_info, &index);
+            })) || index >= session.composed_images.size()) {
+            session.foveated_composer_failed = true;
+            note_single_layer(session, 2, 3);
+            return false;
+        }
+        XrSwapchainImageWaitInfo wait_info{XR_TYPE_SWAPCHAIN_IMAGE_WAIT_INFO};
+        wait_info.timeout = 500'000'000; // 500 ms: the runtime gives an image back within a frame
+        const XrResult waited = with_runtime_entry(&session, [&] {
+            return dispatch->wait_swapchain_image(composed, &wait_info);
+        });
+        if (waited != XR_SUCCESS) {
+            // Still acquired and not waited for: it cannot be released, so the
+            // swapchain is out of use for the session.
+            session.foveated_composer_failed = true;
+            note_single_layer(session, 2, 3);
+            return false;
+        }
+        note_private_image(composed, index, false);
+        // The synthesis of every image read here before the composition, on
+        // the runtime's queue (run_private_releases joins them again for the
+        // release: a second wait for a value already waited for).
+        ID3D12CommandQueue* queue = runtime_queue(session);
+        if (session.d3d12_synthesis_queue) {
+            for (const auto& pending : releases) {
+                if (pending.generation && pending.generation->synthesizer) {
+                    static_cast<void>(pending.generation->synthesizer->synchronize_consumer_queue(queue, pending.ticket));
+                }
+            }
+        }
+        const HRESULT composed_result = session.foveated_composer->compose(queue,
+            {session.composed_images[index], session.composed_width, session.composed_height},
+            std::span<const xrfg::D3D12FoveatedComposeView>(views.data(), view_count));
+        XrSwapchainImageReleaseInfo release_info{XR_TYPE_SWAPCHAIN_IMAGE_RELEASE_INFO};
+        const XrResult released = with_runtime_entry(&session, [&] {
+            return dispatch->release_swapchain_image(composed, &release_info);
+        });
+        if (FAILED(composed_result) || XR_FAILED(released)) {
+            // The image went back unwritten: this frame and every later one go
+            // down as two layers, so no repeat names it.
+            session.foveated_composer_failed = true;
+            note_single_layer(session, 2, 3);
+            return false;
+        }
+        // The frame now: the periphery's projection layer on the composed
+        // swapchain, the focus layer gone.
+        for (std::size_t v = 0; v < view_count; ++v) {
+            XrSwapchainSubImage& sub_image = periphery.views[v].subImage;
+            sub_image.swapchain = composed;
+            sub_image.imageRect = {{0, 0},
+                {static_cast<std::int32_t>(session.composed_width), static_cast<std::int32_t>(session.composed_height)}};
+            sub_image.imageArrayIndex = static_cast<std::uint32_t>(v);
+        }
+        const std::uint32_t focus_layer_index = frame.projections[focus_index].layer_index;
+        std::vector<const XrCompositionLayerBaseHeader*> pointers;
+        pointers.reserve(frame.layer_pointers.size());
+        for (std::size_t i = 0; i < frame.layer_pointers.size(); ++i) {
+            if (i != focus_layer_index) {
+                pointers.push_back(frame.layer_pointers[i]);
+            }
+        }
+        frame.projections.erase(frame.projections.begin() + static_cast<std::ptrdiff_t>(focus_index));
+        ProjectionLayerCopy& kept = frame.projections.front();
+        if (kept.layer_index > focus_layer_index) {
+            --kept.layer_index;
+        }
+        kept.layer.views = kept.views.data();
+        pointers[kept.layer_index] = reinterpret_cast<const XrCompositionLayerBaseHeader*>(&kept.layer);
+        frame.layer_pointers = std::move(pointers);
+        frame.info.layerCount = static_cast<std::uint32_t>(frame.layer_pointers.size());
+        frame.info.layers = frame.layer_pointers.data();
+        frame.foveated_periphery_projection = -1;
+        ++session.composed_frames;
+        note_single_layer(session, 1, 0);
+        xrfg::D3D12FoveatedComposeTiming timing{};
+        while (session.foveated_composer->consume_gpu_timing(&timing) == S_OK) {
+            session.composed_gpu_sum_us += timing.microseconds;
+            session.composed_gpu_max_us = std::max(session.composed_gpu_max_us, timing.microseconds);
+            ++session.composed_gpu_count;
+        }
+        if (session.composed_frames % 900 == 0 && session.composed_gpu_count != 0) {
+            xrfg::bridge_flight_logger().event(xrfg::BridgeFlightOperation::foveated_mode, 6,
+                session.composed_frames, session.composed_gpu_sum_us / session.composed_gpu_count,
+                session.composed_gpu_max_us);
+            session.composed_gpu_sum_us = 0;
+            session.composed_gpu_max_us = 0;
+            session.composed_gpu_count = 0;
+        }
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
