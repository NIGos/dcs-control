diff --git a/include/xrfg/d3d12_foveated_composer.hpp b/include/xrfg/d3d12_foveated_composer.hpp
new file mode 100644
index 0000000..26eabe3
--- /dev/null
+++ b/include/xrfg/d3d12_foveated_composer.hpp
@@ -0,0 +1,132 @@
+#pragma once
+
+// DCS Control (0099): foveated single layer (`[ofxr] foveated_single_layer`).
+// Composes a frame's periphery and focus projection layers into one image per
+// eye (src/d3d12/foveated_compose.hlsl says how), on the queue the runtime
+// orders its swapchain images against, so the frame goes to the runtime as one
+// opaque projection layer. The caller owns every resource it names and keeps
+// them alive until the queue has run the work.
+
+#include <d3d12.h>
+#include <wrl/client.h>
+
+#include <array>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <span>
+
+namespace xrfg {
+
+// One source view: a slice of a texture (array or not), the sub-image the view
+// shows, its field of view as tangents and its orientation.
+struct D3D12FoveatedComposeSource {
+    ID3D12Resource* resource{};
+    std::uint32_t array_slice{};
+    std::int32_t x{};
+    std::int32_t y{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    // tan(angleLeft), tan(angleRight), tan(angleUp), tan(angleDown).
+    std::array<float, 4> tangents{};
+    // x, y, z, w of the view's orientation (XrQuaternionf).
+    std::array<float, 4> orientation{0.0F, 0.0F, 0.0F, 1.0F};
+};
+
+enum class D3D12FoveatedFocusAlpha : std::uint32_t {
+    opaque = 0,          // no SOURCE_ALPHA: the focus colour inside its field of view
+    unpremultiplied = 1, // SOURCE_ALPHA | UNPREMULTIPLIED: f * a + p * (1 - a)
+    premultiplied = 2,   // SOURCE_ALPHA: f + p * (1 - a)
+};
+
+// One eye: the output slice `target_slice` covers the periphery view's field
+// of view (its pose).
+struct D3D12FoveatedComposeView {
+    D3D12FoveatedComposeSource periphery;
+    D3D12FoveatedComposeSource focus;
+    D3D12FoveatedFocusAlpha alpha{D3D12FoveatedFocusAlpha::unpremultiplied};
+    std::uint32_t target_slice{};
+};
+
+struct D3D12FoveatedComposeTarget {
+    ID3D12Resource* resource{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+};
+
+// The composition's GPU time, from timestamps on the queue, once the queue has
+// run it (consume_gpu_timing).
+struct D3D12FoveatedComposeTiming {
+    std::uint64_t microseconds{};
+    std::uint64_t sequence{};
+};
+
+// Root constants: the cbuffer of foveated_compose.hlsl, 40 32-bit values.
+struct D3D12FoveatedComposeConstants {
+    float periphery_rect[4];
+    float periphery_clamp[4];
+    float focus_rect[4];
+    float focus_clamp[4];
+    float output_tan[4];
+    float focus_tan[4];
+    float rotation0[4];
+    float rotation1[4];
+    float rotation2[4];
+    std::uint32_t modes[4];
+};
+static_assert(sizeof(D3D12FoveatedComposeConstants) == 160);
+
+// How a texture is viewed by the pass: the view format and whether the pass
+// converts (a typeless R8G8B8A8 texture: the UNORM view of the stored bytes; a
+// typed sRGB one: its own view, encoded / decoded in the shader).
+struct D3D12FoveatedViewFormat {
+    DXGI_FORMAT format{DXGI_FORMAT_UNKNOWN};
+    bool srgb_typed{};
+};
+[[nodiscard]] D3D12FoveatedViewFormat foveated_view_format(DXGI_FORMAT resource_format) noexcept;
+
+// The constants for one eye (exposed for the tests): `source_width` /
+// `source_height` are the textures' full sizes.
+[[nodiscard]] D3D12FoveatedComposeConstants make_foveated_compose_constants(
+    const D3D12FoveatedComposeView& view,
+    std::uint32_t periphery_texture_width,
+    std::uint32_t periphery_texture_height,
+    std::uint32_t focus_texture_width,
+    std::uint32_t focus_texture_height,
+    bool periphery_encode,
+    bool focus_encode,
+    bool output_decode) noexcept;
+
+class D3D12FoveatedComposer final {
+public:
+    D3D12FoveatedComposer();
+    ~D3D12FoveatedComposer();
+    D3D12FoveatedComposer(const D3D12FoveatedComposer&) = delete;
+    D3D12FoveatedComposer& operator=(const D3D12FoveatedComposer&) = delete;
+
+    [[nodiscard]] HRESULT initialize(ID3D12Device* device) noexcept;
+
+    // Records and executes the composition of `views` into `target` on
+    // `queue`. Every source is in `source_state` before and after (a runtime's
+    // colour swapchain image: RENDER_TARGET), the target in RENDER_TARGET.
+    // Nothing waits on the CPU unless every recording slot is still in flight.
+    [[nodiscard]] HRESULT compose(
+        ID3D12CommandQueue* queue,
+        const D3D12FoveatedComposeTarget& target,
+        std::span<const D3D12FoveatedComposeView> views,
+        D3D12_RESOURCE_STATES source_state = D3D12_RESOURCE_STATE_RENDER_TARGET) noexcept;
+
+    // S_OK and a timing for each composition the queue has finished, in order;
+    // S_FALSE when none is waiting.
+    [[nodiscard]] HRESULT consume_gpu_timing(D3D12FoveatedComposeTiming* timing) noexcept;
+
+    // Blocks until every composition recorded so far has run (tests, teardown).
+    [[nodiscard]] HRESULT wait_idle() noexcept;
+
+private:
+    struct Impl;
+    std::mutex mutex_;
+    std::unique_ptr<Impl> impl_;
+};
+
+} // namespace xrfg
