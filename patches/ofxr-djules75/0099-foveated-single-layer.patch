+// DCS Control (0099): foveated single layer. See d3d12_foveated_composer.hpp
+// and foveated_compose.hlsl.
+
+#include "xrfg/d3d12_foveated_composer.hpp"
+
+#include "foveated_compose_pixel_shader.hpp"
+#include "foveated_compose_vertex_shader.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace xrfg {
+namespace {
+
+using Microsoft::WRL::ComPtr;
+
+// Compositions in flight at once before compose waits on the CPU: the
+// presenter composes one per display period, and the runtime holds a few.
+constexpr std::uint32_t kSlots = 8;
+constexpr std::uint32_t kMaxViews = 2;
+constexpr std::uint32_t kRootConstants = sizeof(D3D12FoveatedComposeConstants) / 4;
+
+struct Matrix3 {
+    float m[3][3];
+};
+
+Matrix3 rotation_of(const std::array<float, 4>& q) noexcept {
+    float x = q[0], y = q[1], z = q[2], w = q[3];
+    const float length = std::sqrt(x * x + y * y + z * z + w * w);
+    if (!(length > 1.0e-6F) || !std::isfinite(length)) {
+        return {{{1, 0, 0}, {0, 1, 0}, {0, 0, 1}}};
+    }
+    x /= length;
+    y /= length;
+    z /= length;
+    w /= length;
+    return {{{1 - 2 * (y * y + z * z), 2 * (x * y - z * w), 2 * (x * z + y * w)},
+        {2 * (x * y + z * w), 1 - 2 * (x * x + z * z), 2 * (y * z - x * w)},
+        {2 * (x * z - y * w), 2 * (y * z + x * w), 1 - 2 * (x * x + y * y)}}};
+}
+
+void set4(float* out, float a, float b, float c, float d) noexcept {
+    out[0] = a;
+    out[1] = b;
+    out[2] = c;
+    out[3] = d;
+}
+
+} // namespace
+
+D3D12FoveatedViewFormat foveated_view_format(DXGI_FORMAT resource_format) noexcept {
+    switch (resource_format) {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+        return {DXGI_FORMAT_R8G8B8A8_UNORM, false};
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+        return {DXGI_FORMAT_B8G8R8A8_UNORM, false};
+    case DXGI_FORMAT_B8G8R8X8_TYPELESS:
+        return {DXGI_FORMAT_B8G8R8X8_UNORM, false};
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS:
+        return {DXGI_FORMAT_R10G10B10A2_UNORM, false};
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+        return {DXGI_FORMAT_R16G16B16A16_FLOAT, false};
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+        return {resource_format, true};
+    default:
+        return {resource_format, false};
+    }
+}
+
+D3D12FoveatedComposeConstants make_foveated_compose_constants(
+    const D3D12FoveatedComposeView& view,
+    std::uint32_t periphery_texture_width,
+    std::uint32_t periphery_texture_height,
+    std::uint32_t focus_texture_width,
+    std::uint32_t focus_texture_height,
+    bool periphery_encode,
+    bool focus_encode,
+    bool output_decode) noexcept {
+    D3D12FoveatedComposeConstants c{};
+    const auto rect = [](const D3D12FoveatedComposeSource& source, std::uint32_t width, std::uint32_t height,
+                          float* scale_offset, float* limits) {
+        const float w = static_cast<float>(std::max<std::uint32_t>(width, 1U));
+        const float h = static_cast<float>(std::max<std::uint32_t>(height, 1U));
+        const float x = static_cast<float>(source.x);
+        const float y = static_cast<float>(source.y);
+        const float sw = static_cast<float>(source.width);
+        const float sh = static_cast<float>(source.height);
+        set4(scale_offset, sw / w, sh / h, x / w, y / h);
+        // Half a texel inside the sub-image: a bilinear tap never reads a texel outside it.
+        set4(limits, (x + 0.5F) / w, (y + 0.5F) / h, (x + sw - 0.5F) / w, (y + sh - 0.5F) / h);
+    };
+    rect(view.periphery, periphery_texture_width, periphery_texture_height, c.periphery_rect, c.periphery_clamp);
+    rect(view.focus, focus_texture_width, focus_texture_height, c.focus_rect, c.focus_clamp);
+    const auto& pt = view.periphery.tangents;
+    const auto& ft = view.focus.tangents;
+    set4(c.output_tan, pt[0], pt[1], pt[2], pt[3]);
+    set4(c.focus_tan, ft[0], ft[1], ft[2], ft[3]);
+    // A direction in the output (periphery) view's frame to the focus view's:
+    // world = Rp d, focus = Rf^T world.
+    const Matrix3 rp = rotation_of(view.periphery.orientation);
+    const Matrix3 rf = rotation_of(view.focus.orientation);
+    float rows[3][3]{};
+    for (int i = 0; i < 3; ++i) {
+        for (int j = 0; j < 3; ++j) {
+            float sum = 0;
+            for (int k = 0; k < 3; ++k) {
+                sum += rf.m[k][i] * rp.m[k][j];
+            }
+            // Exactly the identity for equal orientations (no rounding noise
+            // on the shared-pose path every Quad Views frame takes).
+            rows[i][j] = std::abs(sum - (i == j ? 1.0F : 0.0F)) < 1.0e-6F ? (i == j ? 1.0F : 0.0F) : sum;
+        }
+    }
+    set4(c.rotation0, rows[0][0], rows[0][1], rows[0][2], 0);
+    set4(c.rotation1, rows[1][0], rows[1][1], rows[1][2], 0);
+    set4(c.rotation2, rows[2][0], rows[2][1], rows[2][2], 0);
+    c.modes[0] = static_cast<std::uint32_t>(view.alpha);
+    c.modes[1] = periphery_encode ? 1U : 0U;
+    c.modes[2] = focus_encode ? 1U : 0U;
+    c.modes[3] = output_decode ? 1U : 0U;
+    return c;
+}
+
+struct D3D12FoveatedComposer::Impl {
+    ComPtr<ID3D12Device> device;
+    ComPtr<ID3D12RootSignature> root_signature;
+    std::vector<std::pair<DXGI_FORMAT, ComPtr<ID3D12PipelineState>>> pipelines;
+    ComPtr<ID3D12DescriptorHeap> srv_heap;
+    ComPtr<ID3D12DescriptorHeap> rtv_heap;
+    UINT srv_increment{};
+    UINT rtv_increment{};
+    ComPtr<ID3D12GraphicsCommandList> list;
+    ComPtr<ID3D12QueryHeap> queries;
+    ComPtr<ID3D12Resource> readback;
+    ComPtr<ID3D12Fence> fence;
+    HANDLE event{};
+    std::uint64_t fence_value{};
+    struct Slot {
+        ComPtr<ID3D12CommandAllocator> allocator;
+        std::uint64_t fence_value{};
+        std::uint64_t sequence{};
+        std::uint64_t frequency{};
+        bool timed{};
+    };
+    std::array<Slot, kSlots> slots{};
+    std::uint64_t next{};
+    std::uint64_t harvested{};
+
+    ~Impl() {
+        if (event != nullptr) {
+            CloseHandle(event);
+        }
+    }
+
+    ID3D12PipelineState* pipeline(DXGI_FORMAT format) noexcept {
+        for (const auto& [known, state] : pipelines) {
+            if (known == format) {
+                return state.Get();
+            }
+        }
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC desc{};
+        desc.pRootSignature = root_signature.Get();
+        desc.VS = {g_xrfg_foveated_compose_vertex_shader, sizeof(g_xrfg_foveated_compose_vertex_shader)};
+        desc.PS = {g_xrfg_foveated_compose_pixel_shader, sizeof(g_xrfg_foveated_compose_pixel_shader)};
+        desc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        desc.SampleMask = UINT_MAX;
+        desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        desc.RasterizerState.DepthClipEnable = TRUE;
+        desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        desc.NumRenderTargets = 1;
+        desc.RTVFormats[0] = format;
+        desc.SampleDesc.Count = 1;
+        ComPtr<ID3D12PipelineState> state;
+        if (FAILED(device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(state.GetAddressOf())))) {
+            return nullptr;
+        }
+        pipelines.emplace_back(format, state);
+        return state.Get();
+    }
+
+    HRESULT wait_for(std::uint64_t value, DWORD milliseconds) noexcept {
+        if (value == 0 || fence->GetCompletedValue() >= value) {
+            return S_OK;
+        }
+        if (FAILED(fence->SetEventOnCompletion(value, event))) {
+            return E_FAIL;
+        }
+        return WaitForSingleObject(event, milliseconds) == WAIT_OBJECT_0 ? S_OK : HRESULT_FROM_WIN32(WAIT_TIMEOUT);
+    }
+};
+
+D3D12FoveatedComposer::D3D12FoveatedComposer() = default;
+
+D3D12FoveatedComposer::~D3D12FoveatedComposer() {
+    if (impl_ && impl_->fence) {
+        static_cast<void>(impl_->wait_for(impl_->fence_value, 2000));
+    }
+}
+
+HRESULT D3D12FoveatedComposer::initialize(ID3D12Device* device) noexcept {
+    std::scoped_lock lock(mutex_);
+    if (device == nullptr) {
+        return E_INVALIDARG;
+    }
+    try {
+        auto impl = std::make_unique<Impl>();
+        impl->device = device;
+        D3D12_DESCRIPTOR_RANGE range{};
+        range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        range.NumDescriptors = 2;
+        range.BaseShaderRegister = 0;
+        std::array<D3D12_ROOT_PARAMETER, 2> parameters{};
+        parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        parameters[0].Constants.Num32BitValues = kRootConstants;
+        parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        parameters[1].DescriptorTable.NumDescriptorRanges = 1;
+        parameters[1].DescriptorTable.pDescriptorRanges = &range;
+        parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_STATIC_SAMPLER_DESC sampler{};
+        sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+        sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+        sampler.MaxLOD = D3D12_FLOAT32_MAX;
+        sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC root{};
+        root.NumParameters = static_cast<UINT>(parameters.size());
+        root.pParameters = parameters.data();
+        root.NumStaticSamplers = 1;
+        root.pStaticSamplers = &sampler;
+        ComPtr<ID3DBlob> blob, errors;
+        HRESULT result = D3D12SerializeRootSignature(&root, D3D_ROOT_SIGNATURE_VERSION_1, &blob, &errors);
+        if (FAILED(result)) {
+            return result;
+        }
+        result = device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
+            IID_PPV_ARGS(impl->root_signature.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        D3D12_DESCRIPTOR_HEAP_DESC srv{};
+        srv.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        srv.NumDescriptors = kSlots * kMaxViews * 2;
+        srv.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        result = device->CreateDescriptorHeap(&srv, IID_PPV_ARGS(impl->srv_heap.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        D3D12_DESCRIPTOR_HEAP_DESC rtv{};
+        rtv.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        rtv.NumDescriptors = kSlots * kMaxViews;
+        result = device->CreateDescriptorHeap(&rtv, IID_PPV_ARGS(impl->rtv_heap.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->srv_increment = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        impl->rtv_increment = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+        for (auto& slot : impl->slots) {
+            result = device->CreateCommandAllocator(
+                D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(slot.allocator.GetAddressOf()));
+            if (FAILED(result)) {
+                return result;
+            }
+        }
+        result = device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, impl->slots[0].allocator.Get(),
+            nullptr, IID_PPV_ARGS(impl->list.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->list->Close();
+        D3D12_QUERY_HEAP_DESC queries{};
+        queries.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+        queries.Count = kSlots * 2;
+        // Best effort: without timestamps the composition still runs, untimed.
+        if (FAILED(device->CreateQueryHeap(&queries, IID_PPV_ARGS(impl->queries.GetAddressOf())))) {
+            impl->queries.Reset();
+        }
+        if (impl->queries) {
+            D3D12_HEAP_PROPERTIES heap{};
+            heap.Type = D3D12_HEAP_TYPE_READBACK;
+            D3D12_RESOURCE_DESC buffer{};
+            buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+            buffer.Width = kSlots * 2 * sizeof(std::uint64_t);
+            buffer.Height = 1;
+            buffer.DepthOrArraySize = 1;
+            buffer.MipLevels = 1;
+            buffer.SampleDesc.Count = 1;
+            buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+            if (FAILED(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                    D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(impl->readback.GetAddressOf())))) {
+                impl->queries.Reset();
+            }
+        }
+        result = device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(impl->fence.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (impl->event == nullptr) {
+            return HRESULT_FROM_WIN32(GetLastError());
+        }
+        impl_ = std::move(impl);
+        return S_OK;
+    } catch (...) {
+        return E_OUTOFMEMORY;
+    }
+}
+
+HRESULT D3D12FoveatedComposer::compose(
+    ID3D12CommandQueue* queue,
+    const D3D12FoveatedComposeTarget& target,
+    std::span<const D3D12FoveatedComposeView> views,
+    D3D12_RESOURCE_STATES source_state) noexcept {
+    std::scoped_lock lock(mutex_);
+    if (!impl_) {
+        return E_NOT_VALID_STATE;
+    }
+    if (queue == nullptr || target.resource == nullptr || target.width == 0 || target.height == 0 ||
+        views.empty() || views.size() > kMaxViews) {
+        return E_INVALIDARG;
+    }
+    Impl& impl = *impl_;
+    try {
+        const std::uint32_t index = static_cast<std::uint32_t>(impl.next % kSlots);
+        Impl::Slot& slot = impl.slots[index];
+        // The slot's previous composition must have run before its allocator
+        // and descriptors are used again.
+        HRESULT result = impl.wait_for(slot.fence_value, 250);
+        if (FAILED(result)) {
+            return result;
+        }
+        const D3D12_RESOURCE_DESC target_desc = target.resource->GetDesc();
+        const D3D12FoveatedViewFormat output = foveated_view_format(target_desc.Format);
+        ID3D12PipelineState* pipeline = impl.pipeline(output.format);
+        if (pipeline == nullptr) {
+            return E_FAIL;
+        }
+        result = slot.allocator->Reset();
+        if (FAILED(result)) {
+            return result;
+        }
+        result = impl.list->Reset(slot.allocator.Get(), pipeline);
+        if (FAILED(result)) {
+            return result;
+        }
+        ID3D12GraphicsCommandList* list = impl.list.Get();
+        const bool timed = impl.queries != nullptr;
+        if (timed) {
+            list->EndQuery(impl.queries.Get(), D3D12_QUERY_TYPE_TIMESTAMP, index * 2);
+        }
+        // Every distinct source to PIXEL_SHADER_RESOURCE and back.
+        std::array<ID3D12Resource*, kMaxViews * 2> sources{};
+        std::uint32_t source_count = 0;
+        for (const auto& view : views) {
+            for (ID3D12Resource* resource : {view.periphery.resource, view.focus.resource}) {
+                if (resource == nullptr) {
+                    list->Close();
+                    return E_INVALIDARG;
+                }
+                if (std::find(sources.begin(), sources.begin() + source_count, resource) ==
+                    sources.begin() + source_count) {
+                    sources[source_count++] = resource;
+                }
+            }
+        }
+        std::array<D3D12_RESOURCE_BARRIER, kMaxViews * 2> barriers{};
+        const bool transition = (source_state & D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE) == 0;
+        if (transition) {
+            for (std::uint32_t i = 0; i < source_count; ++i) {
+                barriers[i].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+                barriers[i].Transition.pResource = sources[i];
+                barriers[i].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+                barriers[i].Transition.StateBefore = source_state;
+                barriers[i].Transition.StateAfter = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE;
+            }
+            list->ResourceBarrier(source_count, barriers.data());
+        }
+        ID3D12DescriptorHeap* heaps[] = {impl.srv_heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetGraphicsRootSignature(impl.root_signature.Get());
+        list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        const D3D12_VIEWPORT viewport{0, 0, static_cast<float>(target.width), static_cast<float>(target.height), 0, 1};
+        const D3D12_RECT scissor{0, 0, static_cast<LONG>(target.width), static_cast<LONG>(target.height)};
+        list->RSSetViewports(1, &viewport);
+        list->RSSetScissorRects(1, &scissor);
+        for (std::uint32_t v = 0; v < views.size(); ++v) {
+            const D3D12FoveatedComposeView& view = views[v];
+            const D3D12_RESOURCE_DESC periphery_desc = view.periphery.resource->GetDesc();
+            const D3D12_RESOURCE_DESC focus_desc = view.focus.resource->GetDesc();
+            const D3D12FoveatedViewFormat periphery_format = foveated_view_format(periphery_desc.Format);
+            const D3D12FoveatedViewFormat focus_format = foveated_view_format(focus_desc.Format);
+            const std::uint32_t base = (index * kMaxViews + v) * 2;
+            D3D12_CPU_DESCRIPTOR_HANDLE srv = impl.srv_heap->GetCPUDescriptorHandleForHeapStart();
+            srv.ptr += static_cast<SIZE_T>(base) * impl.srv_increment;
+            const auto make_srv = [&](const D3D12FoveatedComposeSource& source, DXGI_FORMAT format,
+                                      D3D12_CPU_DESCRIPTOR_HANDLE handle) {
+                D3D12_SHADER_RESOURCE_VIEW_DESC desc{};
+                desc.Format = format;
+                desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+                desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+                desc.Texture2DArray.MipLevels = 1;
+                desc.Texture2DArray.FirstArraySlice = source.array_slice;
+                desc.Texture2DArray.ArraySize = 1;
+                impl.device->CreateShaderResourceView(source.resource, &desc, handle);
+            };
+            make_srv(view.periphery, periphery_format.format, srv);
+            D3D12_CPU_DESCRIPTOR_HANDLE focus_srv = srv;
+            focus_srv.ptr += impl.srv_increment;
+            make_srv(view.focus, focus_format.format, focus_srv);
+            D3D12_CPU_DESCRIPTOR_HANDLE rtv = impl.rtv_heap->GetCPUDescriptorHandleForHeapStart();
+            rtv.ptr += static_cast<SIZE_T>(index * kMaxViews + v) * impl.rtv_increment;
+            D3D12_RENDER_TARGET_VIEW_DESC rtv_desc{};
+            rtv_desc.Format = output.format;
+            rtv_desc.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2DARRAY;
+            rtv_desc.Texture2DArray.FirstArraySlice = view.target_slice;
+            rtv_desc.Texture2DArray.ArraySize = 1;
+            impl.device->CreateRenderTargetView(target.resource, &rtv_desc, rtv);
+            const D3D12FoveatedComposeConstants constants = make_foveated_compose_constants(view,
+                static_cast<std::uint32_t>(periphery_desc.Width), periphery_desc.Height,
+                static_cast<std::uint32_t>(focus_desc.Width), focus_desc.Height,
+                periphery_format.srgb_typed, focus_format.srgb_typed, output.srgb_typed);
+            D3D12_GPU_DESCRIPTOR_HANDLE table = impl.srv_heap->GetGPUDescriptorHandleForHeapStart();
+            table.ptr += static_cast<UINT64>(base) * impl.srv_increment;
+            list->OMSetRenderTargets(1, &rtv, FALSE, nullptr);
+            list->SetGraphicsRoot32BitConstants(0, kRootConstants, &constants, 0);
+            list->SetGraphicsRootDescriptorTable(1, table);
+            list->DrawInstanced(3, 1, 0, 0);
+        }
+        if (transition) {
+            for (std::uint32_t i = 0; i < source_count; ++i) {
+                std::swap(barriers[i].Transition.StateBefore, barriers[i].Transition.StateAfter);
+            }
+            list->ResourceBarrier(source_count, barriers.data());
+        }
+        if (timed) {
+            list->EndQuery(impl.queries.Get(), D3D12_QUERY_TYPE_TIMESTAMP, index * 2 + 1);
+            list->ResolveQueryData(impl.queries.Get(), D3D12_QUERY_TYPE_TIMESTAMP, index * 2, 2,
+                impl.readback.Get(), static_cast<UINT64>(index) * 2 * sizeof(std::uint64_t));
+        }
+        result = list->Close();
+        if (FAILED(result)) {
+            return result;
+        }
+        ID3D12CommandList* lists[] = {list};
+        queue->ExecuteCommandLists(1, lists);
+        const std::uint64_t value = ++impl.fence_value;
+        result = queue->Signal(impl.fence.Get(), value);
+        if (FAILED(result)) {
+            return result;
+        }
+        slot.fence_value = value;
+        slot.sequence = impl.next;
+        slot.timed = timed;
+        if (timed) {
+            UINT64 frequency = 0;
+            slot.frequency = SUCCEEDED(queue->GetTimestampFrequency(&frequency)) ? frequency : 0;
+        }
+        ++impl.next;
+        return S_OK;
+    } catch (...) {
+        return E_FAIL;
+    }
+}
+
+HRESULT D3D12FoveatedComposer::consume_gpu_timing(D3D12FoveatedComposeTiming* timing) noexcept {
+    std::scoped_lock lock(mutex_);
+    if (!impl_ || timing == nullptr) {
+        return E_INVALIDARG;
+    }
+    Impl& impl = *impl_;
+    while (impl.harvested < impl.next) {
+        Impl::Slot& slot = impl.slots[impl.harvested % kSlots];
+        if (slot.sequence != impl.harvested) {
+            // Overwritten before it was read (more than kSlots behind).
+            ++impl.harvested;
+            continue;
+        }
+        if (impl.fence->GetCompletedValue() < slot.fence_value) {
+            return S_FALSE;
+        }
+        ++impl.harvested;
+        if (!slot.timed || slot.frequency == 0) {
+            continue;
+        }
+        const std::uint32_t index = static_cast<std::uint32_t>(slot.sequence % kSlots);
+        const D3D12_RANGE range{index * 2 * sizeof(std::uint64_t), (index * 2 + 2) * sizeof(std::uint64_t)};
+        void* mapped = nullptr;
+        if (FAILED(impl.readback->Map(0, &range, &mapped)) || mapped == nullptr) {
+            continue;
+        }
+        std::uint64_t stamps[2]{};
+        std::memcpy(stamps, static_cast<const std::uint8_t*>(mapped) + range.Begin, sizeof(stamps));
+        const D3D12_RANGE none{0, 0};
+        impl.readback->Unmap(0, &none);
+        timing->sequence = slot.sequence;
+        timing->microseconds = stamps[1] > stamps[0] ? (stamps[1] - stamps[0]) * 1000000ULL / slot.frequency : 0;
+        return S_OK;
+    }
+    return S_FALSE;
+}
+
+HRESULT D3D12FoveatedComposer::wait_idle() noexcept {
+    std::scoped_lock lock(mutex_);
+    if (!impl_) {
+        return E_NOT_VALID_STATE;
+    }
+    return impl_->wait_for(impl_->fence_value, 5000);
+}
+
+} // namespace xrfg
diff --git a/src/d3d12/foveated_compose.hlsl b/src/d3d12/foveated_compose.hlsl
new file mode 100644
index 0000000..b905275
--- /dev/null
+++ b/src/d3d12/foveated_compose.hlsl
@@ -0,0 +1,111 @@
+// DCS Control (0099): foveated single layer (`[ofxr] foveated_single_layer`).
+//
+// With foveated frame generation the application (Quad Views, dcsvr_two_layers) submits two projection layers per
+// eye, the periphery and the focus, and the layer synthesizes each on its own (the GPU saving). Handed to the runtime
+// as two layers, the runtime composes them itself, with per-layer distortion: its chromatic aberration correction
+// samples red and blue across the focus layer's border (a coloured line there), and wherever the focus alpha is below
+// 1 it shows its own periphery under the focus, which on some frames is not the one the focus was composed against
+// (a flickering rectangle). This pass does the runtime's composition before the runtime sees anything: one image per
+// eye at the periphery's field of view, at the runtime's recommended size, written with alpha 1, submitted as ONE
+// opaque projection layer. No layer border is left for the distortion to sample across, and nothing for the runtime
+// to blend.
+//
+// The blend is the one the runtime does with the two layers (measured on Pimax, tools/runtime-probe): on the stored
+// (encoded) values, the focus layer's colour over the periphery by the focus layer's alpha. Quad Views' opaque focus
+// (dcsvr_two_layers_alpha 3) chooses its focus colour so that exactly this blend gives its own single-layer
+// composition (ProjectionPS.hlsl's fade, sharpening, edge match, Far depth: all already in the focus layer), so the
+// result is Quad Views' composed image. Real and generated frames go through the same pass.
+//
+//   alpha mode 0  the focus layer is opaque (no SOURCE_ALPHA): its colour inside its field of view.
+//              1  SOURCE_ALPHA | UNPREMULTIPLIED: focus * a + periphery * (1 - a).
+//              2  SOURCE_ALPHA, premultiplied (the OpenXR default): focus + periphery * (1 - a).
+//
+// Each source and the target is read and written through a view chosen by the CPU (a typeless runtime texture gets
+// UNORM views: the stored bytes as they are). encode = 1: the view returns linear values (a typed sRGB resource) and
+// the pass encodes them first, so the blend is still on the encoded values; decode = 1: the target view is sRGB and
+// encodes on write, so the pass hands it the linear value of the encoded result.
+//
+// Geometry: the output covers the periphery view's field of view (its pose); a pixel's direction is rotated into the
+// focus view's frame (the identity when the two share a pose, as Quad Views' do) and projected with the focus view's
+// tangents. Both sources are sampled bilinear within their sub-images (clamped half a texel inside, so nothing outside
+// a sub-image is ever read).
+
+cbuffer ComposeConstants : register(b0) {
+    float4 peripheryRect;  // output uv -> periphery texture uv: xy scale, zw offset
+    float4 peripheryClamp; // texture uv limits: xy min, zw max
+    float4 focusRect;      // focus view uv -> focus texture uv: xy scale, zw offset
+    float4 focusClamp;     // texture uv limits: xy min, zw max
+    float4 outputTan;      // the output view's tangents: left, right, up, down
+    float4 focusTan;       // the focus view's tangents: left, right, up, down
+    float4 rotation0;      // rows of the rotation output view -> focus view (xyz)
+    float4 rotation1;
+    float4 rotation2;
+    uint4 modes;           // x alpha mode, y periphery encode, z focus encode, w output decode
+};
+
+Texture2DArray peripheryImage : register(t0);
+Texture2DArray focusImage : register(t1);
+SamplerState linearClamp : register(s0);
+
+float3 ComposeLinearToSrgb(float3 c) {
+    c = saturate(c);
+    float3 low = c * 12.92;
+    float3 high = 1.055 * pow(c, 1.0 / 2.4) - 0.055;
+    return float3(c.r <= 0.0031308 ? low.r : high.r, c.g <= 0.0031308 ? low.g : high.g,
+        c.b <= 0.0031308 ? low.b : high.b);
+}
+
+float3 ComposeSrgbToLinear(float3 c) {
+    c = saturate(c);
+    float3 low = c / 12.92;
+    float3 high = pow((c + 0.055) / 1.055, 2.4);
+    return float3(c.r <= 0.04045 ? low.r : high.r, c.g <= 0.04045 ? low.g : high.g,
+        c.b <= 0.04045 ? low.b : high.b);
+}
+
+struct ComposeVertex {
+    float4 position : SV_Position;
+    float2 uv : TEXCOORD0;
+};
+
+ComposeVertex FoveatedComposeVS(uint id : SV_VertexID) {
+    ComposeVertex output;
+    output.uv = float2((id << 1) & 2, id & 2);
+    output.position = float4(output.uv * float2(2, -2) + float2(-1, 1), 0, 1);
+    return output;
+}
+
+float3 FoveatedComposeColour(float2 uv) {
+    const float2 peripheryUv = clamp(uv * peripheryRect.xy + peripheryRect.zw, peripheryClamp.xy, peripheryClamp.zw);
+    float3 periphery = peripheryImage.SampleLevel(linearClamp, float3(peripheryUv, 0), 0).rgb;
+    if (modes.y != 0) {
+        periphery = ComposeLinearToSrgb(periphery);
+    }
+    float3 colour = periphery;
+    const float3 direction = float3(lerp(outputTan.x, outputTan.y, uv.x), lerp(outputTan.z, outputTan.w, uv.y), -1);
+    const float3 inFocus = float3(dot(rotation0.xyz, direction), dot(rotation1.xyz, direction), dot(rotation2.xyz, direction));
+    [branch] if (inFocus.z < 0) {
+        const float2 tangent = inFocus.xy / -inFocus.z;
+        const float2 focusUv = (tangent - focusTan.xz) / (focusTan.yw - focusTan.xz);
+        [branch] if (all(focusUv >= 0) && all(focusUv <= 1)) {
+            const float2 textureUv = clamp(focusUv * focusRect.xy + focusRect.zw, focusClamp.xy, focusClamp.zw);
+            float4 focus = focusImage.SampleLevel(linearClamp, float3(textureUv, 0), 0);
+            if (modes.z != 0) {
+                focus.rgb = ComposeLinearToSrgb(focus.rgb);
+            }
+            if (modes.x == 0) {
+                colour = focus.rgb;
+            } else if (modes.x == 1) {
+                colour = focus.rgb * focus.a + periphery * (1 - focus.a);
+            } else {
+                colour = focus.rgb + periphery * (1 - focus.a);
+            }
+        }
+    }
+    colour = saturate(colour);
+    return modes.w != 0 ? ComposeSrgbToLinear(colour) : colour;
+}
+
+float4 FoveatedComposePS(ComposeVertex input) : SV_Target {
+    return float4(FoveatedComposeColour(input.uv), 1);
+}
