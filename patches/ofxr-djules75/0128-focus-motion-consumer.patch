+            {0, 1.0, roll, 6.0, 9.0, kFmTerrain, 0, 3000.0, {k, k, k}},
+            {3, 0.35, roll, 0.0, 0.0, kFmFull, 0x80, 65504.0, sky},
+        }});
+        const double orbit = 0.5 * pi / 180.0;
+        cases.push_back({"orbit" + light, {
+            {1, 1.0, 0.0, 0.0, 0.0, kFmOrbit, 1, 30.0, {0.8 * k, 0.8 * k, 0.85 * k}},
+            {0, 1.0, orbit, 18.0, 2.0, kFmTerrain, 0, 2500.0, {k, k, k}},
+            {3, 0.35, orbit, 18.0, 2.0, kFmFull, 0x80, 65504.0, sky},
+        }});
+        cases.push_back({"small" + light, {
+            {1, 1.0, roll, 12.0, -3.0, kFmSmallA, 1, 2500.0, {0.85 * k, 0.85 * k, 0.9 * k}},
+            {1, 1.0, roll, -10.0, 4.0, kFmSmallB, 1, 1800.0, {0.7 * k, 0.7 * k, 0.75 * k}},
+            {1, 1.0, roll, 9.0, 5.0, kFmSmallC, 1, 2200.0, {0.75 * k, 0.75 * k, 0.8 * k}},
+            {0, 1.0, roll, 6.0, 9.0, kFmTerrain, 0, 3000.0, {k, k, k}},
+            {3, 0.35, roll, 0.0, 0.0, kFmFull, 0x80, 65504.0, sky},
+        }});
+    }
+    for (FmCase& scene : cases) {
+        for (FmLayer& layer : scene.layers) {
+            layer.dx *= factor;
+            layer.dy *= factor;
+        }
+    }
+    return cases;
+}
+
+struct FmRegions {
+    std::vector<std::string> names;
+    std::vector<std::vector<std::uint8_t>> masks;
+};
+
+FmRegions fm_regions(const FmCase& scene, UINT width, UINT height) {
+    const FmFrame f0 = fm_frame(scene.layers, width, height, 0.0);
+    const FmFrame fm = fm_frame(scene.layers, width, height, 0.5);
+    const FmFrame f1 = fm_frame(scene.layers, width, height, 1.0);
+    const std::size_t n = static_cast<std::size_t>(width) * height;
+    const auto shape_at = [&](const FmFrame& f, std::size_t i) {
+        return f.front[i] < 0 ? -1 : scene.layers[static_cast<std::size_t>(f.front[i])].shape;
+    };
+    const auto is_model = [&](const FmFrame& f, std::size_t i) {
+        return f.front[i] >= 0 && scene.layers[static_cast<std::size_t>(f.front[i])].klass == 1U;
+    };
+    const auto grow = [&](const std::function<bool(std::size_t)>& of, int r) {
+        std::vector<std::uint8_t> mask(n, 0);
+        for (int y = 0; y < int(height); ++y) {
+            for (int x = 0; x < int(width); ++x) {
+                if (!of(static_cast<std::size_t>(y) * width + x)) continue;
+                for (int dy = -r; dy <= r; ++dy) {
+                    for (int dx = -r; dx <= r; ++dx) {
+                        const int sx = x + dx, sy = y + dy;
+                        if (sx < 0 || sy < 0 || sx >= int(width) || sy >= int(height)) continue;
+                        mask[static_cast<std::size_t>(sy) * width + sx] = 1;
+                    }
+                }
+            }
+        }
+        return mask;
+    };
+    const FmInset inset = fm_inset(width, height);
+    auto model = grow([&](std::size_t i) { return is_model(fm, i); }, 4);
+    std::vector<std::uint8_t> trailing(n, 0), behind(n, 0), ahead(n, 0), inside(n, 0), outside(n, 0), rest(n, 0),
+        all(n, 1);
+    for (std::size_t i = 0; i < n; ++i) {
+        trailing[i] = !is_model(fm, i) && (is_model(f0, i) || is_model(f1, i));
+        behind[i] = !is_model(fm, i) && is_model(f0, i) && !is_model(f1, i);
+        ahead[i] = !is_model(fm, i) && is_model(f1, i) && !is_model(f0, i);
+        inside[i] = inset.inside(static_cast<UINT>(i % width), static_cast<UINT>(i / width));
+        outside[i] = !inside[i];
+    }
+    auto wires = grow([&](std::size_t i) { return shape_at(fm, i) == kFmWires; }, 2);
+    for (std::size_t i = 0; i < n; ++i) rest[i] = !(model[i] || trailing[i] || wires[i]);
+    // The model band split by where it is (the focus inset or the periphery).
+    std::vector<std::uint8_t> model_in(n, 0), model_out(n, 0);
+    for (std::size_t i = 0; i < n; ++i) {
+        model_in[i] = model[i] && inside[i];
+        model_out[i] = model[i] && !inside[i];
+    }
+    const std::array<std::pair<const char*, std::vector<std::uint8_t>*>, 11> list{{{"model", &model},
+        {"model-inset", &model_in}, {"model-periphery", &model_out}, {"trailing", &trailing}, {"behind", &behind},
+        {"ahead", &ahead}, {"wires", &wires}, {"inset", &inside}, {"outside", &outside}, {"rest", &rest},
+        {"all", &all}}};
+    FmRegions regions;
+    for (const auto& [name, mask] : list) {
+        std::size_t count = 0;
+        for (std::size_t i = 32U * width; i + 32U * width < n; ++i) count += (*mask)[i];
+        if (count == 0) continue;
+        regions.names.emplace_back(name);
+        regions.masks.push_back(*mask);
+    }
+    return regions;
+}
+
+struct FmVariant {
+    std::string name;
+    bool motion{};       // [ofxr] dcs_motion
+    bool key{};          // [ofxr] dcs_motion_focus
+    FmFrameData data{};  // what the frames carry
+};
+
+StereoPattern fm_run(D3D12WarpFixture& fixture, const FmCase& scene, const FmVariant& variant, UINT width,
+    UINT height, const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters, const FmFrame& a, const FmFrame& b) {
+    const ReprojectionViews views = make_reprojection_views();
+    // The previous frame carries its own MVs too (every DCS frame does),
+    // pointing at the frame before it.
+    const auto previous =
+        fm_mask_frame(fixture, scene.layers, width, height, views, 1000, 500, variant.data, counters, 0.0, -1.0);
+    const auto current = fm_mask_frame(fixture, scene.layers, width, height, views, 2000, 1000, variant.data, counters);
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.occlusion_aware = 1; // the app's default for Medium, one-way flow
+    options.dcs_motion = variant.motion;
+    options.dcs_motion_focus = variant.key;
+    // The headset's eye image's cell (8) for the periphery; the fine grid 4.
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", variant.motion ? "8" : nullptr);
+    StereoPattern image = synthesize_nvidia_pair(fixture, a.image, b.image, width, height, options, {previous, current});
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", nullptr);
+    return image;
+}
+
+void fm_dump(const std::string& name, const StereoPattern& image, UINT width, UINT height) {
+    char folder[512]{};
+    if (GetEnvironmentVariableA("XRFG_TEST_DUMP_DIR", folder, sizeof(folder)) == 0) return;
+    std::string file = std::string(folder) + "\\" + name + ".ppm";
+    for (char& c : file) if (c == ',') c = '_';
+    std::ofstream out(file, std::ios::binary);
+    out << "P6\n" << width << ' ' << height << "\n255\n";
+    for (std::size_t i = 0; i < static_cast<std::size_t>(width) * height; ++i) {
+        out.write(reinterpret_cast<const char*>(&image[0][i * kBytesPerPixel]), 3);
+    }
+}
+
+void run_fg_focus_motion_fixtures() {
+    D3D12WarpFixture fixture(true);
+    char which_buffer[256]{};
+    GetEnvironmentVariableA("XRFG_TEST_FG_FOCUS_MOTION", which_buffer, sizeof(which_buffer));
+    const std::string which = which_buffer;
+    const UINT factor = which.find("x4") != std::string::npos ? 4U : 1U;
+    const UINT width = 640U * factor, height = 480U * factor;
+    const UINT fd = which.find("d1") != std::string::npos ? 1U : 2U;
+    std::cout << "fm " << width << "x" << height << ", periphery MVs d10 (cell 8), focus MVs d" << fd
+              << " over the middle half (fine cell 4)" << std::endl;
+    for (const FmCase& scene : fm_cases(double(factor))) {
+        const FmRegions regions = fm_regions(scene, width, height);
+        const FmFrame a = fm_frame(scene.layers, width, height, 0.0);
+        const FmFrame b = fm_frame(scene.layers, width, height, 1.0);
+        const FmFrame truth = fm_frame(scene.layers, width, height, 0.5);
+        auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+        const FmFrameData full{true, fd, true};
+        const std::vector<FmVariant> variants{
+            {"flow", false, false, full},
+            {"today", true, false, full},
+            {"focus", true, true, full},
+            {"focus-class", true, true, {true, fd, false}},
+        };
+        std::vector<StereoPattern> images;
+        std::vector<std::vector<DepthTestError>> errors;
+        for (const FmVariant& variant : variants) {
+            const std::uint64_t along_before = counters->motion_pixels.load();
+            const std::uint64_t back_before = counters->motion_fallback_pixels.load();
+            images.push_back(fm_run(fixture, scene, variant, width, height, counters, a, b));
+            const std::uint64_t along = counters->motion_pixels.load() - along_before;
+            const std::uint64_t back = counters->motion_fallback_pixels.load() - back_before;
+            errors.emplace_back();
+            std::cout << "fm " << scene.name << " " << variant.name;
+            for (std::size_t r = 0; r < regions.names.size(); ++r) {
+                const auto& mask = regions.masks[r];
+                errors.back().push_back(depth_test_error(images.back(), truth.image, width, height,
+                    [&](UINT, UINT x, UINT y) { return mask[static_cast<std::size_t>(y) * width + x] != 0; }));
+                char mae[32]{};
+                std::snprintf(mae, sizeof(mae), "%.2f", errors.back().back().mae);
+                std::cout << " | " << regions.names[r] << " " << mae << " p99 " << errors.back().back().p99;
+            }
+            const double pixels = 2.0 * width * height;
+            std::cout << " | along " << int(100.0 * double(along) / pixels + 0.5) << "% fallback "
+                      << int(100.0 * double(back) / pixels + 0.5) << "%" << std::endl;
+            fm_dump(scene.name + " - " + variant.name, images.back(), width, height);
+        }
+        fm_dump(scene.name + " - truth", truth.image, width, height);
+        // The depth plane is read: a plane whose texels alternate 10 m and 1000 m
+        // (every texel its own surface) changes the focus composition.
+        const StereoPattern checker = fm_run(fixture, scene, {"focus-checker-depth", true, true, {true, fd, true, true}},
+            width, height, counters, a, b);
+        require(checker != images[2], "fg focus motion " + scene.name + ": the depth plane is not read");
+        // Today's path exactly: the key off with the focus data in the frame
+        // and without it, and the key on with a frame from an older producer.
+        const StereoPattern bare = fm_run(fixture, scene, {"today-bare", true, false, {true, 0, false}}, width,
+            height, counters, a, b);
+        require(bare == images[1], "fg focus motion " + scene.name + ": the key off reads the focus data");
+        const StereoPattern older = fm_run(fixture, scene, {"older-producer", true, true, {true, 0, false}}, width,
+            height, counters, a, b);
+        require(older == images[1],
+            "fg focus motion " + scene.name + ": the key on without focus data is not today's composition");
+        const auto at = [&](const char* name) {
+            for (std::size_t r = 0; r < regions.names.size(); ++r) {
+                if (regions.names[r] == name) return static_cast<int>(r);
+            }
+            return -1;
+        };
+        const int all = at("all"), outside = at("outside"), inset = at("inset");
+        // Summary: focus against today, per region.
+        std::cout << "fm " << scene.name << " focus vs today:";
+        for (std::size_t r = 0; r < regions.names.size(); ++r) {
+            char text[64]{};
+            std::snprintf(text, sizeof(text), " %s %.2f->%.2f", regions.names[r].c_str(), errors[1][r].mae,
+                errors[2][r].mae);
+            std::cout << text;
+        }
+        std::cout << std::endl;
+        // Gates: the periphery (outside the inset) as today within the
+        // finer grid's interpolation, and no region of the image overall
+        // worse than today's by more than the colour checks' blend allows.
+        require(errors[2][static_cast<std::size_t>(outside)].mae <=
+                    errors[1][static_cast<std::size_t>(outside)].mae * 1.05 + 0.25,
+            "fg focus motion " + scene.name + ": the periphery is worse than today's");
+        require(errors[2][static_cast<std::size_t>(all)].mae <= errors[1][static_cast<std::size_t>(all)].mae * 1.10 + 0.5,
+            "fg focus motion " + scene.name + ": worse than today's overall");
+        require(errors[2][static_cast<std::size_t>(inset)].mae <=
+                    errors[1][static_cast<std::size_t>(inset)].mae * 1.10 + 0.5,
+            "fg focus motion " + scene.name + ": the inset is worse than today's");
+    }
+    fixture.require_no_debug_errors();
+}
