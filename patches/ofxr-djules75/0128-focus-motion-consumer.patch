+        auto frame = acquire(consumer, proven_view, true);
+        const xrfg::D3D12DcsMotionView& right = frame->motion_focus_views[1];
+        require(frame->motion && frame->motion_focus_views[0].valid && right.valid && right.x == 0 &&
+                right.y == kMotionAtlasHeight / 2U && right.width == kMotionAtlasWidth &&
+                right.height == kMotionAtlasHeight / 2U && right.depth && frame->motion_depth &&
+                frame->motion_depth_texture != nullptr,
+            "motion focus: both focus views (their rects) and the depth plane");
+        require(gpu.readback_rows(frame->motion_depth_texture.Get(), kMotionAtlasWidth * 2U, kMotionAtlasHeight) ==
+                motion.depth_pattern_,
+            "motion focus: the depth copy holds the slot's plane");
+        require(gpu.readback_rows(frame->motion_texture.Get(), kMotionAtlasWidth * 4U, kMotionAtlasHeight) ==
+                motion.pattern_,
+            "motion focus: the MV copy holds the slot");
+        frame.reset();
+        // Jitter not proven on the focus views: the periphery's MVs alone.
+        frame = acquire(consumer, cmv::view_flags::depth_plane, true);
+        require(frame->motion && frame->motion_views[0].valid && !frame->motion_focus_views[0].valid &&
+                !frame->motion_depth && consumer.stats().motion_focus_refused >= 1,
+            "motion focus: unproven focus jitter refused");
+        frame.reset();
+        // Focus views without the plane in this slot.
+        frame = acquire(consumer, cmv::view_flags::jitter_proven, true);
+        require(frame->motion_focus_views[0].valid && !frame->motion_focus_views[0].depth && !frame->motion_depth,
+            "motion focus: a view without depth_plane has no depth");
+        frame.reset();
+        // An older producer (revision 3 with the flag set: view_record says none).
+        frame = acquire(consumer, proven_view, true, 3U);
+        require(frame->motion && !frame->motion_focus_views[0].valid && !frame->motion_depth,
+            "motion focus: a revision 3 producer gives the periphery alone");
+        frame.reset();
+        // The producer's focus views off (flag clear, held set kept).
+        {
+            const std::uint64_t seq = producer.commit(time, 255);
+            motion.commit(producer, time - 10);
+            motion.header_.flags &= ~(cmv::header_flags::focus_views | cmv::header_flags::depth_plane);
+            motion.header_.revision = 4U;
+            motion.publish();
+            frame = consumer.acquire(time);
+            time += 100;
+            producer.signal(seq);
+            require(frame != nullptr && frame->motion && !frame->motion_focus_views[0].valid && !frame->motion_depth,
+                "motion focus: the producer's option off gives the periphery alone");
+            gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+            frame.reset();
+        }
+        require(consumer.stats().motion_generations_opened == 1,
+            "motion focus: one generation opened through every case");
+    }
+    // A plane shared only after the generation was opened: opened again once.
+    {
+        motion.header_.flags &= ~cmv::header_flags::depth_plane;
+        motion.header_.depthFormat = 0;
+        std::fill(std::begin(motion.header_.depthTextureHandle), std::end(motion.header_.depthTextureHandle), 0ULL);
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+        auto frame = acquire(consumer, cmv::view_flags::jitter_proven, false);
+        require(frame->motion_focus_views[0].valid && !frame->motion_depth &&
+                consumer.stats().motion_generations_opened == 1,
+            "motion focus: the focus views without a plane");
+        frame.reset();
+        for (int pass = 0; pass < 3; ++pass) {
+            frame = acquire(consumer, proven_view, true);
+            require(frame->motion_depth && frame->motion_focus_views[1].depth,
+                "motion focus: the plane once shared");
+            frame.reset();
+        }
+        require(consumer.stats().motion_generations_opened == 2,
+            "motion focus: a plane shared later opens the generation once more, and only once");
+    }
+    std::cout << "dcs motion focus: revision 4 focus views and depth plane, key off, unproven jitter, no plane, "
+                 "revision 3, producer option off, late plane\n";
+}
