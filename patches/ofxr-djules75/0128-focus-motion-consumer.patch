+    uint value = (Flags & 1u) != 0u ? ClassSource.Load(int3(focus_texel(texel), 0)) : 0u;
+    return (FocusFlags & 4u) != 0u ? (value & 0x80u) : value;
+}
+
+// Linear depth along the view axis in metres (65504: the sky and beyond);
+// 0 where the focus view's depth plane is not bound.
+float focus_load_depth(int2 texel) {
+    return (FocusFlags & 8u) != 0u ? DepthSource.Load(int3(focus_texel(texel), 0)) : 0.0;
+}
+
+// One surface by depth: within 3 % (and a quarter metre) of each other, the
+// sky only with the sky; anything without the plane.
+static const float kFocusDepthRelative = 0.03;
+static const float kFocusDepthAbsolute = 0.25;
+static const float kFocusSkyDepth = 65000.0;
+bool focus_same_depth(float a, float b) {
+    bool sky_a = a >= kFocusSkyDepth;
+    bool sky_b = b >= kFocusSkyDepth;
+    return (FocusFlags & 8u) == 0u ||
+        (sky_a == sky_b && (sky_a || abs(a - b) <= kFocusDepthRelative * min(a, b) + kFocusDepthAbsolute));
+}
+
+// The focus rect's position of target pixel `pixel` (as source_position).
+bool focus_position(float2 pixel, out float2 position) {
+    float2 uv = (pixel - TargetRect.xy + 0.5) / max(TargetRect.zw, float2(1.0, 1.0));
+    float2 tangent = float2(
+        lerp(TargetTangents.x, TargetTangents.y, uv.x),
+        lerp(TargetTangents.z, TargetTangents.w, uv.y));
+    float left = FocusFov.x, right = FocusFov.y, up = FocusFov.z, down = FocusFov.w;
+    bool usable = right > left && up > down && FocusRect.z >= 2.0 && FocusRect.w >= 2.0;
+    position = usable
+        ? float2((tangent.x - left) / (right - left), (up - tangent.y) / (up - down)) * FocusRect.zw
+        : float2(-1.0, -1.0);
+    return usable && all(position >= 0.0) && all(position < FocusRect.zw);
+}
+
+// The residual motion in target pixels of a focus MV (as target_residual).
+bool focus_residual(float2 pixel, float2 position, float2 motion, out float2 residual) {
+    residual = float2(0.0, 0.0);
+    float left = FocusFov.x, right = FocusFov.y, up = FocusFov.z, down = FocusFov.w;
+    float2 previous_position = position + motion;
+    float2 previous_tangent = float2(
+        left + previous_position.x / FocusRect.z * (right - left),
+        up - previous_position.y / FocusRect.w * (up - down));
+    float4 previous_to_target = float4(-TargetToPrevious.xyz, TargetToPrevious.w);
+    float3 ray = rotate_by_quaternion(previous_to_target, float3(previous_tangent, -1.0));
+    bool front = finite2(motion) && ray.z < -1.0e-5;
+    float2 span = float2(TargetTangents.y - TargetTangents.x, TargetTangents.w - TargetTangents.z);
+    float2 previous_pixel = TargetRect.xy +
+        (ray.xy / max(-ray.z, 1.0e-5) - TargetTangents.xz) / span * TargetRect.zw - 0.5;
+    residual = front ? previous_pixel - pixel : float2(0.0, 0.0);
+    return front && finite2(residual) && length(residual) <= 1024.0;
+}
+
+// Focus texels per target pixel (the larger axis).
+float focus_texels_per_pixel() {
+    float2 texels = FocusRect.zw /
+        max(abs(float2(FocusFov.y - FocusFov.x, FocusFov.z - FocusFov.w)), float2(1.0e-6, 1.0e-6)) *
+        abs(float2(TargetTangents.y - TargetTangents.x, TargetTangents.w - TargetTangents.z)) /
+        max(TargetRect.zw, float2(1.0, 1.0));
+    return max(texels.x, texels.y);
+}
+
+// The edge-aware MV at focus rect position `position`: the bilinear weights
+// of the four texels around it, kept only for those of the nearest texel's
+// surface (its class, its depth, its motion within `tolerance`), normalised;
+// the nearest texel's own where none is (a one-texel sliver). Across a
+// silhouette the two sides are never mixed: each side's cells take their own
+// surface's motion at the plane's full resolution.
+float2 focus_motion_around(float2 position, float tolerance, out uint klass) {
+    int2 nearest = int2(floor(position));
+    klass = focus_load_class(nearest);
+    float reference_depth = focus_load_depth(nearest);
+    float2 reference = focus_load_motion(nearest);
+    float2 at = position - 0.5;
+    int2 base = int2(floor(at));
+    float2 weight = at - float2(base);
+    float2 sum = float2(0.0, 0.0);
+    float total = 0.0;
+    [unroll] for (uint corner = 0u; corner < 4u; ++corner) {
+        int2 offset = int2(corner & 1u, corner >> 1);
+        int2 texel = base + offset;
+        float w = (offset.x != 0 ? weight.x : 1.0 - weight.x) * (offset.y != 0 ? weight.y : 1.0 - weight.y);
+        float2 m = focus_load_motion(texel);
+        bool same = finite2(m) && focus_load_class(texel) == klass &&
+            focus_same_depth(focus_load_depth(texel), reference_depth) && all(abs(m - reference) <= tolerance);
+        sum += same ? w * m : float2(0.0, 0.0);
+        total += same ? w : 0.0;
+    }
+    return total > 1.0e-4 ? sum / total : reference;
+}
+
+// The fine grid's cell inside the focus inset: as periphery_cell, from the
+// focus view's MVs, with the edge-aware filter and the one-surface test by
+// class, depth and a tolerance of about one target pixel of motion.
+void focus_cell(uint2 index, float2 pixel, float2 position, out float4 result, out float4 solved_out[2]) {
+    result = float4(0.0, 0.0, 0.0, 0.0);
+    float texels_per_pixel = focus_texels_per_pixel();
+    float tolerance = max(0.5, texels_per_pixel);
+    int2 nearest = int2(floor(position));
+    uint klass = focus_load_class(nearest);
+    float depth = focus_load_depth(nearest);
+    float2 motion = focus_load_motion(nearest);
+    int reach = int(clamp(ceil(texels_per_pixel * float(Cell)), 1.0, 3.0));
+    bool interior = finite2(motion) && index.x > 0u && index.y > 0u &&
+        index.x + 1u < OutputWidth && index.y + 1u < OutputHeight &&
+        all(nearest - reach >= 0) && all(nearest + reach < int2(FocusRect.zw));
+    [loop] for (int y = -reach; y <= reach && interior; ++y) {
+        [loop] for (int x = -reach; x <= reach; ++x) {
+            int2 texel = nearest + int2(x, y);
+            float2 other = focus_load_motion(texel);
+            if (focus_load_class(texel) != klass || !finite2(other) || any(abs(other - motion) > tolerance) ||
+                !focus_same_depth(focus_load_depth(texel), depth)) {
+                interior = false;
+            }
+        }
+    }
+    uint unused;
+    motion = finite2(motion) ? focus_motion_around(position, tolerance, unused) : motion;
+    float2 residual;
+    if (focus_residual(pixel, position, motion, residual)) {
+        result = float4(residual, float(klass), interior ? 7.0 : 5.0);
+    }
+    [unroll] for (uint output = 0u; output < 2u; ++output) {
+        float4 solved = float4(0.0, 0.0, 0.0, 0.0);
+        float t = output == 0u ? Fraction0 : Fraction1;
+        [branch] if (result.w > 0.5) {
+            float2 moving = result.xy;
+            [unroll] for (uint step = 0u; step < 2u; ++step) {
+                float2 at = pixel - (1.0 - t) * moving;
+                float2 at_position;
+                uint at_class = 0u;
+                float2 at_residual = moving;
+                bool same = false;
+                if (focus_position(at, at_position)) {
+                    float2 raw = focus_motion_around(at_position, tolerance, at_class);
+                    same = at_class == klass && focus_residual(at, at_position, raw, at_residual);
+                }
+                float moved = same ? length(at_residual - moving) : 0.0;
+                moving = same ? at_residual : moving;
+                if (moved <= 0.25) {
+                    break;
+                }
+            }
+            bool uniform_field = length(moving - result.xy) < 1.0;
+            solved = float4(moving, result.z, 1.0 + (interior && uniform_field ? 2.0 : 0.0) +
+                (uniform_field ? 4.0 : 0.0));
+        }
+        solved_out[output] = solved;
+    }
+}
+
+// The one-cell feather at the inset's edge: the focus cell's value moved
+// halfway toward the periphery's where both are a vector of one class within
+// two pixels of each other (its surface flags only where both have them);
+// the focus cell's own otherwise, the periphery's where the focus has none.
+float4 focus_feather(float4 inner, float4 outer) {
+    bool both = inner.w > 0.5 && outer.w > 0.5 && uint(inner.z + 0.5) == uint(outer.z + 0.5) &&
+        length(inner.xy - outer.xy) < 2.0;
+    float4 blended = float4(lerp(outer.xy, inner.xy, 0.5), inner.z, float(uint(inner.w + 0.5) & uint(outer.w + 0.5)));
+    return inner.w > 0.5 ? (both ? blended : inner) : outer;
+}
+
+// A cell of the fine grid (FocusFlags bit 0).
+void fine_cell(uint2 index, out float4 result, out float4 solved_out[2]) {
+    float2 pixel = TargetRect.xy + (float2(index) + 0.5) * float(Cell) - 0.5;
+    float2 position = float2(-1.0, -1.0);
+    bool focus = (FocusFlags & 2u) != 0u && focus_position(pixel, position);
+    // Within one cell of the inset's edge (in target pixels).
+    float2 edge_texels = min(position, FocusRect.zw - position);
+    bool near_edge = focus && min(edge_texels.x, edge_texels.y) <
+        float(Cell) * max(focus_texels_per_pixel(), 1.0e-3);
+    float4 outer = float4(0.0, 0.0, 0.0, 0.0);
+    float4 outer_solved[2] = {outer, outer};
+    [branch] if (!focus || near_edge) {
+        uint coarse = max(PeripheryCell, Cell);
+        uint ratio = max(coarse / max(Cell, 1u), 1u);
+        uint2 grid = (uint2(TargetRect.zw) + coarse - 1u) / coarse;
+        periphery_cell(index / ratio, grid, coarse, outer, outer_solved);
+    }
+    result = outer;
+    solved_out = outer_solved;
+    [branch] if (focus) {
+        float4 inner;
+        float4 inner_solved[2];
+        focus_cell(index, pixel, position, inner, inner_solved);
+        result = near_edge ? focus_feather(inner, outer) : inner;
+        solved_out[0] = near_edge ? focus_feather(inner_solved[0], outer_solved[0]) : inner_solved[0];
+        solved_out[1] = near_edge ? focus_feather(inner_solved[1], outer_solved[1]) : inner_solved[1];
+    }
+}
+
+[numthreads(8, 8, 1)]
+void DcsMotionResampleCS(uint3 thread_id : SV_DispatchThreadID) {
+    if (thread_id.x >= OutputWidth || thread_id.y >= OutputHeight) {
+        return;
+    }
+    float4 result;
+    float4 solved[2];
+    [branch] if ((FocusFlags & 1u) != 0u) {
+        fine_cell(thread_id.xy, result, solved);
+    } else {
+        periphery_cell(thread_id.xy, uint2(OutputWidth, OutputHeight), Cell, result, solved);
+    }
+    MotionTarget[uint3(thread_id.xy, Slice * 3u)] = result;
+    [unroll] for (uint output = 0u; output < 2u; ++output) {
+        MotionTarget[uint3(thread_id.xy, Slice * 3u + 1u + output)] = solved[output];
         ScatterTarget[uint3(thread_id.xy, Slice * 2u + output)] = 0u;
     }
 }
