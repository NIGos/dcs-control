+    std::vector<std::uint8_t> motion(static_cast<std::size_t>(atlas_w) * atlas_h * 4U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(atlas_w) * atlas_h, 7);
+    std::vector<std::uint8_t> depth(static_cast<std::size_t>(atlas_w) * atlas_h * 2U, 0);
+    const auto put = [&](UINT x0, UINT y0, UINT ox, UINT oy, UINT tw, UINT th, UINT d) {
+        for (UINT j = 0; j < th; ++j) {
+            for (UINT i = 0; i < tw; ++i) {
+                const double x = ox + (i + 0.5) * d, y = oy + (j + 0.5) * d;
+                float mx = 0.0F, my = 0.0F, metres = 65504.0F;
+                std::uint8_t klass = 7;
+                for (const DcsMotionLayer& layer : scene.layers) {
+                    if (!layer.opaque) continue;
+                    const auto uv = dcs_motion_texture_point(layer, x, y, from, w, h);
+                    if (dcs_motion_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) {
+                        const auto then = dcs_motion_screen_point(layer, uv[0], uv[1], to, w, h);
+                        mx = static_cast<float>((then[0] - x) / d);
+                        my = static_cast<float>((then[1] - y) / d);
+                        klass = layer.klass;
+                        metres = (klass & 0x80U) != 0U ? 65504.0F : 1000.0F;
+                        break;
+                    }
+                }
+                for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                    const std::size_t t = static_cast<std::size_t>(y0 + j) * atlas_w + eye * tw + x0 + i;
+                    const std::uint16_t hx = dcs_motion_half(mx), hy = dcs_motion_half(my);
+                    const std::uint16_t hd = depth_test_half(metres);
+                    std::memcpy(&motion[t * 4U], &hx, 2);
+                    std::memcpy(&motion[t * 4U + 2U], &hy, 2);
+                    std::memcpy(&depth[t * 2U], &hd, 2);
+                    classes[t] = klass;
+                }
+            }
+        }
+    };
+    put(0, 0, 0, 0, rw, rh, pd);
+    put(0, rh, ix, iy, fw, fh, divisor);
+    frame.motion_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16G16_FLOAT, 4, motion);
+    frame.motion_class_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R8_UINT, 1, classes);
+    frame.motion_depth_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16_FLOAT, 2, depth);
+    frame.motion_depth = true;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        frame.motion_views[eye].x = eye * rw;
+        auto& focus = frame.motion_focus_views[eye];
+        focus.valid = true;
+        focus.x = eye * fw;
+        focus.y = rh;
+        focus.width = fw;
+        focus.height = fh;
+        focus.fov_tan = {left + (right - left) * float(ix) / float(width),
+            left + (right - left) * float(ix + fw * divisor) / float(width), up - (up - down) * float(iy) / float(height),
+            up - (up - down) * float(iy + fh * divisor) / float(height)};
+        focus.depth = true;
+    }
+}
