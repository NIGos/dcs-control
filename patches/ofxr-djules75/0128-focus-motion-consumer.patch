+void add_dcs_motion_focus(D3D12WarpFixture& fixture, const DcsMotionScene& scene, UINT width, UINT height,
+    const ReprojectionViews& views, xrfg::D3D12CockpitMaskFrame& frame, UINT divisor, double from = 1.0,
