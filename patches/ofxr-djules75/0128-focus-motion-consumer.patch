+// DCS Control (0128): fixtures for [ofxr] dcs_motion_focus (motion contract
+// revision 4: the focus views' own MVs and class, the per-pixel depth plane).
+// XRFG_TEST_FG_FOCUS_MOTION=1 on NVIDIA hardware (ctest
+// xrfg_d3d12_fg_focus_motion). Every scene is drawn exactly at the previous
+// capture (s = 0), the current one (s = 1) and halfway (the truth), from rigid
+// layers (front first). Each frame carries what the engine module exports:
+// the periphery's MVs and classes over the whole image at the periphery's
+// texel (10 output pixels a texel), and the focus view's over the inset (the
+// image's middle half each way, 2 output pixels a texel; "d1": 1) with its
+// per-pixel linear depth. The resample's cell is forced to 8 (the headset's
+// eye image's) for every composition along the MVs, so the fine grid is 4.
+// Compositions:
+//   flow          the optical flow alone ([ofxr] dcs_motion off)
+//   today         the MVs, key off (the focus data in the frame, left out)
+//   focus         key on, focus MVs + class + depth (the edge-aware filter)
+//   focus-class   key on, focus MVs + class, no depth plane
+// and two that must equal `today` byte for byte: key off without focus data,
+// and key on with a frame from an older producer (no focus data). Errors in
+// sRGB units (0-255) per region of the true middle frame:
+//   model     an aircraft (DCS's model class) and 4 px around it
+//   trailing  what a model covers in one real frame but not at the middle one
+//   behind / ahead   its disocclusion / occlusion zones
+//   wires     power lines, 2 px around them
+//   inset     every pixel inside the focus inset; outside: every other pixel
+//   rest      everything else; all: every pixel.
+// Scenes, each by day and in the dark (a quarter of the light):
+//   flight  the 0120 flight scene (sky and terrain rolling 1.5 degrees,
+//           wires, an aircraft over the terrain in the inset, one in the sky
+//           in the periphery)
+//   orbit   the F2 orbit: an aircraft still in the middle of the inset, the
+//           world behind it sliding 18 px and rolling half a degree a pair
+//   small   distant aircraft of 1 to 3 periphery texels (12-30 px), two in
+//           the inset (one 12 px with a 2 px light-sized tail fin), one in the
+//           periphery, crossing a rolling world
+// Options in the variable's value: "x4" (2560 x 1920, the motion four times
+// as many pixels: the flow's search range at a headset's scale), "d1" (the
+// focus MVs per output pixel too), "dump" with XRFG_TEST_DUMP_DIR.
+
+struct FmLayer {
+    int texture;
+    double scale;
+    double roll;   // radians at s = 1, about the image centre
+    double dx, dy; // pixels at s = 1
+    int shape;
+    std::uint8_t klass;
+    double depth;  // metres (the depth plane), 65504 the sky
+    std::array<double, 3> tint;
+};
+
+enum FmShape : int {
+    kFmFull = 0, kFmWires = 1, kFmModelLow = 2, kFmModelHigh = 3, kFmTerrain = 4, kFmOrbit = 5,
+    kFmSmallA = 6, kFmSmallB = 7, kFmSmallC = 8,
+};
+
+double fm_cover(int shape, double u, double v, double w, double h) {
+    const auto aircraft = [&](double cx, double cy, double half_length, double half_body, double half_span) {
+        const bool body = std::abs(v - cy) < half_body && std::abs(u - cx) < half_length;
+        const bool wing = std::abs(u - cx + half_length * 0.1) < std::max(1.0, half_length * 0.22) &&
+            std::abs(v - cy) < half_span;
+        const bool tail = std::abs(u - cx + half_length * 0.88) < std::max(1.0, half_length * 0.12) &&
+            std::abs(v - cy) < std::max(1.5, half_span * 0.45);
+        return body || wing || tail;
+    };
+    switch (shape) {
+    case kFmWires: {
+        const double line1 = h * 0.40 + 0.06 * (u - w * 0.5);
+        const double line2 = h * 0.58 - 0.04 * (u - w * 0.5);
+        return std::abs(v - line1) < 0.9 || std::abs(v - line2) < 0.7 ? 1.0 : 0.0;
+    }
+    case kFmModelLow: // an aircraft over the terrain, inside the inset
+        return aircraft(w * 0.40, h * 0.62, 52.0, 9.0, 40.0) ? 1.0 : 0.0;
+    case kFmModelHigh: // another one in the sky, in the periphery
+        return aircraft(w * 0.62, h * 0.16, 40.0, 7.0, 30.0) ? 1.0 : 0.0;
+    case kFmTerrain:
+        return v > h * 0.45 + 0.08 * (u - w * 0.5) ? 1.0 : 0.0;
+    case kFmOrbit: // the orbited aircraft, filling much of the inset
+        return aircraft(w * 0.5, h * 0.5, 70.0, 11.0, 52.0) ? 1.0 : 0.0;
+    case kFmSmallA: // 12 px: about one periphery texel
+        return aircraft(w * 0.42, h * 0.40, 6.0, 1.5, 5.0) ? 1.0 : 0.0;
+    case kFmSmallB: // 30 px: three periphery texels
+        return aircraft(w * 0.60, h * 0.58, 15.0, 2.5, 11.0) ? 1.0 : 0.0;
+    case kFmSmallC: // 20 px in the periphery
+        return aircraft(w * 0.14, h * 0.18, 10.0, 2.0, 8.0) ? 1.0 : 0.0;
+    default:
+        return 1.0;
+    }
+}
+
+std::array<double, 2> fm_texture_point(const FmLayer& layer, double x, double y, double s, double w, double h) {
+    const double a = -layer.roll * s;
+    const double px = x - w * 0.5 - layer.dx * s;
+    const double py = y - h * 0.5 - layer.dy * s;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5, std::sin(a) * px + std::cos(a) * py + h * 0.5};
+}
+
+std::array<double, 2> fm_screen_point(const FmLayer& layer, double u, double v, double s, double w, double h) {
+    const double a = layer.roll * s;
+    const double px = u - w * 0.5, py = v - h * 0.5;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5 + layer.dx * s,
+        std::sin(a) * px + std::cos(a) * py + h * 0.5 + layer.dy * s};
+}
+
+// The front layer at output point (x, y) at instant s, and its texture point.
+int fm_front(const std::vector<FmLayer>& layers, double x, double y, double s, double w, double h,
+    std::array<double, 2>& uv) {
+    for (std::size_t index = 0; index < layers.size(); ++index) {
+        uv = fm_texture_point(layers[index], x, y, s, w, h);
+        if (fm_cover(layers[index].shape, uv[0], uv[1], w, h) > 0.5) return static_cast<int>(index);
+    }
+    return -1;
+}
+
+struct FmFrame {
+    StereoPattern image;
+    std::vector<std::int8_t> front;
+};
+
+FmFrame fm_frame(const std::vector<FmLayer>& layers, UINT width, UINT height, double s) {
+    FmFrame frame;
+    frame.front.assign(static_cast<std::size_t>(width) * height, -1);
+    std::vector<std::uint8_t> bytes(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+    const double w = width, h = height;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            std::array<double, 2> uv{};
+            const int index = fm_front(layers, x + 0.5, y + 0.5, s, w, h, uv);
+            std::array<double, 3> colour{0.0, 0.0, 0.0};
+            if (index >= 0) {
+                const FmLayer& layer = layers[static_cast<std::size_t>(index)];
+                const auto texel = occlusion_texture(uv[0] * layer.scale, uv[1] * layer.scale, layer.texture);
+                colour = {texel[0] * layer.tint[0], texel[1] * layer.tint[1], texel[2] * layer.tint[2]};
+            }
+            frame.front[static_cast<std::size_t>(y) * width + x] = static_cast<std::int8_t>(index);
+            const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+            for (int c = 0; c < 3; ++c) bytes[i + c] = static_cast<std::uint8_t>(std::clamp(colour[c], 0.0, 255.0) + 0.5);
+            bytes[i + 3] = 255;
+        }
+    }
+    for (UINT eye = 0; eye < kEyeCount; ++eye) frame.image[eye] = bytes;
+    return frame;
+}
+
+// The focus inset in output pixels: the image's middle half each way.
+struct FmInset {
+    UINT x, y, width, height;
+    [[nodiscard]] bool inside(UINT px, UINT py) const noexcept {
+        return px >= x && px < x + width && py >= y && py < y + height;
+    }
+};
+
+FmInset fm_inset(UINT width, UINT height) {
+    return {width / 4U, height / 4U, width / 2U, height / 2U};
+}
+
+// One MV grid (MVs in its own texels, class, depth) over output rect (ox, oy,
+// texels w x h of `divisor` pixels) of the scene from instant `from` to `to`.
+struct FmGrid {
+    UINT width{}, height{};
+    std::vector<float> mx, my, depth;
+    std::vector<std::uint8_t> klass;
+};
+
+FmGrid fm_grid(const std::vector<FmLayer>& layers, UINT width, UINT height, UINT ox, UINT oy, UINT texels_x,
+    UINT texels_y, UINT divisor, double from, double to) {
+    FmGrid grid;
+    grid.width = texels_x;
+    grid.height = texels_y;
+    const std::size_t n = static_cast<std::size_t>(texels_x) * texels_y;
+    grid.mx.assign(n, 0.0F);
+    grid.my.assign(n, 0.0F);
+    grid.depth.assign(n, 65504.0F);
+    grid.klass.assign(n, 7);
+    const double w = width, h = height, d = divisor;
+    for (UINT j = 0; j < texels_y; ++j) {
+        for (UINT i = 0; i < texels_x; ++i) {
+            const double x = ox + (i + 0.5) * d, y = oy + (j + 0.5) * d;
+            std::array<double, 2> uv{};
+            const int index = fm_front(layers, x, y, from, w, h, uv);
+            if (index < 0) continue;
+            const FmLayer& layer = layers[static_cast<std::size_t>(index)];
+            const auto then = fm_screen_point(layer, uv[0], uv[1], to, w, h);
+            const std::size_t t = static_cast<std::size_t>(j) * texels_x + i;
+            grid.mx[t] = static_cast<float>((then[0] - x) / d);
+            grid.my[t] = static_cast<float>((then[1] - y) / d);
+            grid.klass[t] = layer.klass;
+            grid.depth[t] = static_cast<float>(layer.depth);
+        }
+    }
+    return grid;
+}
+
+struct FmFrameData {
+    bool motion{};
+    UINT focus_divisor{}; // 0: no focus data (an older producer)
+    bool depth{};
+    bool depth_checker{}; // the plane's texels alternate 10 m / 1000 m (a test that it is read)
+};
+
+// The current frame's mask frame as the consumer hands it on: no cockpit, the
+// periphery's MVs (divisor 10) over the whole image, both eyes side by side
+// in the atlas's first rows, and with `data.focus_divisor` the focus view's
+// over the inset below them (with `data.depth` its depth plane), pointing at
+// `previous_display_time`; the current frame is the scene at `from`, the
+// previous one at `to`.
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> fm_mask_frame(D3D12WarpFixture& fixture, const std::vector<FmLayer>& layers,
+    UINT width, UINT height, const ReprojectionViews& views, std::int64_t display_time,
+    std::int64_t previous_display_time, const FmFrameData& data,
+    const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters, double from = 1.0, double to = 0.0) {
+    auto frame = make_cockpit_mask_frame(fixture, width, height, {}, 8, views);
+    frame->display_time = display_time;
+    frame->counters = counters;
+    if (!data.motion) return frame;
+    constexpr UINT kPeriphery = 10;
+    const UINT rw = (width + kPeriphery - 1U) / kPeriphery, rh = (height + kPeriphery - 1U) / kPeriphery;
+    const FmGrid periphery = fm_grid(layers, width, height, 0, 0, rw, rh, kPeriphery, from, to);
+    const FmInset inset = fm_inset(width, height);
+    const UINT fd = std::max(data.focus_divisor, 1U);
+    const UINT fw = data.focus_divisor != 0 ? inset.width / fd : 0U;
+    const UINT fh = data.focus_divisor != 0 ? inset.height / fd : 0U;
+    const FmGrid focus = data.focus_divisor != 0
+        ? fm_grid(layers, width, height, inset.x, inset.y, fw, fh, fd, from, to)
+        : FmGrid{};
+    const UINT atlas_w = std::max(rw * kEyeCount, fw * kEyeCount), atlas_h = rh + fh;
+    std::vector<std::uint8_t> motion(static_cast<std::size_t>(atlas_w) * atlas_h * 4U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(atlas_w) * atlas_h, 7);
+    std::vector<std::uint8_t> depth(static_cast<std::size_t>(atlas_w) * atlas_h * 2U, 0);
+    const auto put = [&](const FmGrid& grid, UINT x0, UINT y0, bool checker) {
+        for (UINT j = 0; j < grid.height; ++j) {
+            for (UINT i = 0; i < grid.width; ++i) {
+                const std::size_t s = static_cast<std::size_t>(j) * grid.width + i;
+                const std::size_t t = static_cast<std::size_t>(y0 + j) * atlas_w + x0 + i;
+                const std::uint16_t hx = dcs_motion_half(grid.mx[s]), hy = dcs_motion_half(grid.my[s]);
+                const std::uint16_t hd = depth_test_half(checker && ((i + j) & 1U) != 0U ? 10.0F : (checker ? 1000.0F : grid.depth[s]));
+                std::memcpy(&motion[t * 4U], &hx, 2);
+                std::memcpy(&motion[t * 4U + 2U], &hy, 2);
+                std::memcpy(&depth[t * 2U], &hd, 2);
+                classes[t] = grid.klass[s];
+            }
+        }
+    };
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        put(periphery, eye * rw, 0, false);
+        if (data.focus_divisor != 0) put(focus, eye * fw, rh, data.depth_checker);
+    }
+    frame->motion_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16G16_FLOAT, 4, motion);
+    frame->motion_class_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R8_UINT, 1, classes);
+    frame->motion = true;
+    frame->motion_class = true;
+    frame->motion_previous_display_time = previous_display_time;
+    frame->motion_slot_flags = 0x80U | 0x40U | 0x3U;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        auto& view = frame->motion_views[eye];
+        view.valid = true;
+        view.x = eye * rw;
+        view.y = 0;
+        view.width = rw;
+        view.height = rh;
+        view.fov_tan = {left, left + (right - left) * float(rw * kPeriphery) / float(width), up,
+            up - (up - down) * float(rh * kPeriphery) / float(height)};
+        if (data.focus_divisor != 0) {
+            auto& focus_view = frame->motion_focus_views[eye];
+            focus_view.valid = true;
+            focus_view.x = eye * fw;
+            focus_view.y = rh;
+            focus_view.width = fw;
+            focus_view.height = fh;
+            focus_view.fov_tan = {left + (right - left) * float(inset.x) / float(width),
+                left + (right - left) * float(inset.x + fw * fd) / float(width),
+                up - (up - down) * float(inset.y) / float(height),
+                up - (up - down) * float(inset.y + fh * fd) / float(height)};
+            focus_view.depth = data.depth;
+        }
+    }
+    if (data.focus_divisor != 0 && data.depth) {
+        frame->motion_depth_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16_FLOAT, 2, depth);
+        frame->motion_depth = true;
+    }
+    return frame;
+}
+
+struct FmCase {
+    std::string name;
+    std::vector<FmLayer> layers;
+};
+
+std::vector<FmCase> fm_cases(double factor) {
+    const double pi = 3.14159265358979;
+    std::vector<FmCase> cases;
+    for (const bool dark : {false, true}) {
+        const double k = dark ? 0.25 : 1.0;
+        const std::string light = dark ? " dark" : " day";
+        const std::array<double, 3> sky{0.6 * k, 0.75 * k, 1.1 * k};
+        const double roll = 1.5 * pi / 180.0;
+        cases.push_back({"flight" + light, {
+            {1, 1.0, roll, 26.0, -6.0, kFmModelLow, 1, 400.0, {0.8 * k, 0.8 * k, 0.9 * k}},
