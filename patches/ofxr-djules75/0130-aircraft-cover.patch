+// DCS Control (0130): fixtures for [ofxr] dcs_motion_cover (lever 1: a
+// distant aircraft's vector and class spread over its edge; lever 2: a sky
+// gather with an aircraft within reach accepted only after the aircraft's own
+// vector was tried). XRFG_TEST_FG_COVER=1 on NVIDIA hardware (ctest
+// xrfg_d3d12_fg_cover). Every scene is drawn at the previous capture (s = 0),
+// the current one (s = 1) and halfway (the truth), 3 x 3 samples a pixel,
+// layers front first, each opaque or translucent; a layer is in DCS's G-buffer
+// (MVs and class at the MV texels' centres, as DCS's own targets are sampled)
+// or drawn after it (HUD, smoke, lights: no MV, the sky's class and vector
+// below them). The periphery's MVs are d10 (10 output pixels a texel, the
+// headset's); "d2" runs add the focus view's MVs over the image's middle half
+// at d2 with its depth plane ([ofxr] dcs_motion_focus). The images are read
+// through an sRGB view (the periphery swapchain's: linear light), the cell is
+// the headset's (8; the fine grid 4).
+// Scenes (day; the crossing also at dusk, a quarter of the light):
+//   m0b       the motion study's small-aircraft case: aircraft 4, 6 and 8 px
+//             long and 2 px tall (under one MV texel), each with a 2 px light
+//             (no MV), crossing the sky 5-9 px a pair over a rolling world
+//   crossing  four faint aircraft (side view, 8-14 codes from the sky) at the
+//             sizes and speeds of 450, 900, 1200 and 1800 m on the headset
+//             (93, 47, 35, 23 px long; 27, 14, 10, 7 px a pair)
+//   orbit     the F2 orbit: an aircraft still, the world behind it sliding
+//   hud       HUD strokes fixed on the image (drawn after the G-buffer) over a
+//             rolling sky, a far aircraft crossing behind them
+//   wires     power lines (thin G-buffer surfaces) over the sky and terrain,
+//             with an aircraft crossing near them
+//   smoke     an aircraft trailing a translucent smoke band (no MV)
+// Measures per region of the true middle frame (sRGB units, MAE): obj (the
+// aircraft at the middle instant), model (obj and 4 px around: the aircraft
+// band), trail / lead (where it is in one real frame only), band (1-6 px
+// around those: the halo), far (40 px away), and hud, smoke, wires, lights;
+// "cross-fade fraction" (sum |out - truth| over obj, trail and lead against
+// the same for the plain cross-fade of the two frames: 1 = a cross-fade,
+// 0 = the truth); "within 1 px" (the share of obj pixels whose value is the
+// one a composition along the aircraft's true motion, to within 1 px of it,
+// gives: within 4 codes of the nearest of the nine such samples).
+// Gates: the key on never makes the HUD, smoke, wires, far or the whole image
+// worse than the key off beyond the blend's slack; without MVs the key changes
+// nothing; the crossing's cross-fade fraction goes down.
+
+struct FcLayer {
+    std::string tag;
+    int shape;
+    double cx, cy, length; // the shape's place and size at s = 0 (pixels)
+    double dx, dy;         // translation at s = 1 (pixels)
+    double roll;           // radians at s = 1, about the image centre
+    std::uint8_t klass;
+    double depth;          // metres (the depth plane), 65504 the sky
+    std::array<double, 3> colour; // 0-255 (flat), or the texture's tint (textured)
+    int texture;           // -1 flat
+    double scale;
+    bool gbuffer;          // in DCS's G-buffer (MVs, class)
+    double alpha;
+};
+
+enum FcShape : int { kFcFull = 0, kFcTerrain, kFcAircraft, kFcLight, kFcHud, kFcWires, kFcSmoke };
+
+bool fc_inside(const FcLayer& layer, double u, double v, double w, double h) {
+    switch (layer.shape) {
+    case kFcFull:
+        return true;
+    case kFcTerrain:
+        return v > h * 0.68 + 0.05 * (u - w * 0.5);
+    case kFcAircraft: { // side view, nose to +x
+        const double l = layer.length, half = std::max(1.0, l / 14.0);
+        const double x = u - layer.cx, y = v - layer.cy;
+        const bool body = std::abs(y) < half && std::abs(x) < l * 0.5;
+        const bool fin = x > -l * 0.5 && x < -l * 0.5 + std::max(1.5, l * 0.14) && y > -std::max(1.5, l * 0.2) && y <= 0.0;
+        const bool wing = std::abs(y - half * 0.3) < std::max(0.5, l / 60.0) && std::abs(x + l * 0.05) < l * 0.28;
+        return body || fin || wing;
+    }
+    case kFcLight:
+        return std::abs(u - layer.cx) < 1.0 && std::abs(v - layer.cy) < 1.0;
+    case kFcHud: { // a pitch ladder and a cross, fixed on the image
+        const double x = u - layer.cx, y = v - layer.cy;
+        for (int k = -2; k <= 2; ++k) {
+            if (std::abs(y - 26.0 * k) < 0.75 && std::abs(x) < 46.0 && std::abs(x) > 12.0) return true;
+        }
+        return (std::abs(x) < 0.75 && std::abs(y) < 9.0) || (std::abs(y) < 0.75 && std::abs(x) < 9.0);
+    }
+    case kFcWires: {
+        const double line1 = h * 0.42 + 0.06 * (u - w * 0.5);
+        const double line2 = h * 0.47 - 0.03 * (u - w * 0.5);
+        return std::abs(v - line1) < 0.9 || std::abs(v - line2) < 0.7;
+    }
+    case kFcSmoke: { // a widening band behind (-x) the point (cx, cy), `length` long
+        const double back = layer.cx - u;
+        return back > 0.0 && back < layer.length && std::abs(v - layer.cy) < 2.5 + 0.05 * back;
+    }
+    default:
+        return false;
+    }
+}
+
+std::array<double, 2> fc_texture_point(const FcLayer& layer, double x, double y, double s, double w, double h) {
+    const double a = -layer.roll * s;
+    const double px = x - w * 0.5 - layer.dx * s, py = y - h * 0.5 - layer.dy * s;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5, std::sin(a) * px + std::cos(a) * py + h * 0.5};
+}
+
+std::array<double, 2> fc_screen_point(const FcLayer& layer, double u, double v, double s, double w, double h) {
+    const double a = layer.roll * s;
+    const double px = u - w * 0.5, py = v - h * 0.5;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5 + layer.dx * s,
+        std::sin(a) * px + std::cos(a) * py + h * 0.5 + layer.dy * s};
+}
+
+std::array<double, 3> fc_layer_colour(const FcLayer& layer, double u, double v) {
+    if (layer.texture < 0) return layer.colour;
+    const auto texel = occlusion_texture(u * layer.scale, v * layer.scale, layer.texture);
+    return {texel[0] * layer.colour[0] / 255.0, texel[1] * layer.colour[1] / 255.0, texel[2] * layer.colour[2] / 255.0};
+}
+
+// The colour at point (x, y) at instant s: the layers front to back.
+std::array<double, 3> fc_point(const std::vector<FcLayer>& layers, double x, double y, double s, double w, double h) {
+    std::array<double, 3> colour{0.0, 0.0, 0.0};
+    double through = 1.0;
+    for (const FcLayer& layer : layers) {
+        const auto uv = fc_texture_point(layer, x, y, s, w, h);
+        if (!fc_inside(layer, uv[0], uv[1], w, h)) continue;
+        const auto c = fc_layer_colour(layer, uv[0], uv[1]);
+        for (int k = 0; k < 3; ++k) colour[k] += through * layer.alpha * c[k];
+        through *= 1.0 - layer.alpha;
+        if (through < 1.0e-4) break;
+    }
+    return colour;
+}
+
+StereoPattern fc_frame(const std::vector<FcLayer>& layers, UINT width, UINT height, double s) {
+    std::vector<std::uint8_t> bytes(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+    const double w = width, h = height;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            std::array<double, 3> sum{0.0, 0.0, 0.0};
+            for (int j = 0; j < 3; ++j) {
+                for (int i = 0; i < 3; ++i) {
+                    const auto c = fc_point(layers, x + (i + 0.5) / 3.0, y + (j + 0.5) / 3.0, s, w, h);
+                    for (int k = 0; k < 3; ++k) sum[k] += c[k];
+                }
+            }
+            const std::size_t at = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+            for (int k = 0; k < 3; ++k) bytes[at + k] = static_cast<std::uint8_t>(std::clamp(sum[k] / 9.0, 0.0, 255.0) + 0.5);
+            bytes[at + 3] = 255;
+        }
+    }
+    StereoPattern image;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) image[eye] = bytes;
+    return image;
+}
+
+// The G-buffer's front layer at a point (layers drawn after it are not there).
+int fc_gbuffer_front(const std::vector<FcLayer>& layers, double x, double y, double s, double w, double h,
+    std::array<double, 2>& uv) {
+    for (std::size_t index = 0; index < layers.size(); ++index) {
+        if (!layers[index].gbuffer) continue;
+        uv = fc_texture_point(layers[index], x, y, s, w, h);
+        if (fc_inside(layers[index], uv[0], uv[1], w, h)) return static_cast<int>(index);
+    }
+    return -1;
+}
+
+// One MV grid of `divisor` px texels over output rect (ox, oy), texels x
+// texels, from instant `from` to `to`: class, MV and depth at each texel's
+// centre (no coverage: a model narrower than a texel is seen only where it
+// covers a centre).
+FmGrid fc_grid(const std::vector<FcLayer>& layers, UINT width, UINT height, UINT ox, UINT oy, UINT texels_x,
+    UINT texels_y, UINT divisor, double from, double to) {
+    FmGrid grid;
+    grid.width = texels_x;
+    grid.height = texels_y;
+    const std::size_t n = static_cast<std::size_t>(texels_x) * texels_y;
+    grid.mx.assign(n, 0.0F);
+    grid.my.assign(n, 0.0F);
+    grid.depth.assign(n, 65504.0F);
+    grid.klass.assign(n, 0x80);
+    const double w = width, h = height, d = divisor;
+    for (UINT j = 0; j < texels_y; ++j) {
+        for (UINT i = 0; i < texels_x; ++i) {
+            const double x = ox + (i + 0.5) * d, y = oy + (j + 0.5) * d;
+            std::array<double, 2> uv{};
+            const int index = fc_gbuffer_front(layers, x, y, from, w, h, uv);
+            if (index < 0) continue;
+            const FcLayer& layer = layers[static_cast<std::size_t>(index)];
+            const auto then = fc_screen_point(layer, uv[0], uv[1], to, w, h);
+            const std::size_t t = static_cast<std::size_t>(j) * texels_x + i;
+            grid.mx[t] = static_cast<float>((then[0] - x) / d);
+            grid.my[t] = static_cast<float>((then[1] - y) / d);
+            grid.klass[t] = layer.klass;
+            grid.depth[t] = static_cast<float>(layer.depth);
+        }
+    }
+    return grid;
+}
+
+// The mask frame the consumer hands on: as fm_mask_frame (periphery d10 over
+// the image, with `focus_divisor` the focus view's over the middle half and
+// its depth plane), from fc_grid.
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> fc_mask_frame(D3D12WarpFixture& fixture, const std::vector<FcLayer>& layers,
+    UINT width, UINT height, const ReprojectionViews& views, std::int64_t display_time,
+    std::int64_t previous_display_time, UINT focus_divisor, const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters,
+    double from, double to) {
