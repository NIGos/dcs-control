+    const FmInset inset = fm_inset(width, height);
+    const UINT fd = std::max(focus_divisor, 1U);
+    const UINT fw = focus_divisor != 0 ? inset.width / fd : 0U;
+    const UINT fh = focus_divisor != 0 ? inset.height / fd : 0U;
+    const FmGrid focus = focus_divisor != 0 ? fc_grid(layers, width, height, inset.x, inset.y, fw, fh, fd, from, to)
+                                            : FmGrid{};
+    const UINT atlas_w = std::max(rw * kEyeCount, fw * kEyeCount), atlas_h = rh + fh;
+    std::vector<std::uint8_t> motion(static_cast<std::size_t>(atlas_w) * atlas_h * 4U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(atlas_w) * atlas_h, 0x80);
+    std::vector<std::uint8_t> depth(static_cast<std::size_t>(atlas_w) * atlas_h * 2U, 0);
+    const auto put = [&](const FmGrid& grid, UINT x0, UINT y0) {
+        for (UINT j = 0; j < grid.height; ++j) {
+            for (UINT i = 0; i < grid.width; ++i) {
+                const std::size_t s = static_cast<std::size_t>(j) * grid.width + i;
+                const std::size_t t = static_cast<std::size_t>(y0 + j) * atlas_w + x0 + i;
+                const std::uint16_t hx = dcs_motion_half(grid.mx[s]), hy = dcs_motion_half(grid.my[s]);
+                const std::uint16_t hd = depth_test_half(grid.depth[s]);
+                std::memcpy(&motion[t * 4U], &hx, 2);
+                std::memcpy(&motion[t * 4U + 2U], &hy, 2);
+                std::memcpy(&depth[t * 2U], &hd, 2);
+                classes[t] = grid.klass[s];
+            }
+        }
+    };
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        put(periphery, eye * rw, 0);
+        if (focus_divisor != 0) put(focus, eye * fw, rh);
+    }
+    frame->motion_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16G16_FLOAT, 4, motion);
+    frame->motion_class_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R8_UINT, 1, classes);
+    frame->motion = true;
+    frame->motion_class = true;
+    frame->motion_previous_display_time = previous_display_time;
+    frame->motion_slot_flags = 0x80U | 0x40U | 0x3U;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        auto& view = frame->motion_views[eye];
+        view.valid = true;
+        view.x = eye * rw;
+        view.y = 0;
+        view.width = rw;
+        view.height = rh;
+        view.fov_tan = {left, left + (right - left) * float(rw * kPeriphery) / float(width), up,
+            up - (up - down) * float(rh * kPeriphery) / float(height)};
+        if (focus_divisor != 0) {
+            auto& focus_view = frame->motion_focus_views[eye];
+            focus_view.valid = true;
+            focus_view.x = eye * fw;
+            focus_view.y = rh;
+            focus_view.width = fw;
+            focus_view.height = fh;
+            focus_view.fov_tan = {left + (right - left) * float(inset.x) / float(width),
+                left + (right - left) * float(inset.x + fw * fd) / float(width),
+                up - (up - down) * float(inset.y) / float(height),
+                up - (up - down) * float(inset.y + fh * fd) / float(height)};
+            focus_view.depth = true;
+        }
+    }
+    if (focus_divisor != 0) {
+        frame->motion_depth_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16_FLOAT, 2, depth);
+        frame->motion_depth = true;
+    }
+    return frame;
+}
+
+struct FcScene {
+    std::string name;
+    std::vector<FcLayer> layers;
+};
+
+std::vector<FcScene> fc_scenes(UINT width, UINT height) {
+    const double pi = 3.14159265358979;
+    const double w = width, h = height;
+    const double roll = 0.4 * pi / 180.0; // the world rolling a little (the ownship)
+    std::vector<FcScene> scenes;
+    const auto sky = [&](double k, double world_dx) {
+        return FcLayer{"sky", kFcFull, 0, 0, 0, world_dx, 0.0, roll, 0x80, 65504.0, {150.0 * k, 185.0 * k, 225.0 * k},
+            3, 0.35, true, 1.0};
+    };
+    const auto terrain = [&](double k, double world_dx) {
+        return FcLayer{"terrain", kFcTerrain, 0, 0, 0, world_dx, 2.0, roll, 0, 3000.0, {255.0 * k, 255.0 * k, 255.0 * k},
+            0, 1.0, true, 1.0};
+    };
+    const auto aircraft = [&](const std::string& tag, double cx, double cy, double length, double speed,
+                              std::array<double, 3> colour, double depth) {
+        return FcLayer{tag, kFcAircraft, cx, cy, length, speed, 0.0, 0.0, 1, depth, colour, -1, 1.0, true, 1.0};
+    };
+    // m0b: aircraft 4-8 px long, 2 px tall, under one texel, each with a 2 px
+    // light (no MV) at its nose; crossing the sky over a rolling world.
+    {
+        FcScene scene{"m0b day", {}};
+        const std::array<double, 3> grey{118.0, 124.0, 132.0};
+        const std::array<std::array<double, 3>, 3> placements{{{w * 0.36, h * 0.30, 4.0}, {w * 0.52, h * 0.44, 6.0},
+            {w * 0.62, h * 0.56, 8.0}}};
+        const std::array<double, 3> speeds{5.0, 7.0, 9.0};
+        for (std::size_t i = 0; i < placements.size(); ++i) {
+            const auto& p = placements[i];
+            const std::string tag = "a" + std::to_string(int(p[2]));
+            scene.layers.push_back(FcLayer{tag + "light", kFcLight, p[0] + p[2] * 0.5, p[1], 2.0, speeds[i], 0.0, 0.0,
+                0x80, 65504.0, {255.0, 240.0, 200.0}, -1, 1.0, false, 1.0});
+            scene.layers.push_back(aircraft(tag, p[0], p[1], p[2], speeds[i], grey, 2000.0));
+        }
+        scene.layers.push_back(terrain(1.0, 3.0));
+        scene.layers.push_back(sky(1.0, 3.0));
+        scenes.push_back(std::move(scene));
+    }
+    // crossing: four faint aircraft at 450 / 900 / 1200 / 1800 m on the
+    // headset (49 px a degree: a 15 m aircraft 93 / 47 / 35 / 23 px long),
+    // crossing at 200 m/s, a pair 22 ms apart (27 / 14 / 10 / 7 px).
+    for (const bool dusk : {false, true}) {
+        const double k = dusk ? 0.25 : 1.0;
+        FcScene scene{dusk ? "crossing dusk" : "crossing day", {}};
+        const std::array<double, 4> range{450.0, 900.0, 1200.0, 1800.0};
+        const std::array<double, 4> length{93.0, 47.0, 35.0, 23.0};
+        const std::array<double, 4> speed{27.0, 14.0, 10.0, 7.0};
+        const std::array<double, 4> row{0.16, 0.36, 0.50, 0.64};
+        // 8-14 codes from the sky (haze: the farther, the fainter).
+        const std::array<double, 4> contrast{14.0, 12.0, 10.0, 8.0};
+        for (std::size_t i = 0; i < range.size(); ++i) {
+            const double c = contrast[i];
+            scene.layers.push_back(aircraft("r" + std::to_string(int(range[i])), w * 0.48, h * row[i], length[i], speed[i],
+                {(150.0 - c) * k, (185.0 - c) * k, (225.0 - c * 1.2) * k}, range[i]));
+        }
+        scene.layers.push_back(FcLayer{"sky", kFcFull, 0, 0, 0, 2.0, 0.0, roll, 0x80, 65504.0,
+            {150.0 * k, 185.0 * k, 225.0 * k}, -1, 1.0, true, 1.0});
+        scenes.push_back(std::move(scene));
+    }
+    // crossing night (live round 2, the pilot's reference: moonlight over Kola): a grey silhouette 6-14 codes above a
+    // sky of 3 codes (sRGB bytes), with a 2 px nav light at each nose (no MV); in linear light the silhouette differs
+    // from the sky by less than 1/255.
+    {
+        FcScene scene{"crossing night", {}};
+        const std::array<double, 4> range{450.0, 900.0, 1200.0, 1800.0};
+        const std::array<double, 4> length{93.0, 47.0, 35.0, 23.0};
+        const std::array<double, 4> speed{27.0, 14.0, 10.0, 7.0};
+        const std::array<double, 4> row{0.16, 0.36, 0.50, 0.64};
+        const std::array<double, 4> lift{14.0, 11.0, 9.0, 6.0};
+        for (std::size_t i = 0; i < range.size(); ++i) {
+            const std::string tag = "r" + std::to_string(int(range[i]));
+            scene.layers.push_back(FcLayer{tag + "light", kFcLight, w * 0.48 + length[i] * 0.5, h * row[i], 2.0, speed[i],
+                0.0, 0.0, 0x80, 65504.0, {255.0, 60.0, 50.0}, -1, 1.0, false, 1.0});
+            scene.layers.push_back(aircraft(tag, w * 0.48, h * row[i], length[i], speed[i],
+                {3.0 + lift[i], 3.0 + lift[i], 5.0 + lift[i]}, range[i]));
+        }
+        scene.layers.push_back(FcLayer{"sky", kFcFull, 0, 0, 0, 2.0, 0.0, roll, 0x80, 65504.0, {3.0, 3.0, 5.0}, -1, 1.0,
+            true, 1.0});
+        scenes.push_back(std::move(scene));
+    }
+    // orbit: the F2 orbit (the aircraft still, the world sliding behind it).
+    {
+        FcScene scene{"orbit day", {}};
+        scene.layers.push_back(FcLayer{"orbited", kFcAircraft, w * 0.5, h * 0.5, 150.0, 0.0, 0.0, 0.0, 1, 30.0,
+            {200.0, 200.0, 215.0}, 1, 1.0, true, 1.0});
+        scene.layers.push_back(terrain(1.0, 18.0));
+        scene.layers.push_back(sky(1.0, 18.0));
+        scene.layers.back().roll = 0.5 * pi / 180.0;
+        scene.layers[1].roll = 0.5 * pi / 180.0;
+        scenes.push_back(std::move(scene));
+    }
+    // hud: strokes fixed on the image over a rolling sky, a far aircraft
+    // crossing behind them.
+    {
+        FcScene scene{"hud day", {}};
+        scene.layers.push_back(FcLayer{"hud", kFcHud, w * 0.5, h * 0.45, 0.0, 0.0, 0.0, 0.0, 0x80, 65504.0,
+            {90.0, 255.0, 120.0}, -1, 1.0, false, 1.0});
+        scene.layers.push_back(aircraft("r1200", w * 0.40, h * 0.45, 35.0, 10.0, {140.0, 175.0, 212.0}, 1200.0));
+        scene.layers.push_back(sky(1.0, 4.0));
+        scenes.push_back(std::move(scene));
+    }
+    // wires: power lines over the sky and terrain, an aircraft near them.
+    {
+        FcScene scene{"wires day", {}};
+        scene.layers.push_back(aircraft("r900", w * 0.40, h * 0.36, 47.0, 14.0, {136.0, 172.0, 210.0}, 900.0));
+        scene.layers.push_back(FcLayer{"wires", kFcWires, 0, 0, 0, 14.0, 7.0, roll, 0, 1500.0, {70.0, 70.0, 70.0}, -1,
+            1.0, true, 1.0});
+        scene.layers.push_back(terrain(1.0, 6.0));
+        scene.layers.push_back(sky(1.0, 6.0));
+        scenes.push_back(std::move(scene));
+    }
+    // smoke: an aircraft trailing smoke (no MV; it stays where it was made,
+    // moving with the sky).
+    {
+        FcScene scene{"smoke day", {}};
+        scene.layers.push_back(aircraft("r900", w * 0.55, h * 0.40, 47.0, 14.0, {136.0, 172.0, 210.0}, 900.0));
+        scene.layers.push_back(FcLayer{"smoke", kFcSmoke, w * 0.55 - 24.0, h * 0.40, 220.0, 2.0, 0.0, roll, 0x80,
+            65504.0, {235.0, 235.0, 235.0}, -1, 1.0, false, 0.45});
+        scene.layers.push_back(sky(1.0, 2.0));
+        scenes.push_back(std::move(scene));
+    }
+    return scenes;
+}
+
+// Regions of the true middle frame.
+struct FcRegions {
+    std::vector<std::string> names;
+    std::vector<std::vector<std::uint8_t>> masks;
+    std::vector<std::vector<std::uint8_t>> obj_masks; // per aircraft (tag order)
+    std::vector<std::string> obj_tags;
+};
+
+std::vector<std::uint8_t> fc_grow(const std::vector<std::uint8_t>& mask, UINT width, UINT height, int r) {
+    std::vector<std::uint8_t> out(mask.size(), 0);
+    for (int y = 0; y < int(height); ++y) {
+        for (int x = 0; x < int(width); ++x) {
+            if (!mask[static_cast<std::size_t>(y) * width + x]) continue;
+            for (int dy = -r; dy <= r; ++dy) {
+                for (int dx = -r; dx <= r; ++dx) {
+                    const int sx = x + dx, sy = y + dy;
+                    if (sx < 0 || sy < 0 || sx >= int(width) || sy >= int(height)) continue;
+                    out[static_cast<std::size_t>(sy) * width + sx] = 1;
+                }
+            }
+        }
+    }
+    return out;
+}
+
+// Where layers matching `which` cover the pixel centre at instant s.
+std::vector<std::uint8_t> fc_cover_mask(const FcScene& scene, UINT width, UINT height, double s,
+    const std::function<bool(const FcLayer&)>& which) {
+    std::vector<std::uint8_t> mask(static_cast<std::size_t>(width) * height, 0);
+    const double w = width, h = height;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            for (const FcLayer& layer : scene.layers) {
+                if (!which(layer)) continue;
+                const auto uv = fc_texture_point(layer, x + 0.5, y + 0.5, s, w, h);
+                if (fc_inside(layer, uv[0], uv[1], w, h)) {
+                    mask[static_cast<std::size_t>(y) * width + x] = 1;
+                    break;
+                }
+            }
+        }
+    }
+    return mask;
+}
+
+FcRegions fc_regions(const FcScene& scene, UINT width, UINT height) {
+    const std::size_t n = static_cast<std::size_t>(width) * height;
+    const auto model = [](const FcLayer& layer) { return layer.gbuffer && layer.klass == 1U; };
+    const auto obj = fc_cover_mask(scene, width, height, 0.5, model);
+    const auto at_a = fc_grow(fc_cover_mask(scene, width, height, 0.0, model), width, height, 1);
+    const auto at_b = fc_grow(fc_cover_mask(scene, width, height, 1.0, model), width, height, 1);
+    const auto obj1 = fc_grow(obj, width, height, 1);
+    std::vector<std::uint8_t> trail(n, 0), lead(n, 0), moving(n, 0);
+    for (std::size_t i = 0; i < n; ++i) {
+        trail[i] = at_a[i] && !obj1[i];
+        lead[i] = at_b[i] && !obj1[i];
+        moving[i] = obj1[i] || trail[i] || lead[i];
+    }
+    const auto model_band = fc_grow(obj, width, height, 4);
+    const auto near6 = fc_grow(moving, width, height, 6);
+    const auto near40 = fc_grow(moving, width, height, 40);
+    std::vector<std::uint8_t> band(n, 0), distant(n, 0), all(n, 1);
+    for (std::size_t i = 0; i < n; ++i) {
+        band[i] = near6[i] && !moving[i];
+        distant[i] = !near40[i];
+    }
+    const auto named = [&](int shape) {
+        return fc_grow(fc_cover_mask(scene, width, height, 0.5, [shape](const FcLayer& l) { return l.shape == shape; }),
+            width, height, 2);
+    };
+    FcRegions regions;
+    const std::vector<std::pair<std::string, std::vector<std::uint8_t>>> list{{"obj", obj}, {"model", model_band},
+        {"trail", trail}, {"lead", lead}, {"band", band}, {"far", distant}, {"hud", named(kFcHud)},
+        {"smoke", named(kFcSmoke)}, {"wires", named(kFcWires)}, {"lights", named(kFcLight)}, {"all", all}};
+    for (const auto& [name, mask] : list) {
+        std::size_t count = 0;
+        for (std::size_t i = 32U * width; i + 32U * width < n; ++i) count += mask[i];
+        if (count == 0) continue;
+        regions.names.push_back(name);
+        regions.masks.push_back(mask);
+    }
+    for (const FcLayer& layer : scene.layers) {
+        if (!model(layer)) continue;
+        regions.obj_tags.push_back(layer.tag);
+        regions.obj_masks.push_back(fc_cover_mask(scene, width, height, 0.5,
+            [&layer](const FcLayer& l) { return &l == &layer; }));
+    }
+    return regions;
+}
+
+// Bilinear sample of one eye's image (channel c) at (x, y) (pixel centres at
+// k + 0.5), clamped.
+double fc_sample(const std::vector<std::uint8_t>& image, UINT width, UINT height, double x, double y, int c) {
+    const double fx = std::clamp(x - 0.5, 0.0, double(width - 1)), fy = std::clamp(y - 0.5, 0.0, double(height - 1));
+    const UINT x0 = static_cast<UINT>(fx), y0 = static_cast<UINT>(fy);
+    const UINT x1 = std::min(x0 + 1U, width - 1U), y1 = std::min(y0 + 1U, height - 1U);
+    const double ax = fx - x0, ay = fy - y0;
+    const auto at = [&](UINT px, UINT py) { return double(image[(static_cast<std::size_t>(py) * width + px) * kBytesPerPixel + c]); };
+    return (at(x0, y0) * (1.0 - ax) + at(x1, y0) * ax) * (1.0 - ay) + (at(x0, y1) * (1.0 - ax) + at(x1, y1) * ax) * ay;
+}
+
+struct FcMeasure {
+    std::vector<double> mae;          // per region
+    double cross_fade_fraction{};     // obj + trail + lead
+    double within{};                  // obj: share composed as along the true motion (1 px)
+    std::vector<double> obj_within;   // per aircraft
+    std::vector<double> obj_fraction; // per aircraft: its own obj + trail + lead cross-fade fraction
+};
+
+FcMeasure fc_measure(const FcScene& scene, const FcRegions& regions, const StereoPattern& out, const StereoPattern& a,
+    const StereoPattern& b, const StereoPattern& truth, UINT width, UINT height) {
+    FcMeasure m;
+    for (const auto& mask : regions.masks) {
+        m.mae.push_back(depth_test_error(out, truth, width, height,
+            [&](UINT, UINT x, UINT y) { return mask[static_cast<std::size_t>(y) * width + x] != 0; }).mae);
+    }
+    const std::size_t n = static_cast<std::size_t>(width) * height;
+    const double w = width, h = height;
+    // The aircraft layer's displacement from s = 0 to s = 1 at a pixel.
+    const auto displacement = [&](const FcLayer& layer, double x, double y) {
+        const auto uv = fc_texture_point(layer, x, y, 0.5, w, h);
+        const auto p0 = fc_screen_point(layer, uv[0], uv[1], 0.0, w, h);
+        const auto p1 = fc_screen_point(layer, uv[0], uv[1], 1.0, w, h);
+        return std::array<double, 2>{p1[0] - p0[0], p1[1] - p0[1]};
+    };
+    const auto fraction = [&](const std::vector<std::uint8_t>& where) {
+        double num = 0.0, den = 0.0;
+        for (std::size_t i = 0; i < n; ++i) {
+            if (!where[i]) continue;
+            const UINT x = static_cast<UINT>(i % width), y = static_cast<UINT>(i / width);
+            if (x < 32 || y < 32 || x + 32 >= width || y + 32 >= height) continue;
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const std::size_t at = i * kBytesPerPixel;
+                for (int c = 0; c < 3; ++c) {
+                    const double t = truth[eye][at + c];
+                    num += std::abs(double(out[eye][at + c]) - t);
+                    den += std::abs(0.5 * (double(a[eye][at + c]) + double(b[eye][at + c])) - t);
+                }
+            }
+        }
+        return den > 0.0 ? num / den : 0.0;
+    };
+    const auto within = [&](const std::vector<std::uint8_t>& where, const FcLayer* only) {
+        std::size_t good = 0, total = 0;
+        for (std::size_t i = 0; i < n; ++i) {
+            if (!where[i]) continue;
+            const UINT x = static_cast<UINT>(i % width), y = static_cast<UINT>(i / width);
+            if (x < 32 || y < 32 || x + 32 >= width || y + 32 >= height) continue;
+            const FcLayer* layer = only;
+            for (const FcLayer& l : scene.layers) {
+                if (layer != nullptr) break;
+                if (!(l.gbuffer && l.klass == 1U)) continue;
+                const auto uv = fc_texture_point(l, x + 0.5, y + 0.5, 0.5, w, h);
+                if (fc_inside(l, uv[0], uv[1], w, h)) layer = &l;
+            }
+            if (layer == nullptr) continue;
+            const auto d = displacement(*layer, x + 0.5, y + 0.5);
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                double best = 1.0e9;
+                for (int j = -1; j <= 1; ++j) {
+                    for (int k = -1; k <= 1; ++k) {
+                        const double ex = d[0] + k, ey = d[1] + j;
+                        double worst = 0.0;
+                        for (int c = 0; c < 3; ++c) {
+                            const double ta = fc_sample(a[eye], width, height, x + 0.5 - 0.5 * ex, y + 0.5 - 0.5 * ey, c);
+                            const double tb = fc_sample(b[eye], width, height, x + 0.5 + 0.5 * ex, y + 0.5 + 0.5 * ey, c);
+                            worst = std::max(worst, std::abs(double(out[eye][i * kBytesPerPixel + c]) - 0.5 * (ta + tb)));
+                        }
+                        best = std::min(best, worst);
+                    }
+                }
+                good += best <= 4.0 ? 1U : 0U;
+                ++total;
+            }
+        }
+        return total != 0 ? double(good) / double(total) : 0.0;
+    };
+    const auto at = [&](const char* name) -> const std::vector<std::uint8_t>* {
+        for (std::size_t r = 0; r < regions.names.size(); ++r) {
+            if (regions.names[r] == name) return &regions.masks[r];
+        }
+        return nullptr;
+    };
+    std::vector<std::uint8_t> moving(n, 0);
+    for (const char* name : {"trail", "lead"}) {
+        if (const auto* mask = at(name)) {
+            for (std::size_t i = 0; i < n; ++i) moving[i] |= (*mask)[i];
+        }
+    }
+    if (const auto* obj = at("obj")) {
+        const auto obj1 = fc_grow(*obj, width, height, 1);
+        for (std::size_t i = 0; i < n; ++i) moving[i] |= obj1[i];
+        m.within = within(*obj, nullptr);
+    }
+    m.cross_fade_fraction = fraction(moving);
+    for (std::size_t k = 0; k < regions.obj_masks.size(); ++k) {
+        const FcLayer* layer = nullptr;
+        for (const FcLayer& l : scene.layers) {
+            if (l.tag == regions.obj_tags[k] && l.gbuffer && l.klass == 1U) layer = &l;
+        }
+        m.obj_within.push_back(within(regions.obj_masks[k], layer));
+        // Its own moving region: obj, A's and B's places (1 px around).
+        std::vector<std::uint8_t> own = fc_grow(regions.obj_masks[k], width, height, 1);
+        const auto mine = [layer](const FcLayer& l) { return &l == layer; };
+        const auto own_a = fc_grow(fc_cover_mask(scene, width, height, 0.0, mine), width, height, 1);
+        const auto own_b = fc_grow(fc_cover_mask(scene, width, height, 1.0, mine), width, height, 1);
+        for (std::size_t i = 0; i < n; ++i) own[i] |= own_a[i] | own_b[i];
+        m.obj_fraction.push_back(fraction(own));
+    }
+    return m;
+}
+
+struct FcVariant {
+    std::string name;
+    bool motion{};
+    std::uint32_t quality{};
+    UINT focus_divisor{}; // 0: periphery MVs only (d10)
+};
+
+StereoPattern fc_run(D3D12WarpFixture& fixture, const FcScene& scene, const FcVariant& variant, UINT width,
+    UINT height, const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters, const StereoPattern& a,
+    const StereoPattern& b) {
+    const ReprojectionViews views = make_reprojection_views();
+    const auto previous = fc_mask_frame(fixture, scene.layers, width, height, views, 1000, 500, variant.focus_divisor,
+        counters, 0.0, -1.0);
+    const auto current = fc_mask_frame(fixture, scene.layers, width, height, views, 2000, 1000, variant.focus_divisor,
+        counters, 1.0, 0.0);
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.occlusion_aware = 1;
+    options.dcs_motion = variant.motion;
+    options.dcs_motion_focus = variant.motion && variant.focus_divisor != 0;
+    options.fg_quality = variant.quality;
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", variant.motion ? "8" : nullptr);
+    StereoPattern image = synthesize_nvidia_pair(fixture, a, b, width, height, options, {previous, current},
+        xrfg::D3D12OpticalFlowBackend::nvidia, true, nullptr, nullptr, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB);
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", nullptr);
+    print_output_hash("fc " + scene.name + " " + variant.name, image);
+    return image;
+}
+
+void run_fg_cover_fixtures() {
+    D3D12WarpFixture fixture(true);
+    char which_buffer[256]{};
+    GetEnvironmentVariableA("XRFG_TEST_FG_COVER", which_buffer, sizeof(which_buffer));
+    const std::string which = which_buffer;
+    const UINT width = 640U, height = 480U;
+    std::cout << "fc " << width << "x" << height << ", periphery MVs d10 (cell 8), d2: focus MVs over the middle half"
+              << " (fine cell 4), sRGB view" << std::endl;
+    constexpr std::uint32_t kCover = xrfg::kFgQualityCover;
+    constexpr std::uint32_t kSky = xrfg::kFgQualitySkyOcclusion;
+    for (const FcScene& scene : fc_scenes(width, height)) {
+        if (which.size() > 1 && which.find(scene.name.substr(0, scene.name.find(' '))) == std::string::npos &&
+            which != "1") {
+            continue;
+        }
+        const FcRegions regions = fc_regions(scene, width, height);
+        const StereoPattern a = fc_frame(scene.layers, width, height, 0.0);
+        const StereoPattern b = fc_frame(scene.layers, width, height, 1.0);
+        const StereoPattern truth = fc_frame(scene.layers, width, height, 0.5);
+        auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+        const std::vector<FcVariant> variants{
+            {"flow", false, 0U, 0U},
+            {"off", true, 0U, 0U},
+            {"cover", true, kCover, 0U},
+            {"sky", true, kSky, 0U},
+            {"sky+cover", true, kSky | kCover, 0U},
+            {"d2 off", true, 0U, 2U},
+            {"d2 cover", true, kCover, 2U},
+        };
+        std::vector<FcMeasure> measures;
+        std::vector<StereoPattern> images;
+        for (const FcVariant& variant : variants) {
+            images.push_back(fc_run(fixture, scene, variant, width, height, counters, a, b));
+            measures.push_back(fc_measure(scene, regions, images.back(), a, b, truth, width, height));
+            const FcMeasure& m = measures.back();
+            std::cout << "fc " << scene.name << " " << variant.name;
+            for (std::size_t r = 0; r < regions.names.size(); ++r) {
+                char text[64]{};
+                std::snprintf(text, sizeof(text), " | %s %.2f", regions.names[r].c_str(), m.mae[r]);
+                std::cout << text;
+            }
+            char text[96]{};
+            std::snprintf(text, sizeof(text), " | xfade %.2f within1 %.2f", m.cross_fade_fraction, m.within);
+            std::cout << text;
+            for (std::size_t k = 0; k < regions.obj_tags.size(); ++k) {
+                std::snprintf(text, sizeof(text), " | %s within1 %.2f xfade %.2f", regions.obj_tags[k].c_str(),
+                    m.obj_within[k], m.obj_fraction[k]);
+                std::cout << text;
+            }
+            std::cout << std::endl;
+            fm_dump("fc " + scene.name + " - " + variant.name, images.back(), width, height);
+        }
+        fm_dump("fc " + scene.name + " - truth", truth, width, height);
+        // Without MVs the key does nothing.
+        const StereoPattern bare = fc_run(fixture, scene, {"flow+cover", false, kCover, 0U}, width, height, counters, a, b);
+        require(bare == images[0], "fg cover " + scene.name + ": the key changes a pair without MVs");
+        const auto index = [&](const char* name) {
+            for (std::size_t r = 0; r < regions.names.size(); ++r) {
+                if (regions.names[r] == name) return static_cast<int>(r);
+            }
+            return -1;
+        };
+        // Must not regress: what the G-buffer does not hold (HUD, smoke,
+        // lights), thin surfaces (wires), far from the aircraft, the image.
+        for (const auto& [on, off] : std::vector<std::pair<std::size_t, std::size_t>>{{2, 1}, {4, 3}, {6, 5}}) {
+            for (const char* name : {"hud", "smoke", "wires", "far", "all", "lights"}) {
+                const int r = index(name);
+                if (r < 0) continue;
+                const double slack = std::string(name) == "lights" || std::string(name) == "smoke" ? 0.5 : 0.25;
+                require(measures[on].mae[static_cast<std::size_t>(r)] <=
+                            measures[off].mae[static_cast<std::size_t>(r)] * 1.05 + slack,
+                    "fg cover " + scene.name + " " + variants[on].name + ": " + name + " worse than " + variants[off].name);
+            }
+        }
+        // The crossing: fewer cross-faded aircraft.
+        if (scene.name.rfind("crossing", 0) == 0) {
+            require(measures[2].cross_fade_fraction < measures[1].cross_fade_fraction,
+                "fg cover " + scene.name + ": the cross-fade fraction does not go down");
+        }
+    }
+    fixture.require_no_debug_errors();
+}
+
+// DCS Control (0130, live round 2): XRFG_TEST_FG_COVER_LIVE=<dir> composes the live pairs exported by
+// artifacts\motion-study\fg-diag\analysis\export_live_fixture.py (<dir>\pair<k>: the frame's own MV and class atlases
+// as OFXR copied them in flight, the two real frames taken back into the synthesizer's target pixels, the measured
+// aircraft displacement d (B -> A, target pixels) and the aircraft's region in either frame), at the live cell (4 px),
+// through an sRGB view, without and with dcs_motion_cover. Measured against the composition along d (the reference,
+// t = 0.5): the cross-fade fraction and the share of region pixels within 4 codes of a composition along d +- 1 px.
+bool fc_read_file(const std::string& path, std::vector<std::uint8_t>& bytes) {
+    std::ifstream in(path, std::ios::binary);
+    if (!in) return false;
+    bytes.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+    return true;
+}
+
+void run_fg_cover_live(const std::string& root) {
+    D3D12WarpFixture fixture(true);
+    int done = 0;
+    for (int k = 0; k < 32; ++k) {
+        const std::string dir = root + "\\pair" + std::to_string(k);
+        std::ifstream meta(dir + "\\meta.txt");
+        if (!meta) break;
+        UINT width = 0, height = 0, atlas_w = 0, atlas_h = 0;
+        std::array<float, 4> source_rect{}, source_fov{}, tangents{};
+        float off_x = 0, off_y = 0, dx = 0, dy = 0;
+        meta >> width >> height >> atlas_w >> atlas_h;
+        for (auto& v : source_rect) meta >> v;
+        for (auto& v : source_fov) meta >> v;
+        for (auto& v : tangents) meta >> v;
+        meta >> off_x >> off_y >> dx >> dy;
+        std::string capture, stem;
+        meta >> capture >> stem;
+        std::vector<std::uint8_t> a_bytes, b_bytes, mv, cls, mask;
+        require(fc_read_file(dir + "\\a.rgba", a_bytes) && fc_read_file(dir + "\\b.rgba", b_bytes) &&
+                    fc_read_file(dir + "\\mv.bin", mv) && fc_read_file(dir + "\\class.bin", cls) &&
+                    fc_read_file(dir + "\\mask.bin", mask),
+            "fg cover live: files of " + dir);
+        require(a_bytes.size() == std::size_t(width) * height * 4U && mv.size() == std::size_t(atlas_w) * atlas_h * 4U &&
+                    cls.size() == std::size_t(atlas_w) * atlas_h && mask.size() == std::size_t(width) * height,
+            "fg cover live: sizes of " + dir);
+        StereoPattern a, b;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            a[eye] = a_bytes;
+            b[eye] = b_bytes;
+        }
+        ReprojectionViews views = make_reprojection_views();
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            views[eye].pose.position.x = 0.0F;
+            views[eye].fov.angle_left = std::atan(tangents[0]);
+            views[eye].fov.angle_right = std::atan(tangents[1]);
+            views[eye].fov.angle_up = std::atan(tangents[2]);
+            views[eye].fov.angle_down = std::atan(tangents[3]);
+        }
+        auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+        const auto frame_of = [&](std::int64_t display_time, std::int64_t previous_time) {
+            auto frame = make_cockpit_mask_frame(fixture, width, height, {}, 8, views);
+            frame->display_time = display_time;
+            frame->counters = counters;
+            frame->motion_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R16G16_FLOAT, 4, mv);
+            frame->motion_class_texture = upload_depth_test_texture(fixture, atlas_w, atlas_h, DXGI_FORMAT_R8_UINT, 1, cls);
+            frame->motion = true;
+            frame->motion_class = true;
+            frame->motion_previous_display_time = previous_time;
+            frame->motion_slot_flags = 0x80U | 0x40U | 0x3U;
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                auto& view = frame->motion_views[eye];
+                view.valid = true;
+                view.x = static_cast<std::uint32_t>(source_rect[0]);
+                view.y = static_cast<std::uint32_t>(source_rect[1]);
+                view.width = static_cast<std::uint32_t>(source_rect[2]);
+                view.height = static_cast<std::uint32_t>(source_rect[3]);
+                view.fov_tan = source_fov;
+                view.offset_px = {off_x, off_y};
+            }
+            return frame;
+        };
+        const auto previous = frame_of(1000, 500);
+        const auto current = frame_of(2000, 1000);
+        // The reference: the composition along d at t = 0.5 (bilinear in each frame).
+        const auto ref_at = [&](UINT x, UINT y, int c, double ex, double ey) {
+            const double ta = fc_sample(a_bytes, width, height, x + 0.5 + 0.5 * ex, y + 0.5 + 0.5 * ey, c);
+            const double tb = fc_sample(b_bytes, width, height, x + 0.5 - 0.5 * ex, y + 0.5 - 0.5 * ey, c);
+            return 0.5 * (ta + tb);
+        };
+        std::cout << "fc live " << capture << " " << stem << " " << width << "x" << height << " d " << dx << "," << dy;
+        for (const std::uint32_t quality : {0U, xrfg::kFgQualityCover}) {
+            xrfg::D3D12NvidiaOpticalFlowOptions options{};
+            options.occlusion_aware = 1;
+            options.dcs_motion = true;
+            options.fg_quality = quality;
+            SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", "4");
+            const StereoPattern out = synthesize_nvidia_pair(fixture, a, b, width, height, options, {previous, current},
+                xrfg::D3D12OpticalFlowBackend::nvidia, true, &views, &views, DXGI_FORMAT_R8G8B8A8_UNORM_SRGB);
+            SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", nullptr);
+            double num = 0.0, den = 0.0, mae = 0.0;
+            std::size_t n = 0, good = 0;
+            for (UINT y = 0; y < height; ++y) {
+                for (UINT x = 0; x < width; ++x) {
+                    const std::size_t i = std::size_t(y) * width + x;
+                    if (!mask[i]) continue;
+                    for (int c = 0; c < 3; ++c) {
+                        const double r = ref_at(x, y, c, dx, dy);
+                        const double o = out[0][i * 4U + c];
+                        num += std::abs(o - r);
+                        den += std::abs(0.5 * (double(a_bytes[i * 4U + c]) + double(b_bytes[i * 4U + c])) - r);
+                        mae += std::abs(o - r);
+                    }
+                    double best = 1.0e9;
+                    for (int j = -1; j <= 1; ++j) {
+                        for (int q = -1; q <= 1; ++q) {
+                            double worst = 0.0;
+                            for (int c = 0; c < 3; ++c) {
+                                worst = std::max(worst, std::abs(double(out[0][i * 4U + c]) - ref_at(x, y, c, dx + q, dy + j)));
+                            }
+                            best = std::min(best, worst);
+                        }
+                    }
+                    good += best <= 4.0 ? 1U : 0U;
+                    ++n;
+                }
+            }
+            char text[200]{};
+            std::snprintf(text, sizeof(text), " | %s: mae %.2f xfade %.2f within1 %.2f (%zu px; MV pairs %llu, along %llu, flow %llu)", quality ? "cover" : "off",
+                n ? mae / (3.0 * n) : 0.0, den > 0 ? num / den : 0.0, n ? double(good) / n : 0.0, n,
+                static_cast<unsigned long long>(counters->motion_pairs.exchange(0)),
+                static_cast<unsigned long long>(counters->motion_pixels.exchange(0)),
+                static_cast<unsigned long long>(counters->motion_fallback_pixels.exchange(0)));
+            std::cout << text;
+            fm_dump("fc live pair" + std::to_string(k) + " - " + (quality ? "cover" : "off"), out, width, height);
+        }
+        std::cout << std::endl;
+        ++done;
+    }
+    require(done > 0, "fg cover live: no pair in " + root);
+    fixture.require_no_debug_errors();
+}
