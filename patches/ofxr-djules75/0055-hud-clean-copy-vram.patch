+void test_hud_in_place(Gpu& gpu) {
+    // The scene of test_hud_synthesis: a green cross (class 1, coverage 0.85)
+    // over a smooth world, moved by `shift`; and a helmet bar (class 2).
+    const auto scene_at = [](int shift) {
+        HudScene scene;
+        scene.width = kHudSynthWidth;
+        scene.height = kHudSynthHeight;
+        scene.atlas_width = kHudSynthWidth;
+        scene.atlas_height = kHudSynthHeight;
+        scene.frame.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 4U, 255);
+        scene.emission.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 8U, 0);
+        scene.classes.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight, 0);
+        for (UINT y = 0; y < kHudSynthHeight; ++y) {
+            for (UINT x = 0; x < kHudSynthWidth; ++x) {
+                const std::size_t at = static_cast<std::size_t>(y) * kHudSynthWidth + x;
+                const double wx = static_cast<double>(x) - shift;
+                std::array<float, 3> f{};
+                for (int ch = 0; ch < 3; ++ch) {
+                    const double value = 0.5 + 0.35 * std::sin(wx * 0.21 + ch) * std::cos(y * 0.17 + 0.5 * ch);
+                    f[ch] = hud_decode(static_cast<std::uint8_t>(std::clamp(value * 255.0, 0.0, 255.0)));
+                }
+                const bool cross = ((x >= 60 && x < 64) && y >= 30 && y < 66) || ((y >= 46 && y < 50) && x >= 44 && x < 84);
+                const bool helmet = y >= 68 && y < 71 && x >= 36 && x < 92;
+                if (cross || helmet) {
+                    std::array<float, 4> e{};
+                    const std::array<float, 3> colour = cross ? std::array<float, 3>{0.1F, 0.9F, 0.15F}
+                                                              : std::array<float, 3>{0.9F, 0.6F, 0.1F};
+                    for (int ch = 0; ch < 3; ++ch) {
+                        const float mixed = 0.15F * f[ch] + 0.85F * colour[ch];
+                        e[ch] = mixed - f[ch];
+                        f[ch] = mixed;
+                    }
+                    e[3] = 0.85F;
+                    for (int ch = 0; ch < 4; ++ch) {
+                        const std::uint16_t half = hud_half(e[ch]);
+                        std::memcpy(&scene.emission[at * 8U + ch * 2U], &half, 2);
+                    }
+                    scene.classes[at] = cross ? 1 : 2;
+                }
+                for (int ch = 0; ch < 3; ++ch) {
+                    scene.frame[at * 4U + ch] = hud_encode(f[ch]);
+                }
+            }
+        }
+        return scene;
+    };
+    const auto stereo = [](const std::vector<std::uint8_t>& eye) {
+        std::vector<std::uint8_t> both(eye);
+        both.insert(both.end(), eye.begin(), eye.end());
+        return both;
+    };
+    const HudScene still = scene_at(0);
+    const HudScene moved = scene_at(8);
+    const std::array<std::vector<std::uint8_t>, 2> images{stereo(still.frame), stereo(moved.frame)};
+    // Six frames alternating between the two images (pairs A-B, B-A, ...),
+    // each with its own symbology; `alpha`: coverage valid; `gap`: frame 3
+    // without symbology (its pairs composed as before, the next pair cleans
+    // both frames anew).
+    const auto masks = [&](bool alpha, bool gap) {
+        std::vector<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>> list;
+        for (std::uint64_t number = 0; number < 6; ++number) {
+            list.push_back(hud_synthesis_frame(
+                gpu, number % 2U == 0U ? still : moved, !(gap && number == 3U), number + 1U, alpha));
