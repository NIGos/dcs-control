+    const std::array<Case, 4> cases{Case{"2X additive", false, false, false}, Case{"2X coverage", true, false, false},
+        Case{"3X additive", false, false, true}, Case{"2X with a frame without symbology", false, true, false}};
+    std::uint64_t window_bytes = 0;
