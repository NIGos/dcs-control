+        // Each run gets masks of its own (the counters, the latch's frames).
+        const HudRunResult full = hud_synthesize_run(gpu, images, masks(c.alpha, c.gap), true, false, c.triple);
+        const HudRunResult in_place = hud_synthesize_run(gpu, images, masks(c.alpha, c.gap), false, false, c.triple);
+        const HudRunResult shared = hud_synthesize_run(gpu, images, masks(c.alpha, c.gap), false, true, c.triple);
+        const std::string what = std::string("hud in place (") + c.name + "): ";
+        require(full.synthetic.size() == 5 && in_place.synthetic.size() == 5 && shared.synthetic.size() == 5,
+            what + "five pairs");
+        for (std::size_t pair = 0; pair < full.synthetic.size(); ++pair) {
+            const std::string at = what + "pair " + std::to_string(pair + 1) + ": ";
+            require(in_place.synthetic[pair] == full.synthetic[pair] && shared.synthetic[pair] == full.synthetic[pair],
+                at + "the synthetic is not bit-identical to 0049's clean copies");
+            if (c.triple) {
+                require(in_place.extra[pair] == full.extra[pair] && shared.extra[pair] == full.extra[pair],
+                    at + "the 3X second synthetic is not bit-identical to 0049's clean copies");
+            }
+            // The real frame's displayed copy: the frame itself, untouched.
+            const std::vector<std::uint8_t>& frame = images[(pair + 1U) % 2U];
+            require(full.current[pair] == frame && in_place.current[pair] == frame && shared.current[pair] == frame,
+                at + "the real frame's copy changed");
+        }
+        // The frames the pairs held, after them: the true originals.
+        for (std::size_t index = 0; index < 2; ++index) {
+            require(in_place.sources[index] == images[index] && shared.sources[index] == images[index],
+                what + "a source frame is not its original after the run");
