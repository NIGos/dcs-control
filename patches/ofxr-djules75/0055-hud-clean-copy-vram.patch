+        for (const xrfg::HudAllocation& allocation : full.allocations) {
+            full_clean += allocation.kind == xrfg::HudAllocationKind::clean_copy ? 1U : 0U;
+            full_windows += allocation.kind == xrfg::HudAllocationKind::clean_window ? 1U : 0U;
+        }
+        for (const xrfg::HudAllocation& allocation : in_place.allocations) {
+            place_clean += allocation.kind == xrfg::HudAllocationKind::clean_copy ? 1U : 0U;
+            if (allocation.kind == xrfg::HudAllocationKind::clean_window) {
+                ++place_windows;
