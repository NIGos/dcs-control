+// DCS Control (0055): the removal in place against 0049's full-size clean
+// copies. A run of pairs through the synthesizer (FidelityFX on WARP): the
+// frames alternate between two images (source 0 and 1), each frame with its
+// own symbology; per pair the synthetic(s) and the real frame's copy, and at
+// the end the sources themselves; the result=22 records the run logged.
+std::vector<xrfg::HudAllocationRecord>& hud_observed_records() {
+    static std::vector<xrfg::HudAllocationRecord> records;
+    return records;
+}
+
+void hud_observe_record(const xrfg::HudAllocationRecord& record) {
+    hud_observed_records().push_back(record);
+}
+
+struct HudRunResult {
+    std::vector<std::vector<std::uint8_t>> synthetic;
+    std::vector<std::vector<std::uint8_t>> extra;
+    std::vector<std::vector<std::uint8_t>> current;
+    std::array<std::vector<std::uint8_t>, 2> sources;
+    std::vector<xrfg::HudAllocation> allocations;
+};
+
+HudRunResult hud_synthesize_run(Gpu& gpu, const std::array<std::vector<std::uint8_t>, 2>& images,
+    const std::vector<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>>& masks, bool full_copies, bool in_place_history,
+    bool triple) {
+    const DXGI_FORMAT format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    // In place, the history is the sources themselves, resting in COMMON (as
+    // the D3D11 bridge's shared textures); else copied from RENDER_TARGET.
+    const D3D12_RESOURCE_STATES source_state =
+        in_place_history ? D3D12_RESOURCE_STATE_COMMON : D3D12_RESOURCE_STATE_RENDER_TARGET;
+    const auto image = [&](D3D12_RESOURCE_STATES state) {
+        return hud_texture(gpu, kHudSynthWidth, kHudSynthHeight, format, 2, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,
+            D3D12_HEAP_FLAG_NONE, state);
+    };
+    std::array<ComPtr<ID3D12Resource>, 2> sources{image(source_state), image(source_state)};
+    auto current = image(D3D12_RESOURCE_STATE_RENDER_TARGET);
+    auto synthetic = image(D3D12_RESOURCE_STATE_RENDER_TARGET);
+    auto extra = image(D3D12_RESOURCE_STATE_RENDER_TARGET);
+    for (std::size_t index = 0; index < 2; ++index) {
+        hud_upload(gpu, sources[index].Get(), images[index], kHudSynthWidth * 4U, source_state);
+    }
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 1> current_out{current.Get()};
+    std::array<ID3D12Resource*, 2> synthetic_out{synthetic.Get(), extra.Get()};
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(in_place_history
+                        ? history->initialize_in_place(gpu.device.Get(), gpu.queue.Get(), input, source_state)
+                        : history->initialize(gpu.device.Get(), gpu.queue.Get(), input, source_state),
+        "hud run: history");
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.cockpit_mask = true;
+    options.hud_symbology = true;
+    options.hud_full_clean_copies = full_copies;
+    hud_observed_records().clear();
+    xrfg::set_hud_allocation_observer(&hud_observe_record);
+    HudRunResult result;
+    {
+        xrfg::D3D12FrameSynthesizer synth;
+        require_hresult(synth.initialize(gpu.device.Get(), gpu.queue.Get(), history, current_out, synthetic_out,
+                            format, D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::fidelity_fx,
+                            options),
+            "hud run: initialize");
+        const auto views = hud_synthesis_views();
+        xrfg::D3D12HistoryCaptureTicket ticket{};
+        xrfg::D3D12FrameSynthesisTicket output{};
+        require_hresult(history->capture(0, &ticket), "hud run: capture 0");
+        require_hresult(history->commit(ticket), "hud run: commit 0");
+        synth.set_cockpit_mask(masks[0]);
+        require_hresult(synth.submit_prime(ticket, views, 0, &output), "hud run: prime");
+        hud_run(gpu, [](ID3D12GraphicsCommandList*) {});
+        const std::optional<xrfg::D3D12ExtraSynthetic> extra_synthetic = triple
+            ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+            : std::nullopt;
+        for (std::size_t number = 1; number < masks.size(); ++number) {
+            require_hresult(history->capture(static_cast<std::uint32_t>(number % 2U), &ticket), "hud run: capture");
+            require_hresult(history->commit(ticket), "hud run: commit");
+            synth.set_cockpit_mask(masks[number]);
+            require_hresult(synth.submit_pair(ticket, views, views, 0, 0, &output, std::nullopt, {}, false,
+                                triple ? 1.0F / 3.0F : 0.5F, extra_synthetic),
+                "hud run: pair");
+            hud_run(gpu, [](ID3D12GraphicsCommandList*) {});
+            result.synthetic.push_back(
+                hud_readback(gpu, synthetic.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET));
+            if (triple) {
+                result.extra.push_back(
+                    hud_readback(gpu, extra.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET));
+            }
+            result.current.push_back(
+                hud_readback(gpu, current.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET));
+        }
+        require_hresult(synth.wait_for_idle(), "hud run: idle");
+    }
+    xrfg::set_hud_allocation_observer(nullptr);
+    for (const xrfg::HudAllocationRecord& record : hud_observed_records()) {
+        result.allocations.push_back(xrfg::hud_allocation_from_record(record));
+    }
+    for (std::size_t index = 0; index < 2; ++index) {
+        result.sources[index] = hud_readback(gpu, sources[index].Get(), kHudSynthWidth * 4U, source_state);
+    }
+    return result;
+}
