diff --git a/tests/fg_extras_async.inc b/tests/fg_extras_async.inc
new file mode 100644
index 0000000..df351fd
--- /dev/null
+++ b/tests/fg_extras_async.inc
@@ -0,0 +1,126 @@
+// DCS Control (0125): a quality key turned on right after the start, with DCS's cockpit mask and motion vectors (the
+// NVIDIA backend), never holds the submitting thread for the _extras compositions: the first pair that needs them starts
+// their background build and the key takes effect once they are there; with every key off none is ever made. Every submission is timed on the calling thread; the run with
+// the key turned on at the first pair may not be slower than the same run with every key off by more than 5 ms at any
+// pair, and the twins must be bound within the run (XRFG_TEST_FG_EXTRAS_ASYNC, NVIDIA hardware).
+void run_fg_extras_async(D3D12WarpFixture& fixture) {
+    constexpr UINT kFrames = 4;
+    constexpr UINT kAsyncWidth = 1024;
+    constexpr UINT kAsyncHeight = 1024;
+    constexpr int kPairs = 400;
+    const double pi = 3.14159265358979;
+    DcsMotionScene scene;
+    scene.divisor = 9;
+    scene.layers = {
+        {1, 1.0, 1.0 * pi / 180.0, 18.0, -4.0, 1, 1, 1.0, true, {0.35, 0.35, 0.35}},
+        {0, 0.25, 1.0 * pi / 180.0, 0.0, 6.0, 0, 0, 1.0, true, {1.0, 1.0, 1.0}},
+    };
+    const ReprojectionViews views = make_reprojection_views();
+    const DcsMotionFrame a = dcs_motion_frame(scene, kAsyncWidth, kAsyncHeight, 0.0);
+    const DcsMotionFrame b = dcs_motion_frame(scene, kAsyncWidth, kAsyncHeight, 1.0);
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    const auto with_mvs_b = make_dcs_motion_frame(fixture, scene, kAsyncWidth, kAsyncHeight, views, 0, 0, true, counters);
+    const auto with_mvs_a =
+        make_dcs_motion_frame(fixture, scene, kAsyncWidth, kAsyncHeight, views, 0, 0, true, counters, 0.0, 1.0);
+    struct Run {
+        double max_submit_ms{};
+        double first_key_submit_ms{};
+        bool building_at_key{};
+        int bound_at_pair{-1};
+        std::uint64_t build_us{};
+    };
+    const auto run = [&](bool key_on) {
+        Run outcome{};
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources{};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{};
+        std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            sources[frame] = create_source_texture(fixture, kAsyncWidth, kAsyncHeight);
+            upload_pattern(fixture, sources[frame].Get(), frame % 2U == 0U ? a.image : b.image);
+        }
+        for (auto& c : currents) c = create_source_texture(fixture, kAsyncWidth, kAsyncHeight);
+        for (auto& s : synthetics) s = create_source_texture(fixture, kAsyncWidth, kAsyncHeight);
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = sources[i].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{currents[0].Get(), currents[1].Get()};
+        std::array<ID3D12Resource*, 2> synthetic_pointers{synthetics[0].Get(), synthetics[1].Get()};
+        auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "fg extras async: history");
+        xrfg::D3D12NvidiaOpticalFlowOptions options{};
+        options.occlusion_aware = 1;
+        options.cockpit_mask = true;
+        options.dcs_motion = true; // every quality key and the fill off, as DCS Control starts by default
+        auto synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(synthesizer->initialize(fixture.device(), fixture.queue(), history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "fg extras async: synthesizer");
+        for (int frame = 0; frame <= kPairs; ++frame) {
+            const UINT slot = static_cast<UINT>(frame) % kFrames;
+            if (key_on && frame == 1) {
+                outcome.building_at_key = synthesizer->fg_settings().extras_building;
+                synthesizer->set_fg_quality(xrfg::kFgQualitySkyOcclusion);
+            }
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require(operation_succeeded(history->capture(slot, &capture)) &&
+                        operation_succeeded(history->commit(capture)), "fg extras async: capture");
+            auto mask = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+            const auto& source = slot % 2U == 0U ? with_mvs_a : with_mvs_b;
+            mask->texture = source->texture;
+            mask->ready_fence = source->ready_fence;
+            mask->ready_value = source->ready_value;
+            mask->views = source->views;
+            mask->counters = counters;
+            mask->motion_texture = source->motion_texture;
+            mask->motion_class_texture = source->motion_class_texture;
+            mask->motion = frame > 0;
+            mask->motion_class = true;
+            mask->motion_views = source->motion_views;
+            mask->display_time = 1000 + frame;
+            mask->motion_previous_display_time = 999 + frame;
+            synthesizer->set_cockpit_mask(mask);
+            const auto started = std::chrono::steady_clock::now();
+            const HRESULT submitted = frame == 0
+                ? synthesizer->submit_prime(capture, views, 0, &ticket)
+                : synthesizer->submit_pair(capture, views, views, 0, static_cast<std::uint32_t>(frame % 2), &ticket,
+                      std::nullopt, {}, false, 0.5F);
+            const double took_ms =
+                std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+            require(operation_succeeded(submitted), "fg extras async: submission");
+            require_frame_start_gate(*synthesizer, "fg extras async: frame-start gate");
+            if (frame > 0) {
+                outcome.max_submit_ms = (std::max)(outcome.max_submit_ms, took_ms);
+                if (key_on && frame == 1) outcome.first_key_submit_ms = took_ms;
+            }
+            const auto settings = synthesizer->fg_settings();
+            if (key_on && outcome.bound_at_pair < 0 && settings.extras_binds > 0) {
+                outcome.bound_at_pair = frame;
+            }
+            // A frame's pace (about 90 Hz): the background build gets the time a session gives it.
+            std::this_thread::sleep_for(std::chrono::milliseconds(10));
+        }
+        require(operation_succeeded(synthesizer->wait_for_idle()), "fg extras async: idle");
+        outcome.build_us = synthesizer->fg_settings().extras_build_us; // 0 while the build still runs
+        if (!key_on) {
+            const auto settings = synthesizer->fg_settings();
+            require(settings.extras_binds == 0, "fg extras async: every key off binds no twin");
+            require(!settings.extras_building && settings.extras_build_us == 0, "fg extras async: every key off builds no twin");
+        }
+        return outcome;
+    };
+    static_cast<void>(run(false)); // warm-up: first-use costs of the device and the flow, not the keys
+    const Run keyed = run(true);
+    const Run plain = run(false);
+    std::cout << "fg extras async: key at pair 1 (build " << (keyed.building_at_key ? "running before the key" : "not started before the key")
+              << "), first keyed submission " << keyed.first_key_submit_ms << " ms, max " << keyed.max_submit_ms
+              << " ms; keys off max " << plain.max_submit_ms << " ms; twins bound at pair " << keyed.bound_at_pair
+              << ", background build " << keyed.build_us / 1000U << " ms" << std::endl;
+    require(!keyed.building_at_key, "fg extras async: no build before a key is on");
+    require(keyed.bound_at_pair > 0, "fg extras async: the key took effect within the run");
+    require(keyed.max_submit_ms <= plain.max_submit_ms + 5.0,
+            "fg extras async: turning a key on held a submission more than 5 ms beyond the keys-off run");
+}
