+// DCS Control (0056): result=24's fields (xrfg/bridge_flight_logger.hpp),
+// each saturated to its width.
+HudRestoreFields hud_restore_fields(const HudRestoreRecord& record) noexcept {
+    const auto bits = [](std::uint64_t value, std::uint64_t width) {
+        const std::uint64_t limit = (std::uint64_t{1} << width) - 1U;
+        return std::min(value, limit);
+    };
+    HudRestoreFields fields{};
+    fields.a = bits(static_cast<std::uint32_t>(record.kind), 8) | (bits(record.owner, 8) << 8U);
+    switch (record.kind) {
+    case HudRestoreRecordKind::summary: {
+        const HudRestoreCounts& c = record.counts;
+        fields.b = bits(c.pairs, 24) | (bits(c.restored, 24) << 24U) | (bits(c.failure_restored, 16) << 48U);
+        fields.c = bits(c.lost, 16) | (bits(c.full_copy_pairs, 24) << 16U) | (bits(c.seconds, 16) << 40U);
+        break;
+    }
+    case HudRestoreRecordKind::lost:
+        fields.b = bits(static_cast<std::uint32_t>(record.loss), 8) | (bits(record.losses, 32) << 8U);
+        fields.c = bits(record.slot, 8) | (bits(record.previous_views, 8) << 8U) |
+            (bits(record.current_views, 8) << 16U);
+        break;
+    case HudRestoreRecordKind::path:
+        fields.b = bits(static_cast<std::uint32_t>(record.path), 8);
+        fields.c = bits(static_cast<std::uint32_t>(record.reason), 8);
+        break;
+    }
+    return fields;
+}
+
+HudRestoreRecord hud_restore_from_fields(const HudRestoreFields& fields) noexcept {
+    const auto at = [](std::uint64_t value, unsigned shift, unsigned width) {
+        return (value >> shift) & ((std::uint64_t{1} << width) - 1U);
+    };
+    HudRestoreRecord record{};
+    record.kind = static_cast<HudRestoreRecordKind>(at(fields.a, 0, 8));
+    record.owner = static_cast<std::uint32_t>(at(fields.a, 8, 8));
+    switch (record.kind) {
+    case HudRestoreRecordKind::summary:
+        record.counts.pairs = at(fields.b, 0, 24);
+        record.counts.restored = at(fields.b, 24, 24);
+        record.counts.failure_restored = at(fields.b, 48, 16);
+        record.counts.lost = at(fields.c, 0, 16);
+        record.counts.full_copy_pairs = at(fields.c, 16, 24);
+        record.counts.seconds = at(fields.c, 40, 16);
+        break;
+    case HudRestoreRecordKind::lost:
+        record.loss = static_cast<HudRestoreLoss>(at(fields.b, 0, 8));
+        record.losses = at(fields.b, 8, 32);
+        record.slot = static_cast<std::uint32_t>(at(fields.c, 0, 8));
+        record.previous_views = static_cast<std::uint32_t>(at(fields.c, 8, 8));
+        record.current_views = static_cast<std::uint32_t>(at(fields.c, 16, 8));
+        break;
+    case HudRestoreRecordKind::path:
+        record.path = static_cast<HudCleanPath>(at(fields.b, 0, 8));
+        record.reason = static_cast<HudCleanPathReason>(at(fields.c, 0, 8));
+        break;
+    }
+    return record;
+}
+
+namespace {
+std::atomic<HudRestoreObserver> g_hud_restore_observer{nullptr};
+std::atomic<bool> g_hud_restore_drop{false};
+}  // namespace
+
+void set_hud_restore_observer(HudRestoreObserver observer) noexcept {
+    g_hud_restore_observer.store(observer, std::memory_order_release);
+}
+
+void notify_hud_restore(const HudRestoreFields& fields) noexcept {
+    if (const HudRestoreObserver observer = g_hud_restore_observer.load(std::memory_order_acquire)) {
+        observer(fields);
+    }
+}
+
+void set_hud_restore_drop_for_tests(bool drop) noexcept {
+    g_hud_restore_drop.store(drop, std::memory_order_release);
+}
+
+bool hud_restore_drop_for_tests() noexcept {
+    return g_hud_restore_drop.load(std::memory_order_acquire);
+}
+
 }  // namespace xrfg
