+// DCS Control (0056): the removal in place's restores in the flight log
+// (cockpit_mask result=24, xrfg/bridge_flight_logger.hpp), per synthesizer.
+inline constexpr std::int64_t kHudRestoreResult = 24;
+inline constexpr std::uint64_t kHudRestoreSummaryMs = 10000;
+enum class HudRestoreRecordKind : std::uint32_t {
+    summary = 1, // every 10 s, and when the synthesizer goes idle
+    lost = 2,    // at once: a cleaned history whose restore did not run
+    path = 3,    // once per path and reason: in place or 0049's full copies
+};
+enum class HudRestoreLoss : std::uint32_t {
+    none = 0,
+    not_recorded = 1,    // the pair's list holds no copy-back for a cleaned frame
+    list_missing = 2,    // NVIDIA: failed after the pack, its restore list gone
+    no_restore_list = 3, // failed after the pack, no restore list recorded
+};
+enum class HudCleanPath : std::uint32_t {
+    in_place = 1,
+    full_copies = 2,
+};
+enum class HudCleanPathReason : std::uint32_t {
+    none = 0,                  // in place
+    full_copies_asked = 1,     // [ofxr] hud_full_clean_copies
+    previous_not_drawable = 2, // the previous frame's history is no render target
+    current_not_drawable = 3,  // the current frame's
+};
+struct HudRestoreCounts {
+    std::uint64_t pairs{};            // removals in place that reached the GPU
+    std::uint64_t restored{};         // put back after the pair
+    std::uint64_t failure_restored{}; // put back by the NVIDIA restore list
+    std::uint64_t lost{};             // not put back (record 2 each)
+    std::uint64_t full_copy_pairs{};  // cleaned with 0049's full-size copies
+    std::uint64_t seconds{};          // the time counted
+    [[nodiscard]] bool any() const noexcept {
+        return pairs != 0 || restored != 0 || failure_restored != 0 || lost != 0 || full_copy_pairs != 0;
+    }
+};
+struct HudRestoreRecord {
+    HudRestoreRecordKind kind{};
+    std::uint32_t owner{};
+    HudRestoreCounts counts{};      // summary
+    HudRestoreLoss loss{};          // lost
+    std::uint64_t losses{};         // lost: this session's, with this one
+    std::uint32_t slot{};           // lost: the work slot
+    std::uint32_t previous_views{}; // lost: views cleaned in the previous frame
+    std::uint32_t current_views{};  // lost: in the current one
+    HudCleanPath path{};            // path
+    HudCleanPathReason reason{};    // path
+};
+struct HudRestoreFields {
+    std::uint64_t a{};
+    std::uint64_t b{};
+    std::uint64_t c{};
+};
+[[nodiscard]] HudRestoreFields hud_restore_fields(const HudRestoreRecord& record) noexcept;
+[[nodiscard]] HudRestoreRecord hud_restore_from_fields(const HudRestoreFields& fields) noexcept;
+// For the tests: every result=24 record is also handed to this function
+// (null: none, the default), and a removal's restore can be dropped from the
+// pair's list (record 2's reason 1; false: never, the default).
+using HudRestoreObserver = void (*)(const HudRestoreFields& fields);
+void set_hud_restore_observer(HudRestoreObserver observer) noexcept;
+void notify_hud_restore(const HudRestoreFields& fields) noexcept;
+void set_hud_restore_drop_for_tests(bool drop) noexcept;
+[[nodiscard]] bool hud_restore_drop_for_tests() noexcept;
+
 }  // namespace xrfg
