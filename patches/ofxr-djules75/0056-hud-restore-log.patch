+// DCS Control (0056): a run's result=24 records: the summaries' sums (pairs
+// in place, restored after the pair, none by the NVIDIA list, `lost`, pairs
+// with full copies), and one path record, the one expected.
+void hud_check_restore_records(const HudRunResult& run, const std::string& what, std::uint64_t pairs,
+    std::uint64_t restored, std::uint64_t full_copy_pairs, xrfg::HudCleanPathReason reason, std::uint64_t lost = 0) {
+    xrfg::HudRestoreCounts sum{};
+    std::size_t summaries = 0, paths = 0;
+    for (const xrfg::HudRestoreRecord& record : run.restores) {
+        require(record.owner != 0, what + "a record without its owner synthesizer");
+        if (record.kind == xrfg::HudRestoreRecordKind::summary) {
+            ++summaries;
+            sum.pairs += record.counts.pairs;
+            sum.restored += record.counts.restored;
+            sum.failure_restored += record.counts.failure_restored;
+            sum.lost += record.counts.lost;
+            sum.full_copy_pairs += record.counts.full_copy_pairs;
+        } else if (record.kind == xrfg::HudRestoreRecordKind::path) {
+            ++paths;
+            const xrfg::HudCleanPath path =
+                reason == xrfg::HudCleanPathReason::none ? xrfg::HudCleanPath::in_place : xrfg::HudCleanPath::full_copies;
+            require(record.path == path && record.reason == reason,
+                what + "the path record (path " + std::to_string(static_cast<std::uint32_t>(record.path)) +
+                    ", reason " + std::to_string(static_cast<std::uint32_t>(record.reason)) + ")");
+        }
+    }
+    require(summaries >= 1 && paths == 1,
+        what + "a summary and one path record (" + std::to_string(summaries) + ", " + std::to_string(paths) + ")");
+    require(sum.pairs == pairs && sum.restored == restored && sum.failure_restored == 0 && sum.lost == lost &&
+            sum.full_copy_pairs == full_copy_pairs,
+        what + "the summary's counts (pairs " + std::to_string(sum.pairs) + ", restored " +
+            std::to_string(sum.restored) + ", failure " + std::to_string(sum.failure_restored) + ", lost " +
+            std::to_string(sum.lost) + ", full copies " + std::to_string(sum.full_copy_pairs) + ")");
+    // The fields round-trip (saturated widths aside).
+    xrfg::HudRestoreRecord summary{};
+    summary.kind = xrfg::HudRestoreRecordKind::summary;
+    summary.owner = 3;
+    summary.counts = {7, 6, 1, 1, 9, 10};
+    const xrfg::HudRestoreRecord back = xrfg::hud_restore_from_fields(xrfg::hud_restore_fields(summary));
+    require(back.owner == 3 && back.counts.pairs == 7 && back.counts.restored == 6 && back.counts.failure_restored == 1 &&
+            back.counts.lost == 1 && back.counts.full_copy_pairs == 9 && back.counts.seconds == 10,
+        what + "result=24's fields do not round-trip");
+}
