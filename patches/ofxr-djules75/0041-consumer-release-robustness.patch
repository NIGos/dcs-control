+// DCS Control (0041): R76. The reader pauses while the producer fills every
+// slot: all are held (above the release fence), and a producer before R76
+// then skips its frames without refreshing its heartbeat. The stale header
+// still releases them, so the producer publishes again and masks come back;
+// a header held busy releases what the last consistent one showed.
+void test_stale_heartbeat_releases_held_slots(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"pause");
+    FakeProducer producer(gpu, suffix);
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, test_options(suffix)), "consumer initialize");
+    const std::uint64_t first = producer.commit(9000, 255);
+    producer.signal(first);
+    auto frame = consumer.acquire(9000);
+    require(frame != nullptr, "pause: paired before the pause");
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    gpu.wait(producer.release_fence_.Get(), first);
+    frame.reset();
+    // The pause: every slot committed again, none released.
+    std::uint64_t newest = first;
+    for (int index = 0; index < cm::slot_count; ++index) {
+        newest = producer.commit(9001 + index, 255);
+        producer.signal(newest);
+    }
+    require(producer.release_fence_->GetCompletedValue() < newest - static_cast<std::uint64_t>(cm::slot_count - 1),
+        "pause: every slot is held");
+    // The old producer skips frames now, its heartbeat ageing.
+    producer.publish(800);
+    require(consumer.acquire(9100) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::stale,
+        "pause: the header is stale");
+    gpu.wait(producer.release_fence_.Get(), newest, 2000);
+    require(producer.release_fence_->GetCompletedValue() == newest,
+        "pause: the stale header releases every slot up to newestMaskSeq");
+    // The producer may write again: masks are back with its next frame.
+    const std::uint64_t back = producer.commit(9101, 128);
+    producer.signal(back);
+    auto again = consumer.acquire(9101);
+    require(again != nullptr, "pause: masks are back once the producer publishes");
+    gpu.wait(again->ready_fence.Get(), again->ready_value);
+    require(gpu.readback(again->texture.Get()) == producer.last_pattern_, "pause: the copy holds the new slot");
+    gpu.wait(producer.release_fence_.Get(), back);
+    again.reset();
+
+    // Busy: the last consistent header's newest goes back.
+    const std::uint64_t paired = producer.commit(9200, 255);
+    const std::uint64_t later = producer.commit(9201, 255);
+    producer.signal(later);
+    auto busy_frame = consumer.acquire(9200);
+    require(busy_frame != nullptr, "busy: paired before");
+    gpu.wait(producer.release_fence_.Get(), paired);
+    require(producer.release_fence_->GetCompletedValue() == paired, "busy: the copy releases its own slot alone");
+    producer.hold_seqlock();
+    require(consumer.acquire(9202) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::header_busy,
+        "busy: the header is held");
+    gpu.wait(producer.release_fence_.Get(), later, 2000);
+    require(producer.release_fence_->GetCompletedValue() == later,
+        "busy: the last consistent header's newestMaskSeq is released");
+    producer.publish();
+    gpu.wait(busy_frame->ready_fence.Get(), busy_frame->ready_value);
+    std::cout << "cockpit mask: a stale or busy header releases the held slots (R76)\n";
+}
