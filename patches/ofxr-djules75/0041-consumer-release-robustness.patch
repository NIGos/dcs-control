+// DCS Control (0041): a copy that fails releases the slots: before it is
+// queued, up to newestMaskSeq at once (nothing of this frame is pending);
+// after it is queued, its own slot alone and only behind the copy (which
+// waits for the producer's fence).
+void test_copy_failures_release(Gpu& gpu) {
+    using Options = xrfg::CockpitMaskConsumerOptions;
+    int run = 0;
+    for (const std::uint32_t failure :
+        {Options::kTestFailListReset, Options::kTestFailListClose, Options::kTestFailQueueWait}) {
+        const std::wstring suffix = test_suffix((L"copyfail" + std::to_wstring(++run)).c_str());
+        FakeProducer producer(gpu, suffix);
+        auto options = test_options(suffix);
+        options.test_copy_failure = failure;
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+        producer.commit(9300, 255);
+        const std::uint64_t newest = producer.commit(9301, 255);
+        const std::string what = "copy failure " + std::to_string(failure) + ": ";
+        require(consumer.acquire(9300) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::copy_failed,
+            what + "reported");
+        gpu.wait(producer.release_fence_.Get(), newest, 2000);
+        require(producer.release_fence_->GetCompletedValue() == newest, what + "newestMaskSeq released");
+    }
+    const std::wstring suffix = test_suffix(L"copyfail_signal");
+    FakeProducer producer(gpu, suffix);
+    auto options = test_options(suffix);
+    options.test_copy_failure = Options::kTestFailCopySignal;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    const std::uint64_t own = producer.commit(9400, 255);
+    const std::uint64_t newer = producer.commit(9401, 255);
+    require(consumer.acquire(9400) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::copy_failed,
+        "copy failure after the copy: reported");
+    Sleep(100);
+    require(producer.release_fence_->GetCompletedValue() == 0,
+        "copy failure after the copy: nothing released before the copy has run");
+    producer.signal(own);
+    gpu.wait(producer.release_fence_.Get(), own, 2000);
+    Sleep(50);
+    require(producer.release_fence_->GetCompletedValue() == own && own < newer,
+        "copy failure after the copy: its own slot released behind it, not a newer one");
+    require(consumer.acquire(9401) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::stalled,
+        "copy failure after the copy: masks off for the session");
+    std::cout << "cockpit mask: a failed copy releases the slots it no longer reads\n";
+}
