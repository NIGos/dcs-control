+// DCS Control (0041): a header that turns inactive while the handles open
+// is rejected as a generation change is (mask, depth, motion), and the
+// next frame opens them.
+void test_inactive_header_at_open(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"inactive_open");
+    FakeProducer producer(gpu, suffix);
+    FakeDepthProducer depth(gpu, suffix, producer);
+    FakeMotionProducer motion(gpu, suffix, producer);
+    std::uint32_t deactivate = 0; // bit per block: 1 mask, 2 depth, 4 motion
+    auto options = test_options(suffix);
+    options.cockpit_depth = true;
+    options.dcs_motion = true;
+    options.test_before_open_recheck = [&](int which) {
+        if ((deactivate & (1U << which)) == 0) {
+            return;
+        }
+        if (which == 0) {
+            producer.header_.flags &= ~cm::header_flags::active;
+            producer.publish();
+        } else if (which == 1) {
+            depth.header_.flags &= ~cd::header_flags::active;
+            depth.publish();
+        } else {
+            motion.header_.flags &= ~cmv::header_flags::active;
+            motion.publish();
+        }
+    };
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    const auto commit = [&](std::int64_t time) {
+        const std::uint64_t seq = producer.commit(time, 255);
+        depth.commit(producer);
+        motion.commit(producer, time - 10);
+        return seq;
+    };
+    // The mask's header.
+    deactivate = 1U;
+    std::uint64_t seq = commit(9500);
+    require(consumer.acquire(9500) == nullptr &&
+            consumer.stats().last == xrfg::CockpitMaskLookup::generation_changed &&
+            consumer.stats().generations_opened == 0,
+        "inactive at open: the mask's handles are dropped");
+    deactivate = 0;
+    producer.header_.flags |= cm::header_flags::active;
+    producer.signal(seq);
+    // The depth's and the motion's headers.
+    deactivate = 2U | 4U;
+    seq = commit(9510);
+    auto alone = consumer.acquire(9510);
+    require(alone != nullptr && !alone->depth && !alone->motion && consumer.stats().generations_opened == 1,
+        "inactive at open: the mask alone");
+    require(consumer.stats().depth_last == xrfg::CockpitDepthLookup::generation_mismatch &&
+            consumer.stats().depth_generations_opened == 0,
+        "inactive at open: the depth's handles are dropped");
+    require(consumer.stats().motion_last == xrfg::CockpitMotionLookup::generation_mismatch &&
+            consumer.stats().motion_generations_opened == 0,
+        "inactive at open: the motion's handles are dropped");
+    producer.signal(seq);
+    gpu.wait(alone->ready_fence.Get(), alone->ready_value);
+    alone.reset();
+    deactivate = 0;
+    depth.header_.flags |= cd::header_flags::active;
+    motion.header_.flags |= cmv::header_flags::active;
+    // Active again: all three open and pair.
+    seq = commit(9520);
+    auto all = consumer.acquire(9520);
+    require(all != nullptr && all->depth && all->motion && consumer.stats().depth_generations_opened == 1 &&
+            consumer.stats().motion_generations_opened == 1,
+        "inactive at open: opened once active again");
+    producer.signal(seq);
+    gpu.wait(all->ready_fence.Get(), all->ready_value);
+    std::cout << "cockpit mask: a header inactive at open is rejected (mask, depth, motion)\n";
+}
