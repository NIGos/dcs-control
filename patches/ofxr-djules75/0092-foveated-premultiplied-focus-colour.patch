+// DCS Control (0092): a premultiplied focus layer. The alpha is the same as
+// without it (B's at the pixel, every byte); the colour composed without it
+// is brought to that alpha: scaled by B's alpha over the alpha it was
+// composed with (the alpha the pair has without foveated_layers), or B's own
+// pixel where that alpha is 0, and never above the alpha. Every byte within
+// one byte plus what the bytes read back cannot say (half a byte of colour and
+// of composed alpha, carried through the ratio; checked where the composed
+// alpha is at least 16 of 255), never above the alpha; the real frame stays B
+// bit for bit. The saccade case must scale a good part of the fade, or this
+// test proves nothing.
+void test_focus_premultiplied_alpha(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    const std::size_t pixels = static_cast<std::size_t>(kFocusWidth) * kFocusHeight;
+    const auto value_at = [](const StereoPattern& image, UINT eye, std::size_t pixel, UINT channel) {
+        return static_cast<int>(image[eye][pixel * kBytesPerPixel + channel]);
+    };
+    for (const bool triple : {false, true}) for (const FocusCase& c : kFocusCases) {
+        xrfg::D3D12NvidiaOpticalFlowOptions off = base, on = base;
+        off.foveated_layers = false;
+        on.foveated_layers = true;
+        const FocusPairResult plain = run_focus_pair(fixture, backend, off, c.a, c.b, false, true, triple);
+        const FocusPairResult layers = run_focus_pair(fixture, backend, on, c.a, c.b, false, true, triple);
+        const FocusPairResult premultiplied =
+            run_focus_pair(fixture, backend, on, c.a, c.b, false, true, triple, nullptr, nullptr, true);
+        require(premultiplied.real == premultiplied.current, "premultiplied focus: the real frame is not B bit for bit");
+        require(premultiplied.synthetics.size() == layers.synthetics.size() &&
+                plain.synthetics.size() == layers.synthetics.size(), "premultiplied focus: outputs missing");
+        for (std::size_t s = 0; s < layers.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            int worst_alpha = 0;
+            double worst_colour = -1.0; // the largest error beyond the tolerance
+            std::size_t scaled = 0;
+            for (std::size_t pixel = 0; pixel < pixels; ++pixel) {
+                const int alpha = value_at(layers.synthetics[s], eye, pixel, 3);
+                worst_alpha = std::max(worst_alpha, std::abs(value_at(premultiplied.synthetics[s], eye, pixel, 3) - alpha));
+                const double composed = value_at(plain.synthetics[s], eye, pixel, 3) / 255.0;
+                const double target = alpha / 255.0;
+                const double own = value_at(layers.current, eye, pixel, 3) / 255.0;
+                bool changed = false;
+                for (UINT channel = 0; channel < 3; ++channel) {
+                    double expected = composed > 1.0 / 512.0
+                        ? value_at(layers.synthetics[s], eye, pixel, channel) / 255.0 * (target / composed)
+                        : (own > 1.0 / 512.0 ? value_at(layers.current, eye, pixel, channel) / 255.0 * (target / own) : 0.0);
+                    const double ratio = composed > 1.0 / 512.0 ? target / composed : 0.0;
+                    const double tolerance = 1.0 + 0.5 * ratio + (composed > 1.0 / 512.0 ? expected * 255.0 * 0.5 / (composed * 255.0) : 0.0);
+                    expected = std::min(expected, target) * 255.0;
+                    const int got = value_at(premultiplied.synthetics[s], eye, pixel, channel);
+                    if (composed >= 16.0 / 255.0)
+                        worst_colour = std::max(worst_colour, std::abs(got - expected) - tolerance);
+                    require(got <= alpha + 1, std::string("premultiplied focus ") + c.name + ": colour above alpha");
+                    changed = changed || got != value_at(layers.synthetics[s], eye, pixel, channel);
+                }
+                scaled += changed && composed > 1.0 / 512.0 && std::abs(composed - target) > 4.0 / 255.0;
+            }
+            std::cout << "focus premultiplied " << c.name << (triple ? " 3X" : " 2X") << " synthetic=" << s
+                      << " eye=" << eye << " worst alpha change=" << worst_alpha << " worst colour error beyond tolerance="
+                      << worst_colour << " pixels rescaled in the fade=" << scaled << '\n';
+            require(worst_alpha == 0, std::string("premultiplied focus ") + c.name + ": the alpha changed");
+            require(worst_colour <= 0.0, std::string("premultiplied focus ") + c.name +
+                ": the colour is not the composed colour brought to the alpha");
+            if (std::string_view(c.name) == "saccade")
+                require(scaled >= 100, "premultiplied focus saccade: no pixel of the fade was rescaled, "
+                    "so this case cannot tell the two behaviours apart");
+        }
+    }
+}
