+                sample_current_target(previous_a_at - other, Slice, ViewIndex));
+            float taken_previous_b = sample_match(previous_b,
+                sample_current_target(previous_b_at - backward, Slice, ViewIndex));
+            float taken_current_a = sample_match(current_a,
+                sample_previous_target(current_a_at + other, Slice, ViewIndex));
+            float taken_current_b = sample_match(current_b,
+                sample_previous_target(current_b_at + backward, Slice, ViewIndex));
+            // Revealed: the current endpoint is this motion's own, the previous
+            // one was behind the occluder: the current frame alone.
+            float revealed_a = consistent_a * taken_previous_a * (1.0 - agree_a);
+            float revealed_b = consistent_b * taken_previous_b * (1.0 - agree_b);
+            // Covered: the current endpoint is the occluder's, the previous one
+            // is not: the previous frame alone.
+            float covered_a = taken_current_a * (1.0 - taken_previous_a) * (1.0 - agree_a) *
