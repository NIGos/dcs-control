+    bool use_nvidia_cost) {
+    float fraction = synthesis_fraction();
+    float cell = flow_cell_pixels();
+    float2 current_a_at = pixel - (1.0 - fraction) * backward;
+    float residual_a = length(flow_for_pixel(
+        current_a_at, Slice, ViewIndex, value_scale, use_nvidia_cost) - backward);
+    static const float2 directions[4] = {
+        float2(1.0, 0.0), float2(-1.0, 0.0), float2(0.0, 1.0), float2(0.0, -1.0)};
+    float2 other = backward;
+    float split = 0.0;
+    [unroll] for (uint ring = 0; ring < 2; ++ring) {
+        float radius = cell * (ring == 0 ? 2.0 : 5.0);
+        [unroll] for (uint i = 0; i < 4; ++i) {
+            float2 probe = flow_point(pixel + directions[i] * radius, Slice, ViewIndex, value_scale);
+            float distance_to_a = length(probe - backward);
+            if (distance_to_a > split) {
+                split = distance_to_a;
+                other = probe;
+            }
+        }
+    }
