+// DCS Control (0030): moving edges on the NVIDIA path, SynthesisFlags bit 2
+// ([ofxr] nvidia_occlusion_aware=1 or 2). The flow is a current-to-previous
+// vector attached to the CURRENT pixel, so the pixel c that lands on the
+// output pixel p at instant t solves c = p - (1 - t) * flow(c): reading the
+// flow at p itself is exact only where the field is constant, and at a moving
+// edge it puts halos (1 - t) * |flow| wide around the object.
+bool moving_edge_flag() {
+    return (SynthesisFlags & 4u) != 0u;
+}
+
+// DCS Control (0030): SynthesisFlags bit 3 ([ofxr] nvidia_occlusion_aware=2)
+// adds the occlusion choice on top of bit 2: where the two frames still
+// disagree at a moving edge the pixel is being covered or revealed, and the
+// cross-fade at the same pixel shows both frames' content at half strength
+// there (a double image); occlusion_aware_midpoint takes the frame that
+// shows the pixel instead.
+bool occlusion_choice_flag() {
+    return (SynthesisFlags & 8u) != 0u;
+}
+
+// The flow cell under a pixel, without interpolation: a neighbour probe.
+float2 flow_point(float2 pixel, uint slice, uint view_index, float value_scale) {
+    float2 scaled = flow_input_coordinate(pixel);
+    float2 packed_coordinate = float2(scaled.x, scaled.y + float(slice * PackedEyeStride));
+    FlowGridBounds bounds = flow_grid_bounds(PreviousMappings[view_index].TargetRect, slice);
+    int2 cell = clamp(
+        int2(round((packed_coordinate + 0.5) / float(FlowBlockSize) - 0.5)),
+        bounds.minimum,
+        bounds.maximum);
+    return float2(BackwardFlow.Load(int3(cell, 0))) * value_scale /
+        max(flow_input_scale(), float2(1.0e-6, 1.0e-6));
+}
+
+// How alike two samples are, 1 for the same colour, 0 for unlike or missing.
+float sample_match(CameraSample a, CameraSample b) {
+    return a.valid >= 0.5 && b.valid >= 0.5
+        ? saturate(1.0 - rgb_error(a.color, b.color) * 6.0) : 0.0;
+}
+
+// One flow cell in full-resolution pixels.
+float flow_cell_pixels() {
+    return float(FlowBlockSize) / max(flow_input_scale().x, 1.0e-6);
+}
+
+// Two fixed-point steps of c = p - (1 - t) * flow(c), from `start`, as the
+// game-motion branch does. residual: how much the last step still moved the
+// vector (near zero where it converged; at an occlusion, or where the field is
+// noise, it does not, and the caller keeps the vector at the pixel there).
+float2 flow_fixed_point(
+    float2 pixel,
+    float2 start,
+    float fraction,
+    float value_scale,
+    bool use_nvidia_cost,
+    out float residual) {
+    float2 backward = start;
+    residual = 0.0;
+    [unroll] for (uint iteration = 0; iteration < 2; ++iteration) {
+        float2 next = flow_for_pixel(
+            pixel - (1.0 - fraction) * backward, Slice, ViewIndex, value_scale, use_nvidia_cost);
+        residual = length(next - backward);
+        backward = next;
+    }
+    return backward;
+}
+
+// Where the flow midpoint fails, which frame actually shows this pixel.
+// Two candidate motions: A, the one the midpoint used, and B, the most
