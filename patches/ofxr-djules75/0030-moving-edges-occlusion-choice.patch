+        // at all: the four confirmations are most of this branch's cost.
+        float4 single = composed;
+        float certainty = 0.0;
+        [branch] if (remaining * flow_trust > 0.01) {
+            // Which frame shows it, confirmed rather than assumed: a candidate's
+            // previous endpoint is "taken" when the other motion carries what is
+            // there to the current frame (the occluder that hid it), and its
+            // current endpoint is taken when the other motion brings it there
+            // from the previous frame (the occluder that now hides it).
