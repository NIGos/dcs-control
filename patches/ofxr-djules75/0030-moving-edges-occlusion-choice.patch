+// DCS Control (0030): the moving-edge and occlusion handling against the true
+// in-between frame. Each scene is drawn at the previous capture, the current
+// capture and exactly halfway, from smooth non-repeating textures (sums of
+// sines at unrelated frequencies) that move rigidly with their layer, so a
+// sample taken from the wrong place or the wrong frame is an error, and the
+// flow has structure to match without repeated patterns to alias on.
+struct OcclusionScene {
+    StereoPattern image;
+    std::vector<std::uint8_t> foreground;
+};
+
+struct OcclusionMotion {
+    const char* name;
+    int foreground_dx, foreground_dy, background_dx, background_dy;
+};
+
+constexpr std::array<OcclusionMotion, 5> kOcclusionMotions{{
+    // A textured object passing over a textured, still background.
+    {"object", 24, 0, 0, 0},
+    // A thin bar (a canopy frame) sweeping across a still background.
+    {"thin_bar", 12, 0, 0, 0},
+    // A still canopy frame and HUD box while the world moves behind (a roll).
+    {"still_frame_moving_world", 0, 0, 20, -8},
+    // Both layers moving, in different directions (an aircraft passing by
+    // while the view turns).
+    {"both_moving", 20, 0, 0, -12},
+    // A bar moving further than its own width: no flow vector at the
+    // in-between position belongs to it (the limit of a one-pair method).
+    {"fast_thin_bar", 24, 0, 0, 0},
+}};
+
+// Hashed value noise, smoothly interpolated: structure at every position
+// with no period for the flow to alias on.
+double occlusion_noise(double x, double y, double cell, std::uint32_t seed) noexcept {
+    const double fx = x / cell, fy = y / cell;
+    const double ix = std::floor(fx), iy = std::floor(fy);
+    const auto hash = [seed](std::int64_t a, std::int64_t b) {
+        std::uint32_t h = static_cast<std::uint32_t>(a) * 0x8da6b343U ^
+            static_cast<std::uint32_t>(b) * 0xd8163841U ^ seed * 0xcb1ab31fU;
+        h ^= h >> 13; h *= 0x5bd1e995U; h ^= h >> 15;
+        return static_cast<double>(h & 0xffffU) / 65535.0;
+    };
+    const auto smooth = [](double t) { return t * t * (3.0 - 2.0 * t); };
+    const double tx = smooth(fx - ix), ty = smooth(fy - iy);
+    const auto a = static_cast<std::int64_t>(ix), b = static_cast<std::int64_t>(iy);
+    const double top = hash(a, b) + (hash(a + 1, b) - hash(a, b)) * tx;
+    const double bottom = hash(a, b + 1) + (hash(a + 1, b + 1) - hash(a, b + 1)) * tx;
+    return top + (bottom - top) * ty;
+}
+
+std::array<std::uint8_t, 3> occlusion_texture(double x, double y, int layer) noexcept {
+    std::array<std::uint8_t, 3> texel{};
+    for (std::uint32_t c = 0; c < 3; ++c) {
+        const std::uint32_t seed = static_cast<std::uint32_t>(layer) * 7U + c + 1U;
+        double value = 0.55 * occlusion_noise(x, y, 41.0, seed) +
+            0.30 * occlusion_noise(x, y, 13.0, seed + 17U) +
+            0.15 * occlusion_noise(x, y, 5.0, seed + 31U);
+        // The foreground darker on red, brighter on blue: an object over a scene.
+        value = layer == 0 ? 30.0 + 200.0 * value
+                           : (c == 0 ? 10.0 + 120.0 * value : c == 1 ? 40.0 + 150.0 * value : 90.0 + 160.0 * value);
+        texel[c] = static_cast<std::uint8_t>(std::clamp(value, 0.0, 255.0) + 0.5);
+    }
+    return texel;
+}
+
+bool occlusion_foreground(int kind, int x, int y, int width, int height) noexcept {
+    switch (kind) {
+    case 0:
+    case 3:
+        return x >= width * 3 / 10 && x < width * 3 / 10 + 240 && y >= height / 3 &&
+            y < height / 3 + 200;
+    case 1:
+        return x >= width * 2 / 5 && x < width * 2 / 5 + 16;
+    case 2:
+        // A canopy bow and a sill, and a HUD combiner's frame.
+        return (x >= width / 3 && x < width / 3 + 16) ||
+            (y >= height * 3 / 4 && y < height * 3 / 4 + 14) ||
+            (x >= width * 3 / 5 && x < width * 3 / 5 + 180 && y >= height / 4 &&
+                y < height / 4 + 140 &&
+                (x < width * 3 / 5 + 6 || x >= width * 3 / 5 + 174 || y < height / 4 + 6 ||
+                    y >= height / 4 + 134));
+    default:
+        return x >= width * 2 / 5 && x < width * 2 / 5 + 10;
+    }
+}
+
+// half_steps: 0 at the previous capture, 1 halfway, 2 at the current one.
+OcclusionScene occlusion_scene(UINT width, UINT height, int kind, int half_steps) {
+    const OcclusionMotion& motion = kOcclusionMotions[static_cast<std::size_t>(kind)];
+    const int fx = motion.foreground_dx * half_steps / 2;
+    const int fy = motion.foreground_dy * half_steps / 2;
+    const int bx = motion.background_dx * half_steps / 2;
+    const int by = motion.background_dy * half_steps / 2;
+    OcclusionScene scene;
+    scene.foreground.assign(static_cast<std::size_t>(width) * height, 0);
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        auto& bytes = scene.image[eye];
+        bytes.resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const int ix = static_cast<int>(x);
+                const int iy = static_cast<int>(y);
+                const bool front = occlusion_foreground(kind, ix - fx, iy - fy,
+                    static_cast<int>(width), static_cast<int>(height));
+                const auto texel = front
+                    ? occlusion_texture(ix - fx, iy - fy, 1)
+                    : occlusion_texture(ix - bx, iy - by, 0);
+                const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                bytes[i] = texel[0];
+                bytes[i + 1] = texel[1];
+                bytes[i + 2] = texel[2];
+                bytes[i + 3] = 255;
+                if (eye == 0) {
+                    scene.foreground[static_cast<std::size_t>(y) * width + x] = front ? 1 : 0;
+                }
+            }
+        }
+    }
+    return scene;
+}
+
+StereoPattern synthesize_nvidia_pair(D3D12WarpFixture& fixture, const StereoPattern& a,
+    const StereoPattern& b, UINT width, UINT height,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options) {
+    std::array<ComPtr<ID3D12Resource>, 2> sources{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    auto current = create_source_texture(fixture, width, height);
+    auto synthetic = create_source_texture(fixture, width, height);
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 1> current_out{current.Get()}, synthetic_out{synthetic.Get()};
+    upload_pattern(fixture, sources[0].Get(), a);
+    upload_pattern(fixture, sources[1].Get(), b);
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(fixture.device(), fixture.queue(), input,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "occlusion history");
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(fixture.device(), fixture.queue(), history,
+        current_out, synthetic_out, kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET,
+        xrfg::D3D12OpticalFlowBackend::nvidia, options), "occlusion initialize");
+    const auto views = make_reprojection_views();
+    xrfg::D3D12HistoryCaptureTicket ca{}, cb{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ca), "occlusion A");
+    require_hresult(history->commit(ca), "occlusion commit A");
+    require_hresult(synth.submit_prime(ca, views, 0, &output), "occlusion prime");
+    fixture.execute_and_wait([](ID3D12GraphicsCommandList*) {});
+    require_hresult(history->capture(1, &cb), "occlusion B");
+    require_hresult(history->commit(cb), "occlusion commit B");
+    require_hresult(synth.submit_pair(cb, views, views, 0, 0, &output), "occlusion pair");
+    auto image = readback_pattern(fixture, synthetic.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+    require_hresult(synth.wait_for_idle(), "occlusion drain");
+    fixture.require_no_debug_errors();
+    return image;
+}
+
+// Mean absolute RGB error over both eyes, inside the margin, where `mask` is
+// set (or everywhere for an empty mask).
+double masked_mae(const StereoPattern& actual, const StereoPattern& expected, UINT width,
+    UINT height, const std::vector<std::uint8_t>& mask, UINT margin = 32) {
+    double total = 0.0;
+    std::size_t count = 0;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (UINT y = margin; y + margin < height; ++y) {
+            for (UINT x = margin; x + margin < width; ++x) {
+                if (!mask.empty() && mask[static_cast<std::size_t>(y) * width + x] == 0) continue;
+                const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                for (UINT c = 0; c < 3; ++c) {
+                    total += std::abs(int(actual[eye][i + c]) - int(expected[eye][i + c]));
+                }
+                count += 3;
+            }
+        }
+    }
+    return count == 0 ? 0.0 : total / static_cast<double>(count);
+}
+
+// The moving-edge region: where the foreground covers a pixel at some of the
+// three instants but not all, and where the background seen halfway is hidden
+// behind the foreground in either capture; grown by 4 px for the filtering
+// around it.
+std::vector<std::uint8_t> occlusion_edge_mask(int kind, UINT width, UINT height) {
+    const OcclusionMotion& motion = kOcclusionMotions[static_cast<std::size_t>(kind)];
+    const int w = static_cast<int>(width), h = static_cast<int>(height);
+    const auto front = [&](int x, int y, int fx, int fy) {
+        return occlusion_foreground(kind, x - fx, y - fy, w, h);
+    };
+    std::vector<std::uint8_t> raw(static_cast<std::size_t>(width) * height, 0);
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            const bool previous = front(x, y, 0, 0);
+            const bool middle = front(x, y, motion.foreground_dx / 2, motion.foreground_dy / 2);
+            const bool current = front(x, y, motion.foreground_dx, motion.foreground_dy);
+            bool edge = previous != middle || current != middle;
+            if (!middle) {
+                // The background point seen here halfway, in each capture.
+                const int ux = x - motion.background_dx / 2, uy = y - motion.background_dy / 2;
+                edge = edge || front(ux, uy, 0, 0) ||
+                    front(ux + motion.background_dx, uy + motion.background_dy,
+                        motion.foreground_dx, motion.foreground_dy);
+            }
+            raw[static_cast<std::size_t>(y) * width + x] = edge ? 1 : 0;
+        }
+    }
+    std::vector<std::uint8_t> grown(raw.size(), 0);
+    constexpr int kGrow = 4;
+    for (int y = 0; y < h; ++y) {
+        for (int x = 0; x < w; ++x) {
+            bool any = false;
+            for (int dy = -kGrow; dy <= kGrow && !any; ++dy) {
+                for (int dx = -kGrow; dx <= kGrow && !any; ++dx) {
+                    const int sx = x + dx, sy = y + dy;
+                    any = sx >= 0 && sy >= 0 && sx < w && sy < h &&
+                        raw[static_cast<std::size_t>(sy) * width + sx] != 0;
+                }
+            }
+            grown[static_cast<std::size_t>(y) * width + x] = any ? 1 : 0;
+        }
+    }
+    return grown;
+}
+
+// XRFG_TEST_NVIDIA_OCCLUSION_QUALITY=1 on NVIDIA hardware: every scene at
+// each nvidia_occlusion_aware level (0 the composition as before, 1 moving
+// edges followed, 2 with the occlusion choice), for each preset and with and
+// without the bidirectional flow; then the Fast/Medium controls above. Level
+// 1 must stay within 2 % of level 0 everywhere (the engine is deterministic
+// here; the allowance is for the few scenes where the followed vector is a
+// hair worse); level 2 must be better at the edges of the moving objects it
+// is for. Its cost on the still canopy frame over a moving world is printed,
+// not required: it is why level 2 is not the default.
+void run_nvidia_occlusion_controls() {
+    D3D12WarpFixture fixture(true);
+    constexpr UINT width = 1024, height = 768;
+    const auto preset_name = [](xrfg::D3D12NvidiaPerformancePreset preset) {
+        return preset == xrfg::D3D12NvidiaPerformancePreset::fast ? "fast" : "medium";
+    };
+    for (int kind = 0; kind < static_cast<int>(kOcclusionMotions.size()); ++kind) {
+        const auto previous = occlusion_scene(width, height, kind, 0);
+        const auto middle = occlusion_scene(width, height, kind, 1);
+        const auto current = occlusion_scene(width, height, kind, 2);
+        const auto edges = occlusion_edge_mask(kind, width, height);
+        const std::string name = kOcclusionMotions[static_cast<std::size_t>(kind)].name;
+        for (auto preset : {xrfg::D3D12NvidiaPerformancePreset::medium,
+                            xrfg::D3D12NvidiaPerformancePreset::fast}) {
+            for (bool bidirectional : {false, true}) {
+                std::array<double, 3> mae{}, edge{};
+                for (std::uint32_t level = 0; level < 3; ++level) {
+                    xrfg::D3D12NvidiaOpticalFlowOptions options;
+                    options.preset = preset;
+                    options.bidirectional = bidirectional;
+                    options.occlusion_aware = level;
+                    const auto image = synthesize_nvidia_pair(
+                        fixture, previous.image, current.image, width, height, options);
+                    mae[level] = masked_mae(image, middle.image, width, height, {});
+                    edge[level] = masked_mae(image, middle.image, width, height, edges);
+                }
+                std::cout << "occlusion scene=" << name << " preset=" << preset_name(preset)
+                          << " bidirectional=" << bidirectional << " mae " << mae[0] << " / "
+                          << mae[1] << " / " << mae[2] << " edge_mae " << edge[0] << " / "
+                          << edge[1] << " / " << edge[2] << std::endl;
+                require(mae[1] <= mae[0] * 1.02 + 0.01 && edge[1] <= edge[0] * 1.02 + 0.05,
+                    "moving-edge following is worse on " + name);
+                if (name == "object" || name == "thin_bar" || name == "both_moving") {
+                    require(edge[2] < edge[0] && mae[2] < mae[0],
+                        "the occlusion choice does not help on " + name);
+                }
+            }
+        }
+    }
+    constexpr UINT control_width = 1342, control_height = 1464;
+    for (int kind = 0; kind < 4; ++kind) {
+        const auto a = fast_control_pattern(control_width, control_height, 0, kind);
+        const auto b = fast_control_pattern(control_width, control_height, 24, kind);
+        const auto expected = fast_control_pattern(control_width, control_height, 12, kind);
+        for (auto preset : {xrfg::D3D12NvidiaPerformancePreset::fast,
+                            xrfg::D3D12NvidiaPerformancePreset::medium}) {
+            std::array<double, 3> mae{};
+            std::array<std::size_t, 3> changed{};
+            for (std::uint32_t level = 0; level < 3; ++level) {
+                xrfg::D3D12NvidiaOpticalFlowOptions options;
+                options.preset = preset;
+                options.occlusion_aware = level;
+                const auto image = synthesize_nvidia_pair(
+                    fixture, a, b, control_width, control_height, options);
+                mae[level] = masked_mae(image, expected, control_width, control_height, {});
+                for (UINT eye = 0; eye < 2; ++eye) for (UINT y = 32; y + 32 < control_height; ++y)
+                    for (UINT x = 32; x + 32 < control_width; ++x) {
+                        const auto i = (static_cast<std::size_t>(y) * control_width + x) * 4;
+                        if (a[eye][i] != b[eye][i] || b[eye][i] != expected[eye][i]) continue;
+                        changed[level] += std::abs(int(image[eye][i]) - int(expected[eye][i])) > 2;
+                    }
+            }
+            std::cout << "control kind=" << kind << " preset=" << preset_name(preset) << " mae "
+                      << mae[0] << " / " << mae[1] << " / " << mae[2] << " stationary_changed "
+                      << changed[0] << " / " << changed[1] << " / " << changed[2] << std::endl;
+            require(mae[1] <= mae[0] * 1.02 + 0.01,
+                "moving-edge following is worse on control kind " + std::to_string(kind));
+            if (preset == xrfg::D3D12NvidiaPerformancePreset::fast && kind == 0) {
+                require(changed[1] == 0 && changed[2] == 0,
+                    "Fast must not invent motion in identical high-contrast captures");
+            }
