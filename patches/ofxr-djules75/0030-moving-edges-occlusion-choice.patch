+            pixel + fraction * other, Slice, ViewIndex);
+        CameraSample current_b = sample_current_target(current_b_at, Slice, ViewIndex);
+        float consistent_b = current_b.valid >= 0.5
+            ? 1.0 - smoothstep(0.5, 2.0, residual_b) : 0.0;
+        float agree_b = previous_b.valid >= 0.5 && current_b.valid >= 0.5
+            ? saturate(1.0 - rgb_error(previous_b.color, current_b.color) * 6.0) : 0.0;
