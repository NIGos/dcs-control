+// DCS Control (0081): the 2X release offset against the frame it delays.
+//
+// The offset (SessionState::application_release_offset) is a sleep between
+// the hold's release and the application's start, steered so that the
+// application completes a quarter period after a pop instead of on it. It is
+// stepped only from eight completions that agree, always by adding modulo
+// one period, and it is slept on every release whatever the frame then
+// takes. Two things follow, both measured in flight (deeper pipeline, 90
+// Hz):
+//  - a step taken while the frame is light stays when it is heavy again: 10.5
+//    ms learnt on the F10 map (3 ms frames) beside a 12 ms frame is 24.4 ms a
+//    frame against 22.2 for its two slots. The application then runs at 41
+//    fps on the sleep alone, a slot is lost every 4-5 frames (406), and the
+//    steering cannot undo it: a frame that drifts 2.2 ms a frame through the
+//    cycle never gives eight phases that agree. 56 s of it, until chance.
+//  - a step taken from the band below the boundary (a frame that ends 2 ms
+//    before the pop) adds a quarter period and more, which puts a frame that
+//    fitted its slots past them: 8.1 ms beside a 14 ms frame, a second of 42
+//    fps.
+//
+// So the guard keeps the application's own time from each release to its
+// next hold (its work and its xrEndFrame, the sleep left out), and
+//  - `fits`: a step is not taken where it would put a frame that fits the
+//    slots of its cadence past them (the longest of the last eight);
+//  - `observe`: a release that found the application behind its count
+//    (presenter_pair_release's surplus) with a frame that fitted its slots
+//    alone and not with the offset is charged to the offset; kCharged of
+//    them within kWindow releases and the offset is dropped to zero (the
+//    steering then learns it again from frames released without it, as at a
+//    session's start).
+// Neither acts on a frame that does not fit its slots by itself: there the
+// offset and its steering are as they were. A hold that waited (no surplus)
+// charges nothing, so an offset that fits is never dropped.
+struct ReleaseOffsetGuard {
+    static constexpr std::uint32_t kCharged = 3;
+    static constexpr std::uint32_t kWindow = 64;
+    static constexpr std::size_t kOwn = 8;
+
+    Nanoseconds own[kOwn]{};
+    std::uint32_t owns{};
+    std::uint32_t judged{};
+    std::uint32_t charged{};
+    std::uint32_t drops{};
+    std::uint32_t steps_refused{};
+
+    // The application's own time before the release being judged.
+    constexpr void note(Nanoseconds own_time) noexcept {
+        own[owns % kOwn] = own_time;
+        ++owns;
+    }
+    [[nodiscard]] constexpr Nanoseconds longest() const noexcept {
+        Nanoseconds result = 0;
+        const std::size_t count = owns < kOwn ? owns : kOwn;
+        for (std::size_t index = 0; index < count; ++index) {
+            result = own[index] > result ? own[index] : result;
+        }
+        return result;
+    }
+    // Whether the steering may step to `offset`: `budget` the slots of the
+    // frame's cadence.
+    [[nodiscard]] constexpr bool fits(
+        Nanoseconds offset, Nanoseconds budget) const noexcept {
+        const Nanoseconds frame = longest();
+        return owns == 0 || frame > budget || frame + offset <= budget;
+    }
+    constexpr void refused() noexcept { ++steps_refused; }
+    // One release with `offset` in force: `behind`, the application was
+    // behind its count; `own_time`, as for note (0 when not known). True:
+    // drop the offset.
+    [[nodiscard]] constexpr bool observe(
+        bool behind,
+        Nanoseconds offset,
+        Nanoseconds own_time,
+        Nanoseconds budget) noexcept {
+        if (offset <= 0) {
+            judged = 0;
+            charged = 0;
+            return false;
+        }
+        ++judged;
+        if (behind && own_time > 0 && own_time <= budget &&
+            own_time + offset > budget) {
+            ++charged;
+        }
+        if (charged >= kCharged) {
+            judged = 0;
+            charged = 0;
+            ++drops;
+            return true;
+        }
+        if (judged >= kWindow) {
+            judged = 0;
+            charged = 0;
+        }
+        return false;
+    }
+};
+
 } // namespace xrfg::latency
