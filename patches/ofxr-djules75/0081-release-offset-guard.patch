diff --git a/tests/layer_release_offset.cmake b/tests/layer_release_offset.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_release_offset.cmake
@@ -0,0 +1,243 @@
+# DCS Control (0081): the 2X release offset (presenter_transition 800) when
+# the application's frame changes weight, and `[ofxr] release_offset_guard`.
+# Runs the call chain's "dcs-release-offset" (dcs-deep-hold's session: fixed
+# 2X, the deeper pipeline) with SHAPE, the application's phases as
+# "render us:frames/render us:frames/...", and judges the flight log. The last
+# phase is the one judged ("the return"); its first third is left to settle
+# and the rest is "the tail".
+#   EXPECT=fixed (the guard on): in the tail at most one release in fifty is
+#     behind its count (presenter_pair_release result > 0) and at most one slot
+#     in fifty is held (presenter_transition 406), whether the guard had to
+#     refuse a step (805), drop the offset (804) or nothing.
+#   EXPECT=dropped: fixed, and the offset in force when the return starts is
+#     ARM_US or more (else "NOT ARMED": the machine did not reach the case)
+#     and an 804 follows in the return.
+#   EXPECT=off (`release_offset_guard=0`): no 804 and no 805. The stuck
+#     regime this leaves (the offset at the return ARM_US or more, one release
+#     in ten of the tail behind) is reported, not required: whether the
+#     steering takes the first step depends on where the machine puts the
+#     burst's completion.
+#   EXPECT=stuck: off, with that regime required (for runs by hand).
+#   EXPECT=stays: the guard does not act: no 804 anywhere.
+#   EXPECT=report: nothing required (the counts are printed).
+# TWO=1 (foveated frame generation's two-layer shape, where the tree has it):
+# the scenario as "two:dcs-release-offset" with `foveated_layers=1`.
+# EXTRA_KEYS ("key=value,key=value") go under [ofxr].
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN BASE_INI WORK_DIR SHAPE EXPECT)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+if(NOT DEFINED ARM_US)
+    set(ARM_US 6000)
+endif()
+if(NOT DEFINED TWO)
+    set(TWO 0)
+endif()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(READ "${BASE_INI}" ini_text)
+set(added "")
+if(TWO)
+    string(APPEND added "foveated_layers=1\n")
+endif()
+if(DEFINED EXTRA_KEYS)
+    string(REPLACE "," ";" EXTRA_KEYS "${EXTRA_KEYS}")
+    foreach(extra_key IN LISTS EXTRA_KEYS)
+        string(APPEND added "${extra_key}\n")
+    endforeach()
+endif()
+string(REPLACE "[ofxr]" "[ofxr]\n${added}" ini_text "${ini_text}")
+string(REPLACE "logging_enabled=0" "logging_enabled=1" ini_text "${ini_text}")
+file(WRITE "${WORK_DIR}/ofxr_bridge.ini" "${ini_text}")
+
+if(TWO)
+    set(scenario "two:dcs-release-offset")
+else()
+    set(scenario "dcs-release-offset")
+endif()
+# SHAPE has '/' between the phases (a ';' would split the argument).
+string(REPLACE "/" ";" shape_phases "${SHAPE}")
+list(LENGTH shape_phases phase_count)
+set(ENV{XRFG_TEST_RELEASE_OFFSET_SHAPE} "${SHAPE}")
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${scenario}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${scenario}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+math(EXPR return_phase "${phase_count} - 1")
+if(NOT call_chain_output MATCHES "RELEASE_OFFSET_PHASE${return_phase}_FROM=([0-9]+)")
+    message(FATAL_ERROR "The scenario printed no RELEASE_OFFSET_PHASE${return_phase}_FROM")
+endif()
+set(mark_return "${CMAKE_MATCH_1}")
+if(NOT call_chain_output MATCHES "RELEASE_OFFSET_END=([0-9]+)")
+    message(FATAL_ERROR "The scenario printed no RELEASE_OFFSET_END")
+endif()
+set(mark_end "${CMAKE_MATCH_1}")
+list(GET shape_phases ${return_phase} return_shape)
+string(REGEX REPLACE "^[0-9]+:" "" return_frames "${return_shape}")
+math(EXPR settle_releases "${return_frames} / 3")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+
+# In log order: the frames' display times (projection_mapping's a), the
+# steering's steps (800), the guard (804), the held slots (406) and the
+# application's releases.
+file(STRINGS "${flight_log}" lines
+    REGEX " op=(projection_mapping|presenter_transition|presenter_pair_release) result=")
+set(field_pattern "result=(-?[0-9]+) dur_us=([0-9]+) a=([0-9]+) b=([0-9]+) c=([0-9]+)")
+set(phase 0)            # 0 before the return, 1 in it, 2 after it
+set(offset_now 0)
+set(offset_at_return -1)
+set(offset_highest 0)
+set(steps_before 0)
+set(steps_return 0)
+set(drops_before 0)
+set(drops_return 0)
+set(drop_text "")
+set(step_text "")
+set(refused 0)
+set(releases 0)
+set(surplus 0)
+set(held 0)
+set(tail_releases 0)
+set(tail_surplus 0)
+set(tail_held 0)
+set(tail_first_ms -1)
+set(tail_last_ms -1)
+foreach(line IN LISTS lines)
+    if(NOT line MATCHES "ms=([0-9]+)[^ ]* .* op=([a-z_]+) ${field_pattern}")
+        continue()
+    endif()
+    set(ms "${CMAKE_MATCH_1}")
+    set(op "${CMAKE_MATCH_2}")
+    set(result "${CMAKE_MATCH_3}")
+    set(a "${CMAKE_MATCH_5}")
+    set(b "${CMAKE_MATCH_6}")
+    set(c "${CMAKE_MATCH_7}")
+    if(op STREQUAL "projection_mapping")
+        if(phase EQUAL 0 AND a STREQUAL mark_return)
+            set(phase 1)
+            set(offset_at_return ${offset_now})
+        elseif(phase EQUAL 1 AND a STREQUAL mark_end)
+            set(phase 2)
+        endif()
+    elseif(op STREQUAL "presenter_transition")
+        if(result EQUAL 800)
+            set(offset_now ${b})
+            string(APPEND step_text " ${a}>${b}")
+            if(offset_now GREATER offset_highest)
+                set(offset_highest ${offset_now})
+            endif()
+            if(phase EQUAL 0)
+                math(EXPR steps_before "${steps_before} + 1")
+            elseif(phase EQUAL 1)
+                math(EXPR steps_return "${steps_return} + 1")
+            endif()
+        elseif(result EQUAL 804)
+            set(offset_now 0)
+            if(phase EQUAL 0)
+                math(EXPR drops_before "${drops_before} + 1")
+            elseif(phase EQUAL 1)
+                math(EXPR drops_return "${drops_return} + 1")
+                string(APPEND drop_text " [release ${releases}: offset ${a} us, frame ${b} us of ${c}]")
+            endif()
+        elseif(result EQUAL 805)
+            math(EXPR refused "${refused} + ${a}")
+        elseif(result EQUAL 406 AND phase EQUAL 1)
+            math(EXPR held "${held} + 1")
+            if(releases GREATER_EQUAL settle_releases)
+                math(EXPR tail_held "${tail_held} + 1")
+            endif()
+        endif()
+    elseif(op STREQUAL "presenter_pair_release" AND phase EQUAL 1)
+        math(EXPR releases "${releases} + 1")
+        if(result GREATER 0)
+            math(EXPR surplus "${surplus} + 1")
+        endif()
+        if(releases GREATER settle_releases)
+            math(EXPR tail_releases "${tail_releases} + 1")
+            if(result GREATER 0)
+                math(EXPR tail_surplus "${tail_surplus} + 1")
+            endif()
+            if(tail_first_ms LESS 0)
+                set(tail_first_ms ${ms})
+            endif()
+            set(tail_last_ms ${ms})
+        endif()
+    endif()
+endforeach()
+set(rate "?")
+if(tail_releases GREATER 1 AND tail_last_ms GREATER tail_first_ms)
+    math(EXPR rate_x10 "(${tail_releases} - 1) * 10000 / (${tail_last_ms} - ${tail_first_ms})")
+    math(EXPR rate_whole "${rate_x10} / 10")
+    math(EXPR rate_tenth "${rate_x10} % 10")
+    set(rate "${rate_whole}.${rate_tenth}")
+endif()
+set(summary
+    "release offset '${scenario}' ${SHAPE} (${EXPECT}): offset at the return ${offset_at_return} us "
+    "(highest ${offset_highest}), 800 steps ${steps_before} before / ${steps_return} in the return, "
+    "800 as phase>offset us:${step_text}; 804 ${drops_before} before / ${drops_return} in the return${drop_text}, steps refused (805) ${refused}; return: ${releases} "
+    "releases, ${surplus} behind their count, ${held} x 406; tail: ${tail_releases} releases, "
+    "${tail_surplus} behind, ${tail_held} x 406, ${rate} application frames a second")
+string(CONCAT summary ${summary})
+message(STATUS "${summary}")
+if(phase EQUAL 0 OR releases EQUAL 0)
+    message(FATAL_ERROR "The return phase was not found in the flight log. ${summary}")
+endif()
+math(EXPR drops_total "${drops_before} + ${drops_return}")
+math(EXPR tenth "${tail_releases} / 10")
+math(EXPR fiftieth "${tail_releases} / 50")
+set(regime "clean")
+if(tail_surplus GREATER_EQUAL tenth AND tail_surplus GREATER 0)
+    set(regime "STUCK")
+endif()
+message(STATUS "release offset regime in the tail: ${regime}")
+if(EXPECT STREQUAL "stuck" OR EXPECT STREQUAL "dropped")
+    if(offset_at_return LESS ARM_US)
+        message(FATAL_ERROR
+            "NOT ARMED: the release offset was ${offset_at_return} us when the return "
+            "started, under the ${ARM_US} us the case needs; nothing is judged. ${summary}")
+    endif()
+endif()
+if(EXPECT STREQUAL "stuck" OR EXPECT STREQUAL "off")
+    if(NOT drops_total EQUAL 0 OR NOT refused EQUAL 0)
+        message(FATAL_ERROR "Expected no 804 and no 805 with the guard off. ${summary}")
+    endif()
+    if(EXPECT STREQUAL "stuck" AND NOT regime STREQUAL "STUCK")
+        message(FATAL_ERROR "Expected the stuck regime (one release in ten behind). ${summary}")
+    endif()
+elseif(EXPECT STREQUAL "fixed" OR EXPECT STREQUAL "dropped")
+    if(tail_surplus GREATER fiftieth OR tail_held GREATER fiftieth)
+        message(FATAL_ERROR
+            "Expected a clean tail (at most ${fiftieth} releases behind and "
+            "${fiftieth} x 406). ${summary}")
+    endif()
+    if(EXPECT STREQUAL "dropped" AND drops_return LESS 1)
+        message(FATAL_ERROR "Expected the offset dropped (804) in the return. ${summary}")
+    endif()
+elseif(EXPECT STREQUAL "stays")
+    if(NOT drops_total EQUAL 0)
+        message(FATAL_ERROR "Expected no 804. ${summary}")
+    endif()
+elseif(NOT EXPECT STREQUAL "report")
+    message(FATAL_ERROR "Unknown EXPECT=${EXPECT}")
+endif()
diff --git a/tests/layer_release_offset_quiet.cmake b/tests/layer_release_offset_quiet.cmake
