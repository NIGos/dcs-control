+// DCS Control (0081): ReleaseOffsetGuard.
+void release_offset_guard_tests() {
+    constexpr Nanoseconds kMs = 1'000'000;
+    constexpr Nanoseconds kPeriod = 11'111'111;
+    constexpr Nanoseconds kBudget = 2 * kPeriod;
+    // The flight: 10.5 ms of offset learnt on a 3 ms frame, then a 13.6 ms
+    // frame (work and xrEndFrame), one release in five behind.
+    {
+        ReleaseOffsetGuard guard;
+        const Nanoseconds offset = 10'500'000;
+        for (int index = 0; index < 300; ++index) {
+            guard.note(3 * kMs);
+            require(!guard.observe(false, offset, 3 * kMs, kBudget),
+                "guard: an offset that fits is kept (light frames, no surplus)");
+        }
+        int dropped_at = -1;
+        for (int index = 0; index < 64 && dropped_at < 0; ++index) {
+            guard.note(13'600'000);
+            if (guard.observe(index % 5 == 4, offset, 13'600'000, kBudget)) {
+                dropped_at = index;
+            }
+        }
+        require(dropped_at == 14 && guard.drops == 1,
+            "guard: dropped at the third release behind its count");
+        require(!guard.observe(true, 0, 13'600'000, kBudget) && guard.judged == 0,
+            "guard: nothing to judge without an offset");
+    }
+    // A frame that does not fit its slots by itself is not the offset's.
+    {
+        ReleaseOffsetGuard guard;
+        for (int index = 0; index < 500; ++index) {
+            guard.note(25 * kMs);
+            require(!guard.observe(true, 4 * kMs, 25 * kMs, kBudget),
+                "guard: a frame over its slots charges nothing");
+        }
+        require(guard.fits(8 * kMs, kBudget),
+            "guard: steps are as before for a frame over its slots");
+    }
+    // Stalls now and then (a long frame, then surplus while the offset
+    // fits) charge nothing; two charged in a window are forgotten.
+    {
+        ReleaseOffsetGuard guard;
+        for (int index = 0; index < 1000; ++index) {
+            const bool stall = index % 20 == 0;
+            require(!guard.observe(stall, 3 * kMs, stall ? 40 * kMs : 12 * kMs, kBudget),
+                "guard: a stall is not charged");
+        }
+        for (int window = 0; window < 10; ++window) {
+            for (std::uint32_t index = 0; index < ReleaseOffsetGuard::kWindow; ++index) {
+                require(!guard.observe(index < 2, 10 * kMs, 13 * kMs, kBudget),
+                    "guard: two in a window are not enough");
+            }
+        }
+        require(guard.drops == 0, "guard: no drop");
+    }
+    // The step's bound: the longest of the last eight frames.
+    {
+        ReleaseOffsetGuard guard;
+        require(guard.fits(10 * kMs, kBudget), "guard: no frame known, any step");
+        for (int index = 0; index < 8; ++index) {
+            guard.note(18 * kMs);
+        }
+        require(!guard.fits(5 * kMs, kBudget) && guard.fits(4 * kMs, kBudget),
+            "guard: a step may not put a frame that fits past its slots");
+        for (int index = 0; index < 7; ++index) {
+            guard.note(3 * kMs);
+        }
+        require(!guard.fits(5 * kMs, kBudget), "guard: the long frame is still among the eight");
+        guard.note(3 * kMs);
+        require(guard.fits(10 * kMs, kBudget) && guard.longest() == 3 * kMs,
+            "guard: eight light frames, the step is free");
+        require(guard.fits(10 * kMs, 3 * kPeriod) && !guard.fits(10 * kMs, kPeriod + 1 * kMs),
+            "guard: the budget is the cadence's");
+    }
+}
+
