--- /dev/null
+++ b/tests/layer_release_offset_quiet.cmake
@@ -0,0 +1,66 @@
+# DCS Control (0081): `[ofxr] release_offset_guard` (on by default) where the
+# release offset works as it is. Runs a call-chain scenario of the suite with
+# its own ini (BASE_INI, MODE; the scenario's own verdict stands) and requires
+# that the guard dropped nothing: no presenter_transition 804 in the flight
+# log. Steps it refused (805) are printed. C23_EXPECT: the scenario's
+# XRFG_TEST_C23_EXPECT, as layer_cadence_23.cmake sets it.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN BASE_INI WORK_DIR MODE)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(READ "${BASE_INI}" ini_text)
+set(added "")
+if(DEFINED EXTRA_KEYS)
+    string(REPLACE "," ";" EXTRA_KEYS "${EXTRA_KEYS}")
+    foreach(extra_key IN LISTS EXTRA_KEYS)
+        string(APPEND added "${extra_key}\n")
+    endforeach()
+endif()
+string(REPLACE "[ofxr]" "[ofxr]\n${added}" ini_text "${ini_text}")
+string(REPLACE "logging_enabled=0" "logging_enabled=1" ini_text "${ini_text}")
+file(WRITE "${WORK_DIR}/ofxr_bridge.ini" "${ini_text}")
+
+if(DEFINED C23_EXPECT)
+    set(ENV{XRFG_TEST_C23_EXPECT} "${C23_EXPECT}")
+else()
+    unset(ENV{XRFG_TEST_C23_EXPECT})
+endif()
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${MODE}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${MODE}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(STRINGS "${flight_log}" step_lines REGEX " op=presenter_transition result=800 ")
+file(STRINGS "${flight_log}" drop_lines REGEX " op=presenter_transition result=804 ")
+file(STRINGS "${flight_log}" refused_lines REGEX " op=presenter_transition result=805 ")
+list(LENGTH step_lines steps)
+list(LENGTH drop_lines drops)
+list(LENGTH refused_lines refused)
+message(STATUS
+    "release offset guard on '${MODE}': ${steps} steps (800), ${drops} drops (804), "
+    "${refused} records of refused steps (805)")
+if(NOT drops EQUAL 0)
+    message(FATAL_ERROR "The guard dropped the release offset: ${drop_lines}")
+endif()
