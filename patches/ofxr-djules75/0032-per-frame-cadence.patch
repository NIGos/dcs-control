+# DCS Control (0032): runs the dcs-cadence call-chain scenario with
+# `adaptive_frame_gen=1` and `adaptive_cadence=1` (CADENCE_INI beside the
+# layer DLL) and checks, from the flight log, that adaptive cadence ran: on at
+# creation in 2X's shape, never a switch of multiplier, its once-a-second
+# record and the status a flight log is read by, and 1X entered and left. The
+# call chain itself checks what was shown (the synthetics between every two
+# real frames).
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN CADENCE_INI WORK_DIR)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${CADENCE_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(cadence_ini_name "${CADENCE_INI}" NAME)
+file(RENAME "${WORK_DIR}/${cadence_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        dcs-cadence
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+message(STATUS "${call_chain_output}")
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain 'dcs-cadence' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+foreach(expected IN ITEMS
+        # Adaptive on at creation, and adaptive cadence with it, in 2X.
+        "op=adaptive_switch result=5 dur_us=0 a=0 b=2 c=0"
+        "op=adaptive_switch result=13 dur_us=0 a=0 b=2 c=0"
+        # 2X's shape with the deeper pipeline, triple_frame_gen not asked for.
+        "op=presenter_transition result=700 dur_us=0 a=2 b=1 c=0"
+        # Its once-a-second record, and the status under adaptive control.
+        "op=adaptive_throughput result=6 "
+        "op=latency_status result=12 "
+        # 1X entered from 2, and its status.
+        "op=adaptive_switch result=8 dur_us=0 a=2 b=1 c="
+        "op=latency_status result=11 ")
+    string(FIND "${contents}" "${expected}" found)
+    if(found EQUAL -1)
+        message(FATAL_ERROR "The flight log is missing: ${expected}")
+    endif()
+endforeach()
+# 1X left again, on missed slots or on work.
+string(REGEX MATCH "op=adaptive_switch result=(9|10) dur_us=0 a=1 b=2 c=[0-9]+" left_one "${contents}")
+if(left_one STREQUAL "")
+    message(FATAL_ERROR "1X was never left")
+endif()
+# No switch of multiplier: the cadence is each frame's own.
+foreach(unexpected IN ITEMS
+        "op=presenter_transition result=700 dur_us=0 a=3 "
+        "op=adaptive_switch result=1 "
+        "op=adaptive_switch result=2 "
+        "op=adaptive_switch result=3 ")
+    string(FIND "${contents}" "${unexpected}" found)
+    if(NOT found EQUAL -1)
+        message(FATAL_ERROR "The flight log has: ${unexpected}")
+    endif()
+endforeach()
+# Both cadences queued within one second, in some second: a= 1X (bits 0-15),
+# 2 (16-31), 3 (32-47), late (48-63).
+string(REGEX MATCHALL "op=adaptive_throughput result=6 dur_us=0 a=[0-9]+" records "${contents}")
+set(mixed FALSE)
+foreach(record IN LISTS records)
+    string(REGEX REPLACE ".* a=([0-9]+)$" "\\1" packed "${record}")
+    math(EXPR at_two "(${packed} >> 16) & 65535")
+    math(EXPR at_three "(${packed} >> 32) & 65535")
+    if(at_two GREATER 0 AND at_three GREATER 0)
+        set(mixed TRUE)
+    endif()
+endforeach()
+if(NOT mixed)
+    message(FATAL_ERROR "No second with frames of both cadences in: ${records}")
+endif()
