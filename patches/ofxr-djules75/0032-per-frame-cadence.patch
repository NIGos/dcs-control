+// ---------------------------------------------------------------------------
+// DCS Control (0032): adaptive cadence.
+
+// The application under CadenceController: each frame ends one hold (the
+// level in force) after the one before, is fed, and a decision follows.
+struct CadenceSim {
+    CadenceController controller;
+    Nanoseconds now{10 * kSecond};
+    Nanoseconds started{10 * kSecond};
+    std::uint32_t changes{};
+    std::vector<CadenceStep> events;
+
+    explicit CadenceSim(CadenceConfig config = {}) : controller(config) {
+        controller.start(now);
+    }
+    CadenceStep frame(Nanoseconds cpu, Nanoseconds gpu, Nanoseconds synthesis = 0) {
+        now += kPeriod * controller.level();
+        controller.add_frame(now, cpu, gpu, synthesis);
+        const CadenceStep step = controller.decide(now, kPeriod);
+        changes += step.level != step.previous ? 1U : 0U;
+        if (step.event != CadenceEvent::none) {
+            events.push_back(step);
+        }
+        return step;
+    }
+    // Frames of the given work until `event`, at most `limit` of them;
+    // when it happened, or -1.
+    Nanoseconds until(CadenceEvent event, int limit, Nanoseconds cpu,
+        Nanoseconds gpu, Nanoseconds synthesis = 0) {
+        for (int index = 0; index < limit; ++index) {
+            if (frame(cpu, gpu, synthesis).event == event) {
+                return now;
+            }
+        }
+        return -1;
+    }
+};
+
+// Light enough for 1X: CPU 6 ms; GPU 10 ms of which 2 are synthesis, so 8 at
+// 1X - under 80% of the period (8.9 ms).
+constexpr Nanoseconds kOneCpu = 6 * kMillisecond;
+constexpr Nanoseconds kOneGpu = 10 * kMillisecond;
+constexpr Nanoseconds kOneSynthesis = 2 * kMillisecond;
+// Over 95% of the period at 1X (10.6 ms), well inside two.
+constexpr Nanoseconds kOneHeavy = 12 * kMillisecond;
+
+void cadence_choice_tests() {
+    constexpr Nanoseconds kLight = 15 * kMillisecond;
+    constexpr Nanoseconds kHeavy = 25 * kMillisecond; // over 95% of 22.2 ms
+    {
+        // Light for two periods: 2, and it never moves. Its GPU is 14 ms,
+        // so 1X is never in question.
+        CadenceSim sim;
+        for (int index = 0; index < 300; ++index) {
+            sim.frame(kLight, 14 * kMillisecond);
+        }
+        require(sim.controller.level() == 2 && sim.changes == 0 && sim.events.empty(),
+            "light: 2, no change");
+        // Heavy: 3 within a few frames - the first frames over two periods
+        // that put the window's p90 there.
+        int to_three = -1;
+        for (int index = 0; index < 30 && to_three < 0; ++index) {
+            if (sim.frame(kHeavy, 20 * kMillisecond).level == 3) {
+                to_three = index;
+            }
+        }
+        require(to_three >= 0 && to_three <= 3,
+            "heavy -> 3 within frames: " + std::to_string(to_three));
+        // Light again: not before the minimum run, and once the heavy frames
+        // have left the window (half a second), back to 2.
+        int to_two = -1;
+        for (int index = 0; index < 60 && to_two < 0; ++index) {
+            if (sim.frame(kLight, 14 * kMillisecond).level == 2) {
+                to_two = index;
+            }
+        }
+        require(to_two + 1 >= static_cast<int>(CadenceConfig{}.min_run_three) &&
+                to_two <= 20,
+            "light -> 2 after the run and the window: " + std::to_string(to_two));
+        require(sim.changes == 2, "two changes, no flapping");
+    }
+    {
+        // One frame in twenty over two periods is not a trend.
+        CadenceSim sim;
+        for (int index = 0; index < 600; ++index) {
+            sim.frame(index % 20 == 19 ? 24 * kMillisecond : kLight, 14 * kMillisecond);
+        }
+        require(sim.controller.level() == 2 && sim.changes == 0, "spikes: no change");
+    }
+    {
+        // A varying trace: alternating stretches of 2 and 3 follow the work,
+        // a stretch at a time - every change is a stretch's, none flaps.
+        CadenceSim sim;
+        std::uint32_t at_two = 0;
+        std::uint32_t at_three = 0;
+        for (int stretch = 0; stretch < 8; ++stretch) {
+            const bool heavy = stretch % 2 == 1;
+            for (int index = 0; index < 60; ++index) {
+                const CadenceStep step = sim.frame(
+                    heavy ? kHeavy : kLight, heavy ? 23 * kMillisecond : 14 * kMillisecond);
+                if (index == 59) {
+                    at_two += step.level == 2 ? 1U : 0U;
+                    at_three += step.level == 3 ? 1U : 0U;
+                }
+            }
+        }
+        require(at_two == 4 && at_three == 4, "each stretch ends at its own cadence");
+        require(sim.changes == 7, "one change per stretch: " + std::to_string(sim.changes));
+    }
+    {
+        // Between 85% and 95% of two periods (19.5 ms): whichever level is in
+        // force holds - the band is the hysteresis.
+        CadenceSim at_two;
+        for (int index = 0; index < 300; ++index) {
+            at_two.frame(19'500'000, 14 * kMillisecond);
+        }
+        require(at_two.controller.level() == 2 && at_two.changes == 0, "band holds 2");
+        CadenceSim at_three;
+        for (int index = 0; index < 10; ++index) {
+            at_three.frame(kHeavy, 20 * kMillisecond);
+        }
+        require(at_three.controller.level() == 3, "heavy to 3 first");
+        for (int index = 0; index < 300; ++index) {
+            at_three.frame(19'500'000, 14 * kMillisecond);
+        }
+        require(at_three.controller.level() == 3 && at_three.changes == 1, "band holds 3");
+        // A trace that wobbles across the band every frame does not flap.
+        CadenceSim wobble;
+        for (int index = 0; index < 600; ++index) {
+            wobble.frame(index % 2 == 0 ? 19 * kMillisecond : 20'500'000, 14 * kMillisecond);
+        }
+        require(wobble.changes == 0, "wobble inside the band: no change");
+    }
+    {
+        // Missed slots: one episode is not enough, two within a second are.
+        CadenceSim sim;
+        for (int index = 0; index < 50; ++index) {
+            sim.frame(kLight, 14 * kMillisecond);
+        }
+        sim.controller.add_late(sim.now, 1);
+        sim.controller.add_late(sim.now + 50 * kMillisecond, 1); // the same episode
+        sim.frame(kLight, 14 * kMillisecond);
+        sim.frame(kLight, 14 * kMillisecond);
+        require(sim.controller.level() == 2, "one episode: still 2");
+        for (int index = 0; index < 5; ++index) {
+            sim.frame(kLight, 14 * kMillisecond);
+        }
+        sim.controller.add_late(sim.now, 2);
+        require(sim.frame(kLight, 14 * kMillisecond).level == 3, "two episodes: 3");
+        // At 3 the misses decide nothing (they were 2's): back to 2 after
+        // the minimum run, the work being light.
+        int run = 0;
+        while (sim.frame(kLight, 14 * kMillisecond).level == 3 && run < 100) {
+            ++run;
+        }
+        require(run + 1 == static_cast<int>(CadenceConfig{}.min_run_three),
+            "3 -> 2 after the run: " + std::to_string(run + 1));
+        // 2 does not hold - misses again at once - so 3 is held twice as long
+        // each time it comes back within the flap window, up to the cap.
+        std::uint32_t expected = CadenceConfig{}.min_run_three;
+        for (int flap = 0; flap < 4; ++flap) {
+            sim.frame(kLight, 14 * kMillisecond);
+            sim.controller.add_late(sim.now, 1);
+            sim.frame(kLight, 14 * kMillisecond);
+            sim.controller.add_late(sim.now + 120 * kMillisecond, 1);
+            for (int index = 0; index < 8 && sim.controller.level() == 2; ++index) {
+                sim.frame(kLight, 14 * kMillisecond);
+            }
+            expected *= 2;
+            require(sim.controller.level() == 3, "missed again: 3");
+            run = 0;
+            while (sim.frame(kLight, 14 * kMillisecond).level == 3 && run < 1000) {
+                ++run;
+            }
+            require(run + 1 == static_cast<int>(expected),
+                "flap " + std::to_string(flap) + ": run " + std::to_string(run + 1));
+        }
+        // 2 held for the flap window: the next return to 3 needs the base run.
+        while (sim.now < sim.started + 60 * kSecond) {
+            sim.frame(kLight, 14 * kMillisecond);
+        }
+        for (int index = 0; index < 10; ++index) {
+            sim.frame(25 * kMillisecond, 20 * kMillisecond);
+        }
+        require(sim.controller.level() == 3, "heavy: 3");
+        run = 0;
+        while (sim.frame(kLight, 14 * kMillisecond).level == 3 && run < 1000) {
+            ++run;
+        }
+        // The heavy frames leave the window after half a second (15 frames).
+        require(run + 1 >= static_cast<int>(CadenceConfig{}.min_run_three) && run < 40,
+            "the base run again: " + std::to_string(run + 1));
+    }
+    {
+        // Stalls (a loading screen) are not a rate.
+        CadenceSim sim;
+        for (int index = 0; index < 50; ++index) {
+            sim.frame(index % 5 == 0 ? 300 * kMillisecond : kLight, 14 * kMillisecond);
+        }
+        require(sim.controller.level() == 2, "stalled frames are not counted");
+    }
+}
+
+void cadence_one_tests() {
+    {
+        // 1X: from 2 after five seconds of CPU and GPU-at-1X under 80% of
+        // the period, and no sooner.
+        CadenceSim sim;
+        const Nanoseconds entered =
+            sim.until(CadenceEvent::one_entered, 1000, kOneCpu, kOneGpu, kOneSynthesis);
+        require(entered >= sim.started + 5 * kSecond &&
+                entered <= sim.started + 5 * kSecond + 500 * kMillisecond,
+            "1X after five clean seconds");
+        require(sim.controller.level() == 1 && sim.events.back().previous == 2,
+            "1X from 2");
+        require(sim.events.back().predicted_gpu_one == kOneGpu - kOneSynthesis,
+            "the GPU at 1X is the GPU less synthesis");
+        // At 1X, light: it stays (ten seconds).
+        for (int index = 0; index < 900; ++index) {
+            sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+        }
+        require(sim.controller.level() == 1 && sim.events.size() == 1, "1X holds");
+    }
+    {
+        // Never without a GPU figure, with the CPU over 80%, or with a GPU
+        // that synthesis does not free enough of (11 - 2 = 9 ms > 8.9).
+        CadenceSim no_gpu;
+        CadenceSim cpu;
+        CadenceSim gpu;
+        for (int index = 0; index < 600; ++index) {
+            no_gpu.frame(kOneCpu, -1);
+            cpu.frame(9'500'000, kOneGpu, kOneSynthesis);
+            gpu.frame(kOneCpu, 11 * kMillisecond, kOneSynthesis);
+        }
+        require(no_gpu.events.empty() && cpu.events.empty() && gpu.events.empty(),
+            "no 1X without the room for it");
+    }
+    {
+        // A missed slot starts the five seconds over.
+        CadenceSim sim;
+        for (int index = 0; index < 180; ++index) { // four seconds
+            sim.frame(kOneCpu, kOneGpu, kOneSynthesis);
+        }
+        sim.controller.add_late(sim.now, 1);
+        const Nanoseconds missed = sim.now;
+        const Nanoseconds entered =
+            sim.until(CadenceEvent::one_entered, 1000, kOneCpu, kOneGpu, kOneSynthesis);
+        require(entered >= missed + 5 * kSecond, "a miss restarts the clean stretch");
+    }
+    {
+        // Only ever from 2: held at 3 (a run it cannot leave), light enough
+        // for 1X, it does not go there.
+        CadenceConfig config{};
+        config.min_run_three = 100'000;
+        CadenceSim sim(config);
+        for (int index = 0; index < 10; ++index) {
+            sim.frame(25 * kMillisecond, 20 * kMillisecond);
+        }
+        require(sim.controller.level() == 3, "at 3");
+        for (int index = 0; index < 600; ++index) {
+            sim.frame(kOneCpu, kOneGpu, kOneSynthesis);
+        }
+        require(sim.controller.level() == 3 && sim.events.empty(), "not from 3");
+    }
+    {
+        // Off by the configuration.
+        CadenceConfig config{};
+        config.one_enabled = false;
+        CadenceSim sim(config);
+        for (int index = 0; index < 600; ++index) {
+            sim.frame(kOneCpu, kOneGpu, kOneSynthesis);
+        }
+        require(sim.events.empty() && sim.controller.level() == 2, "1X can be off");
+    }
+}
+
+// Runs light frames until 1X is entered; when.
+Nanoseconds enter_one(CadenceSim& sim) {
+    const Nanoseconds entered =
+        sim.until(CadenceEvent::one_entered, 20'000, kOneCpu, kOneGpu, kOneSynthesis);
+    require(entered >= 0, "1X entered");
+    return entered;
+}
+
+void cadence_one_exit_tests() {
+    {
+        // Slow at 1X: nothing is judged in the first second, then the p90
+        // over half a second (once there are samples after the grace) over
+        // 95% of the period leaves.
+        CadenceSim sim;
+        const Nanoseconds entered = enter_one(sim);
+        const Nanoseconds left =
+            sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy);
+        require(left >= entered + kSecond &&
+                left <= entered + kSecond + 10 * kPeriod,
+            "slow: left after the grace");
+        require(sim.controller.level() == 2 && sim.events.back().previous == 1,
+            "back to 2");
+        require(sim.events.back().predicted == kOneHeavy, "with the p90 that left");
+    }
+    {
+        // Missed slots: in the grace they do not count; two episodes within
+        // a second after it leave.
+        CadenceSim sim;
+        const Nanoseconds entered = enter_one(sim);
+        sim.controller.add_late(entered + 200 * kMillisecond, 1);
+        sim.controller.add_late(entered + 600 * kMillisecond, 1);
+        while (sim.now < entered + 1500 * kMillisecond) {
+            sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+        }
+        require(sim.controller.level() == 1, "misses in the grace ignored");
+        sim.controller.add_late(sim.now, 1);
+        require(sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0).level == 1, "one episode stays");
+        sim.controller.add_late(sim.now + 300 * kMillisecond, 1);
+        while (sim.now < entered + 1900 * kMillisecond) {
+            sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+        }
+        require(sim.controller.level() == 2 &&
+                sim.events.back().event == CadenceEvent::one_left_late &&
+                sim.events.back().late_episodes == 2,
