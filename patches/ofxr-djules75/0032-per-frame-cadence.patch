+        const Nanoseconds again = enter_one(sim);
+        require(again >= scene + CadenceConfig{}.one_spacing &&
+                again <= scene + CadenceConfig{}.one_spacing + 3 * kPeriod,
+            "back after the spacing");
+    }
+    {
+        // A scene change at 2 forgets the clean stretch too.
+        CadenceSim sim;
+        for (int index = 0; index < 180; ++index) {
+            sim.frame(kOneCpu, kOneGpu, kOneSynthesis);
+        }
+        const CadenceStep step = sim.controller.scene_changed(sim.now);
+        require(step.event == CadenceEvent::none && step.level == 2, "scene at 2");
+        const Nanoseconds scene = sim.now;
+        require(enter_one(sim) >= scene + 5 * kSecond, "five seconds of the new scene");
+    }
+    {
+        // Stopped (cadence or generation off): left, back to 2, no backoff.
+        CadenceSim sim;
+        enter_one(sim);
+        const CadenceStep step = sim.controller.stop(sim.now);
+        require(step.event == CadenceEvent::one_left_stopped && step.level == 2 &&
+                sim.controller.backoff() == 0,
+            "stopped");
+    }
+}
+
+void cadence_backoff_tests() {
+    {
+        // Failed attempts (left within 30 s): 30, 60, 120, 240, 240 s.
+        CadenceSim sim;
+        const std::array<Nanoseconds, 5> expected{
+            30 * kSecond, 60 * kSecond, 120 * kSecond, 240 * kSecond, 240 * kSecond};
+        enter_one(sim);
+        for (const Nanoseconds backoff : expected) {
+            const Nanoseconds left =
+                sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy);
+            require(left >= 0, "the attempt fails");
+            require(sim.controller.backoff() == backoff, "backoff " +
+                std::to_string(backoff / kSecond) + " s: " +
+                std::to_string(sim.controller.backoff() / kSecond));
+            const Nanoseconds again = enter_one(sim);
+            require(again >= left + backoff && again <= left + backoff + 3 * kPeriod,
+                "the next attempt waits the backoff: " +
+                    std::to_string((again - left) / kMillisecond) + " ms");
+        }
+    }
+    {
+        // Held for a minute: the backoff is cleared, and the next attempt
+        // waits the spacing alone (fifteen seconds).
+        CadenceSim sim;
+        enter_one(sim);
+        require(sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy) >= 0, "fails");
+        require(sim.controller.backoff() == 30 * kSecond, "backed off");
+        const Nanoseconds entered = enter_one(sim);
+        while (sim.now < entered + 61 * kSecond) {
+            sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+        }
+        require(sim.controller.level() == 1 && sim.controller.backoff() == 0,
+            "a minute at 1X clears the backoff");
+        const Nanoseconds left =
+            sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy);
+        require(left >= 0 && sim.controller.backoff() == 0, "not a failure");
+        const Nanoseconds again = enter_one(sim);
+        require(again >= left + 15 * kSecond && again <= left + 15 * kSecond + 3 * kPeriod,
+            "the spacing alone");
+    }
+    {
+        // Held between 30 s and a minute: not a failure, the backoff stays
+        // as it was, and the spacing applies.
+        CadenceSim sim;
+        enter_one(sim);
+        require(sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy) >= 0, "fails");
+        const Nanoseconds entered = enter_one(sim);
+        while (sim.now < entered + 40 * kSecond) {
+            sim.frame(kOneCpu, kOneGpu - kOneSynthesis, 0);
+        }
+        const Nanoseconds left =
+            sim.until(CadenceEvent::one_left_slow, 400, kOneHeavy, kOneHeavy);
+        require(left >= 0 && sim.controller.backoff() == 30 * kSecond, "unchanged");
+        require(enter_one(sim) <= left + 15 * kSecond + 3 * kPeriod, "spacing only");
+    }
+}
+
+void cadence_frame_tests() {
+    // A frame's told time: the one before's plus its cadence and the slots
+    // gained since; the presenter's estimate with nothing before, or once the
+    // two are more than two periods apart.
+    constexpr Nanoseconds kAt = 1000 * kPeriod;
+    require(cadence_told_time(0, 2, 0, kAt, kPeriod) == kAt, "nothing before: the estimate");
+    require(cadence_told_time(kAt, 2, 0, kAt + kPeriod, kPeriod) == kAt + 2 * kPeriod,
+        "two periods on, the estimate a period away");
+    require(cadence_told_time(kAt, 3, 0, kAt + kPeriod, kPeriod) == kAt + 3 * kPeriod,
+        "three, the estimate two away");
+    require(cadence_told_time(kAt, 1, 0, kAt + kPeriod, kPeriod) == kAt + kPeriod, "1X");
+    require(cadence_told_time(kAt, 2, 1, kAt + 2 * kPeriod, kPeriod) == kAt + 3 * kPeriod,
+        "a lost slot carried");
+    require(cadence_told_time(kAt, 2, -1, kAt + 2 * kPeriod, kPeriod) == kAt + kPeriod,
+        "a frame short of its cadence given back");
+    require(cadence_told_time(kAt, 2, 0, kAt + 5 * kPeriod, kPeriod) == kAt + 5 * kPeriod,
+        "drifted three periods: re-anchored");
+    require(cadence_told_time(kAt, 2, -3, kAt + 2 * kPeriod, kPeriod) == kAt + 2 * kPeriod,
+        "never at or before the one before");
+    // The admission bound: the frame before last gone, and the synthetic
+    // slots this one takes.
+    require(cadence_admission_bound(2, 2, true) == 2, "2 after 2: as 2X deep");
+    require(cadence_admission_bound(3, 2, true) == 1, "3 after 2: both slots");
+    require(cadence_admission_bound(3, 3, true) == 1, "3 after 3: as 3X");
+    require(cadence_admission_bound(2, 3, true) == 2, "2 after 3: its first synthetic gone");
+    require(cadence_admission_bound(1, 1, true) == 1, "1X after 1X");
+    require(cadence_admission_bound(1, 3, true) == 3, "1X after 3");
+    require(cadence_admission_bound(3, 1, true) == 1, "3 after 1X");
+    require(cadence_admission_bound(2, 0, true) == 1, "after a pass-through");
+    require(cadence_admission_bound(2, 2, false) == 1 &&
+                cadence_admission_bound(3, 3, false) == 1,
+        "the shallow pipeline keeps one");
+
+    // A first-in, first-out presenter over a mix of cadences, a prime (a
+    // frame that queued one, short of its cadence of two) and lost slots (a
+    // slot the runtime skipped, or one shown again): every real frame lands
+    // at the display time it was told - but a frame short of its own
+    // cadence, told before it was short, which lands that much earlier.
+    struct Frame {
+        std::uint32_t frames;
+        std::uint32_t queued;
+        bool slot_lost_after;
+    };
+    const std::vector<Frame> script{
+        {2, 2, false}, {2, 2, false}, {3, 3, false}, {3, 3, true},
+        {2, 2, false}, {1, 1, false}, {1, 1, true}, {1, 1, false},
+        {2, 2, false}, {2, 1, false}, {2, 2, false}, {3, 3, false},
+        {2, 2, true}, {3, 3, true}, {2, 2, false}, {2, 2, false}};
+    Nanoseconds slot = kAt;
+    Nanoseconds told = 0;
+    std::int64_t slip = 0;
+    std::optional<Nanoseconds> offset; // told less landed, as the first frame
+    std::size_t index = 0;
+    for (const Frame& frame : script) {
+        // The presenter's estimate, a period off: inside the drift bound.
+        const Nanoseconds estimate =
+            slot + static_cast<Nanoseconds>(frame.frames) * kPeriod;
+        told = cadence_told_time(told, frame.frames, slip, estimate, kPeriod);
+        slip = 0;
+        const Nanoseconds landed =
+            slot + static_cast<Nanoseconds>(frame.queued - 1) * kPeriod;
+        if (!offset) {
+            offset = told - landed;
+        }
+        require(told - landed - *offset ==
+                static_cast<Nanoseconds>(frame.frames - frame.queued) * kPeriod,
+            "frame " + std::to_string(index) + " lands where it was told");
+        slot += static_cast<Nanoseconds>(frame.queued) * kPeriod;
+        slip -= static_cast<std::int64_t>(frame.frames) -
+            static_cast<std::int64_t>(frame.queued);
+        if (frame.slot_lost_after) {
+            slot += kPeriod;
+            ++slip;
+        }
+        ++index;
+    }
+}
