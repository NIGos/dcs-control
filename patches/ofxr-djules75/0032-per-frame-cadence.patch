+// ---------------------------------------------------------------------------
+// DCS Control (0032): per-frame cadence (`[ofxr] adaptive_cadence=1`, under
+// adaptive_frame_gen=1).
+//
+// Adaptive 2X/3X picks one multiplier for seconds at a time. An application
+// that can render 40 frames a second at 90 Hz is then held to 30 in 3X, or
+// in 2X misses a slot every few frames and the headset sees the previous
+// frame again. Under adaptive cadence the session keeps 2X's shape (its
+// queue, its depth, its release steering) and every application frame has a
+// cadence N of its own:
+//
+//   - N is this controller's decision as it stands when the application
+//     waits for the frame (xrWaitFrame): 2 when its next frame is predicted
+//     to fit in two periods, 3 when not, 1 at 1X. The application is handed
+//     N periods; the frame carries N, makes N - 1 synthetics at k / N and is
+//     held N presenter frames once it is queued. What it queues is what the
+//     presenter takes before the next release, so the queue keeps its depth
+//     whatever the mix.
+//   - The display time it is told advances by N periods from the frame
+//     before's (cadence_told_time), plus every slot the presenter lost in
+//     between (one the runtime skipped, one shown again) and less what a
+//     frame queued short of its own N (a prime, a pass-through). The queue
+//     is first in, first out, so the real frame lands exactly there, through
+//     every change of N.
+//   - 1X: an application with room to spare at the full rate is shown
+//     unchanged, one frame per period, no synthesis at all.
+//
+// A frame that turns out late anyway is shown where the slot it missed puts
+// it: its synthetics are placed by the measured interval (DCS Control 0029),
+// and the frames told after it carry the lost slot.
+//
+// The prediction is the p90 of max(CPU, GPU) per application frame (the
+// evidence AdaptiveFrameGenController judges) over the last `window`:
+//   2 -> 3   over up_fraction of two periods, or up_late_episodes missed-slot
+//            episodes at 2 within late_window
+//   3 -> 2   at most down_fraction of two periods, and a run of decisions at
+//            3 behind it: min_run_three, doubled (up to max_run_three) each
+//            time missed slots bring 3 back within flap_window of leaving
+//            it, back to min_run_three once 2 has held that long
+// so it does not flap on a margin (the 10-point band) or on an application
+// that cannot hold 2 for long (the run). Slots missed at 3 decide nothing:
+// there is nothing slower to go to.
+//
+// 1X, only ever from 2:
+//   enter   the p90s of CPU and of GPU at 1X (the GPU less the layer's
+//           synthesis, which 1X frees; its copies stay) both at most
+//           one_enter_fraction of the period, continuously for
+//           one_enter_hold with no missed slot, and one_spacing since the
+//           last change into or out of 1X (or the backoff, if longer)
+//   leave   one_exit_episodes missed-slot episodes within late_window, or the
+//           p90 over one_exit_window above one_exit_fraction of the period,
+//           or a scene change (at once); nothing is judged, and no sample or
+//           miss counts, in the first one_grace after entering. Back at 2,
+//           the misses 1X had are forgotten (they would send it on to 3)
+//   backoff an attempt that ends within one_failed_within (not by a scene
+//           change or a stop) failed: the next waits one_backoff_first, then
+//           twice that each time up to one_backoff_max; 1X held for
+//           one_reset_after clears it
+//
+// Cost: one decision per application frame, two small sorts of at most
+// kSamples values - about a microsecond on the xrEndFrame thread. No GPU
+// work. All times are nanoseconds on the caller's monotonic timeline.
+struct CadenceConfig {
+    Nanoseconds window{500 * kMillisecond};
+    std::uint32_t min_samples{6};
+    double up_fraction{0.95};
+    double down_fraction{0.85};
+    std::uint32_t min_run_three{10};
+    std::uint32_t max_run_three{640};
+    Nanoseconds flap_window{5 * kSecond};
+    Nanoseconds late_episode_gap{100 * kMillisecond};
+    Nanoseconds late_window{1 * kSecond};
+    std::uint32_t up_late_episodes{2};
+    Nanoseconds stall{250 * kMillisecond};
+    bool one_enabled{true};
+    double one_enter_fraction{0.80};
+    Nanoseconds one_enter_hold{5 * kSecond};
+    Nanoseconds one_spacing{15 * kSecond};
+    double one_exit_fraction{0.95};
+    Nanoseconds one_exit_window{500 * kMillisecond};
+    std::uint32_t one_exit_episodes{2};
+    Nanoseconds one_grace{1 * kSecond};
+    Nanoseconds one_failed_within{30 * kSecond};
+    Nanoseconds one_backoff_first{30 * kSecond};
+    Nanoseconds one_backoff_max{240 * kSecond};
+    Nanoseconds one_reset_after{60 * kSecond};
+};
+
+enum class CadenceEvent : std::uint32_t {
+    none = 0,
+    one_entered = 1,
+    one_left_late = 2,
+    one_left_slow = 3,
+    one_left_scene = 4,
+    one_left_stopped = 5,
+};
+
+struct CadenceStep {
+    // The cadence in force after this step (1, 2 or 3) and before it.
+    std::uint32_t level{2};
+    std::uint32_t previous{2};
+    CadenceEvent event{CadenceEvent::none};
+    // Over `window`: p90 of max(CPU, GPU), of CPU, and of GPU at 1X (the GPU
+    // less synthesis); -1 without samples.
+    Nanoseconds predicted{-1};
+    Nanoseconds predicted_cpu{-1};
+    Nanoseconds predicted_gpu_one{-1};
+    // Missed-slot episodes over late_window, since the level was entered.
+    std::uint32_t late_episodes{};
+    // The run of decisions at 3 a return to 2 needs now.
+    std::uint32_t run_required{};
+    // The 1X backoff in force (0: none), and when 1X may next be entered.
+    Nanoseconds backoff{};
+    Nanoseconds one_allowed_at{};
+};
+
+class CadenceController {
+public:
+    static constexpr std::size_t kSamples = 128;
+    static constexpr std::size_t kLateEvents = 64;
+
+    explicit CadenceController(CadenceConfig config = {}) noexcept;
+
+    // Starts over at 2, forgetting everything, the 1X backoff included.
+    void start(Nanoseconds now) noexcept;
+    // One application frame: its CPU time, its GPU time (negative: not
+    // measured) and, of that, the layer's synthesis (negative: none known).
+    // A negative CPU time, or either time over the stall bound, is ignored.
+    void add_frame(
+        Nanoseconds at,
+        Nanoseconds cpu,
+        Nanoseconds gpu,
+        Nanoseconds synthesis) noexcept;
+    // Missed slots at `at`, counted as episodes (late_episode_gap).
+    void add_late(Nanoseconds at, std::uint32_t count = 1) noexcept;
+    // Once per application frame. A non-positive period decides nothing.
+    CadenceStep decide(Nanoseconds now, Nanoseconds period) noexcept;
+    // A scene change: 1X is left at once, and every sample and missed slot
+    // is forgotten (the backoff is kept).
+    CadenceStep scene_changed(Nanoseconds now) noexcept;
+    // Cadence or generation stopped: 1X, if in force, is left; back to 2.
+    CadenceStep stop(Nanoseconds now) noexcept;
+
+    [[nodiscard]] std::uint32_t level() const noexcept { return level_; }
+    [[nodiscard]] Nanoseconds backoff() const noexcept { return backoff_; }
+    [[nodiscard]] Nanoseconds one_allowed_at() const noexcept {
+        return one_allowed_at_;
+    }
+
+private:
+    struct Sample {
+        Nanoseconds at{};
+        Nanoseconds cpu{};
+        Nanoseconds gpu{-1};
+        Nanoseconds synthesis{-1};
+    };
+    struct WindowStats {
+        Nanoseconds judged{-1};
+        Nanoseconds cpu{-1};
+        Nanoseconds gpu_one{-1};
+        std::uint32_t judged_samples{};
+        std::uint32_t gpu_samples{};
+    };
+    [[nodiscard]] WindowStats window_stats(
+        Nanoseconds from, Nanoseconds now) const noexcept;
+    [[nodiscard]] std::uint32_t late_episodes_between(
+        Nanoseconds from, Nanoseconds now) const noexcept;
+    void leave_one(Nanoseconds now, CadenceEvent event, CadenceStep& step) noexcept;
+    void fill(CadenceStep& step) const noexcept;
+
+    CadenceConfig config_;
+    std::uint32_t level_{2};
+    std::uint32_t run_three_{};
+    // When the level in force was entered; the last 3 -> 2 (-1: none); the
+    // run of decisions at 3 a return to 2 needs (flap protection).
+    Nanoseconds level_since_{};
+    Nanoseconds last_down_at_{-1};
+    std::uint32_t run_required_{};
+    std::array<Sample, kSamples> samples_{};
+    std::size_t sample_count_{};
+    std::size_t sample_next_{};
+    std::array<Nanoseconds, kLateEvents> late_at_{};
+    std::size_t late_count_{};
+    std::size_t late_next_{};
+    // Since when the 1X entry test has held; -1 when it does not.
+    Nanoseconds one_fit_since_{-1};
+    Nanoseconds one_entered_at_{-1};
+    Nanoseconds one_allowed_at_{};
+    Nanoseconds backoff_{};
+};
+
+// DCS Control (0032): the display time a frame of cadence `frames` is told,
+// from the one the frame before was told (`previous`, 0 for none), the slots
+// the presenter lost or gained since (`slip`, in periods: a slot the runtime
+// skipped or one shown again is +1, a frame that queued one short of its
+// cadence -1), and the presenter's own estimate (`estimate`: the prediction
+// at the application's release plus the frame's periods). The estimate where
+// there is no previous one, or where the two have drifted more than two
+// periods apart; the advanced time otherwise.
+[[nodiscard]] constexpr Nanoseconds cadence_told_time(
+    Nanoseconds previous,
+    std::uint32_t frames,
+    std::int64_t slip,
+    Nanoseconds estimate,
+    Nanoseconds period) noexcept {
+    if (previous <= 0 || period <= 0) {
+        return estimate;
+    }
+    const Nanoseconds advanced = previous +
+        (static_cast<Nanoseconds>(frames) + slip) * period;
+    const Nanoseconds apart =
+        advanced > estimate ? advanced - estimate : estimate - advanced;
+    return apart > 2 * period || advanced <= previous ? estimate : advanced;
+}
+
+// DCS Control (0032): how many of the presenter's submissions may still be
+// outstanding when a frame of cadence `frames` is prepared after one of
+// `previous` submissions, so that no private image it is about to write is
+// still named by one. The current ring alternates two slots, so the frame
+// before last must have gone (outstanding <= previous); the synthetic ring
+// has two slots - a frame of 3 takes both, so the previous frame's
+// synthetics must have gone as well (<= 1), and a frame of 2 after one of 3
+// takes the slot that one's first synthetic took (<= previous - 1). The
+// shallow pipeline keeps its bound of one.
+[[nodiscard]] constexpr std::size_t cadence_admission_bound(
+    std::uint32_t frames,
+    std::uint32_t previous,
+    bool deep_pipeline) noexcept {
+    if (!deep_pipeline || previous == 0) {
+        return 1;
+    }
+    std::size_t bound = previous;
+    if (frames >= 3 && previous >= 2) {
+        bound = 1;
+    } else if (frames == 2 && previous >= 3) {
+        bound = previous - 1;
+    }
+    return bound < 1 ? 1 : bound;
+}
+
 } // namespace xrfg::latency
