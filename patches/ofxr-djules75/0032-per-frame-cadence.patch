+// ---------------------------------------------------------------------------
+// DCS Control (0032): per-frame cadence.
+
+namespace {
+
+// Nearest-rank p90 of the first n values of a cadence window (sorted in
+// place); -1 for none.
+[[nodiscard]] Nanoseconds cadence_p90(
+    std::array<Nanoseconds, CadenceController::kSamples>& values,
+    std::size_t n) noexcept {
+    if (n == 0) {
+        return -1;
+    }
+    std::sort(values.begin(), values.begin() + static_cast<std::ptrdiff_t>(n));
+    const std::size_t rank = (n * 9 + 9) / 10; // ceil(0.9 n)
+    return values[std::max<std::size_t>(rank, 1) - 1];
+}
+
+[[nodiscard]] Nanoseconds fraction_of(double fraction, Nanoseconds value) noexcept {
+    return static_cast<Nanoseconds>(fraction * static_cast<double>(value));
+}
+
+} // namespace
+
+CadenceController::CadenceController(CadenceConfig config) noexcept
+    : config_(config) {
+    if (config_.min_samples == 0) {
+        config_.min_samples = 1;
+    }
+    config_.max_run_three = std::max(config_.max_run_three, config_.min_run_three);
+    run_required_ = config_.min_run_three;
+}
+
+void CadenceController::start(Nanoseconds now) noexcept {
+    level_ = 2;
+    run_three_ = 0;
+    level_since_ = now;
+    last_down_at_ = -1;
+    run_required_ = config_.min_run_three;
+    sample_count_ = 0;
+    sample_next_ = 0;
+    late_count_ = 0;
+    late_next_ = 0;
+    one_fit_since_ = -1;
+    one_entered_at_ = -1;
+    // Nothing into or out of 1X yet: the spacing does not apply.
+    one_allowed_at_ = now;
+    backoff_ = 0;
+}
+
+void CadenceController::add_frame(
+    Nanoseconds at,
+    Nanoseconds cpu,
+    Nanoseconds gpu,
+    Nanoseconds synthesis) noexcept {
+    if (cpu < 0 || cpu > config_.stall || gpu > config_.stall) {
+        return;
+    }
+    samples_[sample_next_] = Sample{at, cpu, gpu < 0 ? -1 : gpu,
+                                    synthesis < 0 ? -1 : synthesis};
+    sample_next_ = (sample_next_ + 1) % kSamples;
+    sample_count_ = std::min(sample_count_ + 1, kSamples);
+}
+
+void CadenceController::add_late(Nanoseconds at, std::uint32_t count) noexcept {
+    if (count == 0) {
+        return;
+    }
+    // A miss ends the 1X entry test's clean stretch, episode or not.
+    one_fit_since_ = -1;
+    if (late_count_ != 0) {
+        const Nanoseconds episode =
+            late_at_[(late_next_ + kLateEvents - 1) % kLateEvents];
+        if (at >= episode && at - episode < config_.late_episode_gap) {
+            return;
+        }
+    }
+    late_at_[late_next_] = at;
+    late_next_ = (late_next_ + 1) % kLateEvents;
+    late_count_ = std::min(late_count_ + 1, kLateEvents);
+}
+
+CadenceController::WindowStats CadenceController::window_stats(
+    Nanoseconds from, Nanoseconds now) const noexcept {
+    WindowStats stats{};
+    std::array<Nanoseconds, kSamples> judged{};
+    std::array<Nanoseconds, kSamples> cpu{};
+    std::array<Nanoseconds, kSamples> gpu_one{};
+    std::size_t judged_n = 0;
+    std::size_t cpu_n = 0;
+    std::size_t gpu_n = 0;
+    for (std::size_t index = 0; index < sample_count_; ++index) {
+        const Sample& sample = samples_[index];
+        if (sample.at <= from || sample.at > now) {
+            continue;
+        }
+        cpu[cpu_n++] = sample.cpu;
+        judged[judged_n++] = std::max(sample.cpu, sample.gpu);
+        if (sample.gpu >= 0) {
+            gpu_one[gpu_n++] = std::max<Nanoseconds>(
+                0, sample.gpu - std::max<Nanoseconds>(0, sample.synthesis));
+        }
+    }
+    stats.judged_samples = static_cast<std::uint32_t>(judged_n);
+    stats.gpu_samples = static_cast<std::uint32_t>(gpu_n);
+    stats.judged = cadence_p90(judged, judged_n);
+    stats.cpu = cadence_p90(cpu, cpu_n);
+    stats.gpu_one = cadence_p90(gpu_one, gpu_n);
+    return stats;
+}
+
+std::uint32_t CadenceController::late_episodes_between(
+    Nanoseconds from, Nanoseconds now) const noexcept {
+    std::uint32_t episodes = 0;
+    for (std::size_t index = 0; index < late_count_; ++index) {
+        if (late_at_[index] > from && late_at_[index] <= now) {
+            ++episodes;
+        }
+    }
+    return episodes;
+}
+
+void CadenceController::fill(CadenceStep& step) const noexcept {
+    step.level = level_;
+    step.run_required = run_required_;
+    step.backoff = backoff_;
+    step.one_allowed_at = one_allowed_at_;
+}
+
+void CadenceController::leave_one(
+    Nanoseconds now, CadenceEvent event, CadenceStep& step) noexcept {
+    const Nanoseconds held = one_entered_at_ >= 0 ? now - one_entered_at_ : 0;
+    const bool failed = held < config_.one_failed_within &&
+        (event == CadenceEvent::one_left_late ||
+         event == CadenceEvent::one_left_slow);
+    if (failed) {
+        backoff_ = backoff_ <= 0
+            ? config_.one_backoff_first
+            : std::min(backoff_ * 2, config_.one_backoff_max);
+    } else if (held >= config_.one_reset_after) {
+        backoff_ = 0;
+    }
+    one_allowed_at_ = now + std::max(config_.one_spacing, failed ? backoff_ : 0);
+    // Slots missed at 1X say nothing about 2: they would send it on to 3.
+    late_count_ = 0;
+    late_next_ = 0;
+    level_ = 2;
+    level_since_ = now;
+    run_three_ = 0;
+    one_fit_since_ = -1;
+    one_entered_at_ = -1;
+    step.event = event;
+}
+
+CadenceStep CadenceController::decide(Nanoseconds now, Nanoseconds period) noexcept {
+    CadenceStep step{};
+    step.previous = level_;
+    if (period <= 0) {
+        fill(step);
+        return step;
+    }
+    const Nanoseconds two_periods = period * 2;
+    if (level_ == 1) {
+        // Nothing from the first one_grace counts: the switch's own
+        // re-phasing.
+        const Nanoseconds judged_from = std::max(
+            now - config_.one_exit_window, one_entered_at_ + config_.one_grace);
+        const WindowStats stats = window_stats(judged_from, now);
+        step.predicted = stats.judged;
+        step.predicted_cpu = stats.cpu;
+        step.predicted_gpu_one = stats.gpu_one;
+        step.late_episodes = late_episodes_between(
+            std::max(now - config_.late_window,
+                     one_entered_at_ + config_.one_grace),
+            now);
+        if (now - one_entered_at_ >= config_.one_reset_after) {
+            backoff_ = 0;
+        }
+        if (now >= one_entered_at_ + config_.one_grace) {
+            if (step.late_episodes >= config_.one_exit_episodes) {
+                leave_one(now, CadenceEvent::one_left_late, step);
+            } else if (stats.judged_samples >= config_.min_samples &&
+                       stats.judged > fraction_of(config_.one_exit_fraction, period)) {
+                leave_one(now, CadenceEvent::one_left_slow, step);
+            }
+        }
+        fill(step);
+        return step;
+    }
+    const WindowStats stats = window_stats(now - config_.window, now);
+    step.predicted = stats.judged;
+    step.predicted_cpu = stats.cpu;
+    step.predicted_gpu_one = stats.gpu_one;
+    // Misses since the level was entered: at 2 they are 2's; at 3 they
+    // decide nothing.
+    step.late_episodes = late_episodes_between(
+        std::max(now - config_.late_window, level_since_), now);
+    const bool enough = stats.judged_samples >= config_.min_samples;
+    if (level_ == 2) {
+        const bool missed = step.late_episodes >= config_.up_late_episodes;
+        if (missed ||
+            (enough &&
+             stats.judged > fraction_of(config_.up_fraction, two_periods))) {
+            // Missing slots again within flap_window of leaving 3: 2 did not
+            // hold though the work said it would, so 3 is held twice as long
+            // this time. Work that grew is a change, not a flap.
+            run_required_ = missed && last_down_at_ >= 0 &&
+                    now - last_down_at_ < config_.flap_window
+                ? std::min(run_required_ * 2, config_.max_run_three)
+                : config_.min_run_three;
+            level_ = 3;
+            level_since_ = now;
+            run_three_ = 0;
+            one_fit_since_ = -1;
+            fill(step);
+            return step;
+        }
+        // 1X: from 2 only, on a clean stretch of one_enter_hold.
+        const Nanoseconds one_limit =
+            fraction_of(config_.one_enter_fraction, period);
+        const bool fits = config_.one_enabled && enough &&
+            stats.gpu_samples >= config_.min_samples &&
+            stats.cpu >= 0 && stats.cpu <= one_limit &&
+            stats.gpu_one >= 0 && stats.gpu_one <= one_limit &&
+            late_episodes_between(now - config_.late_window, now) == 0;
+        if (!fits) {
+            one_fit_since_ = -1;
+        } else if (one_fit_since_ < 0) {
+            one_fit_since_ = now;
+        }
+        if (fits && now - one_fit_since_ >= config_.one_enter_hold &&
+            now >= one_allowed_at_) {
+            level_ = 1;
+            level_since_ = now;
+            one_entered_at_ = now;
+            one_fit_since_ = -1;
+            // Into 1X counts as a change involving it.
+            one_allowed_at_ = now + config_.one_spacing;
+            step.event = CadenceEvent::one_entered;
+        }
+        fill(step);
+        return step;
+    }
+    // 3.
+    ++run_three_;
+    one_fit_since_ = -1;
+    if (run_three_ >= run_required_ && enough &&
+        stats.judged <= fraction_of(config_.down_fraction, two_periods)) {
+        level_ = 2;
+        level_since_ = now;
+        last_down_at_ = now;
+        run_three_ = 0;
+    }
+    fill(step);
+    return step;
+}
+
+CadenceStep CadenceController::scene_changed(Nanoseconds now) noexcept {
+    CadenceStep step{};
+    step.previous = level_;
+    if (level_ == 1) {
+        leave_one(now, CadenceEvent::one_left_scene, step);
+    }
+    level_ = 2;
+    level_since_ = now;
+    run_three_ = 0;
+    // A new scene: no flap record either.
+    last_down_at_ = -1;
+    run_required_ = config_.min_run_three;
+    sample_count_ = 0;
+    sample_next_ = 0;
+    late_count_ = 0;
+    late_next_ = 0;
+    one_fit_since_ = -1;
+    fill(step);
+    return step;
+}
+
+CadenceStep CadenceController::stop(Nanoseconds now) noexcept {
+    CadenceStep step{};
+    step.previous = level_;
+    if (level_ == 1) {
+        leave_one(now, CadenceEvent::one_left_stopped, step);
+    }
+    level_ = 2;
+    level_since_ = now;
+    run_three_ = 0;
+    one_fit_since_ = -1;
+    fill(step);
+    return step;
+}
+
 } // namespace xrfg::latency
