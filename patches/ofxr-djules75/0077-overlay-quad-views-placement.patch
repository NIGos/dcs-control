diff --git a/src/layer/openxr_fps_overlay.cpp b/src/layer/openxr_fps_overlay.cpp
--- a/src/layer/openxr_fps_overlay.cpp
+++ b/src/layer/openxr_fps_overlay.cpp
@@ -562,11 +562,20 @@ struct OpenXrFpsOverlay::Impl {
             if (!layer || layer->type != XR_TYPE_COMPOSITION_LAYER_PROJECTION) continue;
             const auto* projection = reinterpret_cast<const XrCompositionLayerProjection*>(layer);
             if (!projection->views || projection->viewCount > 16) continue;
+            // DCS Control (0077): a quad-views layer that reaches this layer
+            // whole (the runtime's own quad views: no Quad Views layer above
+            // to compose it) has the eyes' full views first and the two
+            // focus views after them. Those are narrow and follow the gaze:
+            // bounding the placement by them put the counter and the panel
+            // inside the focus area, smaller and always just above where the
+            // pilot looked (GitHub #22). Only the eyes' views bound it.
+            const std::uint32_t placement_views = projection->viewCount == 4 ? 2 : projection->viewCount;
             for (std::uint32_t v = 0; v < projection->viewCount; ++v) {
                 const auto& view = projection->views[v];
                 if (view.subImage.imageRect.extent.width <= 0) continue;
                 const auto w = static_cast<std::uint32_t>(view.subImage.imageRect.extent.width);
                 eye_width = eye_width ? std::min(eye_width, w) : w;
+                if (v >= placement_views) continue;
                 // The quad uses physical visible bounds, not the source image's
                 // vertical storage direction. Never reorder the submitted FOV.
                 const float down_angle = std::min(view.fov.angleDown, view.fov.angleUp);
