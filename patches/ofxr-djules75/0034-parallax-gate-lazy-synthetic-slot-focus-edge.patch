+// DCS Control (0034): the second synthetic slot of a ring made with one,
+// created on a thread of its own so that no application thread ever waits on
+// a swapchain creation (a full-size image set takes the runtime tens of
+// milliseconds). The thread fills `created` and sets `done`; the
+// application's xrEndFrame thread takes it into the ring
+// (adopt_second_synthetic) under the swapchain's call_mutex, between two
+// frames, and only then may a frame of three use it.
+struct LazySyntheticSlot {
+    std::mutex mutex;
+    std::thread worker;
+    bool started{};
+    bool done{};
+    bool succeeded{};
+    bool adopted{};
+    bool failure_logged{};
+    XrResult refusal{XR_SUCCESS};
+    CreatedPrivateSwapchain created;
+    std::chrono::steady_clock::time_point started_at{};
+    std::chrono::steady_clock::time_point finished_at{};
+
+    LazySyntheticSlot() = default;
+    LazySyntheticSlot(const LazySyntheticSlot&) = delete;
+    LazySyntheticSlot& operator=(const LazySyntheticSlot&) = delete;
+    // Normally joined by retire_lazy_synthetic_slot. Otherwise (the last
+    // reference may be the thread's own) never joined from here: a slot the
+    // ring never took is then left to the runtime's session teardown.
+    ~LazySyntheticSlot() {
+        if (worker.joinable()) {
+            worker.detach();
+        }
+    }
+};
+
+void retire_lazy_synthetic_slot(
+    const std::shared_ptr<Dispatch>& dispatch, LazySyntheticSlot& slot) noexcept {
+    try {
+        std::thread worker;
+        {
+            std::scoped_lock lock(slot.mutex);
+            worker = std::move(slot.worker);
+        }
+        if (worker.joinable()) {
+            if (worker.get_id() == std::this_thread::get_id()) {
+                worker.detach();
+                return;
+            }
+            worker.join();
+        }
+        std::scoped_lock lock(slot.mutex);
+        if (slot.done && slot.succeeded && !slot.adopted &&
+            slot.created.state.handle != XR_NULL_HANDLE && dispatch &&
+            dispatch->destroy_swapchain != nullptr) {
+            static_cast<void>(dispatch->destroy_swapchain(slot.created.state.handle));
+        }
+        slot.created.state.handle = XR_NULL_HANDLE;
+        slot.adopted = true;
+    } catch (...) {
+    }
+}
