+// DCS Control (0034): whether a frame of three may come - every generation
+// of the session has its second synthetic slot, or the session makes none
+// lazily. Otherwise each missing one is started (`reason`: see
+// BridgeFlightOperation::synthetic_slot) and each made one taken in; false
+// until all are in, or for good once one failed. The first call latches
+// wanted: a swapchain that arms afterwards makes both slots at once. The
+// application's xrEndFrame thread, no swapchain lock held.
+[[nodiscard]] bool second_synthetic_ready(
+    const std::shared_ptr<SessionState>& state, std::uint64_t reason) noexcept {
+    if (!state->lazy_second_synthetic || state->second_synthetic_ready_all.load()) {
+        return true;
+    }
+    if (state->second_synthetic_failed.load()) {
+        return false;
+    }
+    state->second_synthetic_wanted = true;
+    bool all = true;
+    try {
+        for (const auto& swapchain : find_swapchains(state)) {
+            std::scoped_lock call_lock(swapchain->call_mutex);
+            std::shared_ptr<FrameGenerationSwapchainState> generation;
+            {
+                std::scoped_lock lock(swapchain->mutex);
+                generation = swapchain->frame_generation;
+            }
+            if (!generation || generation->synthetic_slot_count >= kSyntheticSlotCountDeep) {
+                continue;
