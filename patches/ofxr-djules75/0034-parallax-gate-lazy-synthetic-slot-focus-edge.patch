+// DCS Control (0034): takes a made second synthetic slot into the ring - the
+// synthesizer's destinations, then the ring itself - between two frames, so
+// that the next frame may use it. The swapchain's call_mutex is held. True
+// once the generation has both slots.
+[[nodiscard]] bool adopt_second_synthetic(
+    const std::shared_ptr<SwapchainState>& swapchain,
+    FrameGenerationSwapchainState& generation) noexcept {
+    try {
+        if (generation.synthetic_slot_count >= kSyntheticSlotCountDeep) {
+            return true;
+        }
+        const std::shared_ptr<LazySyntheticSlot> slot = generation.lazy_slot;
+        if (!slot) {
+            return false;
+        }
+        std::unique_lock lock(slot->mutex);
+        if (!slot->done || slot->adopted) {
+            return false;
+        }
+        std::thread worker = std::move(slot->worker);
+        lock.unlock();
+        // Done: the thread is returning.
+        if (worker.joinable()) {
+            worker.join();
+        }
+        lock.lock();
+        const std::shared_ptr<SessionState> session = swapchain->session;
+        const auto fail = [&](std::uint64_t detail, std::uint64_t which) {
+            if (slot->created.state.handle != XR_NULL_HANDLE && session && session->dispatch &&
+                session->dispatch->destroy_swapchain != nullptr) {
+                static_cast<void>(session->dispatch->destroy_swapchain(slot->created.state.handle));
+            }
+            slot->created.state.handle = XR_NULL_HANDLE;
+            slot->adopted = true;
+            if (session) {
+                session->second_synthetic_failed = true;
+            }
+            if (!slot->failure_logged) {
+                slot->failure_logged = true;
+                xrfg::bridge_flight_logger().event(
+                    xrfg::BridgeFlightOperation::synthetic_slot, 3,
+                    handle_value(swapchain->handle), detail, which);
+            }
+            return false;
+        };
+        if (!slot->succeeded || !session) {
+            return fail(static_cast<std::uint64_t>(static_cast<std::int64_t>(slot->refusal)), 1);
+        }
+        const std::vector<ID3D12Resource*>& resources = slot->created.d3d12_resources;
+        if (resources.empty() || resources.size() != generation.synthetic_images_per_slot ||
+            !generation.synthesizer) {
+            return fail(resources.size(), 2);
+        }
+        HRESULT result = E_FAIL;
+        {
+            std::scoped_lock gpu_lock(session->gpu_mutex);
+            result = generation.synthesizer->add_synthetic_destinations(
+                std::span<ID3D12Resource* const>(resources.data(), resources.size()));
+        }
+        if (FAILED(result)) {
+            return fail(static_cast<std::uint32_t>(result), 3);
+        }
+        generation.synthetic[kSyntheticSlotCountShallow] = slot->created.state;
+        slot->created.state.handle = XR_NULL_HANDLE;
+        slot->adopted = true;
+        generation.synthetic_slot_count = kSyntheticSlotCountDeep;
+        const auto took = std::chrono::duration_cast<std::chrono::microseconds>(
+            slot->finished_at - slot->started_at);
+        xrfg::bridge_flight_logger().event(
+            xrfg::BridgeFlightOperation::synthetic_slot, 2,
+            handle_value(swapchain->handle),
+            static_cast<std::uint64_t>(std::max<std::int64_t>(took.count(), 0)),
+            private_slot_bytes(generation.private_info, resources.size()));
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
