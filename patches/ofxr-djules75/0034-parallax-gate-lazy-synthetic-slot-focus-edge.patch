 namespace xrfg {
 
+// DCS Control (0034): the cockpit's same-pixel rule needs the cockpit still on
+// screen after the rotation pre-warp, and only a head that did not translate
+// leaves it there: the eyes move whenever the head leans and, about the neck,
+// whenever it turns (100 deg/s is 15 px at 0.6 m in 2X). So each eye of each
+// pair is judged once, on the CPU, by the cockpit's worst-case parallax: the
+// eye's translation between the two real frames (their submitted view poses,
+// metres) seen at kCockpitParallaxNearMeters, the nearest cockpit the mask is
+// built around, in output pixels of the target view. Over
+// kCockpitParallaxLimitPixels (or [ofxr] cockpit_parallax_limit) the rule is
+// off for that eye and pair wherever the flow stays in the cockpit: such a
+// masked pixel takes the flow, its own vector kept (frame_synthesis.hlsl).
+// Where the flow left the cockpit - the world's motion taken for a thin
+// cockpit part, the case the flow is weakest at - the rule stays. The world
+// beside the cockpit is handled as in 0031 either way.
+inline constexpr float kCockpitParallaxNearMeters = 0.6F;
+inline constexpr float kCockpitParallaxLimitPixels = 0.5F;
+// DCS Control (0034): the moving focus edge. Quad Views' focus inset (a change
+// of resolution, and of DLSS's tone and detail) moves with the gaze and, in
+// the rotation pre-warped pair the flow sees, with every head turn as well:
+// the flow can take that edge for motion. Where it moved between the two real
+// frames by more than kFocusEdgeMovedPixels, the flow's confidence is lowered
+// within kFocusBandFraction of the view's width of both frames' edges (to
+// 1 - kFocusBandDepth at the edge itself, back to 1 at the band's limit), so
+// the composition leans on the two frames at the very pixel there.
+inline constexpr float kFocusBandFraction = 0.03F;
+inline constexpr float kFocusEdgeMovedPixels = 0.5F;
+inline constexpr float kFocusBandDepth = 0.5F;
+
+namespace cockpit_mask_detail {
+[[nodiscard]] inline Vec3 rotate(const Quaternion& q, const Vec3& v) noexcept {
+    // v + 2 * cross(q.xyz, cross(q.xyz, v) + w * v), as frame_synthesis.hlsl.
+    const Vec3 c1{q.y * v.z - q.z * v.y + q.w * v.x, q.z * v.x - q.x * v.z + q.w * v.y,
+        q.x * v.y - q.y * v.x + q.w * v.z};
+    return {v.x + 2.0F * (q.y * c1.z - q.z * c1.y), v.y + 2.0F * (q.z * c1.x - q.x * c1.z),
+        v.z + 2.0F * (q.x * c1.y - q.y * c1.x)};
+}
+
+[[nodiscard]] inline Quaternion unit(const Quaternion& q) noexcept {
+    const float length = std::sqrt(q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w);
+    return length > 1.0e-12F ? Quaternion{q.x / length, q.y / length, q.z / length, q.w / length}
+                             : Quaternion{};
+}
+}  // namespace cockpit_mask_detail
+
+// DCS Control (0034): the cockpit's worst-case parallax between two real
+// frames of one eye, in output pixels: the eye's translation from `previous`
+// to `current` (tracking space, metres) in the current view's own frame, seen
+// at `near_m`. Across the view axis it shifts every point at that distance by
+// |d_perp| / near_m in tangent; along it, a point at tangent t by t * |d_z| /
+// near_m, the most at the view's widest tangents. `tangents` are the current
+// view's left, right, up, down tangents and `width` x `height` its image
+// rectangle, which give the pixels per unit of tangent. 0 for an unusable
+// view.
+[[nodiscard]] inline float cockpit_parallax_pixels(const Pose& previous, const Pose& current,
+    const std::array<float, 4>& tangents, float width, float height,
+    float near_m = kCockpitParallaxNearMeters) noexcept {
+    const float tangent_width = tangents[1] - tangents[0];
+    const float tangent_height = std::abs(tangents[2] - tangents[3]);
+    if (!(tangent_width > 1.0e-6F) || !(tangent_height > 1.0e-6F) || !(width > 0.0F) ||
+        !(height > 0.0F) || !(near_m > 0.0F)) {
+        return 0.0F;
+    }
+    const Quaternion q = cockpit_mask_detail::unit(current.orientation);
+    const Quaternion inverse{-q.x, -q.y, -q.z, q.w};
+    const Vec3 moved{current.position.x - previous.position.x,
+        current.position.y - previous.position.y, current.position.z - previous.position.z};
+    const Vec3 local = cockpit_mask_detail::rotate(inverse, moved);
+    if (!std::isfinite(local.x) || !std::isfinite(local.y) || !std::isfinite(local.z)) {
+        return 0.0F;
+    }
+    const float focal_x = width / tangent_width;
+    const float focal_y = height / tangent_height;
+    const float across = std::sqrt(local.x * focal_x * local.x * focal_x +
+                             local.y * focal_y * local.y * focal_y) /
+        near_m;
+    const float widest_x = std::max(std::abs(tangents[0]), std::abs(tangents[1])) * focal_x;
+    const float widest_y = std::max(std::abs(tangents[2]), std::abs(tangents[3])) * focal_y;
+    const float along =
+        std::abs(local.z) * std::sqrt(widest_x * widest_x + widest_y * widest_y) / near_m;
+    return across + along;
+}
+
+// DCS Control (0034): how far the focus inset's edge moved between two real
+// frames as the composition sees it, in output pixels: the previous frame's
+// focus rectangle (`previous_focus`, its own left, right, up, down tangents)
+// carried into the current camera by the pair's rotation (`target_to_previous`,
+// x y z w: the rotation the composition maps the current view into the
+// previous one with) against the current one's, the largest move of the four
+// corners. `target_tangents` and `width` x `height` as cockpit_parallax_pixels.
+[[nodiscard]] inline float focus_edge_motion_pixels(const std::array<float, 4>& previous_focus,
+    const std::array<float, 4>& current_focus, const std::array<float, 4>& target_to_previous,
+    const std::array<float, 4>& target_tangents, float width, float height) noexcept {
+    const float tangent_width = target_tangents[1] - target_tangents[0];
+    const float tangent_height = std::abs(target_tangents[2] - target_tangents[3]);
+    if (!(tangent_width > 1.0e-6F) || !(tangent_height > 1.0e-6F) || !(width > 0.0F) ||
+        !(height > 0.0F)) {
+        return 0.0F;
+    }
+    const float focal_x = width / tangent_width;
+    const float focal_y = height / tangent_height;
+    // Previous to target: the inverse of target_to_previous.
+    const Quaternion q = cockpit_mask_detail::unit(
+        {target_to_previous[0], target_to_previous[1], target_to_previous[2], target_to_previous[3]});
+    const Quaternion previous_to_target{-q.x, -q.y, -q.z, q.w};
+    float largest = 0.0F;
+    for (int corner = 0; corner < 4; ++corner) {
+        const float x = previous_focus[corner & 1];
+        const float y = previous_focus[2 + (corner >> 1)];
+        const Vec3 ray = cockpit_mask_detail::rotate(previous_to_target, {x, y, -1.0F});
+        if (!(ray.z < -1.0e-5F)) {
+            return std::numeric_limits<float>::infinity();
+        }
+        const float moved_x = (ray.x / -ray.z - current_focus[corner & 1]) * focal_x;
+        const float moved_y = (ray.y / -ray.z - current_focus[2 + (corner >> 1)]) * focal_y;
+        largest = std::max(largest, std::sqrt(moved_x * moved_x + moved_y * moved_y));
+    }
+    return std::isfinite(largest) ? largest : std::numeric_limits<float>::infinity();
+}
