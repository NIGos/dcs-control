+float read_cockpit_parallax_limit(const std::filesystem::path& module_directory) noexcept {
+    constexpr float kDefault = 0.5F;
+    try {
+        if (module_directory.empty()) {
+            return kDefault;
+        }
+        const auto ini_path = module_directory / L"ofxr_bridge.ini";
+        std::array<wchar_t, 32> value{};
+        const DWORD length = GetPrivateProfileStringW(L"ofxr", L"cockpit_parallax_limit", L"",
+            value.data(), static_cast<DWORD>(value.size()), ini_path.c_str());
+        if (length == 0 || length >= value.size() - 1) {
+            return kDefault;
+        }
+        wchar_t* end = nullptr;
+        const float parsed = std::wcstof(value.data(), &end);
+        if (end == value.data() || !std::isfinite(parsed) || parsed < 0.0F || parsed > 10000.0F) {
+            return kDefault;
+        }
+        return parsed;
+    } catch (...) {
+        return kDefault;
+    }
+}
