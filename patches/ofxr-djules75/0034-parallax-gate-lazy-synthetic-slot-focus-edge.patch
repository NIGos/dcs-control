+// DCS Control (0034): starts making `generation`'s second synthetic slot, on
+// a thread of its own, once. The swapchain's call_mutex is held.
+void start_second_synthetic(
+    const std::shared_ptr<SwapchainState>& swapchain,
+    FrameGenerationSwapchainState& generation,
+    std::uint64_t reason) noexcept {
+    try {
+        if (generation.synthetic_slot_count >= kSyntheticSlotCountDeep) {
+            return;
+        }
+        if (!generation.lazy_slot) {
+            generation.lazy_slot = std::make_shared<LazySyntheticSlot>();
+        }
+        const std::shared_ptr<LazySyntheticSlot> slot = generation.lazy_slot;
+        std::scoped_lock lock(slot->mutex);
+        if (slot->started) {
+            return;
+        }
+        slot->started = true;
+        slot->started_at = std::chrono::steady_clock::now();
+        const XrSwapchainCreateInfo info = generation.private_info;
+        try {
+            slot->worker = std::thread([swapchain, slot, info]() noexcept {
+                CreatedPrivateSwapchain created;
+                XrResult refusal = XR_SUCCESS;
+                bool succeeded = false;
+                try {
+                    succeeded = create_private_swapchain(swapchain, info, &created, &refusal);
+                } catch (...) {
+                    succeeded = false;
+                }
+                try {
+                    std::scoped_lock done_lock(slot->mutex);
+                    slot->created = std::move(created);
+                    slot->succeeded = succeeded && slot->created.state.handle != XR_NULL_HANDLE;
+                    slot->refusal = refusal;
+                    slot->finished_at = std::chrono::steady_clock::now();
+                    slot->done = true;
+                } catch (...) {
+                }
+            });
+        } catch (...) {
+            // No thread: taken as a creation that failed.
+            slot->done = true;
+            slot->succeeded = false;
+            slot->refusal = XR_ERROR_RUNTIME_FAILURE;
+        }
+        xrfg::bridge_flight_logger().event(
+            xrfg::BridgeFlightOperation::synthetic_slot, 1,
+            handle_value(swapchain->handle), reason, 0);
+    } catch (...) {
+    }
+}
