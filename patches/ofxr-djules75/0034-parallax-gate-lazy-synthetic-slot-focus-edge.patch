+// (xrfg::cockpit_parallax_pixels) and the focus edge's move
+// (xrfg::focus_edge_motion_pixels).
+void test_parallax_and_focus_math() {
+    const auto within = [](float a, float b, float tolerance) { return std::abs(a - b) <= tolerance; };
+    xrfg::Pose previous{};
+    xrfg::Pose current{};
+    // Tangents -1..1 over 1000 px: 500 px per unit of tangent.
+    const std::array<float, 4> square{-1.0F, 1.0F, 1.0F, -1.0F};
+    require(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F) == 0.0F,
+        "parallax: none for a still head");
+    current.position.x = 0.003F;
+    require(within(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F),
+                0.003F * 500.0F / 0.6F, 1.0e-3F),
+        "parallax: 3 mm across the view axis at 0.6 m");
+    current.position = {0.0F, -0.002F, 0.0F};
+    require(within(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F),
+                0.002F * 500.0F / 0.6F, 1.0e-3F),
+        "parallax: vertical as well");
+    // 0.1 mm: under the 0.5 px the rule allows.
+    current.position = {0.0001F, 0.0F, 0.0F};
+    require(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F) <
+            xrfg::kCockpitParallaxLimitPixels,
+        "parallax: a tenth of a millimetre is under the limit");
+    // Along the axis: the widest tangent's corner moves the most.
+    current.position = {0.0F, 0.0F, -0.003F};
+    require(within(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F),
+                0.003F * std::sqrt(2.0F) * 500.0F / 0.6F, 1.0e-2F),
+        "parallax: along the view axis, at the widest corner");
+    // In the current view's own frame: turned 90 degrees about y, a move
+    // along tracking x is along its axis.
+    const float half = std::sqrt(0.5F);
+    current.orientation = {0.0F, half, 0.0F, half};
+    current.position = {0.003F, 0.0F, 0.0F};
+    require(within(xrfg::cockpit_parallax_pixels(previous, current, square, 1000.0F, 1000.0F),
+                0.003F * std::sqrt(2.0F) * 500.0F / 0.6F, 1.0e-2F),
+        "parallax: the translation is taken in the current view's frame");
+    // R68's neck pivot: 100 deg/s with the eyes 9 cm from the yaw axis is
+    // 0.157 m/s, 3.49 mm a pair in 2X at 90 Hz; at 46 px/deg (2636 px per
+    // unit of tangent at the centre) that is 15.3 px at 0.6 m.
+    current = {};
+    current.position.x = 0.157F * 0.0222F;
+    require(within(xrfg::cockpit_parallax_pixels(previous, current, square, 5272.0F, 5272.0F), 15.3F, 0.2F),
+        "parallax: R68's 15 px for a 100 deg/s turn");
+    require(xrfg::cockpit_parallax_pixels(previous, current, {1.0F, -1.0F, 1.0F, -1.0F}, 1000.0F, 1000.0F) == 0.0F,
+        "parallax: an unusable view gives none");
+
+    const std::array<float, 4> identity{0.0F, 0.0F, 0.0F, 1.0F};
+    const std::array<float, 4> inset{-0.3F, 0.3F, 0.3F, -0.3F};
+    require(xrfg::focus_edge_motion_pixels(inset, inset, identity, square, 1000.0F, 1000.0F) == 0.0F,
+        "focus: an inset that stayed has not moved");
+    const std::array<float, 4> moved{-0.29F, 0.31F, 0.3F, -0.3F};
+    require(within(xrfg::focus_edge_motion_pixels(inset, moved, identity, square, 1000.0F, 1000.0F), 5.0F, 1.0e-2F),
+        "focus: the gaze moved the inset by 0.01 (5 px)");
+    // The head turned 1 degree with the gaze still: the same inset in each
+    // frame's own tangents, moved on the pre-warped pair.
+    const float angle = 0.5F * 3.14159265F / 180.0F;
+    const std::array<float, 4> turned{0.0F, std::sin(angle), 0.0F, std::cos(angle)};
+    require(xrfg::focus_edge_motion_pixels(inset, inset, turned, square, 1000.0F, 1000.0F) >
+            xrfg::kFocusEdgeMovedPixels,
+        "focus: a head turn moves the inset on the pre-warped pair");
+    std::cout << "cockpit mask: the parallax and focus edge figures\n";
+}
