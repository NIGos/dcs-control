+// the two frames at the very pixel than without, and everywhere else it is
+// byte for byte the composition without them. Without one frame's inset, or
+// with insets that did not move, nothing changes at all.
+void test_focus_edge_band(D3D12WarpFixture& fixture,
+    xrfg::D3D12OpticalFlowBackend backend = xrfg::D3D12OpticalFlowBackend::fidelity_fx) {
+    constexpr UINT width = 320, height = 240;
+    const ReprojectionViews views = make_reprojection_views();
+    struct Inset {
+        int left, top, right, bottom; // pixel edges
+    };
+    const Inset inset_a{100, 70, 200, 160};
+    const Inset inset_b{112, 76, 212, 166};
+    const auto scene = [&](const Inset& inset) {
+        StereoPattern image;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            auto& bytes = image[eye];
+            bytes.resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+            for (UINT y = 0; y < height; ++y) {
+                for (UINT x = 0; x < width; ++x) {
+                    auto texel = occlusion_texture(double(x), double(y), 0);
+                    const bool inside = int(x) >= inset.left && int(x) < inset.right && int(y) >= inset.top &&
+                        int(y) < inset.bottom;
+                    if (inside) {
+                        for (auto& c : texel) c = static_cast<std::uint8_t>(std::min(255, int(c) + 40));
+                    }
+                    const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                    bytes[i] = texel[0];
+                    bytes[i + 1] = texel[1];
+                    bytes[i + 2] = texel[2];
+                    bytes[i + 3] = 255;
+                }
+            }
+        }
+        return image;
+    };
+    const auto previous = scene(inset_a);
+    const auto current = scene(inset_b);
+    const auto tangents_of = [&](const Inset& inset, UINT eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        return std::array<float, 4>{left + (right - left) * float(inset.left) / float(width),
+            left + (right - left) * float(inset.right) / float(width),
+            up + (down - up) * float(inset.top) / float(height),
+            up + (down - up) * float(inset.bottom) / float(height)};
+    };
+    // No cockpit in view: an empty mask, carrying the insets.
+    const auto frame_with = [&](const Inset* inset) {
+        auto frame = make_cockpit_mask_frame(fixture, width, height, {}, 2, views);
+        for (UINT eye = 0; eye < kEyeCount && inset != nullptr; ++eye) {
+            frame->focus[eye].valid = true;
+            frame->focus[eye].fov_tan = tangents_of(*inset, eye);
+        }
+        return frame;
+    };
+    const xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    const auto run = [&](std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> frames) {
+        return synthesize_nvidia_pair(fixture, previous, current, width, height, options, frames, backend);
+    };
+    const auto without = run({frame_with(nullptr), frame_with(nullptr)});
+    const auto with = run({frame_with(&inset_a), frame_with(&inset_b)});
+    require(run({frame_with(nullptr), frame_with(&inset_b)}) == without,
+        "focus band: one frame's inset alone changes the composition");
+    require(run({frame_with(&inset_b), frame_with(&inset_b)}) == without,
+        "focus band: an inset that did not move changes the composition");
+    // The band: within 3 % of the width (9.6 px) of either outline, and the
+    // mask's cell (4 px) beyond, where its texel may reach.
+    const float reach = xrfg::kFocusBandFraction * float(width) + 6.0F;
+    const auto outline_distance = [](const Inset& inset, float x, float y) {
+        const float cx = 0.5F * float(inset.left + inset.right), cy = 0.5F * float(inset.top + inset.bottom);
+        const float qx = std::abs(x - cx) - 0.5F * float(inset.right - inset.left);
+        const float qy = std::abs(y - cy) - 0.5F * float(inset.bottom - inset.top);
+        const float outside = std::sqrt(std::max(qx, 0.0F) * std::max(qx, 0.0F) + std::max(qy, 0.0F) * std::max(qy, 0.0F));
+        return outside + std::abs(std::min(std::max(qx, qy), 0.0F));
+    };
+    std::vector<std::uint8_t> band(static_cast<std::size_t>(width) * height, 0), away(band.size(), 0);
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const float px = float(x) + 0.5F, py = float(y) + 0.5F;
+            const float distance = std::min(outline_distance(inset_a, px, py), outline_distance(inset_b, px, py));
+            band[static_cast<std::size_t>(y) * width + x] = distance <= reach ? 1 : 0;
+            away[static_cast<std::size_t>(y) * width + x] = distance > reach ? 1 : 0;
+        }
+    }
+    const StereoPattern same_pixel = midpoint_pattern(previous, current);
+    const double band_with = masked_mae(with, same_pixel, width, height, band);
+    const double band_without = masked_mae(without, same_pixel, width, height, band);
+    int away_worst = 0;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (std::size_t at = 0; at < away.size(); ++at) {
+            if (away[at] == 0) continue;
+            for (UINT c = 0; c < 3; ++c) {
+                away_worst = std::max(away_worst,
+                    std::abs(int(with[eye][at * kBytesPerPixel + c]) - int(without[eye][at * kBytesPerPixel + c])));
+            }
+        }
+    }
+    std::cout << "focus band (" << (backend == xrfg::D3D12OpticalFlowBackend::nvidia ? "NVIDIA" : "FidelityFX")
+              << "): about the moving edge, from the same pixel mae " << band_with << " (without the insets "
+              << band_without << "); away from it, against without, worst " << away_worst << std::endl;
+    require(away_worst == 0, "focus band: the composition changed away from the moving edge");
+    require(band_with <= band_without + 1.0e-9, "focus band: the moving edge is composed further from the frames");
 }
 
 // The moving-edge region: where the foreground covers a pixel at some of the
diff --git a/tests/layer_adaptive_lazy_slot.cmake b/tests/layer_adaptive_lazy_slot.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_adaptive_lazy_slot.cmake
@@ -0,0 +1,80 @@
+# DCS Control (0034): runs the dcs-adaptive call-chain scenario with adaptive
+# 2X/3X at the shallow depth starting in 2X (ADAPTIVE_INI beside the layer
+# DLL): the application is light, then heavy enough for 3X. The synthetic
+# ring's second slot must be made only then, on its own thread, and be in
+# before the session switches: the flight log must show it wanted, then
+# ready, then the switch to 3X - never 3X first, never a failure. The call
+# chain itself checks that both synthetic slots existed when the application
+# was first handed 3X's period, that 3X showed the second one, and that real
+# frames were shown at the time the application was told.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN ADAPTIVE_INI WORK_DIR)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${ADAPTIVE_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(adaptive_ini_name "${ADAPTIVE_INI}" NAME)
+file(RENAME "${WORK_DIR}/${adaptive_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        dcs-adaptive
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain 'dcs-adaptive' (lazy second synthetic slot) failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(READ "${flight_log}" contents)
+
+# The session's shape at creation: 2X, the shallow depth.
+string(FIND "${contents}" "op=presenter_transition result=700 dur_us=0 a=2 b=0 c=0" created)
+if(created EQUAL -1)
+    message(FATAL_ERROR "The session did not start in 2X at the shallow depth")
+endif()
+# Wanted for a switch to 3X (b=1), or by a scene change that looked heavy (b=3).
+string(REGEX MATCH "op=synthetic_slot result=1 dur_us=0 a=[0-9]+ b=[13] c=0" wanted "${contents}")
+if(wanted STREQUAL "")
+    message(FATAL_ERROR "The second synthetic slot was never asked for")
+endif()
+string(FIND "${contents}" "${wanted}" wanted_at)
+string(REGEX MATCH "op=synthetic_slot result=2 dur_us=0 a=[0-9]+ b=[0-9]+ c=[1-9][0-9]*" ready "${contents}")
+if(ready STREQUAL "")
+    message(FATAL_ERROR "The second synthetic slot was never taken into the ring")
+endif()
+string(FIND "${contents}" "${ready}" ready_at)
+string(FIND "${contents}" "op=synthetic_slot result=3 " failed)
+if(NOT failed EQUAL -1)
+    message(FATAL_ERROR "The second synthetic slot failed")
+endif()
+# The live switch to 3X (c=2), the shallow depth.
+string(FIND "${contents}" "op=presenter_transition result=700 dur_us=0 a=3 b=0 c=2" triple_at)
+if(triple_at EQUAL -1)
+    message(FATAL_ERROR "No live switch to 3X")
+endif()
+if(NOT (created LESS wanted_at AND wanted_at LESS ready_at AND ready_at LESS triple_at))
+    message(FATAL_ERROR
+        "Out of order: created ${created}, wanted ${wanted_at}, ready ${ready_at}, 3X ${triple_at}")
+endif()
+string(REGEX MATCH "op=adaptive_switch result=[23] dur_us=0 a=2 b=3 c=[0-9]+" upshift "${contents}")
+if(upshift STREQUAL "")
+    message(FATAL_ERROR "No 2X -> 3X adaptive switch for a slow or late application")
+endif()
+message(STATUS "Lazy second synthetic slot: ${wanted} / ${ready}")
