+// DCS Control (0102): 0098's settle after a 3 -> 2 (missed slots in its first
+// two_settle_after_three not counted) belongs to that 2 only. 3 -> 2 -> 1X ->
+// 2: the 2 that 1X leaves for counts its missed slots from the start, as
+// before 0098 (the flag stayed set through 1X and hid them for 300 ms).
+void cadence_3x_exit_after_one_tests() {
+    CadenceSim sim(cadence_config_for(CadencePreference::steady));
+    sim.controller.set_three_exit_learned(true);
+    constexpr Nanoseconds kHeavy = 24 * kMillisecond;
+    constexpr Nanoseconds kLight = 6 * kMillisecond;
+    bool up = false, down = false, one = false;
+    for (int index = 0; index < 200 && !up; ++index) {
+        up = sim.frame(kHeavy, kHeavy).level == 3;
+    }
+    for (int index = 0; index < 400 && !down; ++index) {
+        const CadenceStep step = sim.frame(kLight, kLight);
+        down = step.previous == 3 && step.level == 2;
+    }
+    for (int index = 0; index < 1000 && !one; ++index) {
+        one = sim.frame(kLight, kLight).event == CadenceEvent::one_entered;
+    }
+    require(up && down && one, "3x exit after 1X: 3, back to 2, then 1X");
+    // Past 1X's grace, two missed-slot episodes leave it for 2.
+    for (int index = 0; index < 100; ++index) { // a second at 1X: past its grace
+        sim.frame(kLight, kLight);
+    }
+    bool left = false;
+    for (int index = 0; index < 30 && !left; ++index) {
+        sim.controller.add_late(sim.now + kPeriod, 1);
+        left = sim.frame(kLight, kLight).event == CadenceEvent::one_left_late;
+        for (int gap = 0; gap < 12 && !left; ++gap) {
+            left = sim.frame(kLight, kLight).event == CadenceEvent::one_left_late;
+        }
+    }
+    require(left && sim.controller.level() == 2, "3x exit after 1X: 1X left on missed slots");
+    // Two episodes 130 ms apart, both within 300 ms of the return to 2.
+    const Nanoseconds returned = sim.now;
+    std::uint32_t level = 2;
+    for (int index = 0; index < 12 && level == 2; ++index) {
+        if (index == 1 || index == 7) {
+            sim.controller.add_late(sim.now + kPeriod * 2, 1);
+        }
+        level = sim.frame(kLight, kLight).level;
+    }
+    std::cout << "3x exit after 1X: level " << level << " "
+              << (sim.now - returned) / kMillisecond << " ms after the return to 2\n";
+    require(level == 3 && sim.now - returned < 300 * kMillisecond,
+        "3x exit after 1X: missed slots count from the start of a 2 that 1X left for");
+}
