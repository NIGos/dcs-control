+// DCS Control (0062): R114 - a load swapped every 20 s (a square wave), and
+// the level's landing with it: 3 between 4 and 5 periods after its told time
+// (2 between 3 and 5), a quarter period of jitter, each frame observed two
+// frames after it was told. 0061's hysteresis (2 s doubled up to 16 s) moved
+// the offset on every phase; 0062's (30 s up to 120 s, counted from the
+// level's last frame on time in a confirmed run) moves it in the first two
+// phases only (the first settle: from 0 to the one landing, then the other,
+// the same way), then never. A genuine persistent shift still moves.
+void cadence_resync_level_hold_tests() {
+    constexpr Nanoseconds kP = 11'111'111;
+    constexpr Nanoseconds kStart = 1'000'000'000;
+    constexpr Nanoseconds kPhase = 20 * kSecond;
+    constexpr int kPhases = 10;
+    struct Sim {
+        CadenceTimeResync resync{};
+        std::uint32_t frames{};
+        Nanoseconds told{kStart};
+        std::uint32_t lcg{0x5EED0062U};
+        std::vector<std::pair<Nanoseconds, std::int64_t>> in_flight;
+        std::vector<std::pair<Nanoseconds, std::int64_t>> moved_at;
+    };
+    // The level's frames up to `until`, each landing `lands(told)` periods
+    // after its told time before any resync.
+    const auto run = [&](Sim& sim, Nanoseconds until, const auto& lands) {
+        while (sim.told < until) {
+            sim.told += sim.frames * kP;
+            sim.in_flight.emplace_back(sim.told, sim.resync.periods_for(sim.frames));
+            if (sim.in_flight.size() <= 2) {
+                continue;
+            }
+            const auto shown = sim.in_flight.front();
+            sim.in_flight.erase(sim.in_flight.begin());
+            sim.lcg = sim.lcg * 1664525U + 1013904223U;
+            const Nanoseconds jitter =
+                (static_cast<Nanoseconds>((sim.lcg >> 8) % 3U) - 1) * kP / 4;
+            const Nanoseconds residual = (lands(shown.first) - shown.second) * kP + jitter;
+            const std::int64_t moved =
+                sim.resync.observe(sim.frames, shown.first, residual, kP, sim.told);
+            if (moved != 0) {
+                sim.moved_at.emplace_back(shown.first, moved);
+            }
+        }
+    };
+    const auto square = [&](Sim& sim, std::int64_t low, std::int64_t high) {
+        run(sim, kStart + kPhases * kPhase, [&](Nanoseconds at) {
+            return ((at - kStart) / kPhase) % 2 == 0 ? low : high;
+        });
+    };
+    const auto after = [](const Sim& sim, Nanoseconds from) {
+        int count = 0;
+        for (const auto& move : sim.moved_at) {
+            count += move.first >= from ? 1 : 0;
+        }
+        return count;
+    };
+    const auto describe = [](const Sim& sim) {
+        std::string text;
+        for (const auto& move : sim.moved_at) {
+            text += " " + std::to_string((move.first - kStart) / kMillisecond) + "ms:" +
+                std::to_string(move.second);
+        }
+        return text;
+    };
+    const Nanoseconds settled = kStart + 2 * kPhase;
+    for (const std::uint32_t frames : {3U, 2U}) {
+        const std::size_t level = CadenceTimeResync::level_index(frames);
+        const std::int64_t low = frames == 3 ? 4 : 3;
+        const std::int64_t high = 5;
+        const std::string name = "level " + std::to_string(frames) + ": ";
+        Sim old_hold{};
+        old_hold.frames = frames;
+        old_hold.resync.hysteresis = kCadenceResyncHysteresis0061;
+        square(old_hold, low, high);
+        Sim hold{};
+        hold.frames = frames;
+        square(hold, low, high);
+        std::cout << "cadence resync, " << name << "20 s square wave " << low << "/" << high
+                  << ": 0061 moves" << describe(old_hold) << "; 0062 moves" << describe(hold)
+                  << " (hold restarts " << hold.resync.hold_restarts << ")\n";
+        require(after(old_hold, settled) >= 4,
+            name + "0061's hysteresis follows the square wave (" + describe(old_hold) + ")");
+        require(hold.moved_at.size() == 2 && after(hold, settled) == 0 &&
+                    hold.resync.periods_for(frames) == high &&
+                    hold.resync.level_moves[level] == 2 && hold.resync.hold_restarts >= 3,
+            name + "0062: no move after the first settle (" + describe(hold) + ")");
+
+        // A genuine persistent shift against the last move (5 -> low for
+        // good): held the hold from its start (30 s), then one move, and
+        // none after.
