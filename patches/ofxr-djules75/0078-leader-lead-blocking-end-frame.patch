+// ---------------------------------------------------------------------------
+// DCS Control (0078): the first synthetic's hand-over on a runtime whose
+// xrEndFrame waits for it (GitHub #23).
+//
+// At the shallow depth (`deep_pipeline=0`) the application is released so
+// that its frame is queued just after the presenter took the real frame
+// before it, and that frame's first synthetic is handed to the runtime a
+// slot later, usually before its output is written: the runtime waits for it
+// on the layer's queue and shows it if it is written in time (0009). That
+// holds while the runtime's xrEndFrame returns at once. With the Pimax
+// runtime's own quad views (one projection layer of four views) it does not:
+// the call returns about 1.3 ms after the output is written. A live DCS
+// flight (2026-11-15, 90 Hz, RTX 5090) had the first synthetic written
+// 13.5-16.7 ms after its hand-over (the frame's D3D11 rendering, then
+// synthesis), the presenter held in xrEndFrame for that long, and the
+// runtime's next wait a display period later than its slot: 379 of 380
+// frames in a 17 s stretch, every frame at cadence 3 lasting four periods
+// (22.5 fps at 90 Hz), and at a fixed 2X about every other frame (36 fps).
+// The same runtime with two views (the bundled Quad Views layer composes
+// them) returned in 0.3 ms with the output written 2-12 ms later, and lost
+// no slot. A call that returned up to 10 ms after its slot's wait lost
+// almost none; one that returned 11 ms or more after it lost every one.
+//
+// HandOverBlock tells the two apart from what the presenter sees, one
+// observation per first synthetic handed over unwritten. LeaderLead then
+// moves the application's release earlier by what the first synthetic was
+// late, so that it is written at its hand-over: the queue is that much
+// deeper while the runtime waits, and no deeper once it stops.
+// leader_lead_release turns the lead into the presenter frames the release
+// no longer waits for and what is left of the release offset.
+//
+// A runtime that returns before the output is written never latches, and
+// nothing changes for it.
+struct HandOverBlock {
+    // Observations of a held call that lost its slot before the lead arms;
+    // one that returned unwritten takes kFreeStep back, so a runtime that
+    // does not wait disarms it at once.
+    static constexpr std::uint32_t kLatch = 8;
+    static constexpr std::uint32_t kCeiling = 16;
+    static constexpr std::uint32_t kFreeStep = 8;
+    // A call shorter than this was not held for the output, written or not.
+    static constexpr Nanoseconds kHeldCall = 2 * kMillisecond;
+
+    std::uint32_t score{};
+    bool latched{};
+
+    // `written_at_return`: the output was written when the runtime's
+    // xrEndFrame returned; `call`: how long that call took; `slot_lost`: the
+    // runtime's next wait skipped a display period. True when `latched`
+    // changed.
+    bool observe(bool written_at_return, Nanoseconds call, bool slot_lost) noexcept {
+        const bool before = latched;
+        if (!written_at_return) {
+            score = score > kFreeStep ? score - kFreeStep : 0;
+        } else if (call >= kHeldCall && slot_lost) {
+            score = score < kCeiling ? score + 1 : kCeiling;
+        }
+        if (score >= kLatch) {
+            latched = true;
+        } else if (score == 0) {
+            latched = false;
+        }
+        return latched != before;
+    }
+};
+
+struct LeaderLead {
+    static constexpr std::uint32_t kWindowFrames = 30;
+    // Judged on the window's second-highest lateness (written minus handed
+    // over; negative: written before). Above kRaiseAbove the lead grows by
+    // that lateness, so the next window's is about zero; below kLowerBelow
+    // it gives half of the room back. Between the two it holds: a first
+    // synthetic written up to 2.5 ms after its hand-over keeps the
+    // presenter about 4 ms, well inside its slot.
+    static constexpr Nanoseconds kRaiseAbove = 2'500'000;
+    static constexpr Nanoseconds kLowerBelow = -5 * kMillisecond;
+    // A raise that did not bring the lateness down by half of itself bought
+    // nothing (the frame is bound by something the release does not move):
+    // it is taken back and none is tried for `hold` windows, doubling up to
+    // kMaxHoldWindows while raises keep failing.
+    static constexpr std::uint32_t kBaseHoldWindows = 10;
+    static constexpr std::uint32_t kMaxHoldWindows = 80;
+    // Frames still released under the lead before a step are not judged.
+    static constexpr std::uint32_t kSettleFrames = 3;
+
+    enum class Reason : std::uint32_t {
+        hold = 0,
+        raised = 1,
+        lowered = 2,
+        taken_back = 3,
+        disarmed = 4,
+    };
+    struct Step {
+        bool closed{};
+        bool changed{};
+        Nanoseconds lead{};
+        Nanoseconds high{};
+        Reason reason{Reason::hold};
+    };
+
+    Nanoseconds lead{0};
+    std::array<Nanoseconds, kWindowFrames> window{};
+    std::uint32_t count{};
+    std::uint32_t settle{};
+    std::uint32_t hold{};
+    std::uint32_t backoff{kBaseHoldWindows};
+    // The last raise, until the window after it has judged it.
+    Nanoseconds raise_step{0};
+    Nanoseconds raise_from{0};
+
+    void reset() noexcept { *this = LeaderLead{}; }
+
+    // The most the release can lead by: every presenter frame of the
+    // application frame but one.
+    [[nodiscard]] static constexpr Nanoseconds ceiling(
+        Nanoseconds period, std::uint32_t frames) noexcept {
+        return period > 0 && frames >= 2
+            ? period * static_cast<Nanoseconds>(frames - 1)
+            : 0;
+    }
+
+    // One first synthetic: `lateness` is when it was written less when it
+    // was handed over. `frames`: the most presenter frames an application
+    // frame takes in this shape (2, or 3 under adaptive cadence). Not armed
+    // (HandOverBlock not latched), the lead goes back to zero.
+    Step observe(
+        Nanoseconds lateness,
+        Nanoseconds period,
+        std::uint32_t frames,
+        bool armed) noexcept {
+        Step step{};
+        if (!armed || period <= 0 || frames < 2) {
+            step.changed = lead != 0;
+            step.closed = step.changed;
+            step.reason = Reason::disarmed;
+            reset();
+            return step;
+        }
+        if (settle != 0) {
+            --settle;
+            return step;
+        }
+        window[count++] = lateness;
+        if (count < kWindowFrames) {
+            return step;
+        }
+        count = 0;
+        auto sorted = window;
+        std::sort(sorted.begin(), sorted.end());
+        const Nanoseconds high = sorted[kWindowFrames - 2];
+        const Nanoseconds limit = ceiling(period, frames);
+        const Nanoseconds before = lead;
+        step.closed = true;
+        step.high = high;
+        if (hold != 0) {
+            --hold;
+        }
+        if (raise_step > 0) {
+            // The window after a raise judges it.
+            const bool bought = high <= raise_from - raise_step / 2;
+            const Nanoseconds taken = raise_step;
+            raise_step = 0;
+            if (!bought) {
+                lead = lead > taken ? lead - taken : 0;
+                hold = backoff;
+                backoff = backoff * 2 > kMaxHoldWindows ? kMaxHoldWindows : backoff * 2;
+                step.reason = Reason::taken_back;
+            } else {
+                backoff = kBaseHoldWindows;
+            }
+        }
+        if (step.reason == Reason::hold) {
+            if (high > kRaiseAbove && hold == 0 && lead < limit) {
+                const Nanoseconds raised = lead + high > limit ? limit : lead + high;
+                raise_step = raised - lead;
+                raise_from = high;
+                lead = raised;
+                step.reason = Reason::raised;
+            } else if (high < kLowerBelow && lead > 0) {
+                const Nanoseconds give = -high / 2;
+                lead = lead > give ? lead - give : 0;
+                step.reason = Reason::lowered;
+            }
+        }
+        if (lead > limit) {
+            lead = limit;
+        }
+        step.lead = lead;
+        step.changed = lead != before;
+        if (step.changed) {
+            settle = kSettleFrames;
+        }
+        return step;
+    }
+};
+
+// What a lead does to the once-per-pair hold: `turns` presenter frames it no
+// longer waits for, and `delay` after the last one it does wait for (the
+// release offset in force less the lead, carried into those frames). No
+// lead, or a frame of one presenter frame: the offset, as before.
+struct LeaderLeadRelease {
+    std::uint32_t turns{};
+    Nanoseconds delay{};
+};
+[[nodiscard]] constexpr LeaderLeadRelease leader_lead_release(
+    Nanoseconds lead,
+    Nanoseconds offset,
+    Nanoseconds period,
+    std::uint32_t frames) noexcept {
+    if (offset < 0) {
+        offset = 0;
+    }
+    if (lead <= 0 || period <= 0 || frames < 2) {
+        return LeaderLeadRelease{0, offset};
+    }
+    if (lead <= offset) {
+        return LeaderLeadRelease{0, offset - lead};
+    }
+    const Nanoseconds over = lead - offset;
+    const Nanoseconds turns = (over + period - 1) / period;
+    const Nanoseconds most = static_cast<Nanoseconds>(frames - 1);
+    if (turns > most) {
+        return LeaderLeadRelease{static_cast<std::uint32_t>(most), 0};
+    }
+    return LeaderLeadRelease{static_cast<std::uint32_t>(turns), turns * period - over};
+}
+
 } // namespace xrfg::latency
