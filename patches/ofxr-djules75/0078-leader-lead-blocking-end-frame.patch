+            presenter = Presenter::ready;
+        }
+        if (presenter == Presenter::ready && now >= ready_at && !queue.empty()) {
+            current = queue.front();
+            queue.pop_front();
+            in_flight = 1;
+            handed = now;
+            leader_unwritten = current.leader && current.written > now;
+            if (current.leader) {
+                const Nanoseconds lateness = current.written - handed;
+                if (now >= 300 * kMillisecond && now < kSecond) {
+                    early_lateness += static_cast<double>(lateness) / 1.0e6;
+                    ++early_lateness_count;
+                }
+                if (now >= total - 5 * kSecond) {
+                    late_lateness = std::max(late_lateness, static_cast<double>(lateness) / 1.0e6);
+                }
+                if (lead_enabled) {
+                    if (block.latched) {
+                        const auto step = lead.observe(lateness, period, frames, true);
+                        if (step.closed && step.reason == xrfg::latency::LeaderLead::Reason::raised) {
+                            ++result.raises;
+                        }
+                    } else if (lead.lead != 0) {
+                        static_cast<void>(lead.observe(0, 0, 0, false));
+                    }
+                }
+            }
+            if (!current.synthetic) {
+                real_pops.push_back(now);
+            }
+            presenter_until = runtime_waits
+                ? std::max(now, current.written) + 1'300'000
+                : now + 300'000;
+            presenter = Presenter::ending;
+        }
+        if (presenter == Presenter::ending && now >= presenter_until) {
+            in_flight = 0;
+            if (leader_unwritten) {
+                evidence_pending = true;
+                evidence_written = current.written <= now;
+                evidence_call = now - handed;
+            }
+            presenter_until = (now / period + 1) * period;
+            presenter = Presenter::waiting;
+        }
+        // The application.
+        const std::size_t outstanding = queue.size() + static_cast<std::size_t>(in_flight);
+        if (application == Application::cpu && now >= application_until) {
+            render_done = std::max(gpu_free, now) + gpu_now;
+            gpu_free = render_done;
+            application = Application::admission;
+        }
+        if (application == Application::admission && outstanding <= 1) {
+            const Nanoseconds written = std::max(render_done, now) + synth;
+            gpu_free = std::max(gpu_free, written);
+            queue.push_back(Submission{true, true, written});
+            if (frames >= 3) {
+                queue.push_back(Submission{true, false, written});
+            }
+            queue.push_back(Submission{false, false, 0});
+            application = Application::capacity;
+        } else if (application == Application::capacity &&
+                   queue.size() + static_cast<std::size_t>(in_flight) <= frames) {
+            release = lead_enabled && block.latched && lead.lead > 0
+                ? xrfg::latency::leader_lead_release(lead.lead, offset, period, frames)
+                : xrfg::latency::LeaderLeadRelease{0, offset};
+            application = Application::hold;
+        }
+        if (application == Application::hold &&
+            (serial + release.turns + phase_credit >= served + frames || queue.empty())) {
+            served = serial + release.turns;
+            phase_credit = 0;
+            application_until = now + release.delay;
+            application = Application::delay;
+        }
+        if (application == Application::delay && now >= application_until) {
+            application_until = now + cpu;
+            application = Application::cpu;
+        }
+    }
+    const auto mean_periods = [&](Nanoseconds from, Nanoseconds to) {
+        Nanoseconds first = -1;
+        Nanoseconds last = -1;
+        int count = 0;
+        for (const Nanoseconds at : real_pops) {
+            if (at < from || at >= to) {
+                continue;
+            }
+            if (first < 0) {
+                first = at;
+            }
+            last = at;
+            ++count;
+        }
+        return count > 1
+            ? static_cast<double>(last - first) / static_cast<double>(count - 1) /
+                  static_cast<double>(period)
+            : 0.0;
+    };
+    result.early_periods = mean_periods(300 * kMillisecond, kSecond);
+    result.late_periods = mean_periods(total - 5 * kSecond, total);
+    for (const Nanoseconds at : lost_at) {
+        result.late_lost += at >= total - 5 * kSecond ? 1 : 0;
+    }
+    result.early_lateness_ms = early_lateness_count != 0
+        ? early_lateness / early_lateness_count
+        : 0.0;
+    result.late_lateness_ms = late_lateness;
+    result.latched = block.latched;
+    result.lead = lead.lead;
+    return result;
+}
