+    xrfg::latency::Nanoseconds lighter_after = 0,
+    xrfg::latency::Nanoseconds lighter_gpu = 0) {
+    using xrfg::latency::Nanoseconds;
+    using xrfg::latency::kMillisecond;
+    using xrfg::latency::kSecond;
