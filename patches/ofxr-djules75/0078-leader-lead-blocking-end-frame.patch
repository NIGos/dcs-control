+// DCS Control (0078): the first synthetic on a runtime whose xrEndFrame
+// waits for its output (GitHub #23). Numbers from the live flight of
+// 2026-11-15 at 90 Hz: cadence 3, the output written 13.5-16.7 ms after its
+// hand-over, the runtime's call returning 1.3 ms after that and its next
+// wait a period late; and the same runtime with two views, returning in
+// 0.3 ms before the output was written.
+void leader_lead_tests() {
+    using xrfg::latency::HandOverBlock;
+    using xrfg::latency::LeaderLead;
+    using xrfg::latency::leader_lead_release;
+    using xrfg::latency::kMillisecond;
+    using xrfg::latency::Nanoseconds;
+    const Nanoseconds period = 11'111'128;
+    {
+        // The runtime's own quad views: every hand-over held until written,
+        // every one a slot lost. Armed after kLatch of them, not before.
+        HandOverBlock block{};
+        for (std::uint32_t i = 0; i + 1 < HandOverBlock::kLatch; ++i) {
+            require(!block.observe(true, 16 * kMillisecond, true) && !block.latched,
+                "hand-over block: not armed before its count");
+        }
+        require(block.observe(true, 16 * kMillisecond, true) && block.latched,
+            "hand-over block: armed on held calls that lost their slots");
+        // A held call that kept its slot, or a short one, says nothing.
+        require(!block.observe(true, 5 * kMillisecond, false) && block.latched,
+            "hand-over block: a held call in its slot changes nothing");
+        // One hand-over returned unwritten takes kFreeStep back; the score
+        // is at kLatch + 0, so it disarms at once.
+        require(block.observe(false, 300'000, false) && !block.latched,
+            "hand-over block: a call returned before the output disarms it");
+    }
+    {
+        // The bundled Quad Views on the same runtime: 0.3 ms calls, the
+        // output written later, a slot lost now and then for other reasons.
+        HandOverBlock block{};
+        for (int i = 0; i < 10'000; ++i) {
+            const bool slot_lost = i % 400 == 0;
+            // One in fifty happens to be written by the time the call is back.
+            const bool written = i % 50 == 0;
+            require(!block.observe(written, 300'000, slot_lost) && !block.latched,
