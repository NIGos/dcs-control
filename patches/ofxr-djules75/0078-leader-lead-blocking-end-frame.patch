+void leader_lead_model_tests() {
+    using xrfg::latency::kMillisecond;
+    using xrfg::latency::kSecond;
+    const auto near = [](double value, double target, double tolerance) {
+        return std::abs(value - target) <= tolerance;
+    };
+    const auto describe = [](const LeadModelResult& r) {
+        return " (early " + std::to_string(r.early_periods) + " periods/frame, late " +
+            std::to_string(r.late_periods) + ", lost " + std::to_string(r.late_lost) +
+            ", early lateness " + std::to_string(r.early_lateness_ms) + " ms, late lateness " +
+            std::to_string(r.late_lateness_ms) + " ms, lead " +
+            std::to_string(static_cast<double>(r.lead) / 1.0e6) + " ms, raises " +
+            std::to_string(r.raises) + ")";
+    };
+    // The flight's lock, without the lead: four periods a frame for good,
+    // the first synthetic about 14 ms late, a slot lost every frame.
+    {
+        const auto r = run_lead_model(3, 8 * kMillisecond, 14'700'000, 7'200'000, true, false);
+        std::cout << "lead model, cadence 3, a runtime that waits, no lead:" << describe(r) << '\n';
+        require(near(r.early_periods, 4.0, 0.05) && near(r.late_periods, 4.0, 0.05),
+            "lead model: the lock is four periods a frame" + describe(r));
+        require(r.early_lateness_ms > 12.0 && r.early_lateness_ms < 17.0,
+            "lead model: the lock's lateness is the flight's" + describe(r));
+        require(r.late_lost > 100, "lead model: the lock loses a slot a frame" + describe(r));
+    }
+    // With it: the same first second, then three periods a frame, no slot
+    // lost, the first synthetic written by its hand-over.
+    {
+        const auto r = run_lead_model(3, 8 * kMillisecond, 14'700'000, 7'200'000, true, true);
+        std::cout << "lead model, cadence 3, a runtime that waits, with the lead:" << describe(r) << '\n';
+        require(near(r.early_periods, 4.0, 0.3),
+            "lead model: locked until the lead arms" + describe(r));
+        require(r.latched && r.lead > 10 * kMillisecond && r.lead <= 2 * 11'111'128,
+            "lead model: armed, a lead of about the lateness" + describe(r));
+        require(near(r.late_periods, 3.0, 0.02) && r.late_lost == 0,
+            "lead model: three periods a frame, no slot lost" + describe(r));
+        require(r.late_lateness_ms <= 2.6,
+            "lead model: written by its hand-over" + describe(r));
+        require(r.raises >= 1 && r.raises <= 3, "lead model: settles in a few steps" + describe(r));
+    }
+    // The same application on a runtime that does not wait (the bundled
+    // Quad Views): three periods a frame as it always was, never armed.
+    {
+        const auto with = run_lead_model(3, 8 * kMillisecond, 14'700'000, 7'200'000, false, true);
+        const auto without = run_lead_model(3, 8 * kMillisecond, 14'700'000, 7'200'000, false, false);
+        std::cout << "lead model, cadence 3, a runtime that does not wait:" << describe(with) << '\n';
+        require(!with.ever_latched && with.lead == 0,
+            "lead model: never armed on a runtime that does not wait" + describe(with));
+        require(with.late_periods == without.late_periods &&
+                with.early_periods == without.early_periods &&
+                with.late_lateness_ms == without.late_lateness_ms,
+            "lead model: nothing changes on a runtime that does not wait" + describe(with));
+        require(near(with.late_periods, 3.0, 0.02), "lead model: three periods there" + describe(with));
+    }
+    // Cadence 2 on the waiting runtime, a frame that fits two periods with
+    // room (12 ms of rendering): about every other slot lost without the
+    // lead - the fixed 2X flight's 36 fps was 2.5 periods a frame - and two
+    // periods a frame with it.
+    {
+        const auto without = run_lead_model(2, 7 * kMillisecond, 12 * kMillisecond, 7'200'000, true, false);
+        const auto with = run_lead_model(2, 7 * kMillisecond, 12 * kMillisecond, 7'200'000, true, true);
+        std::cout << "lead model, cadence 2, a runtime that waits, no lead:" << describe(without) << '\n';
+        std::cout << "lead model, cadence 2, a runtime that waits, with the lead:" << describe(with) << '\n';
+        require(without.late_periods > 2.4, "lead model: 2X loses slots without the lead" + describe(without));
+        require(near(with.late_periods, 2.0, 0.02) && with.late_lost == 0,
+            "lead model: 2X holds two periods a frame with it" + describe(with));
+    }
+    // The scene gets lighter (rendering 14.7 -> 3 ms after 8 s): the lead
+    // comes down and the frame stays at three periods with no slot lost.
+    {
+        const auto r = run_lead_model(3, 8 * kMillisecond, 14'700'000, 7'200'000, true, true,
+            8 * kSecond, 3 * kMillisecond);
+        std::cout << "lead model, cadence 3, lighter after 8 s:" << describe(r) << '\n';
+        require(r.lead < 9 * kMillisecond, "lead model: the lead comes down with the load" + describe(r));
+        require(near(r.late_periods, 3.0, 0.02) && r.late_lost == 0,
+            "lead model: and the cadence holds" + describe(r));
+    }
+}
