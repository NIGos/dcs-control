+// DCS Control (0054): a run of pairs through one synthesizer (FidelityFX,
+// still frames), the frames' alpha_valid and generation as given; per pair
+// the current frame's re-adds with coverage and the latches.
+struct HudAlphaPair {
+    std::uint64_t alpha_readds{};
+    std::uint64_t latched{};
+    std::uint64_t views{};
+};
+
+std::vector<HudAlphaPair> hud_alpha_run(Gpu& gpu, const HudScene& scene, const std::vector<std::uint8_t>& frame_bytes,
+    const std::vector<bool>& valid, const std::vector<std::uint32_t>& generation) {
+    const DXGI_FORMAT format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    const auto image = [&] {
+        return hud_texture(gpu, kHudSynthWidth, kHudSynthHeight, format, 2, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,
+            D3D12_HEAP_FLAG_NONE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    };
+    std::array<ComPtr<ID3D12Resource>, 2> sources{image(), image()};
+    auto current = image();
+    auto synthetic = image();
+    hud_upload(gpu, sources[0].Get(), frame_bytes, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    hud_upload(gpu, sources[1].Get(), frame_bytes, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 1> current_out{current.Get()};
+    std::array<ID3D12Resource*, 1> synthetic_out{synthetic.Get()};
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(gpu.device.Get(), gpu.queue.Get(), input, D3D12_RESOURCE_STATE_RENDER_TARGET),
+        "hud alpha run: history");
+    xrfg::D3D12NvidiaOpticalFlowOptions flow{};
+    flow.cockpit_mask = true;
+    flow.hud_symbology = true;
+    std::vector<HudAlphaPair> pairs;
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(gpu.device.Get(), gpu.queue.Get(), history, current_out, synthetic_out, format,
+                        D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::fidelity_fx, flow),
+        "hud alpha run: initialize");
+    const auto views = hud_synthesis_views();
+    const auto mask_frame = [&](std::size_t number) {
+        auto frame = hud_synthesis_frame(gpu, scene, true, static_cast<std::uint64_t>(number) + 1U, valid[number]);
+        frame->hud_symbology.generation = generation[number];
+        frame->display_time = 7000 + static_cast<std::int64_t>(number);
+        return frame;
+    };
+    xrfg::D3D12HistoryCaptureTicket ticket{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ticket), "hud alpha run: capture 0");
+    require_hresult(history->commit(ticket), "hud alpha run: commit 0");
+    synth.set_cockpit_mask(mask_frame(0));
+    require_hresult(synth.submit_prime(ticket, views, 0, &output), "hud alpha run: prime");
+    hud_run(gpu, [](ID3D12GraphicsCommandList*) {});
+    for (std::size_t number = 1; number < valid.size(); ++number) {
+        require_hresult(history->capture(static_cast<std::uint32_t>(number % 2), &ticket), "hud alpha run: capture");
+        require_hresult(history->commit(ticket), "hud alpha run: commit");
+        auto frame = mask_frame(number);
+        synth.set_cockpit_mask(frame);
+        require_hresult(
+            synth.submit_pair(ticket, views, views, 0, 0, &output, std::nullopt, {}, false, 0.5F, std::nullopt),
+            "hud alpha run: pair");
+        hud_run(gpu, [](ID3D12GraphicsCommandList*) {});
+        HudAlphaPair pair;
+        pair.alpha_readds = frame->counters->hud_alpha_readds.load();
+        pair.latched = frame->counters->hud_alpha_latched.load();
+        pair.views = frame->counters->hud_views.load();
+        pairs.push_back(pair);
+    }
+    require_hresult(synth.wait_for_idle(), "hud alpha run: idle");
+    return pairs;
+}
