+// DCS Control (0054): the coverage alpha of a re-add, pair-wide and latched.
+// The first live run (R96) saw the producer's alpha_valid (each frame's
+// emission_flags::alpha_valid, D3D12HudSymbology::alpha_valid) flip 44 times
+// under yaw. A view is re-composed with coverage only when BOTH frames of the
+// pair have it valid; once the view has seen it go from valid to invalid
+// within a symbology generation it stays additive for the rest of that
+// generation (latched; a new generation starts over). Between the two the
+// synthetic differs by the composite's own a (C - W'), so the latch keeps
+// that step to one per generation instead of one per flip.
+class HudAlphaLatch final {
+public:
+    static constexpr std::uint32_t kViews = 8;
+    struct Decision {
+        bool alpha{};       // re-compose this pair's view with coverage
+        bool latched_now{}; // this pair latched the view (logged once: cockpit_mask result=23)
+    };
+    // View `view` (the eye of the stereo image) of a pair whose current
+    // frame has symbology generation `generation`: the previous and current
+    // frames' alpha_valid. Call once per pair and view, in pair order.
+    [[nodiscard]] Decision decide(
+        std::uint32_t generation, std::uint32_t view, bool previous_valid, bool current_valid) noexcept;
+    [[nodiscard]] bool latched(std::uint32_t view) const noexcept {
+        return view < kViews && latched_[view];
+    }
+    [[nodiscard]] std::uint32_t generation() const noexcept {
+        return generation_;
+    }
+
+private:
+    bool started_{};
+    std::uint32_t generation_{};
+    // The newer frame of the view's last pair: 0 none yet, 1 invalid, 2 valid.
+    std::array<std::uint8_t, kViews> last_{};
+    std::array<bool, kViews> latched_{};
+};
+
+// DCS Control (0054): the HUD symbology's GPU allocations, each logged once
+// when it is made (cockpit_mask result=22, the live run's VRAM accounting).
+enum class HudAllocationKind : std::uint32_t {
+    clean_copy = 1,           // a synthesizer's real frame with its symbology taken out (two per synthesizer)
+    symbology_copy = 2,       // the consumer's private copy of a frame's emission atlas (RGBA16F)
+    symbology_class_copy = 3, // and of its class atlas (R8_UINT)
+    producer_atlas = 4,       // a producer's emission atlas opened (an NT handle import, its size counted)
+    producer_class_atlas = 5, // a producer's class atlas opened
+    capture_readback = 6,     // 0053's developer capture read-back (a readback heap: not dedicated VRAM)
+};
+
+// Who holds an allocation: the consumer (the session's), or synthesizer n
+// (one per swapchain, numbered from 1 in the order they first make one).
+inline constexpr std::uint32_t kHudAllocationOwnerConsumer = 0;
+
+struct HudAllocation {
+    HudAllocationKind kind{};
+    DXGI_FORMAT format{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+    std::uint32_t array_size{1};
+    // How many of this kind the owner holds with this one.
+    std::uint32_t count{};
+    std::uint32_t owner{};
+    // This one's size in bytes (GetResourceAllocationInfo).
+    std::uint64_t bytes{};
+};
+
+// result=22's fields: a= kind (0-7), DXGI format (8-15), count (16-31),
+// array size (32-47), owner (48-55); b= width (0-31), height (32-63); c= this
+// one's bytes (0-39) and the owner's HUD bytes with it, MiB (40-63).
+struct HudAllocationRecord {
+    std::uint64_t a{};
+    std::uint64_t b{};
+    std::uint64_t c{};
+};
+[[nodiscard]] HudAllocationRecord hud_allocation_record(
+    const HudAllocation& allocation, std::uint64_t owner_total_bytes) noexcept;
+[[nodiscard]] HudAllocation hud_allocation_from_record(
+    const HudAllocationRecord& record, std::uint64_t* owner_total_mib = nullptr) noexcept;
+// A texture's size: the device's (GetResourceAllocationInfo) when given one,
+// else bytes per texel x texels, rounded up to 64 KiB.
+[[nodiscard]] std::uint64_t hud_texture_bytes(ID3D12Device* device, std::uint32_t width, std::uint32_t height,
+    std::uint32_t array_size, DXGI_FORMAT format, D3D12_RESOURCE_FLAGS flags = D3D12_RESOURCE_FLAG_NONE) noexcept;
+
 }  // namespace xrfg
