+// DCS Control (0054) ---------------------------------------------------------
+
+HudAlphaLatch::Decision HudAlphaLatch::decide(
+    std::uint32_t generation, std::uint32_t view, bool previous_valid, bool current_valid) noexcept {
+    if (!started_ || generation != generation_) {
+        started_ = true;
+        generation_ = generation;
+        last_.fill(0);
+        latched_.fill(false);
+    }
+    Decision decision{};
+    if (view >= kViews) {
+        return decision;
+    }
+    // valid -> invalid anywhere in the view's sequence of frames: the newer
+    // frame of its last pair, this pair's older, this pair's newer.
+    const bool fell = (last_[view] == 2U && !previous_valid) || (previous_valid && !current_valid);
+    last_[view] = current_valid ? 2U : 1U;
+    if (fell && !latched_[view]) {
+        latched_[view] = true;
+        decision.latched_now = true;
+    }
+    decision.alpha = !latched_[view] && previous_valid && current_valid;
+    return decision;
+}
+
+HudAllocationRecord hud_allocation_record(const HudAllocation& allocation, std::uint64_t owner_total_bytes) noexcept {
+    const auto bits = [](std::uint64_t value, std::uint64_t width) {
+        const std::uint64_t limit = (std::uint64_t{1} << width) - 1U;
+        return std::min(value, limit);
+    };
+    HudAllocationRecord record{};
+    record.a = bits(static_cast<std::uint32_t>(allocation.kind), 8) |
+        (bits(static_cast<std::uint32_t>(allocation.format), 8) << 8U) | (bits(allocation.count, 16) << 16U) |
+        (bits(allocation.array_size, 16) << 32U) | (bits(allocation.owner, 8) << 48U);
+    record.b = static_cast<std::uint64_t>(allocation.width) | (static_cast<std::uint64_t>(allocation.height) << 32U);
+    const std::uint64_t mib = (owner_total_bytes + (std::uint64_t{1} << 20U) - 1U) >> 20U;
+    record.c = bits(allocation.bytes, 40) | (bits(mib, 24) << 40U);
+    return record;
+}
+
+HudAllocation hud_allocation_from_record(const HudAllocationRecord& record, std::uint64_t* owner_total_mib) noexcept {
+    HudAllocation allocation{};
+    allocation.kind = static_cast<HudAllocationKind>(record.a & 0xffU);
+    allocation.format = static_cast<DXGI_FORMAT>((record.a >> 8U) & 0xffU);
+    allocation.count = static_cast<std::uint32_t>((record.a >> 16U) & 0xffffU);
+    allocation.array_size = static_cast<std::uint32_t>((record.a >> 32U) & 0xffffU);
+    allocation.owner = static_cast<std::uint32_t>((record.a >> 48U) & 0xffU);
+    allocation.width = static_cast<std::uint32_t>(record.b & 0xffffffffU);
+    allocation.height = static_cast<std::uint32_t>(record.b >> 32U);
+    allocation.bytes = record.c & ((std::uint64_t{1} << 40U) - 1U);
+    if (owner_total_mib != nullptr) {
+        *owner_total_mib = record.c >> 40U;
+    }
+    return allocation;
+}
+
+std::uint64_t hud_texture_bytes(ID3D12Device* device, std::uint32_t width, std::uint32_t height,
+    std::uint32_t array_size, DXGI_FORMAT format, D3D12_RESOURCE_FLAGS flags) noexcept {
+    if (device != nullptr) {
+        D3D12_RESOURCE_DESC description{};
+        description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        description.Width = width;
+        description.Height = height;
+        description.DepthOrArraySize = static_cast<UINT16>(std::max<std::uint32_t>(array_size, 1U));
+        description.MipLevels = 1;
+        description.Format = format;
+        description.SampleDesc.Count = 1;
+        description.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+        description.Flags = flags;
+        const D3D12_RESOURCE_ALLOCATION_INFO info = device->GetResourceAllocationInfo(0, 1, &description);
+        if (info.SizeInBytes != 0 && info.SizeInBytes != UINT64_MAX) {
+            return info.SizeInBytes;
+        }
+    }
+    std::uint64_t texel = 4;
+    switch (format) {
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS:
+        texel = 8;
+        break;
+    case DXGI_FORMAT_R8_UINT:
+    case DXGI_FORMAT_R8_TYPELESS:
+    case DXGI_FORMAT_R8_UNORM:
+        texel = 1;
+        break;
+    default:
+        break;
+    }
+    const std::uint64_t raw = texel * width * height * std::max<std::uint32_t>(array_size, 1U);
+    constexpr std::uint64_t kAlignment = 64U * 1024U;
+    return (raw + kAlignment - 1U) / kAlignment * kAlignment;
+}
+
 }  // namespace xrfg
