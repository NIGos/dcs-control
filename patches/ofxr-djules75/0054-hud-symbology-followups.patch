+// DCS Control (0054): the coverage alpha, pair-wide and latched
+// (HudAlphaLatch). One texel's synthetic per pair, as the re-add composes it
+// (dcsvr_symbology::recomposite with the decision's a, else the additive
+// W' + E): with the latch it changes once per generation, by the composite's
+// own a (C - W'); without it (0049: each frame's own flag) at every flip.
+void test_hud_alpha_latch() {
+    {
+        xrfg::HudAlphaLatch latch;
+        // Pair-wide: one frame of the pair without a valid alpha, additive.
+        require(!latch.decide(1, 0, false, true).alpha && !latch.latched(0),
+            "hud alpha: invalid then valid is additive, not a fall");
+        require(latch.decide(1, 0, true, true).alpha, "hud alpha: both frames valid composes with coverage");
+        const auto fall = latch.decide(1, 0, true, false);
+        require(!fall.alpha && fall.latched_now && latch.latched(0), "hud alpha: valid then invalid latches the view");
+        require(!latch.decide(1, 0, false, true).alpha && !latch.decide(1, 0, true, true).alpha &&
+                !latch.decide(1, 0, true, true).latched_now,
+            "hud alpha: latched, additive for the rest of the generation (logged once)");
+        require(latch.decide(1, 1, true, true).alpha && !latch.latched(1), "hud alpha: the other eye is not latched");
+        require(latch.decide(2, 0, true, true).alpha && !latch.latched(0) && latch.generation() == 2,
+            "hud alpha: a new generation starts over");
+        // A fall seen across pairs (the last pair's newer frame valid, this
+        // pair's older one invalid: a skipped frame).
+        static_cast<void>(latch.decide(2, 1, true, true));
+        require(latch.decide(2, 1, false, false).latched_now, "hud alpha: a fall between pairs latches too");
+        require(!latch.decide(2, 7, false, false).alpha && !latch.decide(2, 8, true, true).alpha,
+            "hud alpha: views past kViews are additive");
+    }
+    // The flicker of R96: alpha_valid per frame, generation 3 then 4.
+    const std::vector<bool> valid{true, true, true, false, true, false, true, true, false, true, true, true};
+    const std::vector<std::uint32_t> generation{3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 4, 4};
+    const csy::Rgb world{0.30F, 0.42F, 0.25F};     // W', the synthetic's world under the symbol
+    const csy::Rgb clean{0.10F, 0.15F, 0.08F};     // C, the clean frame at the symbol's source
+    const csy::Rgb emission{0.40F, 0.55F, 0.12F};  // E
+    const float coverage = 0.8F;
+    const auto composite = [&](bool alpha) {
+        return alpha ? csy::recomposite(world, emission, coverage, clean)
+                     : csy::Rgb{world.r + emission.r, world.g + emission.g, world.b + emission.b};
+    };
+    const float step = coverage * std::max({std::abs(clean.r - world.r), std::abs(clean.g - world.g),
+                                      std::abs(clean.b - world.b)});
+    xrfg::HudAlphaLatch latch;
+    int changes = 0, changes_0049 = 0, latches = 0;
+    float largest = 0.0F;
+    csy::Rgb last{}, last_0049{};
+    for (std::size_t frame = 1; frame < valid.size(); ++frame) {
+        const auto decision = latch.decide(generation[frame], 0, valid[frame - 1], valid[frame]);
+        latches += decision.latched_now ? 1 : 0;
+        const csy::Rgb out = composite(decision.alpha);
+        const csy::Rgb out_0049 = composite(valid[frame]); // 0049: the re-added frame's own flag
+        if (frame > 1) {
+            const float jump = std::max({std::abs(out.r - last.r), std::abs(out.g - last.g), std::abs(out.b - last.b)});
+            largest = std::max(largest, jump);
+            changes += jump > 0.0F ? 1 : 0;
+            changes_0049 += (out_0049.r != last_0049.r || out_0049.g != last_0049.g || out_0049.b != last_0049.b) ? 1 : 0;
+        }
+        last = out;
+        last_0049 = out_0049;
+    }
+    std::cout << "hud alpha: R96-like flicker over 11 pairs, 2 generations: the synthetic changes " << changes
+              << " time(s) with the latch (0049: " << changes_0049 << "), the largest step " << largest
+              << " = a |C - W'| " << step << "\n";
+    // Generation 3: alpha, then the fall latches (one step); generation 4:
+    // alpha again (one step back).
+    require(latches == 1 && changes == 2 && changes_0049 >= 6, "hud alpha: one change per generation, not per flip");
+    require(std::abs(largest - step) < 1.0e-5F, "hud alpha: no step beyond the composite difference");
+}
