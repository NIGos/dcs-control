+            "hud alpha run: pair " + std::to_string(index + 1) + " composed " +
+                std::to_string(pairs[index].alpha_readds) + " view(s) with coverage, latched " +
+                std::to_string(pairs[index].latched) + " (expected " + std::to_string(alpha_expected[index]) + ", " +
+                std::to_string(latch_expected[index]) + ")");
+    }
+    std::cout << "hud alpha run: coverage on both eyes until the fall, additive (latched once per eye) for the rest "
+                 "of generation 7 even with both frames valid again, coverage again in generation 8\n";
+}
+
+// DCS Control (0054): a view with collimated symbology only (the producer
+// dropping the helmet class on overflow, HUD-only, instead of present = 0):
+// 0049 reads the class plane per texel, so it is a view like any other. The
+// removal takes out class 1 and nothing else, the re-add gives the frame
+// back, with and without coverage; and nothing in 0049's view checks needs a
+// helmet class (emission_flags without class_head_locked).
+void test_hud_class1_only(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 64, height = 48;
+    HudSymbolModel model;
+    const HudScene scene = hud_symbol_scene(width, height, {8, 6, 40, 30}, hud_noise_background, model,
+        [](UINT x, UINT y) { return static_cast<std::uint8_t>((x * 3U + y) % 5U < 2U ? 1U : 0U); });
+    std::size_t collimated = 0;
+    for (const std::uint8_t klass : model.pixel_class) {
+        require(klass == 0 || klass == 1, "hud class 1 only: the scene has no other class");
+        collimated += klass == 1 ? 1U : 0U;
+    }
+    require(collimated > 400, "hud class 1 only: symbols in the window");
+    HudTextures t = hud_textures(gpu, scene);
+    hud_record_removal(gpu, passes, scene, t);
+    const auto clean = hud_readback(gpu, t.clean.Get(), width * 4U);
+    float worst_linear = 0.0F;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * width + x;
+            if (model.pixel_class[at] == 1) {
+                const auto c = hud_noise_background(x, y);
+                for (int ch = 0; ch < 3; ++ch) {
+                    worst_linear = std::max(worst_linear, std::abs(hud_decode(clean[at * 4U + ch]) - hud_decode(c[ch])));
+                }
+            } else {
+                require(std::memcmp(&clean[at * 4U], &scene.frame[at * 4U], 4) == 0,
+                    "hud class 1 only: a pixel without symbology changed");
+            }
+        }
+    }
+    require(worst_linear < 0.006F, "hud class 1 only: the background under the symbols");
+    for (const bool alpha : {false, true}) {
+        hud_upload(gpu, t.destination.Get(), clean, width * 4U);
+        hud_record_readd(gpu, passes, scene, t, xrfg::HudRotation{}, alpha);
+        const int worst = hud_max_difference(hud_readback(gpu, t.destination.Get(), width * 4U), scene.frame);
+        require(worst <= 1, "hud class 1 only: removal then re-add does not give the frame back within a code");
+    }
+    xrfg::D3D12HudSymbology symbology{};
+    symbology.emission_flags = csy::emission_flags::hdr_overlay | csy::emission_flags::class_collimated |
+        csy::emission_flags::common_excluded;
+    symbology.views[0] = scene.eye.periphery;
+    symbology.eyes[0].layout = true;
+    symbology.eyes[0].focus_rect = scene.eye.focus_rect;
+    require(symbology.eye_present(0) && !symbology.eye_present(1),
+        "hud class 1 only: the view is present without a helmet class");
+    std::cout << "hud symbology: a class-1-only view (HUD only, no helmet class) cleaned and re-added within a code, "
+                 "worst linear "
+              << worst_linear << "\n";
+}
