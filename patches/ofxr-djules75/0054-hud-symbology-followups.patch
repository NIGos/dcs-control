+// DCS Control (0054): the allocation record (cockpit_mask result=22). The
+// consumer against the fake producer, frames held as a synthesizer holds
+// them (its pair: the previous and the current), the records captured: the
+// private copies made are the frames held at once, not the ring's six; a
+// retired generation frees them. Then the totals at a 2 x 2700^2 stereo,
+// four-view config (Quad Views' periphery and focus per eye, the producer's
+// default atlas 2560 x 1024), before (0049) and after, from the records.
+void test_hud_allocations(Gpu& gpu) {
+    {
+        xrfg::HudAllocation allocation{};
+        allocation.kind = xrfg::HudAllocationKind::symbology_class_copy;
+        allocation.format = DXGI_FORMAT_R8_UINT;
+        allocation.width = 2560;
+        allocation.height = 1024;
+        allocation.array_size = 1;
+        allocation.count = 3;
+        allocation.owner = 2;
+        allocation.bytes = 2621440;
+        std::uint64_t total = 0;
+        const auto back =
+            xrfg::hud_allocation_from_record(xrfg::hud_allocation_record(allocation, 200ULL << 20U), &total);
+        require(back.kind == allocation.kind && back.format == allocation.format && back.width == 2560 &&
+                back.height == 1024 && back.array_size == 1 && back.count == 3 && back.owner == 2 &&
+                back.bytes == 2621440 && total == 200,
+            "hud allocations: the record round-trips");
+    }
+    struct Logged {
+        std::uint64_t a, b, c;
+    };
+    std::vector<Logged> records;
+    xrfg::CockpitMaskConsumerStats after_run{};
+    {
+        const std::wstring suffix = test_suffix(L"hudalloc");
+        FakeProducer producer(gpu, suffix);
+        FakeSymbologyProducer hud(gpu, suffix, producer);
+        auto options = test_options(suffix);
+        options.hud_symbology = true;
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(),
+                            [&records](std::int64_t code, std::uint64_t a, std::uint64_t b, std::uint64_t c) {
+                                if (code == 22) {
+                                    records.push_back({a, b, c});
+                                }
+                            },
+                            options),
+            "hud allocations: consumer initialize");
+        std::vector<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>> held;
+        for (std::int64_t time = 14000; time < 14000 + 20; ++time) {
+            const std::uint64_t seq = producer.commit(time, 255);
+            hud.commit(producer);
+            auto frame = consumer.acquire(time);
+            require(frame != nullptr && frame->hud, "hud allocations: every frame paired with its symbology");
+            producer.signal(seq);
+            gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+            Sleep(2); // the copy queue's done signal, just behind the copy (an entry is free after it)
+            held.push_back(std::move(frame));
+            if (held.size() > 2) {
+                held.erase(held.begin());
+            }
+        }
+        after_run = consumer.stats();
+        // The generation retired (export off with another generation): the
+        // copies nobody holds are freed, the held ones as their entries go.
+        held.clear();
+        hud.header_.flags &= ~csy::header_flags::active;
+        hud.header_.generation += 1;
+        hud.publish();
+        for (std::int64_t time = 14100; time < 14100 + 8; ++time) {
+            const std::uint64_t seq = producer.commit(time, 255);
+            auto frame = consumer.acquire(time);
+            require(frame != nullptr && !frame->hud, "hud allocations: no symbology once retired");
+            producer.signal(seq);
+            gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+        }
+        require(consumer.stats().hud_copies == 0 && consumer.stats().hud_copies_freed == after_run.hud_copies_made,
+            "hud allocations: a retired generation frees the private copies");
+    }
+    std::size_t emission_copies = 0, class_copies = 0, imports = 0;
+    for (const Logged& logged : records) {
+        const auto allocation = xrfg::hud_allocation_from_record({logged.a, logged.b, logged.c});
+        emission_copies += allocation.kind == xrfg::HudAllocationKind::symbology_copy ? 1U : 0U;
+        class_copies += allocation.kind == xrfg::HudAllocationKind::symbology_class_copy ? 1U : 0U;
+        imports += allocation.kind == xrfg::HudAllocationKind::producer_atlas ||
+                allocation.kind == xrfg::HudAllocationKind::producer_class_atlas
+            ? 1U
+            : 0U;
+        require(allocation.width == kHudAtlasWidth && allocation.height == kHudAtlasHeight,
+            "hud allocations: every record at the producer's atlas size");
+    }
+    std::cout << "hud allocations: 20 frames, two held at a time: " << after_run.hud_copies_made
+              << " private copies made, " << after_run.hud_copies_reused << " taken over (0049: one per ring entry, "
+              << 6 << ")\n";
+    // Three: the two held and the one being copied (a fourth only if the copy
+    // queue's done signal lagged behind the frame's own fence).
+    require(after_run.hud_copies_made >= 3 && after_run.hud_copies_made <= 4 &&
+            emission_copies == after_run.hud_copies_made && class_copies == after_run.hud_copies_made &&
+            imports == 2,
+        "hud allocations: the private copies are the frames held at once, each logged once; the imports");
+
+    // The config's totals, from the records the code writes (each kind's
+    // record built as the code builds it, sizes from the device).
+    constexpr std::uint32_t eye_side = 2700;
+    constexpr std::uint32_t synthesizers = 2; // Quad Views: a swapchain per eye
+    constexpr std::uint32_t ring_size = 6;    // CockpitMaskConsumerOptions::ring_size
+    const std::uint32_t copies_after = static_cast<std::uint32_t>(after_run.hud_copies_made);
+    ID3D12Device* device = gpu.device.Get();
+    const auto record_total = [&](xrfg::HudAllocationKind kind, DXGI_FORMAT format, std::uint32_t w,
+                                  std::uint32_t h, std::uint32_t count, D3D12_RESOURCE_FLAGS flags) {
+        xrfg::HudAllocation allocation{};
+        allocation.kind = kind;
+        allocation.format = format;
+        allocation.width = w;
+        allocation.height = h;
+        allocation.count = count;
+        allocation.bytes = xrfg::hud_texture_bytes(device, w, h, 1U, format, flags);
+        const auto back = xrfg::hud_allocation_from_record(xrfg::hud_allocation_record(allocation, 0));
+        return back.bytes * back.count;
+    };
+    const auto mb = [](std::uint64_t bytes) {
+        const std::uint64_t tenths = (bytes + 50000U) / 100000U;
+        return std::to_string(tenths / 10U) + "." + std::to_string(tenths % 10U);
+    };
+    const std::uint64_t clean = record_total(xrfg::HudAllocationKind::clean_copy, DXGI_FORMAT_R8G8B8A8_TYPELESS,
+        eye_side, eye_side, 2U * synthesizers, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET);
+    const auto copies = [&](std::uint32_t count) {
+        return record_total(xrfg::HudAllocationKind::symbology_copy, DXGI_FORMAT_R16G16B16A16_FLOAT,
+                   csy::default_atlas_w, csy::default_atlas_h, count, D3D12_RESOURCE_FLAG_NONE) +
+            record_total(xrfg::HudAllocationKind::symbology_class_copy, DXGI_FORMAT_R8_UINT, csy::default_atlas_w,
+                csy::default_atlas_h, count, D3D12_RESOURCE_FLAG_NONE);
+    };
+    const std::uint64_t imported = copies(csy::slot_count);
+    const std::uint64_t before = clean + copies(ring_size);
+    const std::uint64_t after = clean + copies(copies_after);
+    std::cout << "hud allocations at 2 x 2700^2 stereo, 4 views (atlas 2560 x 1024): clean copies " << mb(clean)
+              << " MB (2 per synthesizer x " << synthesizers << "), private copies " << mb(copies(ring_size))
+              << " MB before (ring " << ring_size << ") -> " << mb(copies(copies_after)) << " MB after ("
+              << copies_after << " held), OFXR total " << mb(before) << " -> " << mb(after)
+              << " MB; plus the producer atlases' imports " << mb(imported)
+              << " MB counted in dedicated usage per generation opened\n";
+    require(after < before && before - after == copies(ring_size - copies_after),
+        "hud allocations: the private copies are the frames held, not the ring's");
+}
