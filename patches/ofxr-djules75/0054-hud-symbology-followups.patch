+    };
+    const HudScene still = scene_at(0);
+    const HudScene moved = scene_at(8);
+    const auto frame_a = stereo(still.frame);
+    const auto frame_b = stereo(moved.frame);
+    // Pair-wide: with the world moving under the symbol the coverage
+    // composite differs from the additive one; a pair with one frame's alpha
+    // invalid (either one) is the additive pair, bit for bit.
