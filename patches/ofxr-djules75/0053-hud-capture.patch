+    std::array<ComPtr<ID3D12Resource>, 2> sources{image(), image()};
+    auto current = image();
+    auto synthetic = image();
+    hud_upload(gpu, sources[0].Get(), frame_bytes, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    hud_upload(gpu, sources[1].Get(), frame_bytes, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
