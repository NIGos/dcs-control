+void test_hud_capture(Gpu& gpu) {
+    namespace fs = std::filesystem;
+    // The pure parts: the fallback square, the union, a header's windows.
+    const xrfg::HudImageRect square = xrfg::hud_capture_fallback_region(2000, 1800);
+    const xrfg::HudImageRect clamped = xrfg::hud_capture_fallback_region(800, 600);
+    require(square.x == 488 && square.y == 388 && square.width == 1024 && square.height == 1024 &&
+            clamped.x == 0 && clamped.y == 0 && clamped.width == 800 && clamped.height == 600,
+        "hud capture: the centred 1024 square, clamped to the image");
+    const xrfg::HudImageRect both = xrfg::hud_capture_union({10, 20, 30, 40}, {5, 50, 10, 20});
+    const xrfg::HudImageRect one = xrfg::hud_capture_union({}, {5, 50, 10, 20});
+    require(both.x == 5 && both.y == 20 && both.width == 35 && both.height == 50 && one.x == 5 && one.width == 10,
+        "hud capture: the union of two regions");
+
+    // The OFF arm's window: the block's header alone, no texture opened (its
+    // handles are bogus), no heartbeat stored.
+    const std::wstring block_name = std::wstring(csy::block_name) + test_suffix(L"hudcap");
+    {
+        HudHeaderOnlyBlock block(block_name, 5001);
+        xrfg::HudSymbologyWindowReader reader(block_name);
+        const auto exact = reader.read(5001);
+        xrfg::HudImageRect region{};
+        require(exact.block && exact.source == xrfg::HudCaptureSource::block_frame && exact.seq == 41 &&
+                exact.symbology.views[0].present && exact.symbology.views[1].present &&
+                !exact.symbology.views[2].present &&
+                xrfg::hud_capture_eye_region(exact.symbology, 0, kHudSynthWidth, kHudSynthHeight, region) &&
+                region.x == 30 && region.y == 22 && region.width == 68 && region.height == 52,
+            "hud capture: the block's slot of this frame gives 0049's window (2 px around)");
+        const auto newest = reader.read(9999);
+        require(newest.block && newest.source == xrfg::HudCaptureSource::block_newest && newest.seq == 41,
+            "hud capture: no slot of this frame: the newest one");
+        require(block.reader_heartbeat() == 0, "hud capture: the read-only reader stored a heartbeat");
+        xrfg::HudSymbologyWindowReader missing(block_name + L"-none");
+        require(!missing.read(5001).block, "hud capture: no block is not a block");
+    }
+
+    HudScene scene;
+    scene.width = kHudSynthWidth;
+    scene.height = kHudSynthHeight;
+    scene.atlas_width = kHudSynthWidth;
+    scene.atlas_height = kHudSynthHeight;
+    scene.emission.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 8U, 0);
+    scene.classes.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight, 0);
+    std::vector<std::uint8_t> eye_bytes(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 4U);
+    for (std::size_t at = 0; at < eye_bytes.size(); ++at) {
+        eye_bytes[at] = static_cast<std::uint8_t>((at * 37U + at / 512U) % 251U);
+    }
+    std::vector<std::uint8_t> frame_bytes(eye_bytes);
+    frame_bytes.insert(frame_bytes.end(), eye_bytes.begin(), eye_bytes.end());
+    const std::string pid = std::to_string(GetCurrentProcessId());
+    const fs::path root = fs::temp_directory_path() / ("ofxr-hud-capture-" + pid);
+    fs::remove_all(root);
+    const auto options_for = [&](const char* name, std::uint32_t limit, const std::wstring& block) {
+        xrfg::D3D12HudCaptureOptions options{};
+        options.directory = root / name;
+        fs::create_directories(options.directory);
+        options.limit = limit;
+        options.interval_ms = 0;
+        options.block_name = block;
+        options.budget = std::make_shared<xrfg::D3D12HudCaptureBudget>();
+        return options;
+    };
+    const auto bmp_size = [](std::uint32_t width, std::uint32_t height) {
+        return static_cast<std::uintmax_t>(54U + ((width * 3U + 3U) & ~3U) * height);
+    };
+    // N sets per eye: each three BMPs of `width` x `height` and an info file.
+    const auto check_sets = [&](const fs::path& directory, const char* sym, std::uint32_t width,
+                                std::uint32_t height, const char* source, const char* what) {
+        const auto files = hud_capture_files(directory);
+        require(files.size() == 2U * 2U * 4U, std::string("hud capture: ") + what + ": " +
+                std::to_string(files.size()) + " files, not 2 sets of 4 per eye");
+        for (int eye = 0; eye < 2; ++eye) {
+            for (int k = 1; k <= 2; ++k) {
+                const std::string prefix = "hud-" + pid + "-" + std::to_string(eye) + "-";
+                const std::string tail = "-k" + std::to_string(k) + "of2-" + sym;
+                std::string stem;
+                for (const auto& entry : files) {
+                    const std::string& name = entry.first;
+                    const std::size_t at = name.find(tail);
+                    if (name.rfind(prefix, 0) == 0 && at != std::string::npos && name.find("-info.txt") != std::string::npos) {
+                        stem = name.substr(0, at + tail.size());
+                    }
+                }
+                require(!stem.empty(), std::string("hud capture: ") + what + ": no set " + prefix + "*" + tail);
+                const std::string display_time = stem.substr(prefix.size(), stem.size() - prefix.size() - tail.size());
+                require(std::stoll(display_time) > 5000, std::string("hud capture: ") + what + ": the display time");
+                for (const char* role : {"-synth.bmp", "-prev.bmp", "-cur.bmp"}) {
+                    const auto found = files.find(stem + role);
+                    require(found != files.end() && found->second == bmp_size(width, height),
+                        std::string("hud capture: ") + what + ": " + stem + role + " missing or not " +
+                            std::to_string(width) + "x" + std::to_string(height));
+                }
+                const std::string info = hud_capture_read_text(directory / (stem + "-info.txt"));
+                const std::string region_line = "w=" + std::to_string(width) + " h=" + std::to_string(height);
+                require(info.find("encoding: srgb8, as stored in the swapchain") != std::string::npos &&
+                        info.find(region_line) != std::string::npos && info.find(source) != std::string::npos &&
+                        info.find("R8G8B8A8_UNORM_SRGB") != std::string::npos &&
+                        info.find("k/N: " + std::to_string(k) + "/2") != std::string::npos,
+                    std::string("hud capture: ") + what + ": the info file\n" + info);
+            }
+        }
+        return files;
+    };
+
+    // hud_capture=2, hud_symbology on: two sets per eye, 0049's window from
+    // the pair's own symbology, 0049 cleaned and re-added the pair.
+    const auto on = options_for("on", 2, block_name + L"-none");
+    hud_capture_run(gpu, true, on, 6, frame_bytes, scene);
+    check_sets(on.directory, "sym1", 68, 52, "the pair's own symbology", "hud_symbology on");
+    {
+        const auto files = hud_capture_files(on.directory);
+        std::string info_name;
+        for (const auto& entry : files) {
+            const std::string& name = entry.first;
+            if (name.find("-0-") != std::string::npos && name.find("-k1of2-") != std::string::npos &&
+                name.find("-info.txt") != std::string::npos) {
+                info_name = name;
+            }
+        }
+        const std::string info = hud_capture_read_text(on.directory / info_name);
+        require(info.find("hud_0049: cleaned and re-added") != std::string::npos && info.find("x=30 y=22") != std::string::npos,
+            "hud capture: on: 0049's outcome and the region's origin\n" + info);
+        // The real frame's bytes as stored, unconverted: the cur BMP's first
+        // row (bottom-up, B G R) is eye 0's row 22 from x 30.
+        const std::string stem = info_name.substr(0, info_name.size() - std::string("-info.txt").size());
+        const std::string cur = hud_capture_read_text(on.directory / (stem + "-cur.bmp"));
+        const std::size_t row = (68U * 3U + 3U) & ~3U;
+        bool same = cur.size() == bmp_size(68, 52);
+        for (std::uint32_t x = 0; same && x < 68U; ++x) {
+            const std::size_t texel = (static_cast<std::size_t>(22) * kHudSynthWidth + 30U + x) * 4U;
+            const std::size_t at = 54U + row * 51U + x * 3U;
+            same = static_cast<std::uint8_t>(cur[at]) == eye_bytes[texel + 2U] &&
+                static_cast<std::uint8_t>(cur[at + 1U]) == eye_bytes[texel + 1U] &&
+                static_cast<std::uint8_t>(cur[at + 2U]) == eye_bytes[texel];
+        }
+        require(same, "hud capture: the cur BMP is not the stored bytes of the region");
+    }
+    // hud_capture=0: nothing at all.
+    const auto zero = options_for("zero", 0, block_name);
+    hud_capture_run(gpu, true, zero, 3, frame_bytes, scene);
+    require(hud_capture_files(zero.directory).empty(), "hud capture: hud_capture=0 wrote files");
+    // The OFF arm: hud_symbology off, the window from the block's header.
+    {
+        HudHeaderOnlyBlock block(block_name, 5001);
+        const auto off = options_for("off", 2, block_name);
+        hud_capture_run(gpu, false, off, 6, frame_bytes, scene);
+        check_sets(off.directory, "sym0", 68, 52, "the symbology block's", "hud_symbology off");
+        require(block.reader_heartbeat() == 0, "hud capture: the OFF arm stored a heartbeat");
+        const auto files = hud_capture_files(off.directory);
+        for (const auto& entry : files) {
+            const std::string& name = entry.first;
+            if (name.find("-k1of2-") != std::string::npos && name.find("-info.txt") != std::string::npos) {
+                const std::string info = hud_capture_read_text(off.directory / name);
+                require(info.find("slot of this frame") != std::string::npos &&
+                        info.find("hud_0049: off") != std::string::npos,
+                    "hud capture: off: the first set is the block's slot of its frame\n" + info);
+            }
+        }
+    }
+    // No block: the centred square, clamped to the 128 x 96 eye.
+    const auto fallback = options_for("fallback", 2, block_name + L"-none");
+    hud_capture_run(gpu, false, fallback, 6, frame_bytes, scene);
+    check_sets(fallback.directory, "sym0", kHudSynthWidth, kHudSynthHeight, "a centred 1024 square", "no block");
+    fs::remove_all(root);
+    std::cout << "hud capture: hud_capture=2 writes 2 sets per eye (3 BMPs and info), 0 nothing; the OFF arm's "
+                 "window from a header-only block (no texture, no heartbeat); the square without a block\n";
+}
