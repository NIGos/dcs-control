+// What the stored bytes are, from the format the swapchain is viewed in.
+[[nodiscard]] const char* hud_capture_encoding(DXGI_FORMAT view_format) noexcept {
+    switch (view_format) {
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
