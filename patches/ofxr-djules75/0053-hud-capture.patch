+bool hud_capture_eye_region(const D3D12HudSymbology& symbology, std::uint32_t eye, std::uint32_t width,
+    std::uint32_t height, HudImageRect& region) noexcept {
+    region = {};
+    if (!symbology.eye_present(eye) || width == 0 || height == 0) {
+        return false;
+    }
+    const D3D12_RECT rect = hud_pass_rect(hud_eye_input(symbology, eye), HudImageRect{0, 0, width, height});
+    if (rect.right <= rect.left || rect.bottom <= rect.top) {
+        return false;
+    }
+    region = {static_cast<std::uint32_t>(rect.left), static_cast<std::uint32_t>(rect.top),
+        static_cast<std::uint32_t>(rect.right - rect.left), static_cast<std::uint32_t>(rect.bottom - rect.top)};
+    return true;
+}
+
+HudImageRect hud_capture_fallback_region(std::uint32_t width, std::uint32_t height, std::uint32_t side) noexcept {
+    const std::uint32_t w = std::min(width, side);
+    const std::uint32_t h = std::min(height, side);
+    return {(width - w) / 2U, (height - h) / 2U, w, h};
+}
+
+HudImageRect hud_capture_union(const HudImageRect& a, const HudImageRect& b) noexcept {
+    if (a.width == 0 || a.height == 0) {
+        return b;
+    }
+    if (b.width == 0 || b.height == 0) {
+        return a;
+    }
+    const std::uint64_t right = std::max<std::uint64_t>(std::uint64_t(a.x) + a.width, std::uint64_t(b.x) + b.width);
+    const std::uint64_t bottom =
+        std::max<std::uint64_t>(std::uint64_t(a.y) + a.height, std::uint64_t(b.y) + b.height);
+    const std::uint32_t x = std::min(a.x, b.x);
+    const std::uint32_t y = std::min(a.y, b.y);
+    return {x, y, static_cast<std::uint32_t>(right - x), static_cast<std::uint32_t>(bottom - y)};
+}
+
+bool hud_symbology_from_header(const void* header_bytes, int slot, D3D12HudSymbology& out) noexcept {
+    namespace csy = dcsvr_symbology;
+    out = {};
+    if (header_bytes == nullptr || slot < 0 || slot >= csy::slot_count) {
+        return false;
+    }
+    const csy::Header& header = *static_cast<const csy::Header*>(header_bytes);
+    const csy::EmissionSlot& source = header.slot[slot];
+    const auto finite4 = [](const float (&values)[4]) {
+        return std::isfinite(values[0]) && std::isfinite(values[1]) && std::isfinite(values[2]) &&
+            std::isfinite(values[3]);
+    };
+    // As 0049's pair_hud: Quad Views' edge blend (its defaults where unknown),
+    // the focus rect from the tangents, else rectNorm.
+    const bool qv_known = (header.flags & csy::header_flags::qv_settings) != 0;
+    const float smoothing = qv_known ? header.qv.smoothenFocusViewEdges : 0.2F;
+    const float shape = qv_known ? header.qv.focusViewShape : 0.0F;
+    out.focus_smoothing = std::isfinite(smoothing) ? std::clamp(smoothing, 0.0F, 0.5F) : 0.2F;
+    out.focus_shape = std::isfinite(shape) ? std::clamp(shape, 0.0F, 16.0F) : 0.0F;
+    out.alpha_valid = (header.emissionFlags & csy::emission_flags::alpha_valid) != 0;
+    out.emission_flags = header.emissionFlags;
+    if (csy::layout_usable(header, slot)) {
+        for (int eye = 0; eye < csy::eye_count; ++eye) {
+            const csy::EyeFocus& focus = source.focus.eye[eye];
+            float rect[4]{};
+            bool ok = finite4(focus.eyeFovTan) && finite4(focus.focusFovTan) &&
+                csy::focus_rect(focus.eyeFovTan, focus.focusFovTan, rect) && finite4(rect);
+            if (!ok && finite4(focus.rectNorm) && focus.rectNorm[2] > focus.rectNorm[0] &&
+                focus.rectNorm[3] > focus.rectNorm[1]) {
+                std::copy(std::begin(focus.rectNorm), std::end(focus.rectNorm), std::begin(rect));
+                ok = true;
+            }
+            out.eyes[static_cast<std::size_t>(eye)].layout = ok;
+            out.eyes[static_cast<std::size_t>(eye)].focus_rect = {rect[0], rect[1], rect[2], rect[3]};
+        }
+    }
+    for (int view = 0; view < csy::max_views; ++view) {
+        const csy::EmissionView& m = source.view[view];
+        if (!csy::view_present(header, slot, view) ||
+            !cockpit_rect_inside(m.x, m.y, m.capW, m.capH, header.atlasW, header.atlasH) ||
+            !cockpit_rect_inside(m.winX, m.winY, m.winW, m.winH, m.outW, m.outH) || m.winW > m.capW ||
+            m.winH > m.capH) {
+            continue;
+        }
+        D3D12HudSymbologyView& entry = out.views[static_cast<std::size_t>(view)];
+        entry.present = true;
+        entry.x = m.x;
+        entry.y = m.y;
+        entry.out_width = m.outW;
+        entry.out_height = m.outH;
+        entry.window_x = m.winX;
+        entry.window_y = m.winY;
+        entry.window_width = m.winW;
+        entry.window_height = m.winH;
+        entry.flags = m.flags;
+    }
+    return out.eye_present(0) || out.eye_present(1);
+}
