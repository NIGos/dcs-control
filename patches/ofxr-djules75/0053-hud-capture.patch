+        "hud capture: history");
+    xrfg::D3D12NvidiaOpticalFlowOptions flow{};
+    flow.cockpit_mask = true;
+    flow.hud_symbology = key;
+    {
+        xrfg::D3D12FrameSynthesizer synth;
+        require_hresult(synth.initialize(gpu.device.Get(), gpu.queue.Get(), history, current_out, synthetic_out,
+                            format, D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::fidelity_fx,
+                            flow),
+            "hud capture: initialize");
+        require_hresult(synth.set_hud_capture(options), "hud capture: set_hud_capture");
+        const auto views = hud_synthesis_views();
+        const auto mask_frame = [&](int number) {
+            auto frame = hud_synthesis_frame(gpu, scene, key, static_cast<std::uint64_t>(number) + 1U);
+            frame->display_time = 5000 + number;
+            return frame;
+        };
+        xrfg::D3D12HistoryCaptureTicket ticket{};
+        xrfg::D3D12FrameSynthesisTicket output{};
+        require_hresult(history->capture(0, &ticket), "hud capture: capture 0");
+        require_hresult(history->commit(ticket), "hud capture: commit 0");
+        synth.set_cockpit_mask(mask_frame(0));
+        require_hresult(synth.submit_prime(ticket, views, 0, &output), "hud capture: prime");
+        hud_run(gpu, [](ID3D12GraphicsCommandList*) {});
+        for (int pair = 1; pair <= pairs; ++pair) {
+            require_hresult(history->capture(static_cast<std::uint32_t>(pair % 2), &ticket), "hud capture: capture");
+            require_hresult(history->commit(ticket), "hud capture: commit");
+            synth.set_cockpit_mask(mask_frame(pair));
+            require_hresult(synth.submit_pair(ticket, views, views, 0, 0, &output, std::nullopt, {}, false, 0.5F,
+                                std::nullopt),
+                "hud capture: pair");
+            hud_run(gpu, [](ID3D12GraphicsCommandList*) {}); // the pair done
+            Sleep(40); // the previous set's writer done (a set records only then)
+        }
+        require_hresult(synth.wait_for_idle(), "hud capture: idle");
+    }
+}
