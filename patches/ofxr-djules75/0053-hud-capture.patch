+[[nodiscard]] bool hud_capture_write_file(const std::filesystem::path& path, const std::vector<std::uint8_t>& bytes) noexcept {
+    HANDLE handle = CreateFileW(path.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (handle == INVALID_HANDLE_VALUE) {
+        return false;
+    }
+    DWORD written = 0;
+    const BOOL ok = WriteFile(handle, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr);
+    CloseHandle(handle);
+    return ok != FALSE && written == bytes.size();
+}
+
+// One image of a HUD capture set, `width` x `height` texels `row_pitch` apart
+// at `pixels`: a 24-bit bottom-up BMP of its bytes (the R, G and B bytes as
+// stored, alpha dropped; no conversion), or for another format its rows as
+// stored (.raw, top-down, tightly packed).
+[[nodiscard]] std::vector<std::uint8_t> hud_capture_image_file(const std::uint8_t* pixels, UINT width, UINT height,
+    UINT row_pitch, UINT bytes_per_pixel, int order) {
+    std::vector<std::uint8_t> file;
+    if (order == 0) {
+        const std::size_t row = static_cast<std::size_t>(width) * bytes_per_pixel;
+        file.resize(row * height);
+        for (UINT y = 0; y < height; ++y) {
+            std::memcpy(file.data() + row * y, pixels + static_cast<std::size_t>(row_pitch) * y, row);
+        }
+        return file;
+    }
+    const UINT row = (width * 3U + 3U) & ~3U;
+    file.assign(54U + static_cast<std::size_t>(row) * height, 0U);
+    const auto put32 = [&](std::size_t at, std::uint32_t value) {
+        for (int b = 0; b < 4; ++b) file[at + b] = static_cast<std::uint8_t>(value >> (8 * b));
+    };
+    file[0] = 'B'; file[1] = 'M';
+    put32(2, static_cast<std::uint32_t>(file.size())); put32(10, 54); put32(14, 40);
+    put32(18, width); put32(22, height);
+    file[26] = 1; file[28] = 24;
+    put32(34, row * height);
+    for (UINT y = 0; y < height; ++y) {
+        std::uint8_t* out = file.data() + 54 + static_cast<std::size_t>(height - 1U - y) * row;
+        const std::uint8_t* in = pixels + static_cast<std::size_t>(row_pitch) * y;
+        for (UINT x = 0; x < width; ++x) {
+            const std::uint8_t* texel = in + static_cast<std::size_t>(x) * 4U;
+            // BMP stores B, G, R.
+            out[x * 3U] = order == 1 ? texel[2] : texel[0];
+            out[x * 3U + 1U] = texel[1];
+            out[x * 3U + 2U] = order == 1 ? texel[0] : texel[2];
+        }
+    }
+    return file;
+}
