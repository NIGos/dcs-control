+std::wstring hud_symbology_block_name_from_environment() {
+    std::wstring name = dcsvr_symbology::block_name;
+    std::array<wchar_t, 128> suffix{};
+    const DWORD length = GetEnvironmentVariableW(
+        L"DCSVR_PERCEPTION_SHM_SUFFIX", suffix.data(), static_cast<DWORD>(suffix.size()));
+    if (length > 0 && length < suffix.size()) {
+        name.append(suffix.data(), length);
+    }
+    return name;
+}
