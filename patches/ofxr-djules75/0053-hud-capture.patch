+HudSymbologyWindowReader::HudSymbologyWindowReader(std::wstring name) noexcept : name_(std::move(name)) {}
+
+HudSymbologyWindowReader::~HudSymbologyWindowReader() {
+    if (view_ != nullptr) {
+        UnmapViewOfFile(view_);
+    }
+    if (mapping_ != nullptr) {
+        CloseHandle(static_cast<HANDLE>(mapping_));
+    }
+}
+
+HudSymbologyWindowReader::Result HudSymbologyWindowReader::read(std::int64_t display_time) noexcept {
+    namespace csy = dcsvr_symbology;
+    Result result{};
+    if (view_ == nullptr) {
+        const std::uint64_t now = GetTickCount64();
+        if (next_open_ms_ != 0 && now < next_open_ms_) {
+            return result;
+        }
+        next_open_ms_ = now + 1000U;
+        // Read only: never the reader heartbeat (the producer's "wanted").
+        HANDLE mapping = OpenFileMappingW(FILE_MAP_READ, FALSE, name_.c_str());
+        if (mapping == nullptr) {
+            return result;
+        }
+        const void* view = MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, sizeof(csy::Header));
+        if (view == nullptr) {
+            CloseHandle(mapping);
+            return result;
+        }
+        mapping_ = mapping;
+        view_ = view;
+    }
+    // The header is 2 KB: on the heap, once per read (a capture's rate).
+    std::unique_ptr<csy::Header> header;
+    try {
+        header = std::make_unique<csy::Header>();
+    } catch (...) {
+        return result;
+    }
+    if (!csy::seqlock_read(static_cast<const csy::Header*>(view_), *header) ||
+        !csy::header_usable(*header, GetCurrentProcessId())) {
+        return result;
+    }
+    int slot = csy::find_slot(*header, display_time);
+    result.source = HudCaptureSource::block_frame;
+    if (slot < 0 || !csy::layout_usable(*header, slot)) {
+        slot = -1;
+        for (int index = 0; index < csy::slot_count; ++index) {
+            const csy::EmissionSlot& s = header->slot[index];
+            if ((s.flags & csy::slot_flags::valid) == 0 || s.seq == 0 || !csy::layout_usable(*header, index)) {
+                continue;
+            }
+            if (slot < 0 || s.seq > header->slot[slot].seq) {
+                slot = index;
+            }
+        }
+        result.source = HudCaptureSource::block_newest;
+    }
+    if (slot < 0) {
+        result.source = HudCaptureSource::fallback;
+        return result;
+    }
+    static_cast<void>(hud_symbology_from_header(header.get(), slot, result.symbology));
+    result.block = true;
+    result.seq = header->slot[slot].seq;
+    result.generation = header->generation;
+    return result;
+}
