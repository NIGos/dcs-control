+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8X8_UNORM:
+        return "unorm8 without sRGB (the bytes as the game wrote them), as stored in the swapchain";
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+        return "float16 RGBA (linear), as stored in the swapchain, written raw (.raw, 8 bytes a pixel)";
+    case DXGI_FORMAT_R10G10B10A2_UNORM:
+        return "unorm10 packed R10G10B10A2, as stored in the swapchain, written raw (.raw, 4 bytes a pixel)";
+    case DXGI_FORMAT_R11G11B10_FLOAT:
+        return "float11/11/10 packed, as stored in the swapchain, written raw (.raw, 4 bytes a pixel)";
+    default:
+        return "as stored in the swapchain, written raw (.raw)";
+    }
