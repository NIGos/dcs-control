+// ---------------------------------------------------------------------------
+// DCS Control (0098): CadenceConfig::three_exit_learned (`[ofxr]
+// cadence_3x_exit`). The user's flight of 2026-11-23 16:50 replayed: the
+// view reads 16.5 ms of work at 2 and 20.7 ms at 3 (CPU and GPU alike), two
+// missed-slot episodes send 2 to 3, and every return to 2 brings the switch's
+// own late frames (0, 120 and 240 ms after it).
+
+struct ExitRun {
+    std::uint32_t frames_last{};
+    std::uint32_t three_last{};
+    std::uint32_t returns{};
+    std::uint32_t ups{};
+    std::uint32_t final_level{};
+    Nanoseconds excess{-1};
+};
+
+// `work(level)`: the frame's work at that level. `first_misses`: the frame
+// indices (from the start) whose end misses a slot. `return_misses`: offsets
+// after each 3 -> 2 at which a frame misses.
+template <typename Work>
+ExitRun run_exit(bool learned, Nanoseconds duration, Work work,
+    std::vector<std::uint64_t> first_misses, std::vector<Nanoseconds> return_misses,
+    CadencePreference preference = CadencePreference::balanced) {
+    CadenceConfig config = cadence_config_for(preference);
+    CadenceSim sim(config);
+    sim.controller.set_three_exit_learned(learned);
+    ExitRun run{};
+    const Nanoseconds end = sim.now + duration;
+    const Nanoseconds half = sim.now + duration / 2;
+    Nanoseconds returned_at = -1;
+    std::size_t return_next = 0;
+    std::uint64_t index = 0;
+    while (sim.now < end) {
+        const std::uint32_t level = sim.controller.level();
+        const Nanoseconds at = sim.now + kPeriod * level;
+        bool miss = std::find(first_misses.begin(), first_misses.end(), index) != first_misses.end();
+        if (returned_at >= 0 && return_next < return_misses.size() &&
+            at - returned_at >= return_misses[return_next]) {
+            miss = true;
+            ++return_next;
+        }
+        if (miss) {
+            sim.controller.add_late(at, 1);
+        }
+        const Nanoseconds cost = work(level);
+        const CadenceStep step = sim.frame(cost, cost);
+        if (step.previous == 3 && step.level == 2) {
+            ++run.returns;
+            returned_at = sim.now;
+            return_next = 0;
+        }
+        run.ups += step.previous == 2 && step.level == 3 ? 1U : 0U;
+        if (sim.now > half) {
+            ++run.frames_last;
+            run.three_last += step.level == 3 ? 1U : 0U;
+        }
+        ++index;
+    }
+    run.final_level = sim.controller.level();
+    run.excess = sim.controller.three_excess();
+    return run;
+}
+
+std::string describe_exit(const ExitRun& run) {
+    return " (level " + std::to_string(run.final_level) + ", ups " + std::to_string(run.ups) +
+        ", returns " + std::to_string(run.returns) + ", frames of 3 in the second half " +
+        std::to_string(run.three_last) + " of " + std::to_string(run.frames_last) +
+        ", excess " + std::to_string(run.excess) + " ns)";
+}
+
+void cadence_3x_exit_tests() {
+    require(!CadenceConfig{}.three_exit_learned &&
+            !cadence_config_for(CadencePreference::balanced).three_exit_learned &&
+            !cadence_config_for(CadencePreference::rate).three_exit_learned,
+        "3x exit: off in every configuration until the caller turns it on");
+    static constexpr Nanoseconds kAtTwo = 16'500'000;
+    static constexpr Nanoseconds kAtThree = 20'700'000;
+    const auto flight = [](std::uint32_t level) { return level == 3 ? kAtThree : kAtTwo; };
+    // Two episodes 150 ms apart, after 3 s at 2 (135 frames of 22.2 ms).
+    const std::vector<std::uint64_t> burst{135, 142};
+    const std::vector<Nanoseconds> own{0, 120 * kMillisecond, 240 * kMillisecond};
+
+    for (const CadencePreference preference : {CadencePreference::balanced, CadencePreference::rate}) {
+        const std::string name = " [preference " + std::to_string(static_cast<std::uint32_t>(preference)) + "]";
+        // (a) The 16:50 flight, rule 0: 3 for good (20.7 ms never meets 18.9).
+        {
+            const auto r = run_exit(false, 60 * kSecond, flight, burst, own, preference);
+            std::cout << "3x exit, 16:50 replay, cadence_3x_exit=0" << name << ":" << describe_exit(r) << '\n';
+            require(r.ups == 1 && r.returns == 0 && r.final_level == 3 && r.three_last == r.frames_last,
+                "3x exit: the old rule never leaves 3" + name + describe_exit(r));
+        }
+        // (b) Rule 1: the excess (4.2 ms, capped at 4) is measured, 2 comes
+        // back, the switch's own late frames do not send it up again.
+        {
+            const auto r = run_exit(true, 60 * kSecond, flight, burst, own, preference);
+            std::cout << "3x exit, 16:50 replay, cadence_3x_exit=1" << name << ":" << describe_exit(r) << '\n';
+            require(r.excess == 4 * kMillisecond,
+                "3x exit: the excess measured and capped" + name + describe_exit(r));
+            require(r.ups == 1 && r.returns == 1 && r.final_level == 2 && r.three_last == 0,
+                "3x exit: back at 2 and it stays" + name + describe_exit(r));
+        }
+        // (c) Rule 1, work that does need 3 (25 ms at 2, 27 at 3): it goes up
+        // on the work and stays.
+        {
+            const auto heavy = [](std::uint32_t level) { return level == 3 ? 27 * kMillisecond : 25 * kMillisecond; };
+            const auto r = run_exit(true, 30 * kSecond, heavy, {}, own, preference);
+            std::cout << "3x exit, heavy, cadence_3x_exit=1" << name << ":" << describe_exit(r) << '\n';
+            require(r.ups == 1 && r.returns == 0 && r.final_level == 3 && r.excess == 2 * kMillisecond,
+                "3x exit: work that needs 3 keeps it" + name + describe_exit(r));
+        }
+        // (d) Up on misses without the work at 2 behind them (no sample the
+        // controller takes at 2: -1): no excess, the plain limit (0.90 of two
+        // periods, 20.0 ms) lets 19.5 ms go back to 2; the old rule keeps 3.
+        {
+            const auto plain = [](std::uint32_t level) -> Nanoseconds { return level == 3 ? 19'500'000 : -1; };
+            const std::vector<std::uint64_t> early{0, 6};
+            const auto off = run_exit(false, 30 * kSecond, plain, early, {}, preference);
+            const auto on = run_exit(true, 30 * kSecond, plain, early, {}, preference);
+            std::cout << "3x exit, unmeasured, 0 / 1" << name << ":" << describe_exit(off) << describe_exit(on) << '\n';
+            require(off.ups == 1 && off.returns == 0 && off.final_level == 3,
+                "3x exit: unmeasured, the old rule keeps 3" + name + describe_exit(off));
+            require(on.ups == 1 && on.returns == 1 && on.final_level == 2 && on.excess < 0,
+                "3x exit: unmeasured, the plain limit returns" + name + describe_exit(on));
+        }
+        // (e) Rule 1: misses after the settle still count: two episodes 400
+        // and 550 ms after the return send 2 back to 3.
+        {
+            const std::vector<Nanoseconds> late_after{400 * kMillisecond, 550 * kMillisecond};
+            const auto r = run_exit(true, 30 * kSecond, flight, burst, late_after, preference);
+            std::cout << "3x exit, misses after the settle" << name << ":" << describe_exit(r) << '\n';
+            require(r.ups >= 2 && r.returns >= 1,
+                "3x exit: misses past the settle still go to 3" + name + describe_exit(r));
+        }
+    }
+}
