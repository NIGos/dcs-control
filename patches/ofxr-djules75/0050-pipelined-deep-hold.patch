+// DCS Control (0050): `[ofxr] async_arm`. Arming a swapchain - its private
+// swapchains (the runtime's xrCreateSwapchain, tens of milliseconds each),
+// its history and its synthesizer (pipelines, the optical-flow session) -
+// held the application's xrEndFrame for 55-136 ms right after DCS left its
+// F10 map. With the key it runs on a thread of its own, as 0034's second
+// synthetic slot does, and the frames pass through until a later xrEndFrame
+// takes the generation in (arm_frame_generation_async).
+//
+// Why it is safe off the frame path: the thread takes none of the layer's
+// locks but the swapchain's `mutex`, briefly (the history reads the
+// enumerated images and the bridge), so it can be joined from anywhere that
+// does not hold that one. It calls the runtime as 0034's thread does
+// (xrCreateSwapchain and xrEnumerateSwapchainImages on private swapchains
+// nothing else names yet). On the device it only creates objects - the
+// history's and the synthesizer's resources, pipelines, fences and its
+// optical-flow session - which D3D12 allows from any thread; nothing it does
+// queues GPU work (the smooth cursor's upload and the optical-flow order are
+// set when the generation is taken in, under gpu_mutex, as everything else
+// that queues work), so no queue sees work from it. What it reads of the
+// session's that the frame path may change - the backend, the optical-flow
+// options, the synthetic ring's size - is taken when it starts; a fallback
+// to FidelityFX and a change of options meanwhile are applied when the
+// generation is taken in. The history it makes is published only then, so no
+// capture runs into it before. Its result is never used once the swapchain
+// is torn down: destroy_frame_generation_swapchains (every swapchain and
+// session teardown, and the deeper pipeline's fallback) and the embedded
+// control's own arming retire it first: join, then destroy what it made.
+struct AsyncArmState {
+    std::mutex mutex;
+    std::thread worker;
+    bool done{};
+    AsyncArmInputs inputs;
+    std::shared_ptr<FrameGenerationSwapchainState> generation;
+    SwapchainEligibilityReason reason{SwapchainEligibilityReason::exception};
+    std::uint64_t detail{};
+    std::chrono::steady_clock::time_point started_at{};
+    std::chrono::steady_clock::time_point finished_at{};
+
+    AsyncArmState() = default;
+    AsyncArmState(const AsyncArmState&) = delete;
+    AsyncArmState& operator=(const AsyncArmState&) = delete;
+    // Normally joined (retire_async_arm, or the frame that takes it in).
+    // Otherwise (the last reference may be the thread's own) never joined
+    // from here, as LazySyntheticSlot.
+    ~AsyncArmState() {
+        if (worker.joinable()) {
+            worker.detach();
+        }
+    }
+};
+
+// A generation the arming thread made that no frame took in: its private
+// swapchains go back to the runtime. Nothing ever acquired them, and the
+// synthesizer queued no GPU work.
+void discard_async_generation(
+    const std::shared_ptr<SessionState>& session,
+    const std::shared_ptr<FrameGenerationSwapchainState>& generation) noexcept {
+    try {
+        if (!generation || !session || !session->dispatch ||
+            session->dispatch->destroy_swapchain == nullptr) {
+            return;
+        }
+        for (PrivateSwapchainState& image : generation->synthetic) {
+            if (image.handle != XR_NULL_HANDLE) {
+                static_cast<void>(session->dispatch->destroy_swapchain(image.handle));
+                image.handle = XR_NULL_HANDLE;
+            }
+        }
+        for (PrivateSwapchainState& image : generation->current) {
+            if (image.handle != XR_NULL_HANDLE) {
+                static_cast<void>(session->dispatch->destroy_swapchain(image.handle));
+                image.handle = XR_NULL_HANDLE;
+            }
+        }
+        generation->synthesizer.reset();
+    } catch (...) {
+    }
+}
+
+// Joins `arm`'s thread, unless it is this one.
+void join_async_arm(AsyncArmState& arm) noexcept {
+    try {
+        std::thread worker;
+        {
+            std::scoped_lock lock(arm.mutex);
+            worker = std::move(arm.worker);
+        }
+        if (worker.joinable()) {
+            if (worker.get_id() == std::this_thread::get_id()) {
+                worker.detach();
+            } else {
+                worker.join();
+            }
+        }
+    } catch (...) {
+    }
+}
+
+void retire_async_arm(const std::shared_ptr<SwapchainState>& state) noexcept {
+    try {
+        if (!state) {
+            return;
+        }
+        std::shared_ptr<AsyncArmState> arm;
+        {
+            std::scoped_lock lock(state->mutex);
+            arm = std::move(state->async_arm);
+        }
+        if (!arm) {
+            return;
+        }
+        join_async_arm(*arm);
+        std::shared_ptr<FrameGenerationSwapchainState> generation;
+        {
+            std::scoped_lock lock(arm->mutex);
+            generation = std::move(arm->generation);
+            arm->inputs.history.reset();
+        }
+        discard_async_generation(state->session, generation);
+    } catch (...) {
+    }
+}
