+// DCS Control (0050): what the 2X deeper pipeline's hold re-presents.
+void deep_hold_repeat_tests() {
+    RepeatCandidate real{};
+    real.present = true;
+    real.projections = 1;
+    real.layer_count = 1;
+    real.capture_epoch = 7;
+    // A pipelined presenter, 2X deep, key on: the skip repeat, while the
+    // capture after next has not begun (two current slots).
+    require(deep_hold_repeat(false, real, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::skip_repeat,
+        "deep hold: a projection-only real frame is re-presented");
+    require(deep_hold_repeat(false, real, true, true, 2, true, 8, 2) ==
+                DeepHoldRepeat::skip_repeat,
+        "deep hold: the next frame's capture writes the other slot");
+    require(deep_hold_repeat(false, real, true, true, 2, true, 9, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: the slot's next capture has begun");
+    // The presenter's own last frame always comes first, key on or off.
+    require(deep_hold_repeat(true, real, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::last_frame,
+        "deep hold: the last frame first");
+    require(deep_hold_repeat(true, RepeatCandidate{}, false, true, 2, false, 0, 2) ==
+                DeepHoldRepeat::last_frame,
+        "deep hold: key off keeps the last frame");
+    // Key off: as before, nothing without a last frame.
+    require(deep_hold_repeat(false, real, false, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: key off gives nothing");
+    // Not a synthetic, not a frame with other composition layers, not one
+    // with a layer that is no projection of the layer's own.
+    RepeatCandidate synthetic = real;
+    synthetic.synthetic = true;
+    require(deep_hold_repeat(false, synthetic, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: a synthetic is never re-presented");
+    RepeatCandidate quad = real;
+    quad.composition_layers = 1;
+    quad.layer_count = 2;
+    require(deep_hold_repeat(false, quad, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: a frame with a quad layer is never re-presented");
+    RepeatCandidate unowned = real;
+    unowned.layer_count = 2;
+    require(deep_hold_repeat(false, unowned, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: a frame with a layer of the application's");
+    RepeatCandidate empty = real;
+    empty.projections = 0;
+    empty.layer_count = 0;
+    require(deep_hold_repeat(false, empty, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: a frame with no layers");
+    require(deep_hold_repeat(false, RepeatCandidate{}, true, true, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: no frame at all");
+    RepeatCandidate unknown_epoch = real;
+    unknown_epoch.capture_epoch = 0;
+    require(deep_hold_repeat(false, unknown_epoch, true, true, 2, true, 1, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: a frame whose capture is not known");
+    // Only at 2X, deep, pipelined.
+    require(deep_hold_repeat(false, real, true, false, 2, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: shallow pipeline");
+    require(deep_hold_repeat(false, real, true, true, 3, true, 7, 2) ==
+                DeepHoldRepeat::none,
+        "deep hold: 3X has its own re-presented slot");
+    require(deep_hold_repeat(false, real, true, true, 2, false, 7, 2) ==
