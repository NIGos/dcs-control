+// Under `[ofxr] async_arm`, on a D3D12 session (the D3D11 bridge's included):
+// starts arming `state` on a thread of its own, or takes in what that thread
+// made. The swapchain's call_mutex is held (ensure_frame_generation).
+// nullopt: arm on the frame path as before (the key is off, another binding,
+// or the thread failed - the frame path then also handles a budget refusal
+// as it always has). true: arming is under way (the frame passes through) or
+// the generation was taken in.
+[[nodiscard]] std::optional<bool> arm_frame_generation_async(
+    const std::shared_ptr<SwapchainState>& state) noexcept {
+    try {
+        const std::shared_ptr<SessionState>& session = state->session;
+        if (!session->async_arm ||
+            session->graphics_binding != SessionGraphicsBinding::d3d12 ||
+            state->async_arm_failed) {
+            return std::nullopt;
+        }
+        std::shared_ptr<AsyncArmState> arm;
+        {
+            std::scoped_lock lock(state->mutex);
+            arm = state->async_arm;
+        }
+        if (!arm) {
+            arm = std::make_shared<AsyncArmState>();
+            // Taken here, on the thread that changes them.
+            arm->inputs.backend = session->optical_flow_backend;
+            if (arm->inputs.backend == xrfg::D3D12OpticalFlowBackend::nvidia &&
+                session->nvidia_backend_unavailable) {
+                arm->inputs.backend = xrfg::D3D12OpticalFlowBackend::fidelity_fx;
+            }
+            arm->inputs.nvidia_options = session->nvidia_options;
+            arm->inputs.synthetic_slots = synthetic_slot_count_for(*session);
+            arm->started_at = std::chrono::steady_clock::now();
+            {
+                std::scoped_lock lock(state->mutex);
+                state->async_arm = arm;
+            }
+            try {
+                std::scoped_lock arm_lock(arm->mutex);
+                arm->worker = std::thread([state, arm]() noexcept {
+                    AsyncArmInputs inputs;
+                    {
+                        std::scoped_lock lock(arm->mutex);
+                        inputs = arm->inputs;
+                    }
+                    SwapchainEligibilityReason reason =
+                        SwapchainEligibilityReason::exception;
+                    std::uint64_t detail = 0;
+                    std::shared_ptr<FrameGenerationSwapchainState> generation;
+                    try {
+                        generation = create_d3d12_frame_generation_swapchains(
+                            state, &reason, &detail, &inputs);
+                    } catch (...) {
+                        generation.reset();
+                    }
+                    try {
+                        std::scoped_lock lock(arm->mutex);
+                        arm->inputs = std::move(inputs);
+                        arm->generation = std::move(generation);
+                        arm->reason = reason;
+                        arm->detail = detail;
+                        arm->finished_at = std::chrono::steady_clock::now();
+                        arm->done = true;
+                    } catch (...) {
+                    }
+                });
+            } catch (...) {
+                // No thread: armed on the frame path instead.
+                {
+                    std::scoped_lock lock(state->mutex);
+                    state->async_arm.reset();
+                }
+                state->async_arm_failed = true;
+                return std::nullopt;
+            }
+            log_slow_step(1, arm->started_at, handle_value(state->handle), 2);
+            return true;
+        }
+        {
+            std::scoped_lock lock(arm->mutex);
+            if (!arm->done) {
+                return true;
+            }
+        }
+        join_async_arm(*arm);
+        {
+            std::scoped_lock lock(state->mutex);
+            if (state->async_arm == arm) {
+                state->async_arm.reset();
+            }
+        }
+        std::shared_ptr<FrameGenerationSwapchainState> generation;
+        AsyncArmInputs inputs;
+        SwapchainEligibilityReason reason{};
+        std::uint64_t detail = 0;
+        std::chrono::steady_clock::duration took{};
+        {
+            std::scoped_lock lock(arm->mutex);
+            generation = std::move(arm->generation);
+            inputs = std::move(arm->inputs);
+            reason = arm->reason;
+            detail = arm->detail;
+            took = arm->finished_at - arm->started_at;
+        }
+        const auto log_taken = [&](std::uint64_t outcome) {
+            const std::int64_t took_us = std::max<std::int64_t>(
+                0, std::chrono::duration_cast<std::chrono::microseconds>(took).count());
+            xrfg::bridge_flight_logger().timed_event(
+                xrfg::BridgeFlightOperation::slow_step,
+                5,
+                static_cast<std::uint64_t>(took_us),
+                static_cast<std::uint64_t>(took_us / 1000),
+                handle_value(state->handle),
+                outcome);
+        };
+        if (!generation || !generation->synthesizer) {
+            // Armed on the frame path now, as before: the same attempt, and a
+            // budget refusal handled where it always was.
+            log_swapchain_eligibility(state, reason, detail, 0);
+            log_taken(1);
+            state->async_arm_failed = true;
+            return std::nullopt;
+        }
+        // A history made by the thread is the one its synthesizer reads; one
+        // published meanwhile by another path would leave captures going
+        // elsewhere (no path does while the thread runs, but never mixed).
+        bool taken = true;
+        if (inputs.history_new) {
+            std::scoped_lock lock(state->mutex);
+            taken = !state->d3d12_history;
+        }
+        if (taken) {
+            std::scoped_lock gpu_lock(session->gpu_mutex);
+            if (inputs.nvidia_fell_back) {
+                // As initialize_synthesis_with_fallback does on the frame path.
+                session->nvidia_backend_unavailable = true;
+                session->optical_flow_backend =
+                    xrfg::D3D12OpticalFlowBackend::fidelity_fx;
+            }
+            // The menu changed the optical flow meanwhile: as the embedded
+            // control does to a generation it already has.
+            const xrfg::D3D12OpticalFlowBackend made_with = inputs.nvidia_fell_back
+                ? xrfg::D3D12OpticalFlowBackend::fidelity_fx
+                : inputs.backend;
+            xrfg::D3D12OpticalFlowBackend wanted = session->optical_flow_backend;
+            if (wanted == xrfg::D3D12OpticalFlowBackend::nvidia &&
+                session->nvidia_backend_unavailable) {
+                wanted = xrfg::D3D12OpticalFlowBackend::fidelity_fx;
+            }
+            if (wanted != made_with ||
+                inputs.nvidia_options.preset != session->nvidia_options.preset ||
+                inputs.nvidia_options.input_scale != session->nvidia_options.input_scale ||
+                inputs.nvidia_options.bidirectional !=
+                    session->nvidia_options.bidirectional) {
+                taken = SUCCEEDED(generation->synthesizer->reconfigure(
+                    wanted, session->nvidia_options));
+            }
+            if (taken) {
+                configure_smooth_cursor(*session, *generation->synthesizer); // 0010
+                if (inputs.own_queue && session->optical_flow_chain) {
+                    generation->synthesizer->set_optical_flow_chain(
+                        session->optical_flow_chain); // DCS Control (0038)
+                }
+            }
+        }
+        if (!taken) {
+            discard_async_generation(session, generation);
+            log_taken(2);
+            state->async_arm_failed = true;
+            return std::nullopt;
+        }
+        {
+            std::scoped_lock lock(state->mutex);
+            if (inputs.history_new) {
+                state->d3d12_history = std::move(inputs.history);
+                state->last_released_capture.reset();
+                state->last_released_motion_vectors.reset();
+            }
+            state->frame_generation = std::move(generation);
+        }
+        state->generation_eligible_pending = false;
+        log_swapchain_eligibility(
+            state,
+            SwapchainEligibilityReason::ready,
+            state->enumerated_image_count,
+            (static_cast<std::uint64_t>(state->enumerated_image_count) << 32) |
+                state->create_info.arraySize);
+        log_taken(0);
+        return true;
+    } catch (...) {
+        return std::nullopt;
+    }
+}
