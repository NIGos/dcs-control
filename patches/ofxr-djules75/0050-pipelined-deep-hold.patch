+        bool ran_out = false;
+        const auto started = std::chrono::steady_clock::now();
+        if (blocked_by_repeat()) {
+            waited = true;
+            ApplicationBlockedScope blocked; // DCS VR Control (0004)
+            ran_out = !state->presenter_condition.wait_for(
+                lock, std::chrono::milliseconds(50),
+                [&] { return !blocked_by_repeat(); });
+        }
+        state->capture_epoch = next;
+        lock.unlock();
+        if (waited) {
+            const auto took = std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - started).count();
+            xrfg::bridge_flight_logger().timed_event(
+                xrfg::BridgeFlightOperation::slow_step,
+                6,
+                static_cast<std::uint64_t>(std::max<std::int64_t>(took, 0)),
+                static_cast<std::uint64_t>(std::max<std::int64_t>(took, 0) / 1000),
+                handle_value(state->handle),
+                ran_out ? 1U : 0U);
+        }
+        return next;
+    } catch (...) {
