diff --git a/include/xrfg/latency_control.hpp b/include/xrfg/latency_control.hpp
--- a/include/xrfg/latency_control.hpp
+++ b/include/xrfg/latency_control.hpp
@@ -2047,4 +2047,71 @@
     return bound < 1 ? 1 : bound;
 }
 
+// DCS Control (0050): what the 2X deeper pipeline's hold re-presents for the
+// slot it holds a synthetic back from. A presenter outside the pipelined mode
+// keeps the frame it submitted last (`last_frame`); a pipelined one (DCS:
+// wait and end on two threads) keeps none, because the application may
+// destroy the handles a frame of its names as soon as its xrEndFrame
+// returns, so without another frame the hold never engaged. The late-frame
+// skip's copy (`skip_repeat`) is the last real frame, and only one made of
+// the layer's own projection layers (private swapchains, chains stripped):
+// nothing in it is the application's but the space, which a destroy settles
+// first. Under `[ofxr] pipelined_deep_hold`, at 2X with the deeper pipeline
+// on a pipelined presenter, the hold re-presents that.
+enum class DeepHoldRepeat : std::uint8_t {
+    none = 0,       // nothing to re-present: the synthetic goes now (402/405)
+    last_frame = 1, // the presenter's own last frame (400/401)
+    skip_repeat = 2 // the late-frame skip's copy (406)
+};
+
+// The shape of a frame a slot may re-present.
+struct RepeatCandidate {
+    bool present{};
+    bool synthetic{};
+    std::size_t composition_layers{}; // layers other than projections
+    std::size_t projections{};
+    std::uint32_t layer_count{};
+    // The application frame whose capture wrote the private images it names,
+    // counted per frame from 1 (0: not known).
+    std::uint64_t capture_epoch{};
+};
+
+// A real frame made of projection layers only (skip_repeat_safe's test).
+[[nodiscard]] constexpr bool projection_only_real(const RepeatCandidate& frame) noexcept {
+    return frame.present && !frame.synthetic && frame.composition_layers == 0 &&
+        frame.projections != 0 && frame.layer_count == frame.projections;
+}
+
+// Whether a later frame's capture may already be writing the private images
+// `frame_epoch`'s frame names: the current output alternates `slots` private
+// swapchains, so the capture `slots` frames later takes the same one again,
+// and a re-presented slot would then bind its new image (a newer frame shown
+// out of order). `capture_epoch` is the latest frame whose capture began.
+[[nodiscard]] constexpr bool capture_slot_reused(
+    std::uint64_t frame_epoch,
+    std::uint64_t capture_epoch,
+    std::uint64_t slots) noexcept {
+    return frame_epoch == 0 || capture_epoch >= frame_epoch + slots;
+}
+
+[[nodiscard]] constexpr DeepHoldRepeat deep_hold_repeat(
+    bool last_frame,
+    const RepeatCandidate& skip_repeat,
+    bool enabled,
+    bool deep_pipeline,
+    std::uint32_t frames_per_application_frame,
+    bool pipelined,
+    std::uint64_t capture_epoch,
+    std::uint64_t current_slots) noexcept {
+    if (last_frame) {
+        return DeepHoldRepeat::last_frame;
+    }
+    if (!enabled || !deep_pipeline || frames_per_application_frame > 2 ||
+        !pipelined || !projection_only_real(skip_repeat) ||
+        capture_slot_reused(skip_repeat.capture_epoch, capture_epoch, current_slots)) {
+        return DeepHoldRepeat::none;
+    }
+    return DeepHoldRepeat::skip_repeat;
+}
+
 } // namespace xrfg::latency
