diff --git a/tests/layer_pipelined_deep_hold.cmake b/tests/layer_pipelined_deep_hold.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_pipelined_deep_hold.cmake
@@ -0,0 +1,192 @@
+# DCS Control (0050): the 2X deeper pipeline's hold on a pipelined presenter
+# (`[ofxr] pipelined_deep_hold`) and frame generation armed on a thread of its
+# own (`[ofxr] async_arm`). Runs a call-chain scenario with HOLD_INI beside the
+# layer DLL; the scenario checks what reached the fake runtime itself, and
+# this the flight log.
+#   MODE=dcs-deep-hold, EXPECT=1: holds with the late-frame skip's copy
+#   (presenter_transition 406) happen, none goes over as 402 once steady, and
+#   the late frames (a few ms past the steady frames' slack) cost adaptive
+#   2X/3X no missed slot, in 2X throughout (latency_status's
+#   late count, b bits 16-31, over the late stretch). EXPECT=0: as before
+#   0050 - no 406, and those late frames do cost missed slots.
+#   MODE=dcs-async-arm, EXPECT=1: generation armed on its thread and taken in
+#   (slow_step 5, c=0); EXPECT=0: armed on the frame path (slow_step 1, c=0)
+#   and never on a thread.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN HOLD_INI WORK_DIR MODE EXPECT)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${HOLD_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(hold_ini_name "${HOLD_INI}" NAME)
+file(RENAME "${WORK_DIR}/${hold_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${MODE}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${MODE}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+
+set(field_pattern "result=(-?[0-9]+) dur_us=([0-9]+) a=([0-9]+) b=([0-9]+) c=([0-9]+)")
+
+if(MODE STREQUAL "dcs-async-arm")
+    file(STRINGS "${flight_log}" step_lines REGEX " op=slow_step result=")
+    set(async_taken 0)
+    set(async_started 0)
+    set(armed_inline 0)
+    foreach(line IN LISTS step_lines)
+        if(NOT line MATCHES "${field_pattern}")
+            message(FATAL_ERROR "Malformed slow_step record: ${line}")
+        endif()
+        if(CMAKE_MATCH_1 EQUAL 5 AND CMAKE_MATCH_5 EQUAL 0)
+            math(EXPR async_taken "${async_taken} + 1")
+        elseif(CMAKE_MATCH_1 EQUAL 1 AND CMAKE_MATCH_5 EQUAL 2)
+            math(EXPR async_started "${async_started} + 1")
+        elseif(CMAKE_MATCH_1 EQUAL 1 AND CMAKE_MATCH_5 EQUAL 0)
+            math(EXPR armed_inline "${armed_inline} + 1")
+        endif()
+    endforeach()
+    if(EXPECT)
+        if(async_taken EQUAL 0 OR async_started EQUAL 0 OR NOT armed_inline EQUAL 0)
+            message(FATAL_ERROR
+                "async_arm=1: ${async_started} started and ${async_taken} taken in on a "
+                "thread, ${armed_inline} armed on the frame path")
+        endif()
+    elseif(armed_inline EQUAL 0 OR NOT async_started EQUAL 0 OR NOT async_taken EQUAL 0)
+        message(FATAL_ERROR
+            "async_arm=0: ${armed_inline} armed on the frame path, ${async_started} "
+            "started on a thread")
+    endif()
+    message(STATUS
+        "OFXR async arm verified (async_arm=${EXPECT}): ${async_started} started, "
+        "${async_taken} taken in, ${armed_inline} armed on the frame path")
+    return()
+endif()
+
+foreach(mark IN ITEMS STEADY_FROM LATE_FROM LATE_TO)
+    if(NOT call_chain_output MATCHES "DEEP_HOLD_${mark}=([0-9]+)")
+        message(FATAL_ERROR "The scenario printed no DEEP_HOLD_${mark}")
+    endif()
+    set(mark_${mark} "${CMAKE_MATCH_1}")
+endforeach()
+
+# In log order: the frames' display times (projection_mapping's a), the
+# presenter's holds and the once-a-second latency status.
+file(STRINGS "${flight_log}" lines
+    REGEX " op=(projection_mapping|presenter_transition|latency_status) result=")
+set(phase 0)
+set(held_406 0)
+set(held_406_unwritten 0)
+set(held_400 0)
+set(over_402_steady 0)
+set(over_402_total 0)
+set(late_in_stretch 0)
+set(status_in_stretch 0)
+set(status_2x_in_stretch 0)
+set(first_status_in_stretch 0)
+foreach(line IN LISTS lines)
+    if(NOT line MATCHES " op=([a-z_]+) ${field_pattern}")
+        continue()
+    endif()
+    set(op "${CMAKE_MATCH_1}")
+    set(result "${CMAKE_MATCH_2}")
+    set(a "${CMAKE_MATCH_4}")
+    set(b "${CMAKE_MATCH_5}")
+    if(op STREQUAL "projection_mapping")
+        if(phase EQUAL 0 AND a STREQUAL mark_STEADY_FROM)
+            set(phase 1)
+        elseif(phase EQUAL 1 AND a STREQUAL mark_LATE_FROM)
+            set(phase 2)
+        elseif(phase EQUAL 2 AND a STREQUAL mark_LATE_TO)
+            set(phase 3)
+        endif()
+    elseif(op STREQUAL "presenter_transition")
+        if(result EQUAL 406)
+            math(EXPR held_406 "${held_406} + 1")
+            math(EXPR unwritten "(${b} >> 32) & 1")
+            if(unwritten)
+                math(EXPR held_406_unwritten "${held_406_unwritten} + 1")
+            endif()
+        elseif(result EQUAL 400)
+            math(EXPR held_400 "${held_400} + 1")
+        elseif(result EQUAL 402)
+            math(EXPR over_402_total "${over_402_total} + 1")
+            if(phase GREATER_EQUAL 1 AND phase LESS 3)
+                math(EXPR over_402_steady "${over_402_steady} + 1")
+            endif()
+        endif()
+    elseif(op STREQUAL "latency_status" AND phase EQUAL 2)
+        math(EXPR late "(${b} >> 16) & 65535")
+        math(EXPR late_in_stretch "${late_in_stretch} + ${late}")
+        math(EXPR status_in_stretch "${status_in_stretch} + 1")
+        # result 12: adaptive control in 2X (13: 3X, where a missed slot is
+        # not counted at all).
+        if(result EQUAL 12)
+            math(EXPR status_2x_in_stretch "${status_2x_in_stretch} + 1")
+        endif()
+        if(status_in_stretch EQUAL 1)
+            set(first_status_in_stretch ${result})
+        endif()
+    endif()
+endforeach()
+if(NOT first_status_in_stretch EQUAL 12)
+    message(FATAL_ERROR
+        "The late stretch did not start in 2X (latency_status ${first_status_in_stretch})")
+endif()
+if(NOT phase EQUAL 3)
+    message(FATAL_ERROR "The flight log does not show the scenario's phases (reached ${phase})")
+endif()
+if(status_in_stretch LESS 3)
+    message(FATAL_ERROR "Only ${status_in_stretch} latency_status records over the late stretch")
+endif()
+set(summary
+    "406=${held_406} (${held_406_unwritten} unwritten) 400=${held_400} "
+    "402=${over_402_total} (${over_402_steady} once steady), missed slots over the "
+    "late stretch ${late_in_stretch} in ${status_in_stretch} s "
+    "(${status_2x_in_stretch} of them in 2X)")
+string(CONCAT summary ${summary})
+if(EXPECT)
+    if(NOT status_2x_in_stretch EQUAL status_in_stretch)
+        message(FATAL_ERROR "pipelined_deep_hold=1, yet the late stretch left 2X: ${summary}")
+    endif()
+    if(held_406 EQUAL 0)
+        message(FATAL_ERROR "pipelined_deep_hold=1, yet no hold with the skip's copy: ${summary}")
+    endif()
+    if(over_402_steady GREATER 2)
+        message(FATAL_ERROR "pipelined_deep_hold=1, yet synthetics still go over unheld: ${summary}")
+    endif()
+    if(NOT late_in_stretch EQUAL 0)
+        message(FATAL_ERROR "pipelined_deep_hold=1, yet late frames cost missed slots: ${summary}")
+    endif()
+else()
+    if(NOT held_406 EQUAL 0)
+        message(FATAL_ERROR "pipelined_deep_hold=0, yet holds with the skip's copy: ${summary}")
+    endif()
+    if(late_in_stretch EQUAL 0)
+        message(FATAL_ERROR
+            "pipelined_deep_hold=0: the late frames cost no missed slot, so the "
+            "scenario no longer tells the two apart: ${summary}")
+    endif()
+endif()
+message(STATUS "OFXR pipelined deep hold verified (pipelined_deep_hold=${EXPECT}): ${summary}")
