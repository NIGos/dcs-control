+// private current images is about to begin (SessionState::capture_epoch;
+// GeneratedFrameEndInfo::capture_epoch of its real frame), under `[ofxr]
+// pipelined_deep_hold`. The runtime binds whichever image of a swapchain was
+// released last when xrEndFrame runs, so a slot the 2X hold re-presents from
+// the late-frame skip's copy must go out before a later capture takes the
+// private swapchain that copy names (every kCurrentSlotCount-th frame): if
+// the presenter has such a slot in the runtime's xrEndFrame now, this waits
+// for it, bounded at 50 ms (slow_step result=6). The presenter checks the
+// count under the same lock before it chooses the copy (hold_repeat_locked),
+// so a capture that began first is never re-presented over. presenter_mutex
+// only, as wait_for_presenter_capacity just before it; the presenter takes
+// no lock the application holds here.
+[[nodiscard]] std::uint64_t begin_capture_epoch(
+    const std::shared_ptr<SessionState>& state) noexcept {
+    try {
+        std::unique_lock lock(state->presenter_mutex);
+        const std::uint64_t next = state->capture_epoch + 1;
+        const auto blocked_by_repeat = [&] {
+            return state->hold_repeat_in_flight != 0 &&
+                xrfg::latency::capture_slot_reused(
+                    state->hold_repeat_in_flight, next, kCurrentSlotCount) &&
+                !XR_FAILED(state->presenter_failure) &&
+                !state->presenter_stop_requested;
+        };
