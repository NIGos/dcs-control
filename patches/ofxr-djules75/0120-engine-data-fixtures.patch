diff --git a/tests/fg_engine_data.inc b/tests/fg_engine_data.inc
new file mode 100644
--- /dev/null
+++ b/tests/fg_engine_data.inc
@@ -0,0 +1,471 @@
+// DCS Control (0120): synthetic fixtures for the engine-data round (DCS's motion
+// vectors, their class atlas and the cockpit mask as the engine module shares
+// them; the live R71 captures are gone). XRFG_TEST_FG_ENGINE_DATA=1 on NVIDIA
+// hardware. Every scene is drawn exactly at the previous capture (s = 0), the
+// current one (s = 1) and halfway (the truth), from rigid layers (front first),
+// with what DCS's G-buffer holds of it: the opaque layers' motion vectors at
+// the render resolution (`divisor` output pixels a texel; 10 is the periphery's
+// MVs where the composed image shows the focus view, 2 the focus view's own),
+// their class (stencil composition, bit 7 the sky) and the cockpit mask at the
+// same resolution. Transparent layers (smoke, particles, the HUD) have none.
+// The images are the swapchain's bytes, so every error here is in sRGB units
+// (0-255), per region of the true middle frame:
+//   model     an aircraft (DCS's model class) and 4 px around it
+//   trailing  what a model covers at one of the two real frames but not at the
+//             middle one (its disocclusion and occlusion zones)
+//   wires     power lines nearer than the terrain, 2 px around them
+//   cockpit   6 px of the world beside the cockpit's edge (not the cockpit)
+//   hud       the HUD's strokes (still, drawn over the world, no MVs)
+//   smoke     a smoke puff drifting against the world (no MVs)
+//   particles small bright sparks flying across (no MVs)
+//   rest      everything else; all: every pixel.
+// Each case is composed by the optical flow alone ([ofxr] dcs_motion off) and
+// along the MVs, with the variants a test asks for (preset, MV texel, cell).
+// XRFG_TEST_FG_ENGINE_DATA's value picks them: "fast" adds the Fast preset,
+// "cell" the MV texel against the resample's cell (focus MVs), "x4" four
+// times the size, "smooth" a fast roll over a nearly flat sky instead.
+
+struct FeLayer {
+    int texture;       // occlusion_texture's layer
+    double scale;      // texture coordinates per pixel
+    double roll;       // radians at s = 1, about the image centre
+    double dx, dy;     // pixels at s = 1
+    int shape;         // fe_cover
+    std::uint8_t klass;
+    double alpha;      // 1 opaque; below, transparent
+    bool opaque;       // in the G-buffer (MVs, class)
+    std::array<double, 3> tint;
+};
+
+// Region ids of FeFrame::front's layers are their indices; these name the shapes.
+enum FeShape : int {
+    kFeFull = 0, kFeWires = 1, kFeModelLow = 2, kFeModelHigh = 3, kFeSmoke = 4, kFeTerrain = 5,
+    kFeCockpit = 6, kFeHud = 7, kFeParticles = 8,
+};
+
+double fe_cover(int shape, double u, double v, double w, double h) {
+    switch (shape) {
+    case kFeWires: {
+        const double line1 = h * 0.40 + 0.06 * (u - w * 0.5);
+        const double line2 = h * 0.58 - 0.04 * (u - w * 0.5);
+        return std::abs(v - line1) < 0.9 || std::abs(v - line2) < 0.7 ? 1.0 : 0.0;
+    }
+    case kFeModelLow: { // an aircraft over the terrain: fuselage and wings
+        const double cx = w * 0.36, cy = h * 0.70;
+        const bool body = std::abs(v - cy) < 9.0 && std::abs(u - cx) < 52.0;
+        const bool wing = std::abs(u - cx + 6.0) < 12.0 + 0.0 * v && std::abs(v - cy) < 40.0;
+        const bool tail = std::abs(u - cx + 46.0) < 6.0 && std::abs(v - cy) < 18.0;
+        return body || wing || tail ? 1.0 : 0.0;
+    }
+    case kFeModelHigh: { // another one in the sky
+        const double cx = w * 0.62, cy = h * 0.22;
+        const bool body = std::abs(v - cy) < 7.0 && std::abs(u - cx) < 40.0;
+        const bool wing = std::abs(u - cx + 4.0) < 9.0 && std::abs(v - cy) < 30.0;
+        return body || wing ? 1.0 : 0.0;
+    }
+    case kFeSmoke: {
+        const double r = std::hypot(u - w * 0.58, v - h * 0.55) / 70.0;
+        return r < 1.0 ? (1.0 - r * r) : 0.0;
+    }
+    case kFeTerrain: // terrain below a sloped horizon
+        return v > h * 0.45 + 0.08 * (u - w * 0.5) ? 1.0 : 0.0;
+    case kFeCockpit: { // a canopy strut and the panel's top edge
+        const bool strut = u > w * 0.12 - 0.25 * (v - h * 0.5) && u < w * 0.12 - 0.25 * (v - h * 0.5) + 14.0;
+        const bool panel = v > h * 0.86 + 0.02 * (u - w * 0.5);
+        return strut || panel ? 1.0 : 0.0;
+    }
+    case kFeHud: {
+        const bool box = u >= w * 0.40 && u < w * 0.60 && v >= h * 0.30 && v < h * 0.46 &&
+            (u < w * 0.40 + 2.0 || u >= w * 0.60 - 2.0 || v < h * 0.30 + 2.0 || v >= h * 0.46 - 2.0);
+        const bool cross = (std::abs(u - w * 0.5) < 1.0 && std::abs(v - h * 0.38) < 14.0) ||
+            (std::abs(v - h * 0.38) < 1.0 && std::abs(u - w * 0.5) < 14.0);
+        return box || cross ? 1.0 : 0.0;
+    }
+    case kFeParticles: { // a cluster of 3 px sparks
+        for (int i = 0; i < 36; ++i) {
+            const double px = w * 0.72 + 70.0 * std::sin(i * 2.399), py = h * 0.66 + 45.0 * std::cos(i * 1.711);
+            if (std::abs(u - px) < 1.5 && std::abs(v - py) < 1.5) return 1.0;
+        }
+        return 0.0;
+    }
+    default:
+        return 1.0;
+    }
+}
+
+std::array<double, 2> fe_texture_point(const FeLayer& layer, double x, double y, double s, double w, double h) {
+    const double a = -layer.roll * s;
+    const double px = x - w * 0.5 - layer.dx * s;
+    const double py = y - h * 0.5 - layer.dy * s;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5, std::sin(a) * px + std::cos(a) * py + h * 0.5};
+}
+
+std::array<double, 2> fe_screen_point(const FeLayer& layer, double u, double v, double s, double w, double h) {
+    const double a = layer.roll * s;
+    const double px = u - w * 0.5, py = v - h * 0.5;
+    return {std::cos(a) * px - std::sin(a) * py + w * 0.5 + layer.dx * s,
+        std::sin(a) * px + std::cos(a) * py + h * 0.5 + layer.dy * s};
+}
+
+std::array<double, 3> fe_colour(const FeLayer& layer, double u, double v) {
+    if (layer.shape == kFeHud || layer.shape == kFeParticles) return layer.tint; // flat bright
+    const auto texel = occlusion_texture(u * layer.scale, v * layer.scale, layer.texture);
+    return {texel[0] * layer.tint[0], texel[1] * layer.tint[1], texel[2] * layer.tint[2]};
+}
+
+struct FeFrame {
+    StereoPattern image;
+    std::vector<std::int8_t> front; // the front layer's index (a transparent one where it covers > 0.3)
+};
+
+FeFrame fe_frame(const std::vector<FeLayer>& layers, UINT width, UINT height, double s) {
+    FeFrame frame;
+    frame.front.assign(static_cast<std::size_t>(width) * height, -1);
+    std::vector<std::uint8_t> bytes(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+    const double w = width, h = height;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const double cx = x + 0.5, cy = y + 0.5;
+            std::array<double, 3> colour{0.0, 0.0, 0.0};
+            std::size_t base = layers.size();
+            for (std::size_t index = 0; index < layers.size(); ++index) {
+                const FeLayer& layer = layers[index];
+                if (!layer.opaque) continue;
+                const auto uv = fe_texture_point(layer, cx, cy, s, w, h);
+                if (fe_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) {
+                    colour = fe_colour(layer, uv[0], uv[1]);
+                    base = index;
+                    break;
+                }
+            }
+            std::int8_t front = static_cast<std::int8_t>(base);
+            for (std::size_t index = base; index-- > 0;) {
+                const FeLayer& layer = layers[index];
+                if (layer.opaque) continue;
+                const auto uv = fe_texture_point(layer, cx, cy, s, w, h);
+                const double cover = fe_cover(layer.shape, uv[0], uv[1], w, h) * layer.alpha;
+                if (cover > 0.0) {
+                    const auto overlay = fe_colour(layer, uv[0], uv[1]);
+                    for (int c = 0; c < 3; ++c) colour[c] += (overlay[c] - colour[c]) * cover;
+                    if (cover > 0.3) front = static_cast<std::int8_t>(index);
+                }
+            }
+            frame.front[static_cast<std::size_t>(y) * width + x] = front;
+            const std::size_t i = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+            for (int c = 0; c < 3; ++c) bytes[i + c] = static_cast<std::uint8_t>(std::clamp(colour[c], 0.0, 255.0) + 0.5);
+            bytes[i + 3] = 255;
+        }
+    }
+    for (UINT eye = 0; eye < kEyeCount; ++eye) frame.image[eye] = bytes;
+    return frame;
+}
+
+// The current frame's mask frame as the consumer hands it on: the cockpit mask
+// and, `with_motion`, the MVs and classes at the render resolution (`divisor`),
+// pointing at `previous_display_time`; the current frame is the scene at s =
+// `from`, the previous one at `to`.
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> fe_mask_frame(D3D12WarpFixture& fixture, const std::vector<FeLayer>& layers,
+    UINT width, UINT height, UINT divisor, UINT mask_divisor, const ReprojectionViews& views, std::int64_t display_time,
+    std::int64_t previous_display_time, bool with_motion, const std::shared_ptr<xrfg::CockpitMaskPairCounters>& counters,
+    double from = 1.0, double to = 0.0) {
+    const double w = width, h = height;
+    std::vector<std::uint8_t> cockpit(static_cast<std::size_t>(width) * height, 0);
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            for (const FeLayer& layer : layers) {
+                if (!layer.opaque) continue;
+                const auto uv = fe_texture_point(layer, x + 0.5, y + 0.5, from, w, h);
+                if (fe_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) {
+                    cockpit[static_cast<std::size_t>(y) * width + x] = (layer.klass & 7U) == 5U ? 1 : 0;
+                    break;
+                }
+            }
+        }
+    }
+    auto frame = make_cockpit_mask_frame(fixture, width, height, cockpit, mask_divisor, views);
+    frame->display_time = display_time;
+    frame->counters = counters;
+    if (!with_motion) return frame;
+    const UINT d = divisor;
+    const UINT rw = (width + d - 1U) / d, rh = (height + d - 1U) / d;
+    std::vector<std::uint8_t> motion(static_cast<std::size_t>(rw) * kEyeCount * rh * 4U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(rw) * kEyeCount * rh, 0);
+    for (UINT j = 0; j < rh; ++j) {
+        for (UINT i = 0; i < rw; ++i) {
+            const double x = (i + 0.5) * d, y = (j + 0.5) * d;
+            float mx = 0.0F, my = 0.0F;
+            std::uint8_t klass = 7;
+            for (const FeLayer& layer : layers) {
+                if (!layer.opaque) continue;
+                const auto uv = fe_texture_point(layer, x, y, from, w, h);
+                if (fe_cover(layer.shape, uv[0], uv[1], w, h) > 0.5) {
+                    const auto then = fe_screen_point(layer, uv[0], uv[1], to, w, h);
+                    mx = static_cast<float>((then[0] - x) / d);
+                    my = static_cast<float>((then[1] - y) / d);
+                    klass = layer.klass;
+                    break;
+                }
+            }
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const std::size_t texel = static_cast<std::size_t>(j) * rw * kEyeCount + eye * rw + i;
+                const std::uint16_t hx = dcs_motion_half(mx), hy = dcs_motion_half(my);
+                std::memcpy(&motion[texel * 4U], &hx, 2);
+                std::memcpy(&motion[texel * 4U + 2U], &hy, 2);
+                classes[texel] = klass;
+            }
+        }
+    }
+    frame->motion_texture = upload_depth_test_texture(fixture, rw * kEyeCount, rh, DXGI_FORMAT_R16G16_FLOAT, 4, motion);
+    frame->motion_class_texture = upload_depth_test_texture(fixture, rw * kEyeCount, rh, DXGI_FORMAT_R8_UINT, 1, classes);
+    frame->motion = true;
+    frame->motion_class = true;
+    frame->motion_previous_display_time = previous_display_time;
+    frame->motion_slot_flags = 0x80U | 0x40U | 0x3U;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const auto& fov = views[eye].fov;
+        const float left = std::tan(fov.angle_left), right = std::tan(fov.angle_right);
+        const float up = std::tan(fov.angle_up), down = std::tan(fov.angle_down);
+        auto& view = frame->motion_views[eye];
+        view.valid = true;
+        view.x = eye * rw;
+        view.y = 0;
+        view.width = rw;
+        view.height = rh;
+        // The rect's edges: the last texel may reach past the image.
+        view.fov_tan = {left, left + (right - left) * float(rw * d) / float(width), up,
+            up - (up - down) * float(rh * d) / float(height)};
+    }
+    return frame;
+}
+
+struct FeCase {
+    const char* name;
+    std::vector<FeLayer> layers;
+};
+
+// The flight scene, day (`dark` 1) or night (0.22): sky, terrain, wires, two
+// aircraft, the cockpit's strut and panel, with or without the effects (HUD,
+// smoke, particles). The world rolls 1.5 degrees a pair and slides.
+FeCase fe_flight_case(const char* name, double dark, bool effects) {
+    const double pi = 3.14159265358979;
+    const double roll = 1.5 * pi / 180.0;
+    const std::array<double, 3> grey{dark, dark, dark};
+    FeCase scene{name, {}};
+    if (effects) {
+        scene.layers.push_back({0, 1.0, 0.0, 0.0, 0.0, kFeHud, 0, 1.0, false, {40.0, 255.0, 60.0}});
+        scene.layers.push_back({0, 1.0, 0.0, 34.0, -22.0, kFeParticles, 0, 1.0, false, {255.0, 220.0, 150.0}});
+        scene.layers.push_back({1, 0.5, 0.0, -14.0, 3.0, kFeSmoke, 0, 0.6, false, {1.2 * dark, 1.2 * dark, 1.2 * dark}});
+    }
+    scene.layers.push_back({2, 1.0, 0.0, 0.0, 0.0, kFeCockpit, 5, 1.0, true, {0.5 * dark, 0.5 * dark, 0.55 * dark}});
+    scene.layers.push_back({1, 1.0, roll, 26.0, -6.0, kFeModelLow, 1, 1.0, true, {0.8 * dark, 0.8 * dark, 0.9 * dark}});
+    scene.layers.push_back({1, 1.0, roll, -30.0, 8.0, kFeModelHigh, 1, 1.0, true, {0.6 * dark, 0.6 * dark, 0.65 * dark}});
+    scene.layers.push_back({1, 1.0, roll, 14.0, 7.0, kFeWires, 0, 1.0, true, {0.3 * dark, 0.3 * dark, 0.3 * dark}});
+    scene.layers.push_back({0, 1.0, roll, 6.0, 9.0, kFeTerrain, 0, 1.0, true, grey});
+    scene.layers.push_back({3, 0.35, roll, 0.0, 0.0, kFeFull, 0x80, 1.0, true, {0.6 * dark, 0.75 * dark, 1.1 * dark}});
+    return scene;
+}
+
+struct FeRegions {
+    std::vector<std::string> names;
+    std::vector<std::vector<std::uint8_t>> masks; // per pixel
+};
+
+FeRegions fe_regions(const FeCase& scene, UINT width, UINT height) {
+    const FeFrame f0 = fe_frame(scene.layers, width, height, 0.0);
+    const FeFrame fm = fe_frame(scene.layers, width, height, 0.5);
+    const FeFrame f1 = fe_frame(scene.layers, width, height, 1.0);
+    const std::size_t n = static_cast<std::size_t>(width) * height;
+    const auto shape_at = [&](const FeFrame& f, std::size_t i) {
+        return f.front[i] < 0 ? -1 : scene.layers[static_cast<std::size_t>(f.front[i])].shape;
+    };
+    const auto grow = [&](const std::function<bool(std::size_t)>& of, int r) {
+        std::vector<std::uint8_t> mask(n, 0);
+        for (int y = 0; y < int(height); ++y) {
+            for (int x = 0; x < int(width); ++x) {
+                if (!of(static_cast<std::size_t>(y) * width + x)) continue;
+                for (int dy = -r; dy <= r; ++dy) {
+                    for (int dx = -r; dx <= r; ++dx) {
+                        const int sx = x + dx, sy = y + dy;
+                        if (sx < 0 || sy < 0 || sx >= int(width) || sy >= int(height)) continue;
+                        mask[static_cast<std::size_t>(sy) * width + sx] = 1;
+                    }
+                }
+            }
+        }
+        return mask;
+    };
+    const auto is_model = [&](const FeFrame& f, std::size_t i) {
+        const int s = shape_at(f, i);
+        return s == kFeModelLow || s == kFeModelHigh;
+    };
+    FeRegions r;
+    const auto cockpit = grow([&](std::size_t i) { return shape_at(fm, i) == kFeCockpit; }, 0);
+    const auto cockpit_band = grow([&](std::size_t i) { return shape_at(fm, i) == kFeCockpit; }, 6);
+    auto model = grow([&](std::size_t i) { return is_model(fm, i); }, 4);
+    std::vector<std::uint8_t> trailing(n, 0), uncovered(n, 0), covered(n, 0);
+    for (std::size_t i = 0; i < n; ++i) {
+        trailing[i] = !is_model(fm, i) && (is_model(f0, i) || is_model(f1, i));
+        // Seen at the middle frame and in the current frame alone (a model
+        // hid it in the previous one: behind a model), or in the previous
+        // frame alone (a model hides it in the current one: ahead of it).
+        uncovered[i] = !is_model(fm, i) && is_model(f0, i) && !is_model(f1, i);
+        covered[i] = !is_model(fm, i) && is_model(f1, i) && !is_model(f0, i);
+    }
+    auto wires = grow([&](std::size_t i) { return shape_at(fm, i) == kFeWires; }, 2);
+    auto hud = grow([&](std::size_t i) { return shape_at(fm, i) == kFeHud; }, 1);
+    auto smoke = grow([&](std::size_t i) { return shape_at(fm, i) == kFeSmoke; }, 0);
+    auto particles = grow([&](std::size_t i) { return shape_at(fm, i) == kFeParticles; }, 2);
+    std::vector<std::uint8_t> band(n, 0), rest(n, 0), all(n, 1);
+    for (std::size_t i = 0; i < n; ++i) {
+        band[i] = cockpit_band[i] && !cockpit[i];
+        model[i] = model[i] && !cockpit[i];
+        rest[i] = !(model[i] || trailing[i] || wires[i] || band[i] || hud[i] || smoke[i] || particles[i] || cockpit[i]);
+    }
+    const std::array<std::pair<const char*, std::vector<std::uint8_t>*>, 11> list{{{"model", &model},
+        {"trailing", &trailing}, {"behind", &uncovered}, {"ahead", &covered}, {"wires", &wires}, {"cockpit", &band}, {"hud", &hud}, {"smoke", &smoke},
+        {"particles", &particles}, {"rest", &rest}, {"all", &all}}};
+    for (const auto& [name, mask] : list) {
+        std::size_t count = 0;
+        for (std::size_t i = 32U * width; i + 32U * width < n; ++i) count += (*mask)[i];
+        if (count == 0) continue;
+        r.names.emplace_back(name);
+        r.masks.push_back(*mask);
+    }
+    return r;
+}
+
+struct FeVariant {
+    std::string name;
+    bool motion{};
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    UINT divisor{2};
+    UINT cell{};       // XRFG_TEST_DCS_MOTION_CELL (0: the image's own)
+    UINT mask_divisor{}; // the cockpit mask's texel (0: the MVs')
+};
+
+struct FeResult {
+    std::vector<DepthTestError> errors; // per region
+    double along{};                     // share of the counted pixels composed along the MVs
+    double fallback{};                  // ... back to the flow
+    StereoPattern image;
+};
+
+FeResult fe_run(D3D12WarpFixture& fixture, const FeCase& scene, const FeRegions& regions, const FeVariant& variant,
+    UINT width, UINT height) {
+    const ReprojectionViews views = make_reprojection_views();
+    const FeFrame a = fe_frame(scene.layers, width, height, 0.0);
+    const FeFrame b = fe_frame(scene.layers, width, height, 1.0);
+    const FeFrame truth = fe_frame(scene.layers, width, height, 0.5);
+    auto counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    const UINT mask_divisor = variant.mask_divisor != 0 ? variant.mask_divisor : variant.divisor;
+    // The previous frame carries its own MVs and classes too (every DCS frame
+    // does), pointing at the frame before it.
+    const auto previous = fe_mask_frame(fixture, scene.layers, width, height, variant.divisor, mask_divisor, views, 1000,
+        500, variant.motion, counters, 0.0, -1.0);
+    const auto current = fe_mask_frame(fixture, scene.layers, width, height, variant.divisor, mask_divisor, views, 2000,
+        1000, variant.motion, counters);
+    xrfg::D3D12NvidiaOpticalFlowOptions options = variant.options;
+    options.dcs_motion = variant.motion;
+    FeResult result;
+    const std::string cell = std::to_string(variant.cell);
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", variant.cell != 0 ? cell.c_str() : nullptr);
+    result.image = synthesize_nvidia_pair(fixture, a.image, b.image, width, height, options, {previous, current});
+    SetEnvironmentVariableA("XRFG_TEST_DCS_MOTION_CELL", nullptr);
+    for (std::size_t r = 0; r < regions.masks.size(); ++r) {
+        const auto& mask = regions.masks[r];
+        result.errors.push_back(depth_test_error(result.image, truth.image, width, height,
+            [&](UINT, UINT x, UINT y) { return mask[static_cast<std::size_t>(y) * width + x] != 0; }));
+    }
+    const double pixels = 2.0 * width * height;
+    result.along = double(counters->motion_pixels.load()) / pixels;
+    result.fallback = double(counters->motion_fallback_pixels.load()) / pixels;
+    return result;
+}
+
+void fe_print(const std::string& label, const FeRegions& regions, const FeResult& result) {
+    std::cout << "fe " << label;
+    for (std::size_t r = 0; r < regions.names.size(); ++r) {
+        char mae[32]{};
+        std::snprintf(mae, sizeof(mae), "%.2f", result.errors[r].mae);
+        std::cout << " | " << regions.names[r] << " " << mae << " p99 " << result.errors[r].p99;
+    }
+    std::cout << " | along " << int(100.0 * result.along + 0.5) << "% fallback "
+              << int(100.0 * result.fallback + 0.5) << "%" << std::endl;
+}
+
+// The variants every case is composed with; a later patch adds its own.
+std::vector<FeVariant> fe_variants(const std::string& which) {
+    std::vector<FeVariant> list;
+    xrfg::D3D12NvidiaOpticalFlowOptions medium{};
+    medium.occlusion_aware = 1; // the app's default for Medium, one-way flow
+    xrfg::D3D12NvidiaOpticalFlowOptions fast{};
+    fast.preset = xrfg::D3D12NvidiaPerformancePreset::fast;
+    list.push_back({"flow-medium", false, medium, 2, 0, which.find("cell") != std::string::npos ? 10U : 0U});
+    if (which.find("fast") != std::string::npos) list.push_back({"flow-fast", false, fast, 2});
+    if (which.find("cell") != std::string::npos) {
+        // Focus MVs (E): the periphery's MVs in the focus (texel 10 px) or
+        // the focus view's own (2 px; 1: per pixel), resampled at the cell the
+        // headset's image gets today (8) or a finer one (4).
+        for (UINT cell : {8U, 4U}) {
+            for (UINT divisor : {10U, 2U, 1U}) {
+                list.push_back({"mv c" + std::to_string(cell) + " d" + std::to_string(divisor), true, medium, divisor, cell, 10});
+            }
+        }
+        return list;
+    }
+    for (UINT divisor : {10U, 2U}) {
+        const std::string d = " d" + std::to_string(divisor);
+        list.push_back({"mv-medium" + d, true, medium, divisor});
+        if (which.find("fast") != std::string::npos) list.push_back({"mv-fast" + d, true, fast, divisor});
+    }
+    return list;
+}
+
+void run_fg_engine_data_fixtures() {
+    D3D12WarpFixture fixture(true);
+    char which_buffer[256]{};
+    GetEnvironmentVariableA("XRFG_TEST_FG_ENGINE_DATA", which_buffer, sizeof(which_buffer));
+    const std::string which = which_buffer;
+    // "x4": the scenes at four times the size (2560 x 1920), their motion
+    // four times as many pixels (the flow's search range at a headset's
+    // scale); shapes keep their pixel sizes.
+    const UINT factor = which.find("x4") != std::string::npos ? 4U : 1U;
+    const UINT width = 640U * factor, height = 480U * factor;
+    std::vector<FeCase> cases{fe_flight_case("day", 1.0, false), fe_flight_case("night", 0.22, false),
+        fe_flight_case("day+effects", 1.0, true), fe_flight_case("night+effects", 0.22, true)};
+    if (which.find("smooth") != std::string::npos) {
+        // A fast roll (4 degrees a pair) over a nearly flat sky: little
+        // texture for the flow to match.
+        FeCase smooth = fe_flight_case("smooth sky roll", 1.0, false);
+        for (FeLayer& layer : smooth.layers) {
+            if (layer.klass == 0x80U) layer.scale = 0.02;
+            if (layer.shape != kFeCockpit) layer.roll = 4.0 * 3.14159265358979 / 180.0;
+        }
+        cases = {smooth};
+    }
+    for (FeCase& scene : cases) {
+        for (FeLayer& layer : scene.layers) {
+            layer.dx *= factor;
+            layer.dy *= factor;
+        }
+    }
+    for (const FeCase& scene : cases) {
+        const FeRegions regions = fe_regions(scene, width, height);
+        std::vector<std::pair<FeVariant, FeResult>> results;
+        for (const FeVariant& variant : fe_variants(which)) {
+            results.emplace_back(variant, fe_run(fixture, scene, regions, variant, width, height));
+            fe_print(std::string(scene.name) + " " + variant.name, regions, results.back().second);
+        }
+        // What 0036 shipped holds here too: along the MVs no region is worse
+        // than the flow's by more than the colour checks' blend allows.
+        const auto& flow = results[0].second;
+        for (const auto& [variant, result] : results) {
+            if (!variant.motion) continue;
+            const std::size_t all = regions.names.size() - 1U;
+            require(result.errors[all].mae <= flow.errors[all].mae * 1.10 + 0.5,
+                std::string("fg engine data ") + scene.name + " " + variant.name + ": worse than the flow overall");
+        }
+    }
+    fixture.require_no_debug_errors();
+}
