     return XR_SUCCESS;
 }
 
+// DCS Control (0124): the extension list this layer reads in its own
+// xrCreateApiLayerInstance (the D3D11 bridge's D3D12, the visibility mask),
+// before the next layer has an instance. The next layer's
+// xrGetInstanceProcAddr may not answer XR_NULL_HANDLE: Ultraleap's hand
+// tracking dereferences it and crashed DCS at start below this layer
+// (GitHub #35). The loader answers first, as for a layer above
+// (resolve_global_function). An application that links the loader
+// statically (DCS) exports no loader, and the next layer is asked as before,
+// but a fault in that call or in its enumeration is caught and read as "no
+// list": the instance is then created as the application asked.
+XrResult guarded_null_instance_lookup(
+    PFN_xrGetInstanceProcAddr next,
+    const char* name,
+    PFN_xrVoidFunction* function) noexcept {
+    __try {
+        return next(XR_NULL_HANDLE, name, function);
+    } __except (GetExceptionCode() == EXCEPTION_ACCESS_VIOLATION
+                    ? EXCEPTION_EXECUTE_HANDLER
+                    : EXCEPTION_CONTINUE_SEARCH) {
+        *function = nullptr;
+        return XR_ERROR_FUNCTION_UNSUPPORTED;
+    }
+}
+
+XrResult guarded_enumerate_instance_extensions(
+    PFN_xrEnumerateInstanceExtensionProperties enumerate,
+    std::uint32_t capacity,
+    std::uint32_t* count,
+    XrExtensionProperties* properties) noexcept {
+    __try {
+        return enumerate(nullptr, capacity, count, properties);
+    } __except (GetExceptionCode() == EXCEPTION_ACCESS_VIOLATION
+                    ? EXCEPTION_EXECUTE_HANDLER
+                    : EXCEPTION_CONTINUE_SEARCH) {
+        return XR_ERROR_RUNTIME_FAILURE;
+    }
+}
+
+[[nodiscard]] bool list_extensions_from(
+    PFN_xrEnumerateInstanceExtensionProperties enumerate,
+    std::vector<XrExtensionProperties>& properties) {
+    properties.clear();
+    std::uint32_t count = 0;
+    if (enumerate == nullptr ||
+        XR_FAILED(guarded_enumerate_instance_extensions(enumerate, 0, &count, nullptr)) ||
+        count == 0) {
+        return false;
+    }
+    properties.assign(count, XrExtensionProperties{XR_TYPE_EXTENSION_PROPERTIES});
+    if (XR_FAILED(guarded_enumerate_instance_extensions(
+            enumerate, count, &count, properties.data()))) {
+        properties.clear();
+        return false;
+    }
+    properties.resize(std::min<std::size_t>(count, properties.size()));
+    return true;
+}
+
+[[nodiscard]] bool instance_extensions_before_create(
+    PFN_xrGetInstanceProcAddr next,
+    std::vector<XrExtensionProperties>& properties) {
+    PFN_xrVoidFunction function = nullptr;
+    if (XR_SUCCEEDED(resolve_global_function("xrEnumerateInstanceExtensionProperties", &function)) &&
+        list_extensions_from(
+            reinterpret_cast<PFN_xrEnumerateInstanceExtensionProperties>(function), properties)) {
+        return true;
+    }
+    function = nullptr;
+    return XR_SUCCEEDED(guarded_null_instance_lookup(
+               next, "xrEnumerateInstanceExtensionProperties", &function)) &&
+        list_extensions_from(
+            reinterpret_cast<PFN_xrEnumerateInstanceExtensionProperties>(function), properties);
+}
+
+[[nodiscard]] bool lists_extension(
+    const std::vector<XrExtensionProperties>& properties,
+    std::string_view name) noexcept {
+    return std::any_of(properties.begin(), properties.end(), [name](const auto& property) {
+        return std::string_view(property.extensionName) == name;
+    });
+}
