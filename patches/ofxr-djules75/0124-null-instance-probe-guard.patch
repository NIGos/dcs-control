diff --git a/tests/layer_call_chain.cpp b/tests/layer_call_chain.cpp
index fdf3dcc..82cf958 100644
--- a/tests/layer_call_chain.cpp
+++ b/tests/layer_call_chain.cpp
@@ -2316,10 +2316,18 @@ XRAPI_ATTR XrResult XRAPI_CALL fake_get_instance_proc_addr(
 // xrEnumerateApiLayerProperties without negotiating as a layer or a
 // runtime, and takes the global functions from it when a layer above asks
 // for them with XR_NULL_HANDLE before any instance exists.
+// DCS Control (0124): null-next-fault-noloader hides it, as an application
+// that links the loader statically (DCS) does.
+bool g_fake_loader_hidden = false;
+
 extern "C" XRAPI_ATTR XrResult XRAPI_CALL fake_loader_get_instance_proc_addr(
     XrInstance instance,
     const char* name,
     PFN_xrVoidFunction* function) {
+    if (g_fake_loader_hidden) {
+        *function = nullptr;
+        return XR_ERROR_FUNCTION_UNSUPPORTED;
+    }
     return fake_get_instance_proc_addr(instance, name, function);
 }
 
@@ -3577,9 +3585,123 @@ void two_layer_check(const XrFrameEndInfo* end_info) {
 
 int call_chain_main(int argc, char** argv);
 
+// DCS Control (0124): the layer below OFXR faults when its
+// xrGetInstanceProcAddr is called with XR_NULL_HANDLE (Ultraleap's hand
+// tracking did, and DCS crashed at start: GitHub #35). OFXR must still
+// create the instance: with a loader to ask (null-next-fault) the next
+// layer is never asked; without one (null-next-fault-noloader, as in DCS)
+// the fault is caught and the instance is created as the application asked.
+std::atomic<int> g_null_next_calls{0};
+bool g_null_next_mask_requested = false;
+
+XRAPI_ATTR XrResult XRAPI_CALL faulting_next_get_instance_proc_addr(
+    XrInstance instance,
+    const char* name,
+    PFN_xrVoidFunction* function) {
+    if (instance == XR_NULL_HANDLE) {
+        g_null_next_calls.fetch_add(1);
+        volatile int* const nothing = nullptr;
+        *nothing = 1;
+    }
+    return fake_get_instance_proc_addr(instance, name, function);
+}
+
+XRAPI_ATTR XrResult XRAPI_CALL recording_create_api_layer_instance(
+    const XrInstanceCreateInfo* create_info,
+    const XrApiLayerCreateInfo*,
+    XrInstance* instance) {
+    for (std::uint32_t index = 0; index < create_info->enabledExtensionCount; ++index) {
+        g_null_next_mask_requested = g_null_next_mask_requested ||
+            std::strcmp(create_info->enabledExtensionNames[index], "XR_KHR_visibility_mask") == 0;
+    }
+    *instance = g_instance;
+    return XR_SUCCESS;
+}
+
+int null_next_fault_main(const char* layer_path, bool loader_available) {
+    g_fake_loader_hidden = !loader_available;
+    const HMODULE module = LoadLibraryA(layer_path);
+    if (module == nullptr) {
+        std::cerr << "LoadLibrary failed: " << GetLastError() << '\n';
+        return EXIT_FAILURE;
+    }
+    const auto negotiate = reinterpret_cast<PFN_xrNegotiateLoaderApiLayerInterface>(
+        GetProcAddress(module, "xrNegotiateLoaderApiLayerInterface"));
+    if (negotiate == nullptr) {
+        return EXIT_FAILURE;
+    }
+    XrNegotiateLoaderInfo loader_info{};
+    loader_info.structType = XR_LOADER_INTERFACE_STRUCT_LOADER_INFO;
+    loader_info.structVersion = XR_LOADER_INFO_STRUCT_VERSION;
+    loader_info.structSize = sizeof(loader_info);
+    loader_info.minInterfaceVersion = 1;
+    loader_info.maxInterfaceVersion = XR_CURRENT_LOADER_API_LAYER_VERSION;
+    loader_info.minApiVersion = XR_MAKE_VERSION(1, 0, 0);
+    loader_info.maxApiVersion = XR_CURRENT_API_VERSION;
+    XrNegotiateApiLayerRequest request{};
+    request.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_REQUEST;
+    request.structVersion = XR_API_LAYER_INFO_STRUCT_VERSION;
+    request.structSize = sizeof(request);
+    if (XR_FAILED(negotiate(&loader_info, kLayerName, &request))) {
+        return EXIT_FAILURE;
+    }
+    XrApiLayerNextInfo next_info{};
+    next_info.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_NEXT_INFO;
+    next_info.structVersion = XR_API_LAYER_NEXT_INFO_STRUCT_VERSION;
+    next_info.structSize = sizeof(next_info);
+    strcpy_s(next_info.layerName, kLayerName);
+    next_info.nextGetInstanceProcAddr = faulting_next_get_instance_proc_addr;
+    next_info.nextCreateApiLayerInstance = recording_create_api_layer_instance;
+    XrApiLayerCreateInfo layer_info{};
+    layer_info.structType = XR_LOADER_INTERFACE_STRUCT_API_LAYER_CREATE_INFO;
+    layer_info.structVersion = XR_API_LAYER_CREATE_INFO_STRUCT_VERSION;
+    layer_info.structSize = sizeof(layer_info);
+    layer_info.nextInfo = &next_info;
+    XrInstanceCreateInfo instance_info{XR_TYPE_INSTANCE_CREATE_INFO};
+    strcpy_s(instance_info.applicationInfo.applicationName, "XRFG null next fault test");
+    strcpy_s(instance_info.applicationInfo.engineName, "XRFG tests");
+    instance_info.applicationInfo.apiVersion = XR_MAKE_VERSION(1, 0, 0);
+    const char* const extensions[] = {"XR_KHR_D3D11_enable"};
+    instance_info.enabledExtensionNames = extensions;
+    instance_info.enabledExtensionCount = 1;
+
+    XrInstance instance = XR_NULL_HANDLE;
+    if (XR_FAILED(request.createApiLayerInstance(&instance_info, &layer_info, &instance)) ||
+        instance != g_instance) {
+        std::cerr << "instance not created over a layer that faults on XR_NULL_HANDLE\n";
+        return EXIT_FAILURE;
+    }
+    const int null_calls = g_null_next_calls.load();
+    if (loader_available && (null_calls != 0 || !g_null_next_mask_requested)) {
+        std::cerr << "with a loader the list comes from it (next asked " << null_calls
+                  << " times, mask " << g_null_next_mask_requested << ")\n";
+        return EXIT_FAILURE;
+    }
+    if (!loader_available && (null_calls == 0 || g_null_next_mask_requested)) {
+        std::cerr << "without a loader the faulting next layer is asked, guarded, and "
+                     "nothing is added (asked " << null_calls << " times, mask "
+                  << g_null_next_mask_requested << ")\n";
+        return EXIT_FAILURE;
+    }
+    PFN_xrVoidFunction destroy = nullptr;
+    if (XR_FAILED(request.getInstanceProcAddr(instance, "xrDestroyInstance", &destroy)) ||
+        destroy == nullptr ||
+        XR_FAILED(reinterpret_cast<PFN_xrDestroyInstance>(destroy)(instance))) {
+        std::cerr << "instance not destroyed\n";
+        return EXIT_FAILURE;
+    }
+    std::cout << "PASS null-instance probe " << (loader_available ? "from the loader" : "guarded")
+              << ", next asked " << null_calls << " time(s)\n";
+    return EXIT_SUCCESS;
+}
+
 // Two layers ("two:<scenario>"): the scenario as it is, then the fake
 // runtime's counts of what reached it.
 int main(int argc, char** argv) {
+    if (argc == 4 && (std::strcmp(argv[3], "null-next-fault") == 0 ||
+                      std::strcmp(argv[3], "null-next-fault-noloader") == 0)) {
+        return null_next_fault_main(argv[1], std::strcmp(argv[3], "null-next-fault") == 0);
+    }
     if (argc == 4 && std::strncmp(argv[3], "two:", 4) == 0) {
         g_two_layer_mode = true;
         argv[3] += 4;
