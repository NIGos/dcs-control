+// Foveated layers, round 4: the HUD symbology on two layers
+// (xrfg::hud_layer_eye_input, D3D12FoveatedLink, HudRotation::helmet_by_tangents).
+
+// The layer's input: its own view 1:1, no focus slot, a focus rectangle
+// outside the image; present by its own view alone; the pass rectangle is the
+// view's window.
+void test_hud_layer_inputs() {
+    xrfg::D3D12HudSymbology symbology{};
+    symbology.views[0] = {true, 0, 0, 96, 64, 12, 6, 36, 30, 0};
+    symbology.views[2] = {true, 96, 0, 64, 64, 4, 4, 20, 20, 0};
+    symbology.views[3] = {true, 160, 0, 64, 64, 0, 0, 64, 64, 0};
+    symbology.eyes[0].layout = true;
+    symbology.eyes[0].focus_rect = {0.3F, 0.3F, 0.7F, 0.7F};
+    symbology.focus_smoothing = 0.2F;
+    symbology.focus_shape = 2.0F;
+    const xrfg::HudEyeInput composed = xrfg::hud_eye_input(symbology, 0);
+    require(composed.periphery.present && composed.focus.present && composed.focus_rect[0] == 0.3F &&
+            composed.focus_smoothing == 0.2F && composed.focus_shape == 2.0F,
+        "hud layers: the composed input changed");
+    const xrfg::HudEyeInput periphery = xrfg::hud_layer_eye_input(symbology, 0, false);
+    require(periphery.periphery.present && periphery.periphery.x == 0 && periphery.periphery.out_width == 96 &&
+            periphery.periphery.window_x == 12 && periphery.periphery.window_width == 36 && !periphery.focus.present &&
+            periphery.focus_rect == xrfg::kHudLayerNoFocusRect && periphery.focus_smoothing == 0.0F &&
+            periphery.focus_shape == 0.0F,
+        "hud layers: the periphery layer's input is not its periphery view alone");
+    const xrfg::HudEyeInput focus = xrfg::hud_layer_eye_input(symbology, 0, true);
+    require(focus.periphery.present && focus.periphery.x == 96 && focus.periphery.out_width == 64 &&
+            focus.periphery.window_x == 4 && focus.periphery.window_width == 20 && !focus.focus.present &&
+            focus.focus_rect == xrfg::kHudLayerNoFocusRect,
+        "hud layers: the focus layer's input is not its focus view, 1:1");
+    require(!xrfg::hud_layer_eye_input(symbology, 2, false).periphery.present &&
+            !xrfg::hud_layer_eye_input(symbology, 2, true).periphery.present,
+        "hud layers: an eye that does not exist has an input");
+    // Eye 1: no periphery view, no focus layout, a focus view.
+    require(!symbology.eye_present(1), "hud layers: the composed eye 1 is present without a layout");
+    require(xrfg::hud_layer_eye_present(symbology, 0, false) && xrfg::hud_layer_eye_present(symbology, 0, true) &&
+            !xrfg::hud_layer_eye_present(symbology, 1, false) && xrfg::hud_layer_eye_present(symbology, 1, true) &&
+            !xrfg::hud_layer_eye_present(symbology, 2, true),
+        "hud layers: present is the layer's own view");
+    const D3D12_RECT focus_rect = xrfg::hud_pass_rect(focus, xrfg::HudImageRect{0, 0, 64, 64});
+    const D3D12_RECT periphery_rect = xrfg::hud_pass_rect(periphery, xrfg::HudImageRect{0, 0, 96, 64});
+    require(focus_rect.left == 2 && focus_rect.top == 2 && focus_rect.right == 26 && focus_rect.bottom == 26,
