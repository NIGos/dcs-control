+        kind(layers[0]->views[1].subImage.swapchain, false) != periphery_kind ||
+        kind(layers[1]->views[1].subImage.swapchain, true) != focus_kind) {
+        g_two_layer_shape_wrong.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
