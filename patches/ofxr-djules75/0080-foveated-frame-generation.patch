+// (h) fill = 2. The saccade of (g), but only the world to the right of
+// azimuth 0.30 rad turns (0.025 rad, about 10 focus pixels): the moving part
+// lies wholly in the strip A never saw, so the focus pair's own flow knows
+// nothing of it (fill = 1 leaves B held there) and only the periphery layer's
+// flow does. Against the true frame at the synthetic's time, over the
+// uncovered zone 12 px from the border and 0.05 rad (20 px) clear of the
+// split, 2X and 3X, head still and turned:
+//  - moving part: fill = 2 at most half of fill = 1's error, and fill = 1 at
+//    least 4 codes (the control: its vector is the still world's). GUESSES.
+//  - still part: fill = 2 not more than half a code worse than fill = 1
+//    (GUESS).
+//  - alpha is B's at every byte and the real frame is B (firm).
+//  - with the focus swapchain submitted FIRST there is no flow to read: the
+//    synthetic is fill = 1's, every byte (firm: the fallback).
+void test_focus_fill_from_periphery(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    constexpr float kWorldYaw = 0.025F, kSplit = 0.30F, kClear = 0.05F;
+    constexpr UINT kBorder = 12;
+    const FocusCase& c = kFocusCases[1]; // the saccade
+    for (const bool rotated : {false, true}) for (const bool triple : {false, true}) {
+        const Fill2Run own = run_fill2_pair(fixture, backend, base, 1U, c.a, c.b, rotated, kWorldYaw, kSplit, triple,
+            true);
+        const Fill2Run with_flow = run_fill2_pair(fixture, backend, base, 2U, c.a, c.b, rotated, kWorldYaw, kSplit,
+            triple, true);
+        const Fill2Run late = run_fill2_pair(fixture, backend, base, 2U, c.a, c.b, rotated, kWorldYaw, kSplit,
+            triple, false);
+        require(with_flow.focus_real == with_flow.focus_b, "fill 2: the real frame is not B bit for bit");
+        require(own.synthetics.size() == with_flow.synthetics.size() &&
+                late.synthetics.size() == with_flow.synthetics.size(), "fill 2: outputs missing");
+        const auto views_a = focus_views(c.a, false);
+        const auto views_b = focus_views(c.b, rotated);
+        for (std::size_t s = 0; s < with_flow.synthetics.size(); ++s) {
+            const float time = triple ? static_cast<float>(s + 1U) / 3.0F : 0.5F;
+            const StereoPattern truth =
+                split_world_pattern(views_b, kFocusWidth, kFocusHeight, kWorldYaw * time, kSplit, true);
+            require(late.synthetics[s] == own.synthetics[s],
+                "fill 2: with the focus swapchain first the synthetic is not fill = 1's");
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const float left = std::tan(views_b[eye].fov.angle_left);
+                const float right = std::tan(views_b[eye].fov.angle_right);
+                const float up = std::tan(views_b[eye].fov.angle_up);
+                const float down = std::tan(views_b[eye].fov.angle_down);
+                double error[2][2]{}; // [moving, still][fill 1, fill 2]
+                std::size_t count[2]{};
+                std::size_t alpha_differences = 0;
+                for (UINT y = 0; y < kFocusHeight; ++y) {
+                    for (UINT x = 0; x < kFocusWidth; ++x) {
+                        const std::size_t at = (static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel;
+                        alpha_differences += with_flow.synthetics[s][eye][at + 3] != with_flow.focus_b[eye][at + 3]
+                            ? 1U : 0U;
+                        if (x < kBorder || y < kBorder || x + kBorder >= kFocusWidth || y + kBorder >= kFocusHeight ||
+                            inside_previous_image(views_a[eye], views_b[eye], x, y, kFocusWidth, kFocusHeight) >=
+                                -1.5F) {
+                            continue;
+                        }
+                        const xrfg::Vec3 ray = rotate_vector(views_b[eye].pose.orientation,
+                            {left + (right - left) * (static_cast<float>(x) + 0.5F) / kFocusWidth,
+                                up + (down - up) * (static_cast<float>(y) + 0.5F) / kFocusHeight, -1.0F});
+                        const float azimuth = std::atan2(ray.x, -ray.z);
+                        if (std::abs(azimuth - kSplit) < kClear) continue;
+                        const std::size_t part = azimuth > kSplit ? 0U : 1U;
+                        ++count[part];
+                        for (UINT channel = 0; channel < 3; ++channel) {
+                            const int wanted = truth[eye][at + channel];
+                            error[part][0] += std::abs(static_cast<int>(own.synthetics[s][eye][at + channel]) - wanted);
+                            error[part][1] +=
+                                std::abs(static_cast<int>(with_flow.synthetics[s][eye][at + channel]) - wanted);
+                        }
+                    }
+                }
+                for (std::size_t part = 0; part < 2; ++part) {
+                    const double samples = count[part] != 0 ? static_cast<double>(count[part]) * 3.0 : 1.0;
+                    error[part][0] /= samples;
+                    error[part][1] /= samples;
+                }
+                const std::string what = std::string("focus fill 2 rotated=") + (rotated ? "1" : "0") +
+                    (triple ? " 3X" : " 2X") + " synthetic=" + std::to_string(s) + " eye=" + std::to_string(eye);
+                std::cout << what << ": moving part " << count[0] << " pixels, mae fill 1 " << error[0][0]
+                          << ", fill 2 " << error[0][1] << "; still part " << count[1] << " pixels, fill 1 "
+                          << error[1][0] << ", fill 2 " << error[1][1] << "; alpha bytes not B's "
+                          << alpha_differences << '\n';
+                require(alpha_differences == 0, what + ": the fill changed an alpha");
+                require(count[0] >= 500 && count[1] >= 500, what + ": the zone has no moving or no still part");
+                if (error[0][0] < 4.0 || error[0][1] > 0.5 * error[0][0] || error[1][1] > error[1][0] + 0.5) {
+                    ++g_uncovered_guess_failures;
+                    std::cout << "GUESS EXCEEDED: " << what
+                              << ": the periphery layer's flow did not carry the moving part" << '\n';
+                }
+            }
+        }
+    }
+}
