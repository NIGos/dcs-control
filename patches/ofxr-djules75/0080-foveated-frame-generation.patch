+// Pixels of `region` (both eyes) with a colour byte more than 40 away from
+// `expected`: a cursor missing where it should be, or showing where it should not.
+std::size_t layer_wrong_pixels(const StereoPattern& image, const StereoPattern& expected,
+    const std::array<int, 4>& region) {
+    std::size_t wrong = 0;
+    for (UINT eye = 0; eye < kEyeCount; ++eye)
+        for (int y = region[1]; y < region[3]; ++y)
+            for (int x = region[0]; x < region[2]; ++x) {
+                const std::size_t at = (static_cast<std::size_t>(y) * kLayerWidth + static_cast<std::size_t>(x)) *
+                    kBytesPerPixel;
+                bool differs = false;
+                for (UINT channel = 0; channel < 3; ++channel)
+                    differs = differs || std::abs(static_cast<int>(image[eye][at + channel]) -
+                        static_cast<int>(expected[eye][at + channel])) > 40;
+                wrong += differs ? 1U : 0U;
+            }
+    return wrong;
+}
