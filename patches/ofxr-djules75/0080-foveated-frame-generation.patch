+// Foveated layers: the QUALITY of generated frames, per view against composed.
+// Included by d3d12_history_tests.cpp (XRFG_TEST_FOVEATED_QUALITY=1, NVIDIA
+// hardware). Needs neither a headset nor DCS: every image is made here.
+//
+// A procedural world in tangent space, nothing in it periodic, made from one
+// seed. Each case has a known motion between frame A (time 0) and frame B
+// (time 1), so the TRUE frame at any time between is rendered, not estimated.
+// For each eye the world is rendered as Quad Views would hand it over:
+//   periphery  1040x1028, the eye's FOV
+//   focus      2028x2004, a box of 0.34 of the eye's FOV that follows the gaze,
+//              the fade in alpha (unpremultiplied colour)
+//   composed   5424x5356, what Quad Views submits today: the periphery
+//              enlarged bilinearly and the focus blended over it with the
+//              fade, both in linear light
+// The synthesizer then runs both ways on the same pair:
+//   composed   one instance on the composed images (flow input 50 %)
+//   layers     one instance on the periphery images and one on the focus
+//              images, foveated_layers on (flow 50 %; the periphery also at
+//              100 %); its two synthetics are composed here the way the
+//              headset's compositor blends two layers: on the encoded bytes,
+//              out = a * focus + (1 - a) * periphery, periphery bilinear
+// and every result is compared with the true frame at the synthetic's time,
+// in B's camera and B's focus FOV (what the synthesizer outputs).
+//
+// One line per (case, rate, time, mode, reference, region):
+//   fovq case=... rate=2X|3X t=... mode=... ref=... region=... n=<pixels>
+//        mae=<mean abs error> psnr=<dB> p99=<99th percentile abs error> max=...
+// all in 8-bit codes over R, G, B. See artifacts\foveated\quality-bench.md.
+
+namespace fovq {
+
+struct Fov {
+    double l{}, r{}, u{}, d{}; // tangents: left and down negative
+};
+using EyeFovs = std::array<Fov, kEyeCount>;
+
+// The Pimax Crystal Super's eye FOVs as its runtime reports them (the runtime
+// probe's case files, 2026-11-15).
+constexpr EyeFovs kEyeFov{
+    Fov{-1.52926588, 1.03239238, 1.26479411, -1.26479411},
+    Fov{-1.03239238, 1.52926588, 1.26479411, -1.26479411}};
+constexpr double kSection = 0.34;       // the focus box: this part of the eye's span per axis
+constexpr double kFadeStart = 0.6;      // Quad Views: 1 - 2 * smoothing (0.2)
+constexpr double kBorder = 0.02;        // this part of each image side is left out of the statistics
+constexpr double kPi = 3.14159265358979323846;
+
+// The focus box for a gaze at (ox, oy), in half spans from the eye's centre
+// (runtime-probe's FocusBox, clamped at the eye's borders).
+[[nodiscard]] Fov focus_box(const Fov& eye, double ox, double oy) {
+    const double half_x = 0.5 * (eye.r - eye.l), half_y = 0.5 * (eye.u - eye.d);
+    const double cx = 0.5 * (eye.l + eye.r) + ox * half_x, cy = 0.5 * (eye.u + eye.d) + oy * half_y;
+    Fov box{cx - kSection * half_x, cx + kSection * half_x, cy + kSection * half_y, cy - kSection * half_y};
+    box.l = std::max(box.l, eye.l);
+    box.r = std::min(box.r, eye.r);
+    box.u = std::min(box.u, eye.u);
+    box.d = std::max(box.d, eye.d);
+    return box;
+}
+
+// Quad Views' fade (ProjectionPS.hlsl, runtime-probe common.h FocusAlpha): a
+// superellipse of power 8 in the focus image's NDC, 1 inside radius 0.6, a
+// smoothstep down to 0 at radius 1.
+[[nodiscard]] double focus_alpha(double nx, double ny) noexcept {
+    const double ax = std::abs(nx), ay = std::abs(ny);
+    if (ax >= 1.0 || ay >= 1.0) return 0.0;
+    double x8 = ax * ax, y8 = ay * ay;
+    x8 *= x8; x8 *= x8;
+    y8 *= y8; y8 *= y8;
+    const double radius = std::sqrt(std::sqrt(std::sqrt(x8 + y8)));
+    const double t = std::clamp((radius - kFadeStart) / (1.0 - kFadeStart), 0.0, 1.0);
+    return 1.0 - t * t * (3.0 - 2.0 * t);
+}
+
+struct Tables {
+    std::array<double, 256> decode{};        // sRGB byte -> linear
+    std::array<std::uint8_t, 4097> encode{}; // linear * 4096 -> sRGB byte
+};
+[[nodiscard]] const Tables& tables() {
+    static const Tables built = [] {
+        Tables t;
+        for (int i = 0; i < 256; ++i) {
+            const double v = i / 255.0;
+            t.decode[static_cast<std::size_t>(i)] = v <= 0.04045 ? v / 12.92 : std::pow((v + 0.055) / 1.055, 2.4);
+        }
+        for (int i = 0; i <= 4096; ++i) {
+            const double v = i / 4096.0;
+            const double s = v <= 0.0031308 ? v * 12.92 : 1.055 * std::pow(v, 1.0 / 2.4) - 0.055;
+            t.encode[static_cast<std::size_t>(i)] = static_cast<std::uint8_t>(s * 255.0 + 0.5);
+        }
+        return t;
+    }();
+    return built;
+}
+[[nodiscard]] inline std::uint8_t encode_linear(double linear) noexcept {
+    const double q = linear < 0.0 ? 0.0 : (linear > 1.0 ? 1.0 : linear);
+    return tables().encode[static_cast<std::size_t>(q * 4096.0 + 0.5)];
+}
+
+[[nodiscard]] unsigned worker_count() noexcept {
+    // All cores but one, or XRFG_FOVEATED_QUALITY_WORKERS.
+    static const unsigned count = [] {
+        char text[16]{};
+        const DWORD length = GetEnvironmentVariableA("XRFG_FOVEATED_QUALITY_WORKERS", text, sizeof(text));
+        const unsigned long asked = length > 0 && length < sizeof(text) ? std::strtoul(text, nullptr, 10) : 0UL;
+        const unsigned n = std::thread::hardware_concurrency();
+        const unsigned automatic = n > 2 ? std::min(n - 1U, 32U) : 1U;
+        return asked >= 1UL && asked <= 64UL ? static_cast<unsigned>(asked) : automatic;
+    }();
+    return count;
+}
+// fn(row, worker) for every row, on all cores but one.
+template <typename Fn>
+void parallel_rows(UINT height, Fn&& fn) {
+    const unsigned workers = worker_count();
+    if (workers == 1) {
+        for (UINT y = 0; y < height; ++y) fn(y, 0U);
+        return;
+    }
+    std::vector<std::thread> threads;
+    threads.reserve(workers);
+    for (unsigned w = 0; w < workers; ++w) {
+        threads.emplace_back([&fn, w, workers, height] {
+            for (UINT y = w; y < height; y += workers) fn(y, w);
+        });
+    }
+    for (std::thread& thread : threads) thread.join();
+}
+
+// ---------------------------------------------------------------- the world
+
+[[nodiscard]] inline std::uint32_t hash_cell(std::int32_t x, std::int32_t y, std::uint32_t salt) noexcept {
+    std::uint32_t h = static_cast<std::uint32_t>(x) * 0x8da6b343U ^ static_cast<std::uint32_t>(y) * 0xd8163841U ^
+        salt * 0xcb1ab31fU;
+    h ^= h >> 15; h *= 0x2c1b3c6dU;
+    h ^= h >> 12; h *= 0x297a2d39U;
+    h ^= h >> 15;
+    return h;
+}
+[[nodiscard]] inline double unit(std::uint32_t h) noexcept { return h * (1.0 / 4294967296.0); }
+
+// Value noise on a hashed lattice: no table, so no period.
+[[nodiscard]] double value_noise(double x, double y, double cell, std::uint32_t salt) noexcept {
+    const double fx = x / cell, fy = y / cell;
+    const double bx = std::floor(fx), by = std::floor(fy);
+    const auto ix = static_cast<std::int32_t>(bx), iy = static_cast<std::int32_t>(by);
+    double a = fx - bx, b = fy - by;
+    a = a * a * (3.0 - 2.0 * a);
+    b = b * b * (3.0 - 2.0 * b);
+    const double v00 = unit(hash_cell(ix, iy, salt)), v10 = unit(hash_cell(ix + 1, iy, salt));
+    const double v01 = unit(hash_cell(ix, iy + 1, salt)), v11 = unit(hash_cell(ix + 1, iy + 1, salt));
+    return (v00 * (1.0 - a) + v10 * a) * (1.0 - b) + (v01 * (1.0 - a) + v11 * a) * b;
+}
+// The same, band limited for an image of ppt pixels per unit of tangent: an
+// octave whose cell is under about 1.5 pixels is its mean, so a low-resolution
+// view is a filtered view of the world and not an aliased one.
+[[nodiscard]] double octave(double x, double y, double cell, std::uint32_t salt, double ppt) noexcept {
+    const double weight = std::clamp((cell * ppt - 1.5) / 2.5, 0.0, 1.0);
+    if (weight <= 0.0) return 0.5;
+    return 0.5 + (value_noise(x, y, cell, salt) - 0.5) * weight;
+}
+// Coverage of a pixel (a box of 1 / ppt) by a half plane, and by a strip of
+// half width `half` whose centre line is `distance` away. A strip thinner
+// than a pixel covers its width, not a half.
+[[nodiscard]] inline double edge(double inside_distance, double ppt) noexcept {
+    return std::clamp(inside_distance * ppt + 0.5, 0.0, 1.0);
+}
+[[nodiscard]] inline double strip(double distance, double half, double ppt) noexcept {
+    return edge(half - distance, ppt) - edge(-half - distance, ppt);
+}
+[[nodiscard]] inline double disc(double distance, double radius, double ppt) noexcept {
+    return std::min(strip(distance, radius, ppt), kPi * radius * radius * ppt * ppt);
+}
+inline void over(double rgb[3], const double colour[3], double coverage) noexcept {
+    for (int c = 0; c < 3; ++c) rgb[c] += (colour[c] - rgb[c]) * coverage;
+}
+inline void over(double rgb[3], double grey, double coverage) noexcept {
+    for (int c = 0; c < 3; ++c) rgb[c] += (grey - rgb[c]) * coverage;
+}
+
+struct Line {
+    double px, py, nx, ny, half; // a point, the unit normal, the half width
+    double colour[3];
+};
+struct Object {
+    double x, y;      // centre at time 0
+    double depth;     // its speed is the case's object speed times this (parallax)
+    double a, b;      // disc: radius a. Rectangle: half length a, half width b
+    double cs, sn;    // the rectangle's direction
+    bool round;
+    double colour[3];
+    std::uint32_t salt;
+};
+
+class World {
+public:
+    explicit World(std::uint32_t seed) : seed_(seed), state_(0x5CE11E5EEDULL ^ (static_cast<std::uint64_t>(seed) << 20)) {
+        // Thin high-contrast structures of the far world (roads, wires, a
+        // horizon line): long lines one to five composed pixels wide.
+        for (int i = 0; i < 14; ++i) {
+            Line line{};
+            line.px = (next() * 2.0 - 1.0) * 1.2;
+            line.py = (next() * 2.0 - 1.0) * 1.0;
+            const double angle = next() * kPi;
+            line.nx = std::cos(angle);
+            line.ny = std::sin(angle);
+            line.half = 0.0003 + 0.0009 * next();
+            const double level = next() < 0.3 ? 0.008 : 0.65 + 0.35 * next();
+            const double warm = next();
+            line.colour[0] = level;
+            line.colour[1] = level * (0.85 + 0.15 * warm);
+            line.colour[2] = level * (0.6 + 0.4 * warm);
+            lines_.push_back(line);
+        }
+        // The object layer: textured discs and bars from aircraft-sized to
+        // large, opaque, each at its own depth.
+        const auto add = [this](double x, double y, double depth, bool round, double a, double b, double angle) {
+            Object object{};
+            object.x = x; object.y = y; object.depth = depth; object.round = round;
+            object.a = a; object.b = b; object.cs = std::cos(angle); object.sn = std::sin(angle);
+            const double level = next() < 0.35 ? 0.02 + 0.04 * next() : 0.35 + 0.6 * next();
+            object.colour[0] = level * (0.6 + 0.4 * next());
+            object.colour[1] = level * (0.7 + 0.3 * next());
+            object.colour[2] = level * (0.6 + 0.4 * next());
+            object.salt = static_cast<std::uint32_t>(next() * 4294967295.0);
+            objects_.push_back(object);
+        };
+        for (int i = 0; i < 44; ++i) {
+            const double x = (next() * 2.0 - 1.0) * 1.9, y = (next() * 2.0 - 1.0) * 1.5;
+            const double depth = 0.5 + next();
+            if (next() < 0.4) {
+                add(x, y, depth, true, 0.025 + 0.085 * next(), 0.0, 0.0);
+            } else {
+                add(x, y, depth, false, 0.03 + 0.13 * next(), 0.004 + 0.026 * next(), next() * kPi);
+            }
+        }
+        // And, for each eye's resting focus box, objects that are sure to be
+        // in its interior, across its fade and small ("an aircraft").
+        for (const Fov& eye : kEyeFov) {
+            const Fov box = focus_box(eye, 0.10, 0.05);
+            const double cx = 0.5 * (box.l + box.r), cy = 0.5 * (box.u + box.d), hx = 0.5 * (box.r - box.l);
+            add(cx + 0.06, cy - 0.03, 1.0, true, 0.06, 0.0, 0.0);
+            add(cx + 0.83 * hx, cy + 0.10, 1.2, false, 0.14, 0.006, 0.3);
+            add(cx - 0.15, cy + 0.12, 0.8, false, 0.012, 0.003, 0.5);
+            add(cx - 0.80 * hx, cy - 0.15, 1.0, true, 0.035, 0.0, 0.0);
+        }
+    }
+
+    [[nodiscard]] std::uint32_t seed() const noexcept { return seed_; }
+
+    // Linear-light colour of the far world at tangent (x, y).
+    void backdrop(double x, double y, double ppt, double rgb[3]) const noexcept {
+        const std::uint32_t s = seed_ * 131U;
+        const double l = 0.34 * octave(x, y, 0.25, s + 1U, ppt) + 0.26 * octave(x, y, 0.09, s + 2U, ppt) +
+            0.18 * octave(x, y, 0.035, s + 3U, ppt) + 0.13 * octave(x, y, 0.013, s + 4U, ppt) +
+            0.09 * octave(x, y, 0.005, s + 5U, ppt);
+        const double level = 0.04 + 0.34 * l;
+        rgb[0] = level * (1.0 - 0.4 * value_noise(x, y, 0.3, s + 7U));
+        rgb[1] = level;
+        rgb[2] = level * (1.0 - 0.4 * value_noise(x, y, 0.3, s + 8U));
+        // Blobs: at most one per cell, darker or brighter than the ground.
+        constexpr double kBlobCell = 0.06;
+        const auto ci = static_cast<std::int32_t>(std::floor(x / kBlobCell));
+        const auto cj = static_cast<std::int32_t>(std::floor(y / kBlobCell));
+        for (std::int32_t j = cj - 1; j <= cj + 1; ++j) {
+            for (std::int32_t i = ci - 1; i <= ci + 1; ++i) {
+                if (unit(hash_cell(i, j, s + 11U)) < 0.3) continue;
+                const double q = unit(hash_cell(i, j, s + 14U));
+                const double radius = 0.024 * (0.15 + 0.85 * q * q);
+                const double bx = (i + unit(hash_cell(i, j, s + 12U))) * kBlobCell;
+                const double by = (j + unit(hash_cell(i, j, s + 13U))) * kBlobCell;
+                const double distance = std::hypot(x - bx, y - by);
+                if (distance > radius + 2.0 / ppt) continue;
+                const double pick = unit(hash_cell(i, j, s + 15U));
+                const double value = pick < 0.45 ? 0.01 + 0.06 * pick / 0.45 : 0.30 + 0.70 * (pick - 0.45) / 0.55;
+                const double colour[3]{value * (1.0 - 0.6 * unit(hash_cell(i, j, s + 16U))), value,
+                    value * (1.0 - 0.6 * unit(hash_cell(i, j, s + 17U)))};
+                over(rgb, colour, disc(distance, radius, ppt));
+            }
+        }
+        for (const Line& line : lines_) {
+            const double distance = std::abs((x - line.px) * line.nx + (y - line.py) * line.ny);
+            if (distance > line.half + 2.0 / ppt) continue;
+            over(rgb, line.colour, strip(distance, line.half, ppt));
+        }
+        // Bright dots: far aircraft and lights, 3 to 12 composed pixels across.
+        constexpr double kDotCell = 0.11;
+        const auto di = static_cast<std::int32_t>(std::floor(x / kDotCell));
+        const auto dj = static_cast<std::int32_t>(std::floor(y / kDotCell));
+        if (unit(hash_cell(di, dj, s + 21U)) < 0.6) {
+            const double radius = 0.0008 + 0.002 * unit(hash_cell(di, dj, s + 22U));
+            // Kept inside its cell, so one cell is enough.
+            const double dx = (di + 0.1 + 0.8 * unit(hash_cell(di, dj, s + 23U))) * kDotCell;
+            const double dy = (dj + 0.1 + 0.8 * unit(hash_cell(di, dj, s + 24U))) * kDotCell;
+            const double distance = std::hypot(x - dx, y - dy);
+            if (distance <= radius + 2.0 / ppt) {
+                const double colour[3]{1.0, 0.95, 0.8};
+                over(rgb, colour, disc(distance, radius, ppt));
+            }
+        }
+    }
+
+    // The object layer over rgb; every object displaced by (shift) * its depth.
+    void objects(double x, double y, double shift_x, double shift_y, double ppt, double rgb[3]) const noexcept {
+        for (const Object& object : objects_) {
+            const double dx = x - (object.x + shift_x * object.depth);
+            const double dy = y - (object.y + shift_y * object.depth);
+            const double reach = (object.round ? object.a : object.a + object.b) + 2.0 / ppt;
+            if (std::abs(dx) > reach || std::abs(dy) > reach) continue;
+            const double along = dx * object.cs + dy * object.sn, across = -dx * object.sn + dy * object.cs;
+            double coverage = 0.0;
+            if (object.round) {
+                coverage = edge(object.a - std::hypot(dx, dy), ppt);
+            } else {
+                coverage = strip(std::abs(along), object.a, ppt) * strip(std::abs(across), object.b, ppt);
+            }
+            if (coverage <= 0.0) continue;
+            // Its own texture, fixed to the object.
+            const double shade = 0.5 + 0.6 * octave(along, across, 0.018, object.salt, ppt) +
+                0.4 * octave(along, across, 0.006, object.salt + 1U, ppt);
+            double colour[3]{object.colour[0] * shade, object.colour[1] * shade, object.colour[2] * shade};
+            if (!object.round) {
+                const double stripe = strip(std::abs(across), object.b * 0.25, ppt);
+                for (double& channel : colour) channel += (0.9 - channel) * stripe * 0.8;
+            }
+            over(rgb, colour, coverage);
+        }
+    }
+
+    // A still cockpit over rgb, in the view's own tangents: two canopy struts
+    // and a bow (dark with thin bright edges), a thin HUD frame, and below a
+    // dark instrument panel with fine detail.
+    void cockpit(double x, double y, double ppt, double rgb[3]) const noexcept {
+        const std::uint32_t s = seed_ * 977U;
+        const auto dark_band = [&](double distance, double half) {
+            if (distance > half + 0.004 + 2.0 / ppt) return;
+            over(rgb, 0.012, strip(distance, half, ppt));
+            over(rgb, 0.35, strip(std::abs(distance - half), 0.0011, ppt));
+        };
+        for (const double side : {-1.0, 1.0}) {
+            // The line through (0.80, -1.3) and (0.50, 1.3), mirrored.
+            const double ex = -0.30, ey = 2.6, length = std::hypot(ex, ey);
+            const double distance = std::abs(((x * side - 0.80) * ey - (y + 1.3) * ex) / length);
+            dark_band(distance, 0.022);
+        }
+        dark_band(std::abs(std::hypot(x, y + 1.1) - 1.75), 0.020);
+        {
+            // The HUD frame: the outline of a box, 4 composed pixels thick.
+            const double qx = std::abs(x) - 0.24, qy = std::abs(y - 0.12) - 0.20;
+            const double outside = std::hypot(std::max(qx, 0.0), std::max(qy, 0.0)) + std::min(std::max(qx, qy), 0.0);
+            const double colour[3]{0.25, 0.60, 0.30};
+            over(rgb, colour, strip(std::abs(outside), 0.0009, ppt));
+        }
+        const double panel_top = -0.62 + 0.04 * std::cos(2.2 * x);
+        const double panel = edge(panel_top - y, ppt);
+        if (panel > 0.0) {
+            double surface[3];
+            const double base = 0.02 + 0.05 * octave(x, y, 0.012, s + 1U, ppt) + 0.03 * octave(x, y, 0.07, s + 2U, ppt);
+            surface[0] = surface[1] = surface[2] = base;
+            // Gauges: rings in a grid.
+            constexpr double kGauge = 0.17;
+            const double gx = (std::floor(x / kGauge) + 0.5) * kGauge, gy = (std::floor(y / kGauge) + 0.5) * kGauge;
+            if (gy + 0.07 < -0.66) {
+                const double ring = std::abs(std::hypot(x - gx, y - gy) - 0.055);
+                over(surface, 0.60, strip(ring, 0.0011, ppt));
+                over(surface, 0.004, edge(0.050 - std::hypot(x - gx, y - gy), ppt) * 0.8);
+            }
+            // Small bright marks (labels, switches).
+            constexpr double kMarkX = 0.02, kMarkY = 0.012;
+            const auto mi = static_cast<std::int32_t>(std::floor(x / kMarkX));
+            const auto mj = static_cast<std::int32_t>(std::floor(y / kMarkY));
+            if (unit(hash_cell(mi, mj, s + 5U)) < 0.3) {
+                const double lx = std::abs(x - (mi + 0.5) * kMarkX), ly = std::abs(y - (mj + 0.5) * kMarkY);
+                const double colour[3]{0.55, 0.55, 0.45};
+                over(surface, colour, strip(lx, 0.006, ppt) * strip(ly, 0.0012, ppt));
+            }
+            over(rgb, surface, panel);
+            over(rgb, 0.40, strip(std::abs(y - panel_top), 0.0009, ppt));
+        }
+    }
+
+    // Round 5: whether cockpit() draws cockpit geometry at view tangent
+    // (x, y): the struts, the bow, the HUD frame, the panel (with their
+    // bright edges). What a cockpit mask of this scene marks.
+    [[nodiscard]] bool cockpit_at(double x, double y) const noexcept {
+        for (const double side : {-1.0, 1.0}) {
+            const double ex = -0.30, ey = 2.6, length = std::hypot(ex, ey);
+            if (std::abs(((x * side - 0.80) * ey - (y + 1.3) * ex) / length) <= 0.022 + 0.0011) return true;
+        }
+        if (std::abs(std::hypot(x, y + 1.1) - 1.75) <= 0.020 + 0.0011) return true;
+        const double qx = std::abs(x) - 0.24, qy = std::abs(y - 0.12) - 0.20;
+        const double outside = std::hypot(std::max(qx, 0.0), std::max(qy, 0.0)) + std::min(std::max(qx, qy), 0.0);
+        if (std::abs(outside) <= 0.0009) return true;
+        return y <= -0.62 + 0.04 * std::cos(2.2 * x) + 0.0009;
+    }
+
+private:
+    [[nodiscard]] double next() noexcept {
+        std::uint64_t z = (state_ += 0x9E3779B97F4A7C15ULL);
+        z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;
+        z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;
+        z ^= z >> 31;
+        return static_cast<double>(z >> 11) / 9007199254740992.0;
+    }
+    std::uint32_t seed_;
+    std::uint64_t state_;
+    std::vector<Line> lines_;
+    std::vector<Object> objects_;
+};
+
+// What moves between time 0 (frame A) and time 1 (frame B), in tangent.
+struct Scene {
+    double world_x{}, world_y{};   // the far world's translation
+    bool objects{};
+    double object_x{}, object_y{}; // the object layer's, times each object's depth
+    bool cockpit{};                // a still cockpit over everything
+    double yaw{};                  // B's head yaw, radians (A's is 0); the world itself does not turn
+};
+struct Gaze {
+    double x{}, y{}; // the focus box's centre, in half spans from the eye's centre
+};
+struct Case {
+    const char* name;
+    Scene scene;
+    Gaze a;
+    Gaze b;
+};
+
+// One view of the world at `time`: FOV `fov`, head yaw `yaw`, width x height,
+// RGBA8 sRGB. With `fade` the alpha is Quad Views' focus fade, else 255.
+void render(const World& world, const Scene& scene, double time, const Fov& fov, double yaw, UINT width, UINT height,
+    bool fade, std::vector<std::uint8_t>* out) {
+    out->resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+    const double ppt = width / (fov.r - fov.l);
+    const double cos_yaw = std::cos(yaw), sin_yaw = std::sin(yaw);
+    std::uint8_t* const bytes = out->data();
+    parallel_rows(height, [&](UINT y, unsigned) {
+        const double v = (y + 0.5) / height;
+        const double ty = fov.u - v * (fov.u - fov.d);
+        std::uint8_t* row = bytes + static_cast<std::size_t>(y) * width * kBytesPerPixel;
+        for (UINT x = 0; x < width; ++x) {
+            const double u = (x + 0.5) / width;
+            const double tx = fov.l + u * (fov.r - fov.l);
+            // The ray (tx, ty, -1) turned by the head's yaw about +Y (the
+            // quaternion make_reprojection_views builds), back to tangents.
+            const double depth = tx * sin_yaw + cos_yaw;
+            const double wx = (tx * cos_yaw - sin_yaw) / depth, wy = ty / depth;
+            double rgb[3];
+            world.backdrop(wx - scene.world_x * time, wy - scene.world_y * time, ppt, rgb);
+            if (scene.objects) world.objects(wx, wy, scene.object_x * time, scene.object_y * time, ppt, rgb);
+            if (scene.cockpit) world.cockpit(tx, ty, ppt, rgb);
+            row[x * 4U + 0U] = encode_linear(rgb[0]);
+            row[x * 4U + 1U] = encode_linear(rgb[1]);
+            row[x * 4U + 2U] = encode_linear(rgb[2]);
+            row[x * 4U + 3U] = fade
+                ? static_cast<std::uint8_t>(focus_alpha(u * 2.0 - 1.0, 1.0 - v * 2.0) * 255.0 + 0.5)
+                : std::uint8_t{255};
+        }
+    });
+}
+
+// ------------------------------------------------------------- composition
+
+struct Taps {
+    std::size_t i00, i10, i01, i11; // byte offsets of the four texels
+    double fx, fy;
+};
+[[nodiscard]] inline Taps taps(UINT width, UINT height, double u, double v) noexcept {
+    const double x = u * width - 0.5, y = v * height - 0.5;
+    const double bx = std::floor(x), by = std::floor(y);
+    const int right = static_cast<int>(width) - 1, bottom = static_cast<int>(height) - 1;
+    const auto x0 = static_cast<std::size_t>(std::clamp(static_cast<int>(bx), 0, right));
+    const auto x1 = static_cast<std::size_t>(std::clamp(static_cast<int>(bx) + 1, 0, right));
+    const auto y0 = static_cast<std::size_t>(std::clamp(static_cast<int>(by), 0, bottom));
+    const auto y1 = static_cast<std::size_t>(std::clamp(static_cast<int>(by) + 1, 0, bottom));
+    return {(y0 * width + x0) * 4U, (y0 * width + x1) * 4U, (y1 * width + x0) * 4U, (y1 * width + x1) * 4U,
+        x - bx, y - by};
+}
+// Bilinear on the encoded bytes (what a compositor's sampler does on a UNORM image).
+[[nodiscard]] inline double sample_encoded(const std::uint8_t* px, const Taps& t, std::size_t c) noexcept {
+    return (px[t.i00 + c] * (1.0 - t.fx) + px[t.i10 + c] * t.fx) * (1.0 - t.fy) +
+        (px[t.i01 + c] * (1.0 - t.fx) + px[t.i11 + c] * t.fx) * t.fy;
+}
+// Bilinear in linear light (what Quad Views' sRGB views do).
+[[nodiscard]] inline double sample_linear(const std::uint8_t* px, const Taps& t, std::size_t c) noexcept {
+    const std::array<double, 256>& decode = tables().decode;
+    return (decode[px[t.i00 + c]] * (1.0 - t.fx) + decode[px[t.i10 + c]] * t.fx) * (1.0 - t.fy) +
+        (decode[px[t.i01 + c]] * (1.0 - t.fx) + decode[px[t.i11 + c]] * t.fx) * t.fy;
+}
+
+// The geometry of one composed image: its pixels against the eye's FOV and a
+// focus box.
+struct Composer {
+    UINT width, height;       // composed
+    UINT pw, ph, fw, fh;      // periphery and focus images
+    Fov eye, box;
+
+    struct Pixel {
+        Taps p;       // in the periphery image
+        Taps f;       // in the focus image (valid when inside)
+        bool inside;  // of the focus box
+        double alpha; // Quad Views' fade there (0 outside)
+    };
+    [[nodiscard]] Pixel at(UINT x, UINT y) const noexcept {
+        Pixel pixel{};
+        const double u = (x + 0.5) / width, v = (y + 0.5) / height;
+        pixel.p = taps(pw, ph, u, v);
+        const double tx = eye.l + u * (eye.r - eye.l), ty = eye.u - v * (eye.u - eye.d);
+        const double nx = (tx - 0.5 * (box.l + box.r)) / (0.5 * (box.r - box.l));
+        const double ny = (ty - 0.5 * (box.u + box.d)) / (0.5 * (box.u - box.d));
+        pixel.inside = std::abs(nx) < 1.0 && std::abs(ny) < 1.0;
+        if (pixel.inside) {
+            pixel.f = taps(fw, fh, (nx + 1.0) * 0.5, (1.0 - ny) * 0.5);
+            pixel.alpha = focus_alpha(nx, ny);
+        }
+        return pixel;
+    }
+    // Today's rule (runtime-probe probe_run.cpp Compose, fade on): linear light.
+    void today(const std::uint8_t* periphery, const std::uint8_t* focus, const Pixel& pixel,
+        std::uint8_t out[3]) const noexcept {
+        for (std::size_t c = 0; c < 3; ++c) {
+            double value = sample_linear(periphery, pixel.p, c);
+            if (pixel.alpha > 0.0) value += (sample_linear(focus, pixel.f, c) - value) * pixel.alpha;
+            out[c] = encode_linear(value);
+        }
+    }
+    // Two layers in the headset's compositor: the focus layer's own alpha,
+    // unpremultiplied, on the encoded values.
+    void layered(const std::uint8_t* periphery, const std::uint8_t* focus, const Pixel& pixel,
+        std::uint8_t out[3]) const noexcept {
+        const double alpha = pixel.inside ? sample_encoded(focus, pixel.f, 3) / 255.0 : 0.0;
+        for (std::size_t c = 0; c < 3; ++c) {
+            double value = sample_encoded(periphery, pixel.p, c);
+            if (alpha > 0.0) value += (sample_encoded(focus, pixel.f, c) - value) * alpha;
+            out[c] = static_cast<std::uint8_t>(std::clamp(value, 0.0, 255.0) + 0.5);
+        }
+    }
+};
+
+// The composed image Quad Views submits today, opaque.
+void compose_today(const Composer& composer, const std::vector<std::uint8_t>& periphery,
+    const std::vector<std::uint8_t>& focus, std::vector<std::uint8_t>* out) {
+    out->resize(static_cast<std::size_t>(composer.width) * composer.height * kBytesPerPixel);
+    std::uint8_t* const bytes = out->data();
+    parallel_rows(composer.height, [&](UINT y, unsigned) {
+        std::uint8_t* row = bytes + static_cast<std::size_t>(y) * composer.width * kBytesPerPixel;
+        for (UINT x = 0; x < composer.width; ++x) {
+            composer.today(periphery.data(), focus.data(), composer.at(x, y), row + x * 4U);
+            row[x * 4U + 3U] = 255;
+        }
+    });
+}
+
+// --------------------------------------------------------------- statistics
+
+struct Stat {
+    std::array<std::uint64_t, 256> histogram{}; // of |a - b| over R, G, B
+    void add(const std::uint8_t* a, const std::uint8_t* b) noexcept {
+        for (int c = 0; c < 3; ++c) ++histogram[static_cast<std::size_t>(std::abs(int{a[c]} - int{b[c]}))];
+    }
+    void merge(const Stat& other) noexcept {
+        for (std::size_t i = 0; i < histogram.size(); ++i) histogram[i] += other.histogram[i];
+    }
+};
+
+void print_stat(const Case& c, bool triple, double time, const char* mode, const char* reference, const char* region,
+    const Stat& stat) {
+    std::uint64_t samples = 0;
+    double sum = 0.0, squares = 0.0;
+    int worst = 0;
+    for (std::size_t i = 0; i < stat.histogram.size(); ++i) {
+        const auto n = stat.histogram[i];
+        samples += n;
+        sum += static_cast<double>(n) * static_cast<double>(i);
+        squares += static_cast<double>(n) * static_cast<double>(i * i);
+        if (n != 0) worst = static_cast<int>(i);
+    }
+    int p99 = 0;
+    if (samples != 0) {
+        const auto target = static_cast<std::uint64_t>(std::ceil(0.99 * static_cast<double>(samples)));
+        std::uint64_t seen = 0;
+        for (std::size_t i = 0; i < stat.histogram.size(); ++i) {
+            seen += stat.histogram[i];
+            if (seen >= target) { p99 = static_cast<int>(i); break; }
+        }
+    }
+    const double mae = samples != 0 ? sum / static_cast<double>(samples) : 0.0;
+    const double mse = samples != 0 ? squares / static_cast<double>(samples) : 0.0;
+    // 99.99: no difference at all.
+    const double psnr = mse > 0.0 ? std::min(99.99, 10.0 * std::log10(255.0 * 255.0 / mse)) : 99.99;
+    char line[320];
+    std::snprintf(line, sizeof(line),
+        "fovq case=%s rate=%s t=%.3f mode=%s ref=%s region=%s n=%llu mae=%.3f psnr=%.2f p99=%d max=%d",
+        c.name, triple ? "3X" : "2X", time, mode, reference, region,
+        static_cast<unsigned long long>(samples / 3U), mae, psnr, p99, worst);
+    std::cout << line << std::endl;
+}
+
+// ------------------------------------------------------------ the GPU side
+
+void wait_for_fence(ID3D12Fence* fence, std::uint64_t value, const std::string& what) {
+    if (fence->GetCompletedValue() >= value) return;
+    const HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    require(event != nullptr, what + ": no event");
+    const HRESULT armed = fence->SetEventOnCompletion(value, event);
+    const DWORD waited = SUCCEEDED(armed) ? WaitForSingleObject(event, 120000) : WAIT_FAILED;
+    CloseHandle(event);
+    require(SUCCEEDED(armed) && waited == WAIT_OBJECT_0, what + ": never completed");
+}
+
+struct PairResult {
+    bool real_is_b{};
+    std::vector<StereoPattern> synthetics; // one (2X: t 1/2) or two (3X: t 1/3, 2/3)
+};
+
+// One prime (A) and one pair (A -> B) on a two-slice image (one slice per
+// eye), as tests\vertical_fov_tests.cpp run_focus_pair: the target camera is
+// B's, as the layer submits.
+[[nodiscard]] PairResult run_pair(D3D12WarpFixture& fixture, UINT width, UINT height,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options, bool focus_layer, const ReprojectionViews& views_a,
+    const ReprojectionViews& views_b, const StereoPattern& a, const StereoPattern& b, bool triple,
+    const std::string& what,
+    // Round 5: a cockpit mask per capture (A's, B's), set as the layer sets
+    // them: before the prime and before the pair. Needs options.cockpit_mask.
+    const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>* masks = nullptr) {
+    std::array<ComPtr<ID3D12Resource>, 2> sources{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    std::array<ComPtr<ID3D12Resource>, 2> originals{
+        create_source_texture(fixture, width, height), create_source_texture(fixture, width, height)};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetic{};
+    const std::size_t synthetic_count = triple ? 2U : 1U;
+    for (std::size_t i = 0; i < synthetic_count; ++i) synthetic[i] = create_source_texture(fixture, width, height);
+    std::array<ID3D12Resource*, 2> inputs{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{originals[0].Get(), originals[1].Get()};
+    std::array<ID3D12Resource*, 2> middle{synthetic[0].Get(), synthetic[1].Get()};
+    upload_pattern(fixture, sources[0].Get(), a);
+    upload_pattern(fixture, sources[1].Get(), b);
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "foveated quality: history");
+    xrfg::D3D12FrameSynthesizer synthesizer;
+    require(operation_succeeded(synthesizer.initialize(fixture.device(), fixture.queue(), history, outputs,
+                std::span<ID3D12Resource* const>(middle.data(), synthetic_count), kFormat,
+                D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::nvidia, options)),
+        what + ": synthesizer " + std::to_string(width) + "x" + std::to_string(height));
+    synthesizer.set_foveated_focus(focus_layer);
+    ComPtr<ID3D12Fence> completion;
+    require_hresult(synthesizer.completion_fence(completion.GetAddressOf()), "foveated quality: completion fence");
+    const auto retry = [&](auto&& call, const std::string& step) {
+        HRESULT result = E_FAIL;
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+        do {
+            result = call();
+            if (result == HRESULT_FROM_WIN32(ERROR_BUSY)) Sleep(1);
+        } while (result == HRESULT_FROM_WIN32(ERROR_BUSY) && std::chrono::steady_clock::now() < deadline);
+        require(operation_succeeded(result), what + ": " + step + " HRESULT " +
+            std::to_string(static_cast<std::int32_t>(result)));
+    };
+    xrfg::D3D12HistoryCaptureTicket ticket_a{}, ticket_b{};
+    retry([&] { return history->capture(0, &ticket_a); }, "capture A");
+    require_hresult(history->commit(ticket_a), "foveated quality: commit A");
+    xrfg::D3D12FrameSynthesisTicket prime{};
+    if (masks != nullptr) synthesizer.set_cockpit_mask((*masks)[0]);
+    retry([&] { return synthesizer.submit_prime(ticket_a, views_a, 0, &prime); }, "prime");
+    wait_for_fence(completion.Get(), prime.fence_value, what + ": prime");
+    retry([&] { return history->capture(1, &ticket_b); }, "capture B");
+    require_hresult(history->commit(ticket_b), "foveated quality: commit B");
+    xrfg::D3D12FrameSynthesisTicket pair{};
+    if (masks != nullptr) synthesizer.set_cockpit_mask((*masks)[1]);
+    retry([&] {
+        return synthesizer.submit_pair(ticket_b, views_b, views_b, 0, 1, &pair, std::nullopt, {}, false,
+            triple ? 1.0F / 3.0F : 0.5F,
+            triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                   : std::nullopt);
+    }, "pair");
+    wait_for_fence(completion.Get(), pair.fence_value, what + ": pair");
+    PairResult result;
+    result.real_is_b = readback_pattern(fixture, originals[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET) == b;
+    for (std::size_t i = 0; i < synthetic_count; ++i) {
+        result.synthetics.push_back(
+            readback_pattern(fixture, synthetic[i].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    require_hresult(synthesizer.wait_for_idle(), "foveated quality: drain");
+    require_hresult(history->invalidate(), "foveated quality: history invalidate");
+    return result;
+}
+
+// Round 7: one swapchain's synthesizer kept alive across a pair, so that two
+// of them (a periphery layer's and a focus layer's) can be joined by a
+// D3D12FoveatedLink and submitted in a chosen order, with the GPU timing on.
+struct Rig {
+    std::array<ComPtr<ID3D12Resource>, 2> sources;
+    std::array<ComPtr<ID3D12Resource>, 2> originals;
+    std::array<ComPtr<ID3D12Resource>, 2> synthetic;
+    std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+    xrfg::D3D12FrameSynthesizer synthesizer;
+    ComPtr<ID3D12Fence> completion;
+    std::size_t synthetic_count{};
+    std::string what;
+};
+
+template <typename Call>
+void rig_retry(const Rig& rig, Call&& call, const std::string& step) {
+    HRESULT result = E_FAIL;
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+    do {
+        result = call();
+        if (result == HRESULT_FROM_WIN32(ERROR_BUSY)) Sleep(1);
+    } while (result == HRESULT_FROM_WIN32(ERROR_BUSY) && std::chrono::steady_clock::now() < deadline);
+    require(operation_succeeded(result), rig.what + ": " + step + " HRESULT " +
+        std::to_string(static_cast<std::int32_t>(result)));
+}
+
+void rig_start(D3D12WarpFixture& fixture, Rig& rig, UINT width, UINT height,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options, const StereoPattern& a, const StereoPattern& b, bool triple,
+    const std::string& what) {
+    rig.what = what;
+    rig.synthetic_count = triple ? 2U : 1U;
+    for (auto& texture : rig.sources) texture = create_source_texture(fixture, width, height);
+    for (auto& texture : rig.originals) texture = create_source_texture(fixture, width, height);
+    for (std::size_t i = 0; i < rig.synthetic_count; ++i) rig.synthetic[i] = create_source_texture(fixture, width, height);
+    std::array<ID3D12Resource*, 2> inputs{rig.sources[0].Get(), rig.sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{rig.originals[0].Get(), rig.originals[1].Get()};
+    std::array<ID3D12Resource*, 2> middle{rig.synthetic[0].Get(), rig.synthetic[1].Get()};
+    upload_pattern(fixture, rig.sources[0].Get(), a);
+    upload_pattern(fixture, rig.sources[1].Get(), b);
+    rig.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(rig.history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "foveated quality rig: history");
+    require(operation_succeeded(rig.synthesizer.initialize(fixture.device(), fixture.queue(), rig.history, outputs,
+                std::span<ID3D12Resource* const>(middle.data(), rig.synthetic_count), kFormat,
+                D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::nvidia, options, true)),
+        what + ": synthesizer " + std::to_string(width) + "x" + std::to_string(height));
+    require_hresult(rig.synthesizer.completion_fence(rig.completion.GetAddressOf()),
+        "foveated quality rig: completion fence");
+}
+
+// The layer's naming of a swapchain before a submission.
+void rig_name(Rig& rig, bool focus, const std::shared_ptr<xrfg::D3D12FoveatedLink>& link, std::uint64_t token) {
+    rig.synthesizer.set_foveated_focus(focus);
+    rig.synthesizer.set_foveated_link(link, link != nullptr, token);
+}
+
+void rig_prime(Rig& rig, const ReprojectionViews& views,
+    const std::shared_ptr<xrfg::D3D12CockpitMaskFrame>& mask) {
+    xrfg::D3D12HistoryCaptureTicket ticket{};
+    rig_retry(rig, [&] { return rig.history->capture(0, &ticket); }, "capture A");
+    require_hresult(rig.history->commit(ticket), "foveated quality rig: commit A");
+    if (mask) rig.synthesizer.set_cockpit_mask(mask);
+    xrfg::D3D12FrameSynthesisTicket prime{};
+    rig_retry(rig, [&] { return rig.synthesizer.submit_prime(ticket, views, 0, &prime); }, "prime");
+    wait_for_fence(rig.completion.Get(), prime.fence_value, rig.what + ": prime");
+}
+
+void rig_pair(Rig& rig, const ReprojectionViews& views, bool triple,
+    const std::shared_ptr<xrfg::D3D12CockpitMaskFrame>& mask) {
+    xrfg::D3D12HistoryCaptureTicket ticket{};
+    rig_retry(rig, [&] { return rig.history->capture(1, &ticket); }, "capture B");
+    require_hresult(rig.history->commit(ticket), "foveated quality rig: commit B");
+    if (mask) rig.synthesizer.set_cockpit_mask(mask);
+    xrfg::D3D12FrameSynthesisTicket pair{};
+    rig_retry(rig, [&] {
+        return rig.synthesizer.submit_pair(ticket, views, views, 0, 1, &pair, std::nullopt, {}, false,
+            triple ? 1.0F / 3.0F : 0.5F,
+            triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                   : std::nullopt);
+    }, "pair");
+    wait_for_fence(rig.completion.Get(), pair.fence_value, rig.what + ": pair");
+}
+
+[[nodiscard]] PairResult rig_finish(D3D12WarpFixture& fixture, Rig& rig, const StereoPattern& b,
+    xrfg::D3D12NvidiaGpuTiming* timing) {
+    PairResult result;
+    result.real_is_b = readback_pattern(fixture, rig.originals[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET) == b;
+    for (std::size_t i = 0; i < rig.synthetic_count; ++i) {
+        result.synthetics.push_back(
+            readback_pattern(fixture, rig.synthetic[i].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    if (timing != nullptr) {
+        *timing = {};
+        // The pair's record (the prime leaves none, or an earlier one: the last wins).
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+        xrfg::D3D12NvidiaGpuTiming read{};
+        bool any = false;
+        while (std::chrono::steady_clock::now() < deadline) {
+            const HRESULT consumed = rig.synthesizer.consume_nvidia_gpu_timing(&read);
+            if (consumed == S_OK) {
+                *timing = read;
+                any = true;
+            } else if (any || FAILED(consumed)) {
+                break;
+            } else {
+                Sleep(1);
+            }
+        }
+    }
+    require_hresult(rig.synthesizer.wait_for_idle(), "foveated quality rig: drain");
+    require_hresult(rig.history->invalidate(), "foveated quality rig: history invalidate");
+    return result;
+}
+
+// A focus swapchain's pair, alone (`periphery_options` null) or after the
+// periphery swapchain's pair of the same two frames, joined by a link: what
+// `[ofxr] foveated_uncovered_fill=2` needs. Returns the focus synthetics;
+// the GPU times of the focus pair, and of the periphery pair, where asked.
+[[nodiscard]] PairResult run_focus_rig(D3D12WarpFixture& fixture, UINT pw, UINT ph, UINT fw, UINT fh,
+    const xrfg::D3D12NvidiaOpticalFlowOptions* periphery_options,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& focus_options, const ReprojectionViews& eye_a,
+    const ReprojectionViews& eye_b, const ReprojectionViews& box_a, const ReprojectionViews& box_b,
+    const StereoPattern& a_p, const StereoPattern& b_p, const StereoPattern& a_f, const StereoPattern& b_f,
+    bool triple, const std::string& what,
+    const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>* masks,
+    xrfg::D3D12NvidiaGpuTiming* focus_timing, xrfg::D3D12NvidiaGpuTiming* periphery_timing) {
+    const std::shared_ptr<xrfg::D3D12FoveatedLink> link =
+        periphery_options != nullptr ? std::make_shared<xrfg::D3D12FoveatedLink>() : nullptr;
+    const std::shared_ptr<xrfg::D3D12CockpitMaskFrame> none;
+    Rig focus;
+    std::optional<Rig> periphery;
+    if (periphery_options != nullptr) {
+        periphery.emplace();
+        rig_start(fixture, *periphery, pw, ph, *periphery_options, a_p, b_p, triple, what + " (periphery)");
+    }
+    rig_start(fixture, focus, fw, fh, focus_options, a_f, b_f, triple, what);
+    // Frame A, then frame B: the periphery layer's swapchain first.
+    if (periphery) {
+        rig_name(*periphery, false, link, 1000);
+        rig_prime(*periphery, eye_a, none);
+    }
+    rig_name(focus, true, link, 1000);
+    rig_prime(focus, box_a, masks != nullptr ? (*masks)[0] : none);
+    if (periphery) {
+        rig_name(*periphery, false, link, 2000);
+        rig_pair(*periphery, eye_b, triple, none);
+    }
+    rig_name(focus, true, link, 2000);
+    rig_pair(focus, box_b, triple, masks != nullptr ? (*masks)[1] : none);
+    PairResult result = rig_finish(fixture, focus, b_f, focus_timing);
+    if (periphery) {
+        static_cast<void>(rig_finish(fixture, *periphery, b_p, periphery_timing));
+    }
+    return result;
+}
+
+[[nodiscard]] ReprojectionViews views_for(const EyeFovs& fovs, double yaw) {
+    // The eyes' positions and the yaw quaternion as every other test here.
+    ReprojectionViews views = make_reprojection_views(static_cast<float>(yaw));
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        views[eye].fov.angle_left = static_cast<float>(std::atan(fovs[eye].l));
+        views[eye].fov.angle_right = static_cast<float>(std::atan(fovs[eye].r));
+        views[eye].fov.angle_up = static_cast<float>(std::atan(fovs[eye].u));
+        views[eye].fov.angle_down = static_cast<float>(std::atan(fovs[eye].d));
+    }
+    return views;
+}
+
+// Round 5: the cockpit mask of one frame's focus images, as the producer
+// exports it for the focus views: an R8 atlas, one rect per eye, kMaskDivisor
+// focus pixels per texel, a texel marked where any of nine points of it is
+// cockpit; each rect's edges the tangents of the eye's focus box (extended
+// where the last texel reaches past the image). Complete at once (as
+// make_cockpit_mask_frame, which takes one map for both eyes).
+[[nodiscard]] std::shared_ptr<xrfg::D3D12CockpitMaskFrame> cockpit_mask_frame(D3D12WarpFixture& fixture,
+    const World& world, const EyeFovs& boxes, UINT width, UINT height) {
+    constexpr UINT kMaskDivisor = 8;
+    const UINT mask_width = (width + kMaskDivisor - 1U) / kMaskDivisor;
+    const UINT mask_height = (height + kMaskDivisor - 1U) / kMaskDivisor;
+    const UINT atlas_width = mask_width * kEyeCount;
+    std::vector<std::uint8_t> atlas(static_cast<std::size_t>(atlas_width) * mask_height, 0);
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const Fov& box = boxes[eye];
+        for (UINT my = 0; my < mask_height; ++my) {
+            for (UINT mx = 0; mx < mask_width; ++mx) {
+                bool cockpit = false;
+                for (int sy = 0; sy < 3 && !cockpit; ++sy) {
+                    for (int sx = 0; sx < 3 && !cockpit; ++sx) {
+                        const double u = (mx + 0.5 * sx) * kMaskDivisor / width;
+                        const double v = (my + 0.5 * sy) * kMaskDivisor / height;
+                        cockpit = world.cockpit_at(box.l + u * (box.r - box.l), box.u - v * (box.u - box.d));
+                    }
+                }
+                if (cockpit) {
+                    atlas[static_cast<std::size_t>(my) * atlas_width + eye * mask_width + mx] = 255;
+                }
+            }
+        }
+    }
+    auto frame = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+    const D3D12_HEAP_PROPERTIES heap = heap_properties(D3D12_HEAP_TYPE_DEFAULT);
+    D3D12_RESOURCE_DESC description{};
+    description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    description.Width = atlas_width;
+    description.Height = mask_height;
+    description.DepthOrArraySize = 1;
+    description.MipLevels = 1;
+    description.Format = DXGI_FORMAT_R8_UNORM;
+    description.SampleDesc.Count = 1;
+    require_hresult(fixture.device()->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &description,
+                        D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(frame->texture.GetAddressOf())),
+        "foveated quality: cockpit mask texture");
+    D3D12_PLACED_SUBRESOURCE_FOOTPRINT layout{};
+    UINT rows = 0;
+    UINT64 row_size = 0, total = 0;
+    fixture.device()->GetCopyableFootprints(&description, 0, 1, 0, &layout, &rows, &row_size, &total);
+    ComPtr<ID3D12Resource> upload =
+        create_buffer(fixture, D3D12_HEAP_TYPE_UPLOAD, total, D3D12_RESOURCE_STATE_GENERIC_READ);
+    std::uint8_t* mapped = nullptr;
+    require_hresult(upload->Map(0, nullptr, reinterpret_cast<void**>(&mapped)),
+        "foveated quality: cockpit mask upload");
+    for (UINT y = 0; y < rows; ++y) {
+        std::memcpy(mapped + layout.Offset + static_cast<std::size_t>(y) * layout.Footprint.RowPitch,
+            atlas.data() + static_cast<std::size_t>(y) * atlas_width, atlas_width);
+    }
+    upload->Unmap(0, nullptr);
+    fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+        D3D12_TEXTURE_COPY_LOCATION destination{};
+        destination.pResource = frame->texture.Get();
+        destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION source{};
+        source.pResource = upload.Get();
+        source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        source.PlacedFootprint = layout;
+        list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+    });
+    require_hresult(fixture.device()->CreateFence(1, D3D12_FENCE_FLAG_NONE,
+                        IID_PPV_ARGS(frame->ready_fence.GetAddressOf())),
+        "foveated quality: cockpit mask fence");
+    frame->ready_value = 1;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const Fov& box = boxes[eye];
+        const double across = static_cast<double>(mask_width * kMaskDivisor) / width;
+        const double along = static_cast<double>(mask_height * kMaskDivisor) / height;
+        auto& view = frame->views[eye];
+        view.valid = true;
+        view.x = eye * mask_width;
+        view.y = 0;
+        view.width = mask_width;
+        view.height = mask_height;
+        view.fov_tan = {static_cast<float>(box.l), static_cast<float>(box.l + (box.r - box.l) * across),
+            static_cast<float>(box.u), static_cast<float>(box.u - (box.u - box.d) * along)};
+    }
+    return frame;
+}
+
+// --------------------------------------------------------------- the bench
+
+struct Sizes {
+    UINT cw, ch, pw, ph, fw, fh;
+};
+
+enum : std::size_t {
+    kComposed, kLayersToday, kLayersLayers, kLayers100Today, kLayers100Layers, kLayers100UaToday, kLayers100UaLayers,
+    kLayers100FillToday, kLayers100ExToday, // round 6
+    kLayers100Fill2Today, kLayers50Fill2Today, kLayers100Fill2RampToday, kLayers100FillRampToday, // round 7
+    kFloor, kHold, kComposedModes
+};
+struct ModeName {
+    const char* mode;
+    const char* reference;
+};
+constexpr std::array<ModeName, kComposedModes> kModeNames{
+    ModeName{"composed", "today"},      // the composed synthetic against the true composed frame
+    ModeName{"layers", "today"},        // the two synthetics composed as layers, same reference
+    ModeName{"layers", "layers"},       // the same against the true layers composed as layers
+    ModeName{"layers-p100", "today"},   // periphery flow at 100 %
+    ModeName{"layers-p100", "layers"},
+    // The same with [ofxr] foveated_uncovered_alpha on the focus layer: its
+    // synthetic's alpha is 0 where frame A's focus image does not cover B's.
+    ModeName{"layers-p100-ua", "today"},
+    ModeName{"layers-p100-ua", "layers"},
+    // Round 6. [ofxr] foveated_uncovered_fill: the uncovered zone is frame B
+    // moved along the pair's own flow, with B's alpha. And
+    // foveated_uncovered_alpha with foveated_uncovered_exact: the ramp by
+    // the exact geometry alone. Both with the cockpit mask in the scenes
+    // that have a cockpit (B unmoved on it; the keep), as flown.
+    ModeName{"layers-p100-fill", "today"},
+    ModeName{"layers-p100-ex", "today"},
+    // Round 7. foveated_uncovered_fill=2: the fill from the periphery layer's
+    // flow of the same pair (periphery submitted first, linked), with the
+    // periphery flow at 100 % and at 50 %; the same with the ramp (width 16,
+    // exact) where the fill has no trusted vector; and fill=1 with that ramp.
+    ModeName{"layers-p100-fill2", "today"},
+    ModeName{"layers-p50-fill2", "today"},
+    ModeName{"layers-p100-fill2r", "today"},
+    ModeName{"layers-p100-fillr", "today"},
+    ModeName{"floor", "today"},         // true layers composed as layers against composed today: no synthesis at all
+    ModeName{"hold-b", "today"}};       // frame B shown instead of the frame between: no interpolation
+constexpr std::array<const char*, 3> kRegionNames{"focus", "fade", "periphery"};
+
+// Round 5: the composed pixels B's focus layer shows (fade above 0) whose
+// direction A's focus image does not hold ("uncovered": the strip
+// foveated_uncovered_alpha hands to the periphery layer), and those of them
+// on the cockpit ("uncovered-cockpit"). All against the true composed frame.
+enum : std::size_t {
+    kStripComposed, kStripLayers, kStripUa, kStripMask, kStripMaskUa, kStripFill, kStripEx,
+    kStripFill2, kStripFill2P50, kStripFill2Ramp, kStripFillRamp, // round 7
+    kStripModes
+};
+// Round 7: the four focus synthetics above, in this order everywhere.
+constexpr std::size_t kExtraFocus = 4;
+constexpr std::array<const char*, kStripModes> kStripModeNames{
+    "composed",          // today's composed synthetic
+    "layers-p100",       // two layers, key off
+    "layers-p100-ua",    // the key, no cockpit mask: the strip is the periphery's everywhere
+    "layers-p100-k",     // a cockpit mask on the focus layer, key off (cockpit scenes only)
+    "layers-p100-uak",   // mask and key: the cockpit keeps the focus layer's alpha
+    "layers-p100-fill",  // round 6: the fill (with the mask in cockpit scenes)
+    "layers-p100-ex",    // round 6: the key with the exact mask (and the mask in cockpit scenes)
+    "layers-p100-fill2", "layers-p50-fill2", "layers-p100-fill2r", "layers-p100-fillr"}; // round 7
+constexpr std::array<const char*, 2> kStripRegionNames{"uncovered", "uncovered-cockpit"};
+
+struct Evaluation {
+    std::array<std::array<Stat, 3>, kComposedModes> composed{};
+    std::array<Stat, 3> periphery{};               // 50 %, 100 %, hold-b: the periphery image on its own
+    std::array<std::array<Stat, 2>, 2> focus{};    // 50 %, hold-b: the focus image on its own; interior, fade
+    std::array<std::array<Stat, 2>, kStripModes> strip{}; // round 5
+    // Round 6, sharpness in the uncovered strip: the sum over R, G, B of
+    // |pixel - its right neighbour| of each mode's composed image, and of the
+    // true composed frame's (the last entry). A mode that shows the periphery
+    // layer there has a fraction of the true frame's detail.
+    std::array<double, kStripModes + 1> detail{};
+    void merge(const Evaluation& other) noexcept {
+        for (std::size_t m = 0; m < detail.size(); ++m) detail[m] += other.detail[m];
+        for (std::size_t m = 0; m < strip.size(); ++m)
+            for (std::size_t r = 0; r < 2; ++r) strip[m][r].merge(other.strip[m][r]);
+        for (std::size_t m = 0; m < composed.size(); ++m)
+            for (std::size_t r = 0; r < 3; ++r) composed[m][r].merge(other.composed[m][r]);
+        for (std::size_t m = 0; m < periphery.size(); ++m) periphery[m].merge(other.periphery[m]);
+        for (std::size_t m = 0; m < focus.size(); ++m)
+            for (std::size_t r = 0; r < 2; ++r) focus[m][r].merge(other.focus[m][r]);
+    }
+};
+
+struct Frames {
+    // Per eye. The true layers at the synthetic's time (focus in B's FOV),
+    // frame B's layers, and the synthetics.
+    const StereoPattern* true_p;
+    const StereoPattern* true_f;
+    const StereoPattern* b_p;
+    const StereoPattern* b_f;
+    const StereoPattern* synthetic_c;
+    const StereoPattern* synthetic_p50;
+    const StereoPattern* synthetic_p100;
+    const StereoPattern* synthetic_f50;
+    const StereoPattern* synthetic_f50_ua; // focus, foveated_uncovered_alpha
+    // Round 5. The focus synthetic with a cockpit mask, key off and key on
+    // (the two above where the scene has no cockpit); A's focus boxes and B's
+    // head yaw, for the uncovered strip; the world where the scene has a
+    // cockpit, else null.
+    const StereoPattern* synthetic_f50_k;
+    const StereoPattern* synthetic_f50_uak;
+    const EyeFovs* focus_a;
+    double yaw;
+    const World* cockpit;
+    // Round 6: the focus synthetic with the fill, and with the exact mask.
+    const StereoPattern* synthetic_f50_fill;
+    const StereoPattern* synthetic_f50_ex;
+    // Round 7: fill2 with the periphery flow at 100 %, at 50 % (composed over
+    // the 50 % periphery synthetic), fill2 + ramp, fill1 + ramp.
+    std::array<const StereoPattern*, kExtraFocus> extra_focus;
+};
+
+void evaluate(const Sizes& size, const EyeFovs& focus_b, const Frames& frames, Evaluation* total) {
+    const unsigned workers = worker_count();
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const Composer composer{size.cw, size.ch, size.pw, size.ph, size.fw, size.fh, kEyeFov[eye], focus_b[eye]};
+        const std::uint8_t* const true_p = (*frames.true_p)[eye].data();
+        const std::uint8_t* const true_f = (*frames.true_f)[eye].data();
+        const std::uint8_t* const b_p = (*frames.b_p)[eye].data();
+        const std::uint8_t* const b_f = (*frames.b_f)[eye].data();
+        const std::uint8_t* const syn_c = (*frames.synthetic_c)[eye].data();
+        const std::uint8_t* const syn_p50 = (*frames.synthetic_p50)[eye].data();
+        const std::uint8_t* const syn_p100 = (*frames.synthetic_p100)[eye].data();
+        const std::uint8_t* const syn_f50 = (*frames.synthetic_f50)[eye].data();
+        const std::uint8_t* const syn_f50_ua = (*frames.synthetic_f50_ua)[eye].data();
+        // Round 5: the uncovered strip.
+        const std::uint8_t* const syn_f50_k = (*frames.synthetic_f50_k)[eye].data();
+        const std::uint8_t* const syn_f50_uak = (*frames.synthetic_f50_uak)[eye].data();
+        const std::uint8_t* const syn_f50_fill = (*frames.synthetic_f50_fill)[eye].data(); // round 6
+        const std::uint8_t* const syn_f50_ex = (*frames.synthetic_f50_ex)[eye].data();
+        // Round 7.
+        std::array<const std::uint8_t*, kExtraFocus> syn_extra{};
+        for (std::size_t e = 0; e < kExtraFocus; ++e) syn_extra[e] = (*frames.extra_focus[e])[eye].data();
+        const std::array<const std::uint8_t*, kExtraFocus> syn_extra_p{syn_p100, syn_p50, syn_p100, syn_p100};
+        const Fov box_a = (*frames.focus_a)[eye];
+        const Fov& whole = kEyeFov[eye];
+        const double cos_yaw = std::cos(frames.yaw), sin_yaw = std::sin(frames.yaw);
+        std::vector<Evaluation> partial(workers);
+        // The composed image.
+        const auto border_x = static_cast<UINT>(std::ceil(kBorder * size.cw));
+        const auto border_y = static_cast<UINT>(std::ceil(kBorder * size.ch));
+        parallel_rows(size.ch, [&](UINT y, unsigned worker) {
+            if (y < border_y || y + border_y >= size.ch) return;
+            Evaluation& mine = partial[worker];
+            for (UINT x = border_x; x + border_x < size.cw; ++x) {
+                const Composer::Pixel pixel = composer.at(x, y);
+                const std::size_t region = pixel.alpha >= 0.999 ? 0U : (pixel.alpha > 0.001 ? 1U : 2U);
+                std::uint8_t today[3], layers[3], hold[3], l50[3], l100[3], l100_ua[3];
+                composer.today(true_p, true_f, pixel, today);
+                composer.layered(true_p, true_f, pixel, layers);
+                composer.today(b_p, b_f, pixel, hold);
+                composer.layered(syn_p50, syn_f50, pixel, l50);
+                composer.layered(syn_p100, syn_f50, pixel, l100);
+                composer.layered(syn_p100, syn_f50_ua, pixel, l100_ua);
+                const std::uint8_t* const direct = syn_c + (static_cast<std::size_t>(y) * size.cw + x) * 4U;
+                mine.composed[kComposed][region].add(direct, today);
+                mine.composed[kLayersToday][region].add(l50, today);
+                mine.composed[kLayersLayers][region].add(l50, layers);
+                mine.composed[kLayers100Today][region].add(l100, today);
+                mine.composed[kLayers100Layers][region].add(l100, layers);
+                mine.composed[kLayers100UaToday][region].add(l100_ua, today);
+                mine.composed[kLayers100UaLayers][region].add(l100_ua, layers);
+                std::uint8_t l100_fill[3], l100_ex[3]; // round 6
+                composer.layered(syn_p100, syn_f50_fill, pixel, l100_fill);
+                composer.layered(syn_p100, syn_f50_ex, pixel, l100_ex);
+                mine.composed[kLayers100FillToday][region].add(l100_fill, today);
+                mine.composed[kLayers100ExToday][region].add(l100_ex, today);
+                std::uint8_t extra[kExtraFocus][3]; // round 7
+                for (std::size_t e = 0; e < kExtraFocus; ++e) {
+                    composer.layered(syn_extra_p[e], syn_extra[e], pixel, extra[e]);
+                    mine.composed[kLayers100Fill2Today + e][region].add(extra[e], today);
+                }
+                mine.composed[kFloor][region].add(layers, today);
+                mine.composed[kHold][region].add(hold, today);
+                // Round 5: where B's focus layer shows and A's focus image
+                // does not hold the direction (B's ray in A's camera, as
+                // render turns it).
+                if (pixel.alpha > 0.001) {
+                    const double tx = whole.l + (x + 0.5) / size.cw * (whole.r - whole.l);
+                    const double ty = whole.u - (y + 0.5) / size.ch * (whole.u - whole.d);
+                    const double depth = tx * sin_yaw + cos_yaw;
+                    const double ax = (tx * cos_yaw - sin_yaw) / depth, ay = ty / depth;
+                    if (!(depth > 0.0 && ax > box_a.l && ax < box_a.r && ay > box_a.d && ay < box_a.u)) {
+                        std::uint8_t l100_k[3], l100_uak[3];
+                        composer.layered(syn_p100, syn_f50_k, pixel, l100_k);
+                        composer.layered(syn_p100, syn_f50_uak, pixel, l100_uak);
+                        const std::size_t regions =
+                            frames.cockpit != nullptr && frames.cockpit->cockpit_at(tx, ty) ? 2U : 1U;
+                        for (std::size_t r = 0; r < regions; ++r) {
+                            mine.strip[kStripComposed][r].add(direct, today);
+                            mine.strip[kStripLayers][r].add(l100, today);
+                            mine.strip[kStripUa][r].add(l100_ua, today);
+                            mine.strip[kStripMask][r].add(l100_k, today);
+                            mine.strip[kStripMaskUa][r].add(l100_uak, today);
+                            mine.strip[kStripFill][r].add(l100_fill, today);
+                            mine.strip[kStripEx][r].add(l100_ex, today);
+                            for (std::size_t e = 0; e < kExtraFocus; ++e) {
+                                mine.strip[kStripFill2 + e][r].add(extra[e], today);
+                            }
+                        }
+                        // Round 6: detail, against the pixel to the right.
+                        if (x + 1U + border_x < size.cw) {
+                            const Composer::Pixel beside = composer.at(x + 1U, y);
+                            std::uint8_t beside_today[3], beside_l100[3], beside_ua[3], beside_fill[3], beside_ex[3];
+                            composer.today(true_p, true_f, beside, beside_today);
+                            composer.layered(syn_p100, syn_f50, beside, beside_l100);
+                            composer.layered(syn_p100, syn_f50_ua, beside, beside_ua);
+                            composer.layered(syn_p100, syn_f50_fill, beside, beside_fill);
+                            composer.layered(syn_p100, syn_f50_ex, beside, beside_ex);
+                            for (std::size_t c = 0; c < 3; ++c) {
+                                mine.detail[kStripComposed] += std::abs(int{direct[c]} - int{direct[4U + c]});
+                                mine.detail[kStripLayers] += std::abs(int{l100[c]} - int{beside_l100[c]});
+                                mine.detail[kStripUa] += std::abs(int{l100_ua[c]} - int{beside_ua[c]});
+                                mine.detail[kStripFill] += std::abs(int{l100_fill[c]} - int{beside_fill[c]});
+                                mine.detail[kStripEx] += std::abs(int{l100_ex[c]} - int{beside_ex[c]});
+                                mine.detail[kStripModes] += std::abs(int{today[c]} - int{beside_today[c]});
+                            }
+                            for (std::size_t e = 0; e < kExtraFocus; ++e) { // round 7
+                                std::uint8_t beside_extra[3];
+                                composer.layered(syn_extra_p[e], syn_extra[e], beside, beside_extra);
+                                for (std::size_t c = 0; c < 3; ++c) {
+                                    mine.detail[kStripFill2 + e] += std::abs(int{extra[e][c]} - int{beside_extra[c]});
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        });
+        // The periphery image on its own.
+        const auto p_border_x = static_cast<UINT>(std::ceil(kBorder * size.pw));
+        const auto p_border_y = static_cast<UINT>(std::ceil(kBorder * size.ph));
+        parallel_rows(size.ph, [&](UINT y, unsigned worker) {
+            if (y < p_border_y || y + p_border_y >= size.ph) return;
+            Evaluation& mine = partial[worker];
+            for (UINT x = p_border_x; x + p_border_x < size.pw; ++x) {
+                const std::size_t at = (static_cast<std::size_t>(y) * size.pw + x) * 4U;
+                mine.periphery[0].add(syn_p50 + at, true_p + at);
+                mine.periphery[1].add(syn_p100 + at, true_p + at);
+                mine.periphery[2].add(b_p + at, true_p + at);
+            }
+        });
+        // The focus image on its own, where the compositor shows it: by its alpha.
+        parallel_rows(size.fh, [&](UINT y, unsigned worker) {
+            Evaluation& mine = partial[worker];
+            for (UINT x = 0; x < size.fw; ++x) {
+                const std::size_t at = (static_cast<std::size_t>(y) * size.fw + x) * 4U;
+                const std::uint8_t alpha = b_f[at + 3U];
+                if (alpha == 0) continue;
+                const std::size_t region = alpha == 255 ? 0U : 1U;
+                mine.focus[0][region].add(syn_f50 + at, true_f + at);
+                mine.focus[1][region].add(b_f + at, true_f + at);
+            }
+        });
+        for (const Evaluation& part : partial) total->merge(part);
+    }
+}
+
+// XRFG_FOVEATED_QUALITY_DUMP=<directory>: for the left eye, the part of the
+// composed image around B's focus box (1.25 times the box), as 24-bit BMP:
+// the true frame as composed today, the composed synthetic, and the two
+// layers' synthetics (flow 50 %) composed as layers.
+void write_bmp(const std::string& path, UINT width, UINT height, const std::vector<std::uint8_t>& bgr_bottom_up,
+    std::size_t stride) {
+    std::ofstream file(path, std::ios::binary);
+    require(file.good(), "foveated quality: cannot write " + path);
+    const std::uint32_t pixels = static_cast<std::uint32_t>(stride * height);
+    std::array<std::uint8_t, 54> header{};
+    const auto put = [&header](std::size_t at, std::uint32_t value) {
+        for (std::size_t i = 0; i < 4; ++i) header[at + i] = static_cast<std::uint8_t>(value >> (8U * i));
+    };
+    header[0] = 'B'; header[1] = 'M';
+    put(2, 54U + pixels); put(10, 54U); put(14, 40U); put(18, width); put(22, height);
+    header[26] = 1; header[28] = 24; put(34, pixels);
+    file.write(reinterpret_cast<const char*>(header.data()), static_cast<std::streamsize>(header.size()));
+    file.write(reinterpret_cast<const char*>(bgr_bottom_up.data()), static_cast<std::streamsize>(pixels));
+}
+
+void dump_views(const std::string& directory, const std::string& stem, const Sizes& size, const Fov& box,
+    const Frames& frames) {
+    const Fov& eye = kEyeFov[0];
+    const Composer composer{size.cw, size.ch, size.pw, size.ph, size.fw, size.fh, eye, box};
+    const double cx = 0.5 * (box.l + box.r), cy = 0.5 * (box.u + box.d);
+    const double hx = 0.625 * (box.r - box.l), hy = 0.625 * (box.u - box.d);
+    const auto column = [&](double t) {
+        return static_cast<UINT>(std::clamp((t - eye.l) / (eye.r - eye.l), 0.0, 1.0) * size.cw);
+    };
+    const auto line = [&](double t) {
+        return static_cast<UINT>(std::clamp((eye.u - t) / (eye.u - eye.d), 0.0, 1.0) * size.ch);
+    };
+    const UINT x0 = column(cx - hx), x1 = column(cx + hx), y0 = line(cy + hy), y1 = line(cy - hy);
+    if (x1 <= x0 || y1 <= y0) return;
+    const UINT width = x1 - x0, height = y1 - y0;
+    const std::size_t stride = (static_cast<std::size_t>(width) * 3U + 3U) & ~std::size_t{3};
+    std::array<std::vector<std::uint8_t>, 3> images;
+    for (auto& image : images) image.assign(stride * height, 0);
+    const std::uint8_t* const true_p = (*frames.true_p)[0].data();
+    const std::uint8_t* const true_f = (*frames.true_f)[0].data();
+    const std::uint8_t* const syn_c = (*frames.synthetic_c)[0].data();
+    const std::uint8_t* const syn_p = (*frames.synthetic_p50)[0].data();
+    const std::uint8_t* const syn_f = (*frames.synthetic_f50)[0].data();
+    parallel_rows(height, [&](UINT row, unsigned) {
+        const UINT y = y0 + row;
+        const std::size_t out = static_cast<std::size_t>(height - 1U - row) * stride;
+        for (UINT column_index = 0; column_index < width; ++column_index) {
+            const UINT x = x0 + column_index;
+            const Composer::Pixel pixel = composer.at(x, y);
+            std::uint8_t rgb[3][3];
+            composer.today(true_p, true_f, pixel, rgb[0]);
+            const std::uint8_t* const direct = syn_c + (static_cast<std::size_t>(y) * size.cw + x) * 4U;
+            for (std::size_t c = 0; c < 3; ++c) rgb[1][c] = direct[c];
+            composer.layered(syn_p, syn_f, pixel, rgb[2]);
+            for (std::size_t i = 0; i < 3; ++i) {
+                std::uint8_t* const to = images[i].data() + out + static_cast<std::size_t>(column_index) * 3U;
+                to[0] = rgb[i][2]; to[1] = rgb[i][1]; to[2] = rgb[i][0];
+            }
+        }
+    });
+    constexpr std::array<const char*, 3> names{"-true.bmp", "-composed.bmp", "-layers.bmp"};
+    for (std::size_t i = 0; i < 3; ++i) write_bmp(directory + "\\" + stem + names[i], width, height, images[i], stride);
+}
+
+[[nodiscard]] long env_number(const char* name, long fallback, long low, long high) {
+    char text[32]{};
+    const DWORD length = GetEnvironmentVariableA(name, text, sizeof(text));
+    if (length == 0 || length >= sizeof(text)) return fallback;
+    const long value = std::strtol(text, nullptr, 10);
+    require(value >= low && value <= high, std::string(name) + " must be " + std::to_string(low) + ".." +
+        std::to_string(high));
+    return value;
+}
