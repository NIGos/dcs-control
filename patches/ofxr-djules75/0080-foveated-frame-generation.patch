diff --git a/tests/vertical_fov_tests.cpp b/tests/vertical_fov_tests.cpp
--- a/tests/vertical_fov_tests.cpp
+++ b/tests/vertical_fov_tests.cpp
@@ -184,6 +184,1536 @@ StereoPattern run_fov_pair(D3D12WarpFixture& fixture,
     require_hresult(history->invalidate(), "FOV history invalidate");
     return result;
 }
+
+// Foveated layers (`[ofxr] foveated_layers`): the focus layer of a two-layer
+// submission. Its image always covers its own field of view, and that field
+// of view is a box inside the eye's that follows the gaze: frame A and frame B
+// have the same pose and different FOVs. Two array slices, one per eye (the
+// "one swapchain of two slices per layer" shape).
+constexpr UINT kFocusWidth = 256, kFocusHeight = 256;
+// The box: this part of the eye's tangent span per axis (Quad Views' 0.34).
+constexpr float kFocusSection = 0.34F;
+
+struct FocusGaze {
+    float x; // the box's centre, in eye tangent spans from the eye's centre
+    float y;
+};
+
+ReprojectionViews focus_views(FocusGaze gaze, bool rotated) {
+    auto views = make_reprojection_views();
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const float left = std::tan(views[eye].fov.angle_left);
+        const float right = std::tan(views[eye].fov.angle_right);
+        const float up = std::tan(views[eye].fov.angle_up);
+        const float down = std::tan(views[eye].fov.angle_down);
+        const float half_width = 0.5F * kFocusSection * (right - left);
+        const float half_height = 0.5F * kFocusSection * (up - down);
+        const float centre_x = 0.5F * (left + right) + gaze.x * (right - left);
+        const float centre_y = 0.5F * (up + down) + gaze.y * (up - down);
+        views[eye].fov.angle_left = std::atan(centre_x - half_width);
+        views[eye].fov.angle_right = std::atan(centre_x + half_width);
+        views[eye].fov.angle_up = std::atan(centre_y + half_height);
+        views[eye].fov.angle_down = std::atan(centre_y - half_height);
+        views[eye].image_rect = xrfg::D3D12ImageRect{0, 0, kFocusWidth, kFocusHeight};
+        if (rotated) {
+            const float yaw = 0.02F, pitch = 0.015F; // Half angles: the head between A and B.
+            views[eye].pose.orientation = {
+                std::cos(yaw) * std::sin(pitch),
+                std::sin(yaw) * std::cos(pitch),
+                -std::sin(yaw) * std::sin(pitch),
+                std::cos(yaw) * std::cos(pitch)};
+        }
+    }
+    return views;
+}
+
+// The focus edge's fade as Quad Views writes it: a function of the focus
+// image's own pixel alone (a superellipse in the image's NDC: 1 inside the
+// radius 1 - 2 * smoothing, a smoothstep down to exactly 0 at radius 1).
+std::uint8_t focus_edge_alpha(UINT x, UINT y) {
+    constexpr float kSmoothing = 0.1F, kPower = 4.0F;
+    const float nx = std::abs((static_cast<float>(x) + 0.5F) / kFocusWidth * 2.0F - 1.0F);
+    const float ny = std::abs((static_cast<float>(y) + 0.5F) / kFocusHeight * 2.0F - 1.0F);
+    const float radius = std::pow(std::pow(nx, kPower) + std::pow(ny, kPower), 1.0F / kPower);
+    const float t = std::clamp((radius - (1.0F - 2.0F * kSmoothing)) / (2.0F * kSmoothing), 0.0F, 1.0F);
+    const float alpha = 1.0F - t * t * (3.0F - 2.0F * t);
+    return static_cast<std::uint8_t>(alpha * 255.0F + 0.5F);
+}
+
+StereoPattern focus_pattern(const ReprojectionViews& views, bool alpha_edge) {
+    StereoPattern pattern = ray_direction_pattern(kFocusWidth, kFocusHeight, views);
+    if (alpha_edge) {
+        for (UINT eye = 0; eye < kEyeCount; ++eye)
+            for (UINT y = 0; y < kFocusHeight; ++y)
+                for (UINT x = 0; x < kFocusWidth; ++x)
+                    pattern[eye][(static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel + 3] =
+                        focus_edge_alpha(x, y);
+    }
+    return pattern;
+}
+
+struct FocusPairResult {
