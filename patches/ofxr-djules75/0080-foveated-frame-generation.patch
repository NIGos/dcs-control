+        if (eye >= kEyes) {
+            return;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            if (record.flow == nullptr || record.cost == nullptr || record.fence == nullptr ||
+                record.previous_token == 0 || record.current_token == 0) {
+                flow_[eye] = {};
+            } else {
+                flow_[eye] = record;
+            }
+        } catch (...) {
+        }
+    }
+    void clear_flow(std::uint32_t eye) noexcept {
+        if (eye >= kEyes) {
+            return;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            flow_[eye] = {};
+        } catch (...) {
+        }
+    }
+    // The flow of `eye` for the pair made of exactly these two frames.
+    [[nodiscard]] bool flow(std::uint32_t eye, std::uint64_t previous_token,
+        std::uint64_t current_token, FlowRecord* record) noexcept {
+        if (eye >= kEyes || record == nullptr || previous_token == 0 || current_token == 0) {
+            return false;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            const FlowRecord& held = flow_[eye];
+            if (held.flow == nullptr || held.previous_token != previous_token ||
+                held.current_token != current_token) {
+                return false;
+            }
+            *record = held;
+            return true;
+        } catch (...) {
+            return false;
+        }
+    }
+    // The focus layer read `eye`'s flow; the read is done at `value`. The
+    // periphery layer's next pair waits for it before it writes a flow.
+    void note_flow_reader(std::uint32_t eye, ID3D12Fence* fence, std::uint64_t value) noexcept {
+        if (eye >= kEyes || fence == nullptr) {
+            return;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            flow_reader_[eye].fence = fence;
+            flow_reader_[eye].fence_value = value;
+        } catch (...) {
+        }
+    }
+    [[nodiscard]] bool flow_reader(std::uint32_t eye, CursorReader* reader) noexcept {
+        if (eye >= kEyes || reader == nullptr) {
+            return false;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
