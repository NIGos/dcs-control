+    // ------------------------------------------------------------------
+    // Foveated layers, round 7: `foveated_uncovered_fill = 2`, the periphery
+    // layer's flow for the focus layer's fill.
+    //  - A periphery swapchain's pair (linked, NVIDIA flow) leaves in the
+    //    link, per eye, its flow and cost textures and what maps a direction
+    //    to a flow texel (publish_foveated_flow).
+    //  - A focus swapchain's pair of the same two frames, submitted AFTER it,
+    //    binds them to its composition in the forward flow's slots (t4, t5:
+    //    null without nvidia_bidirectional) and gives the shader the map from
+    //    its own pixels to that flow's texels in GameMotionScale /
+    //    GameMotionJitterDelta (unused by the NVIDIA compositions).
+    //  - Order on the GPU: the focus pair waits for the periphery pair's
+    //    synthetic fence (the textures rest in COMMON again from there), the
+    //    periphery layer's next pair for the focus pair's (its read). On one
+    //    shared synthesis queue both are already in order.
+    // Without the key at 2, without a link, with nvidia_bidirectional, on
+    // FidelityFX: nothing here does anything.
+    struct FillPlan {
+        bool use{};
+        D3D12FoveatedLink::FlowRecord record;
+    };
+    std::array<FillPlan, kMaxReprojectionViews> fill_plan{};
+    // Per view of the pair being recorded: bound, and scale x, y, offset x, y.
+    std::array<bool, kMaxReprojectionViews> pair_fill_bound{};
+    std::array<std::array<float, 4>, kMaxReprojectionViews> pair_fill_map{};
+    // The periphery side: what record_nvidia_pair noted of its views.
+    struct FlowStash {
+        bool valid{};
+        UINT slice{};
+        std::array<float, 4> tangents{};
+        std::array<float, 4> rect{};
+    };
+    std::array<FlowStash, kMaxReprojectionViews> flow_stash{};
+    float flow_stash_ratio{};
+    UINT flow_stash_block{};
+
+    [[nodiscard]] bool foveated_fill_from_periphery() const noexcept {
+        return foveated_focus_layer() && nvidia_options.foveated_uncovered_fill >= 2U &&
+            backend == D3D12OpticalFlowBackend::nvidia && !nvidia_options.bidirectional;
+    }
+
+    // After plan_foveated_cursor: the periphery layer's flow of this pair,
+    // per view, where the link has it.
+    void plan_foveated_flow(const RollingSource& previous_source) noexcept {
+        fill_plan = {};
+        pair_fill_bound = {};
+        flow_stash = {};
+        if (!foveated_fill_from_periphery()) {
+            return;
+        }
+        const std::uint64_t previous_token = foveated_token_of(previous_source.ticket.serial);
+        const UINT view_count = std::min<UINT>(previous_source.view_count, kMaxReprojectionViews);
+        for (UINT view = 0; view < view_count; ++view) {
+            const UINT eye = cockpit_mask_eye(previous_source.views[view], view);
+            D3D12FoveatedLink::FlowRecord record{};
+            if (foveated_link->flow(eye, previous_token, foveated_frame_token, &record) &&
+                record.block_size != 0U && record.input_ratio > 0.0F) {
+                fill_plan[view].use = true;
+                fill_plan[view].record = std::move(record);
+            }
+        }
+    }
+
+    // In record_nvidia_pair, once the composition's own barriers are down.
+    // Periphery layer: its views are noted for publish_foveated_flow. Focus
+    // layer at fill = 2: per view the foreign flow and cost go into the
+    // view's descriptor block (nulls where there is none, as at creation)
+    // and into the shader-read state, and the map is worked out.
+    void begin_foveated_flow(
+        ID3D12GraphicsCommandList* list,
+        WorkSlot& slot,
+        const SynthesisParameters& parameters,
+        std::span<const D3D12ReprojectionView> target_views) noexcept {
+        if (!nvidia_options.foveated_layers || !foveated_linked()) {
+            return;
+        }
+        const UINT view_count = std::min<UINT>(static_cast<UINT>(target_views.size()), kMaxReprojectionViews);
+        if (foveated_periphery_layer()) {
+            flow_stash_ratio = parameters.width != 0U
+                ? std::min(1.0F, static_cast<float>(parameters.packed_width) / static_cast<float>(parameters.width))
+                : 0.0F;
+            flow_stash_block = parameters.flow_block_size;
+            for (UINT view = 0; view < view_count; ++view) {
+                flow_stash[view].valid = true;
+                flow_stash[view].slice = resolved_array_slice(
+                    target_views[view], view, target_views.size(), image_description.DepthOrArraySize);
+                flow_stash[view].tangents = parameters.previous_mappings[view].target_tangents;
+                flow_stash[view].rect = parameters.previous_mappings[view].target_rect;
+            }
+            return;
+        }
+        if (!foveated_fill_from_periphery() || slot.descriptor_heap == nullptr) {
+            return;
+        }
+        const D3D12_CPU_DESCRIPTOR_HANDLE cpu_start =
+            slot.descriptor_heap->GetCPUDescriptorHandleForHeapStart();
+        const UINT increment =
+            device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        D3D12_SHADER_RESOURCE_VIEW_DESC view_description{};
+        view_description.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        view_description.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        view_description.Texture2D.MostDetailedMip = 0;
+        view_description.Texture2D.MipLevels = 1;
+        std::array<D3D12_RESOURCE_BARRIER, 2U * kMaxReprojectionViews> barriers{};
+        UINT barrier_count = 0;
+        for (UINT view = 0; view < view_count; ++view) {
+            const UINT slice = resolved_array_slice(
+                target_views[view], view, target_views.size(), image_description.DepthOrArraySize);
+            const FillPlan& plan = fill_plan[view];
+            const std::array<float, 4>& own = parameters.previous_mappings[view].target_tangents;
+            const std::array<float, 4>& own_rect = parameters.previous_mappings[view].target_rect;
+            const std::array<float, 4>& theirs = plan.record.tangents;
+            const std::array<float, 4>& theirs_rect = plan.record.rect;
+            bool use = plan.use && slice < kMaxReprojectionViews &&
+                plan.record.block_size == parameters.flow_block_size &&
+                own_rect[2] >= 1.0F && own_rect[3] >= 1.0F && theirs_rect[2] >= 1.0F && theirs_rect[3] >= 1.0F &&
+                std::abs(theirs[1] - theirs[0]) > 1.0e-6F && std::abs(theirs[3] - theirs[2]) > 1.0e-6F;
+            std::array<float, 4> map{};
+            if (use) {
+                // A pixel of this image -> its tangent -> the periphery
+                // image's pixel -> the flow's texel (frame_synthesis.hlsl,
+                // flow_input_coordinate and flow_for_pixel_spread):
+                // texel = (q + 0.5) * ratio / block - 0.5, q the periphery
+                // pixel; tangent = t0 + (t1 - t0) * (pixel - x + 0.5) / w.
+                const float to_texel = plan.record.input_ratio / static_cast<float>(plan.record.block_size);
+                const float step_x = (own[1] - own[0]) / (theirs[1] - theirs[0]) * theirs_rect[2] / own_rect[2];
+                const float step_y = (own[3] - own[2]) / (theirs[3] - theirs[2]) * theirs_rect[3] / own_rect[3];
+                const float first_x = theirs_rect[0] + (own[0] - theirs[0]) / (theirs[1] - theirs[0]) * theirs_rect[2] +
+                    step_x * (0.5F - own_rect[0]);
+                const float first_y = theirs_rect[1] + (own[2] - theirs[2]) / (theirs[3] - theirs[2]) * theirs_rect[3] +
+                    step_y * (0.5F - own_rect[1]);
+                map = {step_x * to_texel, step_y * to_texel, first_x * to_texel - 0.5F,
+                    first_y * to_texel - 0.5F};
+                use = std::isfinite(map[0]) && std::isfinite(map[1]) && std::isfinite(map[2]) &&
+                    std::isfinite(map[3]) && map[0] > 0.0F && map[1] > 0.0F;
+            }
+            if (slice < kMaxReprojectionViews) {
+                view_description.Format = DXGI_FORMAT_R16G16_SINT;
+                device->CreateShaderResourceView(use ? plan.record.flow.Get() : nullptr, &view_description,
+                    offset_cpu_handle(cpu_start, slice * kDescriptorBlockSize + 4U, increment));
+                view_description.Format = DXGI_FORMAT_R8_UINT;
+                device->CreateShaderResourceView(use ? plan.record.cost.Get() : nullptr, &view_description,
+                    offset_cpu_handle(cpu_start, slice * kDescriptorBlockSize + 5U, increment));
+            }
+            slot.fill_foreign[view] = {};
+            if (use) {
+                slot.fill_foreign[view] = {plan.record.flow, plan.record.cost};
+                barriers[barrier_count++] = transition_barrier(plan.record.flow.Get(),
+                    D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+                barriers[barrier_count++] = transition_barrier(plan.record.cost.Get(),
+                    D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+                pair_fill_bound[view] = true;
+                pair_fill_map[view] = map;
+            }
+        }
+        slot.fill_views_written = true;
+        if (barrier_count != 0U) {
+            list->ResourceBarrier(barrier_count, barriers.data());
+        }
+    }
+
+    // The foreign textures back to rest, after the pair's compositions.
+    void end_foveated_flow(ID3D12GraphicsCommandList* list, WorkSlot& slot) noexcept {
+        std::array<D3D12_RESOURCE_BARRIER, 2U * kMaxReprojectionViews> barriers{};
+        UINT barrier_count = 0;
+        for (UINT view = 0; view < kMaxReprojectionViews; ++view) {
+            if (!pair_fill_bound[view] || slot.fill_foreign[view][0] == nullptr ||
+                slot.fill_foreign[view][1] == nullptr) {
+                continue;
+            }
+            barriers[barrier_count++] = transition_barrier(slot.fill_foreign[view][0].Get(),
+                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+            barriers[barrier_count++] = transition_barrier(slot.fill_foreign[view][1].Get(),
+                D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON);
+        }
+        if (barrier_count != 0U) {
+            list->ResourceBarrier(barrier_count, barriers.data());
+        }
+    }
+
+    // The composition constants' per-view part of the fill: the map, or
+    // zeros (not bound). Only on a focus swapchain at fill = 2; the
+    // constants are otherwise left as they are.
+    void apply_foveated_flow(SynthesisParameters& parameters, UINT view_index) const noexcept {
+        if (!foveated_fill_from_periphery() || view_index >= kMaxReprojectionViews) {
+            return;
+        }
+        const bool bound = pair_fill_bound[view_index];
+        parameters.game_motion_scale = bound
+            ? std::array<float, 2>{pair_fill_map[view_index][0], pair_fill_map[view_index][1]}
+            : std::array<float, 2>{};
+        parameters.game_motion_jitter_delta = bound
+            ? std::array<float, 2>{pair_fill_map[view_index][2], pair_fill_map[view_index][3]}
+            : std::array<float, 2>{};
+    }
+
+    // The GPU waits, with the pair's other waits.
+    [[nodiscard]] HRESULT wait_foveated_flow(const RollingSource& previous_source) noexcept {
+        if (!foveated_linked() || backend != D3D12OpticalFlowBackend::nvidia) {
+            return S_OK;
+        }
+        const UINT view_count = std::min<UINT>(previous_source.view_count, kMaxReprojectionViews);
+        for (UINT view = 0; view < view_count; ++view) {
+            HRESULT result = S_OK;
+            if (foveated_focus) {
+                if (pair_fill_bound[view]) {
+                    result = wait_once(fill_plan[view].record.fence.Get(), fill_plan[view].record.fence_value);
+                }
+            } else {
+                D3D12FoveatedLink::CursorReader reader{};
+                if (foveated_link->flow_reader(cockpit_mask_eye(previous_source.views[view], view), &reader)) {
+                    result = wait_once(reader.fence.Get(), reader.fence_value);
+                }
+            }
+            if (FAILED(result)) {
+                return result;
+            }
+        }
+        return S_OK;
+    }
+
+    // What this pair leaves in the link: the periphery layer its flow, the
+    // focus layer when its read of it is done.
+    void publish_foveated_flow(const WorkSlot& slot, const RollingSource& previous_source,
+        std::uint64_t current_serial, bool submitted) noexcept {
+        if (!foveated_linked() || backend != D3D12OpticalFlowBackend::nvidia) {
+            return;
+        }
+        const UINT view_count = std::min<UINT>(previous_source.view_count, kMaxReprojectionViews);
+        for (UINT view = 0; view < view_count; ++view) {
+            const UINT eye = cockpit_mask_eye(previous_source.views[view], view);
+            if (foveated_focus) {
+                if (submitted && pair_fill_bound[view]) {
+                    foveated_link->note_flow_reader(eye, fence.Get(), last_synthetic_fence_value);
+                }
+                continue;
+            }
+            const FlowStash& stash = flow_stash[view];
+            if (!submitted || !stash.valid || stash.slice >= kMaxReprojectionViews ||
+                flow_stash_block == 0U || !(flow_stash_ratio > 0.0F)) {
+                foveated_link->clear_flow(eye);
+                continue;
+            }
+            D3D12FoveatedLink::FlowRecord record{};
+            record.flow = slot.nvidia_eyes[stash.slice].flow;
+            record.cost = slot.nvidia_eyes[stash.slice].cost;
+            record.fence = fence;
+            record.fence_value = last_synthetic_fence_value;
+            record.previous_token = foveated_token_of(previous_source.ticket.serial);
+            record.current_token = foveated_token_of(current_serial);
+            record.tangents = stash.tangents;
+            record.rect = stash.rect;
+            record.input_ratio = flow_stash_ratio;
+            record.block_size = flow_stash_block;
+            foveated_link->publish_flow(eye, record);
+        }
+    }
+
