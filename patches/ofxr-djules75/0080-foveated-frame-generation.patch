+                                for (UINT channel = 0; channel < 3; ++channel)
+                                    ordinary_differences += filled.synthetics[s][eye][at + channel] !=
+                                        held.synthetics[s][eye][at + channel] ? 1U : 0U;
+                            }
+                            if (inside < -1.5F && x >= kBorder && y >= kBorder && x + kBorder < kFocusWidth &&
+                                y + kBorder < kFocusHeight) {
+                                ++zone;
+                                for (UINT channel = 0; channel < 3; ++channel) {
+                                    const int wanted = truth[eye][at + channel];
+                                    held_error += std::abs(static_cast<int>(held.synthetics[s][eye][at + channel]) -
+                                        wanted);
+                                    filled_error += std::abs(
+                                        static_cast<int>(filled.synthetics[s][eye][at + channel]) - wanted);
+                                }
+                            }
+                        }
+                    }
+                    const double samples = zone != 0 ? static_cast<double>(zone) * 3.0 : 1.0;
+                    held_error /= samples;
+                    filled_error /= samples;
+                    const std::string what = std::string("focus fill ") + c.name + " rotated=" +
+                        (rotated ? "1" : "0") + (triple ? " 3X" : " 2X") + " synthetic=" + std::to_string(s) +
+                        " eye=" + std::to_string(eye);
+                    std::cout << what << ": zone " << zone << " pixels, mae against the true frame: filled "
+                              << filled_error << ", key off (B held) " << held_error << "; alpha bytes not B's "
+                              << alpha_differences << "; colour bytes changed well inside A " << ordinary_differences
+                              << '\n';
+                    require(alpha_differences == 0, what + ": the fill changed an alpha");
+                    require(ordinary_differences == 0, what + ": the fill changed a colour well inside A");
+                    if (zone < 500) continue; // pursuit: the zone is a few pixels wide and under the border
+                    // Guessed limits: counted, the run goes on and fails at its end.
+                    if (held_error < 4.0 || filled_error > 0.5 * held_error || filled_error > 4.0) {
+                        ++g_uncovered_guess_failures;
+                        std::cout << "GUESS EXCEEDED: " << what << ": the zone is not B moved by the known motion "
+                                  << "(filled " << filled_error << ", held " << held_error << ")" << '\n';
+                    }
+                }
+            }
+        }
+}
