+// ---------------------------------------------------------------------------
+// Round 7: `foveated_uncovered_fill = 2`, the periphery layer's flow.
+
+// The textured world of (g), in which only the part to the right of the
+// azimuth `split` turns by `world_yaw` (a window onto a moving scene: the
+// border stays, the content behind it moves). Any size; `focus`: the focus
+// fade in alpha.
+constexpr UINT kFill2PeripherySize = 512;
+StereoPattern split_world_pattern(const ReprojectionViews& views, UINT width, UINT height, float world_yaw,
+    float split, bool focus) {
+    StereoPattern pattern;
+    const xrfg::Quaternion turn{0.0F, std::sin(world_yaw * 0.5F), 0.0F, std::cos(world_yaw * 0.5F)};
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        auto& bytes = pattern[eye];
+        bytes.resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        const auto& view = views[eye];
+        const float left = std::tan(view.fov.angle_left), right = std::tan(view.fov.angle_right);
+        const float up = std::tan(view.fov.angle_up), down = std::tan(view.fov.angle_down);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const float u = (static_cast<float>(x) + 0.5F) / static_cast<float>(width);
+                const float v = (static_cast<float>(y) + 0.5F) / static_cast<float>(height);
+                xrfg::Vec3 ray = rotate_vector(view.pose.orientation,
+                    {left + (right - left) * u, up + (down - up) * v, -1.0F});
+                if (std::atan2(ray.x, -ray.z) > split) ray = rotate_vector(turn, ray);
+                const double azimuth = std::atan2(static_cast<double>(ray.x), -static_cast<double>(ray.z));
+                const double elevation = std::atan2(static_cast<double>(ray.y),
+                    std::sqrt(static_cast<double>(ray.x) * ray.x + static_cast<double>(ray.z) * ray.z));
+                const std::size_t at = (static_cast<std::size_t>(y) * width + x) * kBytesPerPixel;
+                for (std::uint32_t channel = 0; channel < 3; ++channel) {
+                    const double level = 0.45 * fovq::value_noise(azimuth, elevation, 0.030, 11U) +
+                        0.25 * fovq::value_noise(azimuth, elevation, 0.0125, 23U + channel) +
+                        0.30 * fovq::value_noise(azimuth, elevation, 0.30, 37U + channel * 5U);
+                    bytes[at + channel] = static_cast<std::uint8_t>(std::clamp(30.0 + 200.0 * level, 0.0, 255.0));
+                }
+                bytes[at + 3] = focus ? focus_edge_alpha(x, y) : std::uint8_t{255};
+            }
+        }
+    }
+    return pattern;
+}
+
+// One swapchain of the two-layer rig of (h): any size.
+struct Fill2Pipeline {
+    std::array<ComPtr<ID3D12Resource>, 2> sources;
+    std::array<ComPtr<ID3D12Resource>, 2> currents;
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics;
+    std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+    xrfg::D3D12FrameSynthesizer synthesizer;
+};
+
+void fill2_initialize(D3D12WarpFixture& fixture, Fill2Pipeline& pipeline, UINT width, UINT height,
+    const StereoPattern& a, const StereoPattern& b, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options) {
+    for (auto& texture : pipeline.sources) texture = create_source_texture(fixture, width, height);
+    for (auto& texture : pipeline.currents) texture = create_source_texture(fixture, width, height);
+    for (auto& texture : pipeline.synthetics) texture = create_source_texture(fixture, width, height);
+    upload_pattern(fixture, pipeline.sources[0].Get(), a);
+    upload_pattern(fixture, pipeline.sources[1].Get(), b);
+    std::array<ID3D12Resource*, 2> inputs{pipeline.sources[0].Get(), pipeline.sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+    std::array<ID3D12Resource*, 2> middle{pipeline.synthetics[0].Get(), pipeline.synthetics[1].Get()};
+    pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(pipeline.history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "fill 2: history initialization");
+    require_hresult(pipeline.synthesizer.initialize(fixture.device(), fixture.queue(), pipeline.history,
+        outputs, middle, kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET, backend, options),
+        "fill 2: synthesizer initialization");
+}
+
+struct Fill2Run {
+    StereoPattern focus_b;                 // frame B of the focus layer as uploaded
+    StereoPattern focus_real;              // its current output
+    std::vector<StereoPattern> synthetics; // the focus layer's: one (2X) or two (3X)
+};
+
+// The periphery layer (kFill2PeripherySize square over the eye, flow input
+// at 100 %) and the focus layer (the box of gaze_a / gaze_b) of the split
+// world, each with a synthesizer, joined by a link as the layer joins them.
+// `periphery_first`: the order of the two swapchains' submissions.
+Fill2Run run_fill2_pair(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base, std::uint32_t fill, FocusGaze gaze_a, FocusGaze gaze_b,
+    bool rotated, float world_yaw, float split, bool triple, bool periphery_first) {
+    const ReprojectionViews focus_a = focus_views(gaze_a, false);
+    const ReprojectionViews focus_b = focus_views(gaze_b, rotated);
+    ReprojectionViews eye_a = make_reprojection_views();
+    ReprojectionViews eye_b = make_reprojection_views();
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        eye_a[eye].image_rect = xrfg::D3D12ImageRect{0, 0, kFill2PeripherySize, kFill2PeripherySize};
+        eye_b[eye].image_rect = eye_a[eye].image_rect;
+        eye_b[eye].pose.orientation = focus_b[eye].pose.orientation; // one head
+    }
+    xrfg::D3D12NvidiaOpticalFlowOptions periphery_options = base, focus_options = base;
+    periphery_options.foveated_layers = true;
+    periphery_options.input_scale = xrfg::D3D12NvidiaInputScale::full;
+    focus_options.foveated_layers = true;
+    focus_options.foveated_uncovered_fill = fill;
+    Fill2Run run;
+    run.focus_b = split_world_pattern(focus_b, kFocusWidth, kFocusHeight, world_yaw, split, true);
+    Fill2Pipeline periphery;
+    Fill2Pipeline focus;
+    fill2_initialize(fixture, periphery, kFill2PeripherySize, kFill2PeripherySize,
+        split_world_pattern(eye_a, kFill2PeripherySize, kFill2PeripherySize, 0.0F, split, false),
+        split_world_pattern(eye_b, kFill2PeripherySize, kFill2PeripherySize, world_yaw, split, false), backend,
+        periphery_options);
+    fill2_initialize(fixture, focus, kFocusWidth, kFocusHeight,
+        split_world_pattern(focus_a, kFocusWidth, kFocusHeight, 0.0F, split, true), run.focus_b, backend,
+        focus_options);
+    const auto link = std::make_shared<xrfg::D3D12FoveatedLink>();
+    const auto submit = [&](Fill2Pipeline& pipeline, bool is_focus, UINT frame, std::uint64_t token) {
+        const ReprojectionViews& views = is_focus ? (frame == 0 ? focus_a : focus_b) : (frame == 0 ? eye_a : eye_b);
+        xrfg::D3D12HistoryCaptureTicket capture{};
+        xrfg::D3D12FrameSynthesisTicket ticket{};
+        require_hresult(pipeline.history->capture(frame, &capture), "fill 2: capture");
+        require_hresult(pipeline.history->commit(capture), "fill 2: commit");
+        pipeline.synthesizer.set_foveated_focus(is_focus);
+        pipeline.synthesizer.set_foveated_link(link, true, token);
+        if (frame == 0) {
+            require_hresult(pipeline.synthesizer.submit_prime(capture, views, 0, &ticket), "fill 2: prime");
+        } else {
+            require_hresult(pipeline.synthesizer.submit_pair(capture, views, views, 0, 1, &ticket, std::nullopt, {},
+                    false, triple ? 1.0F / 3.0F : 0.5F,
+                    triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                           : std::nullopt),
+                "fill 2: pair");
+        }
+    };
+    for (const UINT frame : {0U, 1U}) {
+        const std::uint64_t token = frame == 0 ? 1000U : 2000U;
+        if (periphery_first) {
+            submit(periphery, false, frame, token);
+            submit(focus, true, frame, token);
+        } else {
+            submit(focus, true, frame, token);
+            submit(periphery, false, frame, token);
+        }
+    }
+    require_hresult(focus.synthesizer.wait_for_idle(), "fill 2: focus idle");
+    require_hresult(periphery.synthesizer.wait_for_idle(), "fill 2: periphery idle");
+    run.focus_real = readback_pattern(fixture, focus.currents[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+    run.synthetics.push_back(
+        readback_pattern(fixture, focus.synthetics[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    if (triple) {
+        run.synthetics.push_back(
+            readback_pattern(fixture, focus.synthetics[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    require_hresult(focus.history->invalidate(), "fill 2: focus history invalidate");
+    require_hresult(periphery.history->invalidate(), "fill 2: periphery history invalidate");
+    return run;
+}
