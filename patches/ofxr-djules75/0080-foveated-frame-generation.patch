diff --git a/tests/layer_two_layers.cmake b/tests/layer_two_layers.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_two_layers.cmake
@@ -0,0 +1,84 @@
+# Foveated frame generation: the two-layer shape through the call chain's
+# scenarios (tests/layer_call_chain.cpp, "two:<scenario>"): the application
+# submits a periphery layer and a focus layer per frame, each on one swapchain
+# of two slices, the focus field of view moving every frame, as Quad Views'
+# two-layer mode does. BASE_INI is the scenario's own ini; this script adds
+# `foveated_layers=1` (TWO=1) and turns the flight log on, plus EXTRA_KEYS
+# ("key=value;key=value") under [ofxr].
+#   TWO=1: the scenario's own verdict, the fake runtime's two-layer checks
+#   (every xrEndFrame: two projection layers in the application's order with
+#   their flags, both layers of one kind and slot, the focus field of view the
+#   frame's own, in "two:dcs" the focus synthetic's alpha), and in the flight
+#   log " op=foveated_mode result=1 " (active) and never " result=2 ".
+#   TWO=0: the composed twin: the same scenario, ini and keys, one layer, no
+#   foveated key, for the scenarios the suite does not already run that way.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN BASE_INI WORK_DIR MODE TWO)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(READ "${BASE_INI}" ini_text)
+set(added "")
+if(TWO)
+    string(APPEND added "foveated_layers=1\n")
+endif()
+if(DEFINED EXTRA_KEYS)
+    foreach(extra_key IN LISTS EXTRA_KEYS)
+        string(APPEND added "${extra_key}\n")
+    endforeach()
+endif()
+string(REPLACE "[ofxr]" "[ofxr]\n${added}" ini_text "${ini_text}")
+string(REPLACE "logging_enabled=0" "logging_enabled=1" ini_text "${ini_text}")
+file(WRITE "${WORK_DIR}/ofxr_bridge.ini" "${ini_text}")
+
+if(TWO)
+    set(scenario "two:${MODE}")
+else()
+    set(scenario "${MODE}")
+endif()
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${scenario}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${scenario}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+file(STRINGS "${flight_log}" mode_lines REGEX " op=foveated_mode result=")
+set(active 0)
+set(not_applied 0)
+foreach(line IN LISTS mode_lines)
+    if(line MATCHES " op=foveated_mode result=1 ")
+        math(EXPR active "${active} + 1")
+    else()
+        math(EXPR not_applied "${not_applied} + 1")
+    endif()
+endforeach()
+if(TWO)
+    if(active LESS 1 OR NOT not_applied EQUAL 0)
+        message(FATAL_ERROR
+            "foveated mode: ${active} 'active' and ${not_applied} 'not applied' records "
+            "(one or more active, none not applied expected): ${mode_lines}")
+    endif()
+elseif(NOT active EQUAL 0 OR NOT not_applied EQUAL 0)
+    message(FATAL_ERROR "foveated_mode records without the key: ${mode_lines}")
+endif()
+message(STATUS "Two layers '${scenario}': foveated mode active ${active}, not applied ${not_applied}")
diff --git a/tests/layer_warm_private_images.cmake b/tests/layer_warm_private_images.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_warm_private_images.cmake
@@ -0,0 +1,95 @@
+# Start-up stall (round 5): `[ofxr] warm_private_images`. Runs the call-chain
+# scenario MODE (dcs-async-arm with async_arm=0: generation armed on the frame
+# path while the fake runtime takes 80 ms per private swapchain, so frames
+# pass through and prime on the application's thread before the presenter
+# starts) with WARM_INI beside the layer DLL. The scenario checks what reached
+# the fake runtime itself (every frame accepted, its own counts); this the
+# flight log.
+#   EXPECT=1 (warm_private_images=1): at least one slow_step 9 record, each
+#   with layers added (b) and images released (c), b <= 8.
+#   EXPECT=0 (key off or missing): no slow_step 9 record.
+# Both (logging on): the synthesizer's initialisation steps are recorded
+# (slow_step 12, steps 1..7 for each synthesizer).
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN WARM_INI WORK_DIR MODE EXPECT)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${WARM_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(warm_ini_name "${WARM_INI}" NAME)
+file(RENAME "${WORK_DIR}/${warm_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${MODE}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${MODE}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+message(STATUS "${call_chain_output}")
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+
+set(field_pattern "result=(-?[0-9]+) dur_us=([0-9]+) a=([0-9]+) b=([0-9]+) c=([0-9]+)")
+file(STRINGS "${flight_log}" step_lines REGEX " op=slow_step result=")
+set(warm_records 0)
+set(warm_layers 0)
+set(warm_images 0)
+set(init_steps 0)
+set(slow_calls 0)
+foreach(line IN LISTS step_lines)
+    if(NOT line MATCHES "${field_pattern}")
+        message(FATAL_ERROR "Malformed slow_step record: ${line}")
+    endif()
+    set(step_result "${CMAKE_MATCH_1}")
+    set(step_b "${CMAKE_MATCH_4}")
+    set(step_c "${CMAKE_MATCH_5}")
+    if(step_result EQUAL 9)
+        math(EXPR warm_records "${warm_records} + 1")
+        math(EXPR warm_layers "${warm_layers} + ${step_b}")
+        math(EXPR warm_images "${warm_images} + ${step_c}")
+        if(step_b LESS 1 OR step_b GREATER 8 OR step_c LESS 1)
+            message(FATAL_ERROR "slow_step 9 with ${step_b} layers and ${step_c} images: ${line}")
+        endif()
+    elseif(step_result EQUAL 10)
+        math(EXPR slow_calls "${slow_calls} + 1")
+    elseif(step_result EQUAL 12)
+        math(EXPR init_steps "${init_steps} + 1")
+        if(step_b LESS 1 OR step_b GREATER 7)
+            message(FATAL_ERROR "slow_step 12 names step ${step_b}: ${line}")
+        endif()
+    endif()
+endforeach()
+
+if(EXPECT)
+    if(warm_records LESS 1)
+        message(FATAL_ERROR "warm_private_images=1: no slow_step 9 record (no frame took private images with it)")
+    endif()
+else()
+    if(NOT warm_records EQUAL 0)
+        message(FATAL_ERROR "warm_private_images off: ${warm_records} slow_step 9 records")
+    endif()
+endif()
+if(init_steps LESS 7)
+    message(FATAL_ERROR "Only ${init_steps} slow_step 12 records (7 per synthesizer expected)")
+endif()
+message(STATUS
+    "OFXR warm private images verified (warm_private_images=${EXPECT}): ${warm_records} frames took "
+    "${warm_images} images in ${warm_layers} layers; ${init_steps} initialisation steps and "
+    "${slow_calls} runtime xrEndFrame calls of 4 ms or more recorded")
