+    require_hresult(history->commit(a), "focus commit A");
+    xrfg::D3D12FrameSynthesisTicket prime{};
+    if (masks != nullptr) synth.set_cockpit_mask((*masks)[0]);
+    require_hresult(synth.submit_prime(a, views_a, 0, &prime), "focus prime");
+    require(readback_pattern(fixture, originals[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET) == output.previous,
+            "focus prime is not a bit-exact copy of A");
+    require_hresult(history->capture(1, &b), "focus capture B");
+    require_hresult(history->commit(b), "focus commit B");
+    xrfg::D3D12FrameSynthesisTicket pair{};
+    if (masks != nullptr) synth.set_cockpit_mask((*masks)[1]);
+    // A's FOV differs from B's: the pair must be accepted (nothing compares
+    // them), and the target camera is B's.
+    require_hresult(synth.submit_pair(b, views_b, views_b, 0, 1, &pair, std::nullopt, {}, false,
+            triple ? 1.0F / 3.0F : 0.5F,
+            triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                   : std::nullopt),
+        "focus pair with a moved FOV");
+    require(pair.previous_serial == a.serial && pair.current_serial == b.serial,
+            "focus pair lost A/B history identity");
+    output.real = readback_pattern(fixture, originals[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+    output.synthetics.push_back(readback_pattern(fixture, synthetic[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    if (triple) {
+        output.synthetics.push_back(
+            readback_pattern(fixture, synthetic[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    require_hresult(synth.wait_for_idle(), "focus drain");
+    require_hresult(history->invalidate(), "focus history invalidate");
+    return output;
+}
+
+struct FocusCase {
+    const char* name;
+    FocusGaze a;
+    FocusGaze b;
+};
+// Pursuit: a few pixels a frame (0.012 of the eye's span is 9 px of 256).
+// Saccade: 0.14 of the eye's span, 41 % of the box (105 px): B's image has a
+// band that wide A never saw. Off axis: both horizontal angles positive.
+constexpr std::array<FocusCase, 3> kFocusCases{
+    FocusCase{"pursuit", {0.0F, 0.0F}, {0.012F, 0.006F}},
+    FocusCase{"saccade", {-0.05F, 0.03F}, {0.09F, -0.04F}},
+    FocusCase{"off-axis", {0.25F, 0.10F}, {0.29F, 0.12F}}};
+
+// (i) A.fov != B.fov. The world does not move, so the synthetic (in B's
+// camera) is B's image: where A covers it, A carried through the camera
+// mapping (A's tangents, B's tangents) agrees with B; where it does not, B
+// alone. A mapping that took A's FOV for B's would blend the world displaced
+// by the gaze shift. The real frame stays a bit-exact copy of B.
+void test_moved_focus_fov(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    for (const bool foveated : {false, true}) for (const bool rotated : {false, true})
+        for (const bool triple : {false, true}) for (const FocusCase& c : kFocusCases) {
+            xrfg::D3D12NvidiaOpticalFlowOptions options = base;
+            options.foveated_layers = foveated;
+            const FocusPairResult result = run_focus_pair(fixture, backend, options, c.a, c.b, rotated, false, triple);
+            require(result.real == result.current, "moved focus FOV: the real frame is not B bit for bit");
+            const auto views_b = focus_views(c.b, rotated);
+            for (std::size_t s = 0; s < result.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const double error = mean_absolute_rgb_error_rect(result.synthetics[s], result.current,
+                    kFocusWidth, eye, views_b[eye].image_rect, 12);
+                // What a mapping blind to the FOV change would leave: A at the same pixel.
+                const double unmapped = mean_absolute_rgb_error_rect(result.previous, result.current,
+                    kFocusWidth, eye, views_b[eye].image_rect, 12);
+                std::cout << "moved focus fov " << c.name << " foveated=" << foveated << " rotated=" << rotated
+                          << (triple ? " 3X" : " 2X") << " synthetic=" << s << " eye=" << eye << " mae=" << error
+                          << " (A against B at the same pixel: " << unmapped << ")\n";
+                require(error <= 1.0, std::string("moved focus FOV ") + c.name + ": the synthetic is not B's view");
+            }
+        }
+}
+
+// (ii) The alpha edge. Both frames carry the fade in alpha, fixed in image
+// pixels. With foveated_layers every synthetic's alpha is B's at the very
+// pixel, every byte (2X and both targets of the 3X pass), and its colour is
+// the colour composed without the key, every byte. Without the key the alpha
+// is interpolated like a colour: where the FOV moved it is not B's (the
+// saccade case must show that, or this test proves nothing).
+void test_focus_alpha_edge(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    const auto alpha_of = [](const StereoPattern& image, UINT eye, std::size_t pixel) {
+        return static_cast<int>(image[eye][pixel * kBytesPerPixel + 3]);
+    };
+    const std::size_t pixels = static_cast<std::size_t>(kFocusWidth) * kFocusHeight;
+    for (const bool rotated : {false, true}) for (const bool triple : {false, true})
+        for (const FocusCase& c : kFocusCases) {
+            xrfg::D3D12NvidiaOpticalFlowOptions off = base, on = base;
+            off.foveated_layers = false;
+            on.foveated_layers = true;
+            const FocusPairResult plain = run_focus_pair(fixture, backend, off, c.a, c.b, rotated, true, triple);
+            const FocusPairResult copied = run_focus_pair(fixture, backend, on, c.a, c.b, rotated, true, triple);
+            require(plain.real == plain.current && copied.real == copied.current,
+                "alpha edge: the real frame is not B bit for bit");
+            require(plain.synthetics.size() == copied.synthetics.size(), "alpha edge: outputs missing");
+            for (std::size_t s = 0; s < copied.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                int worst_on = 0, worst_off = 0;
+                std::size_t colour_differences = 0;
+                for (std::size_t pixel = 0; pixel < pixels; ++pixel) {
+                    const int target = alpha_of(copied.current, eye, pixel);
+                    worst_on = std::max(worst_on, std::abs(alpha_of(copied.synthetics[s], eye, pixel) - target));
+                    worst_off = std::max(worst_off, std::abs(alpha_of(plain.synthetics[s], eye, pixel) - target));
+                    for (UINT channel = 0; channel < 3; ++channel)
+                        colour_differences += copied.synthetics[s][eye][pixel * kBytesPerPixel + channel] !=
+                            plain.synthetics[s][eye][pixel * kBytesPerPixel + channel];
+                }
+                std::cout << "focus alpha edge " << c.name << " rotated=" << rotated << (triple ? " 3X" : " 2X")
+                          << " synthetic=" << s << " eye=" << eye << " worst alpha error on=" << worst_on
+                          << " off=" << worst_off << " colour bytes changed=" << colour_differences << '\n';
+                require(worst_on == 0, std::string("alpha edge ") + c.name +
+                    ": a synthetic's alpha is not B's at the pixel under foveated_layers");
+                require(colour_differences == 0, std::string("alpha edge ") + c.name +
+                    ": foveated_layers changed a synthetic's colour");
+                if (std::string_view(c.name) == "saccade")
+                    require(worst_off >= 16, "alpha edge saccade: the interpolated alpha equals B's, "
+                        "so this case cannot tell the two behaviours apart");
+            }
+        }
+}
+
+// (iii) `[ofxr] foveated_uncovered_alpha`: where A's image does not hold what
+// a pixel of B shows, the focus synthetic's alpha is 0 (the runtime then
+// shows the periphery layer), with a ramp of the key's width inside A's edge.
+// Against the same pair with foveated_layers alone: no colour byte changes;
+// no alpha rises; a pixel A does not cover has alpha 0; a pixel further
+// inside A than the ramp (plus kReach for the place the flow vector reads A
+// at: the world is still, so that vector is the flow's noise) keeps B's
+// alpha, every byte. The geometric part is checked without a head rotation
+// (the box's shift in pixels is then the same everywhere); with one, the
+// first two. The saccade case must zero a good part of what B shows, or the
+// test proves nothing.
+void test_focus_uncovered_alpha(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    constexpr std::uint32_t kRamp = 8;
+    constexpr float kReach = 12.0F;
+    const std::size_t pixels = static_cast<std::size_t>(kFocusWidth) * kFocusHeight;
+    for (const bool rotated : {false, true}) for (const bool triple : {false, true})
+        for (const FocusCase& c : kFocusCases) {
+            xrfg::D3D12NvidiaOpticalFlowOptions layers = base, uncovered = base;
+            layers.foveated_layers = true;
+            uncovered.foveated_layers = true;
+            uncovered.foveated_uncovered_alpha = kRamp;
+            const FocusPairResult plain = run_focus_pair(fixture, backend, layers, c.a, c.b, rotated, true, triple);
+            const FocusPairResult ramped = run_focus_pair(fixture, backend, uncovered, c.a, c.b, rotated, true, triple);
+            require(ramped.real == ramped.current, "uncovered alpha: the real frame is not B bit for bit");
+            require(plain.synthetics.size() == ramped.synthetics.size(), "uncovered alpha: outputs missing");
+            const auto views_a = focus_views(c.a, false);
+            const auto views_b = focus_views(c.b, rotated);
+            for (std::size_t s = 0; s < ramped.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                // B's pixel in A's image (same pose): by the tangents, row 0 up.
+                const float left_a = std::tan(views_a[eye].fov.angle_left);
+                const float right_a = std::tan(views_a[eye].fov.angle_right);
+                const float up_a = std::tan(views_a[eye].fov.angle_up);
+                const float down_a = std::tan(views_a[eye].fov.angle_down);
+                const float left_b = std::tan(views_b[eye].fov.angle_left);
+                const float right_b = std::tan(views_b[eye].fov.angle_right);
+                const float up_b = std::tan(views_b[eye].fov.angle_up);
+                const float down_b = std::tan(views_b[eye].fov.angle_down);
+                std::size_t colour_differences = 0, raised = 0, shown_outside = 0, lost_inside = 0, zeroed = 0;
+                for (std::size_t pixel = 0; pixel < pixels; ++pixel) {
+                    const std::size_t at = pixel * kBytesPerPixel;
+                    for (UINT channel = 0; channel < 3; ++channel)
+                        colour_differences += ramped.synthetics[s][eye][at + channel] !=
+                            plain.synthetics[s][eye][at + channel];
+                    const int before = plain.synthetics[s][eye][at + 3]; // B's alpha (test ii)
+                    const int after = ramped.synthetics[s][eye][at + 3];
+                    raised += after > before;
+                    zeroed += before > 0 && after == 0;
+                    if (rotated) continue;
+                    const float u = (static_cast<float>(pixel % kFocusWidth) + 0.5F) / kFocusWidth;
+                    const float v = (static_cast<float>(pixel / kFocusWidth) + 0.5F) / kFocusHeight;
+                    const float tangent_x = left_b + (right_b - left_b) * u;
+                    const float tangent_y = up_b + (down_b - up_b) * v;
+                    const float a_x = (tangent_x - left_a) / (right_a - left_a) * kFocusWidth;
+                    const float a_y = (tangent_y - up_a) / (down_a - up_a) * kFocusHeight;
+                    // Pixels inside A's image (negative: outside it).
+                    const float inside = std::min(std::min(a_x, static_cast<float>(kFocusWidth) - a_x),
+                        std::min(a_y, static_cast<float>(kFocusHeight) - a_y));
+                    shown_outside += inside < -1.0F && after != 0;
+                    lost_inside += inside > static_cast<float>(kRamp) + kReach && after != before;
+                }
+                std::cout << "focus uncovered alpha " << c.name << " rotated=" << rotated << (triple ? " 3X" : " 2X")
+                          << " synthetic=" << s << " eye=" << eye << " zeroed=" << zeroed << " raised=" << raised
+                          << " shown outside A=" << shown_outside << " changed well inside A=" << lost_inside
+                          << " colour bytes changed=" << colour_differences << '\n';
+                require(colour_differences == 0, std::string("uncovered alpha ") + c.name +
+                    ": foveated_uncovered_alpha changed a synthetic's colour");
+                require(raised == 0, std::string("uncovered alpha ") + c.name + ": an alpha rose above B's");
+                require(shown_outside == 0, std::string("uncovered alpha ") + c.name +
+                    ": a pixel A does not cover kept its alpha");
+                require(lost_inside == 0, std::string("uncovered alpha ") + c.name +
+                    ": a pixel well inside A lost alpha");
+                if (std::string_view(c.name) == "saccade")
+                    require(zeroed >= pixels / 10, "uncovered alpha saccade: almost nothing was taken out, "
+                        "so this case cannot tell the two behaviours apart");
+            }
+        }
+}
+
+// (iv) Round 4: the smooth cursor on two layers. One eye pair, two swapchains:
+// a periphery image over the eye's field of view and a focus image over a
+// third of it per axis (kLayerRatio focus pixels per periphery pixel; the real
+// shape has 5.7), both kLayerWidth x kLayerHeight, each with a synthesizer of
+// its own, joined by a D3D12FoveatedLink and submitted focus first, as the
+// layer does. The cursor is the built-in arrow at its image's size in the
+// focus image and a third of it in the periphery (11 pixels: below every
+// template scale), at the same tangent in both, moving 48 focus pixels
+// between A and B: further than its size, so flow alone leaves it faded at
+// both places.
+constexpr UINT kLayerWidth = 240, kLayerHeight = 180;
+constexpr int kLayerRatio = 3;
+constexpr int kLayerBoxWidth = static_cast<int>(kLayerWidth) / kLayerRatio;
+constexpr int kLayerBoxHeight = static_cast<int>(kLayerHeight) / kLayerRatio;
+
+// The focus box's top-left corner in periphery pixels.
+struct LayerBox {
+    int left;
+    int top;
+};
+
+ReprojectionViews layer_periphery_views() {
+    auto views = make_reprojection_views();
+    for (UINT eye = 0; eye < kEyeCount; ++eye)
+        views[eye].image_rect = xrfg::D3D12ImageRect{0, 0, kLayerWidth, kLayerHeight};
+    return views;
+}
+
+ReprojectionViews layer_focus_views(LayerBox box) {
+    auto views = make_reprojection_views();
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        const float left = std::tan(views[eye].fov.angle_left);
+        const float right = std::tan(views[eye].fov.angle_right);
+        const float up = std::tan(views[eye].fov.angle_up);
+        const float down = std::tan(views[eye].fov.angle_down);
+        const auto across = [&](int pixel) {
+            return left + (right - left) * static_cast<float>(pixel) / static_cast<float>(kLayerWidth);
+        };
+        const auto along = [&](int pixel) {
+            return up + (down - up) * static_cast<float>(pixel) / static_cast<float>(kLayerHeight);
+        };
+        views[eye].fov.angle_left = std::atan(across(box.left));
+        views[eye].fov.angle_right = std::atan(across(box.left + kLayerBoxWidth));
+        views[eye].fov.angle_up = std::atan(along(box.top));
+        views[eye].fov.angle_down = std::atan(along(box.top + kLayerBoxHeight));
+        views[eye].image_rect = xrfg::D3D12ImageRect{0, 0, kLayerWidth, kLayerHeight};
+    }
+    return views;
+}
+
+// The focus layer's alpha: anything that is a function of the pixel alone.
+std::uint8_t layer_focus_alpha(UINT x, UINT y) {
+    return static_cast<std::uint8_t>(96U + (x * 7U + y * 13U) % 160U);
+}
+
+StereoPattern layer_world(const ReprojectionViews& views, bool focus) {
+    StereoPattern pattern = ray_direction_pattern(kLayerWidth, kLayerHeight, views);
+    if (focus) {
+        for (UINT eye = 0; eye < kEyeCount; ++eye)
+            for (UINT y = 0; y < kLayerHeight; ++y)
+                for (UINT x = 0; x < kLayerWidth; ++x)
+                    pattern[eye][(static_cast<std::size_t>(y) * kLayerWidth + x) * kBytesPerPixel + 3] =
+                        layer_focus_alpha(x, y);
+    }
+    return pattern;
+}
+
+void layer_draw_cursor(StereoPattern* pattern, CursorPosition at, const Sprite& sprite) {
+    for (UINT eye = 0; eye < kEyeCount; ++eye)
+        draw_cursor_sized(pattern, eye, kLayerWidth, kLayerHeight, at, sprite);
+}
+
+// One layer's swapchain: its two real frames, its outputs, its synthesizer.
+struct LayerPipeline {
+    std::array<ComPtr<ID3D12Resource>, 2> sources;
+    std::array<ComPtr<ID3D12Resource>, 2> currents;
+    std::array<ComPtr<ID3D12Resource>, 1> synthetics;
+    std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+    xrfg::D3D12FrameSynthesizer synthesizer;
+};
+
+void layer_initialize(D3D12WarpFixture& fixture, LayerPipeline& pipeline, const StereoPattern& a,
+    const StereoPattern& b, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options, bool feature) {
+    for (auto& texture : pipeline.sources) texture = create_source_texture(fixture, kLayerWidth, kLayerHeight);
+    for (auto& texture : pipeline.currents) texture = create_source_texture(fixture, kLayerWidth, kLayerHeight);
+    for (auto& texture : pipeline.synthetics) texture = create_source_texture(fixture, kLayerWidth, kLayerHeight);
+    upload_pattern(fixture, pipeline.sources[0].Get(), a);
+    upload_pattern(fixture, pipeline.sources[1].Get(), b);
+    std::array<ID3D12Resource*, 2> inputs{pipeline.sources[0].Get(), pipeline.sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{pipeline.currents[0].Get(), pipeline.currents[1].Get()};
+    std::array<ID3D12Resource*, 1> middle{pipeline.synthetics[0].Get()};
+    pipeline.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(pipeline.history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "two layers: history initialization");
+    require_hresult(pipeline.synthesizer.initialize(fixture.device(), fixture.queue(), pipeline.history,
+        outputs, middle, kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET, backend, options),
+        "two layers: synthesizer initialization");
+    if (feature) {
+        xrfg::D3D12SmoothCursorOptions cursor{};
+        cursor.enabled = true;
+        cursor.templates.push_back(xrfg::built_in_arrow_template());
+        require(pipeline.synthesizer.set_smooth_cursor(cursor) == S_OK, "two layers: set_smooth_cursor");
+    }
+}
+
+struct LayerCursorRun {
+    StereoPattern focus_b;       // frame B as uploaded
+    StereoPattern periphery_b;
+    StereoPattern focus_real;    // the current outputs
+    StereoPattern periphery_real;
+    StereoPattern focus_synthetic;
+    StereoPattern periphery_synthetic;
+    // What a synthetic must show: B's world without the cursor, and the
+    // cursor once, half way (2X) between its two tangents.
+    StereoPattern focus_expected;
+    StereoPattern periphery_expected;
+    // The pixels around the cursor's three places: x0, y0, x1, y1.
+    std::array<int, 4> focus_region{};
+    std::array<int, 4> periphery_region{};
+    xrfg::D3D12SmoothCursorStats focus_stats{};
+    xrfg::D3D12SmoothCursorStats periphery_stats{};
+};
+
+LayerCursorRun run_layer_cursor(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    xrfg::D3D12NvidiaOpticalFlowOptions options, LayerBox box_a, LayerBox box_b, bool feature, bool linked,
+    bool mouse_moves,
+    // Round 5: the cursor's corner, this many periphery pixels right of the
+    // focus box's left edge in frame A.
+    int inset = 20) {
+    options.foveated_layers = true;
+    // The cursor's corner in periphery pixels (view-locked: the gaze does not
+    // move it), and in each frame's focus image.
+    const CursorPosition periphery_a{box_a.left + inset, box_a.top + 20};
+    const CursorPosition periphery_to{periphery_a[0] + 16, periphery_a[1] + 8};
+    const auto in_focus = [](CursorPosition at, LayerBox box) {
+        return CursorPosition{(at[0] - box.left) * kLayerRatio, (at[1] - box.top) * kLayerRatio};
+    };
+    const CursorPosition focus_a = in_focus(periphery_a, box_a);
+    const CursorPosition focus_to = in_focus(periphery_to, box_b);
+    // A's place in B's focus image, and the 2X synthetic's place in both.
+    const CursorPosition focus_a_in_b = in_focus(periphery_a, box_b);
+    const CursorPosition periphery_middle{(periphery_a[0] + periphery_to[0]) / 2,
+        (periphery_a[1] + periphery_to[1]) / 2};
+    const CursorPosition focus_middle{(focus_a_in_b[0] + focus_to[0]) / 2, (focus_a_in_b[1] + focus_to[1]) / 2};
+    const Sprite focus_sprite = make_sprite(xrfg::built_in_arrow_template(), 1.0F);
+    const Sprite periphery_sprite =
+        make_sprite(xrfg::built_in_arrow_template(), 1.0F / static_cast<float>(kLayerRatio));
+
+    const ReprojectionViews periphery_views = layer_periphery_views();
+    const ReprojectionViews focus_views_a = layer_focus_views(box_a);
+    const ReprojectionViews focus_views_b = layer_focus_views(box_b);
+    StereoPattern focus_frame_a = layer_world(focus_views_a, true);
+    StereoPattern periphery_frame_a = layer_world(periphery_views, false);
+    LayerCursorRun run;
+    run.focus_b = layer_world(focus_views_b, true);
+    run.periphery_b = layer_world(periphery_views, false);
+    run.focus_expected = run.focus_b;
+    run.periphery_expected = run.periphery_b;
+    layer_draw_cursor(&focus_frame_a, focus_a, focus_sprite);
+    layer_draw_cursor(&periphery_frame_a, periphery_a, periphery_sprite);
+    layer_draw_cursor(&run.focus_b, focus_to, focus_sprite);
+    layer_draw_cursor(&run.periphery_b, periphery_to, periphery_sprite);
+    layer_draw_cursor(&run.focus_expected, focus_middle, focus_sprite);
+    layer_draw_cursor(&run.periphery_expected, periphery_middle, periphery_sprite);
+    const auto region = [](CursorPosition from, CursorPosition to, int side, int margin) {
+        return std::array<int, 4>{
+            std::max(std::min(from[0], to[0]) - margin, 0),
+            std::max(std::min(from[1], to[1]) - margin, 0),
+            std::min(std::max(from[0], to[0]) + side + margin, static_cast<int>(kLayerWidth)),
+            std::min(std::max(from[1], to[1]) + side + margin, static_cast<int>(kLayerHeight))};
+    };
+    run.focus_region = region(focus_a_in_b, focus_to, focus_sprite.size, 8);
+    run.periphery_region = region(periphery_a, periphery_to, periphery_sprite.size, 4);
+
+    LayerPipeline focus;
+    LayerPipeline periphery;
+    layer_initialize(fixture, focus, focus_frame_a, run.focus_b, backend, options, feature);
+    layer_initialize(fixture, periphery, periphery_frame_a, run.periphery_b, backend, options, feature);
+    const std::shared_ptr<xrfg::D3D12FoveatedLink> link =
+        linked ? std::make_shared<xrfg::D3D12FoveatedLink>() : nullptr;
+    // What the layer does before every submission of a swapchain.
+    const auto name_frame = [&](LayerPipeline& pipeline, bool is_focus, std::uint64_t token) {
+        pipeline.synthesizer.set_foveated_focus(is_focus);
+        pipeline.synthesizer.set_foveated_link(link, true, token);
+    };
+    focus.synthesizer.note_cursor_position(1200, 700, 100'000);
+    xrfg::D3D12HistoryCaptureTicket focus_capture{}, periphery_capture{};
+    xrfg::D3D12FrameSynthesisTicket focus_ticket{}, periphery_ticket{};
+    // Frame A: the focus layer's swapchain first, then the periphery's.
+    require_hresult(focus.history->capture(0, &focus_capture), "two layers: focus capture A");
