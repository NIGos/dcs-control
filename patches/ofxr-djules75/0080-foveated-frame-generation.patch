+// Foveated layers, round 4: the cursor's position between the two layers of
+// an eye and between two frames of a focus layer whose box moved
+// (foveated_cursor_tangent, foveated_cursor_position; smooth_cursor.hlsl
+// mirrors them). The shapes are the flown ones: a 1040 x 1028 periphery over
+// the eye's field of view, a 2028 x 2004 focus over 0.34 of it per axis.
+void test_foveated_cursor_positions() {
+    const std::array<float, 4> periphery_rect{0.0F, 0.0F, 1040.0F, 1028.0F};
+    const std::array<float, 4> periphery_tan{-1.0F, 1.0F, 0.75F, -0.75F};
+    const std::array<float, 4> focus_rect{0.0F, 0.0F, 2028.0F, 2004.0F};
+    const std::array<float, 4> focus_tan{-0.2F, 0.48F, 0.3F, -0.21F}; // 0.34 of 2 and of 1.5
+    const auto close_to = [](float value, double expected, double tolerance) {
+        return std::abs(static_cast<double>(value) - expected) <= tolerance;
+    };
+    // A focus position, its tangent, its periphery position, and back.
+    const std::array<float, 2> focus_position{1000.0F, 800.0F};
+    const auto tangent = xrfg::foveated_cursor_tangent(focus_position, focus_rect, focus_tan);
+    const double tangent_x = -0.2 + 0.68 * 1000.0 / 2028.0;
+    const double tangent_y = 0.3 - 0.51 * 800.0 / 2004.0;
+    require(close_to(tangent[0], tangent_x, 1.0e-5) && close_to(tangent[1], tangent_y, 1.0e-5),
+        "cursor positions: a focus pixel's tangent");
+    const auto periphery_position = xrfg::foveated_cursor_position(tangent, periphery_rect, periphery_tan);
+    require(close_to(periphery_position[0], (tangent_x + 1.0) / 2.0 * 1040.0, 1.0e-2) &&
+            close_to(periphery_position[1], (tangent_y - 0.75) / -1.5 * 1028.0, 1.0e-2),
+        "cursor positions: the same tangent in the periphery image");
+    const auto back = xrfg::foveated_cursor_position(
+        xrfg::foveated_cursor_tangent(periphery_position, periphery_rect, periphery_tan), focus_rect, focus_tan);
