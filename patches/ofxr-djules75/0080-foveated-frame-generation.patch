+// ---------------------------------------------------------------------------
+// Round 5: `[ofxr] foveated_uncovered_alpha` from "bench only" to "ready to
+// fly": what can be settled without a headset. Every case 2X and 3X (both
+// synthetic targets), except the cursor's (the cursor rig is 2X).
+
+// How far the centre of pixel (x, y) of image B lies inside image A, in A's
+// pixels (negative: outside it): the shader's foveated_cover before its
+// smoothstep. Both images are width x height over their whole fields of view.
+float inside_previous_image(const xrfg::D3D12ReprojectionView& a, const xrfg::D3D12ReprojectionView& b,
+    UINT x, UINT y, UINT width, UINT height) {
+    const float left_a = std::tan(a.fov.angle_left), right_a = std::tan(a.fov.angle_right);
+    const float up_a = std::tan(a.fov.angle_up), down_a = std::tan(a.fov.angle_down);
+    const float left_b = std::tan(b.fov.angle_left), right_b = std::tan(b.fov.angle_right);
+    const float up_b = std::tan(b.fov.angle_up), down_b = std::tan(b.fov.angle_down);
+    const float u = (static_cast<float>(x) + 0.5F) / static_cast<float>(width);
+    const float v = (static_cast<float>(y) + 0.5F) / static_cast<float>(height);
+    // B's ray into the world (as ray_direction_pattern), then into A's camera.
+    const xrfg::Vec3 world = rotate_vector(b.pose.orientation,
+        {left_b + (right_b - left_b) * u, up_b + (down_b - up_b) * v, -1.0F});
+    const xrfg::Quaternion back{-a.pose.orientation.x, -a.pose.orientation.y, -a.pose.orientation.z,
+        a.pose.orientation.w};
+    const xrfg::Vec3 ray = rotate_vector(back, world);
+    if (!(ray.z < -1.0e-5F)) return -1.0e6F;
+    const float a_x = (ray.x / -ray.z - left_a) / (right_a - left_a) * static_cast<float>(width);
+    const float a_y = (ray.y / -ray.z - up_a) / (down_a - up_a) * static_cast<float>(height);
+    return std::min(std::min(a_x, static_cast<float>(width) - a_x),
+        std::min(a_y, static_cast<float>(height) - a_y));
+}
+
+// Criteria that rest on a guessed number and were exceeded: the run goes on
+// (the later tests still say something) and fails at its end.
+int g_uncovered_guess_failures = 0;
+
+// The shader's ramp: 0 outside A, 1 from `ramp` pixels inside its edge on.
+float uncovered_cover(float inside, std::uint32_t ramp) {
+    const float t = std::clamp(inside / static_cast<float>(ramp), 0.0F, 1.0F);
+    return t * t * (3.0F - 2.0F * t);
+}
+
+// One eye's synthetic with the key against the same pair with foveated_layers
+// alone (whose alpha is B's, test ii).
+struct UncoveredDelta {
+    std::size_t colour_differences{}; // colour bytes that differ
+    std::size_t raised{};             // alpha above B's
+    std::size_t above_ramp{};         // alpha more than 2 codes above B's times the pixel's own cover
+    std::size_t shown_outside{};      // more than 1.5 px outside A and alpha not 0
+    std::size_t lost_inside{};        // more than ramp + reach inside A and alpha changed
+    float lost_inside_deepest{};      // of those: the furthest inside A, px
+    int lost_inside_worst{};          // of those: the largest loss, codes
+    int worst_drop{};                 // largest loss of alpha at a pixel, codes
+    double alpha_before{};            // sum of B's alpha
+    double alpha_lost{};              // sum of the losses
+};
+
+UncoveredDelta uncovered_delta(const StereoPattern& plain, const StereoPattern& ramped, UINT eye,
+    const ReprojectionViews& views_a, const ReprojectionViews& views_b, std::uint32_t ramp, float reach) {
+    UncoveredDelta delta;
+    for (UINT y = 0; y < kFocusHeight; ++y) {
+        for (UINT x = 0; x < kFocusWidth; ++x) {
+            const std::size_t at = (static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel;
+            for (UINT channel = 0; channel < 3; ++channel)
+                delta.colour_differences += plain[eye][at + channel] != ramped[eye][at + channel] ? 1U : 0U;
+            const int before = plain[eye][at + 3];
+            const int after = ramped[eye][at + 3];
+            delta.raised += after > before ? 1U : 0U;
+            delta.worst_drop = std::max(delta.worst_drop, before - after);
+            delta.alpha_before += static_cast<double>(before);
+            delta.alpha_lost += static_cast<double>(std::max(before - after, 0));
+            const float inside =
+                inside_previous_image(views_a[eye], views_b[eye], x, y, kFocusWidth, kFocusHeight);
+            delta.above_ramp +=
+                static_cast<float>(after) > static_cast<float>(before) * uncovered_cover(inside, ramp) + 2.0F
+                    ? 1U : 0U;
+            delta.shown_outside += inside < -1.5F && after != 0 ? 1U : 0U;
+            delta.lost_inside += inside > static_cast<float>(ramp) + reach && after != before ? 1U : 0U;
+            if (inside > static_cast<float>(ramp) + reach && after != before) {
+                delta.lost_inside_deepest = std::max(delta.lost_inside_deepest, inside);
+                delta.lost_inside_worst = std::max(delta.lost_inside_worst, before - after);
+            }
+        }
+    }
+    return delta;
+}
+
+void print_uncovered_delta(const std::string& what, const UncoveredDelta& delta) {
+    std::cout << what << ": worst alpha drop " << delta.worst_drop << " codes, alpha lost "
+              << (delta.alpha_before > 0.0 ? 100.0 * delta.alpha_lost / delta.alpha_before : 0.0)
+              << " %, raised=" << delta.raised << " above the ramp=" << delta.above_ramp
+              << " shown outside A=" << delta.shown_outside << " changed well inside A=" << delta.lost_inside << " (deepest " << delta.lost_inside_deepest
+              << " px, worst " << delta.lost_inside_worst << " codes)"
+              << " colour bytes changed=" << delta.colour_differences << '\n';
+}
+
+// (a) Tracker jitter: the gaze estimate moves the box 0.1 to 0.3 degrees
+// between two frames, back and forth, while the eye is still. Flown: 2028
+// focus pixels over about 47 degrees, so 0.3 degrees is at most 16 pixels,
+// 0.8 % of the box: 2 of this test's 256. The uncovered strip and the ramp
+// then lie where the focus fade is already near 0, so the result must be
+// practically the key off: no colour byte differs, no alpha rises, and the
+// alpha lost is small at every pixel and in sum. Two widths: 2 (the suggested
+// 16 at the flown size) and 8 (the key's maximum, 64).
+// Limits. Geometry alone gives 6 codes / 0.03 % at width 2 and 18 codes /
+// 0.2 % at width 8 with this test's fade (25.6 px; the flown fade is wider:
+// less). The limits leave room for the flow's noise at A's edge, which lowers
+// the alpha further in (R3.3 risk 3): 12 codes / 0.5 % and 40 codes / 2 %.
+// The geometric figures are computed; the room left for noise is a GUESS.
+void test_focus_uncovered_jitter(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    struct Jitter {
+        const char* name;
+        float dx; // the box's move, focus pixels
+        float dy;
+    };
+    struct Width {
+        std::uint32_t ramp;
+        int worst;   // codes
+        double lost; // of the image's alpha
+    };
+    const std::array<Jitter, 4> jitters{Jitter{"0.1 deg", 0.7F, 0.0F}, Jitter{"0.3 deg", 2.0F, 0.0F},
+        Jitter{"0.3 deg back", -2.0F, 0.0F}, Jitter{"0.3 deg diagonal", 2.0F, -2.0F}};
+    const std::array<Width, 2> widths{Width{2U, 12, 0.005}, Width{8U, 40, 0.02}};
+    // One focus pixel, in the eye's tangent spans.
+    const float pixel = kFocusSection / static_cast<float>(kFocusWidth);
+    for (const Jitter& jitter : jitters) for (const bool triple : {false, true}) {
+        const FocusGaze gaze_a{0.02F, 0.01F};
+        const FocusGaze gaze_b{gaze_a.x + jitter.dx * pixel, gaze_a.y + jitter.dy * pixel};
+        const auto views_a = focus_views(gaze_a, false);
+        const auto views_b = focus_views(gaze_b, false);
+        xrfg::D3D12NvidiaOpticalFlowOptions layers = base;
+        layers.foveated_layers = true;
+        const FocusPairResult plain = run_focus_pair(fixture, backend, layers, gaze_a, gaze_b, false, true, triple);
+        for (const Width& width : widths) {
+            xrfg::D3D12NvidiaOpticalFlowOptions uncovered = layers;
+            uncovered.foveated_uncovered_alpha = width.ramp;
+            const FocusPairResult ramped =
+                run_focus_pair(fixture, backend, uncovered, gaze_a, gaze_b, false, true, triple);
+            require(ramped.real == ramped.current, "uncovered alpha jitter: the real frame is not B bit for bit");
+            require(plain.synthetics.size() == ramped.synthetics.size(), "uncovered alpha jitter: outputs missing");
+            for (std::size_t s = 0; s < ramped.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const UncoveredDelta delta = uncovered_delta(plain.synthetics[s], ramped.synthetics[s], eye,
+                    views_a, views_b, width.ramp, 12.0F);
+                const std::string what = std::string("focus uncovered alpha jitter ") + jitter.name + " width " +
+                    std::to_string(width.ramp) + (triple ? " 3X" : " 2X") + " synthetic=" + std::to_string(s) +
+                    " eye=" + std::to_string(eye);
+                print_uncovered_delta(what, delta);
+                require(delta.colour_differences == 0, what + ": a colour byte changed");
+                require(delta.raised == 0 && delta.above_ramp == 0, what + ": an alpha is above B's times its cover");
+                require(delta.shown_outside == 0, what + ": a pixel A does not cover kept its alpha");
+                require(delta.worst_drop <= width.worst, what + ": a pixel lost more alpha than a jitter may cost");
+                require(delta.alpha_lost <= width.lost * delta.alpha_before,
+                    what + ": the image lost more alpha than a jitter may cost");
+            }
+        }
+    }
+}
