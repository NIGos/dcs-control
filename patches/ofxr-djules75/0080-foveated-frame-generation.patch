+
+// Foveated layers: the Waits a command queue already has queued, by fence.
+// Four swapchains of one frame are four submissions on one synthesis queue,
+// and each queued the same waits again: the frame's cockpit mask copy (one
+// fence value for all four), the previous frame's mask (waited for a frame
+// ago, as the current one) and the previous capture (waited for a pair ago,
+// as the current one). A queue runs in order, so a Wait for a fence at a
+// value is implied by an earlier Wait on the same queue for the same fence
+// at that value or a later one: those calls are left out. The entries hold
+// their queue and fence, so neither address can come back as another object
+// while it is listed. Given to a synthesizer by set_queue_wait_ledger (one
+// for the session's synthesizers); without one every Wait is queued as
+// before. Thread-safe.
+class D3D12QueueWaitLedger final {
+public:
+    // Whether `queue` has a Wait for `fence` at `value` or later noted here.
+    [[nodiscard]] bool covered(
+        ID3D12CommandQueue* queue, ID3D12Fence* fence, std::uint64_t value) noexcept {
+        if (queue == nullptr || fence == nullptr) {
+            return false;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            for (Entry& entry : entries_) {
+                if (entry.queue.Get() == queue && entry.fence.Get() == fence) {
+                    if (entry.value >= value) {
+                        entry.used = ++clock_;
+                        ++skipped_;
+                        return true;
+                    }
+                    return false;
+                }
+            }
+        } catch (...) {
+        }
+        return false;
+    }
+    // A Wait for `fence` at `value` was queued on `queue` (it succeeded).
+    void note(ID3D12CommandQueue* queue, ID3D12Fence* fence, std::uint64_t value) noexcept {
+        if (queue == nullptr || fence == nullptr) {
+            return;
+        }
+        try {
+            std::scoped_lock lock(mutex_);
+            Entry* oldest = &entries_[0];
+            for (Entry& entry : entries_) {
+                if (entry.queue.Get() == queue && entry.fence.Get() == fence) {
+                    entry.value = std::max(entry.value, value);
+                    entry.used = ++clock_;
+                    return;
+                }
+                if (entry.used < oldest->used) {
+                    oldest = &entry;
+                }
+            }
+            oldest->queue = queue;
+            oldest->fence = fence;
+            oldest->value = value;
+            oldest->used = ++clock_;
+        } catch (...) {
+        }
+    }
+    // How many Waits covered() answered for (they were not queued).
+    [[nodiscard]] std::uint64_t skipped() noexcept {
+        try {
+            std::scoped_lock lock(mutex_);
+            return skipped_;
+        } catch (...) {
+            return 0;
+        }
+    }
+
+private:
+    struct Entry {
+        Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue;
+        Microsoft::WRL::ComPtr<ID3D12Fence> fence;
+        std::uint64_t value{};
+        std::uint64_t used{};
+    };
+    std::mutex mutex_;
+    std::array<Entry, 16> entries_{};
+    std::uint64_t clock_{};
+    std::uint64_t skipped_{};
+};
+
+// Foveated layers, round 4: the smooth cursor's positions between the two
+// layers. Both layers of an eye have the same pose, so each image is an affine
+// function of the tangent plane (z = -1): a position of one image (in pixels
+// from the texture's corner, a pixel covering [i, i + 1): the cursor box's
+// top-left corner is such a position) has a tangent, and that tangent has a
+// position in the other image. `rect` is the view's image rectangle (x, y,
+// width, height), `tangents` its field of view (left, right, up, down), as
+// the camera mapping carries them. smooth_cursor.hlsl (cursor_tangent,
+// cursor_position) mirrors these.
+[[nodiscard]] inline std::array<float, 2> foveated_cursor_tangent(
+    const std::array<float, 2>& position,
+    const std::array<float, 4>& rect,
+    const std::array<float, 4>& tangents) noexcept {
+    const float u = (position[0] - rect[0]) / rect[2];
+    const float v = (position[1] - rect[1]) / rect[3];
+    return {tangents[0] + (tangents[1] - tangents[0]) * u,
+        tangents[2] + (tangents[3] - tangents[2]) * v};
