+    require_hresult(gpu.device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &description,
+                        D3D12_RESOURCE_STATE_COMMON, nullptr, IID_PPV_ARGS(buffer.GetAddressOf())),
+        "link: buffer");
+    xrfg::D3D12FoveatedLink link;
+    xrfg::D3D12FoveatedLink::CursorRecord found{};
+    require(!link.cursor(0, 10, 20, &found), "link: nothing published, nothing found");
+    xrfg::D3D12FoveatedLink::CursorRecord record{};
+    record.state = buffer;
+    record.view = 1;
+    record.fence = first;
+    record.fence_value = 7;
+    record.previous_token = 10;
+    record.current_token = 20;
+    link.publish_cursor(0, record);
+    require(link.cursor(0, 10, 20, &found) && found.state.Get() == buffer.Get() && found.view == 1 &&
+            found.fence.Get() == first.Get() && found.fence_value == 7,
+        "link: the record of the eye and the pair");
+    require(!link.cursor(0, 10, 21, &found) && !link.cursor(0, 11, 20, &found) && !link.cursor(0, 20, 10, &found),
+        "link: not another pair's record");
+    require(!link.cursor(1, 10, 20, &found) && !link.cursor(2, 10, 20, &found), "link: not another eye's record");
+    require(!link.cursor(0, 0, 20, &found) && !link.cursor(0, 10, 0, &found) && !link.cursor(0, 10, 20, nullptr),
+        "link: no frame, no record");
+    // Publishing something that is no record takes the eye's record away.
+    xrfg::D3D12FoveatedLink::CursorRecord no_state = record;
+    no_state.state.Reset();
+    link.publish_cursor(0, no_state);
+    require(!link.cursor(0, 10, 20, &found), "link: a record without a state buffer clears");
+    link.publish_cursor(0, record);
+    xrfg::D3D12FoveatedLink::CursorRecord no_frame = record;
+    no_frame.previous_token = 0;
+    link.publish_cursor(0, no_frame);
+    require(!link.cursor(0, 10, 20, &found), "link: a record without its previous frame clears");
+    link.publish_cursor(0, record);
+    xrfg::D3D12FoveatedLink::CursorRecord no_fence = record;
+    no_fence.fence.Reset();
+    link.publish_cursor(0, no_fence);
+    require(!link.cursor(0, 10, 20, &found), "link: a record without a fence clears");
+    link.publish_cursor(1, record);
+    link.publish_cursor(7, record); // no such eye: ignored
+    require(link.cursor(1, 10, 20, &found) && !link.cursor(0, 10, 20, &found), "link: each eye has its own");
+    link.clear_cursor(1);
+    require(!link.cursor(1, 10, 20, &found), "link: cleared");
+    // The periphery layer's reads.
+    xrfg::D3D12FoveatedLink::CursorReader reader{};
+    require(!link.cursor_reader(0, &reader), "link: no reader noted");
+    link.note_cursor_reader(0, second.Get(), 9);
+    link.note_cursor_reader(1, nullptr, 3); // no fence: ignored
+    require(link.cursor_reader(0, &reader) && reader.fence.Get() == second.Get() && reader.fence_value == 9,
+        "link: the eye's last reader");
+    require(!link.cursor_reader(1, &reader) && !link.cursor_reader(2, &reader) && !link.cursor_reader(0, nullptr),
+        "link: not another eye's reader");
+    // HUD symbology: who cannot take it out.
+    require(!link.hud_refused(false) && !link.hud_refused(true), "link: nothing refused");
+    link.refuse_hud(true);
+    require(link.hud_refused(true) && !link.hud_refused(false), "link: the focus layer's refusal is the focus layer's");
+    link.refuse_hud(false);
+    require(link.hud_refused(true) && link.hud_refused(false), "link: both refusals stand");
+    std::cout << "cockpit mask: the link between the two layers' synthesizers (foveated layers, round 4)\n";
+}
