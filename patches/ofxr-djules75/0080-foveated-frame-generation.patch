+        create_source_texture(fixture, kFocusWidth, kFocusHeight),
+        create_source_texture(fixture, kFocusWidth, kFocusHeight)};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetic{
+        create_source_texture(fixture, kFocusWidth, kFocusHeight),
+        create_source_texture(fixture, kFocusWidth, kFocusHeight)};
+    std::array<ID3D12Resource*, 2> inputs{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{originals[0].Get(), originals[1].Get()};
+    std::array<ID3D12Resource*, 2> middle{synthetic[0].Get(), synthetic[1].Get()};
+    upload_pattern(fixture, sources[0].Get(), output.previous);
+    upload_pattern(fixture, sources[1].Get(), output.current);
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "focus history initialization");
