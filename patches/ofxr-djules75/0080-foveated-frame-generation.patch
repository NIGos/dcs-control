+}
+
+// The removal on each layer's own image: a constant periphery delta and a
+// constant focus delta (test_hud_focus_mapping's atlas). The periphery
+// layer's image loses the periphery delta at every pixel, inside the focus
+// rectangle too; the focus layer's image the focus delta at every pixel.
+// The composed model on the same periphery image differs inside the focus
+// rectangle (or this would prove nothing).
+void test_hud_layer_removal(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 96, height = 64;
+    constexpr UINT focus_size = 64;
+    const float frame_linear = 0.8F;
+    const std::array<float, 3> periphery_e{0.1F, 0.05F, 0.02F};
+    const std::array<float, 3> focus_e{0.3F, 0.2F, 0.1F};
+    xrfg::D3D12HudSymbology symbology{};
+    symbology.views[0] = {true, 0, 0, width, height, 0, 0, width, height, 0};
+    symbology.views[2] = {true, width, 0, focus_size, focus_size, 0, 0, focus_size, focus_size, 0};
+    symbology.eyes[0].layout = true;
+    symbology.eyes[0].focus_rect = {0.25F, 0.2F, 0.75F, 0.8F};
+    symbology.focus_smoothing = 0.2F;
+    symbology.focus_shape = 2.0F;
+    const auto scene_of = [&](UINT image_width, UINT image_height, const xrfg::HudEyeInput& eye) {
+        HudScene scene;
+        scene.width = image_width;
+        scene.height = image_height;
+        scene.atlas_width = width + focus_size;
+        scene.atlas_height = std::max(height, focus_size);
+        scene.frame.assign(static_cast<std::size_t>(image_width) * image_height * 4U, 255);
+        for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(image_width) * image_height; ++pixel) {
+            scene.frame[pixel * 4U] = scene.frame[pixel * 4U + 1U] = scene.frame[pixel * 4U + 2U] =
+                hud_encode(frame_linear);
+        }
+        scene.emission.assign(static_cast<std::size_t>(scene.atlas_width) * scene.atlas_height * 8U, 0);
+        scene.classes.assign(static_cast<std::size_t>(scene.atlas_width) * scene.atlas_height, 0);
+        for (UINT y = 0; y < scene.atlas_height; ++y) {
+            for (UINT x = 0; x < scene.atlas_width; ++x) {
+                const bool in_periphery = x < width && y < height;
+                const bool in_focus = x >= width && y < focus_size;
+                if (!in_periphery && !in_focus) {
+                    continue;
+                }
+                const std::size_t at = static_cast<std::size_t>(y) * scene.atlas_width + x;
+                const auto& e = in_periphery ? periphery_e : focus_e;
+                for (int ch = 0; ch < 3; ++ch) {
+                    const std::uint16_t half = hud_half(e[ch]);
+                    std::memcpy(&scene.emission[at * 8U + ch * 2U], &half, 2);
+                }
+                scene.classes[at] = in_periphery ? 1U : 2U;
+            }
+        }
+        scene.eye = eye;
+        return scene;
+    };
+    // How many pixels are more than a code from `frame - delta`.
+    const auto off_by = [&](const HudScene& scene, const std::array<float, 3>& delta) {
+        HudTextures t = hud_textures(gpu, scene);
+        hud_record_removal(gpu, passes, scene, t);
+        const auto clean = hud_readback(gpu, t.clean.Get(), scene.width * 4U);
+        std::size_t wrong = 0;
+        for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(scene.width) * scene.height; ++pixel) {
+            bool differs = false;
+            for (int ch = 0; ch < 3; ++ch) {
+                const std::uint8_t expected = hud_encode(hud_decode(hud_encode(frame_linear)) - delta[ch]);
+                differs = differs || std::abs(int(clean[pixel * 4U + ch]) - int(expected)) > 1;
+            }
+            wrong += differs ? 1U : 0U;
+        }
+        return wrong;
+    };
+    const std::size_t periphery_wrong =
+        off_by(scene_of(width, height, xrfg::hud_layer_eye_input(symbology, 0, false)), periphery_e);
+    const std::size_t focus_wrong =
+        off_by(scene_of(focus_size, focus_size, xrfg::hud_layer_eye_input(symbology, 0, true)), focus_e);
+    const std::size_t composed_wrong = off_by(scene_of(width, height, xrfg::hud_eye_input(symbology, 0)), periphery_e);
+    std::cout << "hud symbology: two layers, removal: periphery layer " << periphery_wrong
+              << " pixel(s) off its own delta, focus layer " << focus_wrong
+              << "; the composed model on the periphery image " << composed_wrong << "\n";
+    require(periphery_wrong == 0, "hud layers: the periphery layer does not lose its periphery view's delta everywhere");
+    require(focus_wrong == 0, "hud layers: the focus layer does not lose its focus view's delta everywhere");
+    require(composed_wrong > 0, "hud layers: the composed model agrees with the layer's, so this proves nothing");
+}
+
+// The re-add from a frame whose field of view lay elsewhere (the focus box
+// moved 0.1 of a tangent, 25.6 px, to the right; no head rotation): the
+// collimated dot (class 1) is carried by the rotation's tangents as before,
+// and with helmet_by_tangents the helmet dot (class 2) moves with it: the
+// same tangent. Without it the helmet dot stays at its pixel (as before).
+void test_hud_helmet_by_tangents(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 512, height = 256;
+    HudScene scene;
+    scene.width = width;
+    scene.height = height;
+    scene.atlas_width = width;
+    scene.atlas_height = height;
+    scene.frame.assign(static_cast<std::size_t>(width) * height * 4U, 0);
+    for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(width) * height; ++pixel) {
+        scene.frame[pixel * 4U + 3U] = 255;
+    }
+    scene.emission.assign(static_cast<std::size_t>(width) * height * 8U, 0);
+    scene.classes.assign(static_cast<std::size_t>(width) * height, 0);
+    const auto dot = [&](UINT cx, UINT cy, std::uint8_t klass) {
+        for (UINT y = cy - 2; y <= cy + 2; ++y) {
+            for (UINT x = cx - 2; x <= cx + 2; ++x) {
+                const std::size_t at = static_cast<std::size_t>(y) * width + x;
+                const std::uint16_t half = hud_half(0.5F);
+                std::memcpy(&scene.emission[at * 8U + 2U], &half, 2);
+                scene.classes[at] = klass;
+            }
+        }
+    };
+    dot(256, 128, 1);
+    dot(160, 128, 2);
+    scene.eye.periphery = {true, 0, 0, width, height, 0, 0, width, height, 0};
+    scene.eye.focus_rect = xrfg::kHudLayerNoFocusRect;
+    HudTextures t = hud_textures(gpu, scene);
+    const auto centroids = [&](bool helmet_by_tangents, double& collimated, double& helmet) {
+        xrfg::HudRotation rotation{};
+        rotation.enabled = true;
+        rotation.target_to_source = {0.0F, 0.0F, 0.0F, 1.0F};
+        rotation.source_tangents = {-1.0F, 1.0F, 0.5F, -0.5F};
+        rotation.target_tangents = {-0.9F, 1.1F, 0.5F, -0.5F};
+        rotation.helmet_by_tangents = helmet_by_tangents;
+        hud_upload(gpu, t.destination.Get(), scene.frame, width * 4U);
+        hud_record_readd(gpu, passes, scene, t, rotation, false);
+        const auto out = hud_readback(gpu, t.destination.Get(), width * 4U);
+        const auto centroid = [&](UINT from, UINT to) {
+            double sum = 0.0, weighted = 0.0;
+            for (UINT y = 110; y < 146; ++y) {
+                for (UINT x = from; x < to; ++x) {
+                    const double value = hud_decode(out[(static_cast<std::size_t>(y) * width + x) * 4U + 1U]);
+                    sum += value;
+                    weighted += value * (static_cast<double>(x) + 0.5);
+                }
+            }
+            return sum > 0.0 ? weighted / sum : -1.0;
+        };
+        helmet = centroid(100, 200);
+        collimated = centroid(200, 300);
+    };
+    double collimated_with = 0.0, helmet_with = 0.0, collimated_without = 0.0, helmet_without = 0.0;
+    centroids(true, collimated_with, helmet_with);
+    centroids(false, collimated_without, helmet_without);
+    std::cout << "hud symbology: a field of view moved 25.6 px: collimated dot at " << collimated_with
+              << " (230.9), helmet dot by its tangent at " << helmet_with << " (134.9), without at "
+              << helmet_without << " (160.5)\n";
+    require(std::abs(collimated_with - 230.9) < 0.3 && std::abs(collimated_without - 230.9) < 0.3,
+        "hud layers: the collimated dot is not at its tangent in the moved field of view");
+    require(std::abs(helmet_with - 134.9) < 0.3, "hud layers: the helmet dot is not at its tangent");
+    require(std::abs(helmet_without - 160.5) < 0.05, "hud layers: without the flag the helmet dot moved");
+}
+
+// The synthesis of one layer's swapchain (hud_synthesize with [ofxr]
+// foveated_layers, the layer's role and the session's link, as the layer sets
+// them before each submission).
+HudSynthesisResult hud_synthesize_layer(Gpu& gpu, const std::vector<std::uint8_t>& a,
+    const std::vector<std::uint8_t>& b, const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>& frames,
+    bool focus_layer, const std::shared_ptr<xrfg::D3D12FoveatedLink>& link) {
+    const DXGI_FORMAT format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    const auto image = [&] {
+        return hud_texture(gpu, kHudSynthWidth, kHudSynthHeight, format, 2, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,
+            D3D12_HEAP_FLAG_NONE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    };
+    std::array<ComPtr<ID3D12Resource>, 2> sources{image(), image()};
+    auto current = image();
+    auto synthetic = image();
+    hud_upload(gpu, sources[0].Get(), a, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    hud_upload(gpu, sources[1].Get(), b, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 1> current_out{current.Get()};
+    std::array<ID3D12Resource*, 1> synthetic_out{synthetic.Get()};
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(gpu.device.Get(), gpu.queue.Get(), input, D3D12_RESOURCE_STATE_RENDER_TARGET),
+        "hud layer synthesis: history");
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.cockpit_mask = true;
+    options.hud_symbology = true;
+    options.foveated_layers = true;
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(gpu.device.Get(), gpu.queue.Get(), history, current_out, synthetic_out, format,
+                        D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::fidelity_fx, options),
+        "hud layer synthesis: initialize");
+    const auto views = hud_synthesis_views();
+    xrfg::D3D12HistoryCaptureTicket ca{}, cb{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ca), "hud layer synthesis: capture A");
+    require_hresult(history->commit(ca), "hud layer synthesis: commit A");
+    synth.set_foveated_focus(focus_layer);
+    synth.set_foveated_link(link, true, 100);
+    synth.set_cockpit_mask(frames[0]);
+    require_hresult(synth.submit_prime(ca, views, 0, &output), "hud layer synthesis: prime");
+    hud_run(gpu, [](ID3D12GraphicsCommandList*) {}); // the prime done (wait_for_idle would retire it)
+    require_hresult(history->capture(1, &cb), "hud layer synthesis: capture B");
+    require_hresult(history->commit(cb), "hud layer synthesis: commit B");
+    synth.set_foveated_focus(focus_layer);
+    synth.set_foveated_link(link, true, 200);
+    synth.set_cockpit_mask(frames[1]);
+    require_hresult(synth.submit_pair(cb, views, views, 0, 0, &output), "hud layer synthesis: pair");
+    require_hresult(synth.wait_for_idle(), "hud layer synthesis: idle");
+    HudSynthesisResult result;
+    result.synthetic = hud_readback(gpu, synthetic.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    result.current = hud_readback(gpu, current.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    return result;
+}
+
+// A still world and a still HUD on one layer's swapchain, with an alpha that
+// varies from pixel to pixel:
+//  - the focus layer, linked, frames whose symbology is in the focus views
+//    (2, 3) alone and without a focus layout: both views cleaned and re-added
+//    (the composed model would find nothing: it needs the layout and reads the
+//    periphery views), the synthetic the frame within 2 codes, its alpha the
+//    frame's at every byte (the passes write no alpha), the real frame's copy
+//    untouched;
+//  - the same frames on the periphery layer, and periphery-view frames on the
+//    focus layer: nothing is that layer's, nothing is cleaned;
+//  - periphery-view frames on the periphery layer: cleaned and re-added;
+//  - the focus layer without a link: round 2d's bypass, nothing cleaned;
+//  - the other layer said it cannot take its symbology out: this one leaves
+//    its own in (a format fallback), so the layers stay alike.
+void test_hud_layer_synthesis(Gpu& gpu) {
+    HudSymbolModel model;
+    // test_hud_synthesis's green cross over a smooth world.
+    HudScene still;
+    still.width = kHudSynthWidth;
+    still.height = kHudSynthHeight;
+    still.atlas_width = kHudSynthWidth;
+    still.atlas_height = kHudSynthHeight;
+    still.frame.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 4U, 255);
+    still.emission.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 8U, 0);
+    still.classes.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight, 0);
+    for (UINT y = 0; y < kHudSynthHeight; ++y) {
+        for (UINT x = 0; x < kHudSynthWidth; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * kHudSynthWidth + x;
+            std::array<float, 3> f{};
+            for (int ch = 0; ch < 3; ++ch) {
+                const double value = 0.5 + 0.35 * std::sin(x * 0.21 + ch) * std::cos(y * 0.17 + 0.5 * ch);
+                f[ch] = hud_decode(static_cast<std::uint8_t>(std::clamp(value * 255.0, 0.0, 255.0)));
+            }
+            const bool symbol = ((x >= 60 && x < 64) && y >= 30 && y < 66) || ((y >= 46 && y < 50) && x >= 44 && x < 84);
+            if (symbol) {
+                std::array<float, 4> e{};
+                const std::array<float, 3> green{0.1F, 0.9F, 0.15F};
+                for (int ch = 0; ch < 3; ++ch) {
+                    const float mixed = 0.15F * f[ch] + 0.85F * green[ch];
+                    e[ch] = mixed - f[ch];
+                    f[ch] = mixed;
+                }
+                e[3] = 0.85F;
+                for (int ch = 0; ch < 4; ++ch) {
+                    const std::uint16_t half = hud_half(e[ch]);
+                    std::memcpy(&still.emission[at * 8U + ch * 2U], &half, 2);
+                }
+                still.classes[at] = 1;
+            }
+            for (int ch = 0; ch < 3; ++ch) {
+                still.frame[at * 4U + ch] = hud_encode(f[ch]);
+            }
+            // The focus layer's alpha: any function of the pixel.
+            still.frame[at * 4U + 3U] = static_cast<std::uint8_t>(64U + (x * 7U + y * 13U) % 192U);
+        }
+    }
+    static_cast<void>(model);
+    std::vector<std::uint8_t> frame_a(still.frame);
+    frame_a.insert(frame_a.end(), still.frame.begin(), still.frame.end());
+    // A frame's symbology in the periphery views (as hud_synthesis_frame
+    // makes it) or moved to the focus views, the layout gone.
+    const auto frames_of = [&](bool focus_views) {
+        std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> frames{
+            hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, still, true, 2)};
+        if (focus_views) {
+            for (auto& frame : frames) {
+                for (UINT eye = 0; eye < 2; ++eye) {
+                    frame->hud_symbology.views[2U + eye] = frame->hud_symbology.views[eye];
+                    frame->hud_symbology.views[eye] = {};
+                    frame->hud_symbology.eyes[eye].layout = false;
+                }
+            }
+        }
+        return frames;
+    };
+    const auto alpha_differences = [&](const std::vector<std::uint8_t>& image) {
+        std::size_t differences = 0;
+        for (std::size_t at = 3; at < image.size() && at < frame_a.size(); at += 4U) {
+            differences += image[at] != frame_a[at] ? 1U : 0U;
+        }
+        return differences;
+    };
+    const auto link = std::make_shared<xrfg::D3D12FoveatedLink>();
+    // The focus layer, its own views.
+    const auto focus_frames = frames_of(true);
+    const auto focus = hud_synthesize_layer(gpu, frame_a, frame_a, focus_frames, true, link);
+    const auto& focus_counters = *focus_frames[1]->counters;
+    const int focus_worst = hud_max_difference(focus.synthetic, frame_a);
+    const std::size_t focus_alpha = alpha_differences(focus.synthetic);
+    std::cout << "hud layer synthesis: focus layer: views cleaned " << focus_counters.hud_views.load()
+              << ", re-added from the current frame " << focus_counters.hud_from_current.load() << ", fallback views "
+              << focus_counters.hud_fallback_views.load() << ", synthetic worst " << focus_worst
+              << " code(s) from the frame, alpha bytes not the frame's " << focus_alpha << "\n";
+    require(focus.current == frame_a, "hud layers: the focus layer's real frame changed");
+    require(focus_counters.hud_views.load() == 2 && focus_counters.hud_from_current.load() == 2 &&
+            focus_counters.hud_fallback_views.load() == 0,
+        "hud layers: the focus layer's two views were not cleaned and re-added from its focus views");
+    require(focus_worst <= 2, "hud layers: the focus layer's removal, composition and re-add do not give the frame back");
+    require(focus_alpha == 0, "hud layers: the focus layer's synthetic alpha is not the current frame's");
+    // Each layer only its own view.
+    const auto focus_on_periphery = frames_of(true);
+    const auto wrong_layer = hud_synthesize_layer(gpu, frame_a, frame_a, focus_on_periphery, false, link);
+    const auto periphery_on_focus = frames_of(false);
+    const auto wrong_views = hud_synthesize_layer(gpu, frame_a, frame_a, periphery_on_focus, true, link);
+    require(focus_on_periphery[1]->counters->hud_views.load() == 0 &&
+            periphery_on_focus[1]->counters->hud_views.load() == 0,
+        "hud layers: a layer took the other layer's views");
+    require(wrong_layer.current == frame_a && wrong_views.current == frame_a, "hud layers: a real frame changed");
+    // The periphery layer, its own views.
+    const auto periphery_frames = frames_of(false);
+    const auto periphery = hud_synthesize_layer(gpu, frame_a, frame_a, periphery_frames, false, link);
+    require(periphery_frames[1]->counters->hud_views.load() == 2 &&
+            periphery_frames[1]->counters->hud_from_current.load() == 2 &&
+            hud_max_difference(periphery.synthetic, frame_a) <= 2,
+        "hud layers: the periphery layer's two views were not cleaned and re-added from its periphery views");
+    // No link: the focus swapchain is bypassed as before round 4.
+    const auto unlinked_frames = frames_of(true);
+    const auto unlinked = hud_synthesize_layer(gpu, frame_a, frame_a, unlinked_frames, true, nullptr);
+    require(unlinked_frames[1]->counters->hud_views.load() == 0 && unlinked.synthetic == wrong_views.synthetic,
+        "hud layers: without a link the focus swapchain is not left alone");
+    // The periphery layer cannot: the focus layer does not either.
+    const auto refused_link = std::make_shared<xrfg::D3D12FoveatedLink>();
+    refused_link->refuse_hud(false);
+    require(refused_link->hud_refused(false) && !refused_link->hud_refused(true), "hud layers: the refusal's layer");
+    const auto refused_frames = frames_of(true);
+    const auto refused = hud_synthesize_layer(gpu, frame_a, frame_a, refused_frames, true, refused_link);
+    require(refused_frames[1]->counters->hud_views.load() == 0 &&
+            refused_frames[1]->counters->hud_fallback_views.load() != 0 && refused.synthetic == wrong_views.synthetic,
+        "hud layers: the focus layer cleaned its symbology although the periphery layer cannot");
+    std::cout << "hud layer synthesis: each layer its own view; no link and a refusal leave the symbology in\n";
+}
+
+void test_hud_two_layers(Gpu& gpu) {
+    test_hud_layer_inputs();
+    test_hud_layer_removal(gpu);
+    test_hud_helmet_by_tangents(gpu);
+    test_hud_layer_synthesis(gpu);
+}
