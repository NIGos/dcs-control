+// (c) A still cockpit in the uncovered strip. Where the pair's cockpit mask
+// says cockpit, the key leaves B's alpha alone (frame_synthesis.hlsl,
+// foveated_cockpit_keep): B alone is the frame between there, at the focus
+// layer's resolution. The saccade of test (iii), with a "cockpit" below a
+// line fixed in the eye (B's rows 128 and down; in A's image 53 rows lower),
+// given as a mask per frame in that frame's own field of view, as the layer
+// gives a focus swapchain its mask. Three runs: mask without the key, mask
+// with the key, the key without a mask.
+//  - mask + key against mask alone: no colour byte differs, no alpha rises,
+//    and from kDeep rows inside the cockpit on every alpha is B's;
+//  - the same pixels of the strip without a mask are all 0 (or the test
+//    proves nothing), and there are at least 500 of them;
+//  - more than kFar rows away from the cockpit the alpha is what the key
+//    gives without a mask, every byte.
+// kDeep 16 = four mask cells of 4 px (the bilinear keep reaches one cell):
+// by construction. kFar 48 = the mask's dilation plus the head's 12 rows of
+// pitch in the rotated variant: a GUESS; so is "two runs' flow is the same".
+void test_focus_uncovered_cockpit(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    constexpr std::uint32_t kRamp = 8;
+    constexpr UINT kLine = kFocusHeight / 2, kDeep = 16, kFar = 48;
+    const FocusCase& c = kFocusCases[1];
+    require(std::string_view(c.name) == "saccade", "uncovered alpha cockpit: the saccade case moved");
+    // Cockpit: at or below this height in the eye, in tangent spans from its
+    // centre (the box's middle row in frame B).
+    const float line = c.b.y;
+    const auto cockpit_map = [line](FocusGaze gaze) {
+        std::vector<std::uint8_t> map(static_cast<std::size_t>(kFocusWidth) * kFocusHeight, 0);
+        for (UINT y = 0; y < kFocusHeight; ++y) {
+            const float height_in_eye =
+                gaze.y + (0.5F - (static_cast<float>(y) + 0.5F) / kFocusHeight) * kFocusSection;
+            if (height_in_eye <= line) {
+                std::fill_n(map.begin() + static_cast<std::ptrdiff_t>(y) * kFocusWidth, kFocusWidth,
+                    std::uint8_t{1});
+            }
+        }
+        return map;
+    };
+    for (const bool rotated : {false, true}) for (const bool triple : {false, true}) {
+        const auto views_a = focus_views(c.a, false);
+        const auto views_b = focus_views(c.b, rotated);
+        const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> masks{
+            make_cockpit_mask_frame(fixture, kFocusWidth, kFocusHeight, cockpit_map(c.a), 4, views_a),
+            make_cockpit_mask_frame(fixture, kFocusWidth, kFocusHeight, cockpit_map(c.b), 4, views_b)};
+        xrfg::D3D12NvidiaOpticalFlowOptions masked = base;
+        masked.foveated_layers = true;
+        masked.cockpit_mask = true;
+        xrfg::D3D12NvidiaOpticalFlowOptions masked_key = masked;
+        masked_key.foveated_uncovered_alpha = kRamp;
+        xrfg::D3D12NvidiaOpticalFlowOptions bare_key = base;
+        bare_key.foveated_layers = true;
+        bare_key.foveated_uncovered_alpha = kRamp;
+        const FocusPairResult plain =
+            run_focus_pair(fixture, backend, masked, c.a, c.b, rotated, true, triple, nullptr, &masks);
+        const FocusPairResult kept =
+            run_focus_pair(fixture, backend, masked_key, c.a, c.b, rotated, true, triple, nullptr, &masks);
+        const FocusPairResult bare = run_focus_pair(fixture, backend, bare_key, c.a, c.b, rotated, true, triple);
+        require(kept.real == kept.current, "uncovered alpha cockpit: the real frame is not B bit for bit");
+        require(plain.synthetics.size() == kept.synthetics.size() && bare.synthetics.size() == kept.synthetics.size(),
+            "uncovered alpha cockpit: outputs missing");
+        for (std::size_t s = 0; s < kept.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            std::size_t colour_differences = 0, raised = 0, lost_cockpit = 0, strip_cockpit = 0, zeroed_without = 0,
+                world_changed = 0;
+            for (UINT y = 0; y < kFocusHeight; ++y) {
+                for (UINT x = 0; x < kFocusWidth; ++x) {
+                    const std::size_t at = (static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel;
+                    for (UINT channel = 0; channel < 3; ++channel)
+                        colour_differences +=
+                            kept.synthetics[s][eye][at + channel] != plain.synthetics[s][eye][at + channel] ? 1U : 0U;
+                    const int before = plain.synthetics[s][eye][at + 3];
+                    const int after = kept.synthetics[s][eye][at + 3];
+                    const int without = bare.synthetics[s][eye][at + 3];
+                    raised += after > before ? 1U : 0U;
+                    if (y >= kLine + kDeep) {
+                        lost_cockpit += after != before ? 1U : 0U;
+                        const float inside =
+                            inside_previous_image(views_a[eye], views_b[eye], x, y, kFocusWidth, kFocusHeight);
+                        if (inside < -1.5F && before > 0) {
+                            ++strip_cockpit;
+                            zeroed_without += without == 0 ? 1U : 0U;
+                        }
+                    }
+                    if (y + kFar < kLine) world_changed += after != without ? 1U : 0U;
+                }
+            }
+            const std::string what = std::string("focus uncovered alpha cockpit rotated=") + (rotated ? "1" : "0") +
+                (triple ? " 3X" : " 2X") + " synthetic=" + std::to_string(s) + " eye=" + std::to_string(eye);
+            std::cout << what << ": cockpit pixels of the strip " << strip_cockpit << " (0 without a mask: "
+                      << zeroed_without << "), cockpit alpha not B's=" << lost_cockpit << " raised=" << raised
+                      << " world alpha not the unmasked key's=" << world_changed << " colour bytes changed="
+                      << colour_differences << '\n';
+            require(colour_differences == 0, what + ": the key changed a colour under a mask");
+            require(raised == 0, what + ": an alpha rose above B's");
+            require(lost_cockpit == 0, what + ": a cockpit pixel lost alpha");
+            require(strip_cockpit >= 500 && zeroed_without == strip_cockpit,
+                what + ": without a mask the strip's cockpit pixels are not all 0, so this case proves nothing");
+            require(world_changed == 0, what + ": the mask changed the alpha away from the cockpit");
