+[[nodiscard]] inline std::array<float, 2> foveated_cursor_position(
+    const std::array<float, 2>& tangent,
+    const std::array<float, 4>& rect,
+    const std::array<float, 4>& tangents) noexcept {
+    const float u = (tangent[0] - tangents[0]) / (tangents[1] - tangents[0]);
+    const float v = (tangent[1] - tangents[2]) / (tangents[3] - tangents[2]);
+    return {rect[0] + u * rect[2], rect[1] + v * rect[3]};
