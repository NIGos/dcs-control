+            const FocusPairResult plain =
+                run_focus_pair(fixture, backend, layers, c.a, c.b, false, true, triple, &views_b);
+            const FocusPairResult ramped =
+                run_focus_pair(fixture, backend, exact, c.a, c.b, false, true, triple, &views_b);
+            require(ramped.real == ramped.current, "exact mask: the real frame is not B bit for bit");
+            require(plain.synthetics.size() == ramped.synthetics.size(), "exact mask: outputs missing");
+            for (std::size_t s = 0; s < ramped.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const UncoveredDelta delta = uncovered_delta(plain.synthetics[s], ramped.synthetics[s], eye,
+                    views_a, views_b, kRamp, 1.0F);
