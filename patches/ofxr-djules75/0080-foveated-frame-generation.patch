+// (e) Round 4's cursor redraw in the strip. The two-layer rig of test (iv),
+// the box moved 10 periphery pixels (30 focus pixels) to the right, the
+// cursor near the box's right edge: in B's focus image its place in frame B
+// straddles A's edge (x 198..230, the edge at 210) and its place half way is
+// in the ramp (32 px). The key on the focus layer against the key off:
+//  - the periphery layer's synthetic is the same, every byte (the key is the
+//    focus layer's alone), and the focus gate decides the same;
+//  - no colour byte of the focus synthetic differs;
+//  - its alpha is nowhere more than 2 codes above B's times the pixel's
+//    cover, and around the cursor (the redraw's rectangle) it IS that, within
+//    2 codes: the redraw follows the ramp, it does not punch through it;
+//  - blended as the runtime blends (alpha x focus + (1 - alpha) x periphery,
+//    nearest periphery pixel), the region shows B's world and the cursor
+//    once, half way: at most 2 % of its pixels more than 40 codes off the
+//    same blend of the two expected images.
+// Needs the focus gate to accept a cursor 10 px from the image's edge: if it
+// does not, the test fails saying so (round 4's detection, not the key).
+// The 2 % is the sum of test (iv)'s two 1 % limits: a GUESS as they are.
+void test_two_layer_cursor_uncovered(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    constexpr std::uint32_t kRamp = 32;
+    constexpr int kInset = 60;
+    const LayerBox box_a{80, 60}, box_b{90, 60};
+    xrfg::D3D12NvidiaOpticalFlowOptions keyed = base;
+    keyed.foveated_uncovered_alpha = kRamp;
+    const LayerCursorRun off = run_layer_cursor(fixture, backend, base, box_a, box_b, true, true, true, kInset);
+    const LayerCursorRun on = run_layer_cursor(fixture, backend, keyed, box_a, box_b, true, true, true, kInset);
+    require(on.focus_real == on.focus_b && on.periphery_real == on.periphery_b,
+        "cursor in the strip: a real frame is not B bit for bit");
+    const ReprojectionViews views_a = layer_focus_views(box_a);
+    const ReprojectionViews views_b = layer_focus_views(box_b);
+    std::size_t colour_differences = 0, above = 0, region_pixels = 0, region_low = 0, region_off = 0,
+        composite_wrong = 0;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (UINT y = 0; y < kLayerHeight; ++y) {
+            for (UINT x = 0; x < kLayerWidth; ++x) {
+                const std::size_t at = (static_cast<std::size_t>(y) * kLayerWidth + x) * kBytesPerPixel;
+                for (UINT channel = 0; channel < 3; ++channel)
+                    colour_differences +=
+                        on.focus_synthetic[eye][at + channel] != off.focus_synthetic[eye][at + channel] ? 1U : 0U;
+                const float cover = uncovered_cover(
+                    inside_previous_image(views_a[eye], views_b[eye], x, y, kLayerWidth, kLayerHeight), kRamp);
+                const float expected = static_cast<float>(on.focus_b[eye][at + 3]) * cover;
+                const float alpha = static_cast<float>(on.focus_synthetic[eye][at + 3]);
+                above += alpha > expected + 2.0F ? 1U : 0U;
+                const int px = static_cast<int>(x), py = static_cast<int>(y);
+                if (px < on.focus_region[0] || px >= on.focus_region[2] || py < on.focus_region[1] ||
+                    py >= on.focus_region[3]) {
+                    continue;
+                }
+                ++region_pixels;
+                region_low += cover < 0.5F ? 1U : 0U;
+                region_off += std::abs(alpha - expected) > 2.0F ? 1U : 0U;
+                // The periphery pixel under this focus pixel.
+                const std::size_t under =
+                    (static_cast<std::size_t>(box_b.top + py / kLayerRatio) * kLayerWidth +
+                        static_cast<std::size_t>(box_b.left + px / kLayerRatio)) * kBytesPerPixel;
+                bool wrong = false;
+                for (UINT channel = 0; channel < 3; ++channel) {
+                    const float shown = (alpha * static_cast<float>(on.focus_synthetic[eye][at + channel]) +
+                        (255.0F - alpha) * static_cast<float>(on.periphery_synthetic[eye][under + channel])) / 255.0F;
+                    const float wanted = (alpha * static_cast<float>(on.focus_expected[eye][at + channel]) +
+                        (255.0F - alpha) * static_cast<float>(on.periphery_expected[eye][under + channel])) / 255.0F;
+                    wrong = wrong || std::abs(shown - wanted) > 40.0F;
+                }
+                composite_wrong += wrong ? 1U : 0U;
+            }
+        }
+    }
+    std::cout << "two-layer cursor in the strip: focus gate pairs " << on.focus_stats.pairs << " drawn "
+              << on.focus_stats.drawn << " (key off: " << off.focus_stats.pairs << " / " << off.focus_stats.drawn
+              << "), not found " << on.focus_stats.not_found << " low score " << on.focus_stats.low_score
+              << " jump " << on.focus_stats.jump << "; region " << region_pixels << " pixels, " << region_low
+              << " under half cover; alpha above the ramp " << above << ", off the ramp in the region " << region_off
+              << "; blended wrong " << composite_wrong << "; colour bytes changed " << colour_differences << '\n';
+    require(on.periphery_synthetic == off.periphery_synthetic,
+        "cursor in the strip: the key changed the periphery layer's synthetic");
+    require(on.focus_stats.pairs == off.focus_stats.pairs && on.focus_stats.drawn == off.focus_stats.drawn,
+        "cursor in the strip: the key changed the focus gate's decision");
+    require(colour_differences == 0, "cursor in the strip: the key changed a colour of the focus synthetic");
+    require(above == 0, "cursor in the strip: an alpha is above B's times its cover");
+    require(region_low >= 100, "cursor in the strip: the cursor is not in the strip, so this case proves nothing");
+    require(off.focus_stats.drawn == 1,
+        "cursor in the strip: the focus gate refused the pair (round 4's detection near the image's edge), "
+        "so the redraw in the strip was not exercised");
+    require(region_off == 0, "cursor in the strip: the redraw's alpha does not follow the ramp");
+    require(composite_wrong <= region_pixels / 50,
+        "cursor in the strip: blended, the cursor is not once, half way");
+}
