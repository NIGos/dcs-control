+// Foveated layers, round 4: what the two layers' synthesizers tell each other
+// (D3D12FoveatedLink). A cursor record is found only by its eye and by the
+// very two frames it was made of; a record without a state buffer, a fence or
+// a frame is no record; readers and the HUD refusal are per eye / per layer.
+void test_foveated_link(Gpu& gpu) {
+    ComPtr<ID3D12Fence> first;
+    ComPtr<ID3D12Fence> second;
+    require_hresult(gpu.device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(first.GetAddressOf())),
+        "link: fence");
+    require_hresult(gpu.device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(second.GetAddressOf())),
+        "link: fence");
