+            require(plain.synthetics.size() == ramped.synthetics.size(), "uncovered alpha rotation: outputs missing");
+            for (std::size_t s = 0; s < ramped.synthetics.size(); ++s) for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                const UncoveredDelta delta = uncovered_delta(plain.synthetics[s], ramped.synthetics[s], eye,
+                    views_a, views_b, kRamp, kReach);
+                const std::string what = std::string("focus uncovered alpha ") + (roll ? "roll " : "yaw+pitch ") +
