+} // namespace fovq
+
+// XRFG_TEST_FOVEATED_QUALITY=1 on NVIDIA hardware (see the head of this file).
+//   XRFG_FOVEATED_QUALITY_SCALE=<percent>   every image side times this (default 100; 10..100)
+//   XRFG_FOVEATED_QUALITY_MOTION=<percent>  every scene motion times this (default 100; 0..800). Not the gaze.
+//   XRFG_FOVEATED_QUALITY_CASES=<a,b,...>   only the cases named (default all)
+//   XRFG_FOVEATED_QUALITY_SEED=<n>          the world (default 1)
+//   XRFG_FOVEATED_QUALITY_OCCLUSION=0|1     nvidia_occlusion_aware (default 1, as DCS Control writes it)
+//   XRFG_FOVEATED_QUALITY_DUMP=<directory>  BMP crops around the left eye's focus box (must exist)
+//   XRFG_FOVEATED_QUALITY_WORKERS=<n>       CPU threads (default all cores but one)
+//   XRFG_FOVEATED_QUALITY_DRY=1             no GPU: every synthetic is frame B
+//   XRFG_FOVEATED_QUALITY_UNCOVERED=<n>     foveated_uncovered_alpha of the layers-p100-ua mode, in focus
+//                                           pixels at full size (default 16; 1..64); scaled with SCALE
+void bench_foveated_quality() {
+    using namespace fovq;
+    const auto started = std::chrono::steady_clock::now();
+    const double scale = static_cast<double>(env_number("XRFG_FOVEATED_QUALITY_SCALE", 100, 10, 100)) / 100.0;
+    const double motion = static_cast<double>(env_number("XRFG_FOVEATED_QUALITY_MOTION", 100, 0, 800)) / 100.0;
+    const auto seed = static_cast<std::uint32_t>(env_number("XRFG_FOVEATED_QUALITY_SEED", 1, 0, 1000000));
+    const auto occlusion = static_cast<std::uint32_t>(env_number("XRFG_FOVEATED_QUALITY_OCCLUSION", 1, 0, 1));
+    // No GPU at all: every "synthetic" is frame B (a check of this file's own arithmetic).
+    const bool dry = env_number("XRFG_FOVEATED_QUALITY_DRY", 0, 0, 1) != 0;
+    char dump_directory[512]{};
+    const DWORD dump_length =
+        GetEnvironmentVariableA("XRFG_FOVEATED_QUALITY_DUMP", dump_directory, sizeof(dump_directory));
+    require(dump_length < sizeof(dump_directory), "XRFG_FOVEATED_QUALITY_DUMP is too long");
+    char filter[256]{};
+    const DWORD filter_length = GetEnvironmentVariableA("XRFG_FOVEATED_QUALITY_CASES", filter, sizeof(filter));
+    require(filter_length < sizeof(filter), "XRFG_FOVEATED_QUALITY_CASES is too long");
+    const std::string selected = "," + std::string(filter, filter_length) + ",";
+    const auto side = [scale](UINT full) {
+        // A multiple of 4, as every size in use.
+        return std::max(64U, static_cast<UINT>(std::lround(full * scale / 4.0)) * 4U);
+    };
+    const Sizes size{side(5424), side(5356), side(1040), side(1028), side(2028), side(2004)};
+
+    // Motions per frame pair, in tangent. 0.012 is 25 pixels of the composed
+    // image, 28 of the focus image, 5 of the periphery image.
+    const double wx = 0.012 * motion, wy = 0.005 * motion;
+    const double ox = 0.020 * motion, oy = -0.006 * motion;
+    const Gaze rest{0.10, 0.05};
+    // Round 5 (foveated_uncovered_alpha). Tracker jitter: the box moves 0.3
+    // degrees right and 0.15 down between two frames (12 and 6 focus pixels
+    // at full size) and back, the eye still. Head rotation with a saccade. A
+    // saccade down the instrument panel of a still cockpit.
+    const Gaze jittered{rest.x + 0.00409, rest.y - 0.00207};
+    const std::array<Case, 13> cases{
+        // Nothing moves: what the two paths lose on a still image.
+        Case{"static", Scene{}, rest, rest},
+        // (1) the whole world translates.
+        Case{"translate", Scene{wx, wy, false, 0.0, 0.0, false, 0.0}, rest, rest},
+        // (2) objects at several depths move over a still background.
+        Case{"objects", Scene{0.0, 0.0, true, ox, oy, false, 0.0}, rest, rest},
+        // (3) a still cockpit over the moving world; the gaze on the HUD
+        // frame, then down on the instrument panel's edge.
+        Case{"cockpit", Scene{wx, wy, false, 0.0, 0.0, true, 0.0}, rest, rest},
+        Case{"cockpit-panel", Scene{wx, wy, false, 0.0, 0.0, true, 0.0}, Gaze{0.10, -0.35}, Gaze{0.10, -0.35}},
+        // The head turns 1.5 degrees over a still world: the camera mapping alone.
+        Case{"yaw", Scene{0.0, 0.0, false, 0.0, 0.0, false, 1.5 * kPi / 180.0}, rest, rest},
+        // The world translates and the focus FOV moves 2 degrees (pursuit),
+        // then 12 degrees (a saccade).
+        Case{"pursuit", Scene{wx, wy, false, 0.0, 0.0, false, 0.0}, rest, Gaze{0.127, 0.060}},
+        Case{"saccade", Scene{wx, wy, false, 0.0, 0.0, false, 0.0}, Gaze{0.00, 0.05}, Gaze{0.16, -0.01}},
+        Case{"jitter", Scene{wx, wy, false, 0.0, 0.0, false, 0.0}, rest, jittered},
+        Case{"jitter-back", Scene{wx, wy, false, 0.0, 0.0, false, 0.0}, jittered, rest},
+        Case{"yaw-saccade", Scene{wx, wy, false, 0.0, 0.0, false, 1.5 * kPi / 180.0}, Gaze{0.00, 0.05},
+            Gaze{0.16, -0.01}},
+        Case{"cockpit-saccade", Scene{wx, wy, false, 0.0, 0.0, true, 0.0}, Gaze{0.00, -0.30}, Gaze{0.16, -0.36}},
+        // Round 6: a saccade over objects at several depths moving over a
+        // still background: motion that is NOT the same in the uncovered
+        // strip as where the previous focus image covers (the fill's vector
+        // is taken from there).
+        Case{"objects-saccade", Scene{0.0, 0.0, true, ox, oy, false, 0.0}, Gaze{0.00, 0.05}, Gaze{0.16, -0.01}}};
+
+    xrfg::D3D12NvidiaOpticalFlowOptions composed_options{};
+    composed_options.input_scale = xrfg::D3D12NvidiaInputScale::half;
+    composed_options.occlusion_aware = occlusion;
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half = composed_options;
+    layer_half.foveated_layers = true;
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_full = layer_half;
+    layer_full.input_scale = xrfg::D3D12NvidiaInputScale::full;
+    // The focus layer once more with [ofxr] foveated_uncovered_alpha (mode
+    // layers-p100-ua). The key is read on a swapchain named focus alone.
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half_uncovered = layer_half;
+    layer_half_uncovered.foveated_uncovered_alpha = static_cast<std::uint32_t>(std::clamp(
+        std::lround(static_cast<double>(env_number("XRFG_FOVEATED_QUALITY_UNCOVERED", 16, 1, 64)) * scale), 1L, 64L));
+
+    std::cout << "fovq sizes composed " << size.cw << "x" << size.ch << " periphery " << size.pw << "x" << size.ph
+              << " focus " << size.fw << "x" << size.fh << ", motion x" << motion << ", seed " << seed
+              << ", preset medium, occlusion_aware " << occlusion << ", uncovered_alpha "
+              << layer_half_uncovered.foveated_uncovered_alpha << ", " << worker_count() << " CPU workers" << (dry ? ", DRY (no GPU)" : "")
+              << std::endl;
+
+    std::optional<D3D12WarpFixture> fixture;
+    if (!dry) fixture.emplace(true);
+    const auto synthesize = [&](UINT width, UINT height, const xrfg::D3D12NvidiaOpticalFlowOptions& options,
+                                bool focus_layer, const ReprojectionViews& views_a, const ReprojectionViews& views_b,
+                                const StereoPattern& a, const StereoPattern& b, bool triple, const std::string& what) {
+        if (!dry) {
+            return run_pair(*fixture, width, height, options, focus_layer, views_a, views_b, a, b, triple, what);
+        }
+        PairResult held;
+        held.real_is_b = true;
+        held.synthetics.assign(triple ? 2U : 1U, b);
+        return held;
+    };
+    // Round 5: the focus layer with a cockpit mask (the scenes with a
+    // cockpit), key off and key on.
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half_mask = layer_half;
+    layer_half_mask.cockpit_mask = true;
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half_mask_uncovered = layer_half_uncovered;
+    layer_half_mask_uncovered.cockpit_mask = true;
+    // Round 6: the fill (no ramp), and the ramp with the exact mask.
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half_fill = layer_half;
+    layer_half_fill.foveated_uncovered_fill = 1U;
+    xrfg::D3D12NvidiaOpticalFlowOptions layer_half_exact = layer_half_uncovered;
+    layer_half_exact.foveated_uncovered_exact = true;
+    const World world(seed);
+    for (const Case& c : cases) {
+        if (filter_length != 0 && selected.find("," + std::string(c.name) + ",") == std::string::npos) continue;
+        const auto case_started = std::chrono::steady_clock::now();
+        EyeFovs focus_a{}, focus_b{};
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            focus_a[eye] = focus_box(kEyeFov[eye], c.a.x, c.a.y);
+            focus_b[eye] = focus_box(kEyeFov[eye], c.b.x, c.b.y);
+        }
+        // The layers of frame A (time 0, A's gaze, no yaw) and B (time 1).
+        StereoPattern a_p, a_f, b_p, b_f;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            render(world, c.scene, 0.0, kEyeFov[eye], 0.0, size.pw, size.ph, false, &a_p[eye]);
+            render(world, c.scene, 0.0, focus_a[eye], 0.0, size.fw, size.fh, true, &a_f[eye]);
+            render(world, c.scene, 1.0, kEyeFov[eye], c.scene.yaw, size.pw, size.ph, false, &b_p[eye]);
+            render(world, c.scene, 1.0, focus_b[eye], c.scene.yaw, size.fw, size.fh, true, &b_f[eye]);
+        }
+        const ReprojectionViews eye_a = views_for(kEyeFov, 0.0), eye_b = views_for(kEyeFov, c.scene.yaw);
+        const ReprojectionViews box_a = views_for(focus_a, 0.0), box_b = views_for(focus_b, c.scene.yaw);
+        for (const bool triple : {false, true}) {
+            const std::string what = std::string("foveated quality ") + c.name + (triple ? " 3X" : " 2X");
+            const PairResult p50 =
+                synthesize(size.pw, size.ph, layer_half, false, eye_a, eye_b, a_p, b_p, triple, what + " P50");
+            const PairResult p100 =
+                synthesize(size.pw, size.ph, layer_full, false, eye_a, eye_b, a_p, b_p, triple, what + " P100");
+            const PairResult f50 =
+                synthesize(size.fw, size.fh, layer_half, true, box_a, box_b, a_f, b_f, triple, what + " F50");
+            const PairResult f50_ua = synthesize(size.fw, size.fh, layer_half_uncovered, true, box_a, box_b, a_f, b_f,
+                triple, what + " F50 uncovered alpha");
+            // Round 5: with the frames' cockpit masks, in each frame's own
+            // focus boxes. Without a GPU, or a cockpit, the two above.
+            const bool masked = !dry && c.scene.cockpit;
+            PairResult f50_mask, f50_mask_ua;
+            if (masked) {
+                const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> masks{
+                    cockpit_mask_frame(*fixture, world, focus_a, size.fw, size.fh),
+                    cockpit_mask_frame(*fixture, world, focus_b, size.fw, size.fh)};
+                f50_mask = run_pair(*fixture, size.fw, size.fh, layer_half_mask, true, box_a, box_b, a_f, b_f,
+                    triple, what + " F50 cockpit mask", &masks);
+                f50_mask_ua = run_pair(*fixture, size.fw, size.fh, layer_half_mask_uncovered, true, box_a, box_b,
+                    a_f, b_f, triple, what + " F50 cockpit mask, uncovered alpha", &masks);
+            }
+            const PairResult& f50_k = masked ? f50_mask : f50;
+            const PairResult& f50_uak = masked ? f50_mask_ua : f50_ua;
+            // Round 6: the fill and the exact mask, with the cockpit masks
+            // where the scene has a cockpit.
+            PairResult f50_fill, f50_ex;
+            if (masked) {
+                const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> masks{
+                    cockpit_mask_frame(*fixture, world, focus_a, size.fw, size.fh),
+                    cockpit_mask_frame(*fixture, world, focus_b, size.fw, size.fh)};
+                xrfg::D3D12NvidiaOpticalFlowOptions fill_mask = layer_half_fill, exact_mask = layer_half_exact;
+                fill_mask.cockpit_mask = true;
+                exact_mask.cockpit_mask = true;
+                f50_fill = run_pair(*fixture, size.fw, size.fh, fill_mask, true, box_a, box_b, a_f, b_f, triple,
+                    what + " F50 fill, cockpit mask", &masks);
+                f50_ex = run_pair(*fixture, size.fw, size.fh, exact_mask, true, box_a, box_b, a_f, b_f, triple,
+                    what + " F50 exact mask, cockpit mask", &masks);
+            } else {
+                f50_fill = synthesize(size.fw, size.fh, layer_half_fill, true, box_a, box_b, a_f, b_f, triple,
+                    what + " F50 fill");
+                f50_ex = synthesize(size.fw, size.fh, layer_half_exact, true, box_a, box_b, a_f, b_f, triple,
+                    what + " F50 exact mask");
+            }
+            // Round 7: the focus layer once more, on a rig: fill = 2 after
+            // the periphery layer's pair (its flow at 100 % and at 50 %),
+            // fill = 2 with the ramp, fill = 1 with the ramp; and, for the GPU
+            // times only, the key off and fill = 1 alone. With the cockpit
+            // masks where the scene has a cockpit.
+            std::array<PairResult, kExtraFocus> extra;
+            if (!dry) {
+                std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> rig_masks;
+                if (masked) {
+                    rig_masks = {cockpit_mask_frame(*fixture, world, focus_a, size.fw, size.fh),
+                        cockpit_mask_frame(*fixture, world, focus_b, size.fw, size.fh)};
+                }
+                xrfg::D3D12NvidiaOpticalFlowOptions off = layer_half, fill1 = layer_half_fill, fill2 = layer_half_fill;
+                fill2.foveated_uncovered_fill = 2U;
+                xrfg::D3D12NvidiaOpticalFlowOptions fill2_ramp = fill2, fill1_ramp = fill1;
+                for (xrfg::D3D12NvidiaOpticalFlowOptions* ramped : {&fill2_ramp, &fill1_ramp}) {
+                    ramped->foveated_uncovered_alpha = layer_half_uncovered.foveated_uncovered_alpha;
+                    ramped->foveated_uncovered_exact = true;
+                }
+                for (xrfg::D3D12NvidiaOpticalFlowOptions* each : {&off, &fill1, &fill2, &fill2_ramp, &fill1_ramp}) {
+                    each->cockpit_mask = masked;
+                }
+                struct RigRun {
+                    const char* mode;
+                    const xrfg::D3D12NvidiaOpticalFlowOptions* periphery;
+                    const xrfg::D3D12NvidiaOpticalFlowOptions* focus;
+                    PairResult* into;
+                };
+                PairResult unused;
+                const std::array<RigRun, 6> runs{
+                    RigRun{"focus-key-off", nullptr, &off, &unused},
+                    RigRun{"focus-fill1", nullptr, &fill1, &unused},
+                    RigRun{"focus-fill2-p100", &layer_full, &fill2, &extra[0]},
+                    RigRun{"focus-fill2-p50", &layer_half, &fill2, &extra[1]},
+                    RigRun{"focus-fill2r-p100", &layer_full, &fill2_ramp, &extra[2]},
+                    RigRun{"focus-fill1r", nullptr, &fill1_ramp, &extra[3]}};
+                for (const RigRun& run : runs) {
+                    xrfg::D3D12NvidiaGpuTiming focus_time{}, periphery_time{};
+                    *run.into = run_focus_rig(*fixture, size.pw, size.ph, size.fw, size.fh, run.periphery, *run.focus, eye_a, eye_b, box_a, box_b,
+                        a_p, b_p, a_f, b_f, triple, what + " " + run.mode, masked ? &rig_masks : nullptr,
+                        &focus_time, run.periphery != nullptr ? &periphery_time : nullptr);
+                    char line[320];
+                    std::snprintf(line, sizeof(line),
+                        "fovq-gpu case=%s rate=%s mode=%s focus_pack_us=%llu focus_flow_us=%llu "
+                        "focus_composition_us=%llu focus_total_us=%llu periphery_total_us=%llu",
+                        c.name, triple ? "3X" : "2X", run.mode,
+                        static_cast<unsigned long long>(focus_time.pack_microseconds),
+                        static_cast<unsigned long long>(focus_time.eye0_microseconds + focus_time.eye1_microseconds),
+                        static_cast<unsigned long long>(focus_time.composition_microseconds),
+                        static_cast<unsigned long long>(focus_time.total_microseconds),
+                        static_cast<unsigned long long>(periphery_time.total_microseconds));
+                    std::cout << line << std::endl;
+                }
+            } else {
+                for (PairResult& each : extra) each = f50;
+            }
+            PairResult composed;
+            {
+                StereoPattern a_c, b_c;
