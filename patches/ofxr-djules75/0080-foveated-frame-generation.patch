+    constexpr XrCompositionLayerFlags kFocusFlags =
+        XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT |
+        XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT;
+    if (count != 2 || layers[0]->viewCount != 2 || layers[1]->viewCount != 2 ||
+        layers[0]->views == nullptr || layers[1]->views == nullptr ||
+        layers[0]->layerFlags != 0 || layers[1]->layerFlags != kFocusFlags) {
+        g_two_layer_shape_wrong.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
