+                        focus_a[eye]}, a_p[eye], a_f[eye], &a_c[eye]);
+                    compose_today(Composer{size.cw, size.ch, size.pw, size.ph, size.fw, size.fh, kEyeFov[eye],
+                        focus_b[eye]}, b_p[eye], b_f[eye], &b_c[eye]);
+                }
+                composed = synthesize(size.cw, size.ch, composed_options, false, eye_a, eye_b, a_c, b_c,
+                    triple, what + " composed");
+            }
+            if (!(p50.real_is_b && p100.real_is_b && f50.real_is_b && f50_ua.real_is_b && composed.real_is_b)) {
+                std::cout << "fovq WARNING case=" << c.name << (triple ? " 3X" : " 2X")
+                          << ": a real frame is not frame B bit for bit (P50 " << p50.real_is_b << " P100 "
+                          << p100.real_is_b << " F50 " << f50.real_is_b << " composed " << composed.real_is_b << ")"
+                          << std::endl;
+            }
+            const std::size_t count = composed.synthetics.size();
+            require(p50.synthetics.size() == count && p100.synthetics.size() == count &&
+                f50.synthetics.size() == count && f50_ua.synthetics.size() == count &&
+                f50_k.synthetics.size() == count && f50_uak.synthetics.size() == count &&
+                f50_fill.synthetics.size() == count && f50_ex.synthetics.size() == count &&
+                extra[0].synthetics.size() == count && extra[1].synthetics.size() == count &&
+                extra[2].synthetics.size() == count && extra[3].synthetics.size() == count,
+                what + ": synthetics missing");
+            for (std::size_t s = 0; s < count; ++s) {
+                const double time = triple ? static_cast<double>(s + 1U) / 3.0 : 0.5;
+                // The true frame at that time, in B's camera and B's focus FOV.
+                StereoPattern true_p, true_f;
+                for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                    render(world, c.scene, time, kEyeFov[eye], c.scene.yaw, size.pw, size.ph, false, &true_p[eye]);
+                    render(world, c.scene, time, focus_b[eye], c.scene.yaw, size.fw, size.fh, true, &true_f[eye]);
+                }
+                const Frames frames{&true_p, &true_f, &b_p, &b_f, &composed.synthetics[s], &p50.synthetics[s],
+                    &p100.synthetics[s], &f50.synthetics[s], &f50_ua.synthetics[s], &f50_k.synthetics[s],
+                    &f50_uak.synthetics[s], &focus_a, c.scene.yaw, c.scene.cockpit ? &world : nullptr,
+                    &f50_fill.synthetics[s], &f50_ex.synthetics[s],
+                    {&extra[0].synthetics[s], &extra[1].synthetics[s], &extra[2].synthetics[s],
+                        &extra[3].synthetics[s]}};
+                if (dump_length != 0) {
+                    dump_views(std::string(dump_directory, dump_length), std::string(c.name) +
+                        (triple ? "-3X-" : "-2X-") + std::to_string(s), size, focus_b[0], frames);
+                }
+                Evaluation result;
+                evaluate(size, focus_b, frames, &result);
+                for (std::size_t m = 0; m < kComposedModes; ++m) {
+                    for (std::size_t r = 0; r < 3; ++r) {
+                        print_stat(c, triple, time, kModeNames[m].mode, kModeNames[m].reference, kRegionNames[r],
+                            result.composed[m][r]);
+                    }
+                }
+                // Round 5: the uncovered strip, where the gaze moved; the
+                // masked modes where a mask was given.
+                if (c.a.x != c.b.x || c.a.y != c.b.y) {
+                    for (std::size_t m = 0; m < kStripModes; ++m) {
+                        if ((m == kStripMask || m == kStripMaskUa) && !masked) continue;
+                        for (std::size_t r = 0; r < (c.scene.cockpit ? 2U : 1U); ++r) {
+                            print_stat(c, triple, time, kStripModeNames[m], "today", kStripRegionNames[r],
+                                result.strip[m][r]);
+                        }
+                    }
+                    // Round 6: detail in the strip, as a part of the true frame's.
+                    if (result.detail[kStripModes] > 0.0) {
+                        for (const std::size_t m : {std::size_t{kStripComposed}, std::size_t{kStripLayers},
+                                 std::size_t{kStripUa}, std::size_t{kStripFill}, std::size_t{kStripEx},
+                                 std::size_t{kStripFill2}, std::size_t{kStripFill2P50},
+                                 std::size_t{kStripFill2Ramp}, std::size_t{kStripFillRamp}}) {
+                            char line[200];
+                            std::snprintf(line, sizeof(line),
+                                "fovq-detail case=%s rate=%s t=%.3f mode=%s region=uncovered detail=%.3f",
+                                c.name, triple ? "3X" : "2X", time, kStripModeNames[m],
+                                result.detail[m] / result.detail[kStripModes]);
+                            std::cout << line << std::endl;
+                        }
+                    }
+                }
+                constexpr std::array<const char*, 3> periphery_modes{
+                    "periphery-50", "periphery-100", "periphery-hold-b"};
+                for (std::size_t m = 0; m < periphery_modes.size(); ++m) {
+                    print_stat(c, triple, time, periphery_modes[m], "own", "all", result.periphery[m]);
+                }
+                constexpr std::array<const char*, 2> focus_modes{"focus-50", "focus-hold-b"};
+                for (std::size_t m = 0; m < focus_modes.size(); ++m) {
+                    print_stat(c, triple, time, focus_modes[m], "own", "interior", result.focus[m][0]);
+                    print_stat(c, triple, time, focus_modes[m], "own", "fade", result.focus[m][1]);
+                }
+            }
+        }
+        std::cout << "fovq case=" << c.name << " done in "
+                  << std::chrono::duration_cast<std::chrono::milliseconds>(
+                         std::chrono::steady_clock::now() - case_started).count()
+                  << " ms" << std::endl;
+    }
+    if (fixture) fixture->require_no_debug_errors();
+    std::cout << "fovq finished in "
+              << std::chrono::duration_cast<std::chrono::seconds>(std::chrono::steady_clock::now() - started).count()
+              << " s" << std::endl;
+}
