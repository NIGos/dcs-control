+    std::array<CursorReader, kEyes> reader_{};
+    std::array<FlowRecord, kEyes> flow_{};
+    std::array<CursorReader, kEyes> flow_reader_{};
+    std::array<std::atomic<std::uint64_t>, kEyes> cursor_declined_{};
+    std::array<std::atomic<bool>, 2> hud_refused_{};
