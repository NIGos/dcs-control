+    // synthetic a, 4 synthetic b; -1 not of that layer.
+    const auto kind = [](XrSwapchain handle, bool focus) {
+        const std::array<XrSwapchain, 5> periphery{g_application_swapchain, g_current_swapchain,
+            g_current_swapchain_b, g_synthetic_swapchain, g_synthetic_swapchain_b};
+        const std::array<XrSwapchain, 5> focus_handles{g_application_swapchain_right, g_current_swapchain_right,
+            g_current_swapchain_right_b, g_synthetic_swapchain_right, g_synthetic_swapchain_right_b};
+        const auto& set = focus ? focus_handles : periphery;
+        for (std::size_t index = 0; index < set.size(); ++index) {
+            if (set[index] == handle) return static_cast<int>(index);
+        }
+        return -1;
+    };
+    const int periphery_kind = kind(layers[0]->views[0].subImage.swapchain, false);
+    const int focus_kind = kind(layers[1]->views[0].subImage.swapchain, true);
