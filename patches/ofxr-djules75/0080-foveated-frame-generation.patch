+// Foveated layers: the ledger of queued Waits (D3D12QueueWaitLedger): a Wait
+// is covered by an earlier one of the same queue and fence at that value or
+// later, by nothing else; an entry keeps its queue and fence.
+void test_queue_wait_ledger(Gpu& gpu) {
+    ComPtr<ID3D12Fence> first;
+    ComPtr<ID3D12Fence> second;
+    require_hresult(gpu.device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(first.GetAddressOf())),
+        "ledger: fence");
+    require_hresult(gpu.device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(second.GetAddressOf())),
+        "ledger: fence");
+    D3D12_COMMAND_QUEUE_DESC description{};
+    description.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    ComPtr<ID3D12CommandQueue> other;
+    require_hresult(gpu.device->CreateCommandQueue(&description, IID_PPV_ARGS(other.GetAddressOf())),
+        "ledger: queue");
+    xrfg::D3D12QueueWaitLedger ledger;
+    require(!ledger.covered(gpu.queue.Get(), first.Get(), 1), "ledger: nothing noted, nothing covered");
+    require(!ledger.covered(nullptr, first.Get(), 1) && !ledger.covered(gpu.queue.Get(), nullptr, 1),
+        "ledger: no queue or no fence is never covered");
+    ledger.note(gpu.queue.Get(), first.Get(), 5);
+    require(ledger.covered(gpu.queue.Get(), first.Get(), 5) && ledger.covered(gpu.queue.Get(), first.Get(), 3),
+        "ledger: the value noted and every earlier one");
+    require(!ledger.covered(gpu.queue.Get(), first.Get(), 6), "ledger: not a later value");
+    require(!ledger.covered(gpu.queue.Get(), second.Get(), 1), "ledger: not another fence");
+    require(!ledger.covered(other.Get(), first.Get(), 1), "ledger: not another queue");
+    ledger.note(gpu.queue.Get(), first.Get(), 4);
+    require(ledger.covered(gpu.queue.Get(), first.Get(), 5), "ledger: an earlier value noted later takes nothing back");
+    ledger.note(other.Get(), first.Get(), 9);
+    require(ledger.covered(other.Get(), first.Get(), 9) && !ledger.covered(gpu.queue.Get(), first.Get(), 9),
+        "ledger: each queue has its own");
+    require(ledger.skipped() == 4, "ledger: the covered waits are counted");
+    // More pairs than it holds: the least recently used goes, and what is
+    // left is still never wrong (a forgotten wait is only queued again).
+    std::vector<ComPtr<ID3D12Fence>> many(20);
+    for (std::size_t index = 0; index < many.size(); ++index) {
+        require_hresult(gpu.device->CreateFence(
+                            0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(many[index].GetAddressOf())),
+            "ledger: fence");
+        ledger.note(gpu.queue.Get(), many[index].Get(), index + 1U);
+    }
+    require(!ledger.covered(gpu.queue.Get(), first.Get(), 1), "ledger: the oldest entry was dropped");
+    require(ledger.covered(gpu.queue.Get(), many.back().Get(), many.size()) &&
+            !ledger.covered(gpu.queue.Get(), many.back().Get(), many.size() + 1U),
+        "ledger: the newest entry holds");
+    std::cout << "cockpit mask: the ledger of queued waits (foveated layers)\n";
+}
