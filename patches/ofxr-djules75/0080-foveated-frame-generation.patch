+// Foveated layers: with CockpitMaskConsumerOptions::focus_views the focus
+// views' own texels come with the frame (their rects and tangents, per eye),
+// beside the periphery views, which are unchanged; without the option, or
+// without the producer's views 2 and 3, none; never without a periphery
+// view. The depth of the periphery views is paired as before when the depth
+// producer has no focus views (focus_depth_views stay invalid).
+void test_focus_view_texels(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"focustexels");
+    FakeProducer producer(gpu, suffix);
+    FakeDepthProducer depth(gpu, suffix, producer);
+    auto options = test_options(suffix);
+    options.cockpit_depth = true;
+    {
+        xrfg::CockpitMaskConsumer plain;
+        require_hresult(plain.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+        const std::uint64_t seq = producer.commit(7000, 255, 15U);
+        depth.commit(producer);
+        producer.signal(seq);
+        const auto frame = plain.acquire(7000);
+        require(frame != nullptr && frame->focus[0].valid && frame->focus[1].valid &&
+                !frame->focus_views[0].valid && !frame->focus_views[1].valid &&
+                !frame->focus_depth_views[0].valid && !frame->focus_depth_views[1].valid,
+            "focus texels: none without the option");
+    }
+    options.focus_views = true;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    std::uint64_t seq = producer.commit(7001, 255, 15U);
+    depth.commit(producer);
+    producer.signal(seq);
+    const auto both = consumer.acquire(7001);
+    require(both != nullptr && both->views[0].valid && both->views[1].valid, "focus texels: the periphery views");
+    for (int eye = 0; eye < 2; ++eye) {
+        const cm::MaskView& source = producer.header_.slot[producer.header_.newestSlot].view[2 + eye];
+        const xrfg::D3D12CockpitMaskView& view = both->focus_views[static_cast<std::size_t>(eye)];
+        require(view.valid && view.x == source.x && view.y == source.y && view.width == source.w &&
+                view.height == source.h && view.fov_tan == producer.focus_tan_,
+            "focus texels: the focus view's rect and tangents");
+        require(both->views[static_cast<std::size_t>(eye)].fov_tan != view.fov_tan,
+            "focus texels: the periphery view keeps its own tangents");
+    }
+    require(both->depth && both->depth_views[0].valid && both->depth_views[1].valid &&
+            !both->focus_depth_views[0].valid && !both->focus_depth_views[1].valid,
+        "focus texels: the periphery depth as before, no focus depth without the producer's");
+    seq = producer.commit(7002, 255, 7U);
+    producer.signal(seq);
+    const auto left = consumer.acquire(7002);
+    require(left != nullptr && left->focus_views[0].valid && !left->focus_views[1].valid,
+        "focus texels: the left focus view alone");
+    seq = producer.commit(7003, 255, 3U);
+    producer.signal(seq);
+    const auto none = consumer.acquire(7003);
+    require(none != nullptr && !none->focus_views[0].valid && !none->focus_views[1].valid,
+        "focus texels: none without the focus views");
+    seq = producer.commit(7004, 255, 12U);
+    producer.signal(seq);
+    require(consumer.acquire(7004) == nullptr, "focus texels: no frame from focus views alone");
+    std::cout << "cockpit mask: the focus views' own texels (foveated layers)\n";
+}
