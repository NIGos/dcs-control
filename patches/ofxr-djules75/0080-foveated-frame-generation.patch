+    constexpr float kHalfRoll = 0.025F;
+    for (const bool roll : {false, true}) for (const bool triple : {false, true})
+        for (const FocusCase& c : kFocusCases) {
+            const auto views_a = focus_views(c.a, false);
+            ReprojectionViews views_b = focus_views(c.b, !roll);
+            if (roll) {
