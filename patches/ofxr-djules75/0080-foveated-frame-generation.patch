+// (g) The fill. The world turns 0.025 rad between A and B (about 10 focus
+// pixels, the same everywhere to 5 %), the box moves (pursuit, saccade), the
+// head still or turned (yaw + pitch, known to the synthesizer). For every
+// synthetic (2X; 3X at 1/3 and 2/3), against the TRUE frame at its time in
+// B's camera, over the uncovered zone (B's pixels more than 1.5 px outside
+// A, 12 px away from the image's border):
+//  - with foveated_uncovered_fill the mean colour error is at most half of
+//    what the key off leaves there (B held) and at most 4 codes: the zone
+//    shows B moved by the known motion. The control: key off must leave at
+//    least 4 codes there, or the case proves nothing. (Half, 4 and 4 are
+//    GUESSES: this pattern was never run.)
+//  - the alpha is B's at the pixel, every byte, everywhere: nothing lowered,
+//    nothing moved (the fade is fixed in the focus image's pixels; firm).
+//  - the real frame is B bit for bit (firm).
+//  - more than 64 px inside A (the fill's margin is 48: six 8 px flow cells
+//    at the default half-size flow input) no colour byte differs from the
+//    key off (firm, given two runs' flow is the same).
+// The same with the head turned, with no allowance for flow noise: the fill
+// does not use the vectors next to A's edge.
+void test_focus_uncovered_fill(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& base) {
+    constexpr float kWorldYaw = 0.025F;
+    constexpr UINT kBorder = 12;
+    constexpr float kOrdinary = 64.0F;
+    for (const bool rotated : {false, true}) for (const bool triple : {false, true})
+        for (std::size_t index = 0; index < 2; ++index) {
+            const FocusCase& c = kFocusCases[index]; // pursuit, saccade
+            const auto views_a = focus_views(c.a, false);
+            const auto views_b = focus_views(c.b, rotated);
+            xrfg::D3D12NvidiaOpticalFlowOptions layers = base, fill = base;
+            layers.foveated_layers = true;
+            fill.foveated_layers = true;
+            fill.foveated_uncovered_fill = 1U;
+            const FillRun held = run_fill_pair(fixture, backend, layers, views_a, views_b, kWorldYaw, triple);
+            const FillRun filled = run_fill_pair(fixture, backend, fill, views_a, views_b, kWorldYaw, triple);
+            require(filled.real == filled.current, "fill: the real frame is not B bit for bit");
+            require(held.synthetics.size() == filled.synthetics.size(), "fill: outputs missing");
+            for (std::size_t s = 0; s < filled.synthetics.size(); ++s) {
+                const float time = triple ? static_cast<float>(s + 1U) / 3.0F : 0.5F;
+                const StereoPattern truth = moving_world_pattern(views_b, kWorldYaw * time);
+                for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                    double held_error = 0.0, filled_error = 0.0;
+                    std::size_t zone = 0, alpha_differences = 0, ordinary_differences = 0;
+                    for (UINT y = 0; y < kFocusHeight; ++y) {
+                        for (UINT x = 0; x < kFocusWidth; ++x) {
+                            const std::size_t at = (static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel;
+                            alpha_differences += filled.synthetics[s][eye][at + 3] != filled.current[eye][at + 3]
+                                ? 1U : 0U;
