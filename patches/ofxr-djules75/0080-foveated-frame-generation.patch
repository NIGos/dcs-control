+// A world with texture at every scale the flow needs (value noise by ray
+// direction, cells of 5, 12 and 120 pixels of the focus image), turned by
+// `world_yaw` about the vertical: a known motion of the whole world between
+// two frames whose cameras the synthesizer is told are `views`. The frame at
+// any time between is the same world at a part of the yaw: rendered, not
+// estimated. Alpha: the focus fade.
+StereoPattern moving_world_pattern(const ReprojectionViews& views, float world_yaw) {
+    StereoPattern pattern;
+    const xrfg::Quaternion turn{0.0F, std::sin(world_yaw * 0.5F), 0.0F, std::cos(world_yaw * 0.5F)};
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        auto& bytes = pattern[eye];
+        bytes.resize(static_cast<std::size_t>(kFocusWidth) * kFocusHeight * kBytesPerPixel);
+        const auto& view = views[eye];
+        const float left = std::tan(view.fov.angle_left), right = std::tan(view.fov.angle_right);
+        const float up = std::tan(view.fov.angle_up), down = std::tan(view.fov.angle_down);
+        for (UINT y = 0; y < kFocusHeight; ++y) {
+            for (UINT x = 0; x < kFocusWidth; ++x) {
+                const float u = (static_cast<float>(x) + 0.5F) / kFocusWidth;
+                const float v = (static_cast<float>(y) + 0.5F) / kFocusHeight;
+                const xrfg::Vec3 ray = rotate_vector(turn, rotate_vector(view.pose.orientation,
+                    {left + (right - left) * u, up + (down - up) * v, -1.0F}));
+                const double azimuth = std::atan2(static_cast<double>(ray.x), -static_cast<double>(ray.z));
+                const double elevation = std::atan2(static_cast<double>(ray.y),
+                    std::sqrt(static_cast<double>(ray.x) * ray.x + static_cast<double>(ray.z) * ray.z));
+                const std::size_t at = (static_cast<std::size_t>(y) * kFocusWidth + x) * kBytesPerPixel;
+                for (std::uint32_t channel = 0; channel < 3; ++channel) {
+                    const double level = 0.45 * fovq::value_noise(azimuth, elevation, 0.030, 11U) +
+                        0.25 * fovq::value_noise(azimuth, elevation, 0.0125, 23U + channel) +
+                        0.30 * fovq::value_noise(azimuth, elevation, 0.30, 37U + channel * 5U);
+                    bytes[at + channel] = static_cast<std::uint8_t>(std::clamp(30.0 + 200.0 * level, 0.0, 255.0));
+                }
+                bytes[at + 3] = focus_edge_alpha(x, y);
+            }
+        }
+    }
+    return pattern;
+}
+
+struct FillRun {
+    StereoPattern current;                 // frame B as uploaded
+    StereoPattern real;                    // the current output
+    std::vector<StereoPattern> synthetics; // one (2X) or two (3X)
+};
+
+// As run_focus_pair, on the moving world: A at world yaw 0 in views_a, B at
+// `world_yaw` in views_b.
+FillRun run_fill_pair(D3D12WarpFixture& fixture, xrfg::D3D12OpticalFlowBackend backend,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options, const ReprojectionViews& views_a,
+    const ReprojectionViews& views_b, float world_yaw, bool triple) {
+    FillRun output;
+    const StereoPattern previous = moving_world_pattern(views_a, 0.0F);
+    output.current = moving_world_pattern(views_b, world_yaw);
+    std::array<ComPtr<ID3D12Resource>, 2> sources{
+        create_source_texture(fixture, kFocusWidth, kFocusHeight),
+        create_source_texture(fixture, kFocusWidth, kFocusHeight)};
+    std::array<ComPtr<ID3D12Resource>, 2> originals{
+        create_source_texture(fixture, kFocusWidth, kFocusHeight),
+        create_source_texture(fixture, kFocusWidth, kFocusHeight)};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetic{
+        create_source_texture(fixture, kFocusWidth, kFocusHeight),
+        create_source_texture(fixture, kFocusWidth, kFocusHeight)};
+    std::array<ID3D12Resource*, 2> inputs{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 2> outputs{originals[0].Get(), originals[1].Get()};
+    std::array<ID3D12Resource*, 2> middle{synthetic[0].Get(), synthetic[1].Get()};
+    upload_pattern(fixture, sources[0].Get(), previous);
+    upload_pattern(fixture, sources[1].Get(), output.current);
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(fixture.device(), fixture.queue(), inputs,
+        D3D12_RESOURCE_STATE_RENDER_TARGET), "fill: history initialization");
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(fixture.device(), fixture.queue(), history,
+        outputs, middle, kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET, backend, options),
+        "fill: synthesizer initialization");
+    synth.set_foveated_focus(true);
+    xrfg::D3D12HistoryCaptureTicket a{}, b{};
+    require_hresult(history->capture(0, &a), "fill: capture A");
+    require_hresult(history->commit(a), "fill: commit A");
+    xrfg::D3D12FrameSynthesisTicket prime{};
+    require_hresult(synth.submit_prime(a, views_a, 0, &prime), "fill: prime");
+    require_hresult(history->capture(1, &b), "fill: capture B");
+    require_hresult(history->commit(b), "fill: commit B");
+    xrfg::D3D12FrameSynthesisTicket pair{};
+    require_hresult(synth.submit_pair(b, views_b, views_b, 0, 1, &pair, std::nullopt, {}, false,
+            triple ? 1.0F / 3.0F : 0.5F,
+            triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                   : std::nullopt),
+        "fill: pair");
+    output.real = readback_pattern(fixture, originals[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+    output.synthetics.push_back(readback_pattern(fixture, synthetic[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    if (triple) {
+        output.synthetics.push_back(
+            readback_pattern(fixture, synthetic[1].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET));
+    }
+    require_hresult(synth.wait_for_idle(), "fill: drain");
+    require_hresult(history->invalidate(), "fill: history invalidate");
+    return output;
+}
