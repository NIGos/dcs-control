@@ -135,6 +135,9 @@
     EngineStatusFn periphery_status{};
     HMODULE periphery_module{};
     std::uint64_t next_periphery_lookup_ms{};
+    // 0020: the update counter (bits 48-55) and when it last moved.
+    unsigned periphery_counter{0x100};
+    std::uint64_t periphery_moved_ms{};
     std::uint64_t next_status_open_ms{};
 
     ~Impl() {
@@ -425,7 +428,11 @@
                 L"XR_APILAYER_MBUCCHIA_quad_views_foveated.dll", "DcsVr_QuadViewsPeripheryStatus", periphery_module);
             if (!periphery_status) return;
         }
-        inputs.periphery = {true, periphery_status()};
+        const auto bits = periphery_status();
+        const auto tick = GetTickCount64();
+        const auto counter = static_cast<unsigned>((bits >> 48) & 0xFFU);
+        if (counter != periphery_counter) { periphery_counter = counter; periphery_moved_ms = tick; }
+        inputs.periphery = {true, bits, (bits & kPeripheryValid) != 0 && tick - periphery_moved_ms > 2000};
     }
 
     void read_engine(DiagnosticInputs& inputs) {
