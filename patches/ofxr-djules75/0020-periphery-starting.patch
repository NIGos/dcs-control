diff --git a/include/xrfg/diagnostic_overlay_model.hpp b/include/xrfg/diagnostic_overlay_model.hpp
--- a/include/xrfg/diagnostic_overlay_model.hpp
+++ b/include/xrfg/diagnostic_overlay_model.hpp
@@ -173,11 +173,16 @@
 // filtered, bits 8-15 the strength x100, bits 16-31 frames filtered in the
 // last second, bits 32-47 resets in the last second. known is false when the
 // bundled Quad Views (or its export) is not loaded.
+// 0020: bit 0 means on and active (the opaque periphery, not the focus debug
+// view), bit 2 the status is valid (0 before the first frame), bits 48-55 an
+// update counter; stale is set by the panel when that counter stopped moving.
 struct PeripheryStatus {
     bool known{};
     std::uint64_t bits{};
+    bool stale{};
 };
 inline constexpr std::uint64_t kPeripheryOn = 1ULL << 0;
+inline constexpr std::uint64_t kPeripheryValid = 1ULL << 2;
 
 struct DiagnosticInputs {
     float output_fps{};        // what the overlay's counter shows
@@ -228,6 +233,8 @@
 // periphery line: "Periphery: ON 0.50, 88 fps" green, "Periphery: ON, not
 // filtering" amber (the pass runs but filtered nothing in the last second),
 // "Periphery: OFF" grey. Empty without the bundled Quad Views' export.
+// 0020: "Periphery: starting" grey before its first frame, "Periphery: not
+// updating" amber when its status stopped changing for 2 s.
 [[nodiscard]] std::string format_periphery_line(const DiagnosticInputs& inputs, DiagnosticColor& color);
 // DCS VR Control (0007): "VRAM 28.4 / 32.0 GB" - what every process has
 // resident in the adapter's dedicated memory against that memory, where the
diff --git a/src/core/diagnostic_overlay_model.cpp b/src/core/diagnostic_overlay_model.cpp
--- a/src/core/diagnostic_overlay_model.cpp
+++ b/src/core/diagnostic_overlay_model.cpp
@@ -223,6 +223,8 @@
 std::string format_periphery_line(const DiagnosticInputs& in, DiagnosticColor& color) {
     const auto& p = in.periphery;
     if (!p.known) return {};
+    if (!(p.bits & kPeripheryValid)) { color = DiagnosticColor::grey; return "Periphery: starting"; }
+    if (p.stale) { color = DiagnosticColor::amber; return "Periphery: not updating"; }
     if (!(p.bits & kPeripheryOn)) { color = DiagnosticColor::grey; return "Periphery: OFF"; }
     const auto frames = static_cast<unsigned>((p.bits >> 16) & 0xFFFFU);
     if (frames == 0U) { color = DiagnosticColor::amber; return "Periphery: ON, not filtering"; }
diff --git a/src/layer/openxr_fps_overlay.cpp b/src/layer/openxr_fps_overlay.cpp
