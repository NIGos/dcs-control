+    // DCS Control (0074): 1X was left (`last_told` the latest display time
+    // told so far). Flown (issue #17, 0070-0073): the frames of 2 that follow
+    // a 1X land one or two periods before the time the level's offset tells
+    // them - the queue 1X leaves is a slot or two shorter than the one the
+    // offset was learnt on - and that offset's last move was the other way
+    // (+2 at the session's start), so the hold refused the correction for
+    // 30 s and more (adaptive_switch result=15 a=2 b=-1 or -2, one a second)
+    // while the application predicted its poses a refresh or two off. For
+    // kRephaseWindow of told time after the exit, the first confirmed move
+    // of 2 and of 3 (kConfirmCadence frames agreeing, as ever) is taken
+    // whatever its direction and is not counted a reversal: it is the
+    // transition's, not the load's square wave 0060-0062 hold against. One
+    // move per level per exit; a level found on time (a confirmed run) ends
+    // its window. Everything else of the hysteresis is as it was.
+    static constexpr Nanoseconds kRephaseWindow = 10 * kSecond;
+    std::array<Nanoseconds, kLevels> rephase_until{};
+    void left_one(Nanoseconds last_told) noexcept {
+        for (std::size_t level = 1; level < kLevels; ++level) {
+            rephase_until[level] = last_told + kRephaseWindow;
+            streak[level] = 0;
+            on_time[level] = 0; // a confirmed run on time from here ends it
+        }
+    }
