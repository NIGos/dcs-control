+// DCS Control (0074): the told-time move a 1X exit needs (issue #17). Frames
+// of 2 land two periods late and the level learns +2; after a 1X they land
+// where they were told without it - two periods before the offset's time.
+void cadence_resync_rephase_tests() {
+    constexpr Nanoseconds kP = 11'111'111;
+    struct Sim {
+        CadenceTimeResync resync{};
+        Nanoseconds told{kSecond};
+        std::vector<std::pair<Nanoseconds, std::int64_t>> moved;
+        std::uint32_t blocked{};
+    };
+    // Frames of 2 for `duration`, each shown `lands` periods after the time
+    // it would be told with no offset.
+    const auto run = [&](Sim& sim, Nanoseconds duration, std::int64_t lands) {
+        const Nanoseconds until = sim.told + duration;
+        while (sim.told < until) {
+            sim.told += 2 * kP;
+            const std::int64_t with = sim.resync.periods_for(2);
+            const std::int64_t moved = sim.resync.observe(
+                2, sim.told, (lands - with) * kP, kP, sim.told, with);
+            if (moved != 0) {
+                sim.moved.emplace_back(sim.told, moved);
+            }
+            sim.blocked += sim.resync.blocked.periods != 0 ? 1U : 0U;
+        }
+    };
+    const auto learnt = [&](Sim& sim) {
+        run(sim, 20 * kSecond, 2);
+        require(sim.moved.size() == 1 && sim.moved[0].second == 2 &&
+                sim.resync.periods_for(2) == 2 && sim.blocked == 0,
+            "rephase: 2 learns its +2");
+    };
+    {
+        // Without the exit's word (0062 as it was): the move against the
+        // last one is held, and said so about once a second.
+        Sim held;
+        learnt(held);
+        run(held, 12 * kSecond, 0);
+        require(held.moved.size() == 1 && held.resync.periods_for(2) == 2 &&
+                held.blocked >= 8,
+            "rephase: without left_one the hold refuses the move (result=15)");
+    }
+    Sim sim;
+    learnt(sim);
+    const Nanoseconds left = sim.told;
+    sim.resync.left_one(sim.told);
+    run(sim, 12 * kSecond, 0);
+    require(sim.moved.size() == 2 && sim.moved[1].second == -2 &&
+            sim.moved[1].first <= left + 1 * kSecond &&
+            sim.resync.periods_for(2) == 0 && sim.blocked == 0,
+        "rephase: after a 1X the first confirmed move is taken, within a second");
+    require(sim.resync.backoff[1] == 0 && sim.resync.rephase_until[1] == 0,
+        "rephase: not a reversal, and the one move of its window");
+    // The protections stand: the load's swing back within the hold is held,
+    // inside what was the exit's window as well.
+    Sim swing;
+    learnt(swing);
+    swing.resync.left_one(swing.told);
+    run(swing, 2 * kSecond, 0);
+    require(swing.moved.size() == 2, "rephase: moved");
+    run(swing, 6 * kSecond, 2);
+    require(swing.moved.size() == 2 && swing.blocked > 0,
+        "rephase: one move per exit; the swing back is held as before");
+    // A level found on time after the exit ends its window: a shift a few
+    // seconds later is the hold's to judge.
+    Sim on_time;
+    learnt(on_time);
+    on_time.resync.left_one(on_time.told);
+    run(on_time, 2 * kSecond, 2);
+    require(on_time.resync.rephase_until[1] == 0, "rephase: on time ends the window");
+    run(on_time, 6 * kSecond, 0);
+    require(on_time.moved.size() == 1 && on_time.blocked > 0,
+        "rephase: a later shift inside the hold is held");
+    // 3 has its own window from the same exit; 1X has no hold to pass.
+    CadenceTimeResync levels{};
+    levels.left_one(5 * kSecond);
+    require(levels.rephase_until[0] == 0 &&
+            levels.rephase_until[1] == 5 * kSecond + CadenceTimeResync::kRephaseWindow &&
+            levels.rephase_until[2] == levels.rephase_until[1],
+        "rephase: 2 and 3, not 1X");
+}
