+        const UINT factor = way == Way::twin ? kFactor : 1U;
+        const UINT width = kWidth * factor, height = kHeight * factor;
+        const auto& run_views = way == Way::twin ? twin_views : views;
+        std::array<ComPtr<ID3D12Resource>, 2> sources{create_source_texture(fixture, width, height),
+            create_source_texture(fixture, width, height)};
+        std::array<ComPtr<ID3D12Resource>, 2> currents{create_source_texture(fixture, width, height),
+            create_source_texture(fixture, width, height)};
+        std::array<ComPtr<ID3D12Resource>, 1> synthetics{create_source_texture(fixture, width, height)};
+        const Sprite sprite = make_sprite_filtered(templates[drawn_template], scale);
+        const auto frame = [&](int index) {
+            StereoPattern pattern = world;
+            for (UINT eye = 0; eye < kEyeCount; ++eye)
+                draw_cursor_sized(&pattern, eye, kWidth, kHeight,
+                    CursorPosition{300 + index * 9 + static_cast<int>(eye) * 3, 400 + index * 3}, sprite);
+            return way == Way::twin ? enlarge_pattern(pattern, kWidth, kHeight, kFactor) : pattern;
+        };
+        std::array<ID3D12Resource*, 2> inputs{sources[0].Get(), sources[1].Get()};
+        std::array<ID3D12Resource*, 2> outputs{currents[0].Get(), currents[1].Get()};
+        std::array<ID3D12Resource*, 1> middle{synthetics[0].Get()};
+        auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require_hresult(history->initialize(fixture.device(), fixture.queue(), inputs,
+            D3D12_RESOURCE_STATE_RENDER_TARGET), "real size: history initialization");
+        xrfg::D3D12FrameSynthesizer synthesizer;
+        require_hresult(synthesizer.initialize(fixture.device(), fixture.queue(), history, outputs, middle, kFormat,
+            D3D12_RESOURCE_STATE_RENDER_TARGET, backend, base, true), "real size: synthesizer initialization");
+        xrfg::D3D12SmoothCursorOptions cursor{};
+        cursor.enabled = true;
+        cursor.templates = templates;
+        cursor.small_sprite = way == Way::enlarged;
+        cursor.small_sprite_enlarge = way == Way::enlarged ? static_cast<float>(kFactor) : 0.0F;
+        require(synthesizer.set_smooth_cursor(cursor) == S_OK, "real size: set_smooth_cursor");
+        xrfg::D3D12HistoryCaptureTicket capture{};
+        xrfg::D3D12FrameSynthesisTicket ticket{};
+        // Each pair: frame A primed, frame B paired with it, the cursor 9 x 3
+        // pixels on (so every pair acquires: nothing is tracked from the
+        // pair before).
+        for (int index = 0; index < kPairs; ++index) {
+            upload_pattern(fixture, sources[0].Get(), frame(2 * index));
+            upload_pattern(fixture, sources[1].Get(), frame(2 * index + 1));
+            const std::uint64_t time = 100'000 + static_cast<std::uint64_t>(index) * 40U;
+            synthesizer.note_cursor_position(1000 + index * 54, 700 + index * 18, time);
+            require_hresult(history->capture(0, &capture), "real size: capture A");
+            require_hresult(history->commit(capture), "real size: commit A");
+            require_hresult(synthesizer.submit_prime(capture, run_views, 0, &ticket), "real size: prime");
+            require_frame_start_gate(synthesizer, "real size: frame-start gate");
+            synthesizer.note_cursor_position(1000 + index * 54 + 27, 700 + index * 18 + 9, time + 11U);
+            require_hresult(history->capture(1, &capture), "real size: capture B");
+            require_hresult(history->commit(capture), "real size: commit B");
+            require_hresult(synthesizer.submit_pair(capture, run_views, run_views, 0, 1, &ticket),
