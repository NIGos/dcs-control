+    std::vector<xrfg::D3D12CursorTemplate> templates{xrfg::built_in_arrow_template()};
+    std::array<wchar_t, 512> dcs_bin{};
+    const DWORD length = GetEnvironmentVariableW(L"XRFG_TEST_DCS_BIN", dcs_bin.data(),
+        static_cast<DWORD>(dcs_bin.size()));
+    if (length > 0 && length < dcs_bin.size()) {
+        const xrfg::CursorTemplateSet dcs = xrfg::load_dcs_cursor_templates(std::filesystem::path(dcs_bin.data()));
+        if (dcs.source == xrfg::CursorTemplateSource::dcs_file)
+            templates.insert(templates.end(), dcs.templates.begin(), dcs.templates.end());
+    }
