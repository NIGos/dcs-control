+// What the runtime shows of one synthetic of the pair: alpha x focus +
+// (1 - alpha) x periphery (the nearest periphery pixel) inside the focus box
+// of frame B, the periphery layer elsewhere; counted over the periphery
+// region and the focus region: pixels more than 40 codes off the same blend
+// of the two expected images, and how many pixels were looked at.
+struct LayerShown {
+    std::size_t wrong{};
+    std::size_t pixels{};
+};
+
+LayerShown layer_shown_wrong(const StereoPattern& focus, const StereoPattern& periphery,
+    const StereoPattern& focus_expected, const StereoPattern& periphery_expected,
+    const std::array<int, 4>& focus_region, const std::array<int, 4>& periphery_region, LayerBox box_b) {
+    LayerShown shown;
+    const auto differs = [](float a, float b) { return std::abs(a - b) > 40.0F; };
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        // Outside the focus box: the periphery layer alone.
+        for (int y = periphery_region[1]; y < periphery_region[3]; ++y)
+            for (int x = periphery_region[0]; x < periphery_region[2]; ++x) {
+                if (x >= box_b.left && x < box_b.left + kLayerBoxWidth && y >= box_b.top &&
+                    y < box_b.top + kLayerBoxHeight)
+                    continue;
+                const std::size_t at = (static_cast<std::size_t>(y) * kLayerWidth + static_cast<std::size_t>(x)) *
+                    kBytesPerPixel;
+                bool wrong = false;
+                for (UINT channel = 0; channel < 3; ++channel)
+                    wrong = wrong || differs(static_cast<float>(periphery[eye][at + channel]),
+                        static_cast<float>(periphery_expected[eye][at + channel]));
+                shown.wrong += wrong ? 1U : 0U;
+                ++shown.pixels;
+            }
+        // Inside it: the blend, per focus pixel.
+        for (int y = focus_region[1]; y < focus_region[3]; ++y)
+            for (int x = focus_region[0]; x < focus_region[2]; ++x) {
+                const std::size_t at = (static_cast<std::size_t>(y) * kLayerWidth + static_cast<std::size_t>(x)) *
+                    kBytesPerPixel;
+                const std::size_t under =
+                    (static_cast<std::size_t>(box_b.top + y / kLayerRatio) * kLayerWidth +
+                        static_cast<std::size_t>(box_b.left + x / kLayerRatio)) * kBytesPerPixel;
+                const float alpha = static_cast<float>(focus[eye][at + 3]);
+                bool wrong = false;
+                for (UINT channel = 0; channel < 3; ++channel) {
+                    const float is = (alpha * static_cast<float>(focus[eye][at + channel]) +
+                        (255.0F - alpha) * static_cast<float>(periphery[eye][under + channel])) / 255.0F;
+                    const float wanted = (alpha * static_cast<float>(focus_expected[eye][at + channel]) +
+                        (255.0F - alpha) * static_cast<float>(periphery_expected[eye][under + channel])) / 255.0F;
+                    wrong = wrong || differs(is, wanted);
+                }
+                shown.wrong += wrong ? 1U : 0U;
+                ++shown.pixels;
+            }
+    }
+    return shown;
+}
