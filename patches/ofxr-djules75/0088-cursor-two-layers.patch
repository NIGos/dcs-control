+// Round 8: the sprite as an image that shows it small holds it: every pixel
+// the mean of the template's texels it covers (colour weighted by alpha).
+Sprite make_sprite_filtered(const xrfg::D3D12CursorTemplate& source, float scale) {
+    Sprite sprite;
+    constexpr int kTexels = static_cast<int>(xrfg::kD3D12CursorTemplateSize);
+    sprite.size = static_cast<int>(std::ceil(static_cast<float>(kTexels) * scale));
+    sprite.rgba.assign(static_cast<std::size_t>(sprite.size) * static_cast<std::size_t>(sprite.size), 0U);
+    constexpr int kSub = 8;
+    for (int y = 0; y < sprite.size; ++y) {
+        for (int x = 0; x < sprite.size; ++x) {
+            std::array<float, 3> colour{};
+            float alpha = 0.0F;
+            for (int sy = 0; sy < kSub; ++sy) {
+                for (int sx = 0; sx < kSub; ++sx) {
+                    const int tx = static_cast<int>(std::floor(
+                        (static_cast<float>(x) + (static_cast<float>(sx) + 0.5F) / kSub) / scale));
+                    const int ty = static_cast<int>(std::floor(
+                        (static_cast<float>(y) + (static_cast<float>(sy) + 0.5F) / kSub) / scale));
+                    if (tx >= kTexels || ty >= kTexels) continue;
+                    const std::uint32_t texel =
+                        source.rgba[static_cast<std::size_t>(ty) * kTexels + static_cast<std::size_t>(tx)];
+                    const float a = static_cast<float>(texel >> 24U) / 255.0F;
+                    alpha += a;
+                    for (std::size_t channel = 0; channel < 3; ++channel)
+                        colour[channel] += a * static_cast<float>((texel >> (8U * channel)) & 0xffU);
+                }
+            }
+            if (alpha <= 0.0F) continue;
+            std::uint32_t rgba = static_cast<std::uint32_t>(
+                std::lround(std::min(alpha / static_cast<float>(kSub * kSub), 1.0F) * 255.0F)) << 24U;
+            for (std::size_t channel = 0; channel < 3; ++channel)
+                rgba |= static_cast<std::uint32_t>(std::lround(std::min(colour[channel] / alpha, 255.0F)))
+                    << (8U * channel);
+            sprite.rgba[static_cast<std::size_t>(y * sprite.size + x)] = rgba;
+        }
+    }
