+// An image enlarged `factor` times as a linear-clamp sampler enlarges it
+// (Quad Views' composition of the periphery; smooth_cursor.hlsl,
+// frame_colour).
+StereoPattern enlarge_pattern(const StereoPattern& pattern, UINT width, UINT height, UINT factor) {
+    StereoPattern output;
+    const UINT out_width = width * factor, out_height = height * factor;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        output[eye].resize(static_cast<std::size_t>(out_width) * out_height * kBytesPerPixel);
+        for (UINT y = 0; y < out_height; ++y) {
+            const float real_y = (static_cast<float>(y) + 0.5F) / static_cast<float>(factor) - 0.5F;
+            const int low_y = static_cast<int>(std::floor(real_y));
+            const float weight_y = real_y - static_cast<float>(low_y);
+            const std::size_t y0 = static_cast<std::size_t>(std::clamp(low_y, 0, static_cast<int>(height) - 1));
+            const std::size_t y1 = static_cast<std::size_t>(std::clamp(low_y + 1, 0, static_cast<int>(height) - 1));
+            for (UINT x = 0; x < out_width; ++x) {
+                const float real_x = (static_cast<float>(x) + 0.5F) / static_cast<float>(factor) - 0.5F;
+                const int low_x = static_cast<int>(std::floor(real_x));
+                const float weight_x = real_x - static_cast<float>(low_x);
+                const std::size_t x0 = static_cast<std::size_t>(std::clamp(low_x, 0, static_cast<int>(width) - 1));
+                const std::size_t x1 =
+                    static_cast<std::size_t>(std::clamp(low_x + 1, 0, static_cast<int>(width) - 1));
+                const std::uint8_t* p00 = &pattern[eye][(y0 * width + x0) * kBytesPerPixel];
+                const std::uint8_t* p10 = &pattern[eye][(y0 * width + x1) * kBytesPerPixel];
+                const std::uint8_t* p01 = &pattern[eye][(y1 * width + x0) * kBytesPerPixel];
+                const std::uint8_t* p11 = &pattern[eye][(y1 * width + x1) * kBytesPerPixel];
+                std::uint8_t* out = &output[eye][(static_cast<std::size_t>(y) * out_width + x) * kBytesPerPixel];
+                for (UINT channel = 0; channel < kBytesPerPixel; ++channel) {
+                    const float top = static_cast<float>(p00[channel]) +
+                        (static_cast<float>(p10[channel]) - static_cast<float>(p00[channel])) * weight_x;
+                    const float bottom = static_cast<float>(p01[channel]) +
+                        (static_cast<float>(p11[channel]) - static_cast<float>(p01[channel])) * weight_x;
+                    out[channel] = static_cast<std::uint8_t>(std::lround(top + (bottom - top) * weight_y));
+                }
+            }
+        }
+    }
+    return output;
+}
