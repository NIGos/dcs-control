+// DCS Control (0040): whether the rect (x, y, width, height) lies inside a
+// texture of `texture_width` x `texture_height` texels, in 64 bits: the
+// producer contracts' own view_usable() adds x + w in 32, where a rect near
+// the top of the range wraps and passes.
+[[nodiscard]] constexpr bool cockpit_rect_inside(std::uint32_t x, std::uint32_t y, std::uint32_t width,
+    std::uint32_t height, std::uint64_t texture_width, std::uint64_t texture_height) noexcept {
+    return std::uint64_t(x) + width <= texture_width && std::uint64_t(y) + height <= texture_height;
+}
+
+// DCS Control (0040): DCS's motion vectors' backoff (0036), one decision per
+// pair for every eye. A pixel whose MV fails the colour check is composed by
+// both the MVs and the flow (about 1.7 times the flow's cost): where more
+// than a fifth of the sampled pixels of kWindowPairs pairs fell back (thick
+// smoke or cloud, a scene the MVs do not describe), the next kBackoffPairs
+// pairs take the flow alone, as before 0036. 0036 kept this per synthesizer,
+// that is per eye in DCS (a swapchain each), so the two eyes could decide
+// apart and one compose along the MVs while the other took the flow, for a
+// second or two. Now the consumer's frames share one: the first eye to ask
+// about a pair (its current frame's display time) decides, and every other
+// eye asking about that pair gets the same answer; both eyes' results feed
+// one window.
+class DcsMotionBackoff {
+public:
+    static constexpr std::uint64_t kWindowPairs = 32;
+    static constexpr std::uint64_t kBackoffPairs = 96;
+
+    // Whether the pair whose current frame has display time `pair` takes the
+    // flow alone.
+    [[nodiscard]] bool backing_off(std::int64_t pair) noexcept {
+        std::scoped_lock lock(mutex_);
+        for (const Decision& decision : decided_) {
+            if (decision.known && decision.pair == pair) {
+                return decision.back_off;
+            }
+        }
+        const bool back_off = left_ != 0;
+        if (back_off) {
+            --left_;
+        }
+        decided_[next_] = {true, pair, back_off};
+        next_ = (next_ + 1) % decided_.size();
+        return back_off;
+    }
+    // One eye's sampled pixels along its MVs and back to the flow, of the
+    // pair `pair`. The window counts a pair once, when it first sees a newer
+    // one than before.
+    void add(std::int64_t pair, std::uint64_t pixels, std::uint64_t fallbacks) noexcept {
+        std::scoped_lock lock(mutex_);
+        window_pixels_ += pixels;
+        window_fallbacks_ += fallbacks;
+        if (window_seen_ && pair <= window_last_pair_) {
+            return;
+        }
+        window_seen_ = true;
+        window_last_pair_ = pair;
+        if (++window_pairs_ >= kWindowPairs) {
+            if (window_fallbacks_ * 5U > window_pixels_ + window_fallbacks_) {
+                left_ = kBackoffPairs;
+            }
+            window_pixels_ = 0;
+            window_fallbacks_ = 0;
+            window_pairs_ = 0;
+        }
+    }
+    // The pairs it still holds the MVs off for.
+    [[nodiscard]] std::uint64_t remaining() noexcept {
+        std::scoped_lock lock(mutex_);
+        return left_;
+    }
+
+private:
+    struct Decision {
+        bool known{};
+        std::int64_t pair{};
+        bool back_off{};
+    };
+    std::mutex mutex_;
+    // The last pairs decided: the eyes are at most a few pairs apart.
+    std::array<Decision, 16> decided_{};
+    std::size_t next_{};
+    std::uint64_t left_{};
+    std::uint64_t window_pixels_{};
+    std::uint64_t window_fallbacks_{};
+    std::uint64_t window_pairs_{};
+    std::int64_t window_last_pair_{};
+    bool window_seen_{};
+};
