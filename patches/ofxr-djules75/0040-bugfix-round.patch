+// DCS Control (0040): a stall ends once the copy queue has run everything
+// queued before it and the stall's hold has passed (result=15), the hold
+// doubling with each stall; the frames after it are copied as before.
+void test_stall_recovers(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"recover");
+    FakeProducer producer(gpu, suffix);
+    auto options = test_options(suffix);
+    options.stall_milliseconds = 100;
+    options.stall_recovery_milliseconds = 300;
+    xrfg::CockpitMaskConsumer consumer;
+    std::vector<std::int64_t> logged;
+    require_hresult(consumer.initialize(gpu.device.Get(),
+                        [&logged](std::int64_t code, std::uint64_t, std::uint64_t, std::uint64_t) {
+                            logged.push_back(code);
+                        },
+                        options),
+        "consumer initialize");
+    std::int64_t time = 2100;
+    for (std::uint64_t stall = 1; stall <= 2; ++stall) {
+        const std::uint64_t held = producer.commit(time, 255);
+        require(consumer.acquire(time++) != nullptr, "recover: paired before the stall");
+        Sleep(180);
+        producer.commit(time, 255);
+        require(consumer.acquire(time++) == nullptr &&
+                consumer.stats().last == xrfg::CockpitMaskLookup::stalled && consumer.stats().stalls == stall,
+            "recover: the copy that never completed stalls the masks");
+        const auto stalled_at = std::chrono::steady_clock::now();
+        const DWORD hold = 300U << (stall - 1U);
+        if (stall == 1) {
+            // The queue catches up at once: off for the hold all the same.
+            producer.signal(held);
+            Sleep(hold / 2U);
+            producer.commit(time, 255);
+            require(consumer.acquire(time++) == nullptr &&
+                    consumer.stats().last == xrfg::CockpitMaskLookup::stalled,
+                "recover: off for the hold though the queue caught up");
+        } else {
+            // Still behind past the hold: off however long it takes.
+            Sleep(hold + 50U);
+            producer.commit(time, 255);
+            require(consumer.acquire(time++) == nullptr &&
+                    consumer.stats().last == xrfg::CockpitMaskLookup::stalled,
+                "recover: off while the copy queue is still behind");
+            producer.signal(held);
+        }
+        std::shared_ptr<xrfg::D3D12CockpitMaskFrame> back;
+        std::uint64_t back_seq = 0;
+        for (int attempt = 0; attempt < 300 && back == nullptr; ++attempt) {
+            back_seq = producer.commit(time, 128);
+            producer.signal(back_seq);
+            back = consumer.acquire(time++);
+            if (back == nullptr) {
+                Sleep(10);
+            }
+        }
+        const auto off_for = std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - stalled_at);
+        require(back != nullptr && consumer.stats().stall_recoveries == stall,
+            "recover: masks are back once the queue caught up");
+        require(off_for.count() >= static_cast<long long>(hold) - 20,
+            "recover: not before the hold (doubled for the second stall): " + std::to_string(off_for.count()) +
+                " ms");
+        gpu.wait(back->ready_fence.Get(), back->ready_value);
+        require(gpu.readback(back->texture.Get()) == producer.last_pattern_, "recover: the copy holds the new slot");
+        back.reset();
+    }
+    require(std::count(logged.begin(), logged.end(), 5) == 2 && std::count(logged.begin(), logged.end(), 15) == 2,
+        "recover: two stalls (result=5) and two recoveries (result=15) logged");
+    std::cout << "cockpit mask: a stall ends once the copy queue has caught up, after a doubling hold\n";
+}
