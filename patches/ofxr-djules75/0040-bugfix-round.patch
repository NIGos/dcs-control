+// DCS Control (0040): the release fence's signals queued after the last copy
+// have run once the consumer is gone (the end waits for one more done_fence
+// signal behind them).
+void test_end_drains_release_signals(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"enddrain");
+    FakeProducer producer(gpu, suffix);
+    std::uint64_t newest = 0;
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, test_options(suffix)), "consumer initialize");
+        const std::uint64_t seq = producer.commit(2500, 255);
+        producer.signal(seq);
+        require(consumer.acquire(2500) != nullptr, "end drain: paired");
+        newest = producer.commit(2501, 255);
+        producer.signal(newest);
+        require(consumer.acquire(2599) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::no_slot,
+            "end drain: no slot, the newest released");
+    }
+    require(producer.release_fence_->GetCompletedValue() >= newest,
+        "end drain: the release signal queued after the last copy has run");
+    std::cout << "cockpit mask: the end drains the release signals as well\n";
+}
