+// DCS Control (0040): a rect whose x + w wraps in 32 bits passes the
+// contracts' own view_usable(); the consumer checks in 64 bits and leaves
+// that eye out (its mask and its MVs), the other eye as before.
+void test_wrapped_rects(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"wrap");
+    FakeProducer producer(gpu, suffix);
+    FakeMotionProducer motion(gpu, suffix, producer);
+    auto options = test_options(suffix);
+    options.dcs_motion = true;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    const std::uint64_t seq = producer.commit(2700, 255);
+    const int slot = static_cast<int>(producer.header_.newestSlot);
+    cm::MaskView& mask_view = producer.header_.slot[slot].view[1];
+    mask_view.x = 0xFFFFFFF0U;
+    mask_view.w = 0x20U;
+    producer.publish();
+    require(cm::view_usable(producer.header_, slot, 1), "wrap: the mask contract's check passes it");
+    motion.commit(producer, 2690);
+    cmv::MotionView& motion_view = motion.header_.slot[slot].view[1];
+    motion_view.x = 0xFFFFFFF8U;
+    motion_view.w = 0x10U;
+    motion.publish();
+    require(cmv::view_usable(motion.header_, slot, 1), "wrap: the motion contract's check passes it");
+    producer.signal(seq);
+    const auto frame = consumer.acquire(2700);
+    require(frame != nullptr && frame->views[0].valid && !frame->views[1].valid,
+        "wrap: the wrapped mask rect is left out, the other eye kept");
+    require(frame->motion && frame->motion_views[0].valid && !frame->motion_views[1].valid,
+        "wrap: the wrapped MV rect is left out, the other eye kept");
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    std::cout << "cockpit mask: rects that wrap in 32 bits are left out\n";
+}
