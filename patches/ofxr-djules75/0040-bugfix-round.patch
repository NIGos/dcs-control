+// DCS Control (0040): the rect check, and the MVs' backoff decided once per
+// pair for every eye.
+void test_rects_and_motion_backoff() {
+    require(xrfg::cockpit_rect_inside(0, 0, 48, 20, 48, 20) && !xrfg::cockpit_rect_inside(1, 0, 48, 20, 48, 20) &&
+            !xrfg::cockpit_rect_inside(0, 1, 48, 20, 48, 20),
+        "rect: the edges");
+    require(!xrfg::cockpit_rect_inside(0xFFFFFFF0U, 0, 0x20U, 20, 48, 20) &&
+            !xrfg::cockpit_rect_inside(0, 0xFFFFFFFFU, 48, 2, 48, 20),
+        "rect: a sum that wraps in 32 bits is outside");
+    {
+        xrfg::DcsMotionBackoff backoff;
+        // Over a fifth of the pixels fell back in every pair: the window
+        // closes on its 32nd pair, the left eye having decided it already.
+        for (std::int64_t pair = 1; pair < 32; ++pair) {
+            require(!backoff.backing_off(pair) && !backoff.backing_off(pair), "backoff: not yet");
+            backoff.add(pair, 10, 10);
+            backoff.add(pair, 10, 10);
+        }
+        // A late result of an earlier pair (the other eye's) is no new pair.
+        for (int late = 0; late < 8; ++late) {
+            backoff.add(5, 10, 10);
+        }
+        require(backoff.remaining() == 0, "backoff: a late result does not close the window");
+        require(!backoff.backing_off(32), "backoff: the left eye decides pair 32");
+        backoff.add(32, 10, 10);
+        require(backoff.remaining() == xrfg::DcsMotionBackoff::kBackoffPairs, "backoff: the window closed");
+        require(!backoff.backing_off(32), "backoff: the right eye gets the left eye's answer for pair 32");
+        std::uint64_t held = 0;
+        for (std::int64_t pair = 33; pair < 33 + 200; ++pair) {
+            const bool left = backoff.backing_off(pair);
+            const bool right = backoff.backing_off(pair);
+            require(left == right, "backoff: both eyes decide alike");
+            held += left ? 1U : 0U;
+        }
+        require(held == xrfg::DcsMotionBackoff::kBackoffPairs, "backoff: the MVs held off for its pairs");
+    }
+    {
+        // A healthy window: no backoff.
+        xrfg::DcsMotionBackoff backoff;
+        for (std::int64_t pair = 1; pair <= 64; ++pair) {
+            require(!backoff.backing_off(pair), "healthy: no backoff");
+            backoff.add(pair, 100, 10);
+            backoff.add(pair, 100, 10);
+        }
+        require(backoff.remaining() == 0, "healthy: nothing held");
+    }
+    std::cout << "cockpit mask: 64-bit rects, and one MV backoff decision per pair\n";
+}
