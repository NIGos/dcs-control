+// DCS Control (0038): under `[ofxr] parallel_eye_synthesis`, a synthesis
+// queue for one application swapchain alone, made like the session's
+// d3d12_synthesis_queue. DCS renders one swapchain per eye, and on one shared
+// queue the second eye's pack waited behind the first eye's whole synthesis,
+// the composition's wait for its optical flow included, so its flow could not
+// start before the first eye's had finished. On queues of their own both
+// eyes' flows go to the engine as soon as their packs are done, and the first
+// eye's composition runs beside the second's flow. Measured on an RTX 5090
+// (two 4800x4800 eyes, flow at 2400x2400), the pair is written about 0.9 ms
+// (2X) to 1.3 ms (3X) sooner at the median. At 2 the flows keep one order
+// (D3D12OpticalFlowChain) and that gain is gone: it is there for comparison.
+// Null - the shared queue - when off or where the queue cannot be made.
+[[nodiscard]] Microsoft::WRL::ComPtr<ID3D12CommandQueue> own_synthesis_queue(
+    SessionState& session) noexcept {
+    Microsoft::WRL::ComPtr<ID3D12CommandQueue> queue;
+    if (session.parallel_eye_synthesis == 0 || !session.d3d12_synthesis_queue ||
+        !session.d3d12_device) {
+        return queue;
+    }
+    const D3D12_COMMAND_QUEUE_DESC description =
+        session.d3d12_synthesis_queue->GetDesc();
+    if (FAILED(session.d3d12_device->CreateCommandQueue(
+            &description, IID_PPV_ARGS(queue.GetAddressOf())))) {
+        queue.Reset();
+    }
+    return queue;
+}
