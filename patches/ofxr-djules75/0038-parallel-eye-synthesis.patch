+// XRFG_TEST_PARALLEL_EYES_BENCH=1 on NVIDIA hardware: GPU time from the first
+// eye's pack to both synthetics written, per pair, shared against parallel and
+// chained, alternately on the same clocks, at 2X and 3X. XRFG_PARALLEL_EYES_SIZE=<n>
+// for an n x n eye image (default 4800: a flow input of 2400 at
+// nvidia_input_scale=50, about the 2.9 ms flow of a live Pimax flight).
+void bench_parallel_eye_synthesis() {
+    D3D12WarpFixture fixture(true);
+    UINT side = 4800;
+    char text[16]{};
+    if (GetEnvironmentVariableA("XRFG_PARALLEL_EYES_SIZE", text, sizeof(text)) > 0) {
+        side = static_cast<UINT>(std::strtoul(text, nullptr, 10));
+    }
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.input_scale = xrfg::D3D12NvidiaInputScale::half;
+    const auto percentile = [](std::vector<double> values, double p) {
+        if (values.empty()) return 0.0;
+        std::sort(values.begin(), values.end());
+        return values[static_cast<std::size_t>(p * static_cast<double>(values.size() - 1))];
+    };
+    for (bool triple : {false, true}) {
+        std::array<std::vector<double>, 3> total, eye0;
+        for (int round = 0; round < 4; ++round) {
+            for (int mode : {0, 1, 2}) {
+                const EyeSwapchainRun run = run_eye_swapchains(fixture, side, side, 40, mode, triple, false, true,
+                    options);
+                // The first pairs warm up.
+                if (run.written_us.size() > 4) {
+                    total[mode].insert(total[mode].end(), run.written_us.begin() + 4, run.written_us.end());
+                    eye0[mode].insert(eye0[mode].end(), run.eye0_written_us.begin() + 4, run.eye0_written_us.end());
+                }
+            }
+        }
+        std::cout << "parallel eyes bench " << side << "x" << side << " x2 swapchains " << (triple ? "3X" : "2X")
+                  << ": written (both eyes) p10/p50/p90 us";
+        const char* const names[] = {"shared", "parallel", "chained"};
+        for (int mode : {0, 1, 2}) {
+            std::cout << " " << names[mode] << " " << percentile(total[mode], 0.1) << "/"
+                      << percentile(total[mode], 0.5) << "/" << percentile(total[mode], 0.9);
+        }
+        std::cout << "; eye 0 written p50 us";
+        for (int mode : {0, 1, 2}) {
+            std::cout << " " << names[mode] << " " << percentile(eye0[mode], 0.5);
+        }
+        std::cout << " (" << total[0].size() << " pairs each)" << std::endl;
+    }
+    fixture.require_no_debug_errors();
+}
