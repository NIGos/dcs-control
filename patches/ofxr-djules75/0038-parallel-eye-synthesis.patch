+// DCS Control (0038): `[ofxr] parallel_eye_synthesis`. Two application
+// swapchains, one per eye, each with its own history and synthesizer - DCS's
+// shape - submitted the way the layer submits a frame (both captures, then
+// eye 0's pair, then eye 1's). Mode 0, shared: both synthesizers on one
+// synthesis queue, as before. 1, parallel: a queue each. 2, chained: a queue
+// each, their optical-flow jobs in one D3D12OpticalFlowChain (the key's
+// values). A pair is "written" when the later eye's synthetic
+// is (its gpu_end_qpc, before the current copy), measured from the earlier
+// eye's pack.
+struct EyeSwapchain {
+    std::array<ComPtr<ID3D12Resource>, 3> sources{};
+    std::array<ComPtr<ID3D12Resource>, 2> currents{};
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics{};
+    std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+    std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+    ComPtr<ID3D12Fence> completion;
+};
+
+struct EyeSwapchainRun {
+    // Per pair: both eyes' synthetics, then (3X) their second synthetics,
+    // then both current copies.
+    std::vector<std::vector<std::uint8_t>> outputs;
+    std::vector<double> written_us; // per pair, both eyes
+    std::vector<double> eye0_written_us;
+};
+
+[[nodiscard]] ComPtr<ID3D12CommandQueue> synthesis_queue(D3D12WarpFixture& fixture) {
+    D3D12_COMMAND_QUEUE_DESC description{};
+    description.Type = D3D12_COMMAND_LIST_TYPE_DIRECT;
+    description.Priority = D3D12_COMMAND_QUEUE_PRIORITY_HIGH; // as the layer's
+    ComPtr<ID3D12CommandQueue> queue;
+    require_hresult(fixture.device()->CreateCommandQueue(&description,
+        IID_PPV_ARGS(queue.GetAddressOf())), "parallel eyes: synthesis queue");
+    return queue;
+}
+
+EyeSwapchainRun run_eye_swapchains(D3D12WarpFixture& fixture, UINT width, UINT height, int pairs,
+    int mode, bool triple, bool read_outputs, bool paced,
+    const xrfg::D3D12NvidiaOpticalFlowOptions& options = {}) {
+    constexpr UINT kFrames = 3;
+    std::array<EyeSwapchain, kEyeCount> eyes{};
+    // Three frames of a textured scene moving 12 px a frame, different per eye.
+    StereoPattern background;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        background[eye].resize(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const RgbaBytes texel =
+                    cursor_background_texel((x + 7U * y / 5U) % kCursorWidth, y % kCursorHeight, eye);
+                std::copy(texel.begin(), texel.end(), background[eye].begin() +
+                    static_cast<std::ptrdiff_t>((static_cast<std::size_t>(y) * width + x) * kBytesPerPixel));
+            }
+        }
+    }
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        for (auto& source : eyes[eye].sources) source = create_single_slice_texture(fixture, width, height);
+    }
+    for (UINT frame = 0; frame < kFrames; ++frame) {
+        StereoPattern image = background;
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            std::rotate(image[eye].begin(), image[eye].begin() + frame * 12U * kBytesPerPixel, image[eye].end());
+        }
+        // Uploaded as a two-slice texture, each slice copied into its eye's own.
+        const ComPtr<ID3D12Resource> staging = create_source_texture(fixture, width, height);
+        upload_pattern(fixture, staging.Get(), image);
+        fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+            const D3D12_RESOURCE_BARRIER to_source = transition_barrier(
+                staging.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_SOURCE);
+            list->ResourceBarrier(1, &to_source);
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                ID3D12Resource* const target = eyes[eye].sources[frame].Get();
+                const D3D12_RESOURCE_BARRIER to_dest = transition_barrier(
+                    target, D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COPY_DEST);
+                list->ResourceBarrier(1, &to_dest);
+                D3D12_TEXTURE_COPY_LOCATION source{};
+                source.pResource = staging.Get();
+                source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+                source.SubresourceIndex = eye;
+                D3D12_TEXTURE_COPY_LOCATION destination{};
+                destination.pResource = target;
+                destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+                destination.SubresourceIndex = 0;
+                list->CopyTextureRegion(&destination, 0, 0, 0, &source, nullptr);
+                const D3D12_RESOURCE_BARRIER back = transition_barrier(
+                    target, D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_RENDER_TARGET);
+                list->ResourceBarrier(1, &back);
+            }
+            const D3D12_RESOURCE_BARRIER restore = transition_barrier(
+                staging.Get(), D3D12_RESOURCE_STATE_COPY_SOURCE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+            list->ResourceBarrier(1, &restore);
+        });
+    }
+    // The layer's queues: one shared, or one per swapchain and the chain.
+    const ComPtr<ID3D12CommandQueue> shared = synthesis_queue(fixture);
+    const auto chain = mode == 2 ? std::make_shared<xrfg::D3D12OpticalFlowChain>() : nullptr;
+    std::array<ComPtr<ID3D12CommandQueue>, kEyeCount> queues{};
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        EyeSwapchain& swapchain = eyes[eye];
+        queues[eye] = mode != 0 ? synthesis_queue(fixture) : shared;
+        // Private swapchains rest in COMMON on a synthesis queue of their own.
+        for (auto& c : swapchain.currents) c = create_single_slice_texture(fixture, width, height);
+        for (auto& s : swapchain.synthetics) s = create_single_slice_texture(fixture, width, height);
+        fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+            for (auto* set : {&swapchain.currents, &swapchain.synthetics}) {
+                for (auto& texture : *set) {
+                    const D3D12_RESOURCE_BARRIER to_common = transition_barrier(
+                        texture.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COMMON);
+                    list->ResourceBarrier(1, &to_common);
+                }
+            }
+        });
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT i = 0; i < kFrames; ++i) source_pointers[i] = swapchain.sources[i].Get();
+        std::array<ID3D12Resource*, 2> current_pointers{swapchain.currents[0].Get(), swapchain.currents[1].Get()};
+        std::array<ID3D12Resource*, 2> synthetic_pointers{
+            swapchain.synthetics[0].Get(), swapchain.synthetics[1].Get()};
+        swapchain.history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require(operation_succeeded(swapchain.history->initialize(fixture.device(), fixture.queue(),
+                    std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                    D3D12_RESOURCE_STATE_RENDER_TARGET)), "parallel eyes: history");
+        swapchain.synthesizer = std::make_unique<xrfg::D3D12FrameSynthesizer>();
+        require(operation_succeeded(swapchain.synthesizer->initialize(fixture.device(), queues[eye].Get(),
+                    swapchain.history,
+                    std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                    std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                    kFormat, D3D12_RESOURCE_STATE_COMMON,
+                    xrfg::D3D12OpticalFlowBackend::nvidia, options, true)), "parallel eyes: synthesizer");
+        if (chain) swapchain.synthesizer->set_optical_flow_chain(chain);
+        require_hresult(swapchain.synthesizer->completion_fence(swapchain.completion.GetAddressOf()),
+            "parallel eyes: completion fence");
+    }
+    const ReprojectionViews stereo = make_reprojection_views();
+    LARGE_INTEGER frequency{};
+    QueryPerformanceFrequency(&frequency);
+    const HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    EyeSwapchainRun run;
+    for (int frame = 0; frame <= pairs; ++frame) {
+        const UINT slot = static_cast<UINT>(frame) % kFrames;
+        std::array<xrfg::D3D12HistoryCaptureTicket, kEyeCount> captures{};
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            HRESULT captured = E_FAIL;
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+            do {
+                captured = eyes[eye].history->capture(slot, &captures[eye]);
+                if (captured == HRESULT_FROM_WIN32(ERROR_BUSY)) Sleep(0);
+            } while (captured == HRESULT_FROM_WIN32(ERROR_BUSY) &&
+                     std::chrono::steady_clock::now() < deadline);
+            require(operation_succeeded(captured) &&
+                        operation_succeeded(eyes[eye].history->commit(captures[eye])), "parallel eyes: capture");
+        }
+        std::array<xrfg::D3D12FrameSynthesisTicket, kEyeCount> tickets{};
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            const std::span<const xrfg::D3D12ReprojectionView> view(stereo.data() + eye, 1);
+            HRESULT submitted = E_FAIL;
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+            do {
+                submitted = frame == 0
+                    ? eyes[eye].synthesizer->submit_prime(captures[eye], view, 0, &tickets[eye])
+                    : eyes[eye].synthesizer->submit_pair(captures[eye], view, view, 0, 0, &tickets[eye],
+                          std::nullopt, {}, false, triple ? 1.0F / 3.0F : 0.5F,
+                          triple ? std::optional<xrfg::D3D12ExtraSynthetic>(
+                                       xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F})
+                                 : std::nullopt);
+                if (submitted == HRESULT_FROM_WIN32(ERROR_BUSY)) Sleep(0);
+            } while (submitted == HRESULT_FROM_WIN32(ERROR_BUSY) &&
+                     std::chrono::steady_clock::now() < deadline);
+            require(operation_succeeded(submitted), "parallel eyes: submission at frame " +
+                std::to_string(frame) + " HRESULT " + std::to_string(static_cast<std::int32_t>(submitted)));
+        }
+        if (!paced && !read_outputs) {
+            continue; // back to back: the queues and the chain under load
+        }
+        for (UINT eye = 0; eye < kEyeCount; ++eye) {
+            ID3D12Fence* const fence = eyes[eye].completion.Get();
+            if (fence->GetCompletedValue() < tickets[eye].fence_value) {
+                require_hresult(fence->SetEventOnCompletion(tickets[eye].fence_value, event),
+                    "parallel eyes: completion event");
+                require(WaitForSingleObject(event, 5000) == WAIT_OBJECT_0, "parallel eyes: pair never completed");
+            }
+        }
+        if (frame > 0) {
+            std::array<xrfg::D3D12NvidiaGpuTiming, kEyeCount> timings{};
+            bool timed = true;
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                xrfg::D3D12NvidiaGpuTiming timing{};
+                bool found = false;
+                while (eyes[eye].synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK) {
+                    if (timing.current_serial == captures[eye].serial) {
+                        timings[eye] = timing;
+                        found = true;
+                    }
+                }
+                timed = timed && found && timings[eye].gpu_begin_qpc != 0 && timings[eye].gpu_end_qpc != 0;
+            }
+            if (timed) {
+                const std::uint64_t begin = std::min(timings[0].gpu_begin_qpc, timings[1].gpu_begin_qpc);
+                const std::uint64_t end = std::max(timings[0].gpu_end_qpc, timings[1].gpu_end_qpc);
+                const auto us = [&](std::uint64_t ticks) {
+                    return static_cast<double>(ticks) * 1.0e6 / static_cast<double>(frequency.QuadPart);
+                };
+                run.written_us.push_back(us(end - begin));
+                run.eye0_written_us.push_back(us(timings[0].gpu_end_qpc - begin));
+            }
+        }
+        if (read_outputs && frame > 0) {
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                run.outputs.push_back(readback_single_slice(fixture, eyes[eye].synthetics[0].Get(),
+                    D3D12_RESOURCE_STATE_COMMON));
+            }
+            for (UINT eye = 0; triple && eye < kEyeCount; ++eye) {
+                run.outputs.push_back(readback_single_slice(fixture, eyes[eye].synthetics[1].Get(),
+                    D3D12_RESOURCE_STATE_COMMON));
+            }
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                run.outputs.push_back(readback_single_slice(fixture, eyes[eye].currents[0].Get(),
+                    D3D12_RESOURCE_STATE_COMMON));
+            }
+        }
+        if (paced) Sleep(4); // an idle GPU before each pair, as between DCS frames
+    }
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        require(operation_succeeded(eyes[eye].synthesizer->wait_for_idle()), "parallel eyes: idle");
+    }
+    CloseHandle(event);
+    fixture.require_no_debug_errors();
+    return run;
+}
+
+// Every channel of every pixel of every output, shared against parallel and
+// chained, at 2X, 3X and with bidirectional flow and the occlusion handling;
+// then both back to back (no CPU wait between pairs) for a while: two
+// optical-flow jobs in flight at once on the engine (parallel), and the
+// chain's deadlock check (chained).
+void run_parallel_eye_synthesis_equivalence() {
+    D3D12WarpFixture fixture(true);
+    constexpr UINT kSide = 1024;
+    xrfg::D3D12NvidiaOpticalFlowOptions bidirectional{};
+    bidirectional.bidirectional = true;
+    bidirectional.occlusion_aware = 2;
+    struct Case {
+        bool triple;
+        xrfg::D3D12NvidiaOpticalFlowOptions options;
+        const char* name;
+    };
+    const std::array<Case, 3> cases{
+        Case{false, {}, "2X"}, Case{true, {}, "3X"}, Case{false, bidirectional, "2X bidirectional"}};
+    for (const Case& c : cases) {
+        const EyeSwapchainRun shared = run_eye_swapchains(fixture, kSide, kSide, 6, 0, c.triple, true, false,
+            c.options);
+        std::size_t bytes = 0;
+        for (int mode : {1, 2}) {
+            const EyeSwapchainRun other = run_eye_swapchains(fixture, kSide, kSide, 6, mode, c.triple, true, false,
+                c.options);
+            require(!shared.outputs.empty() && shared.outputs.size() == other.outputs.size(),
+                std::string("parallel eyes ") + c.name + ": outputs missing");
+            for (std::size_t i = 0; i < shared.outputs.size(); ++i) {
+                require(shared.outputs[i] == other.outputs[i],
+                    std::string("parallel eyes ") + c.name + " mode " + std::to_string(mode) + ": output " +
+                        std::to_string(i) + " differs");
+                bytes += shared.outputs[i].size();
+            }
+        }
+        // Not trivially equal: a synthetic is not its current frame.
+        require(shared.outputs[0] != shared.outputs[c.triple ? 4U : 2U],
+            std::string("parallel eyes ") + c.name + ": synthetic equals the current frame");
+        std::cout << "parallel eye synthesis " << c.name << ": " << shared.outputs.size()
+                  << " outputs, " << bytes << " bytes (parallel and chained) identical to the shared queue"
+                  << std::endl;
+    }
+    const auto started = std::chrono::steady_clock::now();
+    for (int mode : {1, 2}) {
+        static_cast<void>(run_eye_swapchains(fixture, kSide, kSide, 400, mode, false, false, false));
+        static_cast<void>(run_eye_swapchains(fixture, kSide, kSide, 200, mode, true, false, false));
+    }
+    std::cout << "parallel eye synthesis: 1200 pairs back to back in "
+              << std::chrono::duration_cast<std::chrono::milliseconds>(
+                     std::chrono::steady_clock::now() - started).count()
+              << " ms, no stall" << std::endl;
+}
