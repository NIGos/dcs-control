+// DCS Control (0039): synthetics placed by DCS's own content clock (poseQpc).
+
+namespace slot_time {
+
+using content_time::kContentEpoch;
+using content_time::kDisplayEpoch;
+using content_time::periods;
+
+struct Placed {
+    SlotTimePlacement placement;
+    double line_error{}; // the synthetic's content less the constant-latency line, periods
+};
+
+// Real frames (told display and poseQpc, in periods) through the slot
+// clock's latency window; each pair's synthetic `index` of `frames` placed by
+// slot_time_fraction. The line is the true latency, `latency` periods.
+std::vector<Placed> run(const std::vector<double>& told, const std::vector<double>& content, double latency,
+    std::uint32_t frames = 2, std::uint32_t index = 0) {
+    ContentLatencyTracker tracker;
+    std::vector<Placed> out;
+    for (std::size_t i = 0; i < told.size(); ++i) {
+        tracker.observe(kDisplayEpoch + periods(told[i]), kContentEpoch + periods(content[i]));
+        if (i == 0) {
+            continue;
+        }
+        Placed placed;
+        placed.placement = slot_time_fraction(kDisplayEpoch + periods(told[i - 1]),
+            kContentEpoch + periods(content[i - 1]), kDisplayEpoch + periods(told[i]),
+            kContentEpoch + periods(content[i]), tracker.latency(), kPeriod, frames, index);
+        const double t = placed.placement.fraction ? *placed.placement.fraction : 0.0;
+        const double line = told[i] - static_cast<double>(frames - 1 - index) - latency;
+        placed.line_error = content[i - 1] + t * (content[i] - content[i - 1]) - line;
+        out.push_back(placed);
+    }
+    return out;
+}
+
+} // namespace slot_time
+
+void slot_time_tests() {
+    using namespace slot_time;
+    const auto near = [](float value, double expected) {
+        return value > expected - 0.002 && value < expected + 0.002;
+    };
+    // A steady application, 2X and 3X: the fixed k / frames, on the line.
+    {
+        std::vector<double> told;
+        std::vector<double> content;
+        for (int i = 0; i < 12; ++i) {
+            told.push_back(2.0 * i + 3.0);
+            content.push_back(2.0 * i);
+        }
+        const auto pairs = run(told, content, 3.0);
+        for (std::size_t i = kContentLatencyMinimum - 1; i < pairs.size(); ++i) {
+            require(pairs[i].placement.fraction && near(*pairs[i].placement.fraction, 0.5) &&
+                    pairs[i].placement.outcome == SlotTimeOutcome::placed,
+                "slot time: steady 2X is one half");
+        }
+        for (double& value : told) {
+            value *= 1.5;
+        }
+        for (double& value : content) {
+            value *= 1.5;
+        }
+        for (std::uint32_t index = 0; index < 2; ++index) {
+            const auto triple = run(told, content, 4.5, 3, index);
+            for (std::size_t i = kContentLatencyMinimum - 1; i < triple.size(); ++i) {
+                require(triple[i].placement.fraction && near(*triple[i].placement.fraction, (index + 1) / 3.0),
+                    "slot time: steady 3X is thirds");
+            }
+        }
+    }
+    // Irregular display steps, steady content (DCS at 2.25 periods a frame,
+    // told the scanout after: 2 or 3 periods on): every synthetic on the
+    // constant-latency line, none clamped or rejected.
+    {
+        std::vector<double> told;
+        std::vector<double> content;
+        for (int i = 0; i < 26; ++i) {
+            content.push_back(2.25 * i);
+            told.push_back(std::ceil(2.25 * i) + 3.0);
+        }
+        const auto pairs = run(told, content, 3.375);
+        std::size_t answered = 0;
+        bool moved = false;
+        for (std::size_t i = kContentLatencyWindow; i < pairs.size(); ++i) {
+            const Placed& placed = pairs[i];
+            require(placed.placement.fraction && placed.placement.outcome == SlotTimeOutcome::placed,
+                "slot time, irregular display: placed within the band");
+            require(std::abs(placed.line_error) < 0.01,
+                "slot time, irregular display: on the line: " + std::to_string(placed.line_error));
+            moved = moved || std::abs(*placed.placement.fraction - 0.5F) > 0.05F;
+            ++answered;
+        }
+        require(answered >= 10 && moved, "slot time, irregular display: answered, away from one half");
+    }
+    // Steady display, irregular content (DCS's frame starts wander by up to
+    // 0.4 periods): near the line; a late start after one on time places the
+    // synthetic nearer the previous frame, an early one nearer the current.
+    {
+        const std::vector<double> jitter{0.0, 0.3, -0.2, 0.4, -0.4, 0.1, 0.0, -0.3,
+            0.2, 0.35, -0.1, 0.0, 0.4, -0.25, 0.15, 0.0, -0.35, 0.25, 0.0, 0.3};
+        std::vector<double> told;
+        std::vector<double> content;
+        for (std::size_t i = 0; i < jitter.size(); ++i) {
+            told.push_back(2.0 * static_cast<double>(i) + 3.0);
+            content.push_back(2.0 * static_cast<double>(i) + jitter[i]);
+        }
+        const auto pairs = run(told, content, 3.0);
+        std::size_t directed = 0;
+        for (std::size_t i = kContentLatencyWindow; i < pairs.size(); ++i) {
+            const Placed& placed = pairs[i];
+            require(placed.placement.fraction.has_value(), "slot time, irregular content: answered");
+            require(std::abs(placed.line_error) < 0.1,
+                "slot time, irregular content: near the line: " + std::to_string(placed.line_error));
+            if (jitter[i] == 0.0 && jitter[i + 1] > 0.0) {
+                require(*placed.placement.fraction < 0.48F, "slot time: a late start, nearer the previous");
+                ++directed;
+            } else if (jitter[i] == 0.0 && jitter[i + 1] < 0.0) {
+                require(*placed.placement.fraction > 0.52F, "slot time: an early start, nearer the current");
+                ++directed;
+            }
+        }
+        require(directed >= 3, "slot time, irregular content: placements moved");
+    }
+    // Missing, implausible and far-off inputs.
+    {
+        const Nanoseconds d0 = kDisplayEpoch;
+        const Nanoseconds c0 = kContentEpoch;
+        // Told display and poseQpc on their own epochs, told = content (a zero
+        // latency in periods).
+        const std::optional<Nanoseconds> latency = kDisplayEpoch - kContentEpoch;
+        const auto place = [&](Nanoseconds pd, Nanoseconds pc, Nanoseconds cd, Nanoseconds cc,
+                               std::optional<Nanoseconds> l, std::uint32_t frames = 2, std::uint32_t index = 0) {
+            return slot_time_fraction(pd, pc, cd, cc, l, kPeriod, frames, index);
+        };
+        const auto complete = place(d0, c0, d0 + periods(2), c0 + periods(2), latency);
+        require(complete.fraction && near(*complete.fraction, 0.5) && complete.outcome == SlotTimeOutcome::placed &&
+                !complete.rejected(),
+            "slot time: a complete pair is placed");
+        // A frame without a usable record (no poseQpc: unmatched, unobserved,
+        // no companion) has content time 0: not judged, the chain goes on.
+        for (const auto& missing : {place(d0, 0, d0 + periods(2), c0 + periods(2), latency),
+                 place(d0, c0, d0 + periods(2), 0, latency),
+                 place(d0, c0, d0 + periods(2), c0 + periods(2), std::nullopt),
+                 place(d0, c0, d0 + periods(2), c0 + periods(2), latency, 2, 1),
+                 slot_time_fraction(d0, c0, d0 + periods(2), c0 + periods(2), latency, 0, 2, 0)}) {
+            require(!missing.fraction && missing.outcome == SlotTimeOutcome::missing && !missing.rejected(),
+                "slot time: a missing record or window is not judged");
+        }
+        // Records of the wrong frames: contents back in time, too close, too
+        // far apart, or display times out of order.
+        for (const auto& wrong : {place(d0, c0 + periods(2), d0 + periods(2), c0, latency),
+                 place(d0, c0, d0 + periods(2), c0 + periods(0.4), latency),
+                 place(d0, c0, d0 + periods(2), c0 + periods(6.5), latency),
+                 place(d0 + periods(2), c0, d0, c0 + periods(2), latency)}) {
+            require(!wrong.fraction && wrong.outcome == SlotTimeOutcome::interval && wrong.rejected(),
+                "slot time: an implausible pair is rejected");
+        }
+        // A tenth of a period off: placed; four tenths: held to the band
+        // (0.25 .. 0.75 in 2X); more than a whole spacing: rejected.
+        const auto off = place(d0, c0, d0 + periods(2), c0 + periods(2), *latency + periods(0.2));
+        require(off.fraction && near(*off.fraction, 0.4) && off.outcome == SlotTimeOutcome::placed,
+            "slot time: a small offset is placed as it is");
+        const auto held = place(d0, c0, d0 + periods(2), c0 + periods(2), *latency + periods(0.8));
+        require(held.fraction && near(*held.fraction, 0.25) && held.outcome == SlotTimeOutcome::clamped &&
+                std::abs(held.raw - 0.1) < 1e-6,
+            "slot time: held to the band");
+        const auto far = place(d0, c0, d0 + periods(2), c0 + periods(2), *latency + periods(1.2));
+        require(!far.fraction && far.outcome == SlotTimeOutcome::outlier && far.rejected(),
+            "slot time: past twice the band, rejected");
+        const auto late = place(d0, c0, d0 + periods(2), c0 + periods(2), *latency - periods(1.2));
+        require(!late.fraction && late.outcome == SlotTimeOutcome::outlier, "slot time: either side");
+        // 3X: the band is a sixth around each third.
+        const auto third = place(d0, c0, d0 + periods(3), c0 + periods(3), *latency + periods(0.8), 3, 1);
+        require(third.fraction && near(*third.fraction, 0.5) && third.outcome == SlotTimeOutcome::clamped,
+            "slot time: 3X's second synthetic held to 2/3 - 1/6");
+    }
+    // The backoff: three rejections in sixteen judged synthetics are
+    // tolerated, the fourth turns the slot clock off for
+    // kSlotTimeBackoffSynthetics, then it judges afresh.
+    {
+        SlotTimeBackoff backoff;
+        for (int i = 0; i < 40; ++i) {
+            require(backoff.admit() && !backoff.record(i % 16 == 3), "backoff: one rejection in 16 is fine");
+        }
+        require(!backoff.record(true) && !backoff.record(false) && !backoff.record(true), "backoff: two in a row");
+        require(backoff.record(true) && backoff.backoffs() == 1, "backoff: four in the window back off");
+        for (std::uint32_t i = 0; i < kSlotTimeBackoffSynthetics; ++i) {
+            require(!backoff.admit(), "backoff: the slot clock stays off");
+        }
+        require(backoff.admit() && backoff.remaining() == 0, "backoff: and comes back");
+        require(!backoff.record(true) && !backoff.record(true) && !backoff.record(true),
+            "backoff: the window started over");
+        // Spread out, older rejections leave the window.
+        SlotTimeBackoff spread;
+        for (int i = 0; i < 64; ++i) {
+            require(!spread.record(i % 6 == 0), "backoff: one in six stays under four in sixteen");
+        }
+    }
+    // The once-a-second record's words.
+    {
+        ContentTimeSecond second;
+        second.add(SyntheticTimeSource::slot, 0.55F, 2, 0);
+        second.add(SyntheticTimeSource::slot, 0.45F, 2, 0);
+        second.add(SyntheticTimeSource::layer, 0.5F, 2, 0);
+        second.add(SyntheticTimeSource::fixed, 2.0F / 3.0F - 0.1F, 3, 1);
+        second.rejects = 2;
+        const std::uint64_t sources = second.sources_word();
+        require((sources & 0xffffU) == 2 && ((sources >> 16U) & 0xffffU) == 1 &&
+                ((sources >> 32U) & 0xffffU) == 1 && (sources >> 48U) == 2,
+            "content time record: the sources");
+        const std::uint64_t offsets = second.offsets_word();
+        const auto mean = static_cast<std::int32_t>(static_cast<std::uint32_t>(offsets & 0xffffffffULL));
+        const auto low = static_cast<std::int16_t>(static_cast<std::uint16_t>((offsets >> 32U) & 0xffffU));
+        const auto high = static_cast<std::int16_t>(static_cast<std::uint16_t>(offsets >> 48U));
+        require(std::abs(mean - (-2500)) <= 2 && std::abs(low - (-1000)) <= 1 && std::abs(high - 500) <= 1,
+            "content time record: mean, min and max of t - k/N: " + std::to_string(mean) + " " +
+                std::to_string(low) + " " + std::to_string(high));
+        require(ContentTimeSecond{}.offsets_word() == 0, "content time record: empty");
+    }
+}
