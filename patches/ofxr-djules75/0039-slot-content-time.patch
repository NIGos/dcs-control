+        previous_display <= 0 || current_display <= 0 ||
+        previous_content <= 0 || current_content <= 0) {
+        return out;
+    }
+    const Nanoseconds interval = current_content - previous_content;
+    // Out of order, shorter than half a period or longer than three times
+    // the cadence: not two consecutive frames of a running application (or a
+    // record of another frame).
+    if (current_display <= previous_display || interval < period / 2 ||
+        interval > period * static_cast<Nanoseconds>(frames) * 3) {
