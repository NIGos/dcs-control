+
+if(DEFINED ROLES)
+    # c = width << 32 | height: the periphery swapchain is 4x4, the focus 8x8.
+    set(periphery_size 17179869188)
+    set(focus_size 34359738376)
+    set(periphery_right 0)
+    set(focus_right 0)
+    set(wrong 0)
+    set(disagreed 0)
+    foreach(line IN LISTS mode_lines)
+        if(line MATCHES " op=foveated_mode result=3 .* b=([0-9]+) c=([0-9]+)")
+            set(role_bits "${CMAKE_MATCH_1}")
+            set(role_size "${CMAKE_MATCH_2}")
+            math(EXPR role "${role_bits} % 2")
