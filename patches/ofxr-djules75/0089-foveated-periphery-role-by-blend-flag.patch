+// Foveated layers: which of the frame's projection layers has the widest
+// views (the mean of tan(right) - tan(left); the first of equals).
+[[nodiscard]] std::size_t foveated_widest_layer(const ProjectionSnapshot& snapshot) noexcept;
+
 // Foveated layers: which of the frame's projection layers is the periphery
-// layer: the one whose views are widest (the mean of tan(right) - tan(left);
-// the first of equals). The focus layer's field of view is a part of it. One
+// layer. The focus layer is blended over it by its alpha, so the periphery
+// layer is the one projection layer of the frame that does NOT blend by its
+// alpha (XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT), where the
+// frame has exactly one such; otherwise the one whose views are widest, as
+// before (the focus layer's field of view is a part of the periphery's). One
 // projection layer is always the periphery layer.
+// DCS Control (0089): the flag comes first because the fields of view cannot
+// be trusted in every frame. Flown 2026-11-16: with a headset that is not
+// tracked when the session starts (on its stand, or not yet put on), the
+// runtime's first xrLocateViews carries no valid pose, Quad Views then leaves
+// the two focus views as the application handed them in, and the first
+// frame's focus layer came with a field of view wider than the periphery's.
+// That frame is the one that arms the swapchains: the periphery role (the
+// optical flow's input scale, the small-sprite cursor detection) went to the
+// focus layer's swapchain and stayed there for the session (20 of 20 flights:
+// 15 untracked wrong, 5 tracked right), and the cursor outside the focus
+// image was never redrawn (0 of 360 pairs).
 [[nodiscard]] std::size_t foveated_periphery_layer(const ProjectionSnapshot& snapshot) noexcept {
+    std::size_t opaque = 0;
+    std::size_t opaque_count = 0;
+    for (std::size_t index = 0; index < snapshot.layers.size(); ++index) {
+        if ((snapshot.layers[index].layer_flags &
+                XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT) == 0) {
+            if (opaque_count == 0) {
+                opaque = index;
+            }
+            ++opaque_count;
+        }
+    }
+    if (snapshot.layers.size() >= 2 && opaque_count == 1) {
+        return opaque;
+    }
+    return foveated_widest_layer(snapshot);
+}
+
