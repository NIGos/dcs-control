+static const uint kQualitySkyOcclusion = 1u << 16; // dcs_motion_sky_occlusion
+static const uint kQualityLinearInput = 1u << 17;
+static const uint kQualityEdgeChoice = 1u << 18;   // nvidia_edge_choice
