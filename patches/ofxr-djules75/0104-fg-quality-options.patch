+
+// The sRGB transfer function, and its inverse.
+float3 quality_srgb_encode(float3 value) {
+    float3 c = saturate(value);
+    float3 high = 1.055 * pow(max(c, 1.0e-7), 1.0 / 2.4) - 0.055;
+    return lerp(high, c * 12.92, float3(c <= 0.0031308));
+}
+
+float3 quality_srgb_decode(float3 value) {
+    float3 c = saturate(value);
+    float3 high = pow((c + 0.055) / 1.055, 2.4);
+    return lerp(high, c / 12.92, float3(c <= 0.04045));
+}
+
+float max3(float3 value) {
+    return max(value.x, max(value.y, value.z));
+}
+
+// The encoded values, whichever way the image is read.
+float3 quality_encoded_rgb(float3 value) {
+    return quality_option(kQualityLinearInput) ? quality_srgb_encode(value) : value;
+}
+
+// Linear light, whichever way the image is read.
+float3 quality_linear_rgb(float3 value) {
+    return quality_option(kQualityLinearInput) ? value : quality_srgb_decode(value);
+}
