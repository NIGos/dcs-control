+// >>> cursor replay full
+// DCS Control (0082): XRFG_TEST_CURSOR_REPLAY_FULL=<folder> (with
+// XRFG_TEST_DCS_BIN), NVIDIA hardware: real captured frame crops through the
+// detection as the flight ran it. Each crop sits at its origin inside an
+// image of the swapchain's real size (the gate's rules scale with it); one
+// swapchain, one view and one detection per eye, as DCS submits; the real
+// mouse positions; a warm-up before the judged pairs (the file's `order` and
+// `judge`). Two layers: the periphery and the focus swapchain of an eye are
+// linked as the layer links them (periphery first). The folder is made by
+// artifacts\foveated\notes-r4\cursor-fix-tools\make_replay_full.py. Nothing
+// is required: one line per pair and unit is printed (what the gate did and
+// what each frame's detection held), and with XRFG_TEST_CURSOR_REPLAY_OUT
+// the judged pairs' synthetics around the cursor are written there.
+// XRFG_TEST_CURSOR_REPLAY_KEYS: "0", "1" or "01" (default) = follow_mouse.
+struct ReplayUnit {
+    std::string layer;
+    int eye{};
+    UINT full_width{}, full_height{}, crop_width{}, crop_height{}, origin_x{}, origin_y{};
+    int srgb{};
+    std::array<float, 4> tangents{};
+    std::array<int, 3> fill{};
+    std::string file;
+    std::string backdrop; // "-" or a file of two whole frames, alternated under the crop
+    std::vector<std::uint8_t> pixels;
+    std::map<UINT, std::array<UINT, 4>> windows;
+};
+
+struct ReplayPipeline {
+    std::array<ComPtr<ID3D12Resource>, 3> sources;
+    std::array<ComPtr<ID3D12Resource>, 2> backdrops;
+    std::array<ComPtr<ID3D12Resource>, 2> currents;
+    std::array<ComPtr<ID3D12Resource>, 2> synthetics;
+    std::shared_ptr<xrfg::D3D12SwapchainHistory> history;
+    std::unique_ptr<xrfg::D3D12FrameSynthesizer> synthesizer;
+    xrfg::D3D12SmoothCursorStats last{};
+    std::filesystem::path captures;
+    UINT capture_index{};
+    std::uint64_t judged{}, drawn{};
+    // The composition's GPU time of every pair (it holds the cursor's redraw), and whether the pair was redrawn.
+    std::vector<std::uint64_t> composition;
+    std::vector<bool> redrawn;
+    void take_timings() {
+        xrfg::D3D12NvidiaGpuTiming timing{};
+        while (synthesizer->consume_nvidia_gpu_timing(&timing) == S_OK)
+            if (timing.previous_serial != 0) composition.push_back(timing.composition_microseconds);
+    }
+};
