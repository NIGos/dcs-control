+// DCS Control (0082), `[ofxr] cursor_follow_mouse` (the gate then gives the
+// sprite's colour as the current frame holds it; zero without the key, and
+// everything below is as before). The game draws the cockpit cursor fatter
+// and softer than its image wherever it lies on a near surface or comes from
+// a coarser layer: bars of 7 to 8 pixels for the template's 5, with a soft
+// rim. Taken out and redrawn by the template's texels alone, the rim stayed
+// behind at both real places and the redrawn cursor was a thinner one
+// (measured on real frames: 140 wrong pixels a pair for a cursor of 460).
+// So, further out than the template's texels (half a texel more), a pixel
+// that has the sprite's colour belongs to the sprite, by as much as it has
+// it: its chromaticity within 0.12 of the sprite's in full, none from 0.36,
+// times its brightness against half the sprite's. The template's own texels
+// count as before whatever their colour (the cross's dark end caps).
+bool cursor_soft(CursorComposite cursor) {
+    return cursor.reference.r + cursor.reference.g + cursor.reference.b > 0.0;
+}
+
+float cursor_likeness(float3 colour, float3 reference) {
+    float3 chroma = colour / max(colour.r + colour.g + colour.b, 1.0e-4);
+    float3 wanted = reference / max(reference.r + reference.g + reference.b, 1.0e-4);
+    float3 apart = abs(chroma - wanted);
+    float hue = saturate(1.0 - (apart.r + apart.g + apart.b - 0.12) / 0.24);
+    float level = dot(colour, float3(0.2126, 0.7152, 0.0722)) /
+        max(0.5 * dot(reference, float3(0.2126, 0.7152, 0.0722)), 1.0e-4);
+    return hue * saturate(level);
+}
+
+// As cursor_covers, further out and finer: whether a texel of the template
+// lies within the soft reach of `coordinate`, and the way to the nearest one
+// (`toward`, pixels; zero on the template itself). The reach is two and a
+// half texels: in the periphery part of a composed image the cross's bars are
+// 15 pixels wide where the template's are 6 (measured, real frames), and a
+// matte half a texel wide left the rest behind at both real places with a
+// dark moat between (more wrong pixels than the flow alone left).
+static const float kCursorSoftReach = 2.5;
