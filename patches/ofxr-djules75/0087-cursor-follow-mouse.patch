+// DCS Control (0082): `[ofxr] cursor_follow_mouse`. A flight's case: the cursor
+// leaves the tracking window in one frame (the mouse jumped) while something
+// that looks like it stands still inside the window (there a HUD's symbols,
+// here a second arrow). The tracker takes the look-alike, the gate refuses
+// the pair (it moved against the mouse), and from then on:
+//  - without the key the look-alike is tracked for good: it is found again
+//    in every frame, the gate refuses every pair, and the cursor, moving
+//    slowly 200 pixels away, is never searched for;
+//  - with the key the frame after a refused pair is searched where
+//    something moved: the cursor is found again, and after one more pair
+//    (whose previous frame still holds the look-alike) every pair is drawn.
+// Twelve frames, eleven pairs; the jump is between frames 2 and 3.
+// Required: with the key at least 6 of the 9 pairs after the jump are drawn
+// (measured: 7; the first two are the refused pair and the one whose
+// previous frame still holds the look-alike) and accepted pairs are tracked
+// from again; without it at most 1 (measured: 0, nine refused as jumps).
+void test_cursor_reacquire(D3D12WarpFixture& fixture) {
+    constexpr UINT kWidth = 640, kHeight = 480, kFrames = 12;
+    const Sprite sprite = make_sprite(xrfg::built_in_arrow_template());
+    StereoPattern background;
+    for (UINT eye = 0; eye < kEyeCount; ++eye) {
+        background[eye].resize(static_cast<std::size_t>(kWidth) * kHeight * kBytesPerPixel);
+        for (UINT y = 0; y < kHeight; ++y) {
+            for (UINT x = 0; x < kWidth; ++x) {
+                const RgbaBytes texel = cursor_background_texel(x % kCursorWidth, y % kCursorHeight, eye);
+                std::copy(texel.begin(), texel.end(), background[eye].begin() +
+                    static_cast<std::ptrdiff_t>((static_cast<std::size_t>(y) * kWidth + x) * kBytesPerPixel));
+            }
+        }
+    }
+    // The look-alike, still, 40 pixels left of where the cursor starts.
+    const CursorPosition look_alike{100, 200};
+    std::array<CursorPosition, kFrames> positions{};
+    for (UINT frame = 0; frame < kFrames; ++frame) {
+        positions[frame] = frame < 3
+            ? CursorPosition{140 + static_cast<int>(frame) * 6, 200 + static_cast<int>(frame) * 2}
+            : CursorPosition{360 + static_cast<int>(frame) * 6, 150 + static_cast<int>(frame) * 4};
+    }
+    std::size_t last_wrong = 0;
+    const auto run = [&](bool reacquire) {
+        std::array<ComPtr<ID3D12Resource>, kFrames> sources;
+        std::array<ComPtr<ID3D12Resource>, 2> currents;
+        std::array<ComPtr<ID3D12Resource>, 2> synthetics;
+        std::array<ID3D12Resource*, kFrames> source_pointers{};
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            sources[frame] = create_source_texture(fixture, kWidth, kHeight);
+            StereoPattern image = background;
+            draw_cursor_into(&image, kWidth, kHeight, look_alike, sprite);
+            draw_cursor_into(&image, kWidth, kHeight, positions[frame], sprite);
+            upload_pattern(fixture, sources[frame].Get(), image);
+            source_pointers[frame] = sources[frame].Get();
+        }
+        for (auto& texture : currents) texture = create_source_texture(fixture, kWidth, kHeight);
+        for (auto& texture : synthetics) texture = create_source_texture(fixture, kWidth, kHeight);
+        std::array<ID3D12Resource*, 2> current_pointers{currents[0].Get(), currents[1].Get()};
+        std::array<ID3D12Resource*, 2> synthetic_pointers{synthetics[0].Get(), synthetics[1].Get()};
+        auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+        require_hresult(history->initialize(fixture.device(), fixture.queue(),
+            std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+            D3D12_RESOURCE_STATE_RENDER_TARGET), "cursor reacquire: history");
+        xrfg::D3D12FrameSynthesizer synthesizer;
+        require_hresult(synthesizer.initialize(fixture.device(), fixture.queue(), history,
+            std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+            std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+            kFormat, D3D12_RESOURCE_STATE_RENDER_TARGET), "cursor reacquire: synthesizer");
+        xrfg::D3D12SmoothCursorOptions options{};
+        options.enabled = true;
+        options.templates.push_back(xrfg::built_in_arrow_template());
+        options.follow_mouse = reacquire;
+        require(synthesizer.set_smooth_cursor(options) == S_OK, "cursor reacquire: set_smooth_cursor");
+        ReprojectionViews views = make_reprojection_views();
+        for (UINT eye = 0; eye < kEyeCount; ++eye)
+            views[eye].image_rect = xrfg::D3D12ImageRect{0, 0, kWidth, kHeight};
+        std::array<std::uint64_t, kFrames> drawn_after{};
+        xrfg::D3D12SmoothCursorStats stats{};
+        for (UINT frame = 0; frame < kFrames; ++frame) {
+            // The mouse moves as the cursor does (a gain of 1).
+            synthesizer.note_cursor_position(positions[frame][0], positions[frame][1],
+                300'000U + static_cast<std::uint64_t>(frame) * 11U);
+            xrfg::D3D12HistoryCaptureTicket capture{};
+            xrfg::D3D12FrameSynthesisTicket ticket{};
+            require_hresult(history->capture(frame, &capture), "cursor reacquire: capture");
+            require_hresult(history->commit(capture), "cursor reacquire: commit");
+            require_hresult(frame == 0
+                    ? synthesizer.submit_prime(capture, views, 0, &ticket)
+                    : synthesizer.submit_pair(capture, views, views, 0, frame % 2U, &ticket),
+                (std::string("cursor reacquire: submission of frame ") + std::to_string(frame)).c_str());
+            // (The first pair on WARP: 1.4 s, the cursor pass's pixel shader at its first use.)
+            require_hresult(synthesizer.wait_for_previous_submission(frame == 1U ? 10000U : 500U),
+                "cursor reacquire: frame-start gate");
+            // (As far as the GPU has got: a frame or two behind.)
+            require_hresult(synthesizer.smooth_cursor_stats(&stats), "cursor reacquire: stats");
+            drawn_after[frame] = stats.drawn;
+        }
+        require_hresult(synthesizer.wait_for_idle(), "cursor reacquire: idle");
+        require_hresult(synthesizer.smooth_cursor_stats(&stats), "cursor reacquire: stats");
+        // The last pair's synthetic against what it must show: the
+        // background, the look-alike where it stands, the cursor once, half
+        // way. Pixels more than 40 codes off, both eyes.
+        {
+            StereoPattern expected = background;
+            draw_cursor_into(&expected, kWidth, kHeight, look_alike, sprite);
+            draw_cursor_into(&expected, kWidth, kHeight,
+                CursorPosition{(positions[kFrames - 2][0] + positions[kFrames - 1][0]) / 2,
+                    (positions[kFrames - 2][1] + positions[kFrames - 1][1]) / 2}, sprite);
+            const StereoPattern shown =
+                readback_pattern(fixture, synthetics[0].Get(), D3D12_RESOURCE_STATE_RENDER_TARGET);
+            last_wrong = 0;
+            for (UINT eye = 0; eye < kEyeCount; ++eye)
+                for (std::size_t at = 0; at < shown[eye].size(); at += kBytesPerPixel) {
+                    bool differs = false;
+                    for (UINT channel = 0; channel < 3; ++channel)
+                        differs = differs || std::abs(static_cast<int>(shown[eye][at + channel]) -
+                            static_cast<int>(expected[eye][at + channel])) > 40;
+                    last_wrong += differs ? 1U : 0U;
+                }
+        }
+        require_hresult(history->invalidate(), "cursor reacquire: history invalidate");
+        std::cout << "cursor reacquire " << (reacquire ? "on" : "off") << ": pairs " << stats.pairs << " drawn "
+                  << stats.drawn << " (drawn after each frame:";
+        for (const std::uint64_t value : drawn_after) std::cout << ' ' << value;
+        std::cout << "), not found " << stats.not_found << " low score " << stats.low_score << " ambiguous "
+                  << stats.ambiguous << " stereo " << stats.stereo << " jump " << stats.jump << ", acquired "
+                  << stats.acquired << " tracked " << stats.tracked << ", another candidate than the best score "
+                  << stats.picked << "; last synthetic: " << last_wrong << " pixels wrong\n";
+        return std::pair<xrfg::D3D12SmoothCursorStats, std::uint64_t>{stats, stats.drawn};
+    };
+    const auto with = run(true);
+    const std::size_t wrong_with = last_wrong;
+    const auto without = run(false);
+    const std::size_t wrong_without = last_wrong;
+    // (Measured: 10 pixels with the key, at the sprite's rim, and 339 without.)
+    require(wrong_with <= 20, "cursor reacquire: with the key the last synthetic is not the cursor once, half way");
+    require(wrong_without >= 60, "cursor reacquire: without the key the last synthetic is right too");
+    require(with.first.pairs == kFrames - 1U && without.first.pairs == kFrames - 1U,
+        "cursor reacquire: a pair was not judged");
+    // (The two pairs before the jump are refused either way: the look-alike
+    // is 40 pixels from the cursor, an identical sprite inside the window.)
+    require(without.second <= 1U,
+        "cursor reacquire: without the key the look-alike did not hold the tracker, so the case proves nothing");
+    require(with.second >= 6U, "cursor reacquire: with the key the cursor was not found again after the jump");
+    require(with.first.tracked > 0U, "cursor reacquire: accepted pairs are not tracked from");
+    std::cout << "smooth cursor reacquire after a refused pair passed\n";
+}
