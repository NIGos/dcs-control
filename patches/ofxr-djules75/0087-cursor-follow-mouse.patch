+void replay_copy_in(D3D12WarpFixture& fixture, ID3D12Resource* texture, const std::uint8_t* pixels, UINT width,
+    UINT height, UINT at_x, UINT at_y) {
+    const UINT pitch = (width * kBytesPerPixel + 255U) & ~255U;
+    ComPtr<ID3D12Resource> upload = create_buffer(fixture, D3D12_HEAP_TYPE_UPLOAD,
+        static_cast<UINT64>(pitch) * height, D3D12_RESOURCE_STATE_GENERIC_READ);
+    void* mapped = nullptr;
+    const D3D12_RANGE no_read{0, 0};
+    require_hresult(upload->Map(0, &no_read, &mapped), "cursor replay full: Map(upload)");
+    for (UINT y = 0; y < height; ++y)
+        std::memcpy(static_cast<std::byte*>(mapped) + static_cast<std::size_t>(y) * pitch,
+            pixels + static_cast<std::size_t>(y) * width * kBytesPerPixel,
+            static_cast<std::size_t>(width) * kBytesPerPixel);
+    upload->Unmap(0, nullptr);
+    fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+        const D3D12_RESOURCE_BARRIER in = transition_barrier(texture, D3D12_RESOURCE_STATE_RENDER_TARGET,
+            D3D12_RESOURCE_STATE_COPY_DEST);
+        list->ResourceBarrier(1, &in);
+        D3D12_TEXTURE_COPY_LOCATION source{};
+        source.pResource = upload.Get();
+        source.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        source.PlacedFootprint.Footprint = {DXGI_FORMAT_R8G8B8A8_TYPELESS, width, height, 1, pitch};
+        D3D12_TEXTURE_COPY_LOCATION destination{};
+        destination.pResource = texture;
+        destination.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        list->CopyTextureRegion(&destination, at_x, at_y, 0, &source, nullptr);
+        const D3D12_RESOURCE_BARRIER out = transition_barrier(texture, D3D12_RESOURCE_STATE_COPY_DEST,
+            D3D12_RESOURCE_STATE_RENDER_TARGET);
+        list->ResourceBarrier(1, &out);
+    });
+}
