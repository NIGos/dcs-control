+std::vector<std::uint8_t> replay_copy_out(D3D12WarpFixture& fixture, ID3D12Resource* texture, UINT at_x, UINT at_y,
+    UINT width, UINT height) {
+    const UINT pitch = (width * kBytesPerPixel + 255U) & ~255U;
+    ComPtr<ID3D12Resource> readback = create_buffer(fixture, D3D12_HEAP_TYPE_READBACK,
+        static_cast<UINT64>(pitch) * height, D3D12_RESOURCE_STATE_COPY_DEST);
+    fixture.execute_and_wait([&](ID3D12GraphicsCommandList* list) {
+        const D3D12_RESOURCE_BARRIER in = transition_barrier(texture, D3D12_RESOURCE_STATE_RENDER_TARGET,
+            D3D12_RESOURCE_STATE_COPY_SOURCE);
+        list->ResourceBarrier(1, &in);
+        D3D12_TEXTURE_COPY_LOCATION source{};
+        source.pResource = texture;
+        source.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION destination{};
+        destination.pResource = readback.Get();
+        destination.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+        destination.PlacedFootprint.Footprint = {DXGI_FORMAT_R8G8B8A8_TYPELESS, width, height, 1, pitch};
+        const D3D12_BOX box{at_x, at_y, 0, at_x + width, at_y + height, 1};
+        list->CopyTextureRegion(&destination, 0, 0, 0, &source, &box);
+        const D3D12_RESOURCE_BARRIER out = transition_barrier(texture, D3D12_RESOURCE_STATE_COPY_SOURCE,
+            D3D12_RESOURCE_STATE_RENDER_TARGET);
+        list->ResourceBarrier(1, &out);
+    });
+    std::vector<std::uint8_t> result(static_cast<std::size_t>(width) * height * kBytesPerPixel);
+    void* mapped = nullptr;
+    require_hresult(readback->Map(0, nullptr, &mapped), "cursor replay full: Map(readback)");
+    for (UINT y = 0; y < height; ++y)
+        std::memcpy(result.data() + static_cast<std::size_t>(y) * width * kBytesPerPixel,
+            static_cast<const std::byte*>(mapped) + static_cast<std::size_t>(y) * pitch,
+            static_cast<std::size_t>(width) * kBytesPerPixel);
+    const D3D12_RANGE no_write{0, 0};
+    readback->Unmap(0, &no_write);
+    return result;
+}
