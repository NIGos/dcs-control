+// DCS Control (0082): XRFG_TEST_CURSOR_REPLAY=<folder>, with
+// XRFG_TEST_DCS_BIN (the game's cursor images): sequences of real captured
+// frames through the detection, with the key off and on. The folder holds
+// <name>.txt ("width height frames enlarge", then "mouse_x mouse_y cursor_x
+// cursor_y" per frame) and <name>.rgba (per frame, view 0 then view 1, RGBA
+// rows) for the names focus, periphery, composed; made by
+// artifacts\foveated\rig\make_cursor_replay.py from the cursor rig's
+// captures (too large for the repository: 30 to 220 MB each). Nothing is
+// required: the counts are printed. `enlarge` is for the periphery
+// layer of foveated frame generation (not in this tree: read and ignored).
+void test_cursor_replay(D3D12WarpFixture& fixture) {
+    std::array<wchar_t, 512> folder_text{};
+    const DWORD folder_length = GetEnvironmentVariableW(L"XRFG_TEST_CURSOR_REPLAY", folder_text.data(),
+        static_cast<DWORD>(folder_text.size()));
+    std::array<wchar_t, 512> dcs_bin{};
+    const DWORD bin_length = GetEnvironmentVariableW(L"XRFG_TEST_DCS_BIN", dcs_bin.data(),
+        static_cast<DWORD>(dcs_bin.size()));
+    if (folder_length == 0 || folder_length >= folder_text.size() || bin_length == 0 ||
+        bin_length >= dcs_bin.size()) {
+        return;
+    }
+    const xrfg::CursorTemplateSet dcs = xrfg::load_dcs_cursor_templates(std::filesystem::path(dcs_bin.data()));
+    require(dcs.source == xrfg::CursorTemplateSource::dcs_file, "cursor replay: the game's cursor images");
+    const std::filesystem::path folder(folder_text.data());
+    for (const char* name : {"focus", "periphery", "composed"}) {
+        std::ifstream list(folder / (std::string(name) + ".txt"));
+        UINT width = 0, height = 0, frames = 0;
+        float enlarge = 0.0F;
+        // The header's fifth number: 1, the swapchain is sRGB (the detection
+        // then reads linear values, as from the game's composed and periphery
+        // swapchains); 0 or missing, the bytes as they are (the focus layer).
+        int srgb = 0;
+        std::string header;
+        std::getline(list, header);
+        std::istringstream header_fields(header);
+        header_fields >> width >> height >> frames >> enlarge >> srgb;
+        if (width == 0 || height == 0 || frames < 3) {
+            std::cout << "cursor replay " << name << ": no fixture\n";
+            continue;
+        }
+        std::vector<std::array<int, 2>> mouse(frames);
+        for (UINT frame = 0; frame < frames; ++frame) {
+            float cursor_x = 0.0F, cursor_y = 0.0F;
+            list >> mouse[frame][0] >> mouse[frame][1] >> cursor_x >> cursor_y;
+        }
+        std::ifstream pixels(folder / (std::string(name) + ".rgba"), std::ios::binary);
+        const std::size_t view_bytes = static_cast<std::size_t>(width) * height * kBytesPerPixel;
+        std::vector<StereoPattern> images(frames);
+        for (UINT frame = 0; frame < frames; ++frame) {
+            for (UINT eye = 0; eye < kEyeCount; ++eye) {
+                images[frame][eye].resize(view_bytes);
+                pixels.read(reinterpret_cast<char*>(images[frame][eye].data()),
+                    static_cast<std::streamsize>(view_bytes));
+            }
+        }
+        require(static_cast<bool>(pixels), std::string("cursor replay ") + name + ": the pixel file is short");
+        // Typeless textures, so that an sRGB view of them can be asked for.
+        const auto create_replay_texture = [&]() {
+            const D3D12_HEAP_PROPERTIES properties = heap_properties(D3D12_HEAP_TYPE_DEFAULT);
+            D3D12_RESOURCE_DESC description = stereo_texture_description(width, height);
+            description.Format = DXGI_FORMAT_R8G8B8A8_TYPELESS;
+            ComPtr<ID3D12Resource> texture;
+            require_hresult(fixture.device()->CreateCommittedResource(&properties, D3D12_HEAP_FLAG_NONE,
+                &description, D3D12_RESOURCE_STATE_RENDER_TARGET, nullptr,
+                IID_PPV_ARGS(texture.GetAddressOf())), "cursor replay: texture");
+            return texture;
+        };
+        const DXGI_FORMAT view_format = srgb != 0 ? DXGI_FORMAT_R8G8B8A8_UNORM_SRGB : kFormat;
+        for (const bool reacquire : {false, true}) {
+            std::vector<ComPtr<ID3D12Resource>> sources(frames);
+            std::vector<ID3D12Resource*> source_pointers(frames);
+            for (UINT frame = 0; frame < frames; ++frame) {
+                sources[frame] = create_replay_texture();
+                upload_pattern(fixture, sources[frame].Get(), images[frame]);
+                source_pointers[frame] = sources[frame].Get();
+            }
+            std::array<ComPtr<ID3D12Resource>, 2> currents{create_replay_texture(), create_replay_texture()};
+            std::array<ComPtr<ID3D12Resource>, 2> synthetics{create_replay_texture(), create_replay_texture()};
+            std::array<ID3D12Resource*, 2> current_pointers{currents[0].Get(), currents[1].Get()};
+            std::array<ID3D12Resource*, 2> synthetic_pointers{synthetics[0].Get(), synthetics[1].Get()};
+            auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+            require_hresult(history->initialize(fixture.device(), fixture.queue(),
+                std::span<ID3D12Resource* const>(source_pointers.data(), source_pointers.size()),
+                D3D12_RESOURCE_STATE_RENDER_TARGET), "cursor replay: history");
+            xrfg::D3D12FrameSynthesizer synthesizer;
+            require_hresult(synthesizer.initialize(fixture.device(), fixture.queue(), history,
+                std::span<ID3D12Resource* const>(current_pointers.data(), current_pointers.size()),
+                std::span<ID3D12Resource* const>(synthetic_pointers.data(), synthetic_pointers.size()),
+                view_format, D3D12_RESOURCE_STATE_RENDER_TARGET), "cursor replay: synthesizer");
+            xrfg::D3D12SmoothCursorOptions options{};
+            options.enabled = true;
+            options.templates = dcs.templates;
+            options.follow_mouse = reacquire;
+            static_cast<void>(enlarge);
+            require(synthesizer.set_smooth_cursor(options) == S_OK, "cursor replay: set_smooth_cursor");
+            ReprojectionViews views = make_reprojection_views();
+            for (UINT eye = 0; eye < kEyeCount; ++eye)
+                views[eye].image_rect = xrfg::D3D12ImageRect{0, 0, width, height};
+            for (UINT frame = 0; frame < frames; ++frame) {
+                synthesizer.note_cursor_position(mouse[frame][0], mouse[frame][1],
+                    400'000U + static_cast<std::uint64_t>(frame) * 22U);
+                xrfg::D3D12HistoryCaptureTicket capture{};
+                xrfg::D3D12FrameSynthesisTicket ticket{};
+                require_hresult(history->capture(frame, &capture), "cursor replay: capture");
+                require_hresult(history->commit(capture), "cursor replay: commit");
+                require_hresult(frame == 0
+                        ? synthesizer.submit_prime(capture, views, 0, &ticket)
+                        : synthesizer.submit_pair(capture, views, views, 0, frame % 2U, &ticket),
+                    "cursor replay: submission");
+                require_frame_start_gate(synthesizer, "cursor replay: frame-start gate");
+            }
+            require_hresult(synthesizer.wait_for_idle(), "cursor replay: idle");
+            xrfg::D3D12SmoothCursorStats stats{};
+            require_hresult(synthesizer.smooth_cursor_stats(&stats), "cursor replay: stats");
+            require_hresult(history->invalidate(), "cursor replay: history invalidate");
+            std::cout << "cursor replay " << name << " " << width << " x " << height << (srgb != 0 ? " sRGB" : "")
+                      << " (enlarge " << enlarge
+                      << "), cursor_follow_mouse " << (reacquire ? "on" : "off") << ": pairs " << stats.pairs
+                      << " drawn " << stats.drawn << ", not found " << stats.not_found << " low score "
+                      << stats.low_score << " ambiguous " << stats.ambiguous << " stereo " << stats.stereo
+                      << " jump " << stats.jump << " busy " << stats.busy << ", acquired " << stats.acquired
+                      << " tracked " << stats.tracked << "; last weak: template " << (stats.last_weak & 0xffU)
+                      << " scale step " << ((stats.last_weak >> 8U) & 0xffU) << " score "
+                      << static_cast<float>((stats.last_weak >> 16U) & 0xffU) / 255.0F << " look-alike "
+                      << static_cast<float>(stats.last_weak >> 24U) / 255.0F << '\n';
+        }
+    }
+}
