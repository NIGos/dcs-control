+// DCS Control (0047): the reversal back-off.
+
+struct SwitchLog {
+    std::vector<Nanoseconds> at;
+    std::vector<std::uint32_t> to;
+    std::vector<AdaptiveDecision> decisions;
+};
+
+// Frames at the shape's paced rate, `work3` in 3X and `work2` in 2X, with a
+// missed slot every `late_gap2` in 2X (0: none); every switch is applied,
+// and the run ends after `max_switches` of them (0: no limit).
+SwitchLog drive_switches(AdaptiveFrameGenController& controller, Nanoseconds& now,
+    Nanoseconds seconds, Nanoseconds work3, Nanoseconds work2, Nanoseconds late_gap2,
+    std::size_t max_switches = 0) {
+    SwitchLog log{};
+    const Nanoseconds end = now + seconds;
+    Nanoseconds next_late = now;
+    while (now < end) {
+        const bool two = controller.mode() == 2;
+        now += kPeriod * controller.mode();
+        const Nanoseconds work = two ? work2 : work3;
+        controller.add_frame(now, work, work);
+        if (two && late_gap2 > 0 && now >= next_late) {
+            controller.add_late(now);
+            next_late = now + late_gap2;
+        }
+        const auto decision = controller.evaluate(now, kPeriod);
+        if (decision.target != 0 && decision.target != controller.mode()) {
+            log.at.push_back(now);
+            log.to.push_back(decision.target);
+            log.decisions.push_back(decision);
+            controller.switched(decision.target, now, decision.reason);
+            if (max_switches != 0 && log.at.size() >= max_switches) {
+                break;
+            }
+        }
+    }
+    return log;
+}
+
+// The soak's shape: 9 ms of work in either shape, and in 2X a missed slot
+// every 200 ms (about five episodes a second).
+constexpr Nanoseconds kSoakWork = 9 * kMillisecond;
+constexpr Nanoseconds kSoakLate = 200 * kMillisecond;
+
+void backoff_tests() {
+    const Nanoseconds start = 50 * kSecond;
+    const Nanoseconds slack = 200 * kMillisecond;
+    {
+        // The soak's ping-pong: every return to 3X is at min_dwell, and each
+        // quick one doubles the next 3X stay: 5, 10, 20, 40 s, then the
+        // flap-doubled downshift window's 49 s (48 + the settle).
+        AdaptiveFrameGenController controller;
+        controller.start(2, start);
+        Nanoseconds now = start;
+        const auto log = drive_switches(controller, now, 190 * kSecond, kSoakWork, kSoakWork,
+            kSoakLate);
+        require(log.at.size() >= 10, "the ping-pong still switches");
+        const Nanoseconds three_stays[] = {5 * kSecond, 10 * kSecond, 20 * kSecond,
+            40 * kSecond, 49 * kSecond};
+        Nanoseconds before = start;
+        std::size_t threes = 0;
+        for (std::size_t i = 0; i < log.at.size(); ++i) {
+            const Nanoseconds stay = log.at[i] - before;
+            if (log.to[i] == 3) {
+                require(log.decisions[i].reason == AdaptiveReason::late, "up on missed slots");
+                require(stay >= 5 * kSecond && stay <= 5 * kSecond + slack,
+                    "2X -> 3X at min_dwell at every level");
+            } else {
+                require(log.decisions[i].reason == AdaptiveReason::headroom, "down on headroom");
+                if (threes < 5) {
+                    require(stay >= three_stays[threes] && stay <= three_stays[threes] + slack,
+                        "3X stay " + std::to_string(threes) + " doubles");
+                }
+                ++threes;
+            }
+            before = log.at[i];
+        }
+        require(threes >= 5, "five 3X stays");
