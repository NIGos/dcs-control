+        require(controller.backoff_level(raised + 60 * kSecond) == 2 &&
+            controller.hold(raised + 60 * kSecond) == 20 * kSecond, "a clean minute halves the hold");
+        require(controller.backoff_level(raised + 120 * kSecond) == 1 &&
