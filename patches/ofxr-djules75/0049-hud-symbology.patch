+    const auto window = [](const D3D12HudSymbologyView& view, float& u0, float& v0, float& u1, float& v1) {
+        const float width = static_cast<float>(std::max<std::uint32_t>(view.out_width, 1U));
+        const float height = static_cast<float>(std::max<std::uint32_t>(view.out_height, 1U));
+        u0 = static_cast<float>(view.window_x) / width;
+        v0 = static_cast<float>(view.window_y) / height;
+        u1 = static_cast<float>(view.window_x + view.window_width) / width;
+        v1 = static_cast<float>(view.window_y + view.window_height) / height;
+    };
+    float u0 = 0.0F, v0 = 0.0F, u1 = 0.0F, v1 = 0.0F;
+    if (eye.periphery.present) {
+        window(eye.periphery, u0, v0, u1, v1);
+        box.add(u0, v0);
+        box.add(u1, v1);
+    }
+    if (eye.focus.present) {
+        window(eye.focus, u0, v0, u1, v1);
+        const auto& r = eye.focus_rect;
+        box.add(r[0] + u0 * (r[2] - r[0]), r[1] + v0 * (r[3] - r[1]));
+        box.add(r[0] + u1 * (r[2] - r[0]), r[1] + v1 * (r[3] - r[1]));
+    }
+    return box;
+}
+
+[[nodiscard]] HudConstants eye_constants(const HudEyeInput& eye, const HudImageRect& image, std::uint32_t slice) noexcept {
+    HudConstants constants{};
+    constants.eye_rect = {static_cast<float>(image.x), static_cast<float>(image.y),
+        static_cast<float>(image.width), static_cast<float>(image.height)};
+    const auto fill = [](const D3D12HudSymbologyView& view, std::array<std::uint32_t, 4>& atlas,
+                          std::array<std::uint32_t, 4>& window) {
+        atlas = {view.x, view.y, view.window_x, view.window_y};
+        window = {view.window_width, view.window_height, view.out_width, view.out_height};
+    };
+    if (eye.periphery.present) {
+        fill(eye.periphery, constants.periphery_atlas, constants.periphery_window);
+        constants.flags |= kFlagPeriphery;
+    }
+    if (eye.focus.present) {
+        fill(eye.focus, constants.focus_atlas, constants.focus_window);
+        constants.flags |= kFlagFocus;
+    }
+    constants.focus_rect = eye.focus_rect;
+    constants.focus_smoothing = eye.focus_smoothing;
+    constants.focus_shape = eye.focus_shape;
+    constants.slice = slice;
+    return constants;
+}
+
+}  // namespace
+
+HudEyeInput hud_eye_input(const D3D12HudSymbology& symbology, std::uint32_t eye) noexcept {
+    HudEyeInput input{};
+    if (eye >= 2U) {
+        return input;
+    }
+    input.periphery = symbology.views[eye];
+    input.focus = symbology.views[2U + eye];
+    input.focus_rect = symbology.eyes[eye].focus_rect;
+    input.focus_smoothing = symbology.focus_smoothing;
+    input.focus_shape = symbology.focus_shape;
+    return input;
+}
+
+bool hud_rotate_uv(const HudRotation& rotation, float u, float v, float& source_u, float& source_v) noexcept {
+    return map_uv(rotation.target_to_source, rotation.target_tangents, rotation.source_tangents, u, v, source_u,
+        source_v);
+}
+
+D3D12_RECT hud_pass_rect(const HudEyeInput& eye, const HudImageRect& image, const HudRotation* rotation) noexcept {
+    D3D12_RECT none{0, 0, 0, 0};
+    UvBox box = windows_box(eye);
+    if (box.empty() || !std::isfinite(box.u0) || !std::isfinite(box.v0) || !std::isfinite(box.u1) ||
+        !std::isfinite(box.v1)) {
+        return none;
+    }
+    if (rotation != nullptr && rotation->enabled) {
+        // Where the collimated symbology lands: the box's corners carried from
+        // the source frame into the target (the inverse rotation), added to
+        // the box itself (the helmet symbology stays).
+        const std::array<float, 4>& q = rotation->target_to_source;
+        const std::array<float, 4> inverse{-q[0], -q[1], -q[2], q[3]};
+        const UvBox source = box;
+        for (int corner = 0; corner < 4; ++corner) {
+            float u = 0.0F, v = 0.0F;
+            if (!map_uv(inverse, rotation->source_tangents, rotation->target_tangents,
+                    (corner & 1) != 0 ? source.u1 : source.u0, (corner & 2) != 0 ? source.v1 : source.v0, u, v)) {
+                // Behind: the whole image.
+                box.add(0.0F, 0.0F);
+                box.add(1.0F, 1.0F);
+                break;
+            }
+            box.add(u, v);
+        }
+    }
+    const auto pixel = [](float uv, std::uint32_t offset, std::uint32_t extent, bool high) {
+        const double value = static_cast<double>(offset) + static_cast<double>(uv) * extent;
+        const double clamped = std::clamp(high ? std::ceil(value) + kMarginPixels : std::floor(value) - kMarginPixels,
+            static_cast<double>(offset), static_cast<double>(offset) + extent);
+        return static_cast<LONG>(clamped);
+    };
+    D3D12_RECT rect{pixel(box.u0, image.x, image.width, false), pixel(box.v0, image.y, image.height, false),
+        pixel(box.u1, image.x, image.width, true), pixel(box.v1, image.y, image.height, true)};
+    return rect.right > rect.left && rect.bottom > rect.top ? rect : none;
+}
+
+DXGI_FORMAT hud_srgb_format(DXGI_FORMAT format) noexcept {
+    switch (format) {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS:
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        return DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS:
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+        return DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+    default:
+        return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+DXGI_FORMAT hud_typeless_format(DXGI_FORMAT format) noexcept {
+    switch (hud_srgb_format(format)) {
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        return DXGI_FORMAT_R8G8B8A8_TYPELESS;
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+        return DXGI_FORMAT_B8G8R8A8_TYPELESS;
+    default:
+        return DXGI_FORMAT_UNKNOWN;
+    }
+}
+
+bool hud_srgb_viewable(DXGI_FORMAT resource_format, DXGI_FORMAT srgb_format) noexcept {
+    return srgb_format != DXGI_FORMAT_UNKNOWN &&
+        (resource_format == srgb_format || resource_format == hud_typeless_format(srgb_format));
+}
+
+struct D3D12HudSymbologyPasses::Impl {
+    struct Pipelines {
+        DXGI_FORMAT format{DXGI_FORMAT_UNKNOWN};
+        ComPtr<ID3D12PipelineState> remove;
+        ComPtr<ID3D12PipelineState> add;
+        ComPtr<ID3D12PipelineState> subtract;
+        ComPtr<ID3D12PipelineState> alpha;
+    };
+
+    ComPtr<ID3D12Device> device;
+    ComPtr<ID3D12RootSignature> root_signature;
+    ComPtr<ID3D12DescriptorHeap> heap;
+    ComPtr<ID3D12DescriptorHeap> rtv_heap;
+    UINT increment{};
+    UINT rtv_increment{};
+    std::uint32_t slots{};
+    std::vector<Pipelines> pipelines;
+
+    [[nodiscard]] HRESULT create_root_signature() noexcept {
+        D3D12_DESCRIPTOR_RANGE range{};
+        range.RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+        range.NumDescriptors = kDescriptorsPerCall;
+        range.BaseShaderRegister = 0;
+        range.OffsetInDescriptorsFromTableStart = 0;
+        std::array<D3D12_ROOT_PARAMETER, 2> parameters{};
+        parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+        parameters[0].DescriptorTable.NumDescriptorRanges = 1;
+        parameters[0].DescriptorTable.pDescriptorRanges = &range;
+        parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+        parameters[1].Constants.ShaderRegister = 0;
+        parameters[1].Constants.Num32BitValues = kHudConstantCount;
+        parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+        D3D12_ROOT_SIGNATURE_DESC description{};
+        description.NumParameters = static_cast<UINT>(parameters.size());
+        description.pParameters = parameters.data();
+        ComPtr<ID3DBlob> blob;
+        ComPtr<ID3DBlob> errors;
+        HRESULT result = D3D12SerializeRootSignature(
+            &description, D3D_ROOT_SIGNATURE_VERSION_1, blob.GetAddressOf(), errors.GetAddressOf());
+        if (FAILED(result)) {
+            return result;
+        }
+        return device->CreateRootSignature(
+            0, blob->GetBufferPointer(), blob->GetBufferSize(), IID_PPV_ARGS(root_signature.GetAddressOf()));
+    }
+
+    [[nodiscard]] HRESULT create_pipeline(DXGI_FORMAT format, const void* pixel, std::size_t pixel_size,
+        const D3D12_RENDER_TARGET_BLEND_DESC& blend, ComPtr<ID3D12PipelineState>& out) noexcept {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC description{};
+        description.pRootSignature = root_signature.Get();
+        description.VS = {g_xrfg_hud_fullscreen_vertex_shader, sizeof(g_xrfg_hud_fullscreen_vertex_shader)};
+        description.PS = {pixel, pixel_size};
+        description.BlendState.RenderTarget[0] = blend;
+        description.SampleMask = UINT_MAX;
+        description.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        description.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        description.RasterizerState.DepthClipEnable = TRUE;
+        description.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        description.NumRenderTargets = 1;
+        description.RTVFormats[0] = format;
+        description.SampleDesc.Count = 1;
+        return device->CreateGraphicsPipelineState(&description, IID_PPV_ARGS(out.GetAddressOf()));
+    }
+
+    // The four pipelines for render targets of `format`, made at first use.
+    [[nodiscard]] const Pipelines* pipelines_for(DXGI_FORMAT format) noexcept {
+        for (const Pipelines& set : pipelines) {
+            if (set.format == format) {
+                return &set;
+            }
+        }
+        try {
+            Pipelines set{};
+            set.format = format;
+            D3D12_RENDER_TARGET_BLEND_DESC blend{};
+            blend.SrcBlend = D3D12_BLEND_ONE;
+            blend.DestBlend = D3D12_BLEND_ZERO;
+            blend.BlendOp = D3D12_BLEND_OP_ADD;
+            blend.SrcBlendAlpha = D3D12_BLEND_ONE;
+            blend.DestBlendAlpha = D3D12_BLEND_ZERO;
+            blend.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+            blend.LogicOp = D3D12_LOGIC_OP_NOOP;
+            // The alpha channel stays the frame's (the copy's, the synthetic's).
+            blend.RenderTargetWriteMask =
+                D3D12_COLOR_WRITE_ENABLE_RED | D3D12_COLOR_WRITE_ENABLE_GREEN | D3D12_COLOR_WRITE_ENABLE_BLUE;
+            if (FAILED(create_pipeline(format, g_xrfg_hud_remove_pixel_shader, sizeof(g_xrfg_hud_remove_pixel_shader),
+                    blend, set.remove))) {
+                return nullptr;
+            }
+            blend.BlendEnable = TRUE;
+            blend.DestBlend = D3D12_BLEND_ONE;
+            blend.SrcBlendAlpha = D3D12_BLEND_ZERO;
+            blend.DestBlendAlpha = D3D12_BLEND_ONE;
+            if (FAILED(create_pipeline(format, g_xrfg_hud_readd_pixel_shader, sizeof(g_xrfg_hud_readd_pixel_shader),
+                    blend, set.add))) {
+                return nullptr;
+            }
+            blend.BlendOp = D3D12_BLEND_OP_REV_SUBTRACT; // dest - source
+            if (FAILED(create_pipeline(format, g_xrfg_hud_readd_pixel_shader, sizeof(g_xrfg_hud_readd_pixel_shader),
+                    blend, set.subtract))) {
+                return nullptr;
+            }
+            blend.BlendOp = D3D12_BLEND_OP_ADD;
+            blend.DestBlend = D3D12_BLEND_INV_SRC1_ALPHA; // S + B * (1 - a)
+            if (FAILED(create_pipeline(format, g_xrfg_hud_readd_alpha_pixel_shader,
+                    sizeof(g_xrfg_hud_readd_alpha_pixel_shader), blend, set.alpha))) {
+                return nullptr;
+            }
+            pipelines.push_back(std::move(set));
+            return &pipelines.back();
+        } catch (...) {
+            return nullptr;
+        }
+    }
+
+    // t0-t2 and the render target of call `call` of slot `slot`.
+    [[nodiscard]] bool bind(ID3D12GraphicsCommandList* list, std::uint32_t slot, std::uint32_t call,
+        ID3D12Resource* image, DXGI_FORMAT srgb_format, ID3D12Resource* emission, ID3D12Resource* classes,
+        ID3D12Resource* target, std::uint32_t slice, const HudImageRect& rect_image, const D3D12_RECT& scissor,
+        D3D12_CPU_DESCRIPTOR_HANDLE* rtv) noexcept {
+        if (slot >= slots || call >= kCallsPerSlot || target == nullptr || emission == nullptr ||
+            classes == nullptr) {
+            return false;
+        }
+        const UINT index = slot * kCallsPerSlot + call;
+        D3D12_CPU_DESCRIPTOR_HANDLE cpu = heap->GetCPUDescriptorHandleForHeapStart();
+        cpu.ptr += static_cast<SIZE_T>(index) * kDescriptorsPerCall * increment;
+        D3D12_GPU_DESCRIPTOR_HANDLE gpu = heap->GetGPUDescriptorHandleForHeapStart();
+        gpu.ptr += static_cast<UINT64>(index) * kDescriptorsPerCall * increment;
+        D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+        view.Format = srgb_format;
+        view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2DARRAY;
+        view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        view.Texture2DArray.MipLevels = 1;
+        view.Texture2DArray.ArraySize = image != nullptr ? image->GetDesc().DepthOrArraySize : 1U;
+        device->CreateShaderResourceView(image, &view, cpu);
+        cpu.ptr += increment;
+        D3D12_SHADER_RESOURCE_VIEW_DESC flat{};
+        flat.Format = DXGI_FORMAT_R16G16B16A16_FLOAT;
+        flat.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        flat.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        flat.Texture2D.MipLevels = 1;
+        device->CreateShaderResourceView(emission, &flat, cpu);
+        cpu.ptr += increment;
+        flat.Format = DXGI_FORMAT_R8_UINT;
+        device->CreateShaderResourceView(classes, &flat, cpu);
+        D3D12_RENDER_TARGET_VIEW_DESC target_view{};
+        target_view.Format = srgb_format;
+        target_view.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2DARRAY;
+        target_view.Texture2DArray.FirstArraySlice = slice;
+        target_view.Texture2DArray.ArraySize = 1;
+        *rtv = rtv_heap->GetCPUDescriptorHandleForHeapStart();
+        rtv->ptr += static_cast<SIZE_T>(index) * rtv_increment;
+        device->CreateRenderTargetView(target, &target_view, *rtv);
+        ID3D12DescriptorHeap* heaps[] = {heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetGraphicsRootSignature(root_signature.Get());
+        list->SetGraphicsRootDescriptorTable(0, gpu);
+        list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+        list->OMSetRenderTargets(1, rtv, FALSE, nullptr);
+        const D3D12_VIEWPORT viewport{static_cast<float>(rect_image.x), static_cast<float>(rect_image.y),
+            static_cast<float>(rect_image.width), static_cast<float>(rect_image.height), 0.0F, 1.0F};
+        list->RSSetViewports(1, &viewport);
+        list->RSSetScissorRects(1, &scissor);
+        return true;
+    }
+};
+
+D3D12HudSymbologyPasses::D3D12HudSymbologyPasses() noexcept = default;
+D3D12HudSymbologyPasses::~D3D12HudSymbologyPasses() = default;
+
+HRESULT D3D12HudSymbologyPasses::initialize(ID3D12Device* device, std::uint32_t slots) noexcept {
+    if (device == nullptr || slots == 0) {
+        return E_INVALIDARG;
+    }
+    try {
+        auto impl = std::make_unique<Impl>();
+        impl->device = device;
+        impl->slots = slots;
+        HRESULT result = impl->create_root_signature();
+        if (FAILED(result)) {
+            return result;
+        }
+        D3D12_DESCRIPTOR_HEAP_DESC description{};
+        description.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        description.NumDescriptors = slots * kCallsPerSlot * kDescriptorsPerCall;
+        description.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        result = device->CreateDescriptorHeap(&description, IID_PPV_ARGS(impl->heap.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        description.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        description.NumDescriptors = slots * kCallsPerSlot;
+        description.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_NONE;
+        result = device->CreateDescriptorHeap(&description, IID_PPV_ARGS(impl->rtv_heap.GetAddressOf()));
+        if (FAILED(result)) {
+            return result;
+        }
+        impl->increment = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        impl->rtv_increment = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_RTV);
+        impl_ = std::move(impl);
+        return S_OK;
+    } catch (...) {
+        return E_OUTOFMEMORY;
+    }
+}
+
+bool D3D12HudSymbologyPasses::record_removal(ID3D12GraphicsCommandList* list, std::uint32_t slot,
+    std::uint32_t call, ID3D12Resource* source, ID3D12Resource* clean, DXGI_FORMAT srgb_format, std::uint32_t slice,
+    const HudImageRect& image, const HudEyeInput& eye, ID3D12Resource* emission, ID3D12Resource* classes) noexcept {
+    if (impl_ == nullptr || list == nullptr || source == nullptr) {
+        return false;
+    }
+    const D3D12_RECT scissor = hud_pass_rect(eye, image);
+    if (scissor.right <= scissor.left || scissor.bottom <= scissor.top) {
+        return true; // nothing to take out
+    }
+    const Impl::Pipelines* pipelines = impl_->pipelines_for(srgb_format);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv{};
+    if (pipelines == nullptr ||
+        !impl_->bind(list, slot, call, source, srgb_format, emission, classes, clean, slice, image, scissor, &rtv)) {
+        return false;
+    }
+    const HudConstants constants = eye_constants(eye, image, slice);
+    list->SetPipelineState(pipelines->remove.Get());
+    list->SetGraphicsRoot32BitConstants(1, kHudConstantCount, &constants, 0);
+    list->DrawInstanced(3, 1, 0, 0);
+    return true;
+}
+
+bool D3D12HudSymbologyPasses::record_readd(ID3D12GraphicsCommandList* list, std::uint32_t slot, std::uint32_t call,
+    ID3D12Resource* destination, DXGI_FORMAT srgb_format, std::uint32_t slice, const HudImageRect& image,
+    const HudEyeInput& eye, ID3D12Resource* emission, ID3D12Resource* classes, ID3D12Resource* clean_source,
+    const HudRotation& rotation, bool alpha_valid) noexcept {
+    if (impl_ == nullptr || list == nullptr || (alpha_valid && clean_source == nullptr)) {
+        return false;
+    }
+    const bool rotate = rotation.enabled && finite4(rotation.target_to_source) &&
+        finite4(rotation.target_tangents) && finite4(rotation.source_tangents) &&
+        rotation.target_tangents[1] != rotation.target_tangents[0] &&
+        rotation.source_tangents[1] != rotation.source_tangents[0] &&
+        rotation.source_tangents[2] != rotation.source_tangents[3];
+    HudRotation used = rotation;
+    used.enabled = rotate;
+    const D3D12_RECT scissor = hud_pass_rect(eye, image, &used);
+    if (scissor.right <= scissor.left || scissor.bottom <= scissor.top) {
+        return true;
+    }
+    const Impl::Pipelines* pipelines = impl_->pipelines_for(srgb_format);
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv{};
+    if (pipelines == nullptr ||
+        !impl_->bind(list, slot, call, alpha_valid ? clean_source : nullptr, srgb_format, emission, classes,
+            destination, slice, image, scissor, &rtv)) {
+        return false;
+    }
+    HudConstants constants = eye_constants(eye, image, slice);
+    if (rotate) {
+        constants.flags |= kFlagRotate;
+        constants.target_to_source = rotation.target_to_source;
+        constants.target_tangents = rotation.target_tangents;
+        constants.source_tangents = rotation.source_tangents;
+    }
+    if (alpha_valid) {
+        constants.flags |= kFlagAlpha;
+        list->SetPipelineState(pipelines->alpha.Get());
+        list->SetGraphicsRoot32BitConstants(1, kHudConstantCount, &constants, 0);
+        list->DrawInstanced(3, 1, 0, 0);
+        return true;
+    }
+    // B + D: the positive part added, then the negative part taken off.
+    list->SetPipelineState(pipelines->add.Get());
+    list->SetGraphicsRoot32BitConstants(1, kHudConstantCount, &constants, 0);
+    list->DrawInstanced(3, 1, 0, 0);
+    constants.flags |= kFlagNegative;
+    list->SetPipelineState(pipelines->subtract.Get());
+    list->SetGraphicsRoot32BitConstants(1, kHudConstantCount, &constants, 0);
+    list->DrawInstanced(3, 1, 0, 0);
+    return true;
+}
+
+}  // namespace xrfg
diff --git a/src/d3d12/hud_symbology.hlsl b/src/d3d12/hud_symbology.hlsl
new file mode 100644
--- /dev/null
+++ b/src/d3d12/hud_symbology.hlsl
@@ -0,0 +1,239 @@
+// DCS Control (0049): the HUD / helmet symbology's passes (xrfg/hud_symbology.hpp,
+// contract xrfg/dcsvr_symbology.h, R89 v1).
+//
+// A real frame's symbology is, per HMD view, the linear delta E it added to
+// the view (an RGBA16F window of an atlas: rgb E, a its coverage when
+// alpha_valid) and the class of each texel (R8_UINT: 1 collimated HUD, 2
+// helmet, anything else never touched). The layer sees Quad Views' stereo
+// eye images, so an eye pixel's delta is composed as Quad Views composes the
+// views (layer order pupil_shift, quad_views, OFXR):
+//     D(uv) = a_f * E_focus(focus uv) + (1 - a_f) * E_periphery(uv)
+// the periphery 1:1 over the eye image (uv the eye image's own, 0..1), the
+// focus view inside FocusRect (normalised eye coordinates), a_f Quad Views'
+// edge blend (dcsvr_symbology::focus_weight, ProjectionPS.hlsl). Each view's
+// E is read bilinearly at the view pixel the eye pixel maps to (as Quad Views
+// samples the view), texels outside the window or of another class as 0.
+//
+// HudRemovePS: P - D into the clean copy of a real frame (P the frame, read
+// through an sRGB view: linear), only where D is not 0 (elsewhere the copy
+// keeps the frame's own bytes). HudReaddPS / HudReaddAlphaPS: the nearest
+// real frame's D back into the synthetic B, collimated symbology (class 1)
+// carried by the head rotation between that frame and the synthetic's camera
+// at infinity (TargetToSource, the composition's own mapping), helmet
+// symbology (class 2) where it was. Without coverage the delta is added:
+// B + D, as two draws (the positive part added, the negative part taken off:
+// a UNORM target clamps a negative source), blended in linear by the sRGB
+// target. With coverage (alpha_valid): S = D + a * pre (pre the frame's clean
+// copy at the symbol's source pixel), out = B * (1 - a) + S, one draw with
+// dual-source blending (ONE, INV_SRC1_ALPHA). Never a cross-fade of two frames.
+//
+// Root signature: t0-t2 (a table), these 40 constants at b0.
+
+Texture2DArray<float4> Image : register(t0);
+Texture2D<float4> Emission : register(t1);
+Texture2D<uint> Classes : register(t2);
+
+cbuffer HudParameters : register(b0) {
+    // The eye image's rectangle in its texture: x, y, width, height (pixels).
+    float4 EyeRect;
+    // Each view: atlas x, y, window x, y; window width, height, output
+    // width, height (dcsvr_symbology::EmissionView).
+    uint4 PeripheryAtlas;
+    uint4 PeripheryWindow;
+    uint4 FocusAtlas;
+    uint4 FocusWindow;
+    // u0, v0, u1, v1 of the focus view in the eye image.
+    float4 FocusRect;
+    // The re-add's rotation: target to source (x y z w), the target's and
+    // the source frame's tangents (left, right, up, down).
+    float4 TargetToSource;
+    float4 TargetTangents;
+    float4 SourceTangents;
+    float FocusSmoothing;
+    float FocusShape;
+    // Bit 0 the periphery present, 1 the focus present, 2 rotate class 1,
+    // 3 the negative part (HudReaddPS), 4 coverage valid.
+    uint Flags;
+    uint Slice;
+};
+
+struct HudVertex {
+    float4 position : SV_Position;
+};
+
+HudVertex HudFullscreenVS(uint id : SV_VertexID) {
+    HudVertex output;
+    const float2 corner = float2((id << 1) & 2, id & 2);
+    output.position = float4(corner * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+    return output;
+}
+
+float hud_smooth_step(float a, float b, float x) {
+    const float t = saturate((x - a) / (b - a));
+    return t * t * (3.0 - 2.0 * t);
+}
+
+float hud_pow_pos(float b, float e) {
+    return b <= 0.0 ? 0.0 : pow(b, e);
+}
+
+// dcsvr_symbology::focus_weight at focus uv `f`.
+float focus_weight(float2 f) {
+    const float nx = 2.0 * f.x - 1.0;
+    const float ny = 1.0 - 2.0 * f.y;
+    const float ax = abs(nx);
+    const float ay = abs(ny);
+    const float s = FocusSmoothing;
+    const float k = FocusShape;
+    float weight = 0.0;
+    if (ax < 1.0 && ay < 1.0) {
+        if (k >= 1.0) {
+            const float rr = hud_pow_pos(hud_pow_pos(ax, k) + hud_pow_pos(ay, k), 1.0 / k);
+            const float w = clamp(2.0 * s, 0.01, 0.95);
+            weight = rr < 1.0 ? 1.0 - hud_smooth_step(1.0 - w, 1.0, rr) : 0.0;
+        } else if (s > 0.0) {
+            const float tx = hud_smooth_step(0.0, s, f.x) - hud_smooth_step(1.0 - s, 1.0, f.x);
+            const float ty = hud_smooth_step(0.0, s, f.y) - hud_smooth_step(1.0 - s, 1.0, f.y);
+            weight = max(tx * ty, 0.5);
+        } else {
+            weight = 1.0;
+        }
+    }
+    return weight;
+}
+
+// One view's E at its uv (0..1 over the view's output image), bilinear over
+// its window, only texels of a class in `class_bits` (bit c: class c).
+float4 view_emission(uint4 atlas, uint4 window, float2 uv, uint class_bits) {
+    const float2 position = uv * float2(window.zw) - 0.5;
+    const float2 base = floor(position);
+    const float2 fraction = position - base;
+    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
+    [unroll] for (uint j = 0; j < 2; ++j) {
+        [unroll] for (uint i = 0; i < 2; ++i) {
+            const int2 local = int2(base) + int2(i, j) - int2(atlas.zw);
+            if (all(local >= 0) && all(local < int2(window.xy))) {
+                const int3 texel = int3(uint2(local) + atlas.xy, 0);
+                const uint value = Classes.Load(texel);
+                if (value < 32u && ((class_bits >> value) & 1u) != 0u) {
+                    const float weight = (i != 0u ? fraction.x : 1.0 - fraction.x) *
+                        (j != 0u ? fraction.y : 1.0 - fraction.y);
+                    sum += weight * Emission.Load(texel);
+                }
+            }
+        }
+    }
+    return sum;
+}
+
+// The eye's composed delta at eye uv `uv` (rgb D, a the coverage).
+float4 eye_emission(float2 uv, uint class_bits) {
+    float4 periphery = float4(0.0, 0.0, 0.0, 0.0);
+    if ((Flags & 1u) != 0u) {
+        periphery = view_emission(PeripheryAtlas, PeripheryWindow, uv, class_bits);
+    }
+    const float2 focus_uv = (uv - FocusRect.xy) / (FocusRect.zw - FocusRect.xy);
+    const float weight = focus_weight(focus_uv);
+    float4 focus = float4(0.0, 0.0, 0.0, 0.0);
+    if ((Flags & 2u) != 0u && weight > 0.0) {
+        focus = view_emission(FocusAtlas, FocusWindow, focus_uv, class_bits);
+    }
+    return weight * focus + (1.0 - weight) * periphery;
+}
+
+float2 eye_uv(float4 position) {
+    return (position.xy - EyeRect.xy) / EyeRect.zw;
+}
+
+float3 rotate_by_quaternion(float4 quaternion, float3 input_vector) {
+    return input_vector + 2.0 * cross(
+        quaternion.xyz,
+        cross(quaternion.xyz, input_vector) + quaternion.w * input_vector);
+}
+
+// The source frame's eye uv that shows the target uv's direction (the head
+// rotation at infinity); false behind the source camera.
+bool rotated_uv(float2 uv, out float2 source) {
+    const float2 tangent = float2(
+        lerp(TargetTangents.x, TargetTangents.y, uv.x),
+        lerp(TargetTangents.z, TargetTangents.w, uv.y));
+    const float3 ray = rotate_by_quaternion(TargetToSource, float3(tangent, -1.0));
+    const bool ahead = ray.z < -1.0e-5;
+    const float2 s = ray.xy / (ahead ? -ray.z : 1.0);
+    source = ahead
+        ? float2((s.x - SourceTangents.x) / (SourceTangents.y - SourceTangents.x),
+              (SourceTangents.z - s.y) / (SourceTangents.z - SourceTangents.w))
+        : float2(-1.0, -1.0);
+    return ahead;
+}
+
+float4 HudRemovePS(HudVertex input) : SV_Target {
+    const float4 delta = eye_emission(eye_uv(input.position), 6u);
+    if (all(delta.rgb == 0.0)) {
+        discard;
+    }
+    const float4 frame = Image.Load(int4(int2(input.position.xy), int(Slice), 0));
+    return float4(saturate(frame.rgb - delta.rgb), frame.a);
+}
+
+// The collimated part (class 1, at `collimated_uv`) and the helmet part
+// (class 2, at the pixel itself).
+void readd_parts(float2 uv, out float4 collimated, out float2 collimated_uv, out float4 helmet) {
+    collimated = float4(0.0, 0.0, 0.0, 0.0);
+    collimated_uv = uv;
+    // (HLSL's || evaluates both sides: the rotation only when asked for.)
+    bool visible = true;
+    [branch] if ((Flags & 4u) != 0u) {
+        visible = rotated_uv(uv, collimated_uv);
+    }
+    if (visible) {
+        collimated = eye_emission(collimated_uv, 2u);
+    }
+    helmet = eye_emission(uv, 4u);
+}
+
+float4 HudReaddPS(HudVertex input) : SV_Target {
+    const float2 uv = eye_uv(input.position);
+    float4 collimated;
+    float2 collimated_uv;
+    float4 helmet;
+    readd_parts(uv, collimated, collimated_uv, helmet);
+    const float3 delta = collimated.rgb + helmet.rgb;
+    const float3 part = (Flags & 8u) != 0u ? max(-delta, 0.0) : max(delta, 0.0);
+    if (all(part == 0.0)) {
+        discard;
+    }
+    return float4(part, 0.0);
+}
+
+// The clean copy of the frame the symbology came from at its eye uv.
+float3 clean_at(float2 uv) {
+    const int2 pixel = int2(floor(EyeRect.xy + saturate(uv) * EyeRect.zw));
+    const int2 last = int2(EyeRect.xy + EyeRect.zw) - 1;
+    return Image.Load(int4(clamp(pixel, int2(EyeRect.xy), last), int(Slice), 0)).rgb;
+}
+
+struct HudAlphaOutput {
+    float4 colour : SV_Target0;
+    float4 coverage : SV_Target1;
+};
+
+HudAlphaOutput HudReaddAlphaPS(HudVertex input) {
+    const float2 uv = eye_uv(input.position);
+    float4 collimated;
+    float2 collimated_uv;
+    float4 helmet;
+    readd_parts(uv, collimated, collimated_uv, helmet);
+    const float collimated_alpha = saturate(collimated.a);
+    const float helmet_alpha = saturate(helmet.a);
+    const float coverage = saturate(collimated_alpha + helmet_alpha);
+    if (coverage <= 0.0 && all(collimated.rgb + helmet.rgb == 0.0)) {
+        discard;
+    }
+    float3 symbol = max(collimated.rgb + collimated_alpha * clean_at(collimated_uv), 0.0);
+    symbol += max(helmet.rgb + helmet_alpha * clean_at(uv), 0.0);
+    HudAlphaOutput output;
+    output.colour = float4(symbol, 0.0);
+    output.coverage = float4(0.0, 0.0, 0.0, coverage);
+    return output;
+}
