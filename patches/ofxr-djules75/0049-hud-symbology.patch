+// k/N: the nearest real frame.
+void test_hud_nearest_frame() {
+    require(!xrfg::hud_readd_from_current(0.0F) && !xrfg::hud_readd_from_current(0.49F) &&
+            xrfg::hud_readd_from_current(0.5F) && xrfg::hud_readd_from_current(0.51F) &&
+            !xrfg::hud_readd_from_current(1.0F / 3.0F) && xrfg::hud_readd_from_current(2.0F / 3.0F) &&
+            xrfg::hud_readd_from_current(1.0F),
+        "hud: k/N < 0.5 the older frame, else the newer");
+    std::cout << "hud symbology: the nearest frame by k/N (2X 1/2 newer; 3X 1/3 older, 2/3 newer)\n";
+}
