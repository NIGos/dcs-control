+[[nodiscard]] bool finite4(const std::array<float, 4>& values) noexcept {
+    return std::isfinite(values[0]) && std::isfinite(values[1]) && std::isfinite(values[2]) &&
+        std::isfinite(values[3]);
+}
+
+[[nodiscard]] std::array<float, 3> rotate(const std::array<float, 4>& q, const std::array<float, 3>& v) noexcept {
+    // v + 2 * cross(q.xyz, cross(q.xyz, v) + w * v), as the shader.
+    const std::array<float, 3> c1{q[1] * v[2] - q[2] * v[1] + q[3] * v[0], q[2] * v[0] - q[0] * v[2] + q[3] * v[1],
+        q[0] * v[1] - q[1] * v[0] + q[3] * v[2]};
+    return {v[0] + 2.0F * (q[1] * c1[2] - q[2] * c1[1]), v[1] + 2.0F * (q[2] * c1[0] - q[0] * c1[2]),
+        v[2] + 2.0F * (q[0] * c1[1] - q[1] * c1[0])};
+}
+
+// Tangents (left, right, up, down) to uv and back.
+[[nodiscard]] std::array<float, 2> uv_to_tangent(const std::array<float, 4>& t, float u, float v) noexcept {
+    return {t[0] + (t[1] - t[0]) * u, t[2] + (t[3] - t[2]) * v};
+}
+[[nodiscard]] std::array<float, 2> tangent_to_uv(const std::array<float, 4>& t, float x, float y) noexcept {
+    return {(x - t[0]) / (t[1] - t[0]), (t[2] - y) / (t[2] - t[3])};
+}
+
+// `from`'s uv into `to`'s through `q` (false behind).
+[[nodiscard]] bool map_uv(const std::array<float, 4>& q, const std::array<float, 4>& from,
+    const std::array<float, 4>& to, float u, float v, float& out_u, float& out_v) noexcept {
+    const auto tangent = uv_to_tangent(from, u, v);
+    const auto ray = rotate(q, {tangent[0], tangent[1], -1.0F});
+    if (!(ray[2] < -1.0e-5F)) {
+        return false;
+    }
+    const auto uv = tangent_to_uv(to, ray[0] / -ray[2], ray[1] / -ray[2]);
+    out_u = uv[0];
+    out_v = uv[1];
+    return std::isfinite(out_u) && std::isfinite(out_v);
+}
+
+// The eye uv range a view's window covers: [u0, u1] x [v0, v1].
+struct UvBox {
+    float u0{1.0e9F};
+    float v0{1.0e9F};
+    float u1{-1.0e9F};
+    float v1{-1.0e9F};
+    void add(float u, float v) noexcept {
+        u0 = std::min(u0, u);
+        v0 = std::min(v0, v);
+        u1 = std::max(u1, u);
+        v1 = std::max(v1, v);
+    }
+    [[nodiscard]] bool empty() const noexcept { return !(u1 >= u0 && v1 >= v0); }
+};
