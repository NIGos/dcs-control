+// One eye image of the passes' tests, its symbology and the D3D12 textures.
+struct HudScene {
+    UINT width{};
+    UINT height{};
+    std::vector<std::uint8_t> frame;     // P, RGBA8 sRGB bytes
+    std::vector<std::uint8_t> emission;  // RGBA16F atlas
+    std::vector<std::uint8_t> classes;   // R8 atlas
+    UINT atlas_width{};
+    UINT atlas_height{};
+    xrfg::HudEyeInput eye{};
+};
+
+struct HudTextures {
+    ComPtr<ID3D12Resource> source;
+    ComPtr<ID3D12Resource> clean;
+    ComPtr<ID3D12Resource> destination;
+    ComPtr<ID3D12Resource> emission;
+    ComPtr<ID3D12Resource> classes;
+};
+
+HudTextures hud_textures(Gpu& gpu, const HudScene& scene) {
+    HudTextures out;
+    const auto image = [&] {
+        return hud_texture(gpu, scene.width, scene.height, DXGI_FORMAT_R8G8B8A8_TYPELESS, 1,
+            D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET);
+    };
+    out.source = image();
+    out.clean = image();
+    out.destination = image();
+    out.emission = hud_texture(gpu, scene.atlas_width, scene.atlas_height, DXGI_FORMAT_R16G16B16A16_FLOAT);
+    out.classes = hud_texture(gpu, scene.atlas_width, scene.atlas_height, DXGI_FORMAT_R8_UINT);
+    hud_upload(gpu, out.source.Get(), scene.frame, scene.width * 4U);
+    hud_upload(gpu, out.clean.Get(), scene.frame, scene.width * 4U);
+    hud_upload(gpu, out.emission.Get(), scene.emission, scene.atlas_width * 8U);
+    hud_upload(gpu, out.classes.Get(), scene.classes, scene.atlas_width);
+    return out;
+}
+
+void hud_record_removal(Gpu& gpu, xrfg::D3D12HudSymbologyPasses& passes, const HudScene& scene, HudTextures& t) {
+    hud_run(gpu, [&](ID3D12GraphicsCommandList* list) {
+        const std::array<D3D12_RESOURCE_BARRIER, 2> before{
+            hud_transition(t.source.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE),
+            hud_transition(t.clean.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_RENDER_TARGET)};
+        list->ResourceBarrier(2, before.data());
+        require(passes.record_removal(list, 0, 0, t.source.Get(), t.clean.Get(), DXGI_FORMAT_R8G8B8A8_UNORM_SRGB, 0,
+                    {0, 0, scene.width, scene.height}, scene.eye, t.emission.Get(), t.classes.Get()),
+            "hud: removal recorded");
+        const std::array<D3D12_RESOURCE_BARRIER, 2> after{
+            hud_transition(t.source.Get(), D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON),
+            hud_transition(t.clean.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COMMON)};
+        list->ResourceBarrier(2, after.data());
+    });
+}
+
+void hud_record_readd(Gpu& gpu, xrfg::D3D12HudSymbologyPasses& passes, const HudScene& scene, HudTextures& t,
+    const xrfg::HudRotation& rotation, bool alpha_valid) {
+    hud_run(gpu, [&](ID3D12GraphicsCommandList* list) {
+        const std::array<D3D12_RESOURCE_BARRIER, 2> before{
+            hud_transition(t.clean.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE),
+            hud_transition(t.destination.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_RENDER_TARGET)};
+        list->ResourceBarrier(2, before.data());
+        require(passes.record_readd(list, 0, 4, t.destination.Get(), DXGI_FORMAT_R8G8B8A8_UNORM_SRGB, 0,
+                    {0, 0, scene.width, scene.height}, scene.eye, t.emission.Get(), t.classes.Get(), t.clean.Get(),
+                    rotation, alpha_valid),
+            "hud: re-add recorded");
+        const std::array<D3D12_RESOURCE_BARRIER, 2> after{
+            hud_transition(t.clean.Get(), D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COMMON),
+            hud_transition(t.destination.Get(), D3D12_RESOURCE_STATE_RENDER_TARGET, D3D12_RESOURCE_STATE_COMMON)};
+        list->ResourceBarrier(2, after.data());
+    });
+}
+
+// A scene of `width` x `height` with one periphery view 1:1 over it (atlas the
+// view's size, window (wx, wy, ww, wh)), the focus outside the window. Each
+// window texel has class (x + y) % 4: 0 nothing, 1 collimated, 2 helmet,
+// 3 (reserved: never touched) a symbol all the same. A symbol is colour c
+// over the background C at coverage a: F = (1 - a) C + a c, E = F - C (signed),
+// E.a = a. `background` gives C's bytes at (x, y).
+struct HudSymbolModel {
+    std::vector<float> coverage;               // per pixel, 0 none
+    std::vector<std::array<float, 3>> colour;  // c, linear
+    std::vector<std::uint8_t> pixel_class;
+};
+
+HudScene hud_symbol_scene(UINT width, UINT height, std::array<UINT, 4> window,
+    const std::function<std::array<std::uint8_t, 3>(UINT, UINT)>& background, HudSymbolModel& model) {
+    HudScene scene;
+    scene.width = width;
+    scene.height = height;
+    scene.atlas_width = width;
+    scene.atlas_height = height;
+    scene.frame.assign(static_cast<std::size_t>(width) * height * 4U, 255);
+    scene.emission.assign(static_cast<std::size_t>(width) * height * 8U, 0);
+    scene.classes.assign(static_cast<std::size_t>(width) * height, 0);
+    model.coverage.assign(static_cast<std::size_t>(width) * height, 0.0F);
+    model.colour.assign(static_cast<std::size_t>(width) * height, {});
+    model.pixel_class.assign(static_cast<std::size_t>(width) * height, 0);
+    HudRandom random;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * width + x;
+            const auto c = background(x, y);
+            std::array<float, 3> f{hud_decode(c[0]), hud_decode(c[1]), hud_decode(c[2])};
+            const bool in = x >= window[0] && x < window[0] + window[2] && y >= window[1] && y < window[1] + window[3];
+            const std::uint8_t klass = in ? static_cast<std::uint8_t>((x + y) % 4U) : 0U;
+            if (klass != 0) {
+                // A HUD symbol: bright, mostly green, partly covering.
+                const float a = 0.3F + 0.7F * random.next();
+                const std::array<float, 3> symbol{0.3F + 0.4F * random.next(), 0.6F + 0.4F * random.next(),
+                    0.3F + 0.4F * random.next()};
+                std::array<float, 4> e{};
+                for (int ch = 0; ch < 3; ++ch) {
+                    const float mixed = (1.0F - a) * f[ch] + a * symbol[ch];
+                    e[ch] = mixed - f[ch];
+                    f[ch] = mixed;
+                }
+                e[3] = a;
+                for (int ch = 0; ch < 4; ++ch) {
+                    const std::uint16_t half = hud_half(e[ch]);
+                    std::memcpy(&scene.emission[at * 8U + ch * 2U], &half, 2);
+                }
+                model.coverage[at] = a;
+                model.colour[at] = symbol;
+            }
+            scene.classes[at] = klass;
+            model.pixel_class[at] = klass;
+            for (int ch = 0; ch < 3; ++ch) {
+                scene.frame[at * 4U + ch] = hud_encode(f[ch]);
+            }
+        }
+    }
+    xrfg::D3D12HudSymbologyView view{};
+    view.present = true;
+    view.out_width = width;
+    view.out_height = height;
+    view.window_x = window[0];
+    view.window_y = window[1];
+    view.window_width = window[2];
+    view.window_height = window[3];
+    view.x = window[0];
+    view.y = window[1];
+    scene.eye.periphery = view;
+    scene.eye.focus_rect = {0.92F, 0.92F, 0.98F, 0.98F};
+    return scene;
+}
+
+std::array<std::uint8_t, 3> hud_noise_background(UINT x, UINT y) {
+    std::uint32_t h = x * 0x8da6b343U ^ y * 0xd8163841U;
+    h ^= h >> 13;
+    h *= 0x5bd1e995U;
+    h ^= h >> 15;
+    return {static_cast<std::uint8_t>(20 + (h & 0x7fU)), static_cast<std::uint8_t>(30 + ((h >> 8) & 0x7fU)),
+        static_cast<std::uint8_t>(10 + ((h >> 16) & 0x7fU))};
+}
+
+int hud_max_difference(const std::vector<std::uint8_t>& a, const std::vector<std::uint8_t>& b,
+    const std::function<bool(std::size_t)>& where = {}) {
+    int worst = 0;
+    for (std::size_t pixel = 0; pixel * 4U < a.size(); ++pixel) {
+        if (where && !where(pixel)) {
+            continue;
+        }
+        for (std::size_t ch = 0; ch < 3; ++ch) {
+            worst = std::max(worst, std::abs(int(a[pixel * 4U + ch]) - int(b[pixel * 4U + ch])));
+        }
+    }
+    return worst;
+}
+
+// Removal then re-add over the same background: the frame back within a
+// code, with and without coverage alpha; class 3 and every pixel outside the
+// symbology never touched; present = 0: nothing at all.
+void test_hud_removal_readd(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 64, height = 48;
+    HudSymbolModel model;
+    const HudScene scene = hud_symbol_scene(width, height, {8, 6, 40, 30}, hud_noise_background, model);
+    HudTextures t = hud_textures(gpu, scene);
+    hud_record_removal(gpu, passes, scene, t);
+    const auto clean = hud_readback(gpu, t.clean.Get(), width * 4U);
+    // The clean frame: the background under classes 1 and 2 (in linear, the
+    // frame's own quantization), everything else the frame's bytes as they were.
+    float worst_linear = 0.0F;
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * width + x;
+            const std::uint8_t klass = model.pixel_class[at];
+            if (klass == 1 || klass == 2) {
+                const auto c = hud_noise_background(x, y);
+                for (int ch = 0; ch < 3; ++ch) {
+                    worst_linear = std::max(worst_linear, std::abs(hud_decode(clean[at * 4U + ch]) - hud_decode(c[ch])));
+                }
+            } else {
+                require(std::memcmp(&clean[at * 4U], &scene.frame[at * 4U], 4) == 0,
+                    "hud removal: a pixel without class 1 or 2 changed (class " + std::to_string(klass) + ")");
+            }
+        }
+    }
+    require(worst_linear < 0.006F, "hud removal: the background under the symbols (linear error " +
+            std::to_string(worst_linear) + ")");
+    // Re-add over the clean frame itself: the frame back.
+    for (const bool alpha : {false, true}) {
+        hud_upload(gpu, t.destination.Get(), clean, width * 4U);
+        hud_record_readd(gpu, passes, scene, t, xrfg::HudRotation{}, alpha);
+        const auto back = hud_readback(gpu, t.destination.Get(), width * 4U);
+        const int worst = hud_max_difference(back, scene.frame);
+        if (worst > 1) {
+            int shown = 0;
+            for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(width) * height && shown < 8; ++pixel) {
+                for (std::size_t ch = 0; ch < 3; ++ch) {
+                    if (std::abs(int(back[pixel * 4U + ch]) - int(scene.frame[pixel * 4U + ch])) > 1) {
+                        std::cout << "  pixel " << pixel % width << "," << pixel / width << " ch " << ch << " class "
+                                  << int(model.pixel_class[pixel]) << ": out " << int(back[pixel * 4U + ch])
+                                  << " frame " << int(scene.frame[pixel * 4U + ch]) << " clean "
+                                  << int(clean[pixel * 4U + ch]) << "\n";
+                        ++shown;
+                        break;
+                    }
+                }
+            }
+        }
+        std::cout << "hud symbology: removal then re-add (" << (alpha ? "coverage alpha" : "additive")
+                  << "), worst " << worst << " code(s)\n";
+        require(worst <= 1, "hud: removal then re-add does not give the frame back within a code");
+    }
+    // present = 0: the passes touch nothing.
+    HudScene absent = scene;
+    absent.eye.periphery.present = false;
+    HudTextures u = hud_textures(gpu, absent);
+    hud_record_removal(gpu, passes, absent, u);
+    require(hud_readback(gpu, u.clean.Get(), width * 4U) == scene.frame, "hud: present = 0 changes the frame");
+    hud_upload(gpu, u.destination.Get(), scene.frame, width * 4U);
+    hud_record_readd(gpu, passes, absent, u, xrfg::HudRotation{}, false);
+    require(hud_readback(gpu, u.destination.Get(), width * 4U) == scene.frame, "hud: present = 0 re-adds something");
+    const xrfg::HudImageRect rect{0, 0, width, height};
+    const D3D12_RECT none = xrfg::hud_pass_rect(absent.eye, rect);
+    require(none.right <= none.left, "hud: present = 0 has no pass rect");
+    std::cout << "hud symbology: classes 1 and 2 only, the rest and present = 0 untouched\n";
+}
+
+// Re-add over a background shifted by 4 px (the synthetic's world moved):
+// with coverage alpha the true composite within 2 codes; the additive delta
+// within 2 codes of B + D, off the truth by a * |C' - C| where the world
+// differs.
+void test_hud_shifted_background(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 64, height = 48;
+    HudSymbolModel model;
+    const HudScene scene = hud_symbol_scene(width, height, {8, 6, 40, 30}, hud_noise_background, model);
+    HudTextures t = hud_textures(gpu, scene);
+    hud_record_removal(gpu, passes, scene, t);
+    const auto clean = hud_readback(gpu, t.clean.Get(), width * 4U);
+    std::vector<std::uint8_t> shifted(scene.frame.size(), 255);
+    std::vector<std::uint8_t> truth(scene.frame.size(), 255);
+    std::vector<std::uint8_t> additive_expected(scene.frame.size(), 255);
+    for (UINT y = 0; y < height; ++y) {
+        for (UINT x = 0; x < width; ++x) {
+            const std::size_t at = static_cast<std::size_t>(y) * width + x;
+            const auto moved = hud_noise_background(x + 4U, y);
+            const auto here = hud_noise_background(x, y);
+            const bool symbol = model.pixel_class[at] == 1 || model.pixel_class[at] == 2;
+            const float a = symbol ? model.coverage[at] : 0.0F;
+            for (int ch = 0; ch < 3; ++ch) {
+                shifted[at * 4U + ch] = moved[ch];
+                const float c_new = hud_decode(moved[ch]);
+                const float symbol_colour = symbol ? model.colour[at][ch] : 0.0F;
+                truth[at * 4U + ch] = hud_encode((1.0F - a) * c_new + a * symbol_colour);
+                const float delta = symbol ? a * (symbol_colour - hud_decode(here[ch])) : 0.0F;
+                additive_expected[at * 4U + ch] = hud_encode(c_new + delta);
+            }
+        }
+    }
+    int alpha_worst = 0, additive_worst = 0, additive_model = 0;
+    for (const bool alpha : {false, true}) {
+        hud_upload(gpu, t.destination.Get(), shifted, width * 4U);
+        hud_record_readd(gpu, passes, scene, t, xrfg::HudRotation{}, alpha);
+        const auto out = hud_readback(gpu, t.destination.Get(), width * 4U);
+        if (alpha) {
+            alpha_worst = hud_max_difference(out, truth);
+        } else {
+            additive_worst = hud_max_difference(out, truth);
+            additive_model = hud_max_difference(out, additive_expected);
+        }
+    }
+    std::cout << "hud symbology: re-add over a world shifted 4 px: coverage alpha worst " << alpha_worst
+              << " code(s) from the true composite, additive worst " << additive_worst << " (" << additive_model
+              << " from B + D)\n";
+    require(alpha_worst <= 2, "hud: with coverage alpha the re-add is not the true composite within 2 codes");
+    require(additive_model <= 2, "hud: the additive re-add is not B + D within 2 codes");
+    require(additive_worst > alpha_worst, "hud: the additive re-add over a moved world should be the worse one");
+    static_cast<void>(clean);
+}
+
+// The focus view's mapping and Quad Views' edge blend: the removal of a
+// constant periphery delta and a constant focus delta from a constant frame,
+// against focus_rect() / focus_weight() and the views' bilinear windows on
+// the CPU, rectangular and round focus shapes.
+void test_hud_focus_mapping(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 96, height = 64;
+    constexpr UINT focus_size = 64;
+    const float eye_tan[4]{-1.0F, 1.0F, 0.75F, -0.75F};
+    const float focus_tan[4]{-0.45F, 0.25F, 0.35F, -0.2F};
+    float rect[4]{};
+    require(csy::focus_rect(eye_tan, focus_tan, rect), "hud focus: focus_rect");
+    const float frame_linear = 0.8F;
+    const std::array<float, 3> periphery_e{0.1F, 0.05F, 0.02F};
+    const std::array<float, 3> focus_e{0.3F, 0.2F, 0.1F};
+    for (const auto& [smoothing, shape] : {std::pair{0.2F, 0.0F}, std::pair{0.1F, 2.0F}}) {
+        HudScene scene;
+        scene.width = width;
+        scene.height = height;
+        scene.atlas_width = width + focus_size;
+        scene.atlas_height = std::max(height, focus_size);
+        scene.frame.assign(static_cast<std::size_t>(width) * height * 4U, 255);
+        for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(width) * height; ++pixel) {
+            scene.frame[pixel * 4U] = scene.frame[pixel * 4U + 1U] = scene.frame[pixel * 4U + 2U] =
+                hud_encode(frame_linear);
+        }
+        scene.emission.assign(static_cast<std::size_t>(scene.atlas_width) * scene.atlas_height * 8U, 0);
+        scene.classes.assign(static_cast<std::size_t>(scene.atlas_width) * scene.atlas_height, 0);
+        for (UINT y = 0; y < scene.atlas_height; ++y) {
+            for (UINT x = 0; x < scene.atlas_width; ++x) {
+                const bool periphery = x < width && y < height;
+                const bool focus = x >= width && y < focus_size;
+                if (!periphery && !focus) {
+                    continue;
+                }
+                const std::size_t at = static_cast<std::size_t>(y) * scene.atlas_width + x;
+                const auto& e = periphery ? periphery_e : focus_e;
+                for (int ch = 0; ch < 3; ++ch) {
+                    const std::uint16_t half = hud_half(e[ch]);
+                    std::memcpy(&scene.emission[at * 8U + ch * 2U], &half, 2);
+                }
+                scene.classes[at] = periphery ? 1U : 2U;
+            }
+        }
+        scene.eye.periphery = {true, 0, 0, width, height, 0, 0, width, height, 0};
+        scene.eye.focus = {true, width, 0, focus_size, focus_size, 0, 0, focus_size, focus_size, 0};
+        scene.eye.focus_rect = {rect[0], rect[1], rect[2], rect[3]};
+        scene.eye.focus_smoothing = smoothing;
+        scene.eye.focus_shape = shape;
+        HudTextures t = hud_textures(gpu, scene);
+        hud_record_removal(gpu, passes, scene, t);
+        const auto clean = hud_readback(gpu, t.clean.Get(), width * 4U);
+        csy::QvSettings qv{};
+        qv.smoothenFocusViewEdges = smoothing;
+        qv.focusViewShape = shape;
+        // The focus view's bilinear read, texels outside its window 0.
+        const auto focus_coverage = [&](float fu, float fv) {
+            const float px = fu * focus_size - 0.5F, py = fv * focus_size - 0.5F;
+            const float bx = std::floor(px), by = std::floor(py);
+            float sum = 0.0F;
+            for (int j = 0; j < 2; ++j) {
+                for (int i = 0; i < 2; ++i) {
+                    const float qx = bx + static_cast<float>(i), qy = by + static_cast<float>(j);
+                    if (qx < 0.0F || qy < 0.0F || qx >= static_cast<float>(focus_size) ||
+                        qy >= static_cast<float>(focus_size)) {
+                        continue;
+                    }
+                    sum += (i != 0 ? px - bx : 1.0F - (px - bx)) * (j != 0 ? py - by : 1.0F - (py - by));
+                }
+            }
+            return sum;
+        };
+        int worst = 0;
+        std::size_t blended = 0;
+        for (UINT y = 0; y < height; ++y) {
+            for (UINT x = 0; x < width; ++x) {
+                const float u = (static_cast<float>(x) + 0.5F) / width, v = (static_cast<float>(y) + 0.5F) / height;
+                const float fu = (u - rect[0]) / (rect[2] - rect[0]), fv = (v - rect[1]) / (rect[3] - rect[1]);
+                const float a = csy::focus_weight(qv, fu, fv);
+                const float inside = a > 0.0F ? focus_coverage(fu, fv) : 0.0F;
+                blended += a > 0.0F && a < 1.0F ? 1U : 0U;
+                for (int ch = 0; ch < 3; ++ch) {
+                    const float d = a * inside * focus_e[ch] + (1.0F - a) * periphery_e[ch];
+                    const std::uint8_t expected = hud_encode(hud_decode(hud_encode(frame_linear)) - d);
+                    worst = std::max(worst,
+                        std::abs(int(clean[(static_cast<std::size_t>(y) * width + x) * 4U + ch]) - int(expected)));
+                }
+            }
+        }
+        std::cout << "hud symbology: focus mapping (smoothing " << smoothing << ", shape " << shape
+                  << "): worst " << worst << " code(s) against focus_rect() / focus_weight(), " << blended
+                  << " pixels in the edge blend\n";
+        require(blended > 0, "hud focus: the edge blend is not exercised");
+        require(worst <= 1, "hud focus: the composed delta is not Quad Views' composition");
+    }
+}
+
+// The collimated symbology carried by the head rotation at infinity: a yaw of
+// 20 deg/s over a 30 fps frame (0.667 deg) moves a class 1 dot by
+// f * tan(0.667 deg) (2.98 px at 256 px per unit of tangent) and leaves a
+// class 2 dot where it was.
+void test_hud_collimated_rotation(Gpu& gpu) {
+    xrfg::D3D12HudSymbologyPasses passes;
+    require_hresult(passes.initialize(gpu.device.Get(), 1), "hud passes initialize");
+    constexpr UINT width = 512, height = 256;
+    HudScene scene;
+    scene.width = width;
+    scene.height = height;
+    scene.atlas_width = width;
+    scene.atlas_height = height;
+    scene.frame.assign(static_cast<std::size_t>(width) * height * 4U, 0);
+    for (std::size_t pixel = 0; pixel < static_cast<std::size_t>(width) * height; ++pixel) {
+        scene.frame[pixel * 4U + 3U] = 255;
+    }
+    scene.emission.assign(static_cast<std::size_t>(width) * height * 8U, 0);
+    scene.classes.assign(static_cast<std::size_t>(width) * height, 0);
+    const auto dot = [&](UINT cx, UINT cy, std::uint8_t klass) {
+        for (UINT y = cy - 2; y <= cy + 2; ++y) {
+            for (UINT x = cx - 2; x <= cx + 2; ++x) {
+                const std::size_t at = static_cast<std::size_t>(y) * width + x;
+                const std::uint16_t half = hud_half(0.5F);
+                std::memcpy(&scene.emission[at * 8U + 2U], &half, 2);
+                scene.classes[at] = klass;
+            }
+        }
+    };
+    dot(256, 128, 1);
+    dot(160, 128, 2);
+    scene.eye.periphery = {true, 0, 0, width, height, 0, 0, width, height, 0};
+    scene.eye.focus_rect = {0.95F, 0.95F, 0.99F, 0.99F};
+    HudTextures t = hud_textures(gpu, scene);
+    const float pi = 3.14159265358979F;
+    const float yaw = 20.0F * pi / 180.0F / 30.0F;
+    xrfg::HudRotation rotation{};
+    rotation.enabled = true;
+    // The synthetic's camera yawed by +yaw (to the left) from the frame's:
+    // target to source is that yaw itself.
+    rotation.target_to_source = {0.0F, std::sin(yaw * 0.5F), 0.0F, std::cos(yaw * 0.5F)};
+    rotation.target_tangents = {-1.0F, 1.0F, 0.5F, -0.5F};
+    rotation.source_tangents = rotation.target_tangents;
+    hud_upload(gpu, t.destination.Get(), scene.frame, width * 4U);
+    hud_record_readd(gpu, passes, scene, t, rotation, false);
+    const auto out = hud_readback(gpu, t.destination.Get(), width * 4U);
+    // Each dot's centroid (green, linear), left and right of x = 208.
+    const auto centroid = [&](bool right) {
+        double sum = 0.0, weighted = 0.0;
+        for (UINT y = 110; y < 146; ++y) {
+            for (UINT x = right ? 208U : 130U; x < (right ? 300U : 208U); ++x) {
+                const double value = hud_decode(out[(static_cast<std::size_t>(y) * width + x) * 4U + 1U]);
+                sum += value;
+                weighted += value * (static_cast<double>(x) + 0.5);
+            }
+        }
+        return sum > 0.0 ? weighted / sum : -1.0;
+    };
+    const double collimated = centroid(true);
+    const double helmet = centroid(false);
+    // Expected: where the CPU mapping takes the dot's centre (x 256.5).
+    double expected = -1.0;
+    for (double x = 240.0; x < 280.0; x += 0.001) {
+        float su = 0.0F, sv = 0.0F;
+        require(xrfg::hud_rotate_uv(rotation, static_cast<float>(x / width), 0.5F, su, sv), "hud rotate");
+        if (su * width >= 256.5F) {
+            expected = x;
+            break;
+        }
+    }
+    const double analytic = 256.5 + 256.0 * std::tan(static_cast<double>(yaw));
+    std::cout << "hud symbology: 20 deg/s yaw over 1/30 s: collimated dot at " << collimated << " (expected "
+              << expected << ", f tan = " << analytic << "), helmet dot at " << helmet << " (160.5)\n";
+    require(std::abs(collimated - expected) < 0.25, "hud: the collimated dot is not where the rotation takes it");
+    require(std::abs(expected - analytic) < 0.05, "hud: the rotation's shift is not f * tan(yaw)");
+    require(std::abs(helmet - 160.5) < 0.05, "hud: the helmet dot moved");
+}
+
+// The cockpit mask's resample (cockpit_mask.hlsl, the synthesizer's) on a
+// mask with one 128 texel (overlay symbology, mask v1.1): masked one texel
+// around it (R94: the footprints are floor-partitioned, so a pixel-centre
+// reader needs the dilation), the band 0.5 two more, nothing beyond.
+void test_hud_mask_overlay_dilation(Gpu& gpu) {
+    constexpr UINT mask_size = 16, target_size = 64;
+    std::vector<std::uint8_t> mask(static_cast<std::size_t>(mask_size) * mask_size, 0);
+    mask[8U * mask_size + 8U] = 128;
+    ComPtr<ID3D12Resource> source = hud_texture(gpu, mask_size, mask_size, DXGI_FORMAT_R8_UNORM);
+    hud_upload(gpu, source.Get(), mask, mask_size);
+    ComPtr<ID3D12Resource> target = hud_texture(gpu, target_size, target_size, DXGI_FORMAT_R8G8_UNORM, 1,
+        D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+    // A root signature with what the resample reads: t0-t1, u0, b0, s0.
+    D3D12_DESCRIPTOR_RANGE ranges[2]{};
+    ranges[0].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_SRV;
+    ranges[0].NumDescriptors = 2;
+    ranges[1].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[1].NumDescriptors = 1;
+    ranges[1].OffsetInDescriptorsFromTableStart = 2;
+    D3D12_ROOT_PARAMETER parameters[2]{};
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[0].DescriptorTable.NumDescriptorRanges = 2;
+    parameters[0].DescriptorTable.pDescriptorRanges = ranges;
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[1].Constants.Num32BitValues = 48;
+    D3D12_STATIC_SAMPLER_DESC sampler{};
+    sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU = sampler.AddressV = sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.MaxLOD = D3D12_FLOAT32_MAX;
+    D3D12_ROOT_SIGNATURE_DESC description{};
+    description.NumParameters = 2;
+    description.pParameters = parameters;
+    description.NumStaticSamplers = 1;
+    description.pStaticSamplers = &sampler;
+    ComPtr<ID3DBlob> blob, errors;
+    require_hresult(D3D12SerializeRootSignature(&description, D3D_ROOT_SIGNATURE_VERSION_1, blob.GetAddressOf(),
+                        errors.GetAddressOf()),
+        "mask resample: root signature");
+    ComPtr<ID3D12RootSignature> root;
+    require_hresult(gpu.device->CreateRootSignature(0, blob->GetBufferPointer(), blob->GetBufferSize(),
+                        IID_PPV_ARGS(root.GetAddressOf())),
+        "mask resample: CreateRootSignature");
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pipeline_description{};
+    pipeline_description.pRootSignature = root.Get();
+    pipeline_description.CS = {g_xrfg_cockpit_mask_resample_shader, sizeof(g_xrfg_cockpit_mask_resample_shader)};
+    ComPtr<ID3D12PipelineState> pipeline;
+    require_hresult(gpu.device->CreateComputePipelineState(&pipeline_description, IID_PPV_ARGS(pipeline.GetAddressOf())),
+        "mask resample: pipeline");
+    D3D12_DESCRIPTOR_HEAP_DESC heap_description{};
+    heap_description.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+    heap_description.NumDescriptors = 3;
+    heap_description.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+    ComPtr<ID3D12DescriptorHeap> heap;
+    require_hresult(gpu.device->CreateDescriptorHeap(&heap_description, IID_PPV_ARGS(heap.GetAddressOf())),
+        "mask resample: heap");
+    const UINT increment = gpu.device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    D3D12_CPU_DESCRIPTOR_HANDLE cpu = heap->GetCPUDescriptorHandleForHeapStart();
+    D3D12_SHADER_RESOURCE_VIEW_DESC view{};
+    view.Format = DXGI_FORMAT_R8_UNORM;
+    view.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    view.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    view.Texture2D.MipLevels = 1;
+    gpu.device->CreateShaderResourceView(source.Get(), &view, cpu);
+    cpu.ptr += increment;
+    gpu.device->CreateShaderResourceView(source.Get(), &view, cpu);
+    cpu.ptr += increment;
+    D3D12_UNORDERED_ACCESS_VIEW_DESC uav{};
+    uav.Format = DXGI_FORMAT_R8G8_UNORM;
+    uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2DARRAY;
+    uav.Texture2DArray.ArraySize = 1;
+    gpu.device->CreateUnorderedAccessView(target.Get(), nullptr, &uav, cpu);
+    // cockpit_mask.hlsl's CockpitMaskParameters: the current frame's mask
+    // alone (Flags bit 1), one cell per target pixel, the mask's rect and the
+    // target view the same field of view.
+    std::array<std::uint32_t, 48> constants{};
+    constants[0] = target_size;
+    constants[1] = target_size;
+    constants[2] = 1;
+    constants[5] = 2;
+    const float target_rect[4]{0.0F, 0.0F, static_cast<float>(target_size), static_cast<float>(target_size)};
+    const float tangents[4]{-1.0F, 1.0F, 1.0F, -1.0F};
+    const float quaternion[4]{0.0F, 0.0F, 0.0F, 1.0F};
+    const float mask_rect[4]{0.0F, 0.0F, static_cast<float>(mask_size), static_cast<float>(mask_size)};
+    std::memcpy(&constants[8], target_rect, 16);
+    std::memcpy(&constants[12], tangents, 16);
+    std::memcpy(&constants[16], quaternion, 16);
+    std::memcpy(&constants[20], mask_rect, 16);
+    std::memcpy(&constants[24], tangents, 16);
+    hud_run(gpu, [&](ID3D12GraphicsCommandList* list) {
+        const auto to_uav =
+            hud_transition(target.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        list->ResourceBarrier(1, &to_uav);
+        ID3D12DescriptorHeap* heaps[] = {heap.Get()};
+        list->SetDescriptorHeaps(1, heaps);
+        list->SetComputeRootSignature(root.Get());
+        list->SetPipelineState(pipeline.Get());
+        list->SetComputeRootDescriptorTable(0, heap->GetGPUDescriptorHandleForHeapStart());
+        list->SetComputeRoot32BitConstants(1, 48, constants.data(), 0);
+        list->Dispatch(target_size / 8U, target_size / 8U, 1);
+        const auto back =
+            hud_transition(target.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_COMMON);
+        list->ResourceBarrier(1, &back);
+    });
+    const auto result = gpu.readback_rows(target.Get(), target_size * 2U, target_size);
+    // The 128 texel is pixels 32-35 (4 per texel); one texel around: 28-39.
+    int wrong = 0;
+    for (UINT y = 0; y < target_size; ++y) {
+        for (UINT x = 0; x < target_size; ++x) {
+            const std::uint8_t masked = result[(static_cast<std::size_t>(y) * target_size + x) * 2U];
+            const bool core = x >= 28 && x < 40 && y >= 28 && y < 40;
+            const bool band = x >= 20 && x < 48 && y >= 20 && y < 48;
+            const std::uint8_t expected = core ? 255U : (band ? 128U : 0U);
+            wrong += std::abs(int(masked) - int(expected)) > 1 ? 1 : 0;
+        }
+    }
+    std::cout << "hud symbology: a 128 mask texel is masked one texel around (pixels 28-39), "
+              << wrong << " pixel(s) otherwise\n";
+    require(wrong == 0, "hud: the cockpit mask's 128 texel is not dilated by exactly one texel");
+}
+
+// The synthesis: a pair of real frames with the same HUD symbol drawn over a
+// world, composed with [ofxr] hud_symbology off and on (FidelityFX on WARP).
+struct HudSynthesisResult {
+    std::vector<std::uint8_t> synthetic;
+    std::vector<std::uint8_t> current;
+};
+
+constexpr UINT kHudSynthWidth = 128;
+constexpr UINT kHudSynthHeight = 96;
+
+std::array<xrfg::D3D12ReprojectionView, 2> hud_synthesis_views() {
+    std::array<xrfg::D3D12ReprojectionView, 2> views{};
+    for (UINT eye = 0; eye < 2; ++eye) {
+        views[eye].pose.orientation.w = 1.0F;
+        views[eye].pose.position.x = eye == 0 ? -0.032F : 0.032F;
+        views[eye].fov = {-0.7F, 0.7F, 0.55F, -0.55F};
+        views[eye].array_slice = eye;
+    }
+    return views;
+}
+
+// A frame's symbology: per eye the periphery 1:1 over the eye image, its
+// window (32, 24, 64, 48) holding `scene`'s delta; `present` false: none.
+std::shared_ptr<xrfg::D3D12CockpitMaskFrame> hud_synthesis_frame(Gpu& gpu, const HudScene& scene, bool present,
+    std::uint64_t seq, bool alpha_valid = false) {
+    auto frame = std::make_shared<xrfg::D3D12CockpitMaskFrame>();
+    require_hresult(gpu.device->CreateFence(1, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(frame->ready_fence.GetAddressOf())),
+        "hud synthesis: fence");
+    frame->ready_value = 1;
+    frame->mask_seq = seq;
+    frame->counters = std::make_shared<xrfg::CockpitMaskPairCounters>();
+    // The atlas: both eyes' views side by side, each its eye's size.
+    std::vector<std::uint8_t> emission(static_cast<std::size_t>(kHudSynthWidth) * 2U * kHudSynthHeight * 8U, 0);
+    std::vector<std::uint8_t> classes(static_cast<std::size_t>(kHudSynthWidth) * 2U * kHudSynthHeight, 0);
+    for (UINT eye = 0; eye < 2; ++eye) {
+        for (UINT y = 0; y < kHudSynthHeight; ++y) {
+            for (UINT x = 0; x < kHudSynthWidth; ++x) {
+                const std::size_t from = static_cast<std::size_t>(y) * kHudSynthWidth + x;
+                const std::size_t to = static_cast<std::size_t>(y) * kHudSynthWidth * 2U + eye * kHudSynthWidth + x;
+                std::memcpy(&emission[to * 8U], &scene.emission[from * 8U], 8);
+                classes[to] = scene.classes[from];
+            }
+        }
+    }
+    frame->hud_texture = hud_texture(gpu, kHudSynthWidth * 2U, kHudSynthHeight, DXGI_FORMAT_R16G16B16A16_FLOAT);
+    frame->hud_class_texture = hud_texture(gpu, kHudSynthWidth * 2U, kHudSynthHeight, DXGI_FORMAT_R8_UINT);
+    hud_upload(gpu, frame->hud_texture.Get(), emission, kHudSynthWidth * 2U * 8U);
+    hud_upload(gpu, frame->hud_class_texture.Get(), classes, kHudSynthWidth * 2U);
+    frame->hud = true;
+    frame->hud_symbology.alpha_valid = alpha_valid;
+    for (UINT eye = 0; eye < 2; ++eye) {
+        xrfg::D3D12HudSymbologyView& view = frame->hud_symbology.views[eye];
+        view.present = present;
+        view.x = eye * kHudSynthWidth + 32U;
+        view.y = 24;
+        view.out_width = kHudSynthWidth;
+        view.out_height = kHudSynthHeight;
+        view.window_x = 32;
+        view.window_y = 24;
+        view.window_width = 64;
+        view.window_height = 48;
+        frame->hud_symbology.eyes[eye].layout = true;
+        frame->hud_symbology.eyes[eye].focus_rect = {0.9F, 0.9F, 0.95F, 0.95F};
+    }
+    return frame;
+}
+
+HudSynthesisResult hud_synthesize(Gpu& gpu, const std::vector<std::uint8_t>& a, const std::vector<std::uint8_t>& b,
+    bool key, const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2>& frames, bool triple = false) {
+    const DXGI_FORMAT format = DXGI_FORMAT_R8G8B8A8_UNORM_SRGB;
+    const auto image = [&] {
+        return hud_texture(gpu, kHudSynthWidth, kHudSynthHeight, format, 2, D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET,
+            D3D12_HEAP_FLAG_NONE, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    };
+    std::array<ComPtr<ID3D12Resource>, 2> sources{image(), image()};
+    auto current = image();
+    auto synthetic = image();
+    auto extra = image(); // 3X: the second synthetic
+    hud_upload(gpu, sources[0].Get(), a, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    hud_upload(gpu, sources[1].Get(), b, kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    std::array<ID3D12Resource*, 2> input{sources[0].Get(), sources[1].Get()};
+    std::array<ID3D12Resource*, 1> current_out{current.Get()};
+    std::array<ID3D12Resource*, 2> synthetic_out{synthetic.Get(), extra.Get()};
+    auto history = std::make_shared<xrfg::D3D12SwapchainHistory>();
+    require_hresult(history->initialize(gpu.device.Get(), gpu.queue.Get(), input, D3D12_RESOURCE_STATE_RENDER_TARGET),
+        "hud synthesis: history");
+    xrfg::D3D12NvidiaOpticalFlowOptions options{};
+    options.cockpit_mask = true;
+    options.hud_symbology = key;
+    xrfg::D3D12FrameSynthesizer synth;
+    require_hresult(synth.initialize(gpu.device.Get(), gpu.queue.Get(), history, current_out, synthetic_out, format,
+                        D3D12_RESOURCE_STATE_RENDER_TARGET, xrfg::D3D12OpticalFlowBackend::fidelity_fx, options),
+        "hud synthesis: initialize");
+    const auto views = hud_synthesis_views();
+    xrfg::D3D12HistoryCaptureTicket ca{}, cb{};
+    xrfg::D3D12FrameSynthesisTicket output{};
+    require_hresult(history->capture(0, &ca), "hud synthesis: capture A");
+    require_hresult(history->commit(ca), "hud synthesis: commit A");
+    synth.set_cockpit_mask(frames[0]);
+    require_hresult(synth.submit_prime(ca, views, 0, &output), "hud synthesis: prime");
+    hud_run(gpu, [](ID3D12GraphicsCommandList*) {}); // the prime done (wait_for_idle would retire it)
+    require_hresult(history->capture(1, &cb), "hud synthesis: capture B");
+    require_hresult(history->commit(cb), "hud synthesis: commit B");
+    synth.set_cockpit_mask(frames[1]);
+    // 3X: the two synthetics at 1/3 and 2/3 (the older frame's symbology,
+    // then the newer one's).
+    const std::optional<xrfg::D3D12ExtraSynthetic> extra_synthetic =
+        triple ? std::optional<xrfg::D3D12ExtraSynthetic>(xrfg::D3D12ExtraSynthetic{1, 2.0F / 3.0F}) : std::nullopt;
+    require_hresult(synth.submit_pair(cb, views, views, 0, 0, &output, std::nullopt, {}, false,
+                        triple ? 1.0F / 3.0F : 0.5F, extra_synthetic),
+        "hud synthesis: pair");
+    require_hresult(synth.wait_for_idle(), "hud synthesis: idle");
+    HudSynthesisResult result;
+    result.synthetic = hud_readback(gpu, synthetic.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    result.current = hud_readback(gpu, current.Get(), kHudSynthWidth * 4U, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    return result;
+}
+
+void test_hud_synthesis(Gpu& gpu) {
+    // The HUD symbol: a bright green cross (class 1) over the window.
+    const auto scene_at = [](int world_shift, HudSymbolModel& model) {
+        HudScene scene;
+        scene.width = kHudSynthWidth;
+        scene.height = kHudSynthHeight;
+        scene.atlas_width = kHudSynthWidth;
+        scene.atlas_height = kHudSynthHeight;
+        scene.frame.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 4U, 255);
+        scene.emission.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight * 8U, 0);
+        scene.classes.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight, 0);
+        model.coverage.assign(static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight, 0.0F);
+        for (UINT y = 0; y < kHudSynthHeight; ++y) {
+            for (UINT x = 0; x < kHudSynthWidth; ++x) {
+                const std::size_t at = static_cast<std::size_t>(y) * kHudSynthWidth + x;
+                // A smooth world texture (the flow can follow it), moved by
+                // world_shift.
+                const double wx = static_cast<double>(x) - world_shift;
+                std::array<float, 3> f{};
+                for (int ch = 0; ch < 3; ++ch) {
+                    const double value = 0.5 + 0.35 * std::sin(wx * 0.21 + ch) * std::cos(y * 0.17 + 0.5 * ch);
+                    f[ch] = hud_decode(static_cast<std::uint8_t>(std::clamp(value * 255.0, 0.0, 255.0)));
+                }
+                const bool symbol = ((x >= 60 && x < 64) && y >= 30 && y < 66) || ((y >= 46 && y < 50) && x >= 44 && x < 84);
+                if (symbol) {
+                    std::array<float, 4> e{};
+                    const std::array<float, 3> green{0.1F, 0.9F, 0.15F};
+                    for (int ch = 0; ch < 3; ++ch) {
+                        const float mixed = 0.15F * f[ch] + 0.85F * green[ch];
+                        e[ch] = mixed - f[ch];
+                        f[ch] = mixed;
+                    }
+                    e[3] = 0.85F;
+                    for (int ch = 0; ch < 4; ++ch) {
+                        const std::uint16_t half = hud_half(e[ch]);
+                        std::memcpy(&scene.emission[at * 8U + ch * 2U], &half, 2);
+                    }
+                    scene.classes[at] = 1;
+                    model.coverage[at] = 0.85F;
+                }
+                for (int ch = 0; ch < 3; ++ch) {
+                    scene.frame[at * 4U + ch] = hud_encode(f[ch]);
+                }
+            }
+        }
+        return scene;
+    };
+    const auto stereo = [](const std::vector<std::uint8_t>& eye) {
+        std::vector<std::uint8_t> both(eye);
+        both.insert(both.end(), eye.begin(), eye.end());
+        return both;
+    };
+    HudSymbolModel model;
+    const HudScene still = scene_at(0, model);
+    const auto frame_a = stereo(still.frame);
+    // present = 0, and frames without symbology: bit-identical to the key off.
+    const auto off = hud_synthesize(gpu, frame_a, frame_a, false,
+        {hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, still, true, 2)});
+    const auto absent = hud_synthesize(gpu, frame_a, frame_a, true,
+        {hud_synthesis_frame(gpu, still, false, 1), hud_synthesis_frame(gpu, still, false, 2)});
+    require(absent.synthetic == off.synthetic && absent.current == off.current,
+        "hud synthesis: present = 0 is not bit-identical to the key off");
+    const auto none = hud_synthesize(gpu, frame_a, frame_a, true, {nullptr, nullptr});
+    require(none.synthetic == off.synthetic, "hud synthesis: no frames is not bit-identical to the key off");
+    // One frame with symbology, the other without: left as before.
+    const auto one = hud_synthesize(gpu, frame_a, frame_a, true,
+        {hud_synthesis_frame(gpu, still, false, 1), hud_synthesis_frame(gpu, still, true, 2)});
+    require(one.synthetic == off.synthetic, "hud synthesis: a pair with one frame's symbology is not left as before");
+    // A still world and a still HUD: the synthetic is the frame within 2
+    // codes, and the real frame's copy is the frame itself.
+    const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> still_frames{
+        hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, still, true, 2)};
+    const auto on = hud_synthesize(gpu, frame_a, frame_a, true, still_frames);
+    require(on.current == frame_a, "hud synthesis: the real frame's copy changed");
+    const auto& counters = *still_frames[1]->counters;
+    require(counters.hud_views.load() == 2 && counters.hud_from_current.load() == 2 &&
+            counters.hud_from_previous.load() == 0 && counters.hud_fallback_views.load() == 0,
+        "hud synthesis: both views cleaned and given the current frame's symbology (k/N = 0.5)");
+    // 3X: 1/3 the older frame's, 2/3 the newer one's.
+    const std::array<std::shared_ptr<xrfg::D3D12CockpitMaskFrame>, 2> triple_frames{
+        hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, still, true, 2)};
+    const auto triple = hud_synthesize(gpu, frame_a, frame_a, true, triple_frames, true);
+    const auto& triple_counters = *triple_frames[1]->counters;
+    require(triple_counters.hud_from_previous.load() == 2 && triple_counters.hud_from_current.load() == 2 &&
+            hud_max_difference(triple.synthetic, frame_a) <= 2,
+        "hud synthesis: 3X takes the older frame's symbology at 1/3, the newer one's at 2/3");
+    const int still_worst = hud_max_difference(on.synthetic, frame_a);
+    std::cout << "hud synthesis: still world and HUD, synthetic worst " << still_worst << " code(s) from the frame (off: "
+              << hud_max_difference(off.synthetic, frame_a) << ")\n";
+    require(still_worst <= 2, "hud synthesis: removal, composition and re-add do not give a still frame back");
+    // The world moves 8 px between the frames, the HUD stays: the symbol in
+    // the synthetic against the true middle frame (world moved 4 px, HUD).
+    HudSymbolModel moved_model;
+    const HudScene moved = scene_at(8, moved_model);
+    HudSymbolModel middle_model;
+    const HudScene middle = scene_at(4, middle_model);
+    const auto frame_b = stereo(moved.frame);
+    const auto truth = stereo(middle.frame);
+    const auto symbol_pixels = [&](std::size_t pixel) {
+        return model.coverage[pixel % (static_cast<std::size_t>(kHudSynthWidth) * kHudSynthHeight)] > 0.0F;
+    };
+    const auto moving_off = hud_synthesize(gpu, frame_a, frame_b, false,
+        {hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, moved, true, 2)});
+    const auto moving_on = hud_synthesize(gpu, frame_a, frame_b, true,
+        {hud_synthesis_frame(gpu, still, true, 1), hud_synthesis_frame(gpu, moved, true, 2)});
+    require(moving_on.current == frame_b, "hud synthesis: the real frame's copy changed (moving world)");
+    const auto moving_alpha = hud_synthesize(gpu, frame_a, frame_b, true,
+        {hud_synthesis_frame(gpu, still, true, 1, true), hud_synthesis_frame(gpu, moved, true, 2, true)});
+    const auto symbol_error = [&](const std::vector<std::uint8_t>& image) {
+        double error = 0.0;
+        std::size_t count = 0;
+        for (std::size_t pixel = 0; pixel * 4U < truth.size(); ++pixel) {
+            if (!symbol_pixels(pixel)) {
+                continue;
+            }
+            for (std::size_t ch = 0; ch < 3; ++ch) {
+                error += std::abs(int(image[pixel * 4U + ch]) - int(truth[pixel * 4U + ch]));
+            }
+            count += 3;
+        }
+        return error / static_cast<double>(std::max<std::size_t>(count, 1));
+    };
+    // Measured, not judged: FidelityFX on WARP follows little of this world
+    // (without the key the two frames' identical symbol is then averaged in
+    // place), and v1's additive delta (no coverage) carries the change of the
+    // world under a nearly opaque symbol (R89 1.5: small at night, tens of
+    // codes over a bright, busy world); coverage alpha (a later revision)
+    // removes it. The live run judges.
+    std::cout << "hud synthesis: world moving 8 px under a still HUD: symbol pixels' mean error "
+              << symbol_error(moving_on.synthetic) << " with the key (additive), "
+              << symbol_error(moving_alpha.synthetic) << " with coverage alpha, " << symbol_error(moving_off.synthetic)
+              << " without\n";
+}
+
+void test_hud_symbology(Gpu& gpu) {
+    test_hud_nearest_frame();
+    test_hud_pairing_and_copies(gpu);
+    test_hud_held_set(gpu);
+    test_hud_removal_readd(gpu);
+    test_hud_shifted_background(gpu);
+    test_hud_focus_mapping(gpu);
+    test_hud_collimated_rotation(gpu);
+    test_hud_mask_overlay_dilation(gpu);
+    test_hud_synthesis(gpu);
+}
