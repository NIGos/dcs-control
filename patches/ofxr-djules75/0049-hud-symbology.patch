+#pragma once
+
+// DCS Control (0049): the HUD / helmet symbology in frame generation, [ofxr]
+// hud_symbology (R89 v1, contract xrfg/dcsvr_symbology.h). DCS Control's
+// engine module publishes, per real frame and HMD view, the linear delta its
+// collimated (HUD, gunsight: class 1) and helmet (class 2) symbology added to
+// the view, in a window of the view (CockpitMaskConsumer copies it with the
+// frame's mask: D3D12CockpitMaskFrame::hud_symbology). The synthesis
+//  - takes it out of both real frames before the flow and the composition
+//    (a clean copy of each frame: P - D in the windows), so the flow never
+//    follows a symbol and the composition never smears one;
+//  - composes the synthetic from the clean frames as before;
+//  - puts the symbology of the real frame nearest in time back into the
+//    synthetic (k/N < 0.5 the older frame, else the newer; never a
+//    cross-fade): collimated symbology carried by the head rotation between
+//    that frame and the synthetic's camera at infinity, helmet symbology where
+//    it was.
+// The real frames themselves (the current output's copy) are never changed.
+// These are the passes that do it, and the math they share with the tests.
+
+#include "xrfg/cockpit_mask.hpp"
+
+#include <d3d12.h>
+
+#include <array>
+#include <cstdint>
+#include <memory>
+
+namespace xrfg {
+
+// Consumer rule 3: the synthetic at `fraction` between the previous real
+// frame (0) and the current one (1) is given the current frame's symbology
+// from half way on, the previous frame's before.
+[[nodiscard]] constexpr bool hud_readd_from_current(float fraction) noexcept {
+    return !(fraction < 0.5F);
+}
+
+// One eye of one frame as the passes read it: its periphery view (eye) and
+// its focus view (2 + eye), where the focus sits in the eye image, and Quad
+// Views' edge blend.
+struct HudEyeInput {
+    D3D12HudSymbologyView periphery{};
+    D3D12HudSymbologyView focus{};
+    std::array<float, 4> focus_rect{};
+    float focus_smoothing{};
+    float focus_shape{};
+};
+
+[[nodiscard]] HudEyeInput hud_eye_input(const D3D12HudSymbology& symbology, std::uint32_t eye) noexcept;
+
+// The eye image's rectangle in its texture, in pixels.
+struct HudImageRect {
+    std::uint32_t x{};
+    std::uint32_t y{};
+    std::uint32_t width{};
+    std::uint32_t height{};
+};
+
+// The collimated symbology's move: a target pixel's direction (its tangent
+// on the target's z = -1 plane) turned by target_to_source (x y z w) into the
+// source frame's camera, whose tangents give its pixel. As the composition's
+// own camera mapping (make_camera_mapping), rotation only: collimated
+// symbology is at infinity.
+struct HudRotation {
+    bool enabled{};
+    std::array<float, 4> target_to_source{0.0F, 0.0F, 0.0F, 1.0F};
+    std::array<float, 4> target_tangents{};
+    std::array<float, 4> source_tangents{};
+};
+
+// The shader's mapping on the CPU: the source frame's eye uv showing target
+// eye uv (u, v) (0..1, v down); false behind the source camera.
+[[nodiscard]] bool hud_rotate_uv(const HudRotation& rotation, float u, float v, float& source_u,
+    float& source_v) noexcept;
+
+// The pixels a pass needs to touch: the eye image's pixels the present views'
+// windows map to (with a re-add's `rotation`, also where the collimated
+// symbology lands), two pixels around, inside `image`. right <= left: none.
+[[nodiscard]] D3D12_RECT hud_pass_rect(
+    const HudEyeInput& eye, const HudImageRect& image, const HudRotation* rotation = nullptr) noexcept;
+
+// The sRGB format of an 8-bit RGBA / BGRA family (UNKNOWN for any other),
+// whether a resource of `resource_format` takes a view of it (its TYPELESS
+// format, or the sRGB format itself), and the family's TYPELESS format.
+[[nodiscard]] DXGI_FORMAT hud_srgb_format(DXGI_FORMAT format) noexcept;
+[[nodiscard]] bool hud_srgb_viewable(DXGI_FORMAT resource_format, DXGI_FORMAT srgb_format) noexcept;
+[[nodiscard]] DXGI_FORMAT hud_typeless_format(DXGI_FORMAT format) noexcept;
+
+// The passes (hud_symbology.hlsl). Descriptors live in heaps of their own, a
+// region per (work slot, call), so a slot's are rewritten only when the slot
+// is reused (its work completed). Each record_* sets its own descriptor heap,
+// root signature, pipeline, viewport and scissor: the caller sets its own
+// again afterwards. Resource states are the caller's: `source` / `clean_source`
+// readable by the pixel shader, the target a render target, the frame's
+// symbology copies readable (they rest in COMMON and are promoted).
+class D3D12HudSymbologyPasses final {
+public:
+    static constexpr std::uint32_t kCallsPerSlot = 8;
+
+    D3D12HudSymbologyPasses() noexcept;
+    ~D3D12HudSymbologyPasses();
+    D3D12HudSymbologyPasses(const D3D12HudSymbologyPasses&) = delete;
+    D3D12HudSymbologyPasses& operator=(const D3D12HudSymbologyPasses&) = delete;
+
+    [[nodiscard]] HRESULT initialize(ID3D12Device* device, std::uint32_t slots) noexcept;
+
+    // P - D (P `source`'s slice `slice`, D the eye's composed delta of
+    // classes 1 and 2) into slice `slice` of `clean`, which already holds a
+    // copy of `source`; only where D is not 0, only over hud_pass_rect.
+    [[nodiscard]] bool record_removal(ID3D12GraphicsCommandList* list, std::uint32_t slot, std::uint32_t call,
+        ID3D12Resource* source, ID3D12Resource* clean, DXGI_FORMAT srgb_format, std::uint32_t slice,
+        const HudImageRect& image, const HudEyeInput& eye, ID3D12Resource* emission,
+        ID3D12Resource* classes) noexcept;
+
+    // The frame's symbology into slice `slice` of `destination` (the
+    // synthetic): class 1 through `rotation` (when enabled), class 2 where it
+    // was; added, or with `alpha_valid` re-composed over the clean copy
+    // `clean_source` (the same frame's, slice `slice`).
+    [[nodiscard]] bool record_readd(ID3D12GraphicsCommandList* list, std::uint32_t slot, std::uint32_t call,
+        ID3D12Resource* destination, DXGI_FORMAT srgb_format, std::uint32_t slice, const HudImageRect& image,
+        const HudEyeInput& eye, ID3D12Resource* emission, ID3D12Resource* classes,
+        ID3D12Resource* clean_source, const HudRotation& rotation, bool alpha_valid) noexcept;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace xrfg
