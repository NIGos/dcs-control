diff --git a/tests/hud_symbology_tests.inc b/tests/hud_symbology_tests.inc
new file mode 100644
--- /dev/null
+++ b/tests/hud_symbology_tests.inc
@@ -0,0 +1,1446 @@
+// DCS Control (0049): the HUD / helmet symbology ([ofxr] hud_symbology, R89
+// v1, contract xrfg/dcsvr_symbology.h). Included by cockpit_mask_tests.cpp
+// inside its namespace (its Gpu, FakeProducer, test_suffix, test_options).
+//  - The consumer against a fake producer block and D3D12 atlases (NT
+//    handles): pairing with the mask slot (index, seq, generation, fence),
+//    the present windows copied, overflow ignored, present = 0, no layout,
+//    the reader heartbeat at 2040, [ofxr] hud_symbology off, and the held set
+//    across an inactive stretch with the same generation (0044).
+//  - The passes on D3D12 textures: removal then re-add over the same
+//    background gives the frame back within a code; over a background
+//    shifted by 4 px with coverage alpha against the additive delta; the
+//    focus view's mapping and Quad Views' edge blend against focus_rect() /
+//    focus_weight(); the collimated symbology's rotation at 20 deg/s; the
+//    helmet symbology left where it was; classes other than 1 and 2 never
+//    touched.
+//  - k/N's nearest frame; the cockpit mask's resample on a 128 texel (one
+//    texel of dilation); and the synthesis itself: present = 0 bit-identical
+//    to the key off, the real frame's copy untouched, a static HUD over a
+//    still and over a moving world.
+
+namespace csy = dcsvr_symbology;
+
+std::uint16_t hud_half(float value) {
+    return DirectX::PackedVector::XMConvertFloatToHalf(value);
+}
+
+float hud_decode(std::uint8_t code) {
+    const float c = static_cast<float>(code) / 255.0F;
+    return c <= 0.04045F ? c / 12.92F : std::pow((c + 0.055F) / 1.055F, 2.4F);
+}
+
+std::uint8_t hud_encode(float linear) {
+    const float l = std::clamp(linear, 0.0F, 1.0F);
+    const float c = l <= 0.0031308F ? l * 12.92F : 1.055F * std::pow(l, 1.0F / 2.4F) - 0.055F;
+    return static_cast<std::uint8_t>(std::lround(c * 255.0F));
+}
+
+// A small, repeatable random sequence.
+struct HudRandom {
+    std::uint32_t state{0x12345678U};
+    float next() {
+        state = state * 1664525U + 1013904223U;
+        return static_cast<float>(state >> 8U) / 16777216.0F;
+    }
+};
+
+D3D12_RESOURCE_BARRIER hud_transition(ID3D12Resource* resource, D3D12_RESOURCE_STATES before,
+    D3D12_RESOURCE_STATES after) {
+    D3D12_RESOURCE_BARRIER barrier{};
+    barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+    barrier.Transition.pResource = resource;
+    barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+    barrier.Transition.StateBefore = before;
+    barrier.Transition.StateAfter = after;
+    return barrier;
+}
+
+// Records `record` on a direct list and waits for it.
+void hud_run(Gpu& gpu, const std::function<void(ID3D12GraphicsCommandList*)>& record) {
+    ComPtr<ID3D12CommandAllocator> allocator;
+    ComPtr<ID3D12GraphicsCommandList> list;
+    require_hresult(gpu.device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                        IID_PPV_ARGS(allocator.GetAddressOf())),
+        "hud: allocator");
+    require_hresult(gpu.device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr,
+                        IID_PPV_ARGS(list.GetAddressOf())),
+        "hud: list");
+    record(list.Get());
+    require_hresult(list->Close(), "hud: Close");
+    ID3D12CommandList* lists[] = {list.Get()};
+    gpu.queue->ExecuteCommandLists(1, lists);
+    require_hresult(gpu.queue->Signal(gpu.fence.Get(), ++gpu.fence_value), "hud: Signal");
+    gpu.wait(gpu.fence.Get(), gpu.fence_value);
+}
+
+ComPtr<ID3D12Resource> hud_texture(Gpu& gpu, UINT width, UINT height, DXGI_FORMAT format, UINT16 slices = 1,
+    D3D12_RESOURCE_FLAGS flags = D3D12_RESOURCE_FLAG_NONE, D3D12_HEAP_FLAGS heap_flags = D3D12_HEAP_FLAG_NONE,
+    D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON) {
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC description{};
+    description.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    description.Width = width;
+    description.Height = height;
+    description.DepthOrArraySize = slices;
+    description.MipLevels = 1;
+    description.Format = format;
+    description.SampleDesc.Count = 1;
+    description.Flags = flags;
+    ComPtr<ID3D12Resource> texture;
+    require_hresult(gpu.device->CreateCommittedResource(&heap, heap_flags, &description, state, nullptr,
+                        IID_PPV_ARGS(texture.GetAddressOf())),
+        "hud: texture");
+    return texture;
+}
+
+// Every slice of `texture` (in `state`) from / to `bytes` (slice after slice,
+// `row_bytes` a row).
+void hud_transfer_slices(Gpu& gpu, ID3D12Resource* texture, std::vector<std::uint8_t>& bytes, UINT row_bytes,
+    bool upload, D3D12_RESOURCE_STATES state) {
+    const D3D12_RESOURCE_DESC description = texture->GetDesc();
+    const UINT slices = description.DepthOrArraySize;
+    std::vector<D3D12_PLACED_SUBRESOURCE_FOOTPRINT> layouts(slices);
+    std::vector<UINT> rows(slices);
+    std::vector<UINT64> row_sizes(slices);
+    UINT64 total = 0;
+    gpu.device->GetCopyableFootprints(&description, 0, slices, 0, layouts.data(), rows.data(), row_sizes.data(), &total);
+    D3D12_HEAP_PROPERTIES heap{};
+    heap.Type = upload ? D3D12_HEAP_TYPE_UPLOAD : D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC buffer{};
+    buffer.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    buffer.Width = total;
+    buffer.Height = 1;
+    buffer.DepthOrArraySize = 1;
+    buffer.MipLevels = 1;
+    buffer.SampleDesc.Count = 1;
+    buffer.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    ComPtr<ID3D12Resource> staging;
+    require_hresult(gpu.device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &buffer,
+                        upload ? D3D12_RESOURCE_STATE_GENERIC_READ : D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                        IID_PPV_ARGS(staging.GetAddressOf())),
+        "hud: staging");
+    const std::size_t slice_bytes = static_cast<std::size_t>(row_bytes) * description.Height;
+    if (!upload) {
+        bytes.assign(slice_bytes * slices, 0);
+    }
+    std::uint8_t* mapped = nullptr;
+    if (upload) {
+        require_hresult(staging->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "hud: Map");
+        for (UINT slice = 0; slice < slices; ++slice) {
+            for (UINT y = 0; y < rows[slice]; ++y) {
+                std::memcpy(mapped + layouts[slice].Offset + static_cast<std::size_t>(y) * layouts[slice].Footprint.RowPitch,
+                    bytes.data() + slice * slice_bytes + static_cast<std::size_t>(y) * row_bytes, row_bytes);
+            }
+        }
+        staging->Unmap(0, nullptr);
+    }
+    hud_run(gpu, [&](ID3D12GraphicsCommandList* list) {
+        if (state != D3D12_RESOURCE_STATE_COMMON) {
+            const auto to = hud_transition(texture, state,
+                upload ? D3D12_RESOURCE_STATE_COPY_DEST : D3D12_RESOURCE_STATE_COPY_SOURCE);
+            list->ResourceBarrier(1, &to);
+        }
+        for (UINT slice = 0; slice < slices; ++slice) {
+            D3D12_TEXTURE_COPY_LOCATION image{};
+            image.pResource = texture;
+            image.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+            image.SubresourceIndex = slice;
+            D3D12_TEXTURE_COPY_LOCATION linear{};
+            linear.pResource = staging.Get();
+            linear.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+            linear.PlacedFootprint = layouts[slice];
+            if (upload) {
+                list->CopyTextureRegion(&image, 0, 0, 0, &linear, nullptr);
+            } else {
+                list->CopyTextureRegion(&linear, 0, 0, 0, &image, nullptr);
+            }
+        }
+        if (state != D3D12_RESOURCE_STATE_COMMON) {
+            const auto back = hud_transition(texture,
+                upload ? D3D12_RESOURCE_STATE_COPY_DEST : D3D12_RESOURCE_STATE_COPY_SOURCE, state);
+            list->ResourceBarrier(1, &back);
+        }
+    });
+    if (!upload) {
+        require_hresult(staging->Map(0, nullptr, reinterpret_cast<void**>(&mapped)), "hud: Map(readback)");
+        for (UINT slice = 0; slice < slices; ++slice) {
+            for (UINT y = 0; y < rows[slice]; ++y) {
+                std::memcpy(bytes.data() + slice * slice_bytes + static_cast<std::size_t>(y) * row_bytes,
+                    mapped + layouts[slice].Offset + static_cast<std::size_t>(y) * layouts[slice].Footprint.RowPitch,
+                    row_bytes);
+            }
+        }
+        staging->Unmap(0, nullptr);
+    }
+}
+
+void hud_upload(Gpu& gpu, ID3D12Resource* texture, std::vector<std::uint8_t> bytes, UINT row_bytes,
+    D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON) {
+    hud_transfer_slices(gpu, texture, bytes, row_bytes, true, state);
+}
+
+std::vector<std::uint8_t> hud_readback(Gpu& gpu, ID3D12Resource* texture, UINT row_bytes,
+    D3D12_RESOURCE_STATES state = D3D12_RESOURCE_STATE_COMMON) {
+    std::vector<std::uint8_t> bytes;
+    hud_transfer_slices(gpu, texture, bytes, row_bytes, false, state);
+    return bytes;
+}
+
+// The symbology block as DCS Control's engine module shares it: its own
+// RGBA16F emission and R8_UINT class atlases (NT handles), the mask
+// producer's fence and generation, committed into the slot the mask producer
+// just used. Atlas 64 x 32: views 0 / 1 (periphery, capacity 16 x 16) at
+// (0, 0) / (0, 16), views 2 / 3 (focus, 24 x 32) at (16, 0) / (40, 0).
+constexpr UINT kHudAtlasWidth = 64;
+constexpr UINT kHudAtlasHeight = 32;
+
+class FakeSymbologyProducer final {
+public:
+    FakeSymbologyProducer(Gpu& gpu, const std::wstring& suffix, const FakeProducer& mask) : gpu_(gpu) {
+        const std::wstring name = std::wstring(csy::block_name) + suffix;
+        mapping_ = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, 4096, name.c_str());
+        require(mapping_ != nullptr, "symbology producer: CreateFileMappingW");
+        block_ = static_cast<csy::Header*>(MapViewOfFile(mapping_, FILE_MAP_ALL_ACCESS, 0, 0, 4096));
+        require(block_ != nullptr, "symbology producer: MapViewOfFile");
+        make_resources(mask);
+    }
+    ~FakeSymbologyProducer() {
+        close_handles();
+        for (HANDLE handle : retired_) {
+            CloseHandle(handle);
+        }
+        if (block_ != nullptr) {
+            UnmapViewOfFile(block_);
+        }
+        if (mapping_ != nullptr) {
+            CloseHandle(mapping_);
+        }
+    }
+    FakeSymbologyProducer(const FakeSymbologyProducer&) = delete;
+    FakeSymbologyProducer& operator=(const FakeSymbologyProducer&) = delete;
+
+    // New atlases with the mask's (new) generation and fence.
+    void make_resources(const FakeProducer& mask) {
+        close_handles(true);
+        for (int index = 0; index < csy::slot_count; ++index) {
+            textures_[index] = hud_texture(gpu_, kHudAtlasWidth, kHudAtlasHeight, DXGI_FORMAT_R16G16B16A16_FLOAT, 1,
+                D3D12_RESOURCE_FLAG_NONE, D3D12_HEAP_FLAG_SHARED);
+            require_hresult(gpu_.device->CreateSharedHandle(
+                                textures_[index].Get(), nullptr, GENERIC_ALL, nullptr, &handles_[index]),
+                "symbology producer: emission handle");
+            classes_[index] = hud_texture(gpu_, kHudAtlasWidth, kHudAtlasHeight, DXGI_FORMAT_R8_UINT, 1,
+                D3D12_RESOURCE_FLAG_NONE, D3D12_HEAP_FLAG_SHARED);
+            require_hresult(gpu_.device->CreateSharedHandle(
+                                classes_[index].Get(), nullptr, GENERIC_ALL, nullptr, &class_handles_[index]),
+                "symbology producer: class handle");
+        }
+        header_ = {};
+        header_.magic = csy::block_magic;
+        header_.version = csy::block_version;
+        header_.structSize = sizeof(csy::Header);
+        header_.flags = csy::header_flags::active | csy::header_flags::fence | csy::header_flags::reader_heartbeat |
+            csy::header_flags::shares_mask_fence | csy::header_flags::class_atlas | csy::header_flags::qv_settings;
+        header_.generation = mask.header_.generation;
+        header_.slotCount = csy::slot_count;
+        header_.format = csy::format_rgba16f;
+        header_.atlasW = kHudAtlasWidth;
+        header_.atlasH = kHudAtlasHeight;
+        header_.ownerPid = GetCurrentProcessId();
+        header_.adapterLuid = mask.header_.adapterLuid;
+        for (int index = 0; index < csy::slot_count; ++index) {
+            header_.textureHandle[index] = reinterpret_cast<std::uintptr_t>(handles_[index]);
+            header_.classTextureHandle[index] = reinterpret_cast<std::uintptr_t>(class_handles_[index]);
+        }
+        header_.classFormat = csy::format_r8_uint;
+        header_.emissionFlags = csy::emission_flags::hdr_overlay | csy::emission_flags::class_collimated |
+            csy::emission_flags::class_head_locked | csy::emission_flags::common_excluded;
+        header_.fenceHandle = mask.header_.fenceHandle;
+        header_.qpcFrequency = qpc_frequency();
+        header_.revision = csy::contract_revision;
+        header_.qv.smoothenFocusViewEdges = 0.2F;
+        header_.qv.focusViewShape = 0.0F;
+        header_.qv.sharpenFocusView = 0.7F;
+        publish();
+    }
+
+    // The symbology of the mask producer's last commit (its slot, seq and
+    // display time): views in `present` present (bit v), those in
+    // `overflow` overflowed (not present), a focus layout unless
+    // `layout` is false; before the mask producer signals.
+    void commit(FakeProducer& mask, std::uint32_t present = 15U, std::uint32_t overflow = 0U, bool layout = true) {
+        const int slot = static_cast<int>(mask.header_.newestSlot);
+        const cm::MaskSlot& mask_slot = mask.header_.slot[slot];
+        pattern_.assign(static_cast<std::size_t>(kHudAtlasWidth) * kHudAtlasHeight * 8U, 0);
+        classes_pattern_.assign(static_cast<std::size_t>(kHudAtlasWidth) * kHudAtlasHeight, 0);
+        for (std::size_t texel = 0; texel < classes_pattern_.size(); ++texel) {
+            for (std::size_t c = 0; c < 4; ++c) {
+                const std::uint16_t half =
+                    hud_half(static_cast<float>((texel * 7U + c * 3U + mask_slot.maskSeq) % 97U) / 97.0F);
+                std::memcpy(&pattern_[texel * 8U + c * 2U], &half, 2);
+            }
+            classes_pattern_[texel] = static_cast<std::uint8_t>(texel % 4U);
+        }
+        hud_upload(gpu_, textures_[slot].Get(), pattern_, kHudAtlasWidth * 8U);
+        hud_upload(gpu_, classes_[slot].Get(), classes_pattern_, kHudAtlasWidth);
+        csy::EmissionSlot& record = header_.slot[slot];
+        record = {};
+        record.seq = mask_slot.maskSeq;
+        record.engineFrame = mask_slot.engineFrame;
+        record.displayTime = mask_slot.displayTime;
+        record.flags = csy::slot_flags::valid | csy::slot_flags::display_time;
+        record.viewMask = 15U;
+        for (int view = 0; view < csy::max_views; ++view) {
+            csy::EmissionView& entry = record.view[view];
+            const bool focus = view >= 2;
+            entry.x = focus ? 16U + 24U * static_cast<std::uint32_t>(view - 2) : 0U;
+            entry.y = focus ? 0U : 16U * static_cast<std::uint32_t>(view);
+            entry.capW = focus ? 24U : 16U;
+            entry.capH = focus ? 32U : 16U;
+            entry.outW = focus ? 200U : 100U;
+            entry.outH = focus ? 180U : 90U;
+            entry.winX = 10U + static_cast<std::uint32_t>(view);
+            entry.winY = 5U;
+            entry.winW = entry.capW - 2U;
+            entry.winH = entry.capH - 3U;
+            entry.flags = csy::view_flags::valid;
+            if ((present & (1U << view)) != 0) {
+                entry.flags |= csy::view_flags::present;
+            } else {
+                entry.winW = entry.winH = 0;
+            }
+            if ((overflow & (1U << view)) != 0) {
+                entry.flags = csy::view_flags::valid | csy::view_flags::overflow;
+                entry.winW = entry.winH = 0;
+            }
+            const float spread = focus ? 0.4F : 1.0F;
+            entry.fovTan[0] = -spread;
+            entry.fovTan[1] = spread;
+            entry.fovTan[2] = 0.8F * spread;
+            entry.fovTan[3] = -0.8F * spread;
+        }
+        for (int eye = 0; eye < csy::eye_count; ++eye) {
+            csy::EyeFocus& focus = record.focus.eye[eye];
+            const float eye_tan[4]{-1.0F, 1.0F, 0.8F, -0.8F};
+            const float focus_tan[4]{-0.4F + 0.05F * static_cast<float>(eye), 0.3F, 0.25F, -0.35F};
+            std::memcpy(focus.eyeFovTan, eye_tan, sizeof(eye_tan));
+            std::memcpy(focus.focusFovTan, focus_tan, sizeof(focus_tan));
+            float rect[4]{};
+            require(csy::focus_rect(eye_tan, focus_tan, rect), "symbology producer: focus rect");
+            std::memcpy(focus.rectNorm, rect, sizeof(rect));
+        }
+        record.focus.flags = layout ? csy::layout_flags::layout_valid | csy::layout_flags::from_submit : 0U;
+        record.focus.fovSource = csy::fov_source_dcs_submitted;
+        header_.newestSeq = record.seq;
+        header_.newestSlot = static_cast<std::uint32_t>(slot);
+        publish();
+    }
+
+    void publish() {
+        header_.heartbeatQpc = qpc_now();
+        csy::seqlock_write(block_, header_);
+    }
+    std::uint64_t reader_heartbeat() const {
+        return csy::reader_heartbeat_of(block_).load(std::memory_order_acquire);
+    }
+
+    csy::Header header_{};
+    std::vector<std::uint8_t> pattern_;
+    std::vector<std::uint8_t> classes_pattern_;
+
+private:
+    void close_handles(bool keep = false) {
+        for (auto* list : {&handles_, &class_handles_}) {
+            for (HANDLE& handle : *list) {
+                if (handle != nullptr) {
+                    keep ? retired_.push_back(handle) : static_cast<void>(CloseHandle(handle));
+                    handle = nullptr;
+                }
+            }
+        }
+    }
+
+    Gpu& gpu_;
+    HANDLE mapping_{};
+    csy::Header* block_{};
+    std::array<ComPtr<ID3D12Resource>, csy::slot_count> textures_{};
+    std::array<ComPtr<ID3D12Resource>, csy::slot_count> classes_{};
+    std::array<HANDLE, csy::slot_count> handles_{};
+    std::array<HANDLE, csy::slot_count> class_handles_{};
+    std::vector<HANDLE> retired_;
+};
+
+// The consumer: pairing, copies, overflow, present = 0, layout, heartbeat,
+// the key off.
+void test_hud_pairing_and_copies(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"hud");
+    FakeProducer producer(gpu, suffix);
+    FakeSymbologyProducer hud(gpu, suffix, producer);
+    auto options = test_options(suffix);
+    options.hud_symbology = true;
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        std::vector<std::int64_t> logged;
+        require_hresult(consumer.initialize(gpu.device.Get(),
+                            [&logged](std::int64_t code, std::uint64_t, std::uint64_t, std::uint64_t) {
+                                logged.push_back(code);
+                            },
+                            options),
+            "consumer initialize");
+        // View 2 overflowed: not present, its window not copied (ignored).
+        std::uint64_t seq = producer.commit(12000, 255);
+        hud.commit(producer, 15U & ~4U, 4U);
+        auto frame = consumer.acquire(12000);
+        require(frame != nullptr && frame->hud && frame->hud_texture != nullptr && frame->hud_class_texture != nullptr,
+            std::string("hud: a paired frame carries its symbology, last ") +
+                std::to_string(static_cast<int>(consumer.stats().hud_last)));
+        const xrfg::D3D12HudSymbology& symbology = frame->hud_symbology;
+        require(symbology.views[0].present && symbology.views[1].present && !symbology.views[2].present &&
+                symbology.views[3].present,
+            "hud: the present views, the overflowed one not");
+        const xrfg::D3D12HudSymbologyView& right_focus = symbology.views[3];
+        require(right_focus.x == 40 && right_focus.y == 0 && right_focus.out_width == 200 &&
+                right_focus.out_height == 180 && right_focus.window_x == 13 && right_focus.window_y == 5 &&
+                right_focus.window_width == 22 && right_focus.window_height == 29,
+            "hud: a view's sub-rect, output size and window");
+        // The focus rect from the tangents (focus_rect()), both eyes.
+        for (std::uint32_t eye = 0; eye < 2; ++eye) {
+            const csy::EyeFocus& published = hud.header_.slot[hud.header_.newestSlot].focus.eye[eye];
+            float rect[4]{};
+            require(csy::focus_rect(published.eyeFovTan, published.focusFovTan, rect), "hud: focus_rect");
+            require(symbology.eyes[eye].layout && symbology.eyes[eye].focus_rect[0] == rect[0] &&
+                    symbology.eyes[eye].focus_rect[1] == rect[1] && symbology.eyes[eye].focus_rect[2] == rect[2] &&
+                    symbology.eyes[eye].focus_rect[3] == rect[3],
+                "hud: the eye's focus rect is focus_rect() of the published tangents");
+        }
+        require(symbology.eye_present(0) && symbology.eye_present(1), "hud: both eyes have symbology");
+        require(symbology.focus_smoothing == 0.2F && symbology.focus_shape == 0.0F && !symbology.alpha_valid,
+            "hud: Quad Views' edge blend, no coverage alpha (v1)");
+        require(producer.reader_heartbeat() != 0 && hud.reader_heartbeat() != 0,
+            "hud: the mask's and the symbology block's heartbeats (offset 2040) are stored");
+        // One fence: the copy waits for the mask's seq.
+        Sleep(50);
+        require(frame->ready_fence->GetCompletedValue() < frame->ready_value, "hud: the copy waits for the shared fence");
+        producer.signal(seq);
+        gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+        const auto emission = gpu.readback_rows(frame->hud_texture.Get(), kHudAtlasWidth * 8U, kHudAtlasHeight);
+        const auto classes = gpu.readback_rows(frame->hud_class_texture.Get(), kHudAtlasWidth, kHudAtlasHeight);
+        const auto& slot = hud.header_.slot[hud.header_.newestSlot];
+        std::size_t inside = 0, outside_nonzero = 0, mismatched = 0;
+        for (UINT y = 0; y < kHudAtlasHeight; ++y) {
+            for (UINT x = 0; x < kHudAtlasWidth; ++x) {
+                const std::size_t texel = static_cast<std::size_t>(y) * kHudAtlasWidth + x;
+                bool in_window = false;
+                for (int view = 0; view < csy::max_views; ++view) {
+                    const csy::EmissionView& m = slot.view[view];
+                    if ((m.flags & csy::view_flags::present) != 0 && x >= m.x && x < m.x + m.winW && y >= m.y &&
+                        y < m.y + m.winH) {
+                        in_window = true;
+                    }
+                }
+                const bool same = std::memcmp(&emission[texel * 8U], &hud.pattern_[texel * 8U], 8) == 0 &&
+                    classes[texel] == hud.classes_pattern_[texel];
+                if (in_window) {
+                    ++inside;
+                    mismatched += same ? 0U : 1U;
+                } else {
+                    outside_nonzero += classes[texel] != 0 ? 1U : 0U;
+                }
+            }
+        }
+        require(inside > 0 && mismatched == 0, "hud: the present windows are copied as published");
+        require(outside_nonzero == 0, "hud: nothing outside the present windows is copied (the overflowed view's)");
+        gpu.wait(producer.release_fence_.Get(), seq);
+        frame.reset();
+
+        const auto expect_none = [&](std::int64_t time, xrfg::CockpitHudLookup reason, const char* what,
+                                     const std::function<void()>& tamper) {
+            const std::uint64_t value = producer.commit(time, 255);
+            hud.commit(producer);
+            tamper();
+            auto none = consumer.acquire(time);
+            require(none != nullptr && !none->hud, std::string("hud: ") + what + " gives the mask alone");
+            require(consumer.stats().hud_last == reason, std::string("hud: ") + what + " is not reported (" +
+                    std::to_string(static_cast<int>(consumer.stats().hud_last)) + ")");
+            producer.signal(value);
+            gpu.wait(none->ready_fence.Get(), none->ready_value);
+        };
+        expect_none(12100, xrfg::CockpitHudLookup::no_view, "present = 0 in every view", [&] {
+            hud.commit(producer, 0U);
+        });
+        expect_none(12200, xrfg::CockpitHudLookup::no_view, "every view overflowed", [&] {
+            hud.commit(producer, 0U, 15U);
+        });
+        expect_none(12300, xrfg::CockpitHudLookup::no_view, "no focus layout", [&] {
+            hud.commit(producer, 15U, 0U, false);
+        });
+        expect_none(12400, xrfg::CockpitHudLookup::unpaired, "another seq", [&] {
+            hud.header_.slot[hud.header_.newestSlot].seq += 5;
+            hud.publish();
+        });
+        expect_none(12500, xrfg::CockpitHudLookup::late_commit, "a late commit", [&] {
+            hud.header_.slot[hud.header_.newestSlot].flags |= csy::slot_flags::late_commit;
+            hud.publish();
+        });
+        expect_none(12600, xrfg::CockpitHudLookup::fence_mismatch, "another fence", [&] {
+            hud.header_.fenceHandle += 4;
+            hud.publish();
+            hud.header_.fenceHandle -= 4;
+        });
+        expect_none(12700, xrfg::CockpitHudLookup::generation_mismatch, "another generation", [&] {
+            hud.header_.generation += 1;
+            hud.publish();
+            hud.header_.generation -= 1;
+        });
+        hud.publish();
+        const auto stats = consumer.stats();
+        require(stats.hud_paired == 1 && stats.hud_misses == 7 && stats.hud_generations_opened == 1 &&
+                stats.hud_overflow >= 5 && stats.hud_no_layout == 1 && stats.hud_view_present[2] < stats.hud_view_present[0],
+            "hud: the frames counted by reason");
+        require(std::find(logged.begin(), logged.end(), 17) != logged.end(), "hud: the textures opened (result=17)");
+    }
+    require(producer.reader_heartbeat() == 0 && hud.reader_heartbeat() == 0,
+        "hud: both heartbeats are cleared when the consumer goes");
+    // [ofxr] hud_symbology off: the block is not even opened.
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, test_options(suffix)), "consumer initialize");
+        const std::uint64_t seq = producer.commit(12800, 255);
+        hud.commit(producer);
+        auto frame = consumer.acquire(12800);
+        require(frame != nullptr && !frame->hud && consumer.stats().hud_last == xrfg::CockpitHudLookup::off &&
+                hud.reader_heartbeat() == 0,
+            "hud off: the mask alone, no symbology heartbeat");
+        producer.signal(seq);
+        gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    }
+    std::cout << "hud symbology: pairing (slot, seq, generation, fence), window copies, overflow ignored, present = 0, "
+                 "layout, heartbeat, [ofxr] hud_symbology\n";
+}
+
+// The held set (0044): the export off with the same generation keeps the
+// symbology set opened, on again it pairs without another import; a new
+// generation imports it again and drops the old one.
+void test_hud_held_set(Gpu& gpu) {
+    const std::wstring suffix = test_suffix(L"hudheld");
+    FakeProducer producer(gpu, suffix);
+    FakeSymbologyProducer hud(gpu, suffix, producer);
+    auto options = test_options(suffix);
+    options.hud_symbology = true;
+    xrfg::CockpitMaskConsumer consumer;
+    require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+    const auto set_active = [&](bool active) {
+        if (active) {
+            producer.header_.flags |= cm::header_flags::active;
+            hud.header_.flags |= csy::header_flags::active;
+        } else {
+            producer.header_.flags &= ~cm::header_flags::active;
+            hud.header_.flags &= ~csy::header_flags::active;
+        }
+    };
+    std::uint64_t seq = producer.commit(13000, 255);
+    hud.commit(producer);
+    auto frame = consumer.acquire(13000);
+    require(frame != nullptr && frame->hud && consumer.stats().sets_opened == 2, "hud held: mask and symbology opened");
+    producer.signal(seq);
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    frame.reset();
+    set_active(false);
+    producer.commit(13100, 255);
+    hud.commit(producer);
+    require(consumer.acquire(13100) == nullptr && consumer.stats().sets_opened == 2 &&
+            consumer.stats().sets_retired == 0,
+        "hud held: the export off with the same generation keeps both sets");
+    set_active(true);
+    seq = producer.commit(13200, 255);
+    hud.commit(producer);
+    frame = consumer.acquire(13200);
+    require(frame != nullptr && frame->hud && consumer.stats().hud_generations_opened == 1,
+        "hud held: on again, paired without another import");
+    producer.signal(seq);
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    frame.reset();
+    producer.make_resources();
+    hud.make_resources(producer);
+    seq = producer.commit(13300, 255);
+    hud.commit(producer);
+    frame = consumer.acquire(13300);
+    require(frame != nullptr && frame->hud && consumer.stats().hud_generations_opened == 2,
+        "hud held: a new generation imports the set again");
+    producer.signal(seq);
+    gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    frame.reset();
+    const ULONGLONG deadline = GetTickCount64() + 10000;
+    while (consumer.stats().sets_retired != 0 && GetTickCount64() <= deadline) {
+        Sleep(5);
+        consumer.drop_idle();
+    }
+    require(consumer.stats().sets_retired == 0 && consumer.stats().sets_opened == 2,
+        "hud held: the old generation's sets dropped once their copies completed");
+    std::cout << "hud symbology: the held set across the export off (0044), a new generation imports again\n";
+}
