diff --git a/tests/layer_frame_records.cmake b/tests/layer_frame_records.cmake
new file mode 100644
--- /dev/null
+++ b/tests/layer_frame_records.cmake
@@ -0,0 +1,216 @@
+# DCS Control (0048): the per-real-frame records (`[diagnostics]
+# frame_records`). Runs a call-chain scenario with RECORDS_INI beside the
+# layer DLL and checks the flight log: with FRAME_RECORDS=1, op=frame records
+# with sane fields (indices 1, 2, 3..., rising QPC values, spans and
+# intervals within reason, a known cadence, the frame's xrWaitFrame found),
+# a frame_hold record per frame whose split adds up to its hold, and
+# frame_slot and frame_gpu records that name frames that were recorded; with
+# FRAME_RECORDS=0, none of the four.
+foreach(required_variable IN ITEMS LAYER_DLL CALL_CHAIN RECORDS_INI WORK_DIR MODE FRAME_RECORDS)
+    if(NOT DEFINED ${required_variable})
+        message(FATAL_ERROR "${required_variable} was not provided")
+    endif()
+endforeach()
+
+file(REMOVE_RECURSE "${WORK_DIR}")
+file(MAKE_DIRECTORY "${WORK_DIR}")
+file(COPY "${LAYER_DLL}" DESTINATION "${WORK_DIR}")
+file(COPY "${RECORDS_INI}" DESTINATION "${WORK_DIR}")
+get_filename_component(records_ini_name "${RECORDS_INI}" NAME)
+file(RENAME "${WORK_DIR}/${records_ini_name}" "${WORK_DIR}/ofxr_bridge.ini")
+
+get_filename_component(layer_name "${LAYER_DLL}" NAME)
+execute_process(
+    COMMAND "${CALL_CHAIN}"
+        "${WORK_DIR}/${layer_name}"
+        "${WORK_DIR}/fake-runtime.log"
+        ${MODE}
+    RESULT_VARIABLE call_chain_result
+    OUTPUT_VARIABLE call_chain_output
+    ERROR_VARIABLE call_chain_error)
+if(NOT call_chain_result EQUAL 0)
+    message(FATAL_ERROR
+        "Call chain '${MODE}' failed (${call_chain_result}):\n"
+        "${call_chain_output}\n${call_chain_error}")
+endif()
+
+file(GLOB flight_logs "${WORK_DIR}/ofxr-bridge-flight-*.log")
+list(LENGTH flight_logs flight_log_count)
+if(NOT flight_log_count EQUAL 1)
+    message(FATAL_ERROR "Expected one OFXR flight log, found ${flight_log_count}")
+endif()
+list(GET flight_logs 0 flight_log)
+
+set(field_pattern "result=([0-9]+) dur_us=([0-9]+) a=([0-9]+) b=([0-9]+) c=([0-9]+)")
+file(STRINGS "${flight_log}" frame_lines REGEX " op=frame result=")
+file(STRINGS "${flight_log}" slot_lines REGEX " op=frame_slot result=")
+file(STRINGS "${flight_log}" gpu_lines REGEX " op=frame_gpu result=")
+file(STRINGS "${flight_log}" hold_lines REGEX " op=frame_hold result=")
+list(LENGTH frame_lines frame_count)
+list(LENGTH slot_lines slot_count)
+list(LENGTH gpu_lines gpu_count)
+list(LENGTH hold_lines hold_count)
+
+if(NOT FRAME_RECORDS)
+    if(NOT frame_count EQUAL 0 OR NOT slot_count EQUAL 0 OR NOT gpu_count EQUAL 0 OR
+       NOT hold_count EQUAL 0)
+        message(FATAL_ERROR
+            "frame_records off, yet the log has ${frame_count} frame, "
+            "${slot_count} frame_slot, ${gpu_count} frame_gpu and "
+            "${hold_count} frame_hold records")
+    endif()
+    message(STATUS "OFXR frame records off: none written")
+    return()
+endif()
+
+if(frame_count LESS 20)
+    message(FATAL_ERROR "Expected per-frame records, found ${frame_count}")
+endif()
+
+set(expected_index 1)
+set(previous_qpc 0)
+set(waits_found 0)
+foreach(line IN LISTS frame_lines)
+    if(NOT line MATCHES "${field_pattern}")
+        message(FATAL_ERROR "Malformed frame record: ${line}")
+    endif()
+    set(index ${CMAKE_MATCH_1})
+    set(span_us ${CMAKE_MATCH_2})
+    set(qpc ${CMAKE_MATCH_3})
+    set(interval_us ${CMAKE_MATCH_4})
+    set(cadence ${CMAKE_MATCH_5})
+    if(NOT index EQUAL expected_index)
+        message(FATAL_ERROR "Frame record ${index} where ${expected_index} was due: ${line}")
+    endif()
+    if(qpc EQUAL 0 OR NOT qpc GREATER previous_qpc)
+        message(FATAL_ERROR "Frame record QPC does not rise: ${line}")
+    endif()
+    # A fake frame is milliseconds; ten seconds is a broken clock.
+    if(span_us GREATER 10000000 OR interval_us GREATER 10000000)
+        message(FATAL_ERROR "Frame record span or interval out of range: ${line}")
+    endif()
+    if(index EQUAL 1)
+        if(NOT interval_us EQUAL 0)
+            message(FATAL_ERROR "The first frame record has an interval: ${line}")
+        endif()
+    elseif(interval_us EQUAL 0)
+        message(FATAL_ERROR "A later frame record has no interval: ${line}")
+    endif()
+    math(EXPR frames "${cadence} & 255")
+    if(frames LESS 1 OR frames GREATER 3)
+        message(FATAL_ERROR "Frame record cadence ${frames} not 1-3: ${line}")
+    endif()
+    math(EXPR unknown_bits "${cadence} & ~4095")
+    if(NOT unknown_bits EQUAL 0)
+        message(FATAL_ERROR "Frame record cadence has undocumented bits: ${line}")
+    endif()
+    math(EXPR wait_found "(${cadence} >> 11) & 1")
+    if(wait_found)
+        math(EXPR waits_found "${waits_found} + 1")
+    else()
+        if(NOT span_us EQUAL 0)
+            message(FATAL_ERROR "A span without its xrWaitFrame: ${line}")
+        endif()
+    endif()
+    set(previous_qpc ${qpc})
+    set(entry_${index} ${qpc})
+    math(EXPR expected_index "${expected_index} + 1")
+endforeach()
+math(EXPR last_index "${expected_index} - 1")
+# Most frames find their own wait (the fake application ends what it waited).
+math(EXPR waits_needed "${frame_count} / 2")
+if(waits_found LESS waits_needed)
+    message(FATAL_ERROR "Only ${waits_found} of ${frame_count} frame records found their xrWaitFrame")
+endif()
+
+# One frame_hold per frame, after its entry, its parts adding up to it.
+if(NOT hold_count EQUAL frame_count)
+    message(FATAL_ERROR "${hold_count} frame_hold records for ${frame_count} frames")
+endif()
+set(expected_index 1)
+set(paced_frames 0)
+foreach(line IN LISTS hold_lines)
+    if(NOT line MATCHES "${field_pattern}")
+        message(FATAL_ERROR "Malformed frame_hold record: ${line}")
+    endif()
+    set(index ${CMAKE_MATCH_1})
+    set(hold_us ${CMAKE_MATCH_2})
+    set(qpc ${CMAKE_MATCH_3})
+    set(split ${CMAKE_MATCH_4})
+    set(rest_us ${CMAKE_MATCH_5})
+    if(NOT index EQUAL expected_index)
+        message(FATAL_ERROR "frame_hold ${index} where ${expected_index} was due: ${line}")
+    endif()
+    if(NOT qpc GREATER entry_${index})
+        message(FATAL_ERROR "frame_hold exit is not after its frame's entry: ${line}")
+    endif()
+    if(hold_us GREATER 10000000)
+        message(FATAL_ERROR "frame_hold out of range: ${line}")
+    endif()
+    math(EXPR pacing_us "${split} & 4294967295")
+    math(EXPR fence_us "${split} >> 32")
+    math(EXPR parts_us "${pacing_us} + ${fence_us} + ${rest_us}")
+    # The parts are rounded down to whole microseconds each.
+    math(EXPR parts_low "${hold_us} - 3")
+    if(parts_us GREATER hold_us OR parts_us LESS parts_low)
+        if(NOT rest_us EQUAL 0)
+            message(FATAL_ERROR "frame_hold parts do not add up: ${line}")
+        endif()
+    endif()
+    if(pacing_us GREATER 0)
+        math(EXPR paced_frames "${paced_frames} + 1")
+    endif()
+    math(EXPR expected_index "${expected_index} + 1")
+endforeach()
+# The presenter holds the fake application once per frame at 2X/3X.
+if(paced_frames EQUAL 0)
+    message(FATAL_ERROR "No frame_hold record saw the presenter's pacing")
+endif()
+
+if(slot_count EQUAL 0)
+    message(FATAL_ERROR "No frame_slot record")
+endif()
+foreach(line IN LISTS slot_lines)
+    if(NOT line MATCHES "${field_pattern}")
+        message(FATAL_ERROR "Malformed frame_slot record: ${line}")
+    endif()
+    set(index ${CMAKE_MATCH_1})
+    set(residual ${CMAKE_MATCH_3})
+    set(period_us ${CMAKE_MATCH_4})
+    set(qpc ${CMAKE_MATCH_5})
+    if(index LESS 1 OR index GREATER last_index)
+        message(FATAL_ERROR "frame_slot names a frame never recorded: ${line}")
+    endif()
+    if(period_us LESS 1000 OR period_us GREATER 100000 OR qpc EQUAL 0)
+        message(FATAL_ERROR "frame_slot period or QPC out of range: ${line}")
+    endif()
+    math(EXPR unknown_bits "${residual} & ~((1 << 48) - 1) | ((${residual} >> 33) & 127)")
+    if(NOT unknown_bits EQUAL 0)
+        message(FATAL_ERROR "frame_slot residual has undocumented bits: ${line}")
+    endif()
+endforeach()
+
+if(gpu_count EQUAL 0)
+    message(FATAL_ERROR "No frame_gpu record")
+endif()
+foreach(line IN LISTS gpu_lines)
+    if(NOT line MATCHES "${field_pattern}")
+        message(FATAL_ERROR "Malformed frame_gpu record: ${line}")
+    endif()
+    set(index ${CMAKE_MATCH_1})
+    set(done_us ${CMAKE_MATCH_2})
+    set(qpc ${CMAKE_MATCH_3})
+    set(fences ${CMAKE_MATCH_4})
+    set(incomplete ${CMAKE_MATCH_5})
+    if(index LESS 1 OR index GREATER last_index)
+        message(FATAL_ERROR "frame_gpu names a frame never recorded: ${line}")
+    endif()
+    if(qpc EQUAL 0 OR fences LESS 1 OR done_us GREATER 10000000 OR NOT incomplete EQUAL 0)
+        message(FATAL_ERROR "frame_gpu fields out of range: ${line}")
+    endif()
+endforeach()
+
+message(STATUS
+    "OFXR frame records verified: ${frame_count} frame, ${slot_count} frame_slot, "
+    "${gpu_count} frame_gpu, ${hold_count} frame_hold (${paced_frames} paced; "
+    "${waits_found} with their xrWaitFrame)")
