+
+// DCS Control (0048): the frame record, at the application's xrEndFrame
+// entry; see BridgeFlightOperation::frame. Only with frame_records on.
+// Returns the frame index and the entry (QPC) for its frame_hold record.
+std::pair<std::uint64_t, std::int64_t> log_frame_record(
+    SessionState& state, const XrFrameEndInfo* end_info) noexcept {
+    const std::int64_t entered = frame_record_counter();
+    const std::uint64_t index =
+        state.frame_record_count.fetch_add(1, std::memory_order_relaxed) + 1;
+    state.frame_record_end.store(index, std::memory_order_relaxed);
+    state.frame_record_end_qpc.store(entered, std::memory_order_relaxed);
+    const std::int64_t previous =
+        state.frame_record_last_qpc.exchange(entered, std::memory_order_relaxed);
+    std::uint64_t span_us = 0;
+    std::uint32_t cadence_frames = 0;
+    bool wait_found = false;
+    if (end_info != nullptr && end_info->displayTime != 0) {
+        for (const auto& slot : state.frame_record_waits) {
+            if (slot.display_time.load(std::memory_order_acquire) ==
+                end_info->displayTime) {
+                const std::int64_t returned =
+                    slot.returned_qpc.load(std::memory_order_relaxed);
+                cadence_frames = slot.frames.load(std::memory_order_relaxed);
+                span_us = frame_record_microseconds(entered - returned);
+                wait_found = returned != 0;
+                break;
+            }
+        }
+    }
+    const bool generation_off =
+        state.manual_control.stop_requested() || !state.menu_enabled.load();
+    std::uint64_t cadence = cadence_frames != 0
+        ? (cadence_frames & 0xFFU) | (1ULL << 8)
+        : (state.frames_per_application_frame.load() & 0xFFU);
+    cadence |= state.adaptive_active.load() ? (1ULL << 9) : 0;
+    cadence |= generation_off ? (1ULL << 10) : 0;
+    cadence |= wait_found ? (1ULL << 11) : 0;
+    xrfg::bridge_flight_logger().timed_event(
+        xrfg::BridgeFlightOperation::frame,
+        static_cast<std::int64_t>(index),
+        span_us,
+        static_cast<std::uint64_t>(entered),
+        previous != 0 ? frame_record_microseconds(entered - previous) : 0,
+        cadence);
+    return {index, entered};
+}
