+// DCS Control (0048): a span of QueryPerformanceCounter ticks in
+// microseconds, for the per-real-frame records (0 for a negative span).
+[[nodiscard]] std::uint64_t frame_record_microseconds(std::int64_t ticks) noexcept {
+    static const std::int64_t frequency = [] {
+        LARGE_INTEGER value{};
+        return QueryPerformanceFrequency(&value) ? value.QuadPart : 0;
+    }();
+    if (ticks <= 0 || frequency <= 0) {
+        return 0;
+    }
+    return static_cast<std::uint64_t>(
+        ticks / frequency * 1000000 + ticks % frequency * 1000000 / frequency);
+}
