+void note_frame_record_wait(
+    SessionState& state, XrTime display_time, std::uint32_t frames) noexcept {
+    const std::int64_t returned = frame_record_counter();
+    auto& slot = state.frame_record_waits[
+        state.frame_record_wait_next.fetch_add(1, std::memory_order_relaxed) %
+        state.frame_record_waits.size()];
+    // Unmatched while it is being rewritten.
+    slot.display_time.store(0, std::memory_order_relaxed);
+    slot.returned_qpc.store(returned, std::memory_order_relaxed);
+    slot.frames.store(frames, std::memory_order_relaxed);
+    slot.display_time.store(display_time, std::memory_order_release);
