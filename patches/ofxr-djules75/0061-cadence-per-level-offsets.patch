+// DCS Control (0061): R113's mixed scene - the cadence alternating 2 and 3
+// with each 20 s view change - with a 2 frame shown three periods after the
+// time it is told before any resync and a 3 frame six (its synthetics queued
+// in front of it), a quarter period of jitter, each frame observed two frames
+// after it was told. `shared` is 0059/0060's model, the one offset 2 and 3
+// shared (a 3 frame judged and told as a 2: the same confirmation, hysteresis
+// and back-off as 0060's common part). That moves it 3 <-> 6 on every change
+// of cadence, as R113's offset did; one offset per level moves each once and
+// never again.
+void cadence_resync_per_level_tests() {
+    constexpr Nanoseconds kP = 11'111'111;
+    constexpr int kPhases = 8;
+    struct Outcome {
+        std::array<int, kPhases> moves{};
+        std::array<int, kPhases> off{};
+        std::array<std::int64_t, kPhases> offset_at_end{};
+    };
+    const auto run = [&](bool shared) {
+        CadenceTimeResync resync{};
+        Outcome outcome{};
+        struct Told { std::uint32_t frames; Nanoseconds told; std::int64_t periods; };
+        std::vector<Told> in_flight;
+        std::uint32_t lcg = 0x5EED0061U;
+        const auto draw = [&](int low, int high) {
+            lcg = lcg * 1664525U + 1013904223U;
+            return low + static_cast<int>((lcg >> 8) % static_cast<std::uint32_t>(high - low + 1));
+        };
+        const auto as_told = [&](std::uint32_t frames) {
+            return shared && frames == 3 ? 2U : frames;
+        };
+        const auto lands = [](std::uint32_t frames) -> std::int64_t {
+            return frames == 3 ? 6 : 3;
+        };
+        Nanoseconds told = 1'000'000'000;
+        for (int phase = 0; phase < kPhases; ++phase) {
+            const std::uint32_t frames = phase % 2 == 0 ? 2U : 3U;
+            const Nanoseconds phase_end = told + 20 * kSecond;
+            while (told < phase_end) {
+                told += frames * kP;
+                in_flight.push_back({frames, told, resync.periods_for(as_told(frames))});
+                if (in_flight.size() <= 2) {
+                    continue;
+                }
+                const Told shown = in_flight.front();
+                in_flight.erase(in_flight.begin());
+                const Nanoseconds jitter = (draw(0, 2) - 1) * kP / 4;
+                const Nanoseconds residual = (lands(shown.frames) - shown.periods) * kP + jitter;
+                outcome.off[phase] += residual_periods(residual, kP) != 0 ? 1 : 0;
+                outcome.moves[phase] +=
+                    resync.observe(as_told(shown.frames), shown.told, residual, kP, told) != 0
+                        ? 1
+                        : 0;
+            }
+            outcome.offset_at_end[phase] = resync.periods_for(as_told(frames));
+        }
+        return outcome;
+    };
+    const auto describe = [](const Outcome& outcome) {
+        std::string text;
+        for (int phase = 0; phase < kPhases; ++phase) {
+            text += " [" + std::to_string(outcome.moves[phase]) + " moves, " +
+                std::to_string(outcome.off[phase]) + " off, offset " +
+                std::to_string(outcome.offset_at_end[phase]) + "]";
+        }
+        return text;
+    };
+    const Outcome shared = run(true);
+    const Outcome per_level = run(false);
+    std::cout << "cadence resync, 2/3 alternating every 20 s: shared offset (0060)"
+              << describe(shared) << "; per level (0061)" << describe(per_level) << '\n';
+    // The hypothesis: one shared offset moves on every change of cadence,
+    // 3 <-> 6, and frames are shown off before each move.
+    for (int phase = 1; phase < kPhases; ++phase) {
+        require(shared.moves[phase] >= 1 && shared.off[phase] >= CadenceTimeResync::kConfirmCadence &&
+                    shared.offset_at_end[phase] == (phase % 2 == 0 ? 3 : 6),
+            "per level: the shared offset moves on every switch (phase " +
+                std::to_string(phase) + ":" + describe(shared) + ")");
+    }
+    // One offset per level: 2 learnt in the first phase, 3 in the second,
+    // nothing after.
+    require(per_level.moves[0] == 1 && per_level.moves[1] == 1,
+        "per level: each level learns once (" + describe(per_level) + ")");
+    for (int phase = 2; phase < kPhases; ++phase) {
+        require(per_level.moves[phase] == 0 && per_level.off[phase] == 0 &&
+                    per_level.offset_at_end[phase] == (phase % 2 == 0 ? 3 : 6),
+            "per level: no move and no frame off once both have learnt (phase " +
+                std::to_string(phase) + ":" + describe(per_level) + ")");
+    }
+}
+
