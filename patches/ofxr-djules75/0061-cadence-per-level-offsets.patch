+# DCS Control (0061): the 408 records - a= us since the application's last
+# xrEndFrame activity, c= 0 idle, 1 the session stopping, 2 the teardown.
+if(MODE MATCHES "^dcs-cadence-(idle|reidle|pause|close)$")
+    file(STRINGS "${flight_log}" stood_down
+        REGEX "op=presenter_transition result=408 ")
+    set(idle_count 0)
+    set(teardown_count 0)
+    set(summary "")
+    foreach(record IN LISTS stood_down)
+        if(NOT record MATCHES " a=([0-9]+) b=[0-9]+ c=([0-9]+)")
+            message(FATAL_ERROR "Unreadable 408 record: ${record}")
+        endif()
+        set(since_us "${CMAKE_MATCH_1}")
+        set(cause "${CMAKE_MATCH_2}")
+        string(APPEND summary " a=${since_us} c=${cause}")
+        if(cause EQUAL 2)
+            math(EXPR teardown_count "${teardown_count} + 1")
+            # The teardown's: the session closed within the idle limit.
+            if(since_us GREATER 150000)
+                message(FATAL_ERROR "408 for the teardown ${since_us} us after the last frame")
+            endif()
+        else()
+            math(EXPR idle_count "${idle_count} + 1")
+            # Idle: past 150 ms (no sooner: R113's 95 ms stall), within a
+            # slot or two of it.
+            if(since_us LESS 150000 OR since_us GREATER 180000)
+                message(FATAL_ERROR "408 for an idle application ${since_us} us after its last frame (150-180 ms expected)")
+            endif()
+        endif()
+    endforeach()
+    if(MODE STREQUAL "dcs-cadence-idle")
+        set(expected_idle 1)
+        set(expected_teardown 0)
+    elseif(MODE STREQUAL "dcs-cadence-reidle")
+        # One per idle: the second after 1X was entered again.
+        set(expected_idle 2)
+        set(expected_teardown 0)
+    elseif(MODE STREQUAL "dcs-cadence-pause")
+        # None for the stall; the teardown's at the end (1X kept).
+        set(expected_idle 0)
+        set(expected_teardown 1)
+    else()
+        set(expected_idle 0)
+        set(expected_teardown 1)
+    endif()
+    if(NOT idle_count EQUAL expected_idle OR NOT teardown_count EQUAL expected_teardown)
+        message(FATAL_ERROR
+            "408 records: ${idle_count} idle (expected ${expected_idle}), ${teardown_count} "
+            "teardown (expected ${expected_teardown}):${summary}")
+    endif()
+    message(STATUS "408 records:${summary}")
+    if(MODE STREQUAL "dcs-cadence-pause")
+        string(FIND "${contents}" "op=adaptive_switch result=9 " left_late)
+        if(NOT left_late EQUAL -1)
+            message(FATAL_ERROR "1X was left on missed slots over the 95 ms stall")
+        endif()
+    endif()
+endif()
