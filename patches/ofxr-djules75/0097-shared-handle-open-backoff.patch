+// DCS Control (0097): handles that fail to open are tried again at most once
+// a retry interval for the same generation (they were tried every frame); a
+// new generation is tried at once. The mask's block and the depth companion's.
+void test_open_failure_backs_off(Gpu& gpu) {
+    constexpr std::uintptr_t bogus = 0x7FFFFFFCU; // no handle of this process
+    const std::wstring suffix = test_suffix(L"openbackoff");
+    FakeProducer producer(gpu, suffix);
+    auto options = test_options(suffix);
+    options.retry_milliseconds = 1000;
+    {
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, options), "consumer initialize");
+        const std::uintptr_t good = producer.header_.textureHandle[0];
+        producer.header_.textureHandle[0] = bogus;
+        std::uint64_t seq = producer.commit(100, 255);
+        producer.signal(seq);
+        require(consumer.acquire(100) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::open_failed &&
+                consumer.stats().open_failures == 1 && consumer.stats().open_retry_waits == 0,
+            "open backoff: the first open of a bad handle fails");
+        for (int frame = 0; frame < 5; ++frame) {
+            producer.publish();
+            require(consumer.acquire(100) == nullptr && consumer.stats().last == xrfg::CockpitMaskLookup::open_failed,
+                "open backoff: the generation stays without masks");
+        }
+        require(consumer.stats().open_failures == 1 && consumer.stats().open_retry_waits == 5,
+            "open backoff: not tried again within the retry interval");
+        Sleep(1100);
+        producer.publish();
+        require(consumer.acquire(100) == nullptr && consumer.stats().open_failures == 2,
+            "open backoff: tried again once the interval is over");
+        producer.header_.textureHandle[0] = good;
+        producer.make_resources(); // a new generation
+        seq = producer.commit(200, 255);
+        producer.signal(seq);
+        auto frame = consumer.acquire(200);
+        require(frame != nullptr && consumer.stats().open_failures == 2 && consumer.stats().generations_opened == 1,
+            "open backoff: a new generation is tried at once, and pairs");
+        gpu.wait(frame->ready_fence.Get(), frame->ready_value);
+    }
+    {
+        FakeProducer mask(gpu, suffix + L"_d");
+        FakeDepthProducer depth(gpu, suffix + L"_d", mask);
+        auto depth_options = test_options(suffix + L"_d");
+        depth_options.retry_milliseconds = 1000;
+        depth_options.cockpit_depth = true;
+        xrfg::CockpitMaskConsumer consumer;
+        require_hresult(consumer.initialize(gpu.device.Get(), {}, depth_options), "consumer initialize");
+        depth.header_.textureHandle[0] = bogus;
+        for (int frame = 0; frame < 4; ++frame) {
+            const std::uint64_t seq = mask.commit(300 + frame, 255);
+            depth.commit(mask);
+            mask.signal(seq);
+            auto got = consumer.acquire(300 + frame);
+            require(got != nullptr && !got->depth && consumer.stats().depth_last == xrfg::CockpitDepthLookup::open_failed,
+                "open backoff: the mask without depth while depth fails to open");
+            gpu.wait(got->ready_fence.Get(), got->ready_value);
+        }
+        require(consumer.stats().depth_open_failures == 1 && consumer.stats().depth_open_retry_waits == 3,
+            "open backoff: depth tried once within the retry interval");
+    }
+    std::cout << "cockpit mask: a failed open is tried again once a retry interval, a new generation at once\n";
+}
