+// DCS Control (0097): a block's handles that failed to open are tried again
+// at most once a retry interval for the same generation. They were tried on
+// every acquire (every frame): up to five OpenSharedHandle calls a frame on
+// the render path for as long as the producer's handles stayed unusable. A
+// new generation is tried at once.
+struct OpenBackoff {
+    bool armed{};
+    std::uint32_t generation{};
+    std::uint64_t retry_at_ms{};
+
+    [[nodiscard]] bool waiting(std::uint32_t header_generation, std::uint64_t now_ms) const noexcept {
+        return armed && header_generation == generation && now_ms < retry_at_ms;
+    }
+    void failed(std::uint32_t header_generation, std::uint64_t now_ms, std::uint32_t interval_ms) noexcept {
+        armed = true;
+        generation = header_generation;
+        retry_at_ms = now_ms + interval_ms;
+    }
+    void clear() noexcept { armed = false; }
+};
+
 }  // namespace
 
