+    write("[ofxr]\nenabled=1\n");
+    section = same_as_readers("live ini: as the readers (no flow keys)");
+    require(section.nvidia.input_scale == ConfiguredNvidiaInputScale::half, "live ini: a missing scale is 50");
+    // UTF-16 LE with a BOM, as DCS Control writes it.
+    write_utf16(L"[ofxr]\r\nbackend=fidelityfx\r\nnvidia_preset=medium\r\nnvidia_input_scale=50\r\n"
+                L"nvidia_bidirectional=1\r\nnvidia_occlusion_aware=1\r\ncursor_templates=C:\\DCS W\u00e9rld\\bin\r\n");
+    section = same_as_readers("live ini: as the readers (UTF-16)");
