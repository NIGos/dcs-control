+LiveAdoption adopt_live(const LiveFlow& flow, bool first) {
+    LiveAdoption result;
+    if (flow.preset < 0 || flow.preset > 2 || flow.scale < 0 || flow.scale > 2 || flow.occlusion_aware > 1U)
