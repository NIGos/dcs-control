+    return static_cast<std::uint64_t>(flow.preset & 0xFF) |
+        (flow.scale >= 0 && flow.scale <= 2 ? percent[flow.scale] << 8 : 0ULL) |
+        (flow.backward ? 1ULL << 16 : 0ULL) |
+        (static_cast<std::uint64_t>(flow.occlusion_aware & 0xFFU) << 24);
+}
