diff --git a/src/common/implicit_layer.cpp b/src/common/implicit_layer.cpp
--- a/src/common/implicit_layer.cpp
+++ b/src/common/implicit_layer.cpp
@@ -580,6 +580,91 @@ ConfiguredNvidiaOptions read_nvidia_options(
     return options;
 }
 
+// DCS Control (0066).
+namespace {
+
+[[nodiscard]] std::wstring_view trim_profile_text(std::wstring_view text) noexcept {
+    while (!text.empty() && (text.front() == L' ' || text.front() == L'\t')) text.remove_prefix(1);
+    while (!text.empty() && (text.back() == L' ' || text.back() == L'\t' || text.back() == L'\r'))
+        text.remove_suffix(1);
+    return text;
+}
+
+// As GetPrivateProfileIntW: the leading decimal number, 0 without one or below
+// zero, the fallback for a missing key.
+[[nodiscard]] UINT profile_int(const std::wstring* value, UINT fallback) noexcept {
+    if (value == nullptr) return fallback;
+    const wchar_t* text = value->c_str();
+    wchar_t* end = nullptr;
+    const long parsed = std::wcstol(text, &end, 10);
+    return end == text || parsed < 0 ? 0U : static_cast<UINT>(parsed);
+}
+
+} // namespace
+
+OfxrSectionValues parse_ofxr_section(std::wstring_view section) {
+    OfxrSectionValues values;
+    std::vector<std::pair<std::wstring, std::wstring>> pairs;
+    while (!section.empty()) {
+        const std::size_t nul = section.find(L'\0');
+        const std::wstring_view line = trim_profile_text(section.substr(0, nul));
+        section.remove_prefix(nul == std::wstring_view::npos ? section.size() : nul + 1);
+        if (line.empty() || line.front() == L';' || line.front() == L'#') continue;
+        const std::size_t equals = line.find(L'=');
+        if (equals == std::wstring_view::npos) continue;
+        const std::wstring_view key = trim_profile_text(line.substr(0, equals));
+        std::wstring_view value = trim_profile_text(line.substr(equals + 1));
+        if (value.size() >= 2 && (value.front() == L'"' || value.front() == L'\'') &&
+            value.back() == value.front()) {
+            value = value.substr(1, value.size() - 2);
+        }
+        if (key.empty()) continue;
+        values.found = true;
+        pairs.emplace_back(std::wstring(key), std::wstring(value));
+    }
+    const auto find = [&](const wchar_t* name) -> const std::wstring* {
+        for (const auto& [key, value] : pairs) {
+            if (_wcsicmp(key.c_str(), name) == 0) return &value; // the first, as the API
+        }
+        return nullptr;
+    };
+    if (const auto* preset = find(L"nvidia_preset")) {
+        if (_wcsicmp(preset->c_str(), L"slow") == 0) {
+            values.nvidia.preset = ConfiguredNvidiaPerformancePreset::slow;
+        } else if (_wcsicmp(preset->c_str(), L"fast") == 0) {
+            values.nvidia.preset = ConfiguredNvidiaPerformancePreset::fast;
+        }
+    }
+    const UINT input_scale = profile_int(find(L"nvidia_input_scale"), 50);
+    values.nvidia.input_scale = input_scale == 75
+        ? ConfiguredNvidiaInputScale::three_quarter
+        : input_scale == 50 ? ConfiguredNvidiaInputScale::half : ConfiguredNvidiaInputScale::full;
+    values.nvidia.bidirectional = profile_int(find(L"nvidia_bidirectional"), 0) != 0;
+    const UINT occlusion = profile_int(find(L"nvidia_occlusion_aware"), 0);
+    values.occlusion_aware = occlusion <= 1U ? occlusion : 0U; // as read_nvidia_occlusion_aware
+    for (std::size_t i = 0; i < kOfxrStartOnlyKeys.size(); ++i) {
+        if (const auto* value = find(kOfxrStartOnlyKeys[i])) values.start_only[i] = *value;
+    }
+    return values;
+}
+
+OfxrSectionValues read_ofxr_section(const std::filesystem::path& module_directory) noexcept {
+    try {
+        if (module_directory.empty()) return {};
+        const auto ini_path = module_directory / L"ofxr_bridge.ini";
+        // The API's limit for a section is 32767 characters; DCS Control's is
+        // under 4 KB. A buffer it filled (size - 2) may have lost lines: then
+        // nothing is taken.
+        std::vector<wchar_t> buffer(32767);
+        const DWORD length = GetPrivateProfileSectionW(
+            L"ofxr", buffer.data(), static_cast<DWORD>(buffer.size()), ini_path.c_str());
+        if (length == 0 || length >= buffer.size() - 2) return {};
+        return parse_ofxr_section(std::wstring_view(buffer.data(), length));
+    } catch (...) {
+        return {};
+    }
+}
+
 bool register_manifest(
     const std::filesystem::path& manifest,
     RegistryScope scope,
