+namespace {
+LiveFlow live_flow_of(const implicit_layer::OfxrSectionValues& values) noexcept {
+    return {static_cast<int>(values.nvidia.preset), static_cast<int>(values.nvidia.input_scale),
+        values.nvidia.bidirectional, values.occlusion_aware};
+}
+}
+
+struct LiveIniWatcher::Impl {
+    std::filesystem::path directory, ini;
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool stop{};
+    std::thread thread;
+    // The poll thread's own, after the constructor.
+    bool stamped{};
+    FILETIME last_write{};
+    std::uint64_t last_size{};
+    bool baseline_known{};
+    std::array<std::wstring, implicit_layer::kOfxrStartOnlyKeys.size()> baseline{};
+    std::uint32_t start_only_logged{};
+
+    void poll(bool first) noexcept {
+        try {
+            WIN32_FILE_ATTRIBUTE_DATA data{};
+            if (!GetFileAttributesExW(ini.c_str(), GetFileExInfoStandard, &data)) return;
+            const std::uint64_t size =
+                (static_cast<std::uint64_t>(data.nFileSizeHigh) << 32) | data.nFileSizeLow;
+            if (stamped && CompareFileTime(&data.ftLastWriteTime, &last_write) == 0 && size == last_size) return;
+            auto& c = control();
+            implicit_layer::OfxrSectionValues values;
+            LiveAdoption adoption;
+            {
+                std::scoped_lock io_lock(c.io_mutex);
+                values = implicit_layer::read_ofxr_section(directory);
+                // No section (a file being written in place): read again next time.
+                if (!values.found) return;
+                adoption = adopt_live(live_flow_of(values), first);
+            }
+            stamped = true;
+            last_write = data.ftLastWriteTime;
+            last_size = size;
+            if (adoption.keys != 0) {
+                // live_settings result=1 (bridge_flight_logger.hpp).
+                bridge_flight_logger().event(BridgeFlightOperation::live_settings, 1,
+                    live_flow_code(adoption.after), live_flow_code(adoption.before),
+                    static_cast<std::uint64_t>(adoption.keys) | (adoption.revision << 32));
+            }
+            if (!baseline_known) {
+                baseline = values.start_only;
+                baseline_known = true;
+                return;
+            }
+            std::uint32_t differing = 0;
+            for (std::size_t i = 0; i < baseline.size(); ++i) {
+                if (_wcsicmp(baseline[i].c_str(), values.start_only[i].c_str()) != 0) differing |= 1U << i;
+            }
+            if (differing != start_only_logged) {
+                // live_settings result=2 (bridge_flight_logger.hpp).
+                start_only_logged = differing;
+                bridge_flight_logger().event(BridgeFlightOperation::live_settings, 2, 0, 0, differing);
+            }
+        } catch (...) {
+        }
+    }
+
+    void run() noexcept {
+        std::unique_lock lock(mutex);
+        while (!wake.wait_for(lock, std::chrono::milliseconds(250), [this] { return stop; })) {
+            lock.unlock();
+            poll(false);
+            lock.lock();
+        }
+    }
+};
+
+LiveIniWatcher::LiveIniWatcher(std::filesystem::path module_directory) {
+    try {
+        if (module_directory.empty()) return;
+        auto impl = std::make_unique<Impl>();
+        impl->directory = std::move(module_directory);
+        impl->ini = impl->directory / L"ofxr_bridge.ini";
+        // The values as the session starts (and, in a later session of the
+        // same process, what changed since the first one).
+        impl->poll(true);
+        impl->thread = std::thread([raw = impl.get()] { raw->run(); });
+        impl_ = std::move(impl);
+    } catch (...) {
+        impl_.reset(); // no thread: the session keeps its start values
+    }
+}
+
+LiveIniWatcher::~LiveIniWatcher() {
+    if (!impl_) return;
+    {
+        std::scoped_lock lock(impl_->mutex);
+        impl_->stop = true;
+    }
+    impl_->wake.notify_all();
+    if (impl_->thread.joinable()) impl_->thread.join();
+}
 }
 
