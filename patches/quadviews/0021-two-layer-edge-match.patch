Edge match on two layers (dcsvr_edge_match with dcsvr_two_layers): the focus layer's output pass
(native/quadviews/dcsvr_twolayer_ps.hlsl) blurs the focus image in the fade band with the composition's tent
(0019-edge-match.patch). The tent's width needs only k, one periphery texel in focus texels. The composition takes it
from the screen-space derivatives of both views; in this mode the compositor enlarges the periphery after the pass, so
k comes from the CPU: per axis the focus texels per tangent over the periphery's (the two source textures' sizes, as
the composition's GetDimensions, and the two fields of view), k = sqrt(kx * ky), at most 16 as there. The constants
grow by one float4 (dcsvrEdge: x the band share, y k) to 112 bytes. dcsvr_edge_match 0 (the default), or
debug_focus_view, leaves dcsvrEdge 0 and the pass's output as before (tests/quadviews-composition checks it).diff --git a/openxr-api-layer/layer.cpp b/openxr-api-layer/layer.cpp
index 0000000..0000000 100644
--- a/openxr-api-layer/layer.cpp
+++ b/openxr-api-layer/layer.cpp
@@ -97,8 +97,10 @@ namespace openxr_api_layer {
         alignas(4) float dcsvrReuse[3][4];
         // x 1: the periphery black (debug_focus_view), y 1: the focus colour outside the fade from the unsharpened image.
         alignas(4) float dcsvrDebug[4];
+        // DCSVR edge match (0021): x the share of the fade band (0 off), y one periphery texel in focus texels.
+        alignas(4) float dcsvrEdge[4];
     };
-    static_assert(sizeof(DcsvrTwoLayerConstants) == 96, "DcsvrTwoLayerConstants must match dcsvr_twolayer_ps.hlsl's cbuffer");
+    static_assert(sizeof(DcsvrTwoLayerConstants) == 112, "DcsvrTwoLayerConstants must match dcsvr_twolayer_ps.hlsl's cbuffer");
 
     struct SharpeningCSConstants {
         alignas(4) uint32_t Const0[4];
@@ -4178,6 +4180,36 @@ namespace openxr_api_layer {
                 // Sharpened: outside the rounded shape the sharpening skips tiles, the plain image fills them.
                 const bool fill = plainFocusSource && m_focusViewShape >= 1.f && !m_debugFocusView;
                 focus.dcsvrDebug[1] = fill ? 1.f : 0.f;
+                // DCSVR edge match: k, one periphery texel in focus texels, as the composition takes it from the
+                // derivatives of both views. Both views look the same way, so per axis it is the focus texels per tangent
+                // over the periphery's (source texture sizes, as the composition's GetDimensions): k = sqrt(kx * ky).
+                if (m_dcsvrEdgeMatch > 0.f && !m_debugFocusView && peripherySource && focusSource) {
+                    const auto size = [](ID3D11ShaderResourceView* srv, float& width, float& height) {
+                        ComPtr<ID3D11Resource> resource;
+                        srv->GetResource(resource.ReleaseAndGetAddressOf());
+                        ComPtr<ID3D11Texture2D> texture;
+                        D3D11_TEXTURE2D_DESC desc{};
+                        if (FAILED(resource.As(&texture))) {
+                            return false;
+                        }
+                        texture->GetDesc(&desc);
+                        width = (float)desc.Width;
+                        height = (float)desc.Height;
+                        return width > 0 && height > 0;
+                    };
+                    float peripheryWidth, peripheryHeight, focusWidth, focusHeight;
+                    const float eyeAcross = std::tan(eyeFov.angleRight) - std::tan(eyeFov.angleLeft);
+                    const float eyeDown = std::tan(eyeFov.angleUp) - std::tan(eyeFov.angleDown);
+                    const float focusAcross = std::tan(focusView.fov.angleRight) - std::tan(focusView.fov.angleLeft);
+                    const float focusDown = std::tan(focusView.fov.angleUp) - std::tan(focusView.fov.angleDown);
+                    if (size(peripherySource, peripheryWidth, peripheryHeight) && size(focusSource, focusWidth, focusHeight) &&
+                        focusAcross > 0.f && focusDown > 0.f) {
+                        const float kx = focusWidth / peripheryWidth * eyeAcross / focusAcross;
+                        const float ky = focusHeight / peripheryHeight * eyeDown / focusDown;
+                        focus.dcsvrEdge[0] = m_dcsvrEdgeMatch;
+                        focus.dcsvrEdge[1] = std::min(16.f, std::sqrt(std::abs(kx * ky)));
+                    }
+                }
                 dcsvrTwoLayerDraw(focusOut, focusOut.arraySize > 1 ? viewIndex : 0, focusSource, fill ? plainFocusSource : nullptr, field, focus,
                                   markFocus ? &focusMarker : nullptr, focusMarkerColor);
             }
