+            const float peripheryMarkerColor[] = {0.5f, 0, 0.5f, 1};
+            const float focusEncoded = linearSource ? 0.7353569f : 0.5f;
+            const float focusMarkerColor[] = {focusEncoded, 0, focusEncoded, 1};
