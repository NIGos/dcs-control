+                periphery.dcsvrDebug[0] = m_debugFocusView ? 1.f : 0.f;
+                dcsvrTwoLayerDraw(peripheryOut, peripheryOut.arraySize > 1 ? viewIndex : 0, peripherySource, nullptr, field, periphery,
