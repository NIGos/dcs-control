+        // DCSVR submission log: remembers a swapchain's format and array size for the submission line.
+        void dcsvrNoteSwapchain(XrSwapchain handle, const XrSwapchainCreateInfo& createInfo) {
+            if (handle == XR_NULL_HANDLE) {
+                return;
+            }
+            std::unique_lock lock(m_dcsvrSubmitMutex);
+            m_dcsvrSubmitFormats.insert_or_assign(handle, std::make_pair(createInfo.format, createInfo.arraySize));
+        }
+
+        // DCSVR submission log: what goes to the runtime, one line at the session's first frame and whenever it
+        // changes: per layer its type, flags, and per view the swapchain's format (DXGI number on D3D11), array
+        // size, slice and rectangle. "DCSVR submission: 2 layer(s) | layer 0: projection flags 0x2
+        // (source-alpha), 2 views; view 0: format 29 x2 slice 0 rect 0,0 2624x2592; ..."
+        void dcsvrLogSubmission(const XrFrameEndInfo& info) {
+            const auto flagNames = [](XrCompositionLayerFlags flags) {
+                std::string names;
+                const auto add = [&](XrCompositionLayerFlags bit, const char* name) {
+                    if (flags & bit) {
+                        names += (names.empty() ? "" : "+") + std::string(name);
+                    }
+                };
+                add(XR_COMPOSITION_LAYER_CORRECT_CHROMATIC_ABERRATION_BIT, "chromatic");
+                add(XR_COMPOSITION_LAYER_BLEND_TEXTURE_SOURCE_ALPHA_BIT, "source-alpha");
+                add(XR_COMPOSITION_LAYER_UNPREMULTIPLIED_ALPHA_BIT, "unpremultiplied");
+                add(0x8, "inverted-alpha"); // XR_COMPOSITION_LAYER_INVERTED_ALPHA_BIT_EXT, not in every SDK
+                return names.empty() ? std::string("none") : names;
+            };
+            std::unique_lock lock(m_dcsvrSubmitMutex);
+            if (m_dcsvrSubmitLines >= kDcsvrSubmitLogLines) {
+                return;
+            }
+            const auto image = [&](const XrSwapchainSubImage& sub) {
+                const auto it = m_dcsvrSubmitFormats.find(sub.swapchain);
+                return fmt::format("{} slice {} rect {},{} {}x{}",
+                                   it == m_dcsvrSubmitFormats.end()
+                                       ? std::string("format ? x?")
+                                       : fmt::format("format {} x{}", it->second.first, it->second.second),
+                                   sub.imageArrayIndex,
+                                   sub.imageRect.offset.x,
+                                   sub.imageRect.offset.y,
+                                   sub.imageRect.extent.width,
+                                   sub.imageRect.extent.height);
+            };
+            std::string text;
+            for (uint32_t i = 0; i < info.layerCount; i++) {
+                const XrCompositionLayerBaseHeader* base = info.layers[i];
+                if (!base) {
+                    continue;
+                }
+                text += fmt::format(" | layer {}: ", i);
+                if (base->type == XR_TYPE_COMPOSITION_LAYER_PROJECTION) {
+                    const auto* proj = reinterpret_cast<const XrCompositionLayerProjection*>(base);
+                    text += fmt::format("projection flags 0x{:x} ({}), {} views", proj->layerFlags, flagNames(proj->layerFlags), proj->viewCount);
+                    for (uint32_t v = 0; v < proj->viewCount; v++) {
+                        text += fmt::format("; view {}: {}", v, image(proj->views[v].subImage));
+                    }
+                } else if (base->type == XR_TYPE_COMPOSITION_LAYER_QUAD) {
+                    const auto* quad = reinterpret_cast<const XrCompositionLayerQuad*>(base);
+                    text += fmt::format("quad flags 0x{:x} ({}), eye {}: {}", quad->layerFlags, flagNames(quad->layerFlags), (int)quad->eyeVisibility, image(quad->subImage));
+                } else {
+                    text += fmt::format("type {} flags 0x{:x} ({})", (int)base->type, base->layerFlags, flagNames(base->layerFlags));
+                }
+            }
+            if (text == m_dcsvrSubmitLast) {
+                return;
+            }
+            m_dcsvrSubmitLast = text;
+            m_dcsvrSubmitLines++;
+            Log(fmt::format("DCSVR submission: {} layer(s){}{}\n", info.layerCount, text,
+                            m_dcsvrSubmitLines == kDcsvrSubmitLogLines ? " (the last line this session: further changes are not logged)" : ""));
+        }
