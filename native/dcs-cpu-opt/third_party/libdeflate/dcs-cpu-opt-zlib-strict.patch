 /* Indicates an end-of-block entry in the litlen decode table */
 #define HUFFDEC_END_OF_BLOCK		0x00002000
 
+/*
+ * dcs-cpu-opt (LIBDEFLATE_ZLIB_STRICT): marks a symbol zlib treats as an error
