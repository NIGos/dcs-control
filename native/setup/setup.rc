// Icon, version information and manifest of the DCS Control setup.
#include <windows.h>
#include "version.h"  // written by scripts/build-setup.ps1 from Directory.Build.props

1 ICON "..\\..\\src\\DcsVr.App\\Assets\\app-icon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION DCSC_VERSION
PRODUCTVERSION DCSC_VERSION
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "DCS Control contributors"
      VALUE "FileDescription", "DCS Control Setup"
      VALUE "ProductName", "DCS Control"
      VALUE "OriginalFilename", "DcsControl-Setup.exe"
      VALUE "FileVersion", DCSC_VERSION_TEXT
      VALUE "ProductVersion", DCSC_VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
